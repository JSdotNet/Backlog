  "cards": [
    {
      "dot": "cyan",
      "title": "Gathering on the read path",
      "items": [
        "Nothing is written back — not to the plan, not to an entry, not to a chapter",
        "An unreachable supplier shrinks a total rather than corrupting a plan",
        "Roadmap Item Gathering reads effort it never registers"
      ]
    },
    {
      "dot": "emerald",
      "title": "Merged, not concatenated",
      "items": [
        "A thing linked and tagged is one gathered thing",
        "The result records that it was reached both ways",
        "A reader about to remove a link needs to know the tag would still hold the work"
      ]
    },
    {
      "dot": "amber",
      "title": "Only registered story points",
      "items": [
        "Nothing is inferred for an unestimated thing",
        "The count of unestimated things rides alongside the total",
        "A small-looking total is not the same as a total that is small"
      ]
    }
