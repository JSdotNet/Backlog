  "cards": [
    {
      "dot": "emerald",
      "title": "Milestone-based, not transcript-shaped",
      "items": [
        "The session emits start, meaningful deltas, and finish",
        "Those are the facts a later reader can use",
        "Token streams and tool bodies would bloat the evidence without improving the answer"
      ]
    },
    {
      "dot": "amber",
      "title": "Capability is a path state",
      "items": [
        "Checked, not guessed from missing events",
        "No external updates can mean not configured or temporarily unreachable",
        "The reporting path carries its own reading"
      ]
    },
    {
      "dot": "slate",
      "title": "Degrading is not failing",
      "items": [
        "A degraded path keeps local session work moving",
        "The session is told its reporting is marked degraded",
        "A disabled path is simply a local-only session"
      ]
    }
  ]
