      {
        "id": "Docker.DockerDesktop",
        "name": "Docker Desktop",
        "provider": "winget",
        "group": "Container workflow",
        "note": "Needs elevation, and a reboot for the WSL 2 backend.",
        "probe": {
          "command": "docker",
          "args": [
            "--version"
          ]
        },
        "enabled": true
      },
      {
        "id": "dev-drive",
        "name": "Dev Drive configured",
        "provider": "command",
        "group": "Dev Drive and package caches",
        "note": "A heuristic. The authoritative per-volume flag, fsutil devdrv query D:, needs elevation and returns Access Denied without it, so this checks for ReFS on D: instead.",
        "detect": {
          "command": "powershell",
          "args": [
            "-NoProfile",
            "-Command",
            "(Get-Volume -DriveLetter D).FileSystemType"
          ],
          "expect": "ReFS"
        },
        "enabled": true
      },
      {
        "id": "nuget-cache-on-dev-drive",
        "name": "NuGet cache on Dev Drive",
        "provider": "command",
        "group": "Dev Drive and package caches",
        "detect": {
          "command": "dotnet",
          "args": [
            "nuget",
            "locals",
            "global-packages",
            "--list"
          ],
          "expect": "D:\\"
        },
        "enabled": true
      },
      {
        "id": "npm-cache-on-dev-drive",
        "name": "npm cache on Dev Drive",
        "provider": "command",
        "group": "Dev Drive and package caches",
        "note": "The HowTo scopes this to \"when npm is installed\", so an absent npm is not a failure.",
        "detect": {
          "command": "npm",
          "args": [
            "config",
            "get",
            "cache"
          ],
          "expect": "D:\\"
        },
        "enabled": true
      },
      {
        "id": "git-pull-rebase",
        "name": "git pull.rebase is true",
        "provider": "command",
        "group": "Git configuration",
        "note": "An unset key exits 1 with empty output. That is \"not configured\", not an error.",
        "detect": {
          "command": "git",
          "args": [
            "config",
            "--global",
            "pull.rebase"
          ],
          "expect": "true"
        },
        "install": {
          "command": "git",
          "args": [
            "config",
            "--global",
            "pull.rebase",
            "true"
          ]
        },
        "enabled": true
      },
      {
        "id": "git-rebase-autostash",
        "name": "git rebase.autoStash is true",
        "provider": "command",
        "group": "Git configuration",
        "detect": {
          "command": "git",
          "args": [
            "config",
            "--global",
            "rebase.autoStash"
          ],
          "expect": "true"
        },
        "install": {
          "command": "git",
          "args": [
            "config",
            "--global",
            "rebase.autoStash",
            "true"
          ]
        },
        "enabled": true
      },
