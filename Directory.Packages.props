<Project>

  <!--
    Central Package Management (org ADR 0002). Every package version in the
    solution is declared here once; project files reference packages by name
    only. A project-local Version attribute is an exception that has to be
    justified with a comment in that project file, not a convenience.

    $(MauiVersion) comes from the root Directory.Build.props, which
    Microsoft.Common.props imports just before this file.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      Transitive pinning is deliberately OFF. Turning it on rewrites versions the
      solution never asked for: the AppHost's transitive YamlDotNet 16.3.0,
      OpenTelemetry 1.15.3 and Microsoft.Extensions.* 10.0.8 each get lifted to
      whatever this file declares for that name, purely because those names appear
      below as direct versions. Those targets are not repeated here because they
      move with every bump of the package; read them from the PackageVersion
      entries. Adopting CPM was meant to change where versions are declared, not
      which ones resolve. Enable it as its own reviewed change if transitive
      governance is wanted.
    -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.CosmosDB" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.DevTunnels" Version="13.6.4" />
    <!--
      The Azure sign-in the Foundry cost reader borrows: Azure CLI, Azure
      Developer CLI, or Visual Studio. Cost Management is a Resource Manager API
      and takes an Entra token, which no Foundry API key can stand in for.
    -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <!--
      Foundry Local and the MAUI project resource ship one preview build per
      Aspire release, so their versions are that release's preview build rather than a
      version of their own. They move with Aspire.Hosting.AppHost above; a
      hosting package from another release binds against a different
      Aspire.Hosting than the AppHost resolves.
    -->
    <PackageVersion Include="Aspire.Hosting.Foundry" Version="13.6.4-preview.1.26523.11" />
    <PackageVersion Include="Aspire.Hosting.Maui" Version="13.6.4-preview.1.26523.11" />

    <!--
      The client-side half of the Cosmos wiring: it reads the connection string
      the AppHost hands the sync service and registers the CosmosClient that
      Backlog.Infrastructure.Cosmos resolves. It moves with the hosting packages
      above for the same reason they move with each other.
    -->
    <PackageVersion Include="Aspire.Microsoft.Azure.Cosmos" Version="13.6.4" />

    <!--
      The client-side half of the attachment store (local ADR 0014): it reads the
      `attachments` connection the AppHost hands the sync service and registers
      the BlobContainerClient that Backlog.Infrastructure.BlobStorage resolves.
      Moves with the hosting packages above, like the Cosmos one.
    -->
    <PackageVersion Include="Aspire.Azure.Storage.Blobs" Version="13.6.4" />

    <!--
      The client-side half of the realtime nudge (local ADR 0039 §4): it registers the
      WebPubSubServiceClient that Backlog.Infrastructure.WebPubSub mints client access
      URLs and publishes "pull now" through, with the managed identity as its
      credential. Moves with the hosting packages above, like the Cosmos one.
    -->
    <PackageVersion Include="Aspire.Azure.Messaging.WebPubSub" Version="13.6.1" />

    <!--
      The Android push (local ADR 0039 §4): the Notification Hubs data-plane client that
      Backlog.Infrastructure.NotificationHubs keeps each phone's FCM v1 installation
      through and sends the data message with. No Aspire integration exists for it, and
      the hub takes no managed identity, so the client is built from the SAS connection
      strings Bicep puts into the container app's secrets. FCM v1 installations and
      native sends arrived in 4.2.0.
    -->
    <PackageVersion Include="Microsoft.Azure.NotificationHubs" Version="4.2.0" />
    <!--
      Lifted from the 6.0.1 Microsoft.Azure.NotificationHubs above depends on, which carries
      a high-severity advisory (GHSA-qj66-m88j-hmgj). Referenced directly by
      Backlog.Infrastructure.NotificationHubs only, because transitive pinning is off.
    -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />

    <!--
      Pinned to the version Aspire.Azure.Storage.Blobs above resolves
      transitively, for the reason Microsoft.Azure.Cosmos below is: the blob
      adapter stages and commits blocks through the SDK's own types, and naming a
      different version would put the adapter and the Aspire wiring on two builds
      of one assembly. Bump the two together or not at all.
    -->
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageVersion Include="bunit" Version="2.12.5" />
    <!--
      Named explicitly so the lock files stop depending on which SDK restored them.
      A Microsoft.NET.Sdk.Web project with .razor content gets an implicit
      PackageReference to this package (blazor.web.js and blazor.server.js as static
      web assets) at the SDK's own bundled ASP.NET Core patch: KnownAspNetCorePack in
      Microsoft.NETCoreSdk.BundledVersions.props, so SDK 10.0.301 asks for 10.0.9,
      10.0.302 for 10.0.10 and 10.0.402 for 10.0.13. packages.lock.json records that
      version, and with global.json rolling forward to the latest patch a restore on
      any other SDK (a newer runner image, an older local install) rewrites the lock
      file or fails CI's locked restore with NU1004. An explicit PackageReference of
      the same id replaces the implicit one, so the version is this line's.
      Only the three web projects under src/Harness reference it, PrivateAssets="all"
      as the implicit one was. The scripts may run a patch apart from the runtime,
      which these undeployed harnesses can afford; keep the version at the ASP.NET
      Core patch of the SDK CI installs, and regenerate the lock files with it.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.App.Internal.Assets" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />

    <!--
      Pinned to the version Aspire.Microsoft.Azure.Cosmos above already resolves
      transitively. The replica adapter is written against the SDK's own types —
      CosmosClient, Container, FeedRange, ChangeFeedStartFrom — so the package is
      a direct reference rather than something only Aspire touches, and naming a
      different version here would put the adapter and the Aspire wiring that
      configures its client on two builds of one assembly. Bump the two together
      or not at all.
    -->
    <PackageVersion Include="Microsoft.Azure.Cosmos" Version="3.63.2" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!--
      The container itself, for a test that composes a module the way a host
      does (AddInboxModule() over in-memory ports) rather than newing its
      handlers one by one. Products get it from their host; only tests name it.
    -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <!--
      A HostApplicationBuilder in a test. Backlog.Infrastructure.Cosmos's
      registration extension takes an IHostApplicationBuilder and decides what to
      do by its environment, and the only honest way to assert that is to hand it
      a real builder rather than a stand-in that implements the interface.
    -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <!--
      ILoggingBuilder and its filters, for the file log the installed desktop
      build keeps (Backlog.Infrastructure.FileSystem). The MAUI heads carry the
      package in their framework already; the library that registers the provider
      has to name it.
    -->
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.13" />

    <!--
      ValidateDataAnnotations(), for a project that is a plain library rather than
      an ASP.NET Core host. The web SDK carries this in its framework reference, so
      only Backlog.Infrastructure.Cosmos names it: without it, options with
      [Required] and [Range] on them would bind and never be checked.
    -->
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />

    <!--
      The screen lock and unlock events the desktop head's presence reads (local ADR 0041).
      Part of the Windows Desktop shared framework, which the MAUI head does not take, so
      it is named here; only Backlog.Desktop references it.
    -->
    <PackageVersion Include="Microsoft.Win32.SystemEvents" Version="10.0.13" />

    <!--
      Pinned to the version Microsoft.AspNetCore.Authentication.JwtBearer 10.0.11
      already resolves transitively (via Microsoft.IdentityModel.Protocols.OpenIdConnect
      8.19.2). The sync service issues its own device tokens with JsonWebTokenHandler,
      so the package is a direct reference; naming a different version here would put
      the issuer and the validator on two builds of the same assembly.
    -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageVersion Include="Microsoft.Maui.Core" Version="$(MauiVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- Browser end-to-end tests only (tests/Backlog.EndToEndTests). Its browsers
         are installed separately, by the playwright.ps1 the build writes to bin. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <!--
      The MCP server ADR 0012 decided. .Core is the transport-neutral half the tool
      classes are attributed with; .AspNetCore is the Streamable HTTP host, referenced
      only by Backlog.Desktop and the web harness so the framework reference it pulls
      in never reaches the net10.0-android head.
    -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.2.0" />
    <!-- And the dependency-injection half between the two: AddMcpServer,
         WithTools and the request filters. Its nuspec declares no framework
         reference of any kind, which is what lets the registration both hosts
         share sit in a library instead of being written twice. -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <!--
      The exceptions the standard resilience handler ends a call with when it gives
      up — a total timeout, an open circuit. Backlog.Infrastructure.Sync catches
      them where it catches HttpRequestException, so a sync cycle that waited out
      the pipeline is a failed result with a sentence rather than the catch-all.
      The version is the one Microsoft.Extensions.Http.Resilience above resolves.
    -->
    <PackageVersion Include="Polly.Core" Version="8.6.6" />
    <!--
      The phone's talk note shrinks a slide photo to 1600 px JPEG before it
      enters the outbox. MIT, with the Android and Windows natives in the box, so
      the MAUI head, the browser harness and the unit tests run one codec.
    -->
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <!--
      The Android push (local ADR 0039 §4): Firebase Cloud Messaging's token and
      the data messages Notification Hubs relays, in the Android head only. The
      Microsoft-maintained binding, with an explicit net10.0-android36.0 group;
      its Play Services targets turn Platforms/Android/google-services.json into
      the resources Firebase reads at start.
    -->
    <PackageVersion Include="Xamarin.Firebase.Messaging" Version="125.1.3" />
    <!--
      Firebase Messaging's Play Services graph lifts AndroidX Fragment, Collection
      and Lifecycle past the versions MAUI's own -ktx packages are pinned to. Those
      artifacts merged their -ktx classes into the main one, so the older -ktx left
      beside a newer main artifact puts each class in the dex twice (D8 "defined
      multiple times"). The Android head references these at the matching versions.
    -->
    <PackageVersion Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
