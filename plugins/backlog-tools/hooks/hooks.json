{
  "modules": ["./register.tsx"],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "i=$(cat); case \"$i\" in *execute-plan*) ;; *) printf '%s' \"$i\" | grep -q -E 'Backlog plan item `|run-plan-item entry `' && printf '%s\\n' 'This prompt carries a Backlog marker: invoke the run-plan-item skill before doing anything else with it.' ;; esac; true"
          },
          {
            "type": "command",
            "command": "i=$(cat); case \"$i\" in *'<scheduled-task'*) printf '%s' \"$i\" | node \"${CLAUDE_PLUGIN_ROOT}/hooks/schedule-run-report.mjs\" ;; esac; true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/schedule-run-report.mjs\"", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|Edit|MultiEdit|Write|NotebookEdit|Artifact|Task|Agent|Skill|Workflow)$|^mcp__",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry-forwarder.mjs\"", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|PowerShell|Edit|MultiEdit|Write|NotebookEdit|Artifact|Task|Agent|Skill|Workflow)$|^mcp__",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry-forwarder.mjs\"", "timeout": 5 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry-forwarder.mjs\"", "timeout": 5 }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry-forwarder.mjs\"", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry-forwarder.mjs\"", "timeout": 5 },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/schedule-run-report.mjs\"", "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry-forwarder.mjs\"", "timeout": 5 }
        ]
      }
    ]
  }
}
