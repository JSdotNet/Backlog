{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "grep -q -E 'Backlog plan item `|backlog-run-plan-item entry `' && printf '%s\\n' 'This prompt carries a Backlog marker: invoke the backlog-run-plan-item skill before doing anything else with it.' || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|Edit|MultiEdit|Write|NotebookEdit|Artifact|Task|Agent|Skill|Workflow)$|^mcp__",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry-forwarder.mjs\"", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|PowerShell|Edit|MultiEdit|Write|NotebookEdit|Artifact|Task|Agent|Skill|Workflow)$|^mcp__",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry-forwarder.mjs\"", "timeout": 5 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry-forwarder.mjs\"", "timeout": 5 }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry-forwarder.mjs\"", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry-forwarder.mjs\"", "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry-forwarder.mjs\"", "timeout": 5 }
        ]
      }
    ]
  }
}
