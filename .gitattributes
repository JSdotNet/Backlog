# The Workflow tool refuses a script with CRLF line endings, so the devbook
# sweep's workflow scripts in plugins/backlog-tools stay LF on a Windows checkout.
*.workflow.js text eol=lf

# Test fixtures are byte-exact inputs: a PDF's xref offsets and a JPEG's EXIF
# would break under line-ending conversion.
tests/**/Fixtures/** binary

# Third-party builds vendored into the component library, kept byte for byte as
# published. autocrlf would otherwise rewrite them on a Windows checkout, and a
# diff of one minified line per file reads as nothing. The README beside each is
# ours, so it diffs and normalises like any other text file.
src/Core/Backlog.UI.Components/wwwroot/lib/** -text -diff linguist-vendored
src/Core/Backlog.UI.Components/wwwroot/lib/**/README.md text diff -linguist-vendored
