{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Packaged AppData Migration on First Start",
    "animation": "trace",
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "check", "label": "First start" },
    { "id": "copy", "label": "PackagedAppData copy" }
  ],
  "nodes": [
    { "id": "start", "lane": "check", "col": 0, "type": "frontend", "label": "First start of a packaged build", "width": 270 },
    { "id": "redirect", "lane": "check", "col": 1, "type": "security", "label": "Redirected AppData", "sublabel": "folder exists?", "width": 190 },
    { "id": "done", "lane": "check", "col": 4, "type": "database", "label": "Use the real folder", "width": 190 },
    { "id": "migrate", "lane": "copy", "col": 1, "type": "backend", "label": "PackagedAppData copies backlog.db", "sublabel": "(SQLite backup API), _inbox, config, .tools and the per-device JSON files", "width": 400 },
    { "id": "skip", "lane": "copy", "col": 3, "type": "backend", "label": "Skips anything already", "sublabel": "in the real folder", "width": 210 },
    { "id": "settings", "lane": "copy", "col": 4, "type": "backend", "label": "Writes settings.json last", "width": 230 }
  ],
  "edges": [
    { "id": "start-to-redirect", "from": "start", "to": "redirect" },
    { "id": "redirect-no", "from": "redirect", "to": "done", "label": "no" },
    { "id": "redirect-yes", "from": "redirect", "to": "migrate", "label": "yes", "toSide": "top" },
    { "id": "migrate-to-skip", "from": "migrate", "to": "skip" },
    { "id": "skip-to-settings", "from": "skip", "to": "settings" },
    { "id": "settings-to-done", "from": "settings", "to": "done" }
  ]
}
