{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Mobile Task Edit and Push",
    "animation": "trace",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [1200, 620]
  },
  "participants": [
    { "id": "me", "type": "external", "label": "ME" },
    { "id": "tasks", "type": "frontend", "label": "Phone Today tab" },
    { "id": "view", "type": "database", "label": "task_view (SQLite)" },
    { "id": "outbox", "type": "database", "label": "SQLite Outbox" },
    { "id": "sync", "type": "cloud", "label": "Sync Service" }
  ],
  "messages": [
    { "id": "edit-task", "from": "me", "to": "tasks", "y": 182, "label": "Mark done, tick a step, or move to tomorrow", "variant": "default" },
    { "id": "read-row", "from": "tasks", "to": "view", "y": 226, "label": "Read the task's row", "variant": "default" },
    { "id": "insert-outbox", "from": "tasks", "to": "outbox", "y": 270, "label": "INSERT outbox (new entry id v7, kind=task, whole TaskChange under the task's id, UpdatedAt now)", "variant": "emphasis" },
    { "id": "upsert-row", "from": "tasks", "to": "view", "y": 314, "label": "UPSERT edited row (server stamp 0)", "variant": "default" },
    { "id": "change-shown", "from": "tasks", "to": "me", "y": 358, "label": "Change shown at once, marked waiting", "variant": "return" },
    { "id": "post-tasks", "from": "outbox", "to": "sync", "y": 402, "label": "POST /api/sync/tasks (same document every attempt)", "variant": "emphasis" },
    { "id": "accepted", "from": "sync", "to": "outbox", "y": 446, "label": "200 Accepted", "variant": "return", "note": "Outbox then: DELETE entry" },
    { "id": "get-tasks", "from": "tasks", "to": "sync", "y": 490, "label": "GET /api/sync/tasks?since=cursor (fold as above)", "variant": "emphasis" }
  ],
  "activations": [
    { "participant": "sync", "from": 396, "to": 452, "type": "cloud" }
  ]
}
