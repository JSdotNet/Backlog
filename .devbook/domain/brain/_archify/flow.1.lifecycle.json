  "cards": [
    {
      "dot": "cyan",
      "title": "Phases, not a stored enum",
      "items": [
        "Created, Organized, Linked and Archived are workflow phases",
        "The persisted state is the note's area",
        "In the inbox area it is Created, in the archive area Archived"
      ]
    },
    {
      "dot": "emerald",
      "title": "Organizing and linking",
      "items": [
        "Organizing moves the note out of the inbox area into another",
        "Linking reaches tasks and other notes",
        "Updating links returns the note to Organized"
      ]
    },
    {
      "dot": "slate",
      "title": "Archiving is reversible",
      "items": [
        "A note no longer active can be archived from Organized or Linked",
        "Restoring returns it to Organized",
        "Archived is not an end of the note"
      ]
    }
