  "cards": [
    {
      "dot": "cyan",
      "title": "A reading, not a stored lifecycle",
      "items": [
        "Nothing in this context transitions a session",
        "Every state is reachable directly from a fresh reading",
        "Edges say what the evidence shows, not what happened"
      ]
    },
    {
      "dot": "emerald",
      "title": "Running and Stalled",
      "items": [
        "The same evidence read against a different clock",
        "The pair moves back and forth in both directions",
        "A session quiet for an hour was never anything but running"
      ]
    },
    {
      "dot": "slate",
      "title": "Finished",
      "items": [
        "Terminal for a given identity",
        "The liveness record is written per process, so a resumed session is a new process",
        "There is no Failed: a record that stops says nothing about why"
      ]
    }
  ]
}