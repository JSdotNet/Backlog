          556,
          157
        ]
      ]
    },
    {
      "id": "writes-again",
      "from": "stalled",
      "to": "running",
      "label": "the agent writes again",
      "fromSide": "left",
      "toSide": "bottom",
      "via": [
        [
          402,
          307
        ]
      ]
    },
    {
      "id": "read-stalled",
      "from": "fresh",
      "to": "stalled",
      "label": "liveness evidence, silent for longer than the threshold",
