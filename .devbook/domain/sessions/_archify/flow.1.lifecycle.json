      "col": 2
    },
    {
      "id": "stalled",
      "type": "waiting",
      "label": "Stalled",
      "sublabel": "silent past the threshold",
      "lane": "clock",
      "col": 1
    },
    {
      "id": "finished",
      "type": "neutral",
      "label": "Finished",
      "sublabel": "no liveness evidence",
      "lane": "terminal",
      "col": 2
    }
  ],
  "transitions": [
