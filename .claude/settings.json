{
  "extraKnownMarketplaces": {
    "backlog-tools": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  },
  "enabledPlugins": {
    "backlog-tools@backlog-tools": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__ccd_session__spawn_task",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/spawn-task-to-issue.ps1\""
          }
        ]
      }
    ]
  }
}
