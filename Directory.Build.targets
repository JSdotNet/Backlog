<Project>

  <!--
    TEMPORARY (plan app-defaults-rollout, step 14 deletes this file with the
    shim). Imports Backlog.SharedKernel.Results.Compatibility into every
    project outside src/Core, src/Modules and their unit tests that compiles
    against Backlog.SharedKernel, directly or through another project.

    A global using of a namespace the project cannot see does not compile, so
    the decision waits for the resolved references. It runs just before the
    compile and adds its own generated file rather than a Using item:
    GenerateGlobalUsings runs right after PrepareForBuild, before references
    resolve, and forcing ResolveReferences ahead of it is a target cycle in
    the MAUI heads. The WinUI head compiles once in XamlPreCompile before
    CoreCompile, so the file joins that pass too.
  -->
  <Target Name="_BacklogResultCompatibilityUsing"
          BeforeTargets="XamlPreCompile;CoreCompile"
          Condition="'$(_BacklogResultMigrated)' != 'true' and '$(Language)' == 'C#'">
    <PropertyGroup>
      <_BacklogReferencesSharedKernel>@(ReferencePath->AnyHaveMetadataValue('Filename', 'Backlog.SharedKernel'))</_BacklogReferencesSharedKernel>
      <_BacklogResultCompatibilityFile>$(IntermediateOutputPath)$(MSBuildProjectName).ResultCompatibility.g.cs</_BacklogResultCompatibilityFile>
    </PropertyGroup>
    <WriteLinesToFile Condition="'$(_BacklogReferencesSharedKernel)' == 'true'"
                      File="$(_BacklogResultCompatibilityFile)"
                      Lines="// &lt;auto-generated /&gt;;global using Backlog.SharedKernel.Results.Compatibility%3B"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup Condition="'$(_BacklogReferencesSharedKernel)' == 'true'">
      <Compile Include="$(_BacklogResultCompatibilityFile)" />
      <FileWrites Include="$(_BacklogResultCompatibilityFile)" />
    </ItemGroup>
  </Target>

</Project>
