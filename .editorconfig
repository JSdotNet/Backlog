# The repository's C# style and analyzer severities. Directory.Build.props
# turns the analyzers on (AnalysisLevel, EnforceCodeStyleInBuild), so a
# severity of warning here is a build warning, and the pull request build
# treats warnings as errors.
#
# The rules describe the code as it is written. A preference the code already
# follows everywhere is a warning; one it mostly follows is a suggestion, which
# the editor shows and the build does not, until the stragglers are fixed and
# it can be raised.

root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,xml,slnf,json,yml,yaml}]
indent_size = 2

[*.cs]
indent_size = 4

# Usings sit outside the namespace, System first.
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_sort_system_directives_first = true

# File-scoped namespaces: every file with a namespace already uses one.
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

# var wherever the type is apparent or does not matter.
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Expression bodies for the one-liners: properties, accessors, indexers and
# lambdas always; methods, operators and local functions when they fit on a
# line; constructors never.
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_indexers = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_operators = when_on_single_line:silent
csharp_style_expression_bodied_local_functions = when_on_single_line:silent
csharp_style_expression_bodied_constructors = false:silent

# Language keywords over framework type names; this. only where required.
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Modern forms the code already reaches for.
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
csharp_prefer_braces = when_multiline:silent

# Naming. Suggestions: a handful of fields predate the convention.
#   interfaces           IPascalCase
#   types and members    PascalCase, constants and static readonly fields too
#   private fields       _camelCase
#   locals, parameters   camelCase
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = i_prefix_pascal
dotnet_naming_rule.interfaces_start_with_i.severity = suggestion

dotnet_naming_rule.constants_are_pascal.symbols = constants
dotnet_naming_rule.constants_are_pascal.style = pascal
dotnet_naming_rule.constants_are_pascal.severity = suggestion

dotnet_naming_rule.static_readonly_fields_are_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_are_pascal.style = pascal
dotnet_naming_rule.static_readonly_fields_are_pascal.severity = suggestion

dotnet_naming_rule.private_fields_are_underscore_camel.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore_camel.style = underscore_camel
dotnet_naming_rule.private_fields_are_underscore_camel.severity = suggestion

dotnet_naming_rule.types_and_members_are_pascal.symbols = types_and_members
dotnet_naming_rule.types_and_members_are_pascal.style = pascal
dotnet_naming_rule.types_and_members_are_pascal.severity = suggestion

dotnet_naming_rule.locals_and_parameters_are_camel.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters_are_camel.style = camel
dotnet_naming_rule.locals_and_parameters_are_camel.severity = suggestion

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.types_and_members.applicable_kinds = namespace, class, struct, enum, interface, delegate, method, property, event
dotnet_naming_symbols.locals_and_parameters.applicable_kinds = parameter, local

dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_style.camel.capitalization = camel_case
dotnet_naming_style.i_prefix_pascal.capitalization = pascal_case
dotnet_naming_style.i_prefix_pascal.required_prefix = I
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# Analyzer categories. A category entry reaches only the rules its analyzers
# enable by default, and it replaces their own severity, so only the
# correctness categories the code already meets are raised; every other
# category keeps each rule's shipped default. Lowering one would silence the
# warnings the defaults already raise, including the xUnit analyzers'.
dotnet_analyzer_diagnostic.category-Reliability.severity = warning
dotnet_analyzer_diagnostic.category-Security.severity = warning

# ConfigureAwait(false) is the convention in the infrastructure adapters, which
# are awaited from UI threads they know nothing about. Scoped to them: the UI
# projects want the captured context back, so it stays silent everywhere else.
dotnet_diagnostic.CA2007.severity = none

[src/Infrastructure/**.cs]
dotnet_diagnostic.CA2007.severity = warning

# The rule also asks for ConfigureAwait on the disposal an `await using` awaits.
# The SQLite repositories open every connection, command and reader that way
# and configure none of those disposals, so there it stays a suggestion until
# they are rewritten.
[src/Infrastructure/Backlog.Infrastructure.Sqlite/**.cs]
dotnet_diagnostic.CA2007.severity = suggestion
