<?xml version="1.0" encoding="utf-8"?>
<!--
  One package source, with NuGet's minimum publish age (org ADR 0001; NuGet 8.0,
  .NET SDK 11.0.100): `dotnet package add` and `dotnet package update` never pick a
  version younger than 72 hours, and restoring a floating version fails with NU1020.
  Restore does not check an exact version's age, so the reviewed pin in
  Directory.Packages.props guards the rest. A source redefined in another
  nuget.config without the attribute drops back to 0.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" minPublishAgeHours="72" />
  </packageSources>
  <minPublishAgeExceptions />
</configuration>
