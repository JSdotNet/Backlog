## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# IDE state and per-user settings, for an IDE opened anywhere in the repository
.vs/
.idea/
*.user
*.suo

# Publish profiles (Visual Studio writes them under Properties/PublishProfiles/)
*.pubxml

# npm dependencies (src/App/Backlog.Ide.VsCode)
node_modules/

# Scratch space for work in progress: QA evidence, notes, throwaway artifacts.
.wip/

# Cache written by the impeccable design hook.
.impeccable/

# Local QA validation evidence (screenshots, scenario results)
.qa-evidence/
.playwright-evidence/

# .qa-workspace holds the committed QA fixtures; anything else a QA run writes
# there (screenshots, notes) is evidence and stays local.
.qa-workspace/*
!.qa-workspace/backlog.db
!.qa-workspace/config/

# Playwright MCP and Playwright CLI browser output (screenshots, page snapshots,
# console logs), written to the working directory of whichever session drove the
# browser.
.playwright-mcp/
.playwright-cli/

# Claude Code worktree sessions. The rest of .claude/ (rules/, skills/,
# settings.json, hooks/) is tracked team configuration.
.claude/worktrees/

# Claude Code per-user settings; settings.json beside it is the shared one.
.claude/settings.local.json

# Local Android developer signing material created by build/Install-AndroidApp.ps1.
# Never commit a keystore or its password; release signing comes from repo secrets.
build/.local/

# azd environment state (azure.yaml, infra/sync/). Holds the resolved
# subscription, resource group and every provisioning output for a named
# environment, per developer machine. Deployment targets that matter are written
# down in docs/deployment/sync.md instead.
.azure/

# The type declarations Claude Code lays beside a plugin of function hooks when it loads one
# from this checkout (backlog-tools' plan-progress pane), regenerated per release.
plugins/*/.claude-plugin/types/
