<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.3" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <!--
      Opted in to the Aspire CLI bundle: `dotnet run` on this project acquires
      the CLI pinned to the Aspire.AppHost.Sdk version above through dnx and
      delegates to `aspire run`, so a machine without the Aspire CLI installed
      gets the matching one rather than a different one. The first run on a
      machine downloads it. ASPIRE010, the advisory for staying opted out, is no
      longer suppressed: nothing here should silence an Aspire advisory now that
      the deferral it covered is over.
    -->
    <AspireUseCliBundle>true</AspireUseCliBundle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.DevTunnels" />
    <PackageReference Include="Aspire.Hosting.Foundry" />
    <PackageReference Include="Aspire.Hosting.Maui" />
  </ItemGroup>
</Project>
