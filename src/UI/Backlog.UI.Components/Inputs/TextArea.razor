@*
    Auto-grow is the CSS-only trick the raw editor already uses: a `.grow-wrap`
    whose ::after replica carries the same text and the same font metrics sets
    the grid track, and the textarea stretches to fill it. No JS, no resize
    observer, no flicker on the first paint.
*@

<div class="@ClassValue" data-testid="@TestId">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="field__label" for="@FieldId">@Label</label>
    }
    <div class="@WrapClass" data-replicated-value="@Value">
        <textarea id="@FieldId"
                  class="field__input"
                  rows="@Rows"
                  placeholder="@Placeholder"
                  disabled="@Disabled"
                  readonly="@Readonly"
                  aria-invalid="@(HasError ? "true" : null)"
                  aria-describedby="@DescribedBy"
                  aria-label="@(string.IsNullOrWhiteSpace(Label) ? AriaLabel : null)"
                  @oninput="OnInput"
                  @attributes="AdditionalAttributes">@Value</textarea>
    </div>
    @if (!string.IsNullOrWhiteSpace(HelpText))
    {
        <p id="@HelpId" class="field__help">@HelpText</p>
    }
    @if (HasError)
    {
        <Alert Message="@ErrorMessage" CssClass="field__error" Id="@ErrorId" />
    }
</div>

@code {
    private readonly string _id = "field-" + Guid.NewGuid().ToString("N");

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Readonly { get; set; }

    [Parameter]
    public bool AutoGrow { get; set; } = true;

    [Parameter]
    public int Rows { get; set; } = 3;

    [Parameter]
    public string? HelpText { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string FieldId => string.IsNullOrWhiteSpace(Id) ? _id : Id;

    private string HelpId => FieldId + "-help";

    private string ErrorId => FieldId + "-error";

    private bool HasError => !string.IsNullOrWhiteSpace(ErrorMessage);

    private string WrapClass => AutoGrow ? "grow-wrap field__grow" : "field__grow";

    private string? DescribedBy
    {
        get
        {
            var parts = new List<string>(2);
            if (!string.IsNullOrWhiteSpace(HelpText)) parts.Add(HelpId);
            if (HasError) parts.Add(ErrorId);

            return parts.Count == 0 ? null : string.Join(' ', parts);
        }
    }

    private string ClassValue
    {
        get
        {
            var error = HasError ? " field--invalid" : string.Empty;
            var extra = string.IsNullOrWhiteSpace(CssClass) ? string.Empty : " " + CssClass;
            return $"field field--textarea{error}{extra}";
        }
    }

    private Task OnInput(ChangeEventArgs e)
    {
        // The replica reads from Value, so it has to be current before the next
        // render or the box lags one keystroke behind the text.
        Value = e.Value?.ToString() ?? string.Empty;
        return ValueChanged.InvokeAsync(Value);
    }
}
