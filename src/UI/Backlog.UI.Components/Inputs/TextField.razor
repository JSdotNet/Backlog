@*
    A labelled single-line field. The help text and the error message are wired
    into `aria-describedby` rather than left floating next to the input, so the
    reason a value was rejected reaches a screen reader with the field.
*@

<div class="@ClassValue" data-testid="@TestId">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="field__label" for="@FieldId">@Label</label>
    }
    <input id="@FieldId"
           class="field__input"
           type="@Type"
           value="@Value"
           placeholder="@Placeholder"
           disabled="@Disabled"
           readonly="@Readonly"
           aria-invalid="@(HasError ? "true" : null)"
           aria-describedby="@DescribedBy"
           aria-label="@(string.IsNullOrWhiteSpace(Label) ? AriaLabel : null)"
           @oninput="OnInput"
           @attributes="AdditionalAttributes" />
    @if (!string.IsNullOrWhiteSpace(HelpText))
    {
        <p id="@HelpId" class="field__help">@HelpText</p>
    }
    @if (HasError)
    {
        <Alert Message="@ErrorMessage" CssClass="field__error" Id="@ErrorId" />
    }
</div>

@code {
    private readonly string _id = "field-" + Guid.NewGuid().ToString("N");

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Readonly { get; set; }

    /// <summary>One of text, number, url or email; anything else falls back to text.</summary>
    [Parameter]
    public string Type { get; set; } = "text";

    [Parameter]
    public string? HelpText { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string FieldId => string.IsNullOrWhiteSpace(Id) ? _id : Id;

    private string HelpId => FieldId + "-help";

    private string ErrorId => FieldId + "-error";

    private bool HasError => !string.IsNullOrWhiteSpace(ErrorMessage);

    private string? DescribedBy
    {
        get
        {
            var parts = new List<string>(2);
            if (!string.IsNullOrWhiteSpace(HelpText)) parts.Add(HelpId);
            if (HasError) parts.Add(ErrorId);

            return parts.Count == 0 ? null : string.Join(' ', parts);
        }
    }

    private string ClassValue
    {
        get
        {
            var error = HasError ? " field--invalid" : string.Empty;
            var extra = string.IsNullOrWhiteSpace(CssClass) ? string.Empty : " " + CssClass;
            return $"field field--text{error}{extra}";
        }
    }

    protected override void OnParametersSet()
    {
        if (Type is not ("text" or "number" or "url" or "email")) Type = "text";
    }

    private Task OnInput(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);
}
