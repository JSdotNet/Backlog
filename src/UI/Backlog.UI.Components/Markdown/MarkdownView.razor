@*
    The read view of an entry's body: what markdown looks like when you are not
    editing it. Sub-items are not here — a `##` heading is an item in its own
    right and is laid out as its own card below the entry (see Home.razor), so
    this renders only the prose above them. Checkboxes belong to `- [ ]` lines
    and only to those, and are only controls when someone is listening for the
    toggle — otherwise they are state, not buttons. Headings render at their
    level, both in size and to a screen reader, and #tags render as chips. Text
    is emitted through Razor's normal escaping, so nothing typed into an entry
    can inject markup.
*@

@foreach (var block in Blocks)
{
    switch (block)
    {
        case MdHeading heading:
            @* Still a <p>, so this never joins the host page's own outline, but
               carrying its level so heading navigation works at all. *@
            <p class="md-heading md-heading--@heading.Level" role="heading" aria-level="@heading.Level">@RenderInlines(heading.Content)</p>
            break;

        case MdParagraph paragraph:
            <p class="md-p">@RenderInlines(paragraph.Content)</p>
            break;

        case MdList list:
            @if (list.Ordered)
            {
                <ol class="md-list">
                    @foreach (var item in list.Items)
                    {
                        <li>@RenderInlines(item.Content)</li>
                    }
                </ol>
            }
            else
            {
                <ul class="md-list">
                    @foreach (var item in list.Items)
                    {
                        @* The task modifier belongs to the item, not the list: a
                           list can mix tasks and plain bullets, and the plain
                           ones must keep their marker. *@
                        <li class="@(item.Done is not null ? "md-item--task" : string.Empty) @(item.Done == true ? "md-item--done" : string.Empty)">
                            @if (item.Done is not null && CanToggle)
                            {
                                <button type="button"
                                        class="md-check @(item.Done == true ? "md-check--done" : string.Empty)"
                                        data-testid="entry-checkbox"
                                        role="checkbox"
                                        aria-checked="@(item.Done == true ? "true" : "false")"
                                        aria-label="@MarkdownRender.PlainText(item.Content)"
                                        @onmousedown:preventDefault="true"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => ToggleTaskItemAsync(item.TaskIndex!.Value)">@(item.Done == true ? "✔" : string.Empty)</button>
                            }
                            else if (item.Done is not null)
                            {
                                @* Nothing to toggle into: show the state without
                                   a control that would take focus and do nothing. *@
                                <span class="md-check @(item.Done == true ? "md-check--done" : string.Empty)"
                                      data-testid="entry-checkbox"
                                      role="img"
                                      aria-label="@(item.Done == true ? "Done" : "Not done")">@(item.Done == true ? "✔" : string.Empty)</span>
                            }
                            @RenderInlines(item.Content)
                        </li>
                    }
                </ul>
            }
            break;

        case MdQuote quote:
            <blockquote class="md-quote">@RenderInlines(quote.Content)</blockquote>
            break;
        case MdCode codeBlock:
            @if (DiagramView.IsDiagram(codeBlock.Language))
            {
                <DiagramView Title="Backlog diagram" Source="@codeBlock.Text" Language="@codeBlock.Language" />
            }
            else
            {
                <pre class="md-code"><code>@codeBlock.Text</code></pre>
            }
            break;

        case MdDivider:
            <hr class="md-divider" />
            break;
    }
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<MdBlock> Blocks { get; set; } = [];

    [Parameter]
    public EventCallback<int> OnTaskItemToggled { get; set; }

    private bool CanToggle => OnTaskItemToggled.HasDelegate;

    private RenderFragment RenderInlines(IReadOnlyList<MdInline> parts) => MarkdownRender.Inlines(parts);

    private Task ToggleTaskItemAsync(int taskIndex) => OnTaskItemToggled.InvokeAsync(taskIndex);
}
