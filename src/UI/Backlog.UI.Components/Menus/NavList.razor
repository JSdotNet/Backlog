<nav class="@ClassValue" role="navigation" aria-label="@AriaLabel" data-testid="@TestId" @attributes="AdditionalAttributes">
    <ul class="nav-list__items">
        @foreach (var item in Items)
        {
            <li class="nav-list__row">
                <NavLink class="nav-list__link"
                         href="@item.Href"
                         Match="@(item.Match ? NavLinkMatch.All : NavLinkMatch.Prefix)">@item.Label</NavLink>
            </li>
        }
    </ul>
</nav>

@code {
    [Parameter]
    public IReadOnlyList<NavItem> Items { get; set; } = [];

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ClassValue => string.IsNullOrWhiteSpace(CssClass) ? "nav-list" : $"nav-list {CssClass}";
}
