<div class="@ClassValue" role="group" aria-label="@AriaLabel" data-testid="@TestId" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ClassValue => string.IsNullOrWhiteSpace(CssClass) ? "btn-group" : $"btn-group {CssClass}";
}
