@*
    A tag reads as a chip. Clickable and removable are independent: filtering by
    a tag and dropping it are different intents, so they are different controls.
*@

<span class="@ClassValue" data-testid="@TestId" @attributes="AdditionalAttributes">
    @if (OnClick.HasDelegate)
    {
        <button type="button" class="tag-chip__label" @onclick="OnClick" disabled="@Disabled">@Text</button>
    }
    else
    {
        <span class="tag-chip__label">@Text</span>
    }
    @if (Removable)
    {
        @* A multiplication sign, not the letter x: the letter sits on the
           baseline and reads as part of the tag's text. *@
        <IconButton AriaLabel="@($"Remove {Text}")"
                    CssClass="tag-chip__remove"
                    Disabled="@Disabled"
                    OnClick="OnRemoveClicked">&#215;</IconButton>
    }
</span>

@code {
    [Parameter]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public bool Removable { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<string> OnRemove { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ClassValue => string.IsNullOrWhiteSpace(CssClass) ? "tag-chip" : $"tag-chip {CssClass}";

    private Task OnRemoveClicked() => OnRemove.InvokeAsync(Text);
}
