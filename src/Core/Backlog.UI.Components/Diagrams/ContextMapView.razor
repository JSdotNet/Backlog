@*
    The Domain view's Context map page (local ADR 0037): a Map | List bar that opens
    on Map. Map is ContextMapDiagram. List names the contexts in the Subdomain
    landscape table's reading order, Core first and Supporting after, each card its
    "Why" cell, then the published-languages chapter and the strategic rules as
    context-map.md writes them. A card on either tab hands its context to OnOpen.
*@

<section class="context-map-page" data-testid="@TestId" aria-label="Context map">
    <Tabs AriaLabel="Context map views"
          TestId="context-map-page-tabs"
          ActiveId="@_tab"
          ActiveIdChanged="@(id => _tab = id)">
        <TabPanel Id="map" Title="Map" TabTestId="context-map-page-tab-map" TestId="context-map-page-map-panel">
            <ContextMapDiagram Map="@Map" Layout="@Layout" OnOpen="OnOpen" />
        </TabPanel>
        <TabPanel Id="list" Title="List" TabTestId="context-map-page-tab-list" TestId="context-map-page-list-panel">
            <div class="context-map-list">
                @if (Map.IsEmpty)
                {
                    <EmptyState Title="No contexts"
                                Description="The context map's Mermaid fence names no bounded context."
                                TestId="context-map-list-empty" />
                }
                @foreach (var (title, contexts, key) in Groups())
                {
                    <section class="context-map-list__group" data-testid="context-map-list-group" data-kind="@key" aria-labelledby="@($"{_id}-{key}")">
                        <h3 class="context-map-list__heading" id="@($"{_id}-{key}")">@title</h3>
                        <ul class="context-map-list__cards">
                            @foreach (var context in contexts)
                            {
                                <li class="context-map-list__item">
                                    <button type="button"
                                            class="@(context.IsCore ? "context-map-list__card context-map-list__card--core" : "context-map-list__card")"
                                            data-testid="context-map-list-card"
                                            data-context="@context.Id"
                                            aria-disabled="@(OnOpen.HasDelegate && context.Slug is not null ? null : "true")"
                                            @onclick="@(() => OpenAsync(context))">
                                        <span class="context-map-list__name">@context.Name</span>
                                        <span class="context-map-list__count">@ContextMapDiagram.LinesWord(Map.LinesTouching(context.Id))</span>
                                        @if (context.Why.Length > 0)
                                        {
                                            <span class="context-map-list__why" data-testid="context-map-list-why">@context.Why</span>
                                        }
                                    </button>
                                </li>
                            }
                        </ul>
                    </section>
                }

                @if (Map.Languages.Length > 0)
                {
                    <section class="context-map-list__section" data-testid="context-map-list-languages" aria-labelledby="@($"{_id}-languages")">
                        <h3 class="context-map-list__heading" id="@($"{_id}-languages")">Published languages and contracts</h3>
                        <MarkdownView Blocks="@_languages"
                                      Source="@Map.Languages"
                                      DevbookDocumentPath="@DocumentPath"
                                      DevbookFolder="DevbookFolder.Domain"
                                      OnDevbookNavigate="OnNavigate" />
                    </section>
                }

                @if (Map.Rules.Length > 0)
                {
                    <section class="context-map-list__section" data-testid="context-map-list-rules" aria-labelledby="@($"{_id}-rules")">
                        <h3 class="context-map-list__heading" id="@($"{_id}-rules")">Strategic rules</h3>
                        <MarkdownView Blocks="@_rules"
                                      Source="@Map.Rules"
                                      DevbookDocumentPath="@DocumentPath"
                                      DevbookFolder="DevbookFolder.Domain"
                                      OnDevbookNavigate="OnNavigate" />
                    </section>
                }
            </div>
        </TabPanel>
    </Tabs>
</section>

@code {
    /// <summary>The context map, read by <see cref="ContextMaps.Read"/>.</summary>
    [Parameter]
    public ContextMap Map { get; set; } = ContextMap.Empty;

    /// <summary>The <c>context-map.md</c> the chapters are read from, which a
    /// relative link in them resolves against.</summary>
    [Parameter]
    public string? DocumentPath { get; set; }

    /// <summary>The tab the page opens on: <c>map</c> or <c>list</c>.</summary>
    [Parameter]
    public string InitialTab { get; set; } = "map";

    /// <summary>The map laid out for <see cref="Map"/>, when the host arranged it
    /// off the render thread.</summary>
    [Parameter]
    public ContextMapLayout? Layout { get; set; }

    /// <summary>A context card the reader picked, on Map or on List.</summary>
    [Parameter]
    public EventCallback<ContextMapContext> OnOpen { get; set; }

    /// <summary>A link in the published languages or the rules the reader followed.</summary>
    [Parameter]
    public EventCallback<DevbookReference> OnNavigate { get; set; }

    [Parameter]
    public string? TestId { get; set; } = "context-map-page";

    private readonly string _id = $"context-map-page-{Guid.NewGuid():N}";
    private string? _tab;
    private ContextMap? _parsed;
    private IReadOnlyList<MdBlock> _languages = [];
    private IReadOnlyList<MdBlock> _rules = [];

    protected override void OnParametersSet()
    {
        _tab ??= InitialTab;
        if (ReferenceEquals(_parsed, Map)) return;
        _parsed = Map;
        _languages = MarkdownPreview.ParseDocument(Map.Languages);
        _rules = MarkdownPreview.ParseDocument(Map.Rules);
    }

    private Task OpenAsync(ContextMapContext context) =>
        OnOpen.HasDelegate && context.Slug is not null ? OnOpen.InvokeAsync(context) : Task.CompletedTask;

    /// <summary>Core, then Supporting, then any other type the landscape table
    /// names, each in the table's order; a group with no context is left out.</summary>
    private IEnumerable<(string Title, IReadOnlyList<ContextMapContext> Contexts, string Key)> Groups()
    {
        var kinds = Map.Contexts.Select(c => c.Kind).Distinct(StringComparer.Ordinal)
            .OrderBy(k => k switch { "core" => 0, "supporting" => 1, _ => 2 })
            .ThenBy(k => k, StringComparer.Ordinal);
        foreach (var kind in kinds)
        {
            var contexts = Map.Contexts.Where(c => c.Kind == kind).ToList();
            static string Slug(string text) => System.Text.RegularExpressions.Regex.Replace(text, "[^a-z0-9]+", "-").Trim('-');
            var title = ContextMapDiagram.KindWord(contexts[0]);
            yield return (title, contexts, Slug(kind));
        }
    }
}
