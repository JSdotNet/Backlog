@implements IAsyncDisposable
@inject IJSRuntime Js

@*
    The C4 zoom tab: one model a reader zooms through a level at a time, where the C4
    tab (C4Explorer) lists views one by one. Both stand side by side behind the c4-zoom
    switch until the zoom tab is validated (local ADR 0037), so this shares the
    renderer — C4LayoutEngine, C4SvgWriter, C4Exploration — and changes nothing about
    how the C4 tab draws: the additions to the shared writer, the Zoom in chip and the
    selectable deployment-node frame, are options only this component sets, as is
    the layout's group bands (C4LayoutOptions.GroupBands). (The one
    shared change both tabs see is a layout fix: a deployment instance is drawn inside
    the deployment node that runs it, where the node used to be dropped.)

    It holds two things, the open view and the selected element. Everything the zoom
    bar says and everywhere a move goes is C4ZoomNavigation's, derived from those two.
    The selected element is shown beside the picture in C4ElementInspector, every
    element alike, a deployment node included; what the knowledge folders say about it
    is the host's, asked for through RecordsFor.

    The ways to move, and where each is handled:

    - Select: a click on a card, or Tab onto it. The viewer (backlogC4Zoom in
      components.js) reports it.
    - Zoom in: a double-click on a card, its Zoom in chip, or Enter on the focused
      card. The viewer reports all three as one call.
    - Zoom out: an earlier step on the bar, or Backspace. Backspace and Enter are
      listened for on the diagram's own frame, never on the document, so typing
      anywhere else in the app is never taken as a move.
*@

<div class="c4-zoom-explorer@(_playback.Count > 0 ? " c4-zoom-explorer--dynamic" : string.Empty)" data-testid="@TestId" role="region" aria-label="C4 zoom">
    @if (_view is null)
    {
        <EmptyState Title="No C4 views here yet" role="status">
            <DescriptionContent>
                The workspace declares no views. Add one in c4hero and it appears here.
            </DescriptionContent>
        </EmptyState>
    }
    else
    {
        <C4ZoomBar State="@_bar" OnStep="OpenStepAsync" OnAlso="OpenAlsoAsync" TestId="c4-zoom-bar" />

        @if (!HintDismissed && !_hintClosed)
        {
            <Callout Heading="Ways to move"
                     ActionLabel="Got it"
                     OnAction="DismissHintAsync"
                     ActionTestId="c4-zoom-hint-dismiss"
                     CssClass="c4-zoom-explorer__hint"
                     TestId="c4-zoom-hint">
                <ul class="c4-zoom-explorer__moves">
                    <li><strong>Zoom in:</strong> double-click an element, use its Zoom in chip, or press Enter on it.</li>
                    <li><strong>Zoom out:</strong> pick an earlier step in the zoom bar, or press Backspace.</li>
                    <li><strong>Jump:</strong> pick any step whose element is known.</li>
                    <li><strong>Sideways:</strong> Landscape, Dynamic and Deployment sit beside the bar under Also.</li>
                </ul>
            </Callout>
        }

        <header class="c4-zoom-explorer__head">
            <p class="c4-zoom-explorer__title" data-testid="c4-zoom-title">@C4Exploration.Label(Workspace, _view)</p>
            <p class="c4-zoom-explorer__key" data-testid="c4-zoom-key">@_view.Key</p>
        </header>

        @* Focusable as a whole, so Backspace has somewhere to land on a view with no
           card focused. Every card is made focusable by the viewer. *@
        RenderFragment frame = @<div class="c4-zoom-explorer__frame"
             id="@_frameId"
             tabindex="0"
             role="group"
             aria-label="@($"{C4Exploration.Label(Workspace, _view)}. Enter zooms into the focused element, Backspace zooms out.")"
             data-testid="c4-zoom-frame">
            <C4DiagramView Diagram="@DiagramFor(_view)"
                           Id="@_svgId"
                           AriaLabel="@C4Exploration.Label(Workspace, _view)"
                           Options="@_options"
                           TestId="c4-zoom-diagram" />
        </div>;

        @* A deployment view whose scope is deployed to more than one environment puts
           the picture behind one tab per environment; the frame is the open tab's
           panel. Any other view is the frame alone. *@
        @* The picture, and beside it the inspector of the element selected on it. *@
        <div class="c4-zoom-explorer__body">
        <div class="c4-zoom-explorer__stage">
        @if (_environments.Count > 1)
        {
            <Tabs Bare="true"
                  ActiveId="@EnvironmentTabId(_environments.First(environment => environment.Current))"
                  ActiveIdChanged="OpenEnvironmentTabAsync"
                  AriaLabel="Deployment environment"
                  ListCssClass="c4-zoom-explorer__environments"
                  TabCssClass="c4-zoom-explorer__environment-tab"
                  ActiveTabCssClass="c4-zoom-explorer__environment-tab c4-zoom-explorer__environment-tab--active"
                  ListTestId="c4-zoom-environments">
                @foreach (var environment in _environments)
                {
                    @* Out of the Tab order: the frame inside it is the stop. *@
                    <TabPanel @key="environment.ViewKey"
                              Id="@EnvironmentTabId(environment)"
                              Title="@environment.Name"
                              BaseClass="c4-zoom-explorer__environment"
                              TabTestId="c4-zoom-environment-tab"
                              tabindex="-1">
                        @frame
                    </TabPanel>
                }
            </Tabs>
        }
        else
        {
            @frame
        }
        </div>

        @if (_inspected is not null)
        {
            <C4ElementInspector Element="@_inspected"
                                ZoomLabel="@_zoomLabel"
                                OnZoomIn="ZoomIntoSelectedAsync"
                                Deployment="@_deploymentNode"
                                OnOpenContainer="OpenContainerAsync"
                                Records="@_records"
                                OnOpenRecord="OpenRecordAsync" />
        }
        </div>

        @if (_doors.Count > 0)
        {
            <div class="c4-zoom-explorer__deployment" data-testid="c4-zoom-deployment">
                <C4DeploymentDoors Doors="@_doors" OnOpen="OpenEnvironmentAsync" />
            </div>
        }

        @* A dynamic view plays its steps: the panel beside the picture, the current
           step's arrow drawn in the primary colour by C4SvgWriter's step options. *@
        @if (_playback.Count > 0)
        {
            <C4DynamicSteps Steps="@_playback"
                            Current="@_stepIndex"
                            Playing="@_playing"
                            ReducedMotion="@_reducedMotion"
                            OnPrevious="PreviousStep"
                            OnNext="NextStep"
                            OnPlay="Play"
                            OnPick="PickStep" />
        }

        <footer class="c4-zoom-explorer__foot">
            <p class="c4-zoom-explorer__legend" data-testid="c4-zoom-legend">Double-click an element, or its Zoom in chip, to open the next level. Backspace goes back up.</p>

            @if (_view.Kind == C4ViewKind.Deployment)
            {
                <p class="c4-zoom-explorer__legend" data-testid="c4-zoom-deployment-legend">Frame: deployment node, select it to see what it runs. Dashed: another environment, drawn as a door.</p>
            }

            @if (Problems.Count > 0)
            {
                <Alert Message="@($"{Problems.Count} thing{(Problems.Count == 1 ? string.Empty : "s")} in this workspace could not be read, so the pictures may be incomplete.")"
                       TestId="c4-zoom-problems"
                       Role="status" />
            }
        </footer>
    }
</div>

@code {
    private readonly string _frameId = "c4-zoom-frame-" + Guid.NewGuid().ToString("N");

    /// <summary>The svg's own id. Stable for the life of the component, because the
    /// viewer strips it off a card's id to get the alias.</summary>
    private readonly string _svgId = "c4-zoom-svg-" + Guid.NewGuid().ToString("N");

    private DotNetObjectReference<C4ZoomExplorer>? _self;
    private IReadOnlyList<C4Node> _nodes = [];
    private C4View? _view;
    private string? _selectedId;
    private string? _loadedFor;
    private C4ZoomBarState _bar = C4ZoomBarState.Empty;
    private C4SvgOptions _options = C4SvgOptions.None;
    private bool _hintClosed;
    private bool _attached;

    /// <summary>On a deployment view: the environments of its scope, the doors to the
    /// other ones, and the deployment node selected, if one is. Empty and null on any
    /// other view.</summary>
    private IReadOnlyList<C4DeploymentEnvironment> _environments = [];
    private IReadOnlyList<C4DeploymentEnvironment> _doors = [];
    private C4DeploymentNodeDetails? _deploymentNode;

    /// <summary>The selected element as the inspector shows it, the view one level
    /// below it (null when there is none) with what the zoom-in button says about it,
    /// and what the host's knowledge folders say about it. All null with nothing
    /// selected.</summary>
    private C4Element? _inspected;
    private string? _zoomTarget;
    private string? _zoomLabel;
    private C4ElementRecords? _records;

    /// <summary>Set by a move the viewer reported — a zoom from the picture — so the
    /// next picture takes the keyboard focus back. A move from the bar leaves the focus
    /// on the bar. Cleared on the attach that honours it.</summary>
    private bool _refocus;

    /// <summary>The layout this tab asks for: outside systems a <c>group</c> block
    /// gathered are kept together in a labelled band, as the design's landscape draws
    /// them. The C4 tab asks for none and draws what it always drew.</summary>
    private static readonly C4LayoutOptions ZoomLayout = new(GroupBands: true);

    private C4Diagram? _diagram;
    private C4Workspace? _diagramWorkspace;
    private string? _diagramViewKey;
    private C4Diagram? _attachedDiagram;

    /// <summary>The selection the viewer was last told about, so a render that
    /// leaves it alone costs no interop call.</summary>
    private string? _shownSelection;

    private IReadOnlyList<C4PlaybackStep> _playback = [];
    private string? _playbackView;
    private int _stepIndex;
    private bool _playing;
    private bool _reducedMotion;
    private bool _reducedMotionRead;
    private CancellationTokenSource? _play;
    private bool _disposed;
    private C4SvgOptions? _attachedOptions;

    [Parameter, EditorRequired]
    public C4Workspace Workspace { get; set; } = C4Workspace.Empty;

    /// <summary>Everything the reader could not be shown, counted under the diagram.</summary>
    [Parameter]
    public IReadOnlyList<C4Problem> Problems { get; set; } = [];

    /// <summary>Whether this reader already dismissed the ways-to-move hint. The host
    /// keeps it, per user; this component only reports the dismissal.</summary>
    [Parameter]
    public bool HintDismissed { get; set; }

    /// <summary>The hint was dismissed. The host remembers it so the next opening
    /// shows none.</summary>
    [Parameter]
    public EventCallback OnHintDismissed { get; set; }

    [Parameter]
    public string? TestId { get; set; } = "c4-zoom-explorer";

    /// <summary>
    /// What the knowledge folders say about an element, by its model identifier: the
    /// chapters that document it and the decisions and debt that name it, shown in the
    /// inspector. The component library has no idea what a chapter is, so the host
    /// works it out. Null — a host with no folder behind it — leaves those sections out
    /// of the inspector.
    /// </summary>
    [Parameter]
    public Func<string, C4ElementRecords>? RecordsFor { get; set; }

    /// <summary>A chapter or a record was picked in the inspector, by the path
    /// <see cref="RecordsFor"/> handed it with. The host opens it.</summary>
    [Parameter]
    public EventCallback<string> OnOpenRecord { get; set; }

    /// <summary>How long Play holds each step of a dynamic view before the next.</summary>
    [Parameter]
    public TimeSpan PlayInterval { get; set; } = TimeSpan.FromSeconds(1.6);

    /// <summary>
    /// A view the host asks to have opened — an arc42 chapter's "Open in C4 zoom".
    /// <para>
    /// A request rather than a bound view key: the reader moves on from it by zooming,
    /// and asking for the same view again has to open it again. So each request is a
    /// new <see cref="C4ZoomOpen"/>, honoured once, and matched by reference.
    /// </para>
    /// </summary>
    [Parameter]
    public C4ZoomOpen? OpenView { get; set; }

    private C4ZoomOpen? _openedRequest;

    /// <summary>Honours a new <see cref="OpenView"/> after the workspace is loaded.
    /// Its own override, so the load above it reads as it did.</summary>
    protected override Task OnParametersSetAsync()
    {
        HonourOpenRequest();
        return Task.CompletedTask;
    }

    private void HonourOpenRequest()
    {
        if (OpenView is not { } request || ReferenceEquals(request, _openedRequest)) return;

        _openedRequest = request;
        Open(request.ViewKey, request.SelectId);
    }

    /// <summary>The element selected now, by its model identifier. For the host and
    /// for tests; the zoom bar is drawn from it.</summary>
    public string? SelectedElementId => _selectedId;

    /// <summary>The view open now.</summary>
    public string? ViewKey => _view?.Key;

    protected override void OnParametersSet()
    {
        // Keyed on the workspace's identity, as the C4 tab's explorer is: a reload
        // hands over a fresh record, and re-deriving is cheaper than diffing it.
        var key = $"{Workspace.Name}#{Workspace.Views.Count}#{Workspace.Elements.Count}";
        if (string.Equals(_loadedFor, key, StringComparison.Ordinal) && _view is not null && Workspace.View(_view.Key) is not null)
        {
            Refresh();
            return;
        }

        _loadedFor = key;
        _selectedId = null;
        _view = C4ZoomNavigation.StartView(Workspace);
        Refresh();
    }

    /// <summary>Re-reads the open view's cards, the bar and the chips after a move.</summary>
    private void Refresh()
    {
        if (_view is null)
        {
            _nodes = [];
            _bar = C4ZoomBarState.Empty;
            _environments = [];
            _doors = [];
            _deploymentNode = null;
            _inspected = null;
            _zoomTarget = null;
            _zoomLabel = null;
            _records = null;
            return;
        }

        // A reload may hand a fresh record for the same key; the view itself is read
        // from the workspace that is current now.
        _view = Workspace.View(_view.Key) ?? _view;
        _nodes = C4Exploration.Nodes(Workspace, _view);
        _bar = C4ZoomNavigation.Bar(Workspace, _view, _selectedId);

        var zoomable = _nodes
            .Where(node => C4ZoomNavigation.ZoomInView(Workspace, _view, node.ElementId) is not null)
            .Select(node => node.Alias)
            .ToHashSet(StringComparer.Ordinal);

        RefreshPlayback();

        var numberSteps = _playback.Count > 0;
        int? currentStep = numberSteps ? _playback[_stepIndex].Order : null;

        // A deployment node that runs something is drawn as a frame; on a deployment
        // view the frame is selectable, because the node is what a reader asks about.
        var frames = _view.Kind == C4ViewKind.Deployment
            ? C4ZoomDeployment.SelectableFrames(DiagramFor(_view))
            : null;

        if (_options.ZoomInAliases is null
            || !_options.ZoomInAliases.SetEquals(zoomable)
            || !SameSet(_options.SelectableBoundaryAliases, frames)
            || _options.NumberSteps != numberSteps
            || _options.CurrentStep != currentStep)
        {
            _options = new C4SvgOptions(zoomable, numberSteps, currentStep) { SelectableBoundaryAliases = frames };
        }

        _environments = C4ZoomDeployment.Environments(Workspace, _view);
        _doors = [.. _environments.Where(environment => !environment.Current)];
        _deploymentNode = _view.Kind == C4ViewKind.Deployment ? C4ZoomDeployment.Details(Workspace, _selectedId) : null;

        _inspected = Workspace.Element(_selectedId);
        _zoomTarget = _inspected is null ? null : C4ZoomNavigation.ZoomInView(Workspace, _view, _inspected.Id);
        _zoomLabel = _zoomTarget is null || _inspected is null ? null : ZoomLabelFor(_inspected, Workspace.View(_zoomTarget));
        _records = RecordsOf(_inspected);
    }

    private Func<string, C4ElementRecords>? _recordsAskedOf;
    private string? _recordsAskedFor;

    /// <summary>The host's records for the inspected element, asked for again only
    /// when the element or the host's delegate changed: a refresh runs on every Play
    /// step and every parent render, and the host's answer walks the views. A host
    /// hands a new delegate when what it reads from changed.</summary>
    private C4ElementRecords? RecordsOf(C4Element? element)
    {
        if (element is null || RecordsFor is null)
        {
            _recordsAskedOf = null;
            _recordsAskedFor = null;
            return null;
        }

        if (ReferenceEquals(_recordsAskedOf, RecordsFor)
            && string.Equals(_recordsAskedFor, element.Id, StringComparison.Ordinal)
            && _records is not null)
        {
            return _records;
        }

        _recordsAskedOf = RecordsFor;
        _recordsAskedFor = element.Id;
        return RecordsFor(element.Id);
    }

    /// <summary>
    /// What the inspector's zoom-in button says: "Open its 11 components", the way the
    /// design words it, when the view below is the element's own containers or
    /// components; "Zoom in" for any other deeper view — a system's context, say.
    /// </summary>
    private string ZoomLabelFor(C4Element element, C4View? next)
    {
        var (kind, noun) = next?.Kind switch
        {
            C4ViewKind.Container => (C4ElementKind.Container, "container"),
            C4ViewKind.Component => (C4ElementKind.Component, "component"),
            _ => ((C4ElementKind?)null, (string?)null)
        };

        if (kind is null) return "Zoom in";

        var count = Workspace.Elements.Count(candidate => candidate.Kind == kind
            && string.Equals(candidate.ParentId, element.Id, StringComparison.OrdinalIgnoreCase));

        return count == 0 ? "Zoom in" : $"Open its {count} {noun}{(count == 1 ? string.Empty : "s")}";
    }

    /// <summary>The inspector's zoom-in button: the view below the selected element,
    /// with the keyboard handed to the new picture as a zoom from the picture does.</summary>
    private Task ZoomIntoSelectedAsync()
    {
        if (_zoomTarget is null) return Task.CompletedTask;

        Open(_zoomTarget, null);
        _refocus = true;
        return Task.CompletedTask;
    }

    private Task OpenRecordAsync(string path) => OnOpenRecord.InvokeAsync(path);

    private static bool SameSet(IReadOnlySet<string>? left, IReadOnlySet<string>? right) =>
        left is null ? right is null : right is not null && left.SetEquals(right);

    // ---- playing a dynamic view --------------------------------------------------

    /// <summary>The open view's steps, re-read on every refresh; a newly opened view
    /// starts on its first step with nothing playing.</summary>
    private void RefreshPlayback()
    {
        _playback = _view is null ? [] : C4DynamicPlayback.Steps(Workspace, _view);

        if (!string.Equals(_playbackView, _view?.Key, StringComparison.OrdinalIgnoreCase))
        {
            _playbackView = _view?.Key;
            _stepIndex = 0;
            StopPlaying();
        }

        _stepIndex = _playback.Count == 0 ? 0 : Math.Clamp(_stepIndex, 0, _playback.Count - 1);
    }

    /// <summary>The step drawn as current now, by its number; null off a dynamic view.
    /// For the host and for tests.</summary>
    public int? CurrentStep => _playback.Count > 0 ? _playback[_stepIndex].Order : null;

    /// <summary>Whether Play is walking the steps now. For the host and for tests.</summary>
    public bool Playing => _playing;

    private void MoveTo(int index)
    {
        _stepIndex = _playback.Count == 0 ? 0 : Math.Clamp(index, 0, _playback.Count - 1);
        Refresh();
    }

    private void PreviousStep()
    {
        StopPlaying();
        MoveTo(C4DynamicPlayback.Previous(_stepIndex, _playback.Count));
    }

    private void NextStep()
    {
        StopPlaying();
        MoveTo(C4DynamicPlayback.Next(_stepIndex, _playback.Count));
    }

    private void PickStep(int index)
    {
        StopPlaying();
        MoveTo(index);
    }

    /// <summary>
    /// Play walks forward one step per <see cref="PlayInterval"/> and stops on the last;
    /// pressed while playing it pauses, and pressed on the last step it starts again
    /// from the first.
    /// <para>
    /// A reader who asked for reduced motion gets no timed walk: the picture would
    /// change under them unasked. Play then moves one step per press, wrapping from the
    /// last to the first. The preference is read once, when the first steps panel is
    /// drawn, so a press never waits on script: two quick presses are a play and a
    /// pause, never two walks.
    /// </para>
    /// </summary>
    private void Play()
    {
        if (_playback.Count == 0) return;

        if (_playing)
        {
            StopPlaying();
            return;
        }

        var last = _playback.Count - 1;

        if (_reducedMotion)
        {
            MoveTo(_stepIndex >= last ? 0 : _stepIndex + 1);
            return;
        }

        if (_stepIndex >= last) MoveTo(0);

        if (_disposed) return;

        _playing = true;
        _play = new CancellationTokenSource();
        _ = WalkAsync(_play.Token);
    }

    /// <summary>The timed walk Play starts. Every move is made on the renderer's own
    /// context, and a cancelled walk — a press, a new view, the tab closing — makes no
    /// further move.</summary>
    private async Task WalkAsync(CancellationToken token)
    {
        try
        {
            while (_stepIndex < _playback.Count - 1)
            {
                await Task.Delay(PlayInterval, token);
                await InvokeAsync(() =>
                {
                    if (token.IsCancellationRequested) return;
                    MoveTo(_stepIndex + 1);
                    StateHasChanged();
                });
                token.ThrowIfCancellationRequested();
            }

            await InvokeAsync(() =>
            {
                if (token.IsCancellationRequested) return;
                StopPlaying();
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void StopPlaying()
    {
        _playing = false;
        _play?.Cancel();
        _play?.Dispose();
        _play = null;
    }

    private async Task<bool> ReducedMotionAsync()
    {
        try
        {
            return await Js.InvokeAsync<bool>("backlogC4Zoom.reducedMotion");
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or InvalidOperationException)
        {
            return false;
        }
    }

    // ---- deployment ------------------------------------------------------------

    /// <summary>A tab's id: unique on the page, because the tab list writes it into
    /// the DOM. By position rather than by view key, because two keys can slug alike;
    /// the list only changes with the scope, and the tabs go with it.</summary>
    private string EnvironmentTabId(C4DeploymentEnvironment environment) =>
        $"{_frameId}-environment-{IndexOf(environment)}";

    private int IndexOf(C4DeploymentEnvironment environment)
    {
        for (var index = 0; index < _environments.Count; index++)
        {
            if (string.Equals(_environments[index].ViewKey, environment.ViewKey, StringComparison.OrdinalIgnoreCase)) return index;
        }

        return -1;
    }

    private Task OpenEnvironmentTabAsync(string tabId)
    {
        if (_environments.FirstOrDefault(environment => string.Equals(EnvironmentTabId(environment), tabId, StringComparison.Ordinal)) is { } environment)
        {
            return OpenEnvironmentAsync(environment);
        }

        return Task.CompletedTask;
    }

    /// <summary>A tab or a door: the view of that environment, nothing selected, since
    /// a node of one environment is not drawn in another.</summary>
    private Task OpenEnvironmentAsync(C4DeploymentEnvironment environment)
    {
        if (environment.Current) return Task.CompletedTask;

        Open(environment.ViewKey, null);
        return Task.CompletedTask;
    }

    /// <summary>"Show in containers" on an instance the selected node runs: the
    /// containers view with that container selected.</summary>
    private Task OpenContainerAsync(C4DeploymentInstance instance)
    {
        Open(instance.ContainersViewKey, instance.ContainerId);

        // The button goes with the inspector, so the keyboard goes to the container
        // card it named rather than falling to the page.
        _refocus = true;
        return Task.CompletedTask;
    }

    private C4Diagram DiagramFor(C4View view)
    {
        if (_diagram is null
            || !ReferenceEquals(_diagramWorkspace, Workspace)
            || !string.Equals(_diagramViewKey, view.Key, StringComparison.OrdinalIgnoreCase))
        {
            _diagram = C4LayoutEngine.Build(Workspace, view, ZoomLayout);
            _diagramWorkspace = Workspace;
            _diagramViewKey = view.Key;
        }

        return _diagram;
    }

    // ---- moving ----------------------------------------------------------------

    /// <summary>Opens a view and leaves <paramref name="selectId"/> selected on it.</summary>
    private void Open(string? viewKey, string? selectId)
    {
        if (Workspace.View(viewKey) is not { } next) return;

        _view = next;
        _selectedId = selectId;
        Refresh();
    }

    private Task OpenStepAsync(C4ZoomStep step)
    {
        if (!step.Enabled) return Task.CompletedTask;

        Open(step.ViewKey, step.SelectId);
        return Task.CompletedTask;
    }

    private Task OpenAlsoAsync(C4ZoomAlso also)
    {
        if (also.Current) return Task.CompletedTask;

        Open(also.ViewKey, null);
        return Task.CompletedTask;
    }

    /// <summary>A card was clicked or focused on the view named.</summary>
    [JSInvokable]
    public Task NodeSelected(string alias, string? viewKey)
    {
        if (!IsOpen(viewKey) || NodeOf(alias) is not { } node) return Task.CompletedTask;
        if (string.Equals(_selectedId, node.ElementId, StringComparison.OrdinalIgnoreCase)) return Task.CompletedTask;

        _selectedId = node.ElementId;
        _shownSelection = node.Alias;
        Refresh();
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// A double-click, a Zoom in chip, or Enter on a focused card.
    /// <para>
    /// An element with nothing deeper is selected and nothing opens: the press is
    /// still about that element, and selecting it is the visible answer.
    /// </para>
    /// </summary>
    [JSInvokable]
    public Task ZoomIn(string alias, string? viewKey)
    {
        if (!IsOpen(viewKey) || _view is null || NodeOf(alias) is not { } node) return Task.CompletedTask;

        if (C4ZoomNavigation.ZoomInView(Workspace, _view, node.ElementId) is { } next)
        {
            Open(next, null);
            _refocus = true;
        }
        else
        {
            _selectedId = node.ElementId;
            Refresh();
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Backspace on the diagram: one level up, the view left behind
    /// selected.</summary>
    [JSInvokable]
    public Task ZoomOut(string? viewKey)
    {
        if (!IsOpen(viewKey) || _view is null) return Task.CompletedTask;
        if (C4ZoomNavigation.ZoomOut(Workspace, _view) is not { } target) return Task.CompletedTask;

        Open(target.ViewKey, target.SelectId);
        _refocus = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Whether a report from the viewer is about the picture on screen now. A
    /// press on the old picture that lands after a move is dropped, not applied to the
    /// new one.</summary>
    private bool IsOpen(string? viewKey) =>
        _view is not null && (viewKey is null || string.Equals(viewKey, _view.Key, StringComparison.OrdinalIgnoreCase));

    private C4Node? NodeOf(string alias) =>
        _nodes.FirstOrDefault(candidate => string.Equals(candidate.Alias, alias, StringComparison.Ordinal));

    private string? SelectedAlias =>
        _selectedId is null
            ? null
            : _nodes.FirstOrDefault(node => string.Equals(node.ElementId, _selectedId, StringComparison.OrdinalIgnoreCase))?.Alias;

    private async Task DismissHintAsync()
    {
        _hintClosed = true;
        await OnHintDismissed.InvokeAsync();
    }

    // ---- the viewer ------------------------------------------------------------

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_view is null || _diagram is null)
        {
            _attachedDiagram = null;
            return;
        }

        // A dynamic view tells the reader up front that Play will not move on its
        // own, so the preference is read once the first steps panel is on screen —
        // and only then, so a Play press never has to wait on script.
        if (_playback.Count > 0 && !_reducedMotionRead)
        {
            _reducedMotionRead = true;
            if (await ReducedMotionAsync())
            {
                _reducedMotion = true;
                StateHasChanged();
            }
        }

        // A new current step rewrites the picture, and the cards the viewer made
        // focusable go with it, so the picture is handed over again.
        if (!ReferenceEquals(_diagram, _attachedDiagram) || !ReferenceEquals(_options, _attachedOptions))
        {
            await AttachAsync(_diagram);
            return;
        }

        // The same picture with another selection: a step on the bar that stayed on
        // this view, or an element with nothing deeper.
        if (!string.Equals(_shownSelection, SelectedAlias, StringComparison.Ordinal))
        {
            _shownSelection = SelectedAlias;
            await InvokeViewerAsync("backlogC4Zoom.select", _frameId, _shownSelection);
        }
    }

    private async Task AttachAsync(C4Diagram diagram)
    {
        _self ??= DotNetObjectReference.Create(this);
        _attached = true;
        _attachedDiagram = diagram;
        _attachedOptions = _options;
        _shownSelection = SelectedAlias;

        var refocus = _refocus;
        _refocus = false;

        // The full names, because a card's drawn name is cut to fit it and the
        // accessible name should not be.
        var names = _nodes
            .GroupBy(node => node.Alias, StringComparer.Ordinal)
            .ToDictionary(group => group.Key, group => group.First().Name, StringComparer.Ordinal);

        try
        {
            var took = await Js.InvokeAsync<bool>(
                "backlogC4Zoom.attach",
                _frameId,
                _self,
                _view?.Key,
                _shownSelection,
                refocus,
                names);

            if (!took && ReferenceEquals(_attachedDiagram, diagram)) _attachedDiagram = null;
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // No viewer, or no circuit to reach one through. The bar still moves
            // between levels; only the gestures on the picture are lost.
            if (ReferenceEquals(_attachedDiagram, diagram)) _attachedDiagram = null;
        }
    }

    private async Task InvokeViewerAsync(string identifier, params object?[] arguments)
    {
        try
        {
            await Js.InvokeVoidAsync(identifier, arguments);
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or InvalidOperationException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        StopPlaying();

        // Only after a viewer was asked for: a prerender disposes the component
        // without ever reaching OnAfterRender.
        if (_attached)
        {
            try
            {
                await Js.InvokeVoidAsync("backlogC4Zoom.dispose", _frameId);
            }
            catch (Exception exception) when (exception is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
            {
            }
        }

        _self?.Dispose();
    }
}
