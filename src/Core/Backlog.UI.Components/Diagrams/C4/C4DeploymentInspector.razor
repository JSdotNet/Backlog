@*
    The inspector of a selected deployment node on the C4 zoom tab's deployment view:
    what kind of node it is and on what technology, what it is for, and the container
    instances it runs, each a way back into the containers view with that container
    selected.

    It draws a C4DeploymentNodeDetails and nothing else; C4ZoomDeployment works out what
    a node runs and where each container is shown.
*@

<aside class="c4-deployment-inspector" aria-label="Selected node" data-testid="@TestId">
    <p class="c4-deployment-inspector__kicker" data-testid="c4-deployment-inspector-kind">@Kicker</p>
    <h3 class="c4-deployment-inspector__name" data-testid="c4-deployment-inspector-name">@Details.Name</h3>

    @if (Details.Description is not null)
    {
        <p class="c4-deployment-inspector__description" data-testid="c4-deployment-inspector-description">@Details.Description</p>
    }

    <section class="c4-deployment-inspector__section" aria-labelledby="@_runsId">
        <h4 class="c4-deployment-inspector__heading" id="@_runsId">Runs</h4>

        @if (Details.Runs.Count == 0)
        {
            <p class="c4-deployment-inspector__none" data-testid="c4-deployment-inspector-none">No container instance is deployed here.</p>
        }
        else
        {
            <ul class="c4-deployment-inspector__runs">
                @foreach (var instance in Details.Runs)
                {
                    <li class="c4-deployment-inspector__run" data-testid="c4-deployment-instance">
                        <span class="c4-deployment-inspector__run-name">
                            @instance.Name
                            @if (instance.Technology is not null)
                            {
                                <span class="c4-deployment-inspector__run-tech">@instance.Technology</span>
                            }
                        </span>

                        @if (instance.ContainersViewKey is not null)
                        {
                            <AppButton BaseClass="c4-deployment-inspector__open"
                                       Variant="ButtonVariant.None"
                                       aria-label="@($"Show {instance.Name} in containers")"
                                       TestId="c4-deployment-instance-open"
                                       OnClick="() => OnOpenContainer.InvokeAsync(instance)">Show in containers</AppButton>
                        }
                    </li>
                }
            </ul>
        }
    </section>
</aside>

@code {
    private readonly string _runsId = "c4-deployment-runs-" + Guid.NewGuid().ToString("N");

    /// <summary>The node selected. <see cref="C4ZoomDeployment.Details"/> builds it.</summary>
    [Parameter, EditorRequired]
    public C4DeploymentNodeDetails Details { get; set; } = default!;

    /// <summary>A container instance's "Show in containers" was pressed. Offered only
    /// for an instance whose container has a container view.</summary>
    [Parameter]
    public EventCallback<C4DeploymentInstance> OnOpenContainer { get; set; }

    [Parameter]
    public string? TestId { get; set; } = "c4-deployment-inspector";

    /// <summary>"Deployment Node · MSIX": the kind, and the technology when the model
    /// names one, the way the design's inspector heads a node.</summary>
    private string Kicker => Details.Technology is null ? Details.Kind : $"{Details.Kind} · {Details.Technology}";
}
