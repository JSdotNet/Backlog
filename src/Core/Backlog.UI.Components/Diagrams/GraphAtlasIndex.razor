@*
    The atlas's node list, and the surface that actually answers for it.

    A canvas has no accessibility tree, and a node drawn at seventeen pixels
    across cannot be a 44px target however it is styled — so the picture is not
    the interactive surface and pretending otherwise would fail both rules at
    once. This list is where selection lives: it is focusable, it is ordered, it
    prints every fact the marks encode, and the canvas is a pointer shortcut onto
    the same model.

    That is why it is visible rather than screen-reader-only. A hidden mirror is a
    second implementation nobody looks at, and it rots the first time the picture
    changes and the mirror does not.

    Roving tabindex: one row is tabbable and the arrows move between them, so the
    list is one stop on the page rather than one stop per technology.

    Moving is not choosing. The arrows, Home and End move the focus — and the
    active row, which the host may spotlight on its picture — and leave the
    selection alone; Enter or Space selects the focused row, and so does a
    click. A selection is what opens a host's detail sheet, and a sheet that
    opened and took the focus on every arrow press would leave a keyboard reader
    no way to browse the list at all.
*@

<div class="@ClassValue"
     data-testid="@TestId"
     role="listbox"
     aria-label="@AriaLabel"
     @onkeydown="OnKeyDownAsync">
    @foreach (var node in Nodes)
    {
        var selected = IsSelected(node);

        <div class="@RowClass(node)"
             id="@RowId(node)"
             data-testid="graph-atlas-index-option"
             data-node-id="@node.Id"
             role="option"
             aria-selected="@(selected ? "true" : "false")"
             tabindex="@(IsRovingStop(node) ? 0 : -1)"
             @ref="_rows[node.Id]"
             @onclick="() => PickAsync(node.Id)">
            <span class="graph-atlas-index__mark" data-tone="@ToneValue(node)" aria-hidden="true"></span>

            <span class="graph-atlas-index__body">
                <span class="graph-atlas-index__label">@node.Label</span>

                <span class="graph-atlas-index__meta">
                    @if (!string.IsNullOrWhiteSpace(node.Group))
                    {
                        <span class="graph-atlas-index__group">@node.Group</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(node.Kind))
                    {
                        <span class="graph-atlas-index__kind">@node.Kind</span>
                    }
                    @* The status is written out, never left to the mark alone. *@
                    @if (!string.IsNullOrWhiteSpace(node.Status))
                    {
                        <span class="graph-atlas-index__status">@node.Status</span>
                    }
                </span>
            </span>

            @* Degree is the one thing the picture says loudest — it is what sizes a
               node — so it is the one thing the list must not leave to the picture. *@
            <span class="graph-atlas-index__degree">
                <span class="graph-atlas-index__degree-value">@node.InDegree</span>
                <span class="sr-only">@DegreeDescription(node)</span>
            </span>
        </div>
    }
</div>

@code {
    private readonly string _id = "graph-atlas-index-" + Guid.NewGuid().ToString("N");
    private readonly Dictionary<string, ElementReference> _rows = [];
    private string? _focusRequestId;

    [Parameter]
    public IReadOnlyList<GraphAtlasNode> Nodes { get; set; } = [];

    [Parameter]
    public string? SelectedId { get; set; }

    [Parameter]
    public EventCallback<string?> SelectedIdChanged { get; set; }

    /// <summary>The row the keyboard is on: the focused one, the tab stop, the
    /// one a host spotlights. Moved by the arrows without touching
    /// <see cref="SelectedId"/>; falls back to the selection when it names no
    /// row.</summary>
    [Parameter]
    public string? ActiveId { get; set; }

    [Parameter]
    public EventCallback<string?> ActiveIdChanged { get; set; }

    [Parameter]
    public string AriaLabel { get; set; } = "Nodes";

    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>Replaces <c>graph-atlas-index</c> on the listbox.</summary>
    [Parameter]
    public string BaseClass { get; set; } = "graph-atlas-index";

    [Parameter]
    public string? TestId { get; set; }

    private string ClassValue => string.IsNullOrWhiteSpace(CssClass) ? BaseClass : $"{BaseClass} {CssClass}";

    private bool IsSelected(GraphAtlasNode node) => string.Equals(node.Id, SelectedId, StringComparison.Ordinal);

    private int IndexOf(string? id) =>
        id is null ? -1 : Nodes.ToList().FindIndex(node => string.Equals(node.Id, id, StringComparison.Ordinal));

    /// <summary>Where the keyboard is: the active row, else the selected one, else
    /// none.</summary>
    private int CurrentIndex => IndexOf(ActiveId) is var active and >= 0 ? active : IndexOf(SelectedId);

    /// <summary>The one tabbable row, as an index: the current one when there is
    /// one, so tabbing back into the list — or closing a sheet — lands where the
    /// reader left it; the first row otherwise, so the list is always reachable.
    /// It is the row that holds the focus while the list does, so it is where an
    /// arrow moves from: the first Down from the first row goes to the second.
    /// No <c>aria-activedescendant</c>: the focus itself moves, which is the
    /// roving-tabindex pattern, and naming a descendant as well would be the other
    /// pattern laid over it.</summary>
    private int RovingIndex => CurrentIndex is var current and >= 0 ? current : (Nodes.Count > 0 ? 0 : -1);

    private bool IsRovingStop(GraphAtlasNode node) => RovingIndex is var stop and >= 0 && ReferenceEquals(node, Nodes[stop]);

    private GraphAtlasNode? RovingStop => RovingIndex is var stop and >= 0 ? Nodes[stop] : null;

    private string RowId(GraphAtlasNode node) => $"{_id}-{Math.Abs(node.Id.GetHashCode())}";

    private string RowClass(GraphAtlasNode node)
    {
        var value = "graph-atlas-index__option";
        if (IsSelected(node)) value += " graph-atlas-index__option--selected";
        return value;
    }

    /// <summary>An empty tone is the unknown mark rather than no mark: a node whose
    /// status is in no vocabulary is flagged, not silently undressed.</summary>
    private static string ToneValue(GraphAtlasNode node) =>
        string.IsNullOrWhiteSpace(node.ToneSlug) ? "unknown" : node.ToneSlug;

    private static string DegreeDescription(GraphAtlasNode node) =>
        $"{node.InDegree} {(node.InDegree == 1 ? "dependent" : "dependents")}, {node.OutDegree} {(node.OutDegree == 1 ? "dependency" : "dependencies")}";

    private async Task SelectAsync(string? id)
    {
        if (string.Equals(id, SelectedId, StringComparison.Ordinal)) return;

        SelectedId = id;
        await SelectedIdChanged.InvokeAsync(id);
    }

    private async Task ActivateAsync(string? id)
    {
        if (string.Equals(id, ActiveId, StringComparison.Ordinal)) return;

        ActiveId = id;
        await ActiveIdChanged.InvokeAsync(id);
    }

    /// <summary>A click both moves to the row and chooses it — the pointer has no
    /// browsing gesture to keep apart from choosing.</summary>
    private async Task PickAsync(string id)
    {
        await ActivateAsync(id);
        await SelectAsync(id);
    }

    /// <summary>Moves the active row and asks for focus to follow it, leaving the
    /// selection where it was. Focus moves in <c>OnAfterRender</c> rather than
    /// here because the row that should receive it may not have been rendered as
    /// the roving stop yet.</summary>
    private async Task MoveAsync(int index)
    {
        if (Nodes.Count == 0) return;

        var clamped = Math.Clamp(index, 0, Nodes.Count - 1);
        var target = Nodes[clamped];
        _focusRequestId = target.Id;
        await ActivateAsync(target.Id);
    }

    /// <summary>Enter or Space: choose the row the keyboard is on.</summary>
    private Task ChooseAsync() => RovingStop is { } node ? PickAsync(node.Id) : Task.CompletedTask;

    private Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        var current = RovingIndex;

        return args.Key switch
        {
            "ArrowDown" or "ArrowRight" => MoveAsync(current + 1),
            "ArrowUp" or "ArrowLeft" => MoveAsync(current - 1),
            "Home" => MoveAsync(0),
            "End" => MoveAsync(Nodes.Count - 1),
            "Enter" or " " => ChooseAsync(),
            _ => Task.CompletedTask
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusRequestId is not { } id) return;

        _focusRequestId = null;

        if (_rows.TryGetValue(id, out var row))
        {
            try
            {
                await row.FocusAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit went away between the key press and the render.
            }
            catch (InvalidOperationException)
            {
                // Prerendering: there is no element to focus yet.
            }
        }
    }
}
