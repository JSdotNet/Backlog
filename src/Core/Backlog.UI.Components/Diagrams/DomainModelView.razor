@*
    The Domain view's Model page (local ADR 0037): a Diagram | Fields | Events bar
    that opens on Diagram. Diagram draws each classDiagram fence of the model file
    with DomainModelDiagram. Fields lists each fence's classes with their
    attributes grouped by kind (DomainModelFieldsView), the model file's
    relationship notes beneath, and how each domain service runs
    (DomainServiceInvocations). Events reads each domain-event chapter of the
    context as a contract (DomainEventContracts).
*@

<section class="domain-model-view" data-testid="@TestId" aria-label="@AriaLabel">
    <Tabs AriaLabel="Model views"
          TestId="domain-model-tabs"
          ActiveId="@_tab"
          ActiveIdChanged="@(id => _tab = id)">
        <TabPanel Id="diagram" Title="Diagram" TabTestId="domain-model-tab-diagram" TestId="domain-model-diagram-panel">
            @if (Fences.Count == 0)
            {
                <EmptyState Title="No class diagram"
                            Description="This model file holds no classDiagram fence to draw."
                            TestId="domain-model-empty" />
            }
            else
            {
                @foreach (var fence in Fences)
                {
                    <DomainModelDiagram Source="@fence.Source" Title="@fence.Title" ChapterReferences="@ChapterReferences" />
                }
            }
        </TabPanel>
        <TabPanel Id="fields" Title="Fields" TabTestId="domain-model-tab-fields" TestId="domain-model-fields-panel">
            @if (Fences.Count == 0)
            {
                <EmptyState Title="No class diagram"
                            Description="This model file holds no classDiagram fence to read fields from."
                            TestId="domain-model-fields-empty" />
            }
            else
            {
                @foreach (var fence in Fences)
                {
                    <DomainModelFieldsView Source="@fence.Source" Title="@fence.Title" />
                }
            }
            @if (!string.IsNullOrWhiteSpace(RelationshipNotes))
            {
                <section class="domain-model-view__notes" data-testid="domain-model-relationship-notes" aria-labelledby="@_notesHeadingId">
                    <h3 class="domain-model-view__section-title" id="@_notesHeadingId">Relationship notes</h3>
                    <MarkdownView Blocks="@MarkdownPreview.ParseDocument(RelationshipNotes)" />
                </section>
            }
            <DomainServiceInvocations Services="@Chapters.Services" />
        </TabPanel>
        <TabPanel Id="events" Title="Events" TabTestId="domain-model-tab-events" TestId="domain-model-events-panel">
            <DomainEventContracts Events="@Chapters.Events" />
        </TabPanel>
    </Tabs>
</section>

@code {
    /// <summary>The model file's <c>classDiagram</c> fences, in the order the file
    /// holds them, each with the heading it sits under.</summary>
    [Parameter]
    public IReadOnlyList<DomainModelFence> Fences { get; set; } = [];

    /// <summary>The model file's relationship notes, as markdown without their
    /// heading — shown beneath the fields.</summary>
    [Parameter]
    public string? RelationshipNotes { get; set; }

    /// <summary>The context's domain services and events, read from its domain
    /// chapters.</summary>
    [Parameter]
    public DomainChapterReading Chapters { get; set; } = DomainChapterReading.Empty;

    /// <summary>The domain chapter each class of the diagram is, by the name the
    /// model gives it — where a part's Brain notes badge looks its notes up.</summary>
    [Parameter]
    public IReadOnlyDictionary<string, string>? ChapterReferences { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; } = "Model";

    [Parameter]
    public string? TestId { get; set; } = "domain-model-view";

    private string _tab = "diagram";
    private readonly string _notesHeadingId = $"domain-model-notes-{Guid.NewGuid():N}";
}
