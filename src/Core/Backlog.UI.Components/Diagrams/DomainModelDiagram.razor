@*
    A bounded context's class diagram, drawn as the Domain view's Model page reads
    it (local ADR 0040): each aggregate root inside its consistency-boundary band
    with the parts composed into it drawn as a tree around it, what the band holds
    only by identity outside it, and any service class of the fence below. The
    context's domain-service chapters are DomainModelView's strip.

    The lines are drawn by the stylesheet, not by an SVG: the band, the parts and
    the references stay boxes in a reading order — the parts above the root, the
    root, the parts below it, then what sits outside — and each part says its kind
    and multiplicity in words, which a screen reader reads and a line never was. A
    class no band holds — a shared value object, a type another context owns — is
    a card outside every aggregate. A part the invariants are about counts its
    rules, and the count opens them in place under the card (DomainRuleList). A
    fence that does not parse or names no aggregate root (DomainModelArrangement
    returns null) is handed to DiagramView, which draws it with mermaid as before.
*@

@if (_arrangement is null)
{
    <div class="domain-model domain-model--fallback" data-testid="@TestId" data-rendered="mermaid">
        <DiagramView Source="@Source" Language="mermaid" Title="@Title" />
    </div>
}
else
{
    <figure class="domain-model" data-testid="@TestId" data-rendered="domain-model" aria-label="@Title">
        @foreach (var boundary in _arrangement.Boundaries)
        {
            var (above, below) = Tiers(boundary);
            <div class="@($"domain-model__aggregate{(boundary.References.Count > 0 ? " domain-model__aggregate--references" : "")}")" data-testid="domain-model-aggregate" data-root="@boundary.Root.Name">
                <section class="domain-model__band" data-testid="domain-model-band" aria-label="@($"Consistency boundary of {boundary.Root.Name}")">
                    <span class="domain-model__band-label">@boundary.Root.Name aggregate · one consistency boundary</span>
                    @if (above.Count > 0)
                    {
                        @Tier(boundary, above, "above")
                    }
                    <div class="@RootClass(above.Count > 0, below.Count > 0)">
                        <div class="domain-model__root-stack">
                            @RootCard(boundary, above.Count > 0, below.Count > 0)
                        </div>
                        @if (boundary.References.Count > 0)
                        {
                            <span class="domain-model__id-line" aria-hidden="true"></span>
                        }
                    </div>
                    @if (below.Count > 0)
                    {
                        @Tier(boundary, below, "below")
                    }
                </section>
                @if (boundary.References.Count > 0)
                {
                    <section class="domain-model__references" data-testid="domain-model-references" aria-label="@($"Named by {boundary.Root.Name} by id, outside the boundary")">
                        <span class="domain-model__group-label">Outside · by id</span>
                        <ul class="domain-model__reference-list">
                            @foreach (var reference in boundary.References)
                            {
                                <li class="domain-model__reference" data-testid="domain-model-reference" data-target="@reference.Target" data-chapter="@reference.Chapter" data-source="@reference.Source.ToString().ToLowerInvariant()">
                                    <span class="domain-model__reference-head">
                                        <span class="domain-model__reference-name">@reference.Target</span>
                                        @if (reference.Multiplicity is not null)
                                        {
                                            <span class="domain-model__multiplicity" data-testid="domain-model-multiplicity">@reference.Multiplicity</span>
                                        }
                                    </span>
                                    @if (reference.Owner != boundary.Root.Name)
                                    {
                                        <span class="domain-model__reference-owner">from @reference.Owner</span>
                                    }
                                    @if (reference.Via.Count > 0)
                                    {
                                        <span class="domain-model__reference-via" data-testid="domain-model-reference-via">
                                            @foreach (var held in reference.Via)
                                            {
                                                <code>@held</code>
                                            }
                                        </span>
                                    }
                                    else if (reference.Label is not null)
                                    {
                                        <span class="domain-model__reference-via">@reference.Label</span>
                                    }
                                </li>
                            }
                        </ul>
                    </section>
                }
            </div>
        }
        @{
            var services = ServiceCards();
        }
        @if (services.Count > 0)
        {
            <section class="domain-model__services" data-testid="domain-model-services" aria-label="Domain services">
                <span class="domain-model__group-label">Domain services</span>
                <ul class="domain-model__service-list">
                    @foreach (var (name, summary) in services)
                    {
                        <li class="domain-model__service" data-testid="domain-model-service" data-name="@name">
                            <span class="domain-model__service-name">@name</span>
                            @if (!string.IsNullOrWhiteSpace(summary))
                            {
                                <span class="domain-model__service-summary">@summary</span>
                            }
                        </li>
                    }
                </ul>
            </section>
        }
        @if (_arrangement.Outside.Count > 0)
        {
            <section class="domain-model__services" data-testid="domain-model-outside" aria-label="Outside every aggregate">
                <span class="domain-model__group-label">Outside every aggregate</span>
                <ul class="domain-model__service-list">
                    @foreach (var outsider in _arrangement.Outside)
                    {
                        var element = outsider.Class;
                        <li class="@($"domain-model__service domain-model__element--{DomainModelArrangement.KindKey(element.Kind)}")" data-testid="domain-model-outside-class" data-name="@element.Name" data-kind="@DomainModelArrangement.KindKey(element.Kind)">
                            <span class="domain-model__service-name"><span class="domain-model__element-glyph" aria-hidden="true">@DomainModelArrangement.KindGlyph(element.Kind)</span> @element.Name</span>
                            <span class="domain-model__service-summary">@OutsiderSummary(outsider)</span>
                        </li>
                    }
                </ul>
            </section>
        }
        @if (_arrangement.Unplaced.Count > 0)
        {
            <figcaption class="domain-model__unplaced" data-testid="domain-model-unplaced">
                Enumerations, listed on Fields: @string.Join(", ", _arrangement.Unplaced.Select(c => c.Name))
            </figcaption>
        }
    </figure>
}

@code {
    /// <summary>The <c>classDiagram</c> fence's body, without the backtick lines.</summary>
    [Parameter, EditorRequired]
    public string Source { get; set; } = string.Empty;

    /// <summary>The diagram's name — the heading its fence sits under.</summary>
    [Parameter]
    public string Title { get; set; } = "Model diagram";

    [Parameter]
    public string? TestId { get; set; } = "domain-model-diagram";

    /// <summary>The domain chapter each class is, by the name the model gives it.
    /// A class found here carries a badge counting the Brain notes linking to its
    /// chapter.</summary>
    [Parameter]
    public IReadOnlyDictionary<string, string>? ChapterReferences { get; set; }

    /// <summary>The rules about a part, by the name the model gives it: what its
    /// card counts and opens in place. Unset, no card counts rules.</summary>
    [Parameter]
    public Func<string, IReadOnlyList<DomainRule>>? RulesAbout { get; set; }

    /// <summary>A rule's link to its row on Always true, followed.</summary>
    [Parameter]
    public EventCallback<DomainAlwaysTrueLink> OnOpenRule { get; set; }

    private readonly string _rulesId = $"domain-model-rules-{Guid.NewGuid():N}";

    // The parts whose rules the reader opened, by the part's name.
    private readonly HashSet<string> _rulesShown = new(StringComparer.Ordinal);

    private void ToggleRules(string part)
    {
        if (!_rulesShown.Remove(part)) _rulesShown.Add(part);
    }

    /// <summary>The chapters an id attribute can point at, the ones to prefer
    /// first: what names the types outside the boundary.</summary>
    [Parameter]
    public IReadOnlyList<DomainModelIdentity>? Identities { get; set; }

    /// <summary>The context's domain-service chapters, which the page draws as its
    /// own strip: a service class of the fence one of them names is not drawn twice.</summary>
    [Parameter]
    public IReadOnlyList<DomainServiceInvocation> Services { get; set; } = [];

    /// <summary>Opens the Fields tab: the root card's <em>All fields</em> link. No
    /// link without it.</summary>
    [Parameter]
    public EventCallback OnAllFields { get; set; }

    [CascadingParameter]
    public DomainChapterLinks? Links { get; set; }

    private IReadOnlyList<BrainNoteLink> NotesOf(DomainModelClass element) =>
        Links is { } links && ChapterReferences?.GetValueOrDefault(element.Name) is { } reference ? links.NotesOn(reference) : [];

    private (string? Source, IReadOnlyList<DomainModelIdentity>? Identities) _arranged;
    private DomainModelArrangement? _arrangement;

    protected override void OnParametersSet()
    {
        if (string.Equals(_arranged.Source, Source, StringComparison.Ordinal) && ReferenceEquals(_arranged.Identities, Identities)) return;
        _arranged = (Source, Identities);
        _arrangement = DomainModelArrangement.TryArrange(Source, Identities);
    }

    /// <summary>The root's parts split into the row above it and the row below:
    /// the first half above, the rest — and a lone part — below. A part of a part
    /// sits in its owner's cell.</summary>
    private static (IReadOnlyList<DomainModelPart> Above, IReadOnlyList<DomainModelPart> Below) Tiers(DomainModelBoundary boundary)
    {
        var first = boundary.Parts.Where(p => p.Depth == 1).ToList();
        var split = first.Count / 2;
        return (first.GetRange(0, split), first.GetRange(split, first.Count - split));
    }

    private static string RootClass(bool above, bool below) =>
        "domain-model__root"
        + (above ? " domain-model__root--above" : string.Empty)
        + (below ? " domain-model__root--below" : string.Empty);

    /// <summary>The fence's service classes no domain-service chapter names.</summary>
    private List<(string Name, string? Summary)> ServiceCards()
    {
        var cards = new List<(string Name, string? Summary)>();
        var named = Services.Select(s => RunTogether(s.Title)).ToHashSet(StringComparer.OrdinalIgnoreCase);
        foreach (var service in _arrangement?.Services ?? [])
        {
            if (!named.Contains(RunTogether(service.Name))) cards.Add((service.Name, null));
        }
        return cards;
    }

    /// <summary>What a card outside every band says: its kind — "from another
    /// context" for a class with no stereotype — its fields, and what it owns.</summary>
    private static string OutsiderSummary(DomainModelOutsider outsider)
    {
        var element = outsider.Class;
        var kind = element.Kind == DomainModelKind.Other ? "from another context" : DomainModelArrangement.KindLabel(element.Kind);
        var parts = new List<string> { kind };
        if (FieldSummary(element) is { Length: > 0 } fields) parts.Add(fields);
        if (outsider.Owns.Count > 0) parts.Add("owns " + string.Join(", ", outsider.Owns));
        return string.Join(" — ", parts);
    }

    internal static string RunTogether(string text) =>
        string.Concat(text.Where(char.IsLetterOrDigit));

    /// <summary>The names of a part's own fields, its id left out: what the card
    /// says the part is made of.</summary>
    private static string FieldSummary(DomainModelClass element) =>
        string.Join(" · ", element.Attributes.Where(a => !string.Equals(a.Name, "id", StringComparison.OrdinalIgnoreCase)).Take(4).Select(a => a.Name));

    private RenderFragment Tier(DomainModelBoundary boundary, IReadOnlyList<DomainModelPart> parts, string side) => __builder =>
    {
        <ul class="@($"domain-model__tier domain-model__tier--{side}")"
            style="@($"--domain-model-columns: {parts.Count}")"
            data-testid="domain-model-tier"
            data-side="@side"
            aria-label="@($"Composed into {boundary.Root.Name}")">
            @foreach (var part in parts)
            {
                <li class="domain-model__part" data-testid="domain-model-part" data-part="@part.Class.Name" data-depth="@part.Depth">
                    @PartCard(part)
                    @{
                        var nested = Descendants(boundary, part.Class.Name);
                    }
                    @if (nested.Count > 0)
                    {
                        <ul class="domain-model__subparts" aria-label="@($"Composed into {part.Class.Name}")">
                            @foreach (var child in nested)
                            {
                                <li class="domain-model__part domain-model__part--nested" data-testid="domain-model-part" data-part="@child.Class.Name" data-depth="@child.Depth">
                                    @PartCard(child)
                                </li>
                            }
                        </ul>
                    }
                </li>
            }
        </ul>
    };

    /// <summary>Every part under <paramref name="owner"/>, at any depth, breadth first.</summary>
    private static List<DomainModelPart> Descendants(DomainModelBoundary boundary, string owner)
    {
        var owners = new HashSet<string>(StringComparer.Ordinal) { owner };
        var found = new List<DomainModelPart>();
        foreach (var part in boundary.Parts.Where(p => p.Depth > 1))
        {
            if (!owners.Contains(part.Owner)) continue;
            found.Add(part);
            owners.Add(part.Class.Name);
        }
        return found;
    }

    private RenderFragment PartCard(DomainModelPart part) => __builder =>
    {
        var element = part.Class;
        var key = DomainModelArrangement.KindKey(element.Kind);
        var summary = FieldSummary(element);
        var rules = RulesAbout?.Invoke(element.Name) ?? [];
        var shown = _rulesShown.Contains(element.Name);
        var listId = $"{_rulesId}-{element.Name}";
        <span class="@($"domain-model__element domain-model__element--{key}")" data-testid="domain-model-element" data-kind="@key" data-name="@element.Name">
            <span class="domain-model__element-kind">
                <span class="domain-model__element-glyph" aria-hidden="true">@DomainModelArrangement.KindGlyph(element.Kind)</span>
                @(element.Kind == DomainModelKind.Other && element.Stereotype is { } stereotype ? stereotype : DomainModelArrangement.KindLabel(element.Kind))
                @if (part.Multiplicity is not null)
                {
                    <span aria-hidden="true">·</span>
                    <span class="domain-model__multiplicity" data-testid="domain-model-multiplicity">@part.Multiplicity</span>
                }
                @if (part.Depth > 1)
                {
                    <span class="domain-model__edge-owner">of @part.Owner</span>
                }
            </span>
            <span class="domain-model__element-title">
                <span class="domain-model__element-name">@element.Name</span>
                <BrainNotesBadge Notes="@NotesOf(element)" OnOpen="@(Links?.OnOpenNote ?? default)" TestId="domain-model-notes" />
            </span>
            @if (part.Label is not null)
            {
                <span class="sr-only">@part.Owner @part.Label @element.Name</span>
            }
            @if (summary.Length > 0)
            {
                <span class="domain-model__element-fields">@summary</span>
            }
            @if (rules.Count > 0)
            {
                <AppButton Variant="ButtonVariant.None"
                           BaseClass="domain-model__rules"
                           TestId="domain-model-rules"
                           OnClick="@(() => ToggleRules(element.Name))"
                           aria-expanded="@(shown ? "true" : "false")"
                           aria-controls="@listId"
                           aria-label="@($"{DomainRuleText.Count(rules.Count)} about {element.Name}")">@DomainRuleText.Count(rules.Count)</AppButton>
            }
        </span>
        @if (shown && rules.Count > 0)
        {
            <DomainRuleList Rules="@rules"
                            OnOpen="OnOpenRule"
                            AriaLabel="@($"Rules about {element.Name}")"
                            CssClass="domain-model__rule-list"
                            TestId="domain-model-rule-list"
                            id="@listId" />
        }
    };

    private RenderFragment RootCard(DomainModelBoundary boundary, bool above, bool below) => __builder =>
    {
        var root = boundary.Root;
        @if (above)
        {
            <span class="domain-model__owns domain-model__owns--above" aria-hidden="true"></span>
        }
        <span class="domain-model__element domain-model__element--root" data-testid="domain-model-element" data-kind="root" data-name="@root.Name">
            <span class="domain-model__element-kind">
                <span class="domain-model__element-glyph" aria-hidden="true">@DomainModelArrangement.KindGlyph(root.Kind)</span>
                @DomainModelArrangement.KindLabel(root.Kind)
            </span>
            <span class="domain-model__element-name">@root.Name</span>
            @if (boundary.KeyFields.Count > 0)
            {
                <span class="domain-model__key-fields" data-testid="domain-model-key-fields">
                    @foreach (var line in boundary.KeyFields.Chunk(3))
                    {
                        <span class="domain-model__key-line">@string.Join(" · ", line)</span>
                    }
                </span>
            }
            <span class="domain-model__root-links">
                @if (OnAllFields.HasDelegate)
                {
                    <AppButton Variant="ButtonVariant.None"
                               BaseClass="domain-model__all-fields"
                               TestId="domain-model-all-fields"
                               OnClick="@(() => OnAllFields.InvokeAsync())">All fields →</AppButton>
                }
                <BrainNotesBadge Notes="@NotesOf(root)" OnOpen="@(Links?.OnOpenNote ?? default)" TestId="domain-model-notes" />
            </span>
        </span>
        @if (below)
        {
            <span class="domain-model__owns domain-model__owns--below" aria-hidden="true"></span>
        }
    };
}
