@implements IAsyncDisposable
@inject IJSRuntime Js
@*
    The artifact source is resolved from the provider rather than injected,
    because most of the places that render a diagram have never heard of it: the
    storybook pages, the unit tests, and the mobile harness all construct a
    DiagramView with nothing registered, and an [Inject] property would make
    every one of them fail to render rather than fall back to mermaid.
*@
@inject IServiceProvider Services

<figure class="diagram-view" data-testid="diagram-view" aria-label="@AriaLabel">
    <figcaption class="diagram-view__header">
        <span class="diagram-view__title">@DiagramName</span>
        <span class="diagram-view__badges">
            @* Which renderer drew this, as a control rather than a label.

               The two draw the same diagram differently and neither is simply
               better: the artifact is the considered picture, and the mermaid is
               the one that is unarguably current, because it is a rendering of
               the fence rather than a re-authoring of it. A reader who doubts
               what they are looking at has to be able to check it against the
               other, and a badge that only announced the answer left them
               nothing to do about it.

               Only where there is a choice to make. A diagram with no artifact
               has one renderer and gets no switch at all. *@
            @if (_artifact is { CanRender: true })
            {
                <span class="diagram-view__renderers" role="group" aria-label="Renderer" data-testid="diagram-view-renderers">
                    <ToggleButton Pressed="@(!_preferMermaid)"
                                  BaseClass="language-badge diagram-view__renderer"
                                  PressedCssClass="diagram-view__renderer--active"
                                  TestId="diagram-view-renderer-artifact"
                                  Title="Show the Archify artifact"
                                  PressedChanged="@(pressed => ChooseRendererAsync(preferMermaid: false, pressed))">Archify</ToggleButton>
                    <ToggleButton Pressed="@_preferMermaid"
                                  BaseClass="language-badge diagram-view__renderer"
                                  PressedCssClass="diagram-view__renderer--active"
                                  TestId="diagram-view-renderer-mermaid"
                                  Title="Draw the diagram from its source"
                                  PressedChanged="@(pressed => ChooseRendererAsync(preferMermaid: true, pressed))">Mermaid</ToggleButton>
                </span>
            }
            @* Room, which is the one thing a diagram in a column of prose cannot
               have. The artifact is already a whole viewer with its own zoom and
               pan; what it runs out of is width. This hands it the screen.

               Only for the artifact: a drawn mermaid diagram is an SVG in the
               page and has nothing to go fullscreen with. *@
            @if (ShowingArtifact)
            {
                <AppButton Size="ButtonSize.Small"
                           Variant="ButtonVariant.Ghost"
                           TestId="diagram-view-fullscreen"
                           title="Show this diagram full screen"
                           OnClick="ExpandArtifactAsync">Full screen</AppButton>
            }
            @* The language, except where the switch has already said it. A mermaid
               fence with an artifact rendered "Archify | Mermaid | mermaid", and the
               last two are the same word for the same thing: the switch's second
               option IS the fence's language, because drawing the fence is what
               that option does. The badge is worth keeping only where there is no
               switch to say it. *@
            @if (!string.IsNullOrWhiteSpace(Language) && _artifact is not { CanRender: true })
            {
                <span class="language-badge diagram-view__language" data-testid="diagram-view-language">@Language</span>
            }
        </span>
    </figcaption>
    @* role="img" is dropped for an artifact: it is a document with its own
       structure rather than one picture, and labelling it as an image would hide
       everything inside it from a screen reader. The frame's title carries the
       label instead. *@
    <div class="diagram-view__canvas" role="@(ShowingArtifact ? null : "img")" aria-label="@(ShowingArtifact ? null : AriaLabel)">
        @if (ShowingArtifact)
        {
            @* The stage, and the whole reason there is one: fullscreen is
               requested on this rather than on the frame. Only the element in the
               top layer and its descendants are painted, and a frame is the one
               thing here that can hold nothing of ours — the document inside is
               sandboxed into an opaque origin, so it can be neither scripted into
               nor reached back from. Wrapping the frame is what gives the way out
               somewhere to be; without it the only way back was Esc, and nothing
               on screen said so. *@
            <div @ref="_stage" class="diagram-view__stage" data-testid="diagram-view-stage">
                @* `allow-downloads` is what makes the artifact's Export menu real.
                   It writes a PNG, SVG or WebM by clicking an anchor with a
                   `download` attribute at a blob URL, and a frame without this
                   permission has that click silently ignored — the menu was there,
                   the button pressed, and nothing ever arrived. It grants the frame
                   nothing else: without `allow-same-origin` the document stays in an
                   opaque origin and still cannot read a cookie, a store, or this
                   page. *@
                <iframe @ref="_frame"
                        class="diagram-view__artifact"
                        data-testid="diagram-view-artifact"
                        sandbox="allow-scripts allow-downloads"
                        title="@AriaLabel"></iframe>
                @* And out again. Always in the markup and shown by the stylesheet
                   only while the stage is the screen: `:fullscreen` answers for Esc
                   and F11 as well as for this button, so there is no state here to
                   fall out of step with what the browser actually did. *@
                <AppButton Size="ButtonSize.Small"
                           CssClass="diagram-view__exit"
                           TestId="diagram-view-exit-fullscreen"
                           title="Leave full screen (Esc)"
                           OnClick="ExpandArtifactAsync">Exit full screen</AppButton>
            </div>
        }
        else if (CanRender(Language))
        {
            <div @ref="_canvas" class="diagram-view__rendered" data-diagram-id="@_diagramId">
                @if (_renderError is { } error)
                {
                    <p class="diagram-view__fallback" role="note">@error</p>
                }
                else
                {
                    <p class="diagram-view__status" role="status">Rendering @Language diagram...</p>
                }
            </div>
        }
        else
        {
            <pre class="diagram-view__source"><code>@Source</code></pre>
        }
    </div>
    @* No source disclosure. A drawn diagram used to carry one, on the reasoning
       that the picture is the one block in a body a reader cannot select — and for
       an artifact especially, since the artifact is a re-authoring of the fence
       rather than a rendering of it, so nothing on screen was the canonical text.

       The renderer switch above answers that better than a fold of text did. A
       reader who wants to know whether the artifact still tells the truth presses
       Mermaid and sees the fence drawn, which is the question they actually had;
       a wall of `stateDiagram-v2` under every diagram was the long way round to
       it, and it was under every diagram, open or shut, in a pane that is mostly
       prose. The fence is still in the chapter for anyone who wants to read it as
       text.

       A language nothing can draw keeps its <pre> above — that is not a
       disclosure, it is the only rendering there is. *@
    @* The offers, and only where there is an honest one to make. A diagram whose
       kind Archify has no type for gets nothing at all, because an offer is a
       promise. *@
    @if (_artifact is { CanRender: false } artifact && (artifact.SpecPath is not null || CanOfferAuthoring))
    {
        <div class="diagram-view__footer" data-testid="diagram-view-footer">
            @if (artifact.IsOutOfDate)
            {
                <Alert Role="note"
                       BaseClass="diagram-view__notice"
                       TestId="diagram-view-outdated"
                       Message="An Archify artifact exists for this diagram, but it was authored from an earlier version of the source. You are looking at the mermaid rendering, which is current." />
            }
            @if (artifact.SpecPath is not null)
            {
                <AppButton Size="ButtonSize.Small"
                           Busy="_busy"
                           BusyLabel="Rendering"
                           TestId="diagram-view-render"
                           OnClick="RenderArtifactAsync">Render artifact</AppButton>
            }
            else
            {
                <AppButton Size="ButtonSize.Small"
                           Busy="_busy"
                           BusyLabel="Starting"
                           TestId="diagram-view-author"
                           OnClick="AuthorArtifactAsync">Author with agent</AppButton>
            }
            <Alert TestId="diagram-view-action-error" Message="@_actionError" />
        </div>
    }
</figure>

@code {
    private readonly string _diagramId = "diagram-" + Guid.NewGuid().ToString("N");
    private ElementReference _canvas;
    private ElementReference _frame;

    /// <summary>The element that goes fullscreen, which is the wrapper around
    /// the frame rather than the frame itself — it has to be, because the way
    /// back out has to be inside whatever is in the top layer, and a sandboxed
    /// frame in an opaque origin can carry nothing of ours.</summary>
    private ElementReference _stage;
    private IDiagramArtifactSource? _artifacts;
    private bool _artifactsResolved;
    private DiagramArtifact? _artifact;
    private string? _renderedSource;
    private string? _renderedLanguage;
    private string? _renderedArtifact;
    private int _artifactRevision;
    private string? _renderError;
    private string? _actionError;
    private bool _busy;

    /// <summary>Whether the reader has asked for the mermaid rather than the
    /// artifact. Held here rather than lifted to the host, because it is a
    /// question about one diagram: a reader checking whether this picture still
    /// matches its fence is not saying anything about the next one.</summary>
    private bool _preferMermaid;

    [Parameter, EditorRequired]
    public string Source { get; set; } = string.Empty;

    [Parameter]
    public string? Language { get; set; }

    [Parameter]
    public string Title { get; set; } = "Diagram";

    /// <summary>
    /// Raised once the renderer has drawn this diagram.
    /// <para>
    /// For a caller that has to work on the rendered SVG rather than on the source —
    /// there is exactly one, the C4 explorer, which attaches pan, zoom, a minimap and
    /// a click target to it. It is an event rather than something the explorer polls
    /// for, because a poll has to guess how long mermaid takes and gets it wrong on
    /// either a cold library load or a fast machine.
    /// </para>
    /// </summary>
    [Parameter]
    public EventCallback OnRendered { get; set; }

    private bool ShowingArtifact => _artifact is { CanRender: true } && !_preferMermaid;

    /// <summary>Whether to offer to start an agent. Three things have to be true
    /// at once — the host knows about artifacts, an agent CLI is available, and
    /// Archify has a type for this kind of diagram — and the last is asked of the
    /// source directly rather than of the host, because it is the same answer
    /// everywhere and the host has no better one to give.</summary>
    private bool CanOfferAuthoring =>
        _artifacts is { CanAuthor: true } && ArchifyDiagramTypes.IsSupported(Source);

    private string DiagramName => IsDiagram(Language) ? Title : "Code diagram";

    private string AriaLabel => string.IsNullOrWhiteSpace(Language)
        ? "Diagram source visualization"
        : $"{Language} diagram source visualization";

    protected override void OnParametersSet()
    {
        if (!_artifactsResolved)
        {
            _artifacts = Services.GetService<IDiagramArtifactSource>();
            _artifactsResolved = true;
        }

        _artifact = _artifacts?.Find(Source, Language);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ShowingArtifact)
        {
            // Keyed on the path and a revision rather than the document itself, so
            // that re-rendering an artifact in place — same file, new contents — is
            // noticed, without holding a second copy of 675 KB to compare against.
            var key = $"{_artifact!.ArtifactPath}#{_artifactRevision}";
            if (string.Equals(_renderedArtifact, key, StringComparison.Ordinal)) return;

            _renderedArtifact = key;
            _renderedSource = null;
            _renderedLanguage = null;

            try
            {
                await Js.InvokeVoidAsync("backlogDiagrams.renderArtifact", _frame, _diagramId, _artifact.Html);
            }
            catch (JSException)
            {
                // Fall back to the diagram that is always renderable. Dropping the
                // document is what makes ShowingArtifact false, so the next pass
                // takes the mermaid path rather than leaving an empty frame on
                // screen with nothing to say for itself.
                _renderedArtifact = null;
                _artifact = _artifact with { Html = null };
                StateHasChanged();
            }

            return;
        }

        if (_renderedArtifact is not null)
        {
            _renderedArtifact = null;
            await DisposeDiagramAsync();
        }

        if (!CanRender(Language)) return;
        if (string.Equals(_renderedSource, Source, StringComparison.Ordinal)
            && string.Equals(_renderedLanguage, Language, StringComparison.OrdinalIgnoreCase)) return;

        _renderedSource = Source;
        _renderedLanguage = Language;
        _renderError = null;

        try
        {
            await Js.InvokeVoidAsync("backlogDiagrams.render", _canvas, _diagramId, Language, Source);

            // Said after the drawing, because the only caller that wants to know is
            // one that needs the SVG to exist: the C4 explorer takes the rendered
            // picture over for pan, zoom and clicking, and polling for it would be
            // the alternative. Nobody else takes the callback, and the render path is
            // unchanged for them.
            if (OnRendered.HasDelegate) await OnRendered.InvokeAsync();
        }
        catch (JSException ex)
        {
            _renderedSource = null;
            _renderError = $"The diagram renderer could not start: {ex.Message}";
            StateHasChanged();
        }
    }

    /// <summary>Answers one of the two renderer buttons.
    /// <para>
    /// A press that turns a button off is ignored on purpose. These are one of
    /// two, so pressing the one already showing means "yes, this one" rather than
    /// "neither" — <c>ToggleButton</c> announces the state it would move to and
    /// leaves a host driving a strip to decide, which is what this is.
    /// </para></summary>
    private async Task ChooseRendererAsync(bool preferMermaid, bool pressed)
    {
        if (!pressed || _preferMermaid == preferMermaid) return;

        _preferMermaid = preferMermaid;

        // Switching to mermaid drops the artifact's document, its runtime and the
        // roughly 675 KB behind it right away rather than leaving it parked in a
        // frame nobody is looking at. OnAfterRenderAsync would do it on the next
        // pass anyway; doing it here means the two never both exist.
        if (preferMermaid)
        {
            _renderedArtifact = null;
            await DisposeDiagramAsync();
        }
        else
        {
            // The mermaid canvas is going away with the element it drew into, so
            // the next pass has to draw the artifact from nothing rather than
            // deciding it is already current.
            _renderedSource = null;
            _renderedLanguage = null;
        }
    }

    /// <summary>Hands the artifact the whole screen, and takes it back — one
    /// method for both directions, because it is one toggle and the browser already
    /// knows which way it is going.
    /// <para>
    /// A failure here is swallowed on purpose. Fullscreen is refused for reasons
    /// that are not faults and that a reader can do nothing about — no user
    /// gesture recognised, a permissions policy on the host, a browser that
    /// declines — and the diagram is still perfectly readable in the chapter. An
    /// error banner over a working diagram would be the worse outcome.
    /// </para></summary>
    private async Task ExpandArtifactAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("backlogDiagrams.toggleArtifactFullscreen", _stage);
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <summary>Runs the pinned generator over a specification somebody already
    /// authored. The mechanical half of "generate": no agent, no judgement, and
    /// the same command a person would run at a prompt.</summary>
    private async Task RenderArtifactAsync()
    {
        if (_artifacts is null || _busy) return;

        _busy = true;
        _actionError = null;

        try
        {
            _actionError = await _artifacts.RenderAsync(Source);
        }
        finally
        {
            _busy = false;
        }

        if (_actionError is not null) return;

        _artifactRevision++;
        _artifact = _artifacts.Find(Source, Language);
    }

    /// <summary>Opens an agent session with a brief. The half no running app can
    /// do by itself, so it ends here: the artifact appears once the agent has
    /// written the specification and the generator has run.</summary>
    private async Task AuthorArtifactAsync()
    {
        if (_artifacts is null || _busy) return;

        _busy = true;
        _actionError = null;

        try
        {
            _actionError = await _artifacts.AuthorAsync(Source);
        }
        finally
        {
            _busy = false;
        }
    }

    public async ValueTask DisposeAsync() => await DisposeDiagramAsync();

    private async Task DisposeDiagramAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("backlogDiagrams.dispose", _diagramId);
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    public static bool IsDiagram(string? language) =>
        language?.Trim().ToLowerInvariant() is "mermaid" or "mmd" or "plantuml" or "puml" or "graphviz" or "dot";

    public static bool CanRender(string? language) =>
        language?.Trim().ToLowerInvariant() is "mermaid" or "mmd";
}
