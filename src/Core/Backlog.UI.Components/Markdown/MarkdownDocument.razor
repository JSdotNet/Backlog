@*
    A body you read, with a way into editing it.

    Read is the resting state, and that is the decision this component is. A
    surface that opens in an editor tells the reader they are here to write; this
    product's bodies are read far more often than they are written, so the
    default is the rendering and writing is a thing you ask for.

    One text either way. Editing does not copy it somewhere and copy it back —
    the same string is handed to the editor and to the parser — so there is no
    moment where a body exists twice and the two can disagree.
*@

<div class="@ClassValue" data-testid="@TestId">
    @* Only when the bar has something to put in it.

       A host whose own header carries the title, the copy and the way into
       editing hands this none of the three — see KnowledgeChapterEditor.Bare —
       and the row was drawn all the same: an empty strip two rems tall between
       that header and the first line of the file. Room taken from the body by
       controls that are not there. *@
    @if (ShowsBar)
    {
    <div class="markdown-document__bar">
        <span class="markdown-document__title">@Title</span>

        <span class="markdown-document__actions">
            @if (!Editing && AllowCopy)
            {
                <CopyButton Text="@(Value ?? string.Empty)"
                            Label="@CopyLabel"
                            ButtonCssClass="markdown-document__copy"
                            StatusCssClass="markdown-document__status"
                            ButtonTestId="@Suffix("copy")"
                            StatusTestId="@Suffix("copy-status")" />
            }

            @if (CanEdit)
            {
                <AppButton Variant="ButtonVariant.Ghost"
                           OnClick="ToggleAsync"
                           TestId="@Suffix(Editing ? "done" : "edit")">
                    @(Editing ? DoneLabel : EditLabel)
                </AppButton>
            }
        </span>
    </div>
    }

    @if (Editing)
    {
        <MarkdownEditor Value="@Value"
                        ValueChanged="OnEditedAsync"
                        OnBlur="OnBlur"
                        AriaLabel="@EditorAriaLabel"
                        Rows="@Rows"
                        Fill="@Fill"
                        Bare="@BareEditor"
                        TestId="@Suffix("editor")" />
    }
    else
    {
        <div class="markdown-document__read" data-testid="@Suffix("read")">
            <MarkdownView Blocks="@_blocks"
                          KnowledgeDocumentPath="@KnowledgeDocumentPath"
                          OnKnowledgeNavigate="@OnKnowledgeNavigate"
                          Comments="@Comments"
                          OnAddComment="OnAddComment"
                          OnResolveComment="OnResolveComment"
                          OnDeleteComment="OnDeleteComment" />
        </div>
    }
</div>

@code {
    private IReadOnlyList<MdBlock> _blocks = [];
    private string? _parsed;
    private bool _parsedWithoutFrontmatter;
    private bool _hasParsed;

    /// <summary>The markdown, read or written.</summary>
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Which mode it is in. Two-way bindable, so a host that wants to
    /// open something straight into editing can, and a host that does not care
    /// need not hold it.</summary>
    [Parameter]
    public bool Editing { get; set; }

    [Parameter]
    public EventCallback<bool> EditingChanged { get; set; }

    /// <summary>Focus has left the editor's text, which is a host's cue to write
    /// what is pending. Not a cue to stop editing: the formatting buttons sit
    /// outside the textarea, so reaching for bold blurs it, and an editor that
    /// closed here would take the button away as it was being pressed. Ending an
    /// edit is what Done is for, and it stays that way.</summary>
    [Parameter]
    public EventCallback OnBlur { get; set; }

    [Parameter]
    public string? Title { get; set; }

    /// <summary>Whether the edit button is offered at all. A body someone is
    /// only allowed to read should not show a way in that refuses them.</summary>
    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Whether the read view leaves out a leading YAML frontmatter block.
    /// <para>
    /// For a host that is already showing it as facts — a file view's frontmatter
    /// strip above this one — where the reader would otherwise meet the same four
    /// lines twice, the second time as a divider and a run-together paragraph.
    /// </para>
    /// <para>
    /// Read mode only, and that is the whole of the parameter: the text handed to
    /// the editor and back out through <see cref="ValueChanged"/> is
    /// <see cref="Value"/> itself, untouched, because it is what a host writes to
    /// disk. One text either way, as the note at the top says.
    /// </para>
    /// </summary>
    [Parameter]
    public bool HideFrontmatter { get; set; }

    [Parameter]
    public bool AllowCopy { get; set; } = true;

    [Parameter]
    public string EditLabel { get; set; } = "Edit";

    [Parameter]
    public string DoneLabel { get; set; } = "Done";

    [Parameter]
    public string CopyLabel { get; set; } = "Copy markdown";

    [Parameter]
    public int Rows { get; set; } = 14;

    /// <summary>
    /// Whether the editor takes the height the host gives it instead of the one
    /// <see cref="Rows"/> asks for. Handed straight to
    /// <see cref="MarkdownEditor.Fill"/>, which explains what the two heights
    /// cost and when each is right.
    /// <para>
    /// Nothing but a pass-through, and deliberately: this component holds no
    /// height of its own — it is a bar over one of two bodies — so the only
    /// useful thing it can do with the answer is give it to the surface that has
    /// to stretch. The read view is untouched either way, because a rendered
    /// body is already as tall as the body.
    /// </para>
    /// </summary>
    [Parameter]
    public bool Fill { get; set; }

    /// <summary>
    /// Whether the editor gives up its own frame, because the host already drew
    /// one around it. Handed straight to <see cref="MarkdownEditor.Bare"/>, which
    /// explains what a second edge a pixel inside the first costs a reader.
    /// <para>
    /// A pass-through for the same reason <see cref="Fill"/> is: the frame in
    /// question is the editor's, and this component draws none of its own. The
    /// read view keeps whatever it had — it has no border to give up.
    /// </para>
    /// </summary>
    [Parameter]
    public bool BareEditor { get; set; }

    /// <summary>Comments against the read view's blocks. Not shown while
    /// editing: the blocks they are anchored to do not exist in that mode, and a
    /// comment beside a textarea would be pointing at nothing.</summary>
    [Parameter]
    public IReadOnlyList<MarkdownComment> Comments { get; set; } = [];

    [Parameter]
    public EventCallback<int> OnAddComment { get; set; }

    [Parameter]
    public EventCallback<string> OnResolveComment { get; set; }

    /// <summary>Raised with a comment's id when a reader asks to remove it
    /// outright, and also how a fresh draft nobody typed into is taken back when
    /// Cancel is pressed on it — see <c>MarkdownView.CancelEditAsync</c>. Without
    /// it, a draft abandoned that way is left behind as an empty remark.</summary>
    [Parameter]
    public EventCallback<string> OnDeleteComment { get; set; }

    /// <summary>The repository-relative path of the knowledge document this text
    /// came from, forwarded to the read view so a relative link in it resolves to
    /// the chapter it names instead of to the reader's browser.
    ///
    /// <para>It travels through here because this component is the read view of
    /// every knowledge chapter an area lets a reader write: three of the five
    /// sections hand their body to an editing surface, and the surface renders the
    /// chapter through this. Left unset — which is every entry body and every
    /// other surface — nothing about the rendering changes.</para></summary>
    [Parameter]
    public string? KnowledgeDocumentPath { get; set; }

    /// <summary>Raised with the reference a reader followed out of the read view.
    /// Only the host knows what "go there" means, so nothing here moves.</summary>
    [Parameter]
    public EventCallback<KnowledgeReference> OnKnowledgeNavigate { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    private string ClassValue => string.Join(' ', new[]
    {
        "markdown-document",
        Editing ? "markdown-document--editing" : null,
        Fill ? "markdown-document--fill" : null,
        CssClass
    }.Where(part => !string.IsNullOrWhiteSpace(part)));

    /// <summary>
    /// Whether the bar has anything to say. A title, a copy button, a way into
    /// editing — any one of them is a bar; none of them is a strip of empty
    /// space above the body, which is what a host that carries all three in its
    /// own header used to get.
    /// </summary>
    private bool ShowsBar => !string.IsNullOrWhiteSpace(Title) || (!Editing && AllowCopy) || CanEdit;

    private string? Suffix(string part) => TestId is null ? null : $"{TestId}-{part}";

    /// <summary>What the editor is called to a screen reader. A host that names
    /// the body above it hands in no title, and interpolating that absence gave
    /// the textarea the label " source" — a name that reads as nothing and sorts
    /// under a space in a rotor listing.</summary>
    private string EditorAriaLabel => string.IsNullOrWhiteSpace(Title) ? "Markdown source" : $"{Title} source";

    /// <summary>Parsed when the text changes rather than on every render — the
    /// bar above it re-renders for reasons that have nothing to do with the
    /// body.</summary>
    protected override void OnParametersSet()
    {
        if (_hasParsed && _parsed == Value && _parsedWithoutFrontmatter == HideFrontmatter) return;

        // ParseDocument, not Parse: a document's `##` is a heading. An entry
        // wants the other reading, and hands its own blocks to MarkdownView.
        //
        // The blocks are the only thing the frontmatter is ever taken out of, so
        // it is taken out here: Value goes to the editor as it is.
        _blocks = MarkdownPreview.ParseDocument(HideFrontmatter ? MarkdownFrontmatter.Read(Value).Body : Value);
        _parsed = Value;
        _parsedWithoutFrontmatter = HideFrontmatter;
        _hasParsed = true;
    }

    private async Task ToggleAsync()
    {
        Editing = !Editing;
        await EditingChanged.InvokeAsync(Editing);
    }

    private async Task OnEditedAsync(string value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
