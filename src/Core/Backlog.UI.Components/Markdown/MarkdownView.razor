@*
    The read view of an entry's body: what markdown looks like when you are not
    editing it. Sub-items are not here — a `##` heading is an item in its own
    right and is laid out as its own card below the entry (see Home.razor), so
    this renders only the prose above them. Checkboxes belong to `- [ ]` lines
    and only to those, and are only controls when someone is listening for the
    toggle — otherwise they are state, not buttons. Headings render at their
    level, both in size and to a screen reader, and #tags render as chips. Text
    is emitted through Razor's normal escaping, so nothing typed into an entry
    can inject markup.
*@

@if (AllowCopy && !string.IsNullOrWhiteSpace(Source))
{
    @* Copies the markdown, not the rendering. What a reader wants out of a read
       view is the thing they can paste back into one — the source is what round
       trips, and it is what every other surface in this product stores. *@
    <div class="md-actions">
        <CopyButton Text="@Source"
                    Label="@CopyLabel"
                    ButtonCssClass="md-copy"
                    StatusCssClass="md-copy__status"
                    ButtonTestId="markdown-copy"
                    StatusTestId="markdown-copy-status" />
    </div>
}

<div class="@ViewClass">
@foreach (var (block, index) in Blocks.Select((block, index) => (block, index)))
{
    @* A `meta` fence describes the heading it sits under, so where it can be it
       is drawn as part of that heading rather than as the block after it: the
       heading becomes the record's headline and the fence's own turn here is
       skipped. The document's own fence is skipped for the other reason — a host
       that is drawing it somewhere better has taken it off this view's hands. *@
    @if (DrawnElsewhere(index))
    {
    }
    else if (Annotated)
    {
        @* Only wrapped when there is something to hang off a block. A div around
           every block changes what a stylesheet sees, and a read view nobody
           annotates should render exactly what it rendered before. *@
        <div class="md-block-row" data-block="@index">
            <div class="md-block @(NotesOn(index).Count > 0 ? "md-block--commented" : string.Empty) @AffordanceClass">
                @RenderContent(block, index)
                @if (CanComment || CanRewrite)
                {
                    @* The corner, as one row. Each control used to anchor itself
                       to it, which was fine while there was only one and put the
                       rewrite button on top of the comment button the moment a
                       host offered both. The row also says how wide the block's
                       gutter has to be: what is in here is what the text is
                       stopping short of. *@
                    <div class="md-block__affordances">
                        @if (CanComment)
                        {
                            <button type="button"
                                    class="md-block__comment"
                                    aria-label="@($"Comment on block {index + 1}")"
                                    data-testid="@($"markdown-comment-{index}")"
                                    @onclick="() => OnAddComment.InvokeAsync(index)">
                                <span aria-hidden="true">💬</span>
                                @if (NotesOn(index).Count > 0)
                                {
                                    <span class="md-block__count">@NotesOn(index).Count</span>
                                }
                            </button>
                        }
                        @if (CanRewrite)
                        {
                            @* A second per-block affordance beside the first,
                               rather than a parallel row of AI controls. A rewrite
                               is anchored to a block for exactly the reason a
                               comment is — see MarkdownComment — so it belongs
                               where comments already hang off, and the two look
                               like two things you can do to a paragraph rather
                               than two features that happen to overlap. *@
                            <button type="button"
                                    class="md-block__comment md-block__rewrite"
                                    aria-label="@($"Rewrite block {index + 1} with AI")"
                                    data-testid="@($"markdown-rewrite-{index}")"
                                    @onclick="() => OnRewriteBlock.InvokeAsync(index)">
                                <span aria-hidden="true">✦</span>
                            </button>
                        }
                    </div>
                }
            </div>
            @* In margin mode this cell is the second column, level with its
               block; inline it simply follows. One markup, two layouts, so the
               two cannot drift apart. Proposals land in the same cell as the
               comments, so the margin layout works for them for free and there is
               no second layout to keep in step. *@
            <div class="md-block-row__notes">
                @RenderComments(NotesOn(index))
                @RenderProposals(SuggestionsOn(index))
            </div>
        </div>
    }
    else
    {
        @RenderContent(block, index)
    }
}
</div>

@* A comment whose block has gone still has to land somewhere. Dropping it would
   lose what someone said; showing it at the end says it is adrift.

   A proposal has the same problem — blocks are deleted while suggestions are
   open — and takes the same answer rather than a region of its own, for the
   reason already recorded here: a lost proposal is worse than a stray one. *@
@if (Orphans.Count > 0 || OrphanProposals.Count > 0)
{
    <div class="md-comments md-comments--orphaned" data-testid="markdown-orphaned-comments">
        @RenderComments(Orphans)
        @RenderProposals(OrphanProposals)
    </div>
}

@code {
    /// <summary>
    /// One block as it appears in the document, wherever it appears: annotated in
    /// a row of its own, or plain in the flow.
    ///
    /// <para>It exists because the two layouts used to answer the metadata
    /// question differently — annotated documents left a chapter's status sitting
    /// in its own code fence — and a reader reviewing a chapter is exactly the
    /// reader who needs to see whether it is still current. One fragment for both
    /// means there is no second place for that answer to drift.</para>
    /// </summary>
    private RenderFragment RenderContent(MdBlock block, int index) => __builder =>
    {
        if (block is MdHeading heading)
        {
            @* Not a heading's job to know it is a record's headline; the fence
               under it is what decides that. What the pair then looks like is
               MetadataChapterView's — the shape has a name, so the header of a
               file that draws the same record differently can be told apart from
               it rather than being a second copy of this call. *@
            if (PairedMetaFence(index) is { } fence)
            {
                <MetadataChapterView Metadata="@MetadataOf(fence)"
                                     Vocabulary="@KnowledgeStatus.Vocabulary(KnowledgeFolder)"
                                     ShowFields="@RenderKnowledgeMetadataFields"
                                     OnStatusChanged="status => ReportStatusAsync(index, status)"
                                     OnNavigate="@OnKnowledgeNavigate"
                                     HrefFor="@KnowledgeHrefFor"
                                     Heading="@RenderChapterHead(heading, index)" />
            }
            else
            {
                @RenderChapterHead(heading, index)
            }

            return;
        }

        @RenderBlock(block)
    };

    /// <summary>
    /// A heading, and the one thing a reader wants to do with the chapter under
    /// it: take it away with them.
    ///
    /// <para>Beside the heading rather than at the end of the chapter, because
    /// the heading is what a reader is looking at when they decide they want it,
    /// and because a chapter's end is not a place on the screen — a long one ends
    /// somewhere off the fold.</para>
    ///
    /// <para>The heading element itself is untouched: it is what heading
    /// navigation matches on, and it is rendered from the same fragment whether
    /// or not there is anything to copy.</para>
    /// </summary>
    private RenderFragment RenderChapterHead(MdHeading heading, int index) => __builder =>
    {
        if (ChapterAt(index) is not { } chapter)
        {
            @RenderBlock(heading)
            return;
        }

        <div class="md-chapter-head">
            @RenderBlock(heading)
            @* The markdown, not the rendering, for the reason the file-level copy
               gives: the source is what round trips. *@
            <CopyButton Text="@chapter.Text"
                        Label="@($"Copy {chapter.Title}")"
                        CssClass="md-chapter-head__copy"
                        ButtonCssClass="md-copy md-chapter-copy"
                        StatusCssClass="md-copy__status"
                        ButtonTestId="@($"markdown-chapter-copy-{index}")"
                        StatusTestId="@($"markdown-chapter-copy-status-{index}")" />
        </div>
    };

    /// <summary>
    /// One block, drawn by the component that owns every block's markup.
    ///
    /// <para>Everything this view knows that a single block cannot — the fence
    /// paired with the heading above it, the chapter's own copy button, the
    /// gutter beside it — is decided before the call and none of it travels
    /// down. What does travel down is the reading: whether a <c>meta</c> fence is
    /// a record, which folder it was read from, and the inline hook. So a block
    /// drawn here and the same block drawn by a knowledge panel differ in the
    /// classes they wear and in nothing else.</para>
    ///
    /// <para>Headings come through here too, including the one a chapter head
    /// wraps. Heading navigation matches on that element, so a second
    /// hand-written copy of it would silently drift out of reach — which is the
    /// reason this was one fragment before it was one component.</para>
    /// </summary>
    private RenderFragment RenderBlock(MdBlock block) =>
        @<MarkdownBlockView Block="@block"
                            OnTaskItemToggled="@OnTaskItemToggled"
                            InlineTarget="@InlineTarget"
                            RenderKnowledgeMetadata="@RenderKnowledgeMetadata"
                            RenderKnowledgeMetadataFields="@RenderKnowledgeMetadataFields"
                            KnowledgeFolder="@KnowledgeFolder"
                            OnKnowledgeNavigate="@OnKnowledgeNavigate"
                            KnowledgeHrefFor="@KnowledgeHrefFor"
                            ShowDiagramSource="@ShowDiagramSource" />;

    private string? _editingId;
    private string _draft = string.Empty;

    /// <summary>Whether anything hangs off a block — an affordance to add a
    /// remark or to ask for a rewrite, or a remark or a suggestion already there.
    ///
    /// <para>It widened to take the AI affordances rather than gaining a second
    /// flag beside it, so a view that asks for none of them renders exactly the
    /// markup it rendered before any of this existed. That "nothing already
    /// rendering changed" guarantee is the same one the knowledge metadata work
    /// made, and it is worth keeping for the same reason: a stylesheet and a
    /// screenshot test both see the wrapper.</para></summary>
    private bool Annotated => CanComment || CanRewrite || Comments.Count > 0 || Proposals.Count > 0;

    private string ViewClass =>
        $"md-view{(Layout is MarkdownCommentLayout.Margin && Annotated ? " md-view--margin" : string.Empty)}{(DrawsKnowledgeStatus ? " md-view--status-column" : string.Empty)}";

    /// <summary>Whether this document draws chapter status, and so owes the
    /// column down its right that the status is read in.
    /// <para>A fact about the document rather than about a block: the point of
    /// the column is that every line in the file stops at the same rule, and one
    /// measured per block would be a ragged edge with a pill somewhere in it.
    /// Asked of the blocks rather than of the folder, because a chapter with no
    /// `meta` fence renders no status however knowledgeable the view is
    /// configured to be — and a column reserved for a status nobody drew is a
    /// margin of nothing.</para></summary>
    private bool DrawsKnowledgeStatus =>
        RenderKnowledgeMetadata
        && Blocks.Any(block => block is MdCode fence && MetadataReader.IsMetaBlock(fence.Language));

    /// <summary>What the block reserves on its right, said as a class so the
    /// stylesheet does not have to guess.
    /// <para>The controls in the corner are out of flow, so without this the
    /// prose beside them keeps the whole column and runs underneath them. The
    /// gutter is only paid where a control is actually rendered: a view that
    /// shows comments nobody can add to is annotated and has no corner, and a
    /// margin reserved there would hold nothing. Two controls take two slots,
    /// because a strip sized for one puts the pair back over the words.</para></summary>
    private string AffordanceClass => (CanComment, CanRewrite) switch
    {
        (true, true) => "md-block--affordance md-block--affordance-pair",
        (false, false) => string.Empty,
        _ => "md-block--affordance"
    };

    /// <summary>The draft is held here and the comment is only told about it
    /// when it is saved. An edit that reported every keystroke would make Cancel
    /// mean nothing — the change it was meant to abandon would already have
    /// landed.</summary>
    private void StartEdit(MarkdownComment comment)
    {
        _editingId = comment.Id;
        _draft = comment.Body;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _draft = string.Empty;
    }

    private async Task SaveEditAsync(MarkdownComment comment)
    {
        var body = _draft.Trim();
        CancelEdit();

        // An empty comment is a delete asked for the wrong way, and an unchanged
        // one is not an edit. Neither is raised.
        if (body.Length == 0 || string.Equals(body, comment.Body, StringComparison.Ordinal)) return;

        await OnEditComment.InvokeAsync(comment with { Body = body });
    }

    /// <summary>The comments hanging off one block, in the order they were
    /// given.</summary>
    private IReadOnlyList<MarkdownComment> CommentsOn(int index) =>
        [.. Comments.Where(comment => comment.BlockIndex == index)];

    /// <summary>Comments whose block is no longer there. Shown at the end rather
    /// than dropped: a lost comment is worse than a stray one.</summary>
    private IReadOnlyList<MarkdownComment> Orphans =>
        [.. Comments.Where(comment => comment.BlockIndex < 0 || comment.BlockIndex >= Blocks.Count)];

    /// <summary>The proposals hanging off one block. A proposal carrying a
    /// comment id belongs to that comment and is drawn inside it, so it is
    /// excluded here rather than rendered twice.</summary>
    private IReadOnlyList<AiProposal> ProposalsOn(int index) =>
        [.. Proposals.Where(proposal => proposal.CommentId is null && proposal.BlockIndex == index)];

    /// <summary>The proposals against one comment.</summary>
    private IReadOnlyList<AiProposal> ProposalsFor(string commentId) =>
        [.. Proposals.Where(proposal => string.Equals(proposal.CommentId, commentId, StringComparison.Ordinal))];

    /// <summary>Proposals with nowhere left to hang: a block that went away, a
    /// comment that was deleted, or no anchor given at all. Same answer as an
    /// orphaned comment, and for the same reason.</summary>
    private IReadOnlyList<AiProposal> OrphanProposals =>
    [
        .. Proposals.Where(proposal => proposal.CommentId is { } commentId
            ? !Comments.Any(comment => string.Equals(comment.Id, commentId, StringComparison.Ordinal))
            : proposal.BlockIndex is not { } block || block < 0 || block >= Blocks.Count)
    ];

    /// <summary>
    /// Suggestions, drawn wherever they are anchored.
    /// <para>
    /// The card raises Accept and Reject and this view applies neither: the host
    /// re-parses and hands back new blocks, exactly as it already does for an
    /// edited comment. A view that wrote into its own content would be holding a
    /// second copy of the truth, and the two would eventually differ.
    /// </para>
    /// </summary>
    private RenderFragment RenderProposals(IReadOnlyList<AiProposal> proposals) =>
        @<text>
            @foreach (var proposal in proposals)
            {
                <AiProposalCard Proposal="@proposal"
                                OnAccept="@OnAcceptProposal"
                                OnReject="@OnRejectProposal"
                                CssClass="md-proposal"
                                TestId="@($"markdown-proposal-{proposal.Id}")"
                                AcceptTestId="@($"markdown-proposal-accept-{proposal.Id}")"
                                RejectTestId="@($"markdown-proposal-reject-{proposal.Id}")" />
            }
        </text>;

    private RenderFragment RenderComments(IReadOnlyList<MarkdownComment> comments) =>
        @<text>
            @if (comments.Count > 0)
            {
                <ul class="md-comments">
                    @foreach (var comment in comments)
                    {
                        @* Resolved stays visible and quiet. The reason a
                           paragraph reads the way it does is usually in the
                           comment that got it there. *@
                        <li class="md-comment @(comment.Resolved ? "md-comment--resolved" : string.Empty)"
                            data-testid="@($"markdown-comment-body-{comment.Id}")">
                            @if (!string.IsNullOrWhiteSpace(comment.Author) || !string.IsNullOrWhiteSpace(comment.Timestamp))
                            {
                                <p class="md-comment__who">
                                    @if (!string.IsNullOrWhiteSpace(comment.Author))
                                    {
                                        <span class="md-comment__author">@comment.Author</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(comment.Timestamp))
                                    {
                                        <span class="md-comment__when">@comment.Timestamp</span>
                                    }
                                    @if (comment.Resolved)
                                    {
                                        <span class="md-comment__resolved">Resolved</span>
                                    }
                                </p>
                            }

                            @if (string.Equals(_editingId, comment.Id, StringComparison.Ordinal))
                            {
                                @* A comment is prose that may run to a paragraph,
                                   so it gets a box and two buttons rather than
                                   the commit-on-Enter a one-line rename uses:
                                   Enter has to stay a newline here. *@
                                <div class="md-comment__edit">
                                    <TextArea Value="@_draft"
                                              ValueChanged="v => _draft = v"
                                              AriaLabel="Edit comment"
                                              Rows="3"
                                              Bare="true"
                                              TestId="@($"markdown-comment-editor-{comment.Id}")" />
                                    <div class="md-comment__edit-actions">
                                        <button type="button"
                                                class="md-comment__action"
                                                data-testid="@($"markdown-comment-save-{comment.Id}")"
                                                @onclick="() => SaveEditAsync(comment)">Save</button>
                                        <button type="button"
                                                class="md-comment__action"
                                                data-testid="@($"markdown-comment-cancel-{comment.Id}")"
                                                @onclick="CancelEdit">Cancel</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <p class="md-comment__body">@comment.Body</p>

                                @* A resolution proposal renders inside the
                                   comment it answers rather than against the
                                   block, because that is what it is about — the
                                   block may be fine and the remark the thing that
                                   needs settling. *@
                                @RenderProposals(ProposalsFor(comment.Id))

                                <span class="md-comment__actions">
                                    @if (OnEditComment.HasDelegate)
                                    {
                                        <button type="button"
                                                class="md-comment__action"
                                                data-testid="@($"markdown-comment-edit-{comment.Id}")"
                                                @onclick="() => StartEdit(comment)">Edit</button>
                                    }
                                    @if (OnResolveComment.HasDelegate)
                                    {
                                        <button type="button"
                                                class="md-comment__action"
                                                data-testid="@($"markdown-comment-resolve-{comment.Id}")"
                                                @onclick="() => OnResolveComment.InvokeAsync(comment.Id)">
                                            @(comment.Resolved ? "Reopen" : "Resolve")
                                        </button>
                                    }
                                    @if (OnResolveCommentWithAi.HasDelegate)
                                    {
                                        @* A third button, and deliberately not a
                                           change to the second. Resolving with AI
                                           is two acts: this one asks for a
                                           wording, and the existing Resolve still
                                           means exactly what it meant. Folding
                                           them together would make one press do
                                           two things on one confirmation, and a
                                           reader who wanted the suggested wording
                                           but not the resolution would have no way
                                           to say so. *@
                                        <button type="button"
                                                class="md-comment__action md-comment__action--ai"
                                                data-testid="@($"markdown-comment-ai-resolve-{comment.Id}")"
                                                @onclick="() => OnResolveCommentWithAi.InvokeAsync(comment.Id)">Resolve with AI</button>
                                    }
                                </span>
                            }
                        </li>
                    }
                </ul>
            }
        </text>;
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<MdBlock> Blocks { get; set; } = [];

    [Parameter]
    public EventCallback<int> OnTaskItemToggled { get; set; }

    /// <summary>The markdown these blocks were parsed from. Only needed to offer
    /// a copy button — the view renders from <see cref="Blocks"/> and never reads
    /// this — but copying the rendering rather than the source would hand back
    /// something that does not paste into anything.</summary>
    [Parameter]
    public string? Source { get; set; }

    /// <summary>Whether to offer a copy button. Needs <see cref="Source"/>: with
    /// nothing to copy there is nothing to offer.</summary>
    [Parameter]
    public bool AllowCopy { get; set; }

    [Parameter]
    public string CopyLabel { get; set; } = "Copy markdown";

    /// <summary>Whether each heading offers to copy its own chapter as well.
    /// Needs <see cref="Source"/> for the same reason the file-level copy does,
    /// and needs the blocks to have come from it: the chapters are sliced out of
    /// that text and matched to the headings on screen, and where the two
    /// disagree no button is offered rather than one that copies from the wrong
    /// place.</summary>
    [Parameter]
    public bool AllowChapterCopy { get; set; }

    /// <summary>Comments against blocks of this view. Anchored by block index,
    /// and re-anchoring when blocks move is the host's — see MarkdownComment.</summary>
    [Parameter]
    public IReadOnlyList<MarkdownComment> Comments { get; set; } = [];

    /// <summary>Raised with the block index a reader wants to comment on.
    /// Without it no block carries the affordance, and the markup is exactly what
    /// it was before comments existed.</summary>
    [Parameter]
    public EventCallback<int> OnAddComment { get; set; }

    /// <summary>Raised with a comment's id. Without it a comment shows its state
    /// and offers no way to change it.</summary>
    [Parameter]
    public EventCallback<string> OnResolveComment { get; set; }

    /// <summary>Raised with the whole comment, body already replaced. The record
    /// rather than the text, so a host storing more than this component shows —
    /// a thread, an edit history — gets back something it can match up.</summary>
    [Parameter]
    public EventCallback<MarkdownComment> OnEditComment { get; set; }

    /// <summary>Where the remarks are drawn: under each block, or in a column
    /// beside the body.</summary>
    [Parameter]
    public MarkdownCommentLayout Layout { get; set; } = MarkdownCommentLayout.Inline;

    /// <summary>Raised with the index of a block a reader wants rewritten.
    /// Without it no block carries the affordance, and the markup is exactly what
    /// it was before any of this existed.
    ///
    /// <para>An index and not a range, and that is forced rather than chosen —
    /// see <see cref="MarkdownComment"/>. Which is why "rewrite part with AI"
    /// means rewrite this paragraph and can never mean rewrite this sentence:
    /// there is no anchor in this product that would survive the second.</para></summary>
    [Parameter]
    public EventCallback<int> OnRewriteBlock { get; set; }

    /// <summary>Raised with a comment's id when a reader asks an AI to settle it.
    /// The host runs the tool and hands back a proposal; nothing about the
    /// comment changes here, and the existing <see cref="OnResolveComment"/> keeps
    /// its exact meaning.</summary>
    [Parameter]
    public EventCallback<string> OnResolveCommentWithAi { get; set; }

    /// <summary>Suggestions held for review. A rewrite hangs off the block its
    /// <c>BlockIndex</c> names; a resolution hangs off the comment its
    /// <c>CommentId</c> names; anything anchored to something that has gone joins
    /// the orphan region the comments already use.</summary>
    [Parameter]
    public IReadOnlyList<AiProposal> Proposals { get; set; } = [];

    /// <summary>Raised with the whole proposal. This view applies nothing: the
    /// host writes the change, re-parses, and hands back new blocks — the same
    /// discipline <see cref="OnEditComment"/> keeps, and for the same reason.
    ///
    /// <para>It also does not resolve anything. Accepting a resolution proposal
    /// raises this and nothing else; a host that wants the comment resolved too
    /// calls <see cref="OnResolveComment"/> second. One act, one callback.</para></summary>
    [Parameter]
    public EventCallback<AiProposal> OnAcceptProposal { get; set; }

    /// <summary>Raised with the whole proposal. Rejecting leaves the document
    /// byte-identical rather than restored, because nothing was ever applied.</summary>
    [Parameter]
    public EventCallback<AiProposal> OnRejectProposal { get; set; }

    /// <summary>Whether a diagram drawn from a fence keeps its own source
    /// disclosure. Forwarded verbatim to <c>DiagramView.ShowSource</c>, for a host
    /// that already shows the body's markdown beside the rendering and would
    /// otherwise print the same fence twice.</summary>
    [Parameter]
    public bool ShowDiagramSource { get; set; } = true;

    /// <summary>Whether a fenced <c>meta</c> block is read as the metadata record
    /// it is. Off by default: most markdown in this product is not a knowledge
    /// document, and where it is not, a `meta` fence is only a fenced block.</summary>
    [Parameter]
    public bool RenderKnowledgeMetadata { get; set; }

    /// <summary>Whether the document's own metadata block — the fence under the
    /// title that opens it — is drawn here at all. On by default, so a host that
    /// says nothing gets the record folded into its title exactly as it always
    /// has.
    ///
    /// <para>Off for a host that has somewhere better to put it. A surface framing
    /// the whole file already says which file this is, and it says it in a header
    /// that stays put while the body scrolls — which is where the answer to "is
    /// this still current?" belongs, rather than at the top of a document the
    /// reader has scrolled past. The fence is then not drawn here in any form:
    /// leaving it behind as a code block would be the same record twice, the
    /// second time with the reading taken off.</para>
    ///
    /// <para>Only the document's own block. A <c>##</c> chapter's record describes
    /// the chapter under it, that heading is in the body, and this says nothing
    /// about it.</para></summary>
    [Parameter]
    public bool RenderFileKnowledgeMetadata { get; set; } = true;

    /// <summary>Whether a metadata record draws everything under the status as
    /// well. On by default, so nothing that renders one today changes. A surface
    /// that is already showing the file itself turns it off: `order`, `aliases`
    /// and `version` have no visualization a reader gains anything from, so
    /// printing them as rows is the fence again with the fence taken off.
    /// Forwarded verbatim to <c>MetadataView.ShowFields</c>.</summary>
    [Parameter]
    public bool RenderKnowledgeMetadataFields { get; set; } = true;

    /// <summary>Which knowledge folder the document was read from, so a status
    /// can be checked against that folder's vocabulary.</summary>
    [Parameter]
    public KnowledgeFolder KnowledgeFolder { get; set; } = KnowledgeFolder.Unknown;

    /// <summary>Raised with the reference a reader activated in a metadata
    /// block.</summary>
    [Parameter]
    public EventCallback<KnowledgeReference> OnKnowledgeNavigate { get; set; }

    /// <summary>
    /// The repository-relative path of the knowledge document these blocks were
    /// read from, carrying its area folder — <c>.domain/roadmap/features.md</c>.
    ///
    /// <para>Without it a relative link in the prose is unreadable, and the
    /// knowledge folders write almost every link relative: a sibling as
    /// <c>domain.md#roadmap-item-gathering</c> and another context as
    /// <c>../backlog/domain.md#backlog-entry</c>, because those folders are read in
    /// plain markdown viewers too. The blocks say nothing about where they came
    /// from, so the host has to.</para>
    ///
    /// <para>Handing it over also says this <em>is</em> a knowledge document, which
    /// is why it opens the inline hook on its own. The instruction files are read
    /// in the knowledge pane and carry no <c>meta</c> fence at all, so
    /// <see cref="RenderKnowledgeMetadata"/> — a question about fences — has
    /// nothing to say about them. Both signals stay opt-in and an entry's body
    /// gives neither, which is what keeps a path in one a path being quoted.</para>
    /// </summary>
    [Parameter]
    public string? KnowledgeDocumentPath { get; set; }

    /// <summary>Resolves a metadata reference to a link target.</summary>
    [Parameter]
    public Func<KnowledgeReference, string?>? KnowledgeHrefFor { get; set; }

    /// <summary>Raised when a reader picked a different status in the record
    /// beside a chapter's heading. Nothing here writes it — see
    /// <see cref="KnowledgeStatusChange"/> for what the host is being told and
    /// what it still owns.</summary>
    [Parameter]
    public EventCallback<KnowledgeStatusChange> OnKnowledgeStatusChanged { get; set; }

    /// <summary>Parsed metadata blocks, kept per block. A view re-renders far
    /// more often than its blocks change — every comment edit redraws all of
    /// them — and re-parsing the same fence each time buys nothing.</summary>
    private readonly Dictionary<MdCode, MetadataRecord> _metadata = [];

    /// <summary>Which chapter of the source each heading block is the top of.
    /// Empty when the source was not given, or when what it splits into does not
    /// match what is being rendered.</summary>
    private readonly Dictionary<int, MarkdownChapter> _chapters = [];

    private string? _splitSource;
    private IReadOnlyList<MdBlock>? _splitBlocks;

    protected override void OnParametersSet()
    {
        _metadata.Clear();

        // Splitting walks the whole file, and a view re-renders for reasons that
        // have nothing to do with it — a comment being typed, most of all. Only
        // the two inputs the alignment is made of can invalidate it.
        if (_splitSource == Source && ReferenceEquals(_splitBlocks, Blocks)) return;

        AlignChapters();
        _splitSource = Source;
        _splitBlocks = Blocks;
    }

    /// <summary>
    /// Matches the chapters of the source to the headings on screen, by order and
    /// by level.
    /// <para>
    /// Both checks, because there is no id to match on: the blocks carry no
    /// offsets back into the text they were parsed from. Order alone would hand a
    /// heading the wrong chapter the moment the two lists disagree — which they
    /// do whenever the blocks did not come from this source, or came from
    /// <see cref="MarkdownPreview.Parse"/>, where a <c>##</c> is folded into a
    /// sub-item and never appears as a heading at all. A mismatch anywhere
    /// abandons the whole alignment rather than trusting the prefix that happened
    /// to line up: a copy button that quietly copies the wrong chapter is worse
    /// than no copy button.
    /// </para>
    /// </summary>
    private void AlignChapters()
    {
        _chapters.Clear();
        if (string.IsNullOrEmpty(Source)) return;

        var chapters = MarkdownChapters.Split(Source);
        var headings = Blocks
            .Select((block, index) => (Index: index, Heading: block as MdHeading))
            .Where(pair => pair.Heading is not null)
            .ToList();

        if (chapters.Count != headings.Count) return;

        for (var position = 0; position < headings.Count; position++)
        {
            if (headings[position].Heading!.Level != chapters[position].Level)
            {
                _chapters.Clear();
                return;
            }

            _chapters[headings[position].Index] = chapters[position];
        }
    }

    /// <summary>The chapter a heading block is the top of, when the source it was
    /// sliced from is known and a caller asked for the copy.</summary>
    private MarkdownChapter? ChapterAt(int index) =>
        AllowChapterCopy && _chapters.TryGetValue(index, out var chapter) ? chapter : null;

    /// <summary>The heading a status change should name, which is the chapter's
    /// title when the source is known. Read whether or not the copy button was
    /// asked for: what the change is called does not depend on that.</summary>
    private Task ReportStatusAsync(int index, string status) =>
        OnKnowledgeStatusChanged.InvokeAsync(
            new KnowledgeStatusChange(index, _chapters.TryGetValue(index, out var chapter) ? chapter.Title : null, status));

    private MetadataRecord MetadataOf(MdCode block)
    {
        if (_metadata.TryGetValue(block, out var parsed)) return parsed;

        parsed = MetadataReader.Parse(block.Text);
        _metadata[block] = parsed;
        return parsed;
    }

    /// <summary>The <c>meta</c> fence a heading at this index owns, if it wrote
    /// one directly underneath — which is where the convention puts it.
    ///
    /// <para>Never the document's own fence when a host is drawing that itself:
    /// the title is then a plain heading again, and pairing it here would put the
    /// record back in the body the host just took it out of.</para>
    ///
    /// <para>In annotated mode too. It used to be skipped there, on the grounds
    /// that folding two blocks into one row would leave the fence's comments
    /// pointing at a row that no longer exists — true, and answered by the row
    /// taking both indices' notes rather than by giving up the pairing. The cost
    /// of giving it up was that a reviewed chapter — the one document whose
    /// currency a reader most needs to see — was the only one that showed its
    /// status as a raw code fence.</para></summary>
    private MdCode? PairedMetaFence(int index) =>
        RenderKnowledgeMetadata
        && !(index == 0 && HoistsFileMetadata)
        && index + 1 < Blocks.Count
        && Blocks[index] is MdHeading
        && Blocks[index + 1] is MdCode fence
        && MetadataReader.IsMetaBlock(fence.Language)
            ? fence
            : null;

    /// <summary>Whether the document's own block — the fence under the title that
    /// opens it — is somebody else's to draw. Both halves of the question, because
    /// a view that was never told to read <c>meta</c> fences at all has no records
    /// to hoist and its fence is still a code block.</summary>
    private bool HoistsFileMetadata =>
        RenderKnowledgeMetadata
        && !RenderFileKnowledgeMetadata
        && MarkdownFileMetadata.OpensWithFileBlock(Blocks);

    /// <summary>Whether the block at this index is drawn somewhere other than its
    /// own turn in the loop — as the heading above it, or in the host's own
    /// chrome — in which case that turn is a no-op rather than a second
    /// rendering. A hoisted fence must not fall back to a code block either: the
    /// raw fence under a title whose record is already on screen is the same
    /// duplication read twice over.</summary>
    private bool DrawnElsewhere(int index) =>
        (index > 0 && PairedMetaFence(index - 1) is not null)
        || (index == 1 && HoistsFileMetadata);

    /// <summary>Whether this block's row also stands in for the one after it. Both
    /// ways a <c>meta</c> fence loses its own row come to the same thing for the
    /// heading above it, so both are asked here rather than at each use.</summary>
    private bool AbsorbsNextBlock(int index) =>
        PairedMetaFence(index) is not null || (index == 0 && HoistsFileMetadata);

    /// <summary>
    /// The comments a row shows: its own, and the fence's when it drew one.
    ///
    /// <para>Anchors are untouched by the pairing — a comment on the fence still
    /// says the fence's index, and the host that wrote it has nothing to fix up.
    /// Only where it is *drawn* moves, into the row of the heading the fence was
    /// folded into, which is the row that is level with it on the screen. The
    /// alternative was an empty row carrying notes for a block the reader can no
    /// longer see.</para>
    ///
    /// <para>A hoisted fence takes the same answer, and has to: it has no row of
    /// its own either way, and the row level with the title is still the title's.
    /// That the record itself is now in a host's header does not make a remark
    /// left on the file's own fence an orphan.</para>
    /// </summary>
    private IReadOnlyList<MarkdownComment> NotesOn(int index) =>
        AbsorbsNextBlock(index)
            ? [.. CommentsOn(index), .. CommentsOn(index + 1)]
            : CommentsOn(index);

    /// <summary>The proposals a row shows, merged for the same reason its
    /// comments are.</summary>
    private IReadOnlyList<AiProposal> SuggestionsOn(int index) =>
        AbsorbsNextBlock(index)
            ? [.. ProposalsOn(index), .. ProposalsOn(index + 1)]
            : ProposalsOn(index);

    private bool CanComment => OnAddComment.HasDelegate;

    private bool CanRewrite => OnRewriteBlock.HasDelegate;

    /// <summary>
    /// The hook handed to the inline renderer, and null where a host has said
    /// neither of the two things that make this a knowledge document — which is
    /// what keeps a code span in an entry's body a code span.
    ///
    /// <para>What the hook then does is
    /// <see cref="KnowledgeInlineTargets"/>'s, and deliberately not this view's:
    /// the arc42 read-only fallback and the design sections render their own block
    /// trees straight through <see cref="MarkdownRender"/>, and a rule that lived
    /// here would have had to be written a second and third time to reach
    /// them.</para>
    ///
    /// <para>Two signals rather than one because they answer different questions.
    /// <see cref="RenderKnowledgeMetadata"/> asks whether a <c>meta</c> fence is a
    /// record, which the instruction files — read in the same pane, carrying
    /// frontmatter instead — never had an opinion about;
    /// <see cref="KnowledgeDocumentPath"/> says outright which knowledge document
    /// this is. Either is a host stating that the prose here is convention-written
    /// prose. Neither is anything an entry's body says.</para>
    /// </summary>
    private MarkdownRender.MarkdownInlineTarget? InlineTarget =>
        RenderKnowledgeMetadata || !string.IsNullOrWhiteSpace(KnowledgeDocumentPath)
            ? KnowledgeInlineTargets.For(KnowledgeDocumentPath, KnowledgeHrefFor, OnKnowledgeNavigate)
            : null;
}
