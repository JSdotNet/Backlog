@*
    One outside tool that tasks can follow, as the settings screen lists it: the
    tool's mark and name, who is signed in to it, and what has been connected
    through it.

    Every value is a parameter and every act a callback, so the card holds no
    state of its own beyond what a field is showing. The host decides what a
    connector is called, whether it signs in, and what adding or removing a
    target does; the card only draws the answers. That is what lets the storybook
    show a signed-in tool, a signed-out one and one mid-sign-in with no
    application behind it.

    The mark is the connector's own glyph, coloured by the design token it names,
    and hidden from assistive technology: the name beside it says the same thing
    in words.
*@

<Card AriaLabel="@Name" CssClass="connector-card" TestId="@TestId">
    <div class="connector-card__head">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <span class="connector-card__mark" style="@MarkStyle" aria-hidden="true">@Icon</span>
        }
        <h3 class="card__title connector-card__name">@Name</h3>

        @if (SignsIn)
        {
            <span class="connector-card__account" role="status" data-testid="connector-account">
                @(string.IsNullOrWhiteSpace(AccountName) ? "Not signed in" : $"Signed in as {AccountName}")
            </span>

            @if (string.IsNullOrWhiteSpace(AccountName))
            {
                <AppButton Variant="ButtonVariant.Primary"
                           Size="ButtonSize.Small"
                           Busy="@SigningIn"
                           BusyLabel="Signing in"
                           TestId="connector-sign-in"
                           OnClick="() => OnSignIn.InvokeAsync()">Sign in</AppButton>
            }
            else
            {
                <AppButton Variant="ButtonVariant.Secondary"
                           Size="ButtonSize.Small"
                           TestId="connector-sign-out"
                           OnClick="() => OnSignOut.InvokeAsync()">Sign out</AppButton>
            }
        }
    </div>

    @if (SignsIn)
    {
        <Alert Message="@SignInError" TestId="connector-sign-in-error" />
    }

    @if (Targets is not null)
    {
        @if (Targets.Count == 0)
        {
            <p class="connector-card__none" data-testid="connector-no-targets">Nothing connected yet.</p>
        }
        else
        {
            <ul class="connector-card__targets" aria-label="@($"Connected to {Name}")">
                @foreach (var target in Targets)
                {
                    <li @key="target.Name" class="connector-card__target" data-testid="connector-target" data-target="@target.Name">
                        <Toggle Label="@target.Name"
                                Checked="@target.Enabled"
                                CheckedChanged="enabled => OnTargetEnabledChanged.InvokeAsync(target with { Enabled = enabled })"
                                CssClass="connector-card__toggle"
                                TestId="connector-target-enabled" />
                        <IntegrationFreshness Reading="@(new IntegrationReading(target.LastSynced))"
                                              Prefix="Synced"
                                              NeverText="Not synced yet"
                                              TextTestId="connector-target-synced" />
                        <DeleteButton Label="Remove"
                                      AriaLabel="@($"Remove {target.Name}")"
                                      Size="ButtonSize.Small"
                                      ShowIcon="false"
                                      TestId="connector-target-remove"
                                      OnClick="() => OnRemoveTarget.InvokeAsync(target)" />
                    </li>
                }
            </ul>
        }

        <form class="connector-card__add" @onsubmit="() => OnAddTarget.InvokeAsync()" @onsubmit:preventDefault="true">
            <TextField Label="Add"
                       Placeholder="@AddPlaceholder"
                       Value="@AddDraft"
                       ValueChanged="value => AddDraftChanged.InvokeAsync(value)"
                       ErrorMessage="@AddError"
                       Compact="true"
                       CssClass="connector-card__add-field"
                       TestId="connector-add"
                       autocomplete="off"
                       spellcheck="false" />
            <AppButton Type="submit"
                       Size="ButtonSize.Small"
                       TestId="connector-add-button">Add</AppButton>
        </form>
    }
</Card>

@code {
    /// <summary>What a person reads, such as the tool's name.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    /// <summary>The glyph drawn before the name, or nothing.</summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>The design token the glyph is coloured with, with or without its
    /// leading <c>--</c>. Anything that is not a token name is ignored, so the
    /// glyph keeps the text colour rather than carrying a stray declaration.</summary>
    [Parameter]
    public string? ColorToken { get; set; }

    /// <summary>Whether the tool has a sign-in for the card to offer. Without it
    /// there is no account line and no button.</summary>
    [Parameter]
    public bool SignsIn { get; set; }

    /// <summary>Who is signed in, or null when nobody is.</summary>
    [Parameter]
    public string? AccountName { get; set; }

    /// <summary>A sign-in is under way: the button is busy and cannot be pressed
    /// twice.</summary>
    [Parameter]
    public bool SigningIn { get; set; }

    /// <summary>Why the last sign-in did not work, as the host words it.</summary>
    [Parameter]
    public string? SignInError { get; set; }

    [Parameter]
    public EventCallback OnSignIn { get; set; }

    [Parameter]
    public EventCallback OnSignOut { get; set; }

    /// <summary>What is connected through the tool, in the host's order. Null when
    /// the host keeps none, and then there is no list and nothing to add to.</summary>
    [Parameter]
    public IReadOnlyList<ConnectorTargetRow>? Targets { get; set; }

    /// <summary>A switch was flipped. The row carries the value it was flipped
    /// to.</summary>
    [Parameter]
    public EventCallback<ConnectorTargetRow> OnTargetEnabledChanged { get; set; }

    [Parameter]
    public EventCallback<ConnectorTargetRow> OnRemoveTarget { get; set; }

    /// <summary>What the add field shows. The host holds it, so it can clear the
    /// field once the target is kept and leave it as typed when it is not.</summary>
    [Parameter]
    public string? AddDraft { get; set; }

    [Parameter]
    public EventCallback<string> AddDraftChanged { get; set; }

    /// <summary>A hint in the empty add field, in the tool's own spelling of what
    /// a target is.</summary>
    [Parameter]
    public string? AddPlaceholder { get; set; }

    /// <summary>Why the last add was refused, shown under the field.</summary>
    [Parameter]
    public string? AddError { get; set; }

    /// <summary>Add was pressed, or Enter in the field. The text is
    /// <see cref="AddDraft"/>.</summary>
    [Parameter]
    public EventCallback OnAddTarget { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    private string? MarkStyle
    {
        get
        {
            var token = ColorToken?.Trim().TrimStart('-');
            if (string.IsNullOrEmpty(token) || !token.All(c => char.IsAsciiLetterOrDigit(c) || c == '-')) return null;

            return $"color: var(--{token})";
        }
    }
}
