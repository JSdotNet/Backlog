@using Backlog.UI.Components.Buttons
@using Backlog.UI.Components.Inputs
@using Backlog.UI.Components.Layout
@using Backlog.UI.Components.Selects
@*
    One connected repository or product, and how its sync behaves: the card a
    connector settings page draws once per target.

    The same options for every connector, because they are the sync's rather than
    the source's — ADR 0020 §9 — so the card needs nothing from a connector beyond
    its descriptor's name and icon. A connector added later is edited here with no
    change to this file. The one exception is "Complete at the source", drawn only
    when the host says the connector can, because a switch for something the source
    cannot do would do nothing.

    Every change is reported at once as the whole options record, and nothing is
    held as a draft: the host saves it and hands the saved record back, so what
    the card shows is always what is stored.

    Two options are filled from the host rather than the record alone: the
    repository a target's new tasks are filed under, picked from the registry the
    host hands in, and the Statuses group, one row per status the source lists,
    each mapped to a task status or left to the default its state gives. A source
    that lists none gets no group; with nothing to pick and nothing stored, there
    is no repository picker.

    A connector that asks questions also gets one line under "Only questions
    assigned to me": its own push reaches a phone subscribed to it as well, and
    which of its preferences leaves only Backlog's.

    A last sync that failed is shown under the head, in the sync's own sentence,
    until a sync succeeds: a target that stopped syncing says why on its own card.
    So does a target the host says is paused, in the host's sentence, while its
    switch keeps what the person set.
    What the host's answer to this card's Sync now was is shown on this card too,
    so two cards syncing at once never read each other's answer.

    A target whose tasks were deleted offers to restore them, when the host listens
    and says how many there are. The card only raises the request: the host asks
    before it restores anything, since the count may include tasks the person
    deleted one by one.
*@

<Card Compact="true" CssClass="connected-target" TestId="@TestId" AriaLabel="@($"{Options.ConnectorName} {Options.Target}")">
    <div class="connected-target__head">
        @if (Mark is not IntegrationProvider.None)
        {
            <ProviderMark Provider="@Mark" Size="16" />
        }
        <span class="connected-target__connector">@Options.ConnectorName</span>
        <code class="connected-target__name" data-testid="@Suffix("name")">@Options.Target</code>
        <span class="connected-target__synced" data-testid="@Suffix("synced")">
            @(Options.LastSynced is null ? "Not synced yet" : $"Synced {Options.LastSynced}")
        </span>
    </div>

    @* Role status rather than alert: it is what the stored target says, drawn on
       every render, not an event — the page's own message announces a sync that
       just failed. *@
    <Alert Message="@LastSyncErrorText"
           Role="status"
           CssClass="connected-target__error"
           TestId="@Suffix("error")" />

    <Alert Message="@Options.PausedReason"
           Role="status"
           CssClass="connected-target__paused"
           TestId="@Suffix("paused")" />

    <div class="connected-target__options">
        <Toggle Label="Sync this target"
                Description="Off keeps its tasks and stops bringing in new ones."
                Checked="@Options.Enabled"
                CheckedChanged="value => ChangeAsync(Options with { Enabled = value })"
                TestId="@Suffix("enabled")" />
        <Toggle Label="Titles follow the source"
                Description="A title you rename stops following until you reset it."
                Checked="@Options.TitleFollowsSource"
                CheckedChanged="value => ChangeAsync(Options with { TitleFollowsSource = value })"
                TestId="@Suffix("title-follows")" />
        @if (Options.CanCompleteAtSource)
        {
            <Toggle Label="Complete at the source"
                    Description="Finishing a task here finishes its item at the source."
                    Checked="@Options.CompleteAtSource"
                    CheckedChanged="value => ChangeAsync(Options with { CompleteAtSource = value })"
                    TestId="@Suffix("complete-at-source")" />
        }
        @if (Options.HasQuestions)
        {
            <Toggle Label="Only questions assigned to me"
                    Description="Off also brings the unassigned questions you may answer."
                    Checked="@Options.OnlyQuestionsAssignedToMe"
                    CheckedChanged="value => ChangeAsync(Options with { OnlyQuestionsAssignedToMe = value })"
                    TestId="@Suffix("only-assigned-questions")">
                @* The source pushes its own questions to a phone subscribed to it, so
                   that phone buzzes twice for each one. Both pushes are kept, and the
                   card says which switch on the phone leaves only Backlog's. *@
                <TextContent>
                    <span class="connected-target__push-hint" data-testid="@Suffix("question-push-hint")">@QuestionPushHint</span>
                </TextContent>
            </Toggle>
        }
        <SelectField Form="true"
                     Label="Sync every"
                     Id="@IdOf("interval")"
                     TestId="@Suffix("interval")"
                     CurrentValue="@Options.SyncIntervalMinutes.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                     Options="@IntervalOptions"
                     OnChanged="OnIntervalChangedAsync" />
        <SelectField Form="true"
                     Label="Skip items untouched for"
                     Id="@IdOf("skip")"
                     TestId="@Suffix("skip")"
                     CurrentValue="@(Options.SkipUntouchedOlderThanDays?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty)"
                     IncludeEmptyOption="true"
                     EmptyLabel="Never skip"
                     Options="@SkipOptions"
                     OnChanged="OnSkipChangedAsync" />
        @if (OffersRepository)
        {
            <SelectField Form="true"
                         Label="Repository"
                         Id="@IdOf("repository")"
                         TestId="@Suffix("repository")"
                         CurrentValue="@(RepositoryValue ?? string.Empty)"
                         IncludeEmptyOption="true"
                         EmptyLabel="@RepositoryEmptyLabel"
                         Options="@RepositoryOptions"
                         HelpText="New tasks from this target are filed under this repository. Tasks you already filed keep theirs."
                         OnChanged="OnRepositoryChangedAsync" />
        }
    </div>

    @* A group rather than more fields in the list above: the rows are the source's
       statuses, one per status it lists, and read as one question — what each of
       them becomes here. Keyed by position, as the host listed them. *@
    @if (Options.StatusRows.Count > 0)
    {
        <fieldset class="connected-target__mapping" data-testid="@Suffix("statuses")">
            <legend class="connected-target__mapping-title">Statuses</legend>
            <p class="connected-target__mapping-help">What a task becomes while its item is in each of the source's statuses.</p>
            @for (var index = 0; index < Options.StatusRows.Count; index++)
            {
                var row = Options.StatusRows[index];
                var slot = index;
                <SelectField Form="true"
                             Label="@row.Name"
                             Id="@IdOf($"status-{slot}")"
                             TestId="@Suffix($"status-{slot}")"
                             CurrentValue="@(row.Mapped ?? string.Empty)"
                             IncludeEmptyOption="true"
                             EmptyLabel="@row.DefaultLabel"
                             Options="@Options.StatusChoices"
                             OnChanged="value => OnStatusChangedAsync(slot, value)" />
            }
        </fieldset>
    }

    @if (OnSyncNow.HasDelegate || OnRemove.HasDelegate || OffersRestore)
    {
    <div class="connected-target__actions">
        @if (OnSyncNow.HasDelegate)
        {
            <AppButton Size="ButtonSize.Small"
                       Disabled="@(!Options.Enabled)"
                       Busy="@(Syncing || _acts.IsRunning(SyncAct))"
                       aria-disabled="@(Syncing ? "true" : Blocked)"
                       BusyLabel="Syncing"
                       TestId="@Suffix("sync")"
                       OnClick="() => _acts.RunAsync(SyncAct, () => OnSyncNow.InvokeAsync(Options))">
                Sync now
            </AppButton>
        }
        @if (OffersRestore)
        {
            @* Disabled rather than blocked: a restore and a sync would write the
               same tasks at once, and the restore can wait for the sync. *@
            <AppButton Size="ButtonSize.Small"
                       Disabled="@(Syncing || _acts.IsAnyRunning)"
                       TestId="@Suffix("restore")"
                       OnClick="() => OnRestoreDeleted.InvokeAsync(Options)">
                Restore deleted tasks
            </AppButton>
        }
        @if (OnRemove.HasDelegate)
        {
            <AppButton Variant="ButtonVariant.Danger"
                       Size="ButtonSize.Small"
                       Busy="@_acts.IsRunning(RemoveAct)"
                       aria-disabled="@Blocked"
                       BusyLabel="Disconnecting"
                       TestId="@Suffix("remove")"
                       OnClick="() => _acts.RunAsync(RemoveAct, () => OnRemove.InvokeAsync(Options))">
                Disconnect
            </AppButton>
        }
    </div>
    }

    <Alert Message="@SyncMessage"
           Role="status"
           CssClass="connected-target__sync-message"
           TestId="@Suffix("sync-message")" />
</Card>

@code {
    /// <summary>The target as it is stored.</summary>
    [Parameter, EditorRequired]
    public ConnectedTargetOptions Options { get; set; } = new(string.Empty, string.Empty);

    /// <summary>Raised with the whole record on every change.</summary>
    [Parameter]
    public EventCallback<ConnectedTargetOptions> OnChange { get; set; }

    /// <summary>Raised to sync the target now. The button is left off without a
    /// listener.</summary>
    [Parameter]
    public EventCallback<ConnectedTargetOptions> OnSyncNow { get; set; }

    /// <summary>Raised to disconnect the target. The button is left off without a
    /// listener.</summary>
    [Parameter]
    public EventCallback<ConnectedTargetOptions> OnRemove { get; set; }

    /// <summary>Raised to restore the target's deleted tasks. The button is drawn
    /// only with a listener and while <see cref="ConnectedTargetOptions.DeletedTaskCount"/>
    /// is above zero; the host asks before it restores anything.</summary>
    [Parameter]
    public EventCallback<ConnectedTargetOptions> OnRestoreDeleted { get; set; }

    /// <summary>Whether a sync the host started is still running.</summary>
    [Parameter]
    public bool Syncing { get; set; }

    /// <summary>How this card's last Sync now went, in the host's words, or null
    /// for nothing to say.</summary>
    [Parameter]
    public string? SyncMessage { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    /// <summary>What the ids of the card's selects start with, so each label's
    /// <c>for</c> points at its own card's select. A page that draws several cards
    /// under one <see cref="TestId"/> passes one per card; without it the ids start
    /// with the test id.</summary>
    [Parameter]
    public string? IdPrefix { get; set; }

    /// <summary>The failure, with when it happened when the host says.</summary>
    private string? LastSyncErrorText =>
        string.IsNullOrWhiteSpace(Options.LastSyncError) ? null
        : Options.LastSyncFailed is { } when ? $"Last sync failed {when}: {Options.LastSyncError}"
        : $"Last sync failed: {Options.LastSyncError}";

    /// <summary>The line beside "Only questions assigned to me": the source's own
    /// push for a question, on a phone subscribed to it, comes on top of Backlog's.
    /// "Backlog question" is spec-manager's name for that preference: spec-manager is
    /// the one connector that asks questions, and one that joins it brings its own.</summary>
    private string QuestionPushHint =>
        $"Questions also arrive as {Options.ConnectorName}'s own push on a phone subscribed to it. " +
        $"Switch off \"Backlog question\" in {Options.ConnectorName}'s notification preferences on that phone to get only Backlog's.";

    private IntegrationProvider Mark =>
        Enum.TryParse<IntegrationProvider>(Options.Icon, ignoreCase: true, out var provider)
            ? provider
            : IntegrationProvider.None;

    private IReadOnlyList<SelectorOption> IntervalOptions =>
    [
        .. ConnectedTargetOptions.IntervalChoices
            .Append(Options.SyncIntervalMinutes)
            .Distinct()
            .Order()
            .Select(minutes => new SelectorOption(
                minutes.ToString(System.Globalization.CultureInfo.InvariantCulture),
                minutes < 60 ? $"{minutes} minutes" : minutes == 60 ? "1 hour" : $"{minutes / 60} hours"))
    ];

    private IReadOnlyList<SelectorOption> SkipOptions =>
    [
        .. ConnectedTargetOptions.SkipChoices
            .Concat(Options.SkipUntouchedOlderThanDays is { } days ? [days] : [])
            .Distinct()
            .Order()
            .Select(days => new SelectorOption(
                days.ToString(System.Globalization.CultureInfo.InvariantCulture),
                days % 365 == 0 ? (days == 365 ? "a year" : $"{days / 365} years") : $"{days} days"))
    ];

    private bool OffersRestore => OnRestoreDeleted.HasDelegate && Options.DeletedTaskCount > 0;

    /// <summary>A repository picker is drawn when there is something to pick or a
    /// stored repository to show.</summary>
    private bool OffersRepository =>
        Options.RepositoryChoices.Count > 0 || !string.IsNullOrWhiteSpace(Options.RepositoryId);

    /// <summary>The stored repository as the choice that holds it — compared
    /// without regard to case, as a repository is — or as stored when none does.</summary>
    private string? RepositoryValue =>
        string.IsNullOrWhiteSpace(Options.RepositoryId) ? null
        : Options.RepositoryChoices.FirstOrDefault(choice => string.Equals(choice.Value, Options.RepositoryId.Trim(), StringComparison.OrdinalIgnoreCase))?.Value
            ?? Options.RepositoryId.Trim();

    /// <summary>The host's repositories, plus a stored one it no longer holds, so
    /// editing another option never rewrites it.</summary>
    private IReadOnlyList<SelectorOption> RepositoryOptions =>
        RepositoryValue is { } stored && !Options.RepositoryChoices.Any(choice => string.Equals(choice.Value, stored, StringComparison.Ordinal))
            ? [.. Options.RepositoryChoices, new SelectorOption(stored, stored)]
            : Options.RepositoryChoices;

    /// <summary>What picking no repository means: a target that is a repository
    /// files under itself, any other under none.</summary>
    private string RepositoryEmptyLabel =>
        Options.TargetIsRepository ? $"Its own repository ({Options.Target})" : "None";

    private const string SyncAct = "sync";
    private const string RemoveAct = "remove";

    /// <summary>Sync now and Disconnect while the host awaits them. <see cref="Syncing"/>
    /// still says a sync is running when the host started it some other way; this
    /// covers the press itself, before the host has said anything.</summary>
    private readonly PendingAct _acts;

    public ConnectedTargetEditor() => _acts = new PendingAct(StateHasChanged);

    /// <summary>Sync now and Disconnect say they are blocked while either runs,
    /// so a press on the other does not look lost. The running one is busy as
    /// well; repeating it here keeps a null from this splat clearing the
    /// attribute AppButton set.</summary>
    private string? Blocked => _acts.IsAnyRunning ? "true" : null;

    private Task ChangeAsync(ConnectedTargetOptions changed) => OnChange.InvokeAsync(changed);

    private Task OnRepositoryChangedAsync(string? value) =>
        ChangeAsync(Options with { RepositoryId = string.IsNullOrWhiteSpace(value) ? null : value });

    /// <summary>The whole record with the one row's mapping changed; the empty
    /// choice is the default, so it maps nothing.</summary>
    private Task OnStatusChangedAsync(int slot, string? value) =>
        ChangeAsync(Options with
        {
            StatusRows =
            [
                .. Options.StatusRows.Select((row, index) =>
                    index == slot ? row with { Mapped = string.IsNullOrWhiteSpace(value) ? null : value } : row)
            ]
        });

    private Task OnIntervalChangedAsync(string? value) =>
        int.TryParse(value, out var minutes) && minutes > 0
            ? ChangeAsync(Options with { SyncIntervalMinutes = minutes })
            : Task.CompletedTask;

    private Task OnSkipChangedAsync(string? value) =>
        ChangeAsync(Options with
        {
            SkipUntouchedOlderThanDays = int.TryParse(value, out var days) && days > 0 ? days : null
        });

    private string? Suffix(string part) => TestId is null ? null : $"{TestId}-{part}";

    /// <summary>The element id of a part: <see cref="IdPrefix"/>'s, else the test
    /// id's, else none, so the select draws an id of its own.</summary>
    private string? IdOf(string part) => (IdPrefix ?? TestId) is { } prefix ? $"{prefix}-{part}" : null;
}
