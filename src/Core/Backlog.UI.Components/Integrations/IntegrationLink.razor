@*
    One linked artifact that lives outside the product: the mark, the label, its
    state, and how it disagrees with what we believe locally.

    What it renders depends on what the host can do with it, not on what it is —
    the tri-state DevbookReferenceLink already draws, copied rather than
    re-derived. Given a URL it is an anchor, given a callback it is a button,
    given neither it is inert text. The argument is the one recorded there: an
    anchor can be middle-clicked, copied and opened in a new window and a button
    cannot, and a reference nobody can follow should not invite a click or take a
    tab stop to refuse one.

    It matters more here than it did there. A pull request has a URL. A Copilot
    CLI session is a local process with nothing to address, so it arrives as a
    callback and renders as a button — and a fourth renderer invented for that
    case is precisely the drift this family exists to prevent.

    The inert shape is a span rather than DevbookReferenceLink's code element.
    A pull request number is a number, not a path: the existing `.badge--gh`
    already sets tabular-nums rather than putting it in the mono face, and this
    follows what the product already does with these.
*@

@if (!string.IsNullOrWhiteSpace(Link.Url))
{
    <a class="@ClassValue("link")"
       href="@Link.Url"
       target="_blank"
       rel="noopener"
       title="@TitleValue"
       data-testid="@TestId">@Body()</a>
}
else if (OnOpen.HasDelegate)
{
    <button type="button"
            class="@ClassValue("action")"
            title="@TitleValue"
            data-testid="@TestId"
            @onclick="() => OnOpen.InvokeAsync(Link)">@Body()</button>
}
else
{
    <span class="@ClassValue("inert")" title="@TitleValue" data-testid="@TestId">@Body()</span>
}

@code {
    [Parameter, EditorRequired]
    public IntegrationLinkRef Link { get; set; } = default!;

    /// <summary>Raised with the whole reference. Ignored while the reference has
    /// a URL: a link already navigates, and two ways to reach one place is one
    /// too many.</summary>
    [Parameter]
    public EventCallback<IntegrationLinkRef> OnOpen { get; set; }

    [Parameter]
    public IntegrationDensity Density { get; set; } = IntegrationDensity.Inline;

    /// <summary>Whether to name the repository on the reference itself. Off by
    /// default because the list groups by repository and a heading over each
    /// group says it once — this is for a reference standing on its own.</summary>
    [Parameter]
    public bool ShowRepository { get; set; }

    [Parameter]
    public bool ShowTitle { get; set; } = true;

    /// <summary>Carry the artifact's state as the link's own colour rather than as
    /// a chip beside it, for a table where the link is the one button per row and
    /// a chip would say the state a second time. The words stay — in the title and
    /// an sr-only span — so the colour is never the sole carrier.</summary>
    [Parameter]
    public bool StateAsInk { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public string? MarkTestId { get; set; }

    [Parameter]
    public string? LabelTestId { get; set; }

    [Parameter]
    public string? StateTestId { get; set; }

    [Parameter]
    public string? DriftTestId { get; set; }

    /// <summary>Addressed apart from the link, like the chips, so a test can find
    /// the checks mark rather than assert on the link's whole markup.</summary>
    [Parameter]
    public string? ChecksTestId { get; set; }

    [Parameter]
    public string? AutoMergeTestId { get; set; }

    /// <summary>
    /// The three check glyphs, in the chips' own drawing — stroked at 1.6, never
    /// filled but for a dot — at 12 px rather than 14, because these sit inside a
    /// line of text beside a number rather than in a chip of their own.
    /// <para>
    /// Three shapes as well as three inks: a tick, a cross and a dot read apart
    /// with the colour taken away, which is what lets the ink be decoration here.
    /// </para>
    /// </summary>
    private static RenderFragment ChecksIcon(IntegrationCheckState checks) =>
        @<svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor"
              stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
              aria-hidden="true" focusable="false">
            @if (checks is IntegrationCheckState.Passing)
            {
                <path d="M3.5 8.5 6.5 11.5 12.5 4.5" />
            }
            else if (checks is IntegrationCheckState.Failing)
            {
                <path d="M4.5 4.5 11.5 11.5" />
                <path d="M11.5 4.5 4.5 11.5" />
            }
            else
            {
                @* Pending: a dot in a ring — something is there and has not
                   finished, the same idea as the open state's centred dot. *@
                <circle cx="8" cy="8" r="4.75" />
                <circle cx="8" cy="8" r="1.75" fill="currentColor" stroke="none" />
            }
        </svg>;

    private bool IconOnly => IntegrationStates.IsIconOnly(Density);

    /// <summary>The artifact's own title where it has one, and the label
    /// otherwise. Kept on every shape including the inert one, because the
    /// reason a reference is unfollowable is never that it is uninteresting.</summary>
    private string TitleValue
    {
        get
        {
            var title = string.IsNullOrWhiteSpace(Link.Title) ? Link.Label : Link.Title;
            return InkedState is { } state ? $"{title} — {IntegrationStates.TitleOf(state)}" : title;
        }
    }

    /// <summary>The state the link wears as its colour, or null when it draws a
    /// chip instead.</summary>
    private IntegrationArtifactState? InkedState => StateAsInk ? Link.ArtifactState : null;

    private string ClassValue(string shape)
    {
        var stem = $"integration-link integration-link--{shape} integration-link--{IntegrationStates.SlugOf(Density)}";
        if (InkedState is { } state)
        {
            stem += $" integration-link--stateful integration-link--state-{IntegrationStates.SlugOf(state)}";
        }

        return string.IsNullOrWhiteSpace(CssClass) ? stem : $"{stem} {CssClass}";
    }

    /// <summary>
    /// One body for all three shapes, so an anchor, a button and a span are the
    /// same reference drawn three ways rather than three renderings a stylesheet
    /// has to keep in step.
    /// </summary>
    private RenderFragment Body() =>
        @<text>
            @* The mark carries a name only at Compact density, where it is the
               sole thing separating a Claude session row from a GitHub issue
               row. Everywhere else the label beside it already says which. *@
            <ProviderMark Provider="@Link.Provider"
                          Title="@(IconOnly ? IntegrationStates.NameOf(Link.Provider) : null)"
                          TestId="@MarkTestId" />

            <span class="integration-link__label" data-testid="@LabelTestId">@Link.Label</span>

            @if (InkedState is { } inked)
            {
                <span class="sr-only" data-testid="@StateTestId">@IntegrationStates.LabelOf(inked)</span>
            }

            @* Two small marks about the pull request, after the number they speak
               about and before anything else, so the label stays the first thing a
               reader scans for. Marks rather than chips: a row already carries its
               state chip, and two more pills beside a number would out-shout it.
               Each says its words twice — on its title for a pointer, and in an
               sr-only span for a screen reader, because a title is not reliably
               announced — so the ink is never the only carrier. *@
            @if (Link.Checks is not IntegrationCheckState.None)
            {
                var checksLabel = IntegrationStates.LabelOf(Link.Checks);

                <span class="integration-link__checks integration-link__checks--@IntegrationStates.SlugOf(Link.Checks)"
                      title="@checksLabel"
                      data-testid="@ChecksTestId">
                    @ChecksIcon(Link.Checks)
                    <span class="sr-only">@checksLabel</span>
                </span>
            }

            @if (Link.AutoMerge)
            {
                <span class="integration-link__auto-merge"
                      title="@IntegrationStates.AutoMergeLabel"
                      data-testid="@AutoMergeTestId">
                    @* A branch bending into a trunk with an arrow on it: the merge,
                       still to happen, going ahead on its own. *@
                    <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor"
                         stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true" focusable="false">
                        <circle cx="4.5" cy="3.5" r="1.5" />
                        <path d="M4.5 5v8" />
                        <path d="M4.5 6.5a4 4 0 0 0 4 4H13" />
                        <path d="M11 8.5 13 10.5 11 12.5" />
                    </svg>
                    <span class="sr-only">@IntegrationStates.AutoMergeLabel</span>
                </span>
            }

            @if (ShowRepository && Link.Repository is { } repository)
            {
                <span class="integration-link__repository">@repository.DisplayName</span>
            }

            @if (ShowTitle && !IconOnly && !string.IsNullOrWhiteSpace(Link.Title))
            {
                <span class="integration-link__title">@Link.Title</span>
            }

            @if ((Link.ArtifactState is not null && InkedState is null) || Link.SessionState is not null)
            {
                <IntegrationStateChip Artifact="@(InkedState is null ? Link.ArtifactState : null)"
                                      Session="@Link.SessionState"
                                      Kind="@Link.Kind"
                                      IconOnly="@IconOnly"
                                      TestId="@StateTestId" />
            }

            @* A second chip beside the first rather than a mode of it, because a
               disagreement between the artifact and what we believe is a
               different fact from the artifact's own state, and on screen two
               facts are two chips. *@
            @if (Link.Drift is not IntegrationDrift.None)
            {
                <IntegrationStateChip Drift="@Link.Drift"
                                      Kind="@Link.Kind"
                                      IconOnly="@IconOnly"
                                      Title="@Link.DriftNote"
                                      TestId="@DriftTestId" />
            }
        </text>;
}
