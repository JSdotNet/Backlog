@*
    The Requirements page of the Domain view (local ADR 0037), laid out as the
    design board "Requirements — requirements.md" draws it. The page opens on its
    title and two cards: what a requirement is, with how many the file holds and
    how many a test proves, and — dashed, because it is a way out rather than
    content — What is always true for each unit whose rules the open feature's
    requirements rest on, which opens that unit's Always true tab.

    Below them, an unsplit requirements.md lists its features By feature · tested,
    each with its proved / count and a bar; a split requirements.<name>.md holds
    one feature and opens on it with no list. Each requirement is a card: its
    title and proof mark, its SHALL sentence set larger with the word SHALL in
    the requirement tone, the tasks referencing it, then each scenario as GIVEN /
    WHEN / THEN rows on the card's sunken foot — a row that joins its clauses with
    ", and" reads as one bullet per clause. A feature with more than three
    requirements opens its first two and lists the rest as rows that open in
    place.

    Pure: the host hands over the groups DomainRequirements read.
*@

<article class="domain-requirements" data-testid="@TestId" aria-label="@AriaLabel">
    @if (Groups.Count == 0)
    {
        <EmptyState Title="No requirements"
                    Description="This file holds no requirement to show."
                    TestId="domain-requirements-empty"
                    role="status" />
    }
    else if (Active is { } active)
    {
        <header class="domain-requirements__page">
            <h2 class="domain-requirements__page-title">Requirements</h2>
            <div class="domain-requirements__summary">
                <div class="domain-requirements__card domain-requirements__card--requirement" data-testid="domain-requirements-summary">
                    <div class="domain-requirements__card-head">
                        <b>Requirement</b>
                        <span class="domain-requirements__card-meta" data-testid="domain-requirements-tally">@Tested(Total)</span>
                    </div>
                    <span class="domain-requirements__card-text">A promise to someone outside the product. One SHALL sentence, its cases as Given / When / Then, proved by a linked test.</span>
                </div>
                @foreach (var unit in active.AlwaysTrue)
                {
                    var described = $"{_id}-always-true-{unit.UnitKey}";
                    <button type="button"
                            class="domain-requirements__card domain-requirements__card--always-true"
                            data-testid="domain-requirements-always-true-link"
                            data-unit="@unit.UnitKey"
                            aria-label="@($"What is always true for {unit.Title}, on Domain")"
                            aria-describedby="@described"
                            @onclick="() => OnOpenAlwaysTrue.InvokeAsync(unit)">
                        <span class="domain-requirements__card-head">
                            <b>What is always true</b>
                            <span class="domain-requirements__card-meta" data-testid="domain-requirements-always-true-meta">@RulesMeta(unit)</span>
                        </span>
                        <span class="domain-requirements__card-text" id="@described">Not promises but what the model never lets happen, whoever changes the @(unit.Title).</span>
                    </button>
                }
            </div>
        </header>

        <div class="domain-requirements__body">
            @if (Groups.Count > 1)
            {
                <nav class="domain-requirements__features" aria-label="Requirements by feature" data-testid="domain-requirements-features">
                    <div class="domain-requirements__features-label">By feature · tested</div>
                    <ul class="domain-requirements__feature-list">
                        @foreach (var group in Groups)
                        {
                            var selected = group.Key == active.Key;
                            <li>
                                <button type="button"
                                        class="@(selected ? "domain-requirements__feature domain-requirements__feature--selected" : "domain-requirements__feature")"
                                        data-testid="domain-requirements-feature"
                                        data-key="@group.Key"
                                        aria-current="@(selected ? "true" : null)"
                                        @onclick="() => SelectAsync(group)">
                                    <span class="domain-requirements__feature-row">
                                        <span class="domain-requirements__feature-name">@group.Title</span>
                                        <span class="domain-requirements__feature-tally"><span aria-hidden="true">@group.Tally.Proved / @group.Tally.Count</span><span class="sr-only">@group.Tally.Proved of @group.Tally.Count tested</span></span>
                                    </span>
                                    <span class="domain-requirements__feature-bar" aria-hidden="true">
                                        <span class="domain-requirements__feature-fill" style="@FillStyle(group.Tally)"></span>
                                    </span>
                                </button>
                            </li>
                        }
                    </ul>
                </nav>
            }

            <section class="domain-requirements__group" data-testid="domain-requirements-group" data-key="@active.Key" aria-label="@active.Title">
                <header class="domain-requirements__header">
                    <h3 class="domain-requirements__title">@active.Title</h3>
                    @if (active.Feature is { } feature && DevbookReference.Parse(feature.Reference) is { } featureReference)
                    {
                        <span class="domain-requirements__feature-link" data-testid="domain-requirements-feature-link">
                            <DevbookReferenceLink Reference="@featureReference" Text="@($"Feature chapter · {feature.Title}")" OnNavigate="OnNavigate" />
                        </span>
                    }
                </header>
                <DomainChapterTasks References="@([active.Reference])" TestId="domain-requirements-group-tasks" />
                @if (active.Intro.Length > 0)
                {
                    <div class="domain-requirements__intro" data-testid="domain-requirements-intro">
                        <MarkdownView Blocks="@MarkdownPreview.ParseDocument(active.Intro)"
                                      Source="@active.Intro"
                                      DevbookDocumentPath="@DocumentPath"
                                      DevbookFolder="DevbookFolder.Domain"
                                      OnDevbookNavigate="OnNavigate" />
                    </div>
                }

                @{
                    var open = OpenCount(active);
                    var rows = active.Requirements.Skip(open).ToList();
                    var listed = _showAll || rows.Count <= RowsListed ? rows.Count : RowsListed;
                }
                <ol class="domain-requirements__list">
                    @foreach (var requirement in active.Requirements.Take(open))
                    {
                        <li class="domain-requirement" @key="requirement.Key" data-testid="domain-requirement" data-key="@requirement.Key" data-proved="@(requirement.Proved ? "true" : "false")">
                            @Card(requirement)
                        </li>
                    }
                </ol>
                @if (rows.Count > 0)
                {
                    <ol class="domain-requirements__rows" data-testid="domain-requirements-rows">
                        @foreach (var requirement in rows.Take(listed))
                        {
                            var shown = _shown.Contains(requirement.Key);
                            <li class="domain-requirement domain-requirement--row"
                                @key="requirement.Key"
                                data-testid="domain-requirement"
                                data-key="@requirement.Key"
                                data-proved="@(requirement.Proved ? "true" : "false")">
                                <FoldControl BaseClass="domain-requirement-fold"
                                             HeadingLevel="4"
                                             HeadingCssClass="domain-requirement-fold__heading"
                                             Expanded="@shown"
                                             ExpandedChanged="@(expanded => Toggle(requirement, expanded))"
                                             TestId="domain-requirement-toggle">
                                    <LabelContent>
                                        <span class="domain-requirement__toggle-title">@requirement.Title</span>
                                        <span class="domain-requirement__toggle-word" aria-hidden="true">@(shown ? "Hide" : "Show")</span>
                                    </LabelContent>
                                    <ChildContent>
                                        @if (shown)
                                        {
                                            @Card(requirement, titled: false)
                                        }
                                    </ChildContent>
                                </FoldControl>
                            </li>
                        }
                        @if (listed < rows.Count)
                        {
                            <li class="domain-requirements__more">
                                <button type="button"
                                        class="domain-requirements__more-button"
                                        data-testid="domain-requirements-more"
                                        @onclick="() => _showAll = true">and @(rows.Count - listed) more in @active.Title</button>
                            </li>
                        }
                    </ol>
                }
            </section>
        </div>
    }
</article>

@code {
    /// <summary>A feature with more requirements than this opens only the first
    /// <see cref="OpenFirst"/> and lists the rest as rows.</summary>
    internal const int OpenAll = 3;

    internal const int OpenFirst = 2;

    /// <summary>How many rows are listed before "and n more".</summary>
    internal const int RowsListed = 4;

    /// <summary>The groups <see cref="DomainRequirements.Groups"/> read.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<DomainRequirementGroup> Groups { get; set; } = [];

    /// <summary>The requirements file, which a relative link in a chapter's prose
    /// resolves against.</summary>
    [Parameter]
    public string? DocumentPath { get; set; }

    /// <summary>The feature picked, by its group's key. Unset, or a key the file
    /// does not hold, is the first.</summary>
    [Parameter]
    public string? ActiveGroup { get; set; }

    [Parameter]
    public EventCallback<string> ActiveGroupChanged { get; set; }

    /// <summary>A link in the prose, or the feature, the reader followed.</summary>
    [Parameter]
    public EventCallback<DevbookReference> OnNavigate { get; set; }

    /// <summary>An Always true link the reader pressed: the host opens that unit
    /// on its Always true tab.</summary>
    [Parameter]
    public EventCallback<DomainAlwaysTrueLink> OnOpenAlwaysTrue { get; set; }

    [Parameter]
    public string AriaLabel { get; set; } = "Requirements";

    [Parameter]
    public string? TestId { get; set; } = "domain-requirements";

    private readonly string _id = "domain-requirements-" + Guid.NewGuid().ToString("N");
    private string? _active;
    private string? _activeParameter;
    private string? _rowsOf;
    private readonly HashSet<string> _shown = new(StringComparer.Ordinal);
    private bool _showAll;

    protected override void OnParametersSet()
    {
        if (!string.Equals(_activeParameter, ActiveGroup, StringComparison.Ordinal))
        {
            _activeParameter = ActiveGroup;
            _active = ActiveGroup;
        }
        ResetRowsOnGroupChange();
    }

    private DomainRequirementGroup? Active =>
        Groups.FirstOrDefault(group => group.Key == _active) ?? Groups.FirstOrDefault();

    private DomainProofTally Total => new(Groups.Sum(group => group.Tally.Count), Groups.Sum(group => group.Tally.Proved));

    private async Task SelectAsync(DomainRequirementGroup group)
    {
        _active = group.Key;
        ResetRowsOnGroupChange();
        await ActiveGroupChanged.InvokeAsync(group.Key);
    }

    /// <summary>Rows opened on one feature stay that feature's: another feature
    /// opens with its own rows closed.</summary>
    private void ResetRowsOnGroupChange()
    {
        var key = Active?.Key;
        if (string.Equals(_rowsOf, key, StringComparison.Ordinal)) return;
        _rowsOf = key;
        _shown.Clear();
        _showAll = false;
    }

    private void Toggle(DomainRequirement requirement, bool expanded)
    {
        if (expanded) _shown.Add(requirement.Key);
        else _shown.Remove(requirement.Key);
    }

    private static int OpenCount(DomainRequirementGroup group) =>
        group.Requirements.Count <= OpenAll ? group.Requirements.Count : OpenFirst;

    /// <summary>How many rules the card opens on, as the board reads it.</summary>
    private static string RulesMeta(DomainAlwaysTrueLink unit) =>
        unit.Rules switch
        {
            0 => "on Domain",
            1 => "1 rule · on Domain",
            var count => $"{count} rules · on Domain"
        };

    private static string Tested(DomainProofTally tally) =>
        tally.Count == 0 ? "No requirements" : $"{tally.Count} · {tally.Proved} tested";

    private static string FillStyle(DomainProofTally tally) =>
        FormattableString.Invariant($"width: {(tally.Count == 0 ? 0 : Math.Round(100.0 * tally.Proved / tally.Count))}%");

    private static string ProofTitle(DomainRequirement requirement) =>
        requirement.Proved
            ? $"Linked to {requirement.Tests.Count} test{(requirement.Tests.Count == 1 ? string.Empty : "s")}: {string.Join(", ", requirement.Tests)}"
            : "No test is linked to this requirement yet.";

    private MarkdownRender.MarkdownInlineTarget Inline =>
        DevbookInlineTargets.For(DocumentPath, null, OnNavigate);

    /// <summary>One requirement's card. <paramref name="titled"/> false leaves the
    /// title to the row's fold heading above it, so it is not said twice.</summary>
    private RenderFragment Card(DomainRequirement requirement, bool titled = true) =>
        @<article class="domain-requirement__card">
            <div class="domain-requirement__statement">
                <header class="@(titled ? "domain-requirement__header" : "domain-requirement__header domain-requirement__header--untitled")">
                    @if (titled)
                    {
                        <h4 class="domain-requirement__title">@requirement.Title</h4>
                    }
                    <Badge Kind="tone"
                           CssClass="@(requirement.Proved ? "domain-requirement__proof" : "domain-requirement__proof domain-requirement__proof--none")"
                           TestId="domain-requirement-proof"
                           Title="@ProofTitle(requirement)">@(requirement.Proved ? "✓ Test linked" : "No test linked")</Badge>
                </header>
                @if (requirement.Shall.Length > 0)
                {
                    @if (DomainRequirements.SplitShall(requirement.Shall) is { } split)
                    {
                        <p class="domain-requirement__shall" data-testid="domain-requirement-shall">@MarkdownRender.Inlines(MarkdownPreview.ParseInlines(split.Before), Inline)<b class="domain-requirement__shall-word">SHALL</b>@MarkdownRender.Inlines(MarkdownPreview.ParseInlines(split.After), Inline)</p>
                    }
                    else
                    {
                        <div class="domain-requirement__shall" data-testid="domain-requirement-shall">
                            <MarkdownView Blocks="@MarkdownPreview.ParseDocument(requirement.Shall)" Source="@requirement.Shall" DevbookDocumentPath="@DocumentPath" DevbookFolder="DevbookFolder.Domain" OnDevbookNavigate="OnNavigate" />
                        </div>
                    }
                }
                @if (requirement.Prose.Length > 0)
                {
                    <div class="domain-requirement__prose">
                        <MarkdownView Blocks="@MarkdownPreview.ParseDocument(requirement.Prose)" Source="@requirement.Prose" DevbookDocumentPath="@DocumentPath" DevbookFolder="DevbookFolder.Domain" OnDevbookNavigate="OnNavigate" />
                    </div>
                }
                <DomainChapterTasks References="@([requirement.Reference])" Label="Referenced by" TestId="domain-requirement-tasks" />
            </div>
            @foreach (var scenario in requirement.Scenarios)
            {
                <section class="domain-scenario" data-testid="domain-scenario" aria-label="@($"Scenario: {scenario.Title}")">
                    <h5 class="domain-scenario__title"><span class="domain-scenario__word">Scenario ·</span> @scenario.Title</h5>
                    <dl class="domain-scenario__steps">
                        @foreach (var step in scenario.Steps)
                        {
                            <div class="domain-scenario__step" data-testid="domain-scenario-step" data-keyword="@step.Keyword">
                                <dt class="domain-scenario__keyword">@step.Keyword</dt>
                                <dd class="domain-scenario__clauses">
                                    @if (step.Clauses.Count == 1)
                                    {
                                        <span class="domain-scenario__clause" data-testid="domain-scenario-clause">@MarkdownRender.Inlines(MarkdownPreview.ParseInlines(step.Clauses[0]), Inline)</span>
                                    }
                                    else
                                    {
                                        <ul class="domain-scenario__bullets">
                                            @foreach (var clause in step.Clauses)
                                            {
                                                <li class="domain-scenario__clause" data-testid="domain-scenario-clause">@MarkdownRender.Inlines(MarkdownPreview.ParseInlines(clause), Inline)</li>
                                            }
                                        </ul>
                                    }
                                </dd>
                            </div>
                        }
                    </dl>
                    @if (scenario.Prose.Length > 0)
                    {
                        <div class="domain-scenario__prose">
                            <MarkdownView Blocks="@MarkdownPreview.ParseDocument(scenario.Prose)" Source="@scenario.Prose" DevbookDocumentPath="@DocumentPath" DevbookFolder="DevbookFolder.Domain" OnDevbookNavigate="OnNavigate" />
                        </div>
                    }
                </section>
            }
        </article>;
}
