@*
    The four-state dot of a scenario page or part: passed, failed, stale, never run.
    Told apart by shape as well as colour — a filled disc, a filled diamond, a ring,
    a dashed ring — so the state reads without colour, and named to a screen reader,
    since a dot alone says nothing to one (.devbook/design/accessibility.md, "Names
    & roles"). Any word but the four, a run's not-run among them, is never run.
*@
<span class="devbook-scenario-dot devbook-scenario-dot--@Slug"
      role="@(Decorative ? null : "img")"
      aria-label="@(Decorative ? null : AccessibleName)"
      aria-hidden="@(Decorative ? "true" : null)"
      title="@(Decorative ? null : Label)"
      data-testid="@TestId"
      data-state="@Slug"></span>

@code {
    /// <summary><c>passed</c>, <c>failed</c>, <c>stale</c> or <c>never-run</c>.</summary>
    [Parameter, EditorRequired]
    public string? State { get; set; }

    [Parameter]
    public string? TestId { get; set; } = "devbook-scenario-dot";

    /// <summary>Whether the dot stands beside its own word, as in a legend: then it is
    /// hidden from assistive technology, so a screen reader does not hear the state
    /// twice, and it carries no tooltip repeating the word next to it.</summary>
    [Parameter]
    public bool Decorative { get; set; }

    private string Slug => SlugOf(State);

    private string Label => Slug switch
    {
        "passed" => "Passed",
        "failed" => "Failed",
        "stale" => "Stale",
        _ => "Never run"
    };

    private string AccessibleName => $"Scenario {Label.ToLowerInvariant()}";

    /// <summary>The dot's state for a state word.</summary>
    public static string SlugOf(string? state) =>
        state?.Trim().ToLowerInvariant() switch
        {
            "passed" => "passed",
            "failed" => "failed",
            "stale" => "stale",
            _ => "never-run"
        };
}
