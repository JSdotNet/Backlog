@inject IJSRuntime Js

@*
    A list of tasks that can be reordered.

    The drag is the browser's, and everything about where a row would land is
    held here — which row is moving, which one it is over — because a row cannot
    know either on its own. The list raises one event when the move settles:
    where the row went. Reordering the data is the host's, since the host is the
    only thing that knows whether the order survives a reload.

    Reordering is also on the keyboard, and that is not decoration. A drag is a
    pointer gesture with no keyboard equivalent at all, so a list that only
    dragged would be a list some people cannot reorder. Alt+Arrow moves the
    focused row, and the focus goes with it — the row is a different element
    after the list re-renders, so it is found again by id.

    A move is also said out loud. The visible answer to "where did it go" is the
    row having moved, which is no answer at all to somebody who cannot see the
    list, so each move announces the position it landed in.

    When rows name the ids they wait on, the list works out what that comes to
    and draws it: which rows are blocked, what each of them is waiting for, which
    ones could be started, and which one of those to pick up next. In a linear
    chain the last two are the same row and only one marker appears. They come
    apart in a fan-out, where finishing one step frees several at once — and that
    is exactly when the reader needs telling, because otherwise the unlock is
    visible only by three waiting lines disappearing.

    Worked out, not written down — the Tasks it was
    handed are the Tasks the host still has, and the same answer is available to
    the host from TaskChain without rendering anything. A list where nobody
    declared a dependency derives nothing at all, so its markup is exactly what
    it was before chains existed.
*@

<ul class="@ClassValue" data-testid="@TestId" aria-label="@AriaLabel">
    @if (Tasks.Count == 0)
    {
        <li class="task-list__empty">@EmptyMessage</li>
    }

    @* Preview, not Tasks. While a drag is in flight the rows are shown in the
       order they would end up in, so the gap the row would drop into is a gap
       you can see rather than a line you have to interpret. @key is what makes
       that work: the rows move rather than being rebuilt, so the one under the
       pointer stays the one under the pointer. *@
    @foreach (var task in Open)
    {
        @RenderRow(task)
    }
</ul>

@* Where the row landed, for anyone who cannot see that it moved. Always
   rendered rather than appearing with the first move: a live region has to be in
   the DOM before it changes, or the first announcement is the one nobody
   hears. *@
<p class="sr-only" role="status" aria-live="polite" data-testid="@Suffix("announcement")">@_announcement</p>

@* Finished work goes to the bottom, behind a count you can fold away. A list
   whose done rows stay where they were becomes a list you have to read past to
   find the work — and deleting them instead would throw away the record of what
   was done. Folded by default: the reason to open this is to undo something. *@
@if (GroupCompleted && Completed.Count > 0)
{
    <div class="task-list__completed" data-testid="@CompletedTestId">
        <button type="button"
                class="task-list__completed-header"
                aria-expanded="@(_showCompleted ? "true" : "false")"
                data-testid="@Suffix("completed-toggle")"
                @onclick="() => _showCompleted = !_showCompleted">
            <span class="task-list__twisty" aria-hidden="true">@(_showCompleted ? "⌄" : "›")</span>
            <span>@CompletedLabel</span>
            <span class="task-list__completed-count">@Completed.Count</span>
        </button>

        @if (_showCompleted)
        {
            <ul class="task-list" aria-label="@($"{CompletedLabel}, {AriaLabel}")">
                @foreach (var task in Completed)
                {
                    @RenderRow(task)
                }
            </ul>
        }
    </div>
}

@code {
    private string? _dragging;
    private string? _over;
    private bool _showCompleted;

    /// <summary>What to say about the last keyboard move, if there was one.</summary>
    private string? _announcement;

    /// <summary>The row element to put the focus back on once the host has
    /// applied a keyboard move, or null when nothing is waiting for it.</summary>
    private string? _focusAfterMove;

    /// <summary>
    /// Distinguishes this list's row ids from another list's.
    /// <para>
    /// Two lists on one page can hold the same task ids — an open list and an
    /// archive of the same work is the ordinary case — and an id is unique to a
    /// document rather than to a component. Without this the two lists would mint
    /// the same ids and a move in one could put the focus in the other.
    /// </para>
    /// </summary>
    private readonly string _listId = "task-list-" + Guid.NewGuid().ToString("N");

    /// <summary>The chain as it stands, by id, and the row to pick up next.
    /// Derived once when the parameters land rather than per row per render:
    /// every row needs the same answer, and computing it in a property would
    /// walk the whole list once for each row in it.</summary>
    private IReadOnlyDictionary<string, TaskChainStatus> _statuses =
        new Dictionary<string, TaskChainStatus>(StringComparer.Ordinal);

    private string? _nextId;

    /// <summary>
    /// A view of the list, never a change to it. TaskChain reads the rows and
    /// returns statuses; nothing is written back, so the host's list is the same
    /// object it handed over.
    /// </summary>
    protected override void OnParametersSet()
    {
        var statuses = new Dictionary<string, TaskChainStatus>(StringComparer.Ordinal);
        _nextId = null;

        // Nobody declared anything, so there is nothing to derive — and a list
        // that derived anyway would start marking a "next" row in every plain
        // list in the product.
        if (!TaskChain.IsChain(Tasks))
        {
            _statuses = statuses;
            return;
        }

        // One resolve, both answers. Calling TaskChain.NextReady afterwards would
        // walk the graph and detect the cycles a second time to learn something
        // the statuses in hand already say: Resolve returns them in list order, so
        // the first Ready in this loop is the row NextReady would have returned.
        foreach (var status in TaskChain.Resolve(Tasks))
        {
            statuses.TryAdd(status.Id, status);

            if (status.Readiness is not TaskReadiness.Ready) continue;

            _nextId ??= status.Id;
        }

        _statuses = statuses;
    }

    /// <summary>One row, wherever it is being drawn. Both lists render the same
    /// thing — a done row is not a different kind of row, it is the same row
    /// having been finished.</summary>
    private RenderFragment RenderRow(TaskRow task) =>
        @<TaskItem @key="task.Id"
                   Task="task"
                   Selected="@(string.Equals(SelectedId, task.Id, StringComparison.Ordinal))"
                   OnToggle="OnToggle"
                   OnSelected="OnSelected"
                   OnRename="OnRename"
                   OnBodyChanged="OnBodyChanged"
                   Actions="@RowActions"
                   AllowCopy="@AllowCopy"
                   BodyLabel="@BodyLabel"
                   Status="@StatusOf(task)"
                   Next="@(string.Equals(_nextId, task.Id, StringComparison.Ordinal))"
                   Draggable="@(Reorderable && !task.Done)"
                   Dragging="@(string.Equals(_dragging, task.Id, StringComparison.Ordinal))"
                   OnDragStart="StartDrag"
                   OnDragOver="DragOver"
                   OnDrop="Drop"
                   OnDragEnd="EndDrag"
                   RowElementId="@RowElementId(task)"
                   OnKeyboardMove="delta => MoveByKeyboardAsync(task, delta)"
                   TestId="@RowTestId(task)" />;

    [Parameter, EditorRequired]
    public IReadOnlyList<TaskRow> Tasks { get; set; } = [];

    [Parameter]
    public string? SelectedId { get; set; }

    [Parameter]
    public EventCallback<string> OnToggle { get; set; }

    [Parameter]
    public EventCallback<string> OnSelected { get; set; }

    /// <summary>Whether rows offer to copy themselves.</summary>
    [Parameter]
    public bool AllowCopy { get; set; } = true;

    /// <summary>What a row's disclosure calls its body. Passed straight through
    /// to every row: what a body is called is the host's word for it, and one
    /// list should not have two.</summary>
    [Parameter]
    public string BodyLabel { get; set; } = "Body";

    [Parameter]
    public EventCallback<TaskRename> OnRename { get; set; }

    /// <summary>Straight through to every row, exactly like OnRename: whether a
    /// body can be edited is one answer for the whole list, and a list that
    /// decided it per row would be deciding which tasks are the reader's.
    /// Unsupplied, no row offers an editor.</summary>
    [Parameter]
    public EventCallback<TaskBodyChange> OnBodyChanged { get; set; }

    /// <summary>The host's own controls for each row, handed the task they are
    /// about. Straight through to every row for the same reason OnRename is: what a
    /// host can do to a task is one answer for the whole list, and a list that
    /// decided it per row would be deciding which tasks are actionable.</summary>
    [Parameter]
    public RenderFragment<TaskRow>? RowActions { get; set; }

    /// <summary>Whether finished rows move to a section of their own at the
    /// bottom. On by default: a list whose done rows stay in place is a list you
    /// read past to find the work.</summary>
    [Parameter]
    public bool GroupCompleted { get; set; } = true;

    [Parameter]
    public string CompletedLabel { get; set; } = "Completed";

    /// <summary>Where a row ended up: the row that moved, and the row it landed
    /// on. Applying it is the host's, because only the host knows whether the
    /// new order is saved anywhere.</summary>
    [Parameter]
    public EventCallback<TaskMove> OnReorder { get; set; }

    /// <summary>Whether rows can be picked up at all. Off for a list whose order
    /// is not the reader's to choose — one sorted by date, or a search result.</summary>
    [Parameter]
    public bool Reorderable { get; set; }

    [Parameter]
    public string AriaLabel { get; set; } = "Tasks";

    [Parameter]
    public string EmptyMessage { get; set; } = "Nothing here yet.";

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    private string ClassValue => string.Join(' ', new[]
    {
        "task-list",
        // Lets the rows that are not moving pull in while one is in flight, so
        // the list reads as having made room rather than as having a hole in it.
        _dragging is not null ? "task-list--dragging" : null,
        CssClass
    }.Where(part => !string.IsNullOrWhiteSpace(part)));

    /// <summary>
    /// The order to draw right now: the real one, or — while a row is being
    /// dragged over another — the order the drop would produce.
    /// <para>
    /// Previewing rather than drawing an insertion line is the difference
    /// between showing where a row would go and describing it. The reader is
    /// already looking at the list; moving it is the cheapest possible answer to
    /// "where would this land".
    /// </para>
    /// <para>
    /// It is a view and nothing more. Tasks is untouched, and if the drag is
    /// abandoned the preview simply stops being computed — there is no state to
    /// roll back because nothing was changed.
    /// </para>
    /// </summary>
    /// <summary>The rows in the top list: everything, or everything unfinished
    /// when the done ones have somewhere of their own to go.</summary>
    private IReadOnlyList<TaskRow> Open =>
        GroupCompleted ? [.. Preview.Where(task => !task.Done)] : Preview;

    /// <summary>The finished rows, in the order they were given. Not sorted by
    /// when they were finished, because nothing here knows that.</summary>
    private IReadOnlyList<TaskRow> Completed =>
        GroupCompleted ? [.. Tasks.Where(task => task.Done)] : [];

    private string? CompletedTestId => TestId is null ? null : $"{TestId}-completed";

    private string? Suffix(string part) => TestId is null ? null : $"{TestId}-{part}";

    private IReadOnlyList<TaskRow> Preview =>
        _dragging is { } moved && _over is { } target && !string.Equals(moved, target, StringComparison.Ordinal)
            ? new TaskMove(moved, target).ApplyTo(Tasks, task => task.Id)
            : Tasks;

    private string? RowTestId(TaskRow task) => TestId is null ? null : $"{TestId}-{task.Id}";

    /// <summary>This row's status, or null when nothing here declared a
    /// dependency. Null rather than a Ready everyone gets by default, because
    /// "ready" said about a list nobody chained is an answer to a question the
    /// reader never asked.</summary>
    private TaskChainStatus? StatusOf(TaskRow task) =>
        _statuses.TryGetValue(task.Id, out var status) ? status : null;

    private void StartDrag(string id)
    {
        _dragging = id;
        _over = id;
    }

    /// <summary>
    /// Which row the pointer is over, and so where the drop would land.
    /// <para>
    /// Dragging over the moved row itself is ignored. In the previewed order
    /// that row is already sitting where the pointer is, so honouring it would
    /// mean "put it back", the preview would snap to the real order, the row
    /// under the pointer would change, and the two would trade places for as
    /// long as the reader held still.
    /// </para>
    /// </summary>
    private void DragOver(string id)
    {
        if (_dragging is null || string.Equals(id, _dragging, StringComparison.Ordinal)) return;

        _over = id;
    }

    private void EndDrag()
    {
        _dragging = null;
        _over = null;
    }

    /// <summary>
    /// Commits what the preview was already showing. The drop reports the row
    /// the pointer was last over rather than whatever it technically landed on —
    /// the reader has been looking at the answer for as long as they held the
    /// row there, and anything else would move it somewhere they had not seen.
    /// </summary>
    private async Task Drop(string _)
    {
        var moved = _dragging;
        var target = _over;
        EndDrag();

        // Never left the row it started on: a drag the reader thought better of,
        // not a move. Raising it would put a no-op into whatever the host does
        // with these, including its undo stack.
        if (moved is null || target is null || string.Equals(moved, target, StringComparison.Ordinal)) return;

        await OnReorder.InvokeAsync(new TaskMove(moved, target));
    }

    /// <summary>This row's focusable element, named so the focus can be put back
    /// on it after a move. Derived from the task id rather than generated, because
    /// the id has to be computable here — this is the only place that knows which
    /// row was just moved.</summary>
    private string RowElementId(TaskRow task) => $"{_listId}-{Slug(task.Id)}";

    /// <summary>An id an HTML document will accept. Task ids are the host's and
    /// may hold anything; everything outside the safe set becomes a hyphen.</summary>
    private static string Slug(string id) =>
        new([.. id.Select(character =>
            char.IsLetterOrDigit(character) || character is '-' or '_' ? character : '-')]);

    /// <summary>
    /// A keyboard move: the row the reader was on, and which way they asked.
    /// <para>
    /// The neighbour comes from the order on screen rather than from Tasks, so
    /// the row swaps with the row above or below the one the reader can see. With
    /// finished rows folded into their own section those two orders differ, and
    /// using the underlying one would move a row past something invisible.
    /// </para>
    /// <para>
    /// Clamped at both ends rather than wrapped. A row at the top that jumped to
    /// the bottom on one more press would be a move nobody asked for, and the
    /// reader would have to notice it happened before they could undo it.
    /// </para>
    /// <para>
    /// The move is raised, not applied, exactly as the drag is: the host owns the
    /// order. What is held here is only where to put the focus once the host has
    /// answered.
    /// </para>
    /// </summary>
    private async Task MoveByKeyboardAsync(TaskRow task, int delta)
    {
        var order = Open;

        var from = -1;
        for (var index = 0; index < order.Count; index++)
        {
            if (!string.Equals(order[index].Id, task.Id, StringComparison.Ordinal)) continue;

            from = index;
            break;
        }

        if (from < 0) return;

        var to = from + delta;
        if (to < 0 || to >= order.Count) return;

        _announcement = $"Moved {task.Title} to {to + 1} of {order.Count}.";
        _focusAfterMove = RowElementId(task);

        await OnReorder.InvokeAsync(new TaskMove(task.Id, order[to].Id));
    }

    /// <summary>
    /// Gives a moved row its focus back.
    /// <para>
    /// After the host applies the move the row is a different element, so the
    /// focus ring is gone and the next press would move whatever slid into the old
    /// slot. Found by id because that is the only handle that survives the
    /// re-render.
    /// </para>
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusAfterMove is not { } target) return;

        _focusAfterMove = null;

        try
        {
            await Js.InvokeVoidAsync("backlogFocus", target);
        }
        catch (Exception)
        {
            // Losing the focus ring is not worth tearing down the page. Broad on
            // purpose, and the same call is guarded the same way where the desktop
            // pane moves a sub-item: the row is still there and still usable, so
            // there is no failure here worth propagating.
        }
    }
}
