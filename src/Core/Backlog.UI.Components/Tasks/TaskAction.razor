@*
    One row in a task's detail pane: add a step, put it in my day, remind me,
    give it a due date, repeat it.

    All of them are the same shape — an icon, a label, and sometimes a value and
    a way to clear it — so they are one component rather than five. A row that is
    set says what it is set to and offers an ✕; a row that is not says what it
    would do. That difference is the whole state model, and it is why "Remind me"
    and "Reminder, Monday 09:00" are the same control rather than two.
*@

<div class="@ClassValue" data-testid="@TestId" title="@(HasReason ? DisabledReason : null)">
    <button type="button"
            class="task-action__main"
            aria-pressed="@(Togglable ? (Set ? "true" : "false") : null)"
            aria-expanded="@(Expanded is { } expanded ? (expanded ? "true" : "false") : null)"
            aria-controls="@Controls"
            aria-label="@(Compact ? Label : null)"
            data-testid="@Suffix("set")"
            disabled="@Disabled"
            aria-describedby="@(HasReason ? _reasonId : null)"
            @onclick="() => OnSet.InvokeAsync()">
        <span class="task-action__icon" aria-hidden="true">@Icon</span>
        @if (!Compact)
        {
            <span class="task-action__label">
                @Label
                @if (Set && !string.IsNullOrWhiteSpace(Value))
                {
                    <span class="task-action__value">@Value</span>
                }
            </span>
        }
    </button>

    @if (HasReason)
    {
        @* The same sentence again, for the reader who never hovers anything. It
           takes no line on screen — the `title` above is what the pointer gets —
           and it exists because a title is not reliably announced and a
           described-by is not visible, so neither route reaches everybody alone. *@
        <span id="@_reasonId" class="sr-only" data-testid="@Suffix("reason")">@DisabledReason</span>
    }

    @if (Set && OnClear.HasDelegate)
    {
        <button type="button"
                class="task-action__clear"
                aria-label="@($"Clear {Label}")"
                data-testid="@Suffix("clear")"
                @onclick="() => OnClear.InvokeAsync()"
                @onclick:stopPropagation="true">
            <span aria-hidden="true">✕</span>
        </button>
    }
</div>

@code {
    /// <summary>The glyph. Text rather than an icon set, because this library
    /// ships no icon font and a component that needed one would need it
    /// everywhere.</summary>
    [Parameter, EditorRequired]
    public string Icon { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    /// <summary>What it is set to, when it is set — "Monday, 09:00", "Weekly".
    /// Already formatted: what tomorrow is called, and in what language, belongs
    /// to the host.</summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>Whether the thing is set. Drives both what the row says and
    /// whether it offers to clear it.</summary>
    [Parameter]
    public bool Set { get; set; }

    /// <summary>Whether being set is a state the row itself is in, rather than
    /// something it opens a picker for. My Day is a toggle; a due date is not.
    /// <para>
    /// A toggle and not a disclosure, and the distinction is the whole of why
    /// <see cref="Expanded"/> exists beside this. <c>aria-pressed</c> says "this
    /// thing is on"; a row that reveals other controls is not on, it is open, and
    /// telling a screen reader the wrong one of those is worse than telling it
    /// neither.
    /// </para></summary>
    [Parameter]
    public bool Togglable { get; set; }

    /// <summary>
    /// Whether this row currently has something open below or beside it.
    /// <para>
    /// The disclosure counterpart of <see cref="Togglable"/>: it emits
    /// <c>aria-expanded</c>, which is what a control that reveals other controls
    /// owes a reader who cannot see them appear. Nullable because absent is a
    /// third answer and the common one — most rows reveal nothing, and an
    /// <c>aria-expanded="false"</c> on a row that never opens anything promises a
    /// disclosure that is not there.
    /// </para>
    /// <para>
    /// Independent of <see cref="Set"/> on purpose, although a host will often
    /// drive both from the same flag: <see cref="Set"/> is what the row draws --
    /// the forward colour that lets a pane be read down its left edge — and this
    /// is what it announces. A host that wants only one of the two says only one.
    /// </para>
    /// <para>
    /// Pair it with <see cref="Controls"/>. An <c>aria-expanded</c> with nothing
    /// naming what expanded leaves the reader to find it.
    /// </para>
    /// </summary>
    [Parameter]
    public bool? Expanded { get; set; }

    /// <summary>The <c>id</c> of the thing <see cref="Expanded"/> is about, for
    /// <c>aria-controls</c>. The host's, because only the host knows which element
    /// its picker ended up in.</summary>
    [Parameter]
    public string? Controls { get; set; }

    /// <summary>The row that matters more than the rows around it.
    /// <para>
    /// A pane of rows that all look alike is a pane read left to right, and one of
    /// these is not like the others: "put this in today" is a decision the reader
    /// makes every morning, where a due date is a fact about the task that was
    /// settled once. Prominence is how the pane says which is which — a border and
    /// the brand colour, rather than a bigger label, because the label is the same
    /// length as its neighbours and stretching it would only push the rows apart.
    /// </para>
    /// <para>
    /// One row at a time. Two prominent rows is a pane with no emphasis in it and
    /// a shape nobody can scan, so this is a decision the host makes once and not a
    /// dial to turn up on everything.
    /// </para></summary>
    [Parameter]
    public bool Prominent { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Icon-only, for an act that shares a row with another rather than
    /// owning one of its own.
    /// <para>
    /// The label does not vanish, it moves: this button carries no visible text
    /// while compact, so <see cref="Label"/> becomes its <c>aria-label</c> instead
    /// — an icon alone says nothing to a screen reader, the same reasoning
    /// <c>IconButton</c>'s header comment gives for the same trade. A sighted
    /// reader still has the icon and whatever it sits beside for context; a
    /// screen reader gets the word directly, because there is no line of text
    /// next to the icon to fall back on here.
    /// </para>
    /// <para>
    /// <see cref="Value"/> is dropped rather than shrunk to fit: there is no room
    /// beside an icon for a second line, and the row this shape exists for is
    /// one-shot — it has nothing to read back once it has run. A compact action
    /// that also sets <see cref="Value"/> is asking for both a tight control and
    /// a line under it, which is the row this parameter exists to avoid, so
    /// <see cref="Value"/> is ignored while <see cref="Compact"/> is true rather
    /// than honoured alongside it.
    /// </para>
    /// <para>
    /// <see cref="Disabled"/> and <see cref="DisabledReason"/> are unchanged: a
    /// compact action can still refuse, and it still owes the reason through both
    /// routes — the wrapper's <c>title</c> and the button's <c>aria-describedby</c>.
    /// The button then carries both an <c>aria-label</c> naming the act and an
    /// <c>aria-describedby</c> naming why it will not run. That is not a clash —
    /// a name and a reason are two different questions — so both stay.
    /// </para></summary>
    [Parameter]
    public bool Compact { get; set; }

    /// <summary>Why the row cannot be pressed, in words fit to read.
    /// <para>
    /// A disabled row keeps its slot rather than disappearing — a reader who never
    /// sees an act concludes the product cannot do it and files that as a missing
    /// feature — and a slot that keeps its place owes the reader the reason it is
    /// refusing. Greying a label out says only that something is wrong, which is
    /// the state each host used to explain in its own way, or not at all.
    /// </para>
    /// <para>
    /// Two routes for one sentence, because neither reaches everybody. The
    /// pointer's route is a <c>title</c> on the wrapper rather than on the button:
    /// a disabled button raises no pointer events of its own in most engines, so a
    /// tooltip hung on it is a tooltip nobody can open. The other is
    /// <c>aria-describedby</c> from the button to a screen-reader-only copy, since
    /// a title is not announced reliably and a described-by is invisible. This is
    /// the same pairing <c>IntegrationAction</c> makes for an unavailable act, and
    /// it is one pattern rather than two on purpose.
    /// </para>
    /// <para>
    /// Only read while <see cref="Disabled"/> is true. A reason on a row that works
    /// would be an excuse for refusing something it goes ahead and does, so a host
    /// may leave a standing reason bound and let the flag decide.
    /// </para></summary>
    [Parameter]
    public string? DisabledReason { get; set; }

    [Parameter]
    public EventCallback OnSet { get; set; }

    /// <summary>Without this, a set row has no ✕ — which is right for a row that
    /// toggles, since pressing it again is how it comes off.</summary>
    [Parameter]
    public EventCallback OnClear { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    private string ClassValue => string.Join(' ', new[]
    {
        "task-action",
        Set ? "task-action--set" : null,
        Prominent ? "task-action--prominent" : null,
        Compact ? "task-action--compact" : null,
        CssClass
    }.Where(part => !string.IsNullOrWhiteSpace(part)));

    /// <summary>Unique per instance rather than derived from the label: two panes
    /// on one page may legitimately hold the same row, and two elements with one id
    /// would send aria-describedby to whichever the browser saw first.</summary>
    private readonly string _reasonId = $"task-action-reason-{Guid.NewGuid():N}";

    private bool HasReason => Disabled && !string.IsNullOrWhiteSpace(DisabledReason);

    private string? Suffix(string part) => TestId is null ? null : $"{TestId}-{part}";
}
