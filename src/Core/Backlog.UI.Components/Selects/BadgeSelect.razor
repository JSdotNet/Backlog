@*
    A `<select>` that wears the badge of whatever it currently holds — status by
    default. BadgeKind drives both the badge class and the per-value modifier, so
    the same component can dress a priority, an area or anything else that has a
    slug.

    The badge is always the application's own: `badge badge--{BadgeKind}` plus the
    modifier for the value. A caller that needs a different modifier than the one
    the value spells hands in `Slug`, exactly as it would to Badge — the same
    value drawn read-only and drawn editable is the same value, and a reader
    should never be told by colour or by shape that a status they can change is a
    different kind of thing from one they cannot.

    The structural classes stay ours either way, because the stylesheet reaches
    the control and the wrapper through them.
*@

<label class="@WrapperClass" data-testid="@TestId">
    <span class="sr-only">@Label</span>
    <select id="@Id"
            class="@SelectClass"
            value="@CurrentValue"
            aria-label="@Label"
            title="@Label"
            disabled="@Disabled"
            @onchange="OnChange">
        @if (IncludeEmptyOption)
        {
            <option value="">@EmptyLabel</option>
        }
        @foreach (var option in Options)
        {
            <option value="@option.Value">@option.Label</option>
        }
    </select>
</label>

@code {
    [Parameter]
    public string CurrentValue { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<SelectorOption> Options { get; set; } = [];

    [Parameter]
    public string Label { get; set; } = "Change status";

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string BadgeKind { get; set; } = "status";

    /// <summary>The badge modifier to wear, in place of the one
    /// <see cref="CurrentValue"/> spells. Means what it means on
    /// <c>Badge</c>: given, the badge is <c>badge--{BadgeKind}-{Slug}</c>; given
    /// empty, the modifier is left off and the badge is the plain
    /// <c>badge badge--{BadgeKind}</c>.
    ///
    /// <para>For a caller whose vocabulary is not the badge's. A knowledge
    /// folder names its lifecycle in its own words, so <c>adopted</c> has to be
    /// told which of the application's states it is; left to spell its own
    /// modifier it would ask for <c>badge--status-adopted</c>, which no rule
    /// defines, and land on plain grey next to a pill that had been told.</para>
    ///
    /// <para>Null is not the same as empty. Null is "not specified", and the
    /// modifier is derived from the value as usual; empty is a caller saying
    /// there is no modifier to wear.</para></summary>
    [Parameter]
    public string? Slug { get; set; }

    /// <summary>
    /// An entry at the top of the list holding no value, the way
    /// <c>SelectField</c> offers one.
    /// <para>
    /// For the caller whose subject has no single current value — a bulk edit over
    /// twenty rows, where the honest answer to "what is the status" is that there
    /// are twenty of them. Without it the select opens on whichever option sorts
    /// first and the badge claims a value nothing is set to, and the reader has to
    /// change it to something else and back to make the control fire at all.
    /// </para>
    /// <para>
    /// Not the same as an option meaning "none". Nothing here writes an empty
    /// value; the caller decides what an empty <c>OnChanged</c> means, and the two
    /// callers so far both mean "the reader has not said".
    /// </para>
    /// </summary>
    [Parameter]
    public bool IncludeEmptyOption { get; set; }

    /// <summary>What the empty entry reads as. The field's name in practice —
    /// "Status" — because in that shape the empty option is the only thing on
    /// screen naming what is about to be set.</summary>
    [Parameter]
    public string EmptyLabel { get; set; } = "None";

    [Parameter]
    public string FallbackSlug { get; set; } = "draft";

    [Parameter]
    public EventCallback<string> OnChanged { get; set; }

    private string? EffectiveSlug => Slug ?? BadgeSlug.Of(CurrentValue, FallbackSlug);

    /// <summary>
    /// The badge classes: the kind always, the value's modifier when there is a
    /// value, and <c>badge--unset</c> when there is not.
    /// <para>
    /// That last one is not decoration. A badge's default fill is
    /// <c>--color-background-raised</c>, which is also the fill of the raised
    /// surfaces an editable badge sits on, so a badge with no modifier came out the
    /// same colour as the strip behind it — correct markup, invisible control. The
    /// only caller that can be in that state is one that asked for
    /// <see cref="IncludeEmptyOption"/> and has no single value to show, and a
    /// control it cannot see is worse for that caller than for anybody.
    /// </para>
    /// <para>
    /// Emitted from the absence of a slug rather than from
    /// <see cref="IncludeEmptyOption"/>, because the absence is the fact: a caller
    /// who hands in an empty <see cref="Slug"/> has said there is no modifier to
    /// wear, whatever its reason.
    /// </para>
    /// </summary>
    private string Appearance
    {
        get
        {
            var slug = string.IsNullOrWhiteSpace(EffectiveSlug)
                ? " badge--unset"
                : $" badge--{BadgeKind}-{EffectiveSlug}";

            return $"badge badge--{BadgeKind}{slug}";
        }
    }

    private string WrapperClass => $"{BadgeKind}-editor {Appearance}";

    private string SelectClass => $"{BadgeKind}-editor__select";

    private Task OnChange(ChangeEventArgs e) => OnChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);
}
