@*
    A repository picker, over whatever aliases the caller hands it. Which
    repositories exist is a workspace question and not this component's business,
    so it takes options rather than reading a registry.
*@

<SelectField CurrentValue="@CurrentValue"
             Options="@Options"
             Label="@Label"
             TestId="@TestId"
             Disabled="@Disabled"
             IncludeEmptyOption="@IncludeEmptyOption"
             EmptyLabel="@EmptyLabel"
             CssClass="metadata-editor--repo badge badge--area"
             OnChanged="OnChanged" />

@code {
    [Parameter]
    public string? CurrentValue { get; set; }

    [Parameter]
    public IReadOnlyList<SelectorOption> Options { get; set; } = [];

    [Parameter]
    public string Label { get; set; } = "Change repository";

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool IncludeEmptyOption { get; set; } = true;

    [Parameter]
    public string EmptyLabel { get; set; } = "No repo";

    [Parameter]
    public EventCallback<string?> OnChanged { get; set; }
}
