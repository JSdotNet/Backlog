@*
    A menu is one tab stop: arrows walk it, Enter and Space activate, and only
    the item under the cursor is tabbable. Disabled items and separators are
    skipped by the arrows rather than focused and refused.

    FocusFirstItem is for a host that opens the menu from the keyboard or a
    pointer and wants the next key to land in it (WAI-ARIA menu pattern): the
    first item that can be activated takes the focus once the menu is drawn.

    Enter and Space activate through the button's own click and nothing else.
    A keydown handler that selected as well would run a second time on the
    click the browser raises for that same key, and a server-bound
    `@onkeydown:preventDefault` cannot stop it: it is rendered after the
    handler, so it is false for the first key the menu sees and, after an
    arrow, swallows the Enter that follows. The keys the menu does take for
    itself (the arrows, Home, End) have their default refused in
    components.js, at the keydown, by the item's class.
*@

<ul class="@ClassValue" role="menu" aria-label="@AriaLabel" data-testid="@TestId" @attributes="AdditionalAttributes">
    @for (var i = 0; i < Items.Count; i++)
    {
        var index = i;
        var item = Items[index];

        if (item.Separator)
        {
            <li class="menu-list__separator" role="separator"></li>
            continue;
        }

        <li class="menu-list__row" role="none">
            <button type="button"
                    class="@ItemClass(item)"
                    role="menuitem"
                    @ref="_itemElements[index]"
                    data-testid="@($"{TestId}-{item.Id}")"
                    disabled="@item.Disabled"
                    tabindex="@(index == ActiveIndex ? 0 : -1)"
                    @onclick="() => SelectAsync(item)"
                    @onfocus="() => _activeIndex = index"
                    @onkeydown="e => OnKeyDown(e, index)">
                @if (!string.IsNullOrWhiteSpace(item.Icon))
                {
                    <span class="menu-list__icon" aria-hidden="true">@item.Icon</span>
                }
                <span class="menu-list__label">@item.Label</span>
            </button>
        </li>
    }
</ul>

@code {
    private readonly Dictionary<int, ElementReference> _itemElements = [];
    private int _activeIndex = -1;
    private bool _focusPending;
    private bool _focusRequested;

    [Parameter]
    public IReadOnlyList<MenuItem> Items { get; set; } = [];

    [Parameter]
    public EventCallback<MenuItem> OnItemSelected { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>Moves the focus to the first enabled item once the menu is
    /// drawn, and again each time this turns from false to true.</summary>
    [Parameter]
    public bool FocusFirstItem { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ClassValue => string.IsNullOrWhiteSpace(CssClass) ? "menu-list" : $"menu-list {CssClass}";

    private int ActiveIndex => _activeIndex >= 0 ? _activeIndex : FirstEnabled;

    private int FirstEnabled
    {
        get
        {
            for (var i = 0; i < Items.Count; i++)
            {
                if (!Items[i].Separator && !Items[i].Disabled) return i;
            }

            return -1;
        }
    }

    protected override void OnParametersSet()
    {
        if (FocusFirstItem && !_focusRequested) _focusPending = true;
        _focusRequested = FocusFirstItem;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending) return;

        _focusPending = false;

        var first = FirstEnabled;
        if (first < 0 || !_itemElements.TryGetValue(first, out var element)) return;

        try
        {
            await element.FocusAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private string ItemClass(MenuItem item) => item.Destructive
        ? "menu-list__item menu-list__item--destructive"
        : "menu-list__item";

    private Task SelectAsync(MenuItem item) =>
        item.Disabled || item.Separator ? Task.CompletedTask : OnItemSelected.InvokeAsync(item);

    private void OnKeyDown(KeyboardEventArgs e, int index)
    {
        var target = e.Key switch
        {
            "ArrowDown" => Step(index, 1),
            "ArrowUp" => Step(index, -1),
            "Home" => Step(-1, 1),
            "End" => Step(Items.Count, -1),
            _ => -1
        };

        if (target >= 0) _activeIndex = target;
    }

    private int Step(int from, int direction)
    {
        if (Items.Count == 0) return -1;

        for (var offset = 1; offset <= Items.Count; offset++)
        {
            var candidate = ((from + (direction * offset)) % Items.Count + Items.Count) % Items.Count;
            if (!Items[candidate].Separator && !Items[candidate].Disabled) return candidate;
        }

        return -1;
    }
}
