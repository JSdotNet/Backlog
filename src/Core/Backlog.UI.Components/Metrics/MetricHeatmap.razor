@*
    Repositories down, periods across, shade for the score. The chart that scales
    when a trellis stops fitting: twenty repositories over twenty-six weeks is five
    hundred readings, which is five hundred cells here and twenty unreadably narrow
    panels there.

    A heatmap is also the one chart type this palette is *built* for. Every other
    way of comparing series wants a categorical scale — one colour per repository —
    and there is exactly one saturated hue to spend. A heatmap wants a sequential
    scale instead, which is precisely what an ordinal ramp of one hue is.

    Zero gets the track rather than the palest step. "Nothing happened that week" and
    "a little happened that week" are different facts, and if the palest shade means
    both then the chart cannot say either.

    The grid is a real table with real row and column headers, so it is navigable
    rather than being a picture of a table. Each cell carries its figure as text in
    the title and in a visually-hidden span, because a shade is not a number: the
    ramp has four steps and the data has hundreds of values, so the colour is a
    bucket and the text is the reading.
*@

<div class="@ClassValue" data-testid="@TestId" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <p class="@(Part("label"))" id="@LabelId">@Label</p>
    }

    @if (Buckets.Count == 0 || Rows.Count == 0)
    {
        <MetricStatus Kind="MetricStatusKind.Empty" Message="@EmptyMessage" CssClass="@(Part("status"))" />
    }
    else
    {
        <div class="@(Part("scroll"))">
            <table class="@(Part("grid"))"
                   aria-labelledby="@(string.IsNullOrWhiteSpace(Label) ? null : LabelId)"
                   aria-label="@(string.IsNullOrWhiteSpace(Label) ? AriaLabel : null)">
                <thead>
                    <tr>
                        <td class="@(Part("corner"))"></td>
                        @foreach (var bucket in Buckets)
                        {
                            <th scope="col" class="@(Part("bucket"))">@bucket</th>
                        }
                        @* Upright, unlike the bucket headings beside them. They name
                           columns of figures rather than columns of marks, and a heading
                           turned on its side over readable numbers would be the one thing
                           in the row a reader had to tilt their head for. *@
                        @foreach (var total in Totals)
                        {
                            <th scope="col" class="@(Part("total-heading"))">@total.Heading</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Rows)
                    {
                        <tr>
                            <th scope="row" class="@(Part("name"))">@row.Name</th>
                            @foreach (var bucket in Buckets)
                            {
                                var reading = Reading(row, bucket);
                                <td class="@CellClass(row, bucket, reading)" title="@Title(row, bucket, reading)">
                                    @* The shade is a bucket of four; this is the
                                       reading. A screen reader gets the figure, and a
                                       pointer gets it from the title. *@
                                    <span class="sr-only">@CellText(row, bucket, reading)</span>
                                    @if (ShowValues && reading is { } shown && shown != 0m)
                                    {
                                        @* aria-hidden because the sr-only span above
                                           already carries this figure and the detail with
                                           it. Without that, a reader hears the number
                                           twice and the second time without its
                                           context. *@
                                        <span class="@(Part("value"))" aria-hidden="true">@Format(shown)</span>
                                    }
                                </td>
                            }
                            @foreach (var total in Totals)
                            {
                                <td class="@(Part("total"))">@total.Of(row.Name)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (ShowLegend)
        {
            <ul class="@(Part("legend"))" aria-label="@($"Shade scale, 0 to {Format(Max)}")">
                <li class="@(Part("legend-item"))">
                    <span class="@($"{Part("swatch")} {Part("swatch")}--0")" aria-hidden="true"></span>
                    <span>none</span>
                </li>
                @for (var step = 1; step <= RampSteps; step++)
                {
                    var index = step;
                    <li class="@(Part("legend-item"))">
                        <span class="@($"{Part("swatch")} {Part("swatch")}--{index}")" aria-hidden="true"></span>
                        <span>@Format(Ceiling(index - 1)) – @Format(Ceiling(index))</span>
                    </li>
                }
            </ul>
        }
    }
</div>

@code {
    /// <summary>One row per series. Every series is read against the same bucket
    /// labels, taken from whichever series has the most of them, so a series missing
    /// a week leaves a gap rather than shifting its row left.</summary>
    [Parameter]
    public IReadOnlyList<MetricSeries> Series { get; set; } = [];

    [Parameter]
    public string? Label { get; set; }

    /// <summary>Names the grid when there is no visible label.</summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>How a cell's figure reads in its title and to a screen reader.</summary>
    [Parameter]
    public Func<decimal, string>? FormatValue { get; set; }

    /// <summary>
    /// A second sentence for one cell, keyed the way the grid already matches cells:
    /// the row's name and the column's label.
    /// <para>
    /// It goes to the title <em>and</em> to the visually-hidden text, on the same
    /// reasoning the figure itself does — the shade is a bucket of four and the text is
    /// the reading, so a caller with more to say about a cell than one number must be
    /// able to say it to a screen reader too, not only to a pointer.
    /// </para>
    /// <para>
    /// Two strings rather than the <see cref="MetricSeries"/> and the point: the caller
    /// already knows what it put in the grid, and handing it this component's own model
    /// back would make its lambda depend on how rows are stored here.
    /// </para>
    /// </summary>
    [Parameter]
    public Func<string, string, string?>? CellDetail { get; set; }

    /// <summary>
    /// Prints each cell's figure inside the cell as well as shading it.
    /// <para>
    /// Off by default, and that default is the honest one for what this component was
    /// built for: a ramp of four steps against hundreds of distinct readings, where the
    /// numbers would be unreadable at the size a cell has to be to fit twenty-six of them
    /// across. Turn it on for the grid that is the exception — few columns, or readings
    /// that are small whole numbers — where the shade answers "which cells" and the digit
    /// answers "how many" without a pointer.
    /// </para>
    /// <para>
    /// Neither a zero nor a cell with no reading prints anything, for two different
    /// reasons that land on the same answer. A missing cell has no figure to print — not
    /// reported is not none, which <c>--missing</c> already draws. A zero has one, and it
    /// is the track's job: this component's whole position on zero is that it is drawn
    /// rather than shaded, and a grid where most hours are quiet would otherwise print a
    /// hundred noughts over the dozen figures somebody turned this on to read.
    /// </para>
    /// <para>
    /// Both still reach a screen reader, and both are still in the title. What is
    /// suppressed is ink, not information.
    /// </para>
    /// </summary>
    [Parameter]
    public bool ShowValues { get; set; }

    /// <summary>
    /// Columns of per-row figures, drawn after the cells in the order given.
    /// <para>
    /// A list rather than one column, because the figures a row deserves are rarely one:
    /// a day of a working week has a count, the part of it inside working hours and the
    /// part outside, and those are three answers to three questions rather than one
    /// answer with two footnotes. Each is <see cref="MetricTotal"/>'s to compute — see
    /// there for why the grid never works one out itself.
    /// </para>
    /// </summary>
    [Parameter]
    public IReadOnlyList<MetricTotal> RowTotals { get; set; } = [];

    /// <summary>
    /// Marks a cell as belonging to some category the shade does not express — the hours
    /// of a working day, a release window, a period under maintenance.
    /// <para>
    /// A second channel, and deliberately not a second ramp. The shade answers "how much"
    /// on an ordinal scale of one hue; this answers "in or out" and nothing else, so it is
    /// drawn as an edge rather than a fill and cannot be mistaken for a reading. Two
    /// quantities in one cell would need two ramps, which
    /// <c>.design/color-scheme.md</c> does not have and this component would not be the
    /// place to invent.
    /// </para>
    /// <para>
    /// Requires <see cref="MarkedLabel"/> to draw. That pairing is the point: a mark a
    /// sighted reader can see and a screen reader cannot is a distinction the grid makes
    /// and then refuses to say, so the label travels into the cell's text and the mark
    /// does not appear without one.
    /// </para>
    /// </summary>
    [Parameter]
    public Func<string, string, bool>? CellMarked { get; set; }

    /// <summary>What a marked cell is, in the cell's own text. Required for
    /// <see cref="CellMarked"/> to draw.</summary>
    [Parameter]
    public string? MarkedLabel { get; set; }

    /// <summary>The value that earns the darkest step. Left null it is the largest
    /// reading present; set it to a fixed ceiling — 100 for a score — so the shades
    /// mean the same thing from one window to the next.</summary>
    [Parameter]
    public decimal? SharedMax { get; set; }

    [Parameter]
    public bool ShowLegend { get; set; } = true;

    [Parameter]
    public string? EmptyMessage { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>Replaces <c>metric-heatmap</c> as the class this block carries, and
    /// every child class with it.</summary>
    [Parameter]
    public string BaseClass { get; set; } = "metric-heatmap";

    [Parameter]
    public string? TestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>How many shades the ramp has. Four, because that is how many steps of
    /// one hue stay apart on this surface.</summary>
    private const int RampSteps = 4;

    /// <summary>An em dash in the hidden text: this cell was not reported. A zero
    /// would be a claim that nothing happened.</summary>
    private const string NotReported = "not reported";

    private readonly string _labelId = "metric-heatmap-label-" + Guid.NewGuid().ToString("N");

    private string LabelId => _labelId;

    private IReadOnlyList<MetricSeries> Rows =>
        [.. (Series ?? []).Where(series => series.Points.Count > 0)];

    /// <summary>The column headings. Taken from the longest series rather than the
    /// first, so one short row does not truncate the whole grid.</summary>
    private IReadOnlyList<string> Buckets
    {
        get
        {
            var longest = Rows.OrderByDescending(series => series.Points.Count).FirstOrDefault();

            return longest is null ? [] : [.. longest.Points.Select(point => point.Label)];
        }
    }

    /// <summary>The columns worth drawing. A column with nothing to call it is dropped
    /// rather than drawn blank: a heading is what makes a figure answerable.</summary>
    private IReadOnlyList<MetricTotal> Totals =>
        [.. (RowTotals ?? []).Where(total => !string.IsNullOrWhiteSpace(total.Heading))];

    /// <summary>Both halves or neither, for the reason above and one more: an unnamed mark
    /// is a distinction only some readers can perceive.</summary>
    private bool HasMarks => CellMarked is not null && !string.IsNullOrWhiteSpace(MarkedLabel);

    private bool Marked(string row, string bucket) => HasMarks && CellMarked!(row, bucket);

    private decimal Max => SharedMax ?? MetricScoring.SharedMax(Rows);

    private static decimal? Reading(MetricSeries series, string bucket) =>
        series.Points.FirstOrDefault(point => point.Label == bucket)?.Value;

    private string CellClass(MetricSeries row, string bucket, decimal? reading)
    {
        var mark = Marked(row.Name, bucket) ? $" {Part("cell")}--marked" : string.Empty;

        if (reading is null) return $"{Part("cell")} {Part("cell")}--missing{mark}";

        var step = MetricScoring.RampStep(reading.Value, Max, RampSteps);

        return $"{Part("cell")} {Part("cell")}--{step}{mark}";
    }

    private string Title(MetricSeries row, string bucket, decimal? reading) =>
        $"{row.Name}, {bucket}: {(reading is null ? NotReported : Format(reading.Value))}"
        + (Detail(row.Name, bucket) is { } detail ? $" — {detail}" : string.Empty)
        + (Marked(row.Name, bucket) ? $" ({MarkedLabel})" : string.Empty);

    /// <summary>The hidden text: the reading, whatever else the caller has to say about
    /// this cell, and the mark if it carries one. A pointer gets the same from the title.
    /// <para>
    /// The mark is in here rather than only in the class, because an edge somebody cannot
    /// see is a distinction this grid draws and then withholds.
    /// </para>
    /// </summary>
    private string CellText(MetricSeries row, string bucket, decimal? reading) =>
        (reading is null ? NotReported : Format(reading.Value))
        + (Detail(row.Name, bucket) is { } detail ? $". {detail}" : string.Empty)
        + (Marked(row.Name, bucket) ? $". {MarkedLabel}" : string.Empty);

    /// <summary>Blank is the same as absent. A caller building a sentence from data it
    /// may not have should not have to decide whether an empty one is worth appending an
    /// em dash to.</summary>
    private string? Detail(string row, string bucket)
    {
        var text = CellDetail?.Invoke(row, bucket);

        return string.IsNullOrWhiteSpace(text) ? null : text;
    }

    /// <summary>The top of ramp step <paramref name="step"/>, for the legend.</summary>
    private decimal Ceiling(int step) => Math.Round(Max / RampSteps * step, 1, MidpointRounding.AwayFromZero);

    private string Format(decimal value) => (FormatValue ?? MetricFormat.Compact)(value);

    private string Part(string name) => $"{BaseClass}__{name}";

    private string ClassValue =>
        string.IsNullOrWhiteSpace(CssClass) ? BaseClass : $"{BaseClass} {CssClass}";
}
