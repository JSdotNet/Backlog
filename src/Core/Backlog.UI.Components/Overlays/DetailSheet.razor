@implements IAsyncDisposable
@inject IJSRuntime Js

@*
    A panel that slides in beside a surface to say more about the thing just
    picked on it.

    Not a Modal. Modal renders nothing while closed, which is right for a dialog
    that should leave nothing behind and wrong for a sheet that has to animate
    out — a thing removed from the tree cannot transition. So this one is always
    in the tree and `inert` while closed, which keeps its contents out of the tab
    order and off the accessibility tree just as firmly as not rendering them.

    It traps focus: Tab inside a sheet cycles rather than walking out into the
    surface behind it. Modal keeps Tab inside itself too, and both go through
    components.js for it — but a sheet that is always in the tree can take the
    containment and the giving-back as one `backlogFocusTrap`, where a dialog
    that removes itself has to ask for the two halves separately. Giving the
    focus back is the half neither can skip: a reader sent into a sheet by
    pressing Enter on a row has to land back on that row when they leave, or the
    list they were working has lost their place.

    The header is fixed and the body scrolls, because the title of the thing you
    are reading about should not scroll away from the thing you are reading.
*@

<div class="@BackdropClassValue"
     data-testid="@BackdropTestId"
     data-open="@(Open ? "true" : "false")"
     aria-hidden="true"
     @onclick="BackdropClickedAsync"></div>

@* While open, a key pressed in the sheet is the sheet's, as it is a Modal's: its
   host is often an ancestor with a keydown handler of its own — the Devbook's
   surface closes on Escape — and one Escape must not close the sheet and then the
   surface behind it. Bound to Open as drawn before the key, the state the key acted
   on; Blazor's stopPropagation ends only its own walk, so a document listener still
   hears the key. *@
<aside id="@_id"
       class="@ClassValue"
       data-testid="@TestId"
       data-open="@(Open ? "true" : "false")"
       role="dialog"
       aria-modal="@(Open ? "true" : null)"
       aria-labelledby="@(HasTitle ? TitleId : null)"
       aria-label="@(HasTitle ? null : AriaLabel)"
       inert="@(!Open)"
       tabindex="-1"
       @onkeydown="OnKeyDownAsync"
       @onkeydown:stopPropagation="Open"
       @attributes="AdditionalAttributes">
    <header class="@HeaderClassValue">
        <div class="detail-sheet__heading">
            @if (!string.IsNullOrWhiteSpace(Kicker))
            {
                <p class="detail-sheet__kicker">@Kicker</p>
            }
            @if (HasTitle)
            {
                <h2 class="detail-sheet__title" id="@TitleId">@Title</h2>
            }
            @if (!string.IsNullOrWhiteSpace(Lede))
            {
                <p class="detail-sheet__lede">@Lede</p>
            }
        </div>

        <IconButton BaseClass="detail-sheet__close"
                    AriaLabel="@CloseLabel"
                    TestId="@CloseTestId"
                    Disabled="@(!Dismissible)"
                    OnClick="CloseAsync">&#215;</IconButton>
    </header>

    <div class="@BodyClassValue">
        @ChildContent
    </div>

    @if (Footer is not null)
    {
        <footer class="@FooterClassValue">
            @Footer
        </footer>
    }
</aside>

@code {
    private readonly string _id = "detail-sheet-" + Guid.NewGuid().ToString("N");
    private bool _trapped;

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>The eyebrow above the title — which section, folder or group the
    /// subject belongs to.</summary>
    [Parameter]
    public string? Kicker { get; set; }

    [Parameter]
    public string? Title { get; set; }

    /// <summary>One line saying what the subject is, under the title.</summary>
    [Parameter]
    public string? Lede { get; set; }

    /// <summary>Names the sheet when there is no title to name it.</summary>
    [Parameter]
    public string? AriaLabel { get; set; } = "Details";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Footer { get; set; }

    /// <summary>False while the sheet must stay up - work it started is still
    /// running and its result belongs here. Escape, the backdrop and the close
    /// button then do nothing, and the close button says so by being disabled.
    /// <see cref="CloseOnEscape"/> and <see cref="CloseOnBackdropClick"/> each
    /// turn one of those off for good; this turns all three off for a while.</summary>
    [Parameter]
    public bool Dismissible { get; set; } = true;

    [Parameter]
    public bool CloseOnEscape { get; set; } = true;

    [Parameter]
    public bool CloseOnBackdropClick { get; set; } = true;

    [Parameter]
    public string CloseLabel { get; set; } = "Close details";

    [Parameter]
    public EventCallback OnClosed { get; set; }

    /// <summary>The id of the element focus returns to on close. Named rather than
    /// captured so it survives the opener being re-rendered while the sheet is up;
    /// without it, focus goes back to whatever held it when the sheet opened.</summary>
    [Parameter]
    public string? RestoreFocusToId { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>Replaces <c>detail-sheet</c> on the panel.</summary>
    [Parameter]
    public string BaseClass { get; set; } = "detail-sheet";

    [Parameter]
    public string? BackdropCssClass { get; set; }

    [Parameter]
    public string? HeaderCssClass { get; set; }

    [Parameter]
    public string? BodyCssClass { get; set; }

    [Parameter]
    public string? FooterCssClass { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public string? BackdropTestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string TitleId => _id + "-title";

    private bool HasTitle => !string.IsNullOrWhiteSpace(Title);

    private string ClassValue => string.IsNullOrWhiteSpace(CssClass) ? BaseClass : $"{BaseClass} {CssClass}";

    private string BackdropClassValue =>
        string.IsNullOrWhiteSpace(BackdropCssClass) ? "detail-sheet-backdrop" : BackdropCssClass;

    private string HeaderClassValue => string.IsNullOrWhiteSpace(HeaderCssClass) ? "detail-sheet__header" : HeaderCssClass;

    private string BodyClassValue => string.IsNullOrWhiteSpace(BodyCssClass) ? "detail-sheet__body" : BodyCssClass;

    private string FooterClassValue => string.IsNullOrWhiteSpace(FooterCssClass) ? "detail-sheet__footer" : FooterCssClass;

    private string? CloseTestId => string.IsNullOrWhiteSpace(TestId) ? null : $"{TestId}-close";

    private Task BackdropClickedAsync() => CloseOnBackdropClick ? CloseAsync() : Task.CompletedTask;

    private Task OnKeyDownAsync(KeyboardEventArgs args) =>
        CloseOnEscape && args.Key == "Escape" ? CloseAsync() : Task.CompletedTask;

    private async Task CloseAsync()
    {
        if (!Open || !Dismissible) return;

        Open = false;
        await OpenChanged.InvokeAsync(false);
        await OnClosed.InvokeAsync();
    }

    /// <summary>Arms and releases the trap as the sheet opens and closes. Driven
    /// from render rather than from the setter because the panel has to exist in
    /// the DOM before anything can be focused inside it.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open == _trapped) return;

        _trapped = Open;

        try
        {
            if (Open)
            {
                // Escape held for the sheet wherever the focus is while it is open:
                // a sheet opened with the pointer can leave the focus on what was
                // pressed, outside it, and the key would go to the surface behind.
                await Js.InvokeVoidAsync("backlogFocusTrap", _id, RestoreFocusToId, CloseOnEscape);
            }
            else
            {
                await Js.InvokeVoidAsync("backlogReleaseFocusTrap", _id);
            }
        }
        catch (JSException)
        {
            _trapped = false;
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
            // Prerendering: no DOM to trap focus in yet.
            _trapped = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!_trapped) return;

        try
        {
            await Js.InvokeVoidAsync("backlogReleaseFocusTrap", _id);
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }
}
