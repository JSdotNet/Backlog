@*
    A dialog is only a dialog while it is open: when closed it renders nothing at
    all, so nothing behind it is reachable through a hidden node. Escape is
    handled on the container rather than on the document, which means it works
    without a document-wide listener and cannot outlive the dialog.

    The dialog element is written through the render tree because a host that
    already renders its dialog as a `section` should not have to give that up to
    gain the focus and Escape handling, and the class hooks replace the defaults
    so a host keeps its own naming.
*@

@if (Open)
{
    <div class="@BackdropClassValue" data-testid="@BackdropTestId" role="@BackdropRole" @onclick="BackdropClickedAsync">
        @DialogFragment
    </div>
}

@code {
    private readonly string _id = "modal-" + Guid.NewGuid().ToString("N");
    private ElementReference _dialog;
    private bool _focusPending;
    private bool _wasOpen;

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public string? Title { get; set; }

    /// <summary>Replaces the default title header entirely.</summary>
    [Parameter]
    public RenderFragment? Header { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Footer { get; set; }

    [Parameter]
    public bool CloseOnBackdropClick { get; set; } = true;

    [Parameter]
    public bool CloseOnEscape { get; set; } = true;

    [Parameter]
    public string CloseLabel { get; set; } = "Close dialog";

    [Parameter]
    public EventCallback OnClosed { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>The element the dialog is rendered as.</summary>
    [Parameter]
    public string Element { get; set; } = "div";

    /// <summary>Replaces <c>modal</c> on the dialog.</summary>
    [Parameter]
    public string BaseClass { get; set; } = "modal";

    /// <summary>Replaces <c>modal-backdrop</c> on the backdrop.</summary>
    [Parameter]
    public string? BackdropCssClass { get; set; }

    /// <summary>Replaces <c>modal__header</c> on the default header.</summary>
    [Parameter]
    public string? HeaderCssClass { get; set; }

    /// <summary>Replaces <c>modal__body</c> on the body wrapper.</summary>
    [Parameter]
    public string? BodyCssClass { get; set; }

    /// <summary>Replaces <c>modal__footer</c> on the footer.</summary>
    [Parameter]
    public string? FooterCssClass { get; set; }

    /// <summary>Wraps the content in a body element. Hosts whose dialog styling
    /// lays out its children directly turn this off.</summary>
    [Parameter]
    public bool UseBodyWrapper { get; set; } = true;

    [Parameter]
    public string? BackdropRole { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public string? BackdropTestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string TitleId => _id + "-title";

    private bool HasTitle => !string.IsNullOrWhiteSpace(Title);

    private string ClassValue => string.IsNullOrWhiteSpace(CssClass) ? BaseClass : $"{BaseClass} {CssClass}";

    private string BackdropClassValue =>
        string.IsNullOrWhiteSpace(BackdropCssClass) ? "modal-backdrop" : BackdropCssClass;

    private string HeaderClassValue => string.IsNullOrWhiteSpace(HeaderCssClass) ? "modal__header" : HeaderCssClass;

    private string BodyClassValue => string.IsNullOrWhiteSpace(BodyCssClass) ? "modal__body" : BodyCssClass;

    private string FooterClassValue => string.IsNullOrWhiteSpace(FooterCssClass) ? "modal__footer" : FooterCssClass;

    private RenderFragment DialogFragment => builder =>
    {
        builder.OpenElement(0, Element);
        builder.AddAttribute(1, "class", ClassValue);
        builder.AddAttribute(2, "role", "dialog");
        builder.AddAttribute(3, "aria-modal", "true");
        builder.AddAttribute(4, "aria-labelledby", HasTitle ? TitleId : null);
        builder.AddAttribute(5, "aria-label", HasTitle ? null : AriaLabel);
        builder.AddAttribute(6, "data-testid", TestId);
        builder.AddAttribute(7, "tabindex", "-1");
        builder.AddAttribute(8, "onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, OnKeyDownAsync));
        builder.AddEventStopPropagationAttribute(9, "onclick", true);
        builder.AddMultipleAttributes(10, AdditionalAttributes);
        builder.AddElementReferenceCapture(11, reference => _dialog = reference);
        builder.AddContent(12, DialogContent);
        builder.CloseElement();
    };

    private RenderFragment DialogContent =>
        @<text>
            @if (Header is not null)
            {
                @Header
            }
            else if (HasTitle)
            {
                <header class="@HeaderClassValue">
                    <h2 id="@TitleId" class="modal__title">@Title</h2>
                    <IconButton AriaLabel="@CloseLabel" CssClass="modal__close" OnClick="CloseAsync">x</IconButton>
                </header>
            }

            @if (UseBodyWrapper)
            {
                <div class="@BodyClassValue">@ChildContent</div>
            }
            else
            {
                @ChildContent
            }

            @if (Footer is not null)
            {
                <footer class="@FooterClassValue">@Footer</footer>
            }
        </text>;

    protected override void OnParametersSet()
    {
        // Focus has to land inside the dialog the moment it appears, or the
        // keyboard is still out in the page behind it. Armed only on the
        // false->true transition: OnParametersSet runs on every render, and a
        // host that re-renders while a field inside the dialog is being typed
        // into re-passes Open="true" unchanged — arming on that too would drag
        // focus back onto the dialog container on every keystroke.
        if (Open && !_wasOpen) _focusPending = true;
        _wasOpen = Open;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Open || !_focusPending) return;

        _focusPending = false;

        try
        {
            await _dialog.FocusAsync();
        }
        catch (JSException)
        {
        }
    }

    private Task BackdropClickedAsync() => CloseOnBackdropClick ? CloseAsync() : Task.CompletedTask;

    private Task OnKeyDownAsync(KeyboardEventArgs e) =>
        CloseOnEscape && e.Key == "Escape" ? CloseAsync() : Task.CompletedTask;

    private async Task CloseAsync()
    {
        Open = false;
        await OpenChanged.InvokeAsync(false);
        await OnClosed.InvokeAsync();
    }
}
