@implements IAsyncDisposable
@inject IJSRuntime Js

@*
    A dialog is only a dialog while it is open: when closed it renders nothing at
    all, so nothing behind it is reachable through a hidden node. Escape is
    handled on the container rather than on the document, which means it works
    without a document-wide listener and cannot outlive the dialog.

    That places one duty on the dialog: the focus must never leave it while it is
    up, or the Escape handler cannot be reached and the dialog is dismissable
    only with a pointer. So Tab is contained inside it — the same containment the
    sheet uses, out of `components.js` — and a backdrop click that does not close
    the dialog takes the focus back off the body the browser dropped it on.

    Focus is borrowed, not taken: the control that opened the dialog is recorded
    before the focus moves in, and gets it back when the dialog closes. That is
    the accessibility rule for every overlay, and it cannot be done with an
    `ElementReference` — the trigger belongs to another component and may not be
    rendered any more by the time the dialog goes. So `components.js` holds it,
    keyed by this dialog's id.

    The dialog element is written through the render tree because a host that
    already renders its dialog as a `section` should not have to give that up to
    gain the focus and Escape handling, and the class hooks replace the defaults
    so a host keeps its own naming.
*@

@if (Open)
{
    <div class="@BackdropClassValue" data-testid="@BackdropTestId" role="@BackdropRole" @onclick="BackdropClickedAsync">
        @DialogFragment
    </div>
}

@code {
    private readonly string _id = "modal-" + Guid.NewGuid().ToString("N");
    private ElementReference _dialog;
    private bool _holdsFocus;
    private bool _captured;
    private bool _contained;

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public string? Title { get; set; }

    /// <summary>Replaces the default title header entirely.</summary>
    [Parameter]
    public RenderFragment? Header { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Footer { get; set; }

    [Parameter]
    public bool CloseOnBackdropClick { get; set; } = true;

    [Parameter]
    public bool CloseOnEscape { get; set; } = true;

    [Parameter]
    public string CloseLabel { get; set; } = "Close dialog";

    [Parameter]
    public EventCallback OnClosed { get; set; }

    /// <summary>The id of the element focus returns to on close. Named rather than
    /// captured so it survives the opener being re-rendered while the dialog is up;
    /// without it, focus goes back to whatever held it when the dialog opened.</summary>
    [Parameter]
    public string? RestoreFocusToId { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>The element the dialog is rendered as.</summary>
    [Parameter]
    public string Element { get; set; } = "div";

    /// <summary>Replaces <c>modal</c> on the dialog.</summary>
    [Parameter]
    public string BaseClass { get; set; } = "modal";

    /// <summary>Replaces <c>modal-backdrop</c> on the backdrop.</summary>
    [Parameter]
    public string? BackdropCssClass { get; set; }

    /// <summary>Replaces <c>modal__header</c> on the default header.</summary>
    [Parameter]
    public string? HeaderCssClass { get; set; }

    /// <summary>Replaces <c>modal__body</c> on the body wrapper.</summary>
    [Parameter]
    public string? BodyCssClass { get; set; }

    /// <summary>Replaces <c>modal__footer</c> on the footer.</summary>
    [Parameter]
    public string? FooterCssClass { get; set; }

    /// <summary>Wraps the content in a body element. Hosts whose dialog styling
    /// lays out its children directly turn this off.</summary>
    [Parameter]
    public bool UseBodyWrapper { get; set; } = true;

    [Parameter]
    public string? BackdropRole { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public string? BackdropTestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string TitleId => _id + "-title";

    /// <summary>The id the dialog element actually carries. A host that splats its
    /// own <c>id</c> overwrites the generated one, and the containment has to
    /// follow it there: `components.js` reaches an element only by the name it
    /// rendered with, so arming on the generated id would find nothing, contain
    /// nothing, and say so to no one.</summary>
    private string DialogId =>
        AdditionalAttributes is not null
        && AdditionalAttributes.TryGetValue("id", out var supplied)
        && supplied?.ToString() is { Length: > 0 } named
            ? named
            : _id;

    private bool HasTitle => !string.IsNullOrWhiteSpace(Title);

    private string ClassValue => string.IsNullOrWhiteSpace(CssClass) ? BaseClass : $"{BaseClass} {CssClass}";

    private string BackdropClassValue =>
        string.IsNullOrWhiteSpace(BackdropCssClass) ? "modal-backdrop" : BackdropCssClass;

    private string HeaderClassValue => string.IsNullOrWhiteSpace(HeaderCssClass) ? "modal__header" : HeaderCssClass;

    private string BodyClassValue => string.IsNullOrWhiteSpace(BodyCssClass) ? "modal__body" : BodyCssClass;

    private string FooterClassValue => string.IsNullOrWhiteSpace(FooterCssClass) ? "modal__footer" : FooterCssClass;

    private RenderFragment DialogFragment => builder =>
    {
        builder.OpenElement(0, Element);
        builder.AddAttribute(1, "class", ClassValue);
        // The containment is addressed by id, which is the only handle
        // `components.js` has on an element. Written before the splat so a host
        // that has its own name for its dialog still wins — and `DialogId` reads
        // that name back, so the containment is armed on the id the dialog
        // actually renders with rather than on one nothing answers to.
        builder.AddAttribute(2, "id", DialogId);
        builder.AddAttribute(3, "role", "dialog");
        builder.AddAttribute(4, "aria-modal", "true");
        builder.AddAttribute(5, "aria-labelledby", HasTitle ? TitleId : null);
        builder.AddAttribute(6, "aria-label", HasTitle ? null : AriaLabel);
        builder.AddAttribute(7, "data-testid", TestId);
        builder.AddAttribute(8, "tabindex", "-1");
        builder.AddAttribute(9, "onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, OnKeyDownAsync));
        builder.AddEventStopPropagationAttribute(10, "onclick", true);
        builder.AddMultipleAttributes(11, AdditionalAttributes);
        builder.AddElementReferenceCapture(12, reference => _dialog = reference);
        builder.AddContent(13, DialogContent);
        builder.CloseElement();
    };

    private RenderFragment DialogContent =>
        @<text>
            @if (Header is not null)
            {
                @Header
            }
            else if (HasTitle)
            {
                <header class="@HeaderClassValue">
                    <h2 id="@TitleId" class="modal__title">@Title</h2>
                    <IconButton AriaLabel="@CloseLabel" CssClass="modal__close" OnClick="CloseAsync">x</IconButton>
                </header>
            }

            @if (UseBodyWrapper)
            {
                <div class="@BodyClassValue">@ChildContent</div>
            }
            else
            {
                @ChildContent
            }

            @if (Footer is not null)
            {
                <footer class="@FooterClassValue">@Footer</footer>
            }
        </text>;

    /// <summary>Takes the focus as the dialog appears and gives it back as the
    /// dialog goes. Driven by comparing <c>Open</c> against what the focus is
    /// actually doing rather than by a parameter transition, for two reasons: the
    /// dialog has to be in the DOM before anything in it can be focused, and
    /// Escape and the close button set <c>Open</c> from in here, where no
    /// parameter changes at all.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A host that re-renders while a field inside the dialog is being typed
        // into re-passes Open="true" unchanged. That is not the dialog opening
        // again, and acting on it would drag focus back onto the dialog container
        // on every keystroke.
        if (Open == _holdsFocus) return;

        _holdsFocus = Open;

        if (!Open)
        {
            // Containment first, and by id: the dialog element is already out of
            // the document by now, and only the record `components.js` keeps
            // against that id can still say where the focus goes back to.
            await ReleaseContainmentAsync();
            await RestoreFocusAsync();
            return;
        }

        // Captured before the focus moves, because until it does, `activeElement`
        // is still the control that opened the dialog — and nothing else knows
        // which one that was.
        await CaptureFocusAsync();

        try
        {
            await _dialog.FocusAsync();
        }
        catch (JSException)
        {
        }

        await ContainFocusAsync();
    }

    /// <summary>A host that tears the dialog out while it is open has closed it as
    /// surely as Escape does, and no further render will run to notice — so the
    /// containment goes and the focus comes back from here too.</summary>
    public async ValueTask DisposeAsync()
    {
        await ReleaseContainmentAsync();
        await RestoreFocusAsync();
    }

    private async Task CaptureFocusAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("backlogCaptureFocus", _id);
            _captured = true;
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
            // Prerendering: no document to read the active element from.
        }
    }

    /// <summary>Only a dialog that took the focus gives it back. One that never
    /// opened has nothing to return, and returning anyway would move a focus the
    /// reader put somewhere else themselves.</summary>
    private async Task RestoreFocusAsync()
    {
        if (!_captured) return;

        _captured = false;

        try
        {
            await Js.InvokeVoidAsync("backlogRestoreFocus", _id, RestoreFocusToId);
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    /// <summary>Keeps Tab inside the dialog while it is up. Armed after the focus
    /// has moved in, so the containment finds it already inside and leaves it
    /// where this component put it.</summary>
    private async Task ContainFocusAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("backlogContainFocus", DialogId);
            _contained = true;
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
            // Prerendering: no element to contain the focus in yet.
        }
    }

    /// <summary>Containment must not outlive the dialog: a listener left armed on
    /// an id nothing renders any more is the keyboard trap the accessibility
    /// rules forbid.</summary>
    private async Task ReleaseContainmentAsync()
    {
        if (!_contained) return;

        _contained = false;

        try
        {
            await Js.InvokeVoidAsync("backlogReleaseFocusContainment", DialogId);
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    /// <summary>A backdrop click that does not close the dialog still moves the
    /// focus: the browser drops it on the body, where the Escape handler on the
    /// dialog cannot hear it. Taking it back is what keeps a dialog that refuses
    /// the backdrop dismissable without a pointer.</summary>
    private async Task BackdropClickedAsync()
    {
        if (CloseOnBackdropClick)
        {
            await CloseAsync();
            return;
        }

        try
        {
            await _dialog.FocusAsync();
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private Task OnKeyDownAsync(KeyboardEventArgs e) =>
        CloseOnEscape && e.Key == "Escape" ? CloseAsync() : Task.CompletedTask;

    private async Task CloseAsync()
    {
        Open = false;
        await OpenChanged.InvokeAsync(false);
        await OnClosed.InvokeAsync();
    }
}
