@*
    Three dots in a row: "more of this, out of the way".

    Drawn here rather than fetched, for the reason ChevronUpIcon gives, and in
    Lucide's idiom on exactly the terms `.devbook/design/typography-and-layout.md#iconography`
    allows: an outline on the 24x24 grid, stroked at 2, round caps and joins,
    filled nowhere. Lucide's `ellipsis`, its three circles written as paths so the
    glyph is paths only like the rest of the set.

    Named for the shape, not for a meaning. The shell header puts it on the
    button that opens the repository display options; the name stays on that
    button, so the glyph is decorative and hidden from assistive technology.
*@

<svg class="@ClassValue"
     viewBox="0 0 24 24"
     width="@Size"
     height="@Size"
     fill="none"
     stroke="currentColor"
     stroke-width="2"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true"
     focusable="false"
     data-testid="@TestId"
     @attributes="AdditionalAttributes">
    <path d="M5 11a1 1 0 1 0 0 2a1 1 0 1 0 0-2z" />
    <path d="M12 11a1 1 0 1 0 0 2a1 1 0 1 0 0-2z" />
    <path d="M19 11a1 1 0 1 0 0 2a1 1 0 1 0 0-2z" />
</svg>

@code {
    /// <summary>Edge length, written straight onto <c>width</c> and <c>height</c>;
    /// see <see cref="ChevronUpIcon.Size"/> for the scale it is drawn on.</summary>
    [Parameter]
    public string Size { get; set; } = "16";

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ClassValue => string.IsNullOrWhiteSpace(CssClass) ? "ellipsis-icon" : $"ellipsis-icon {CssClass}";
}
