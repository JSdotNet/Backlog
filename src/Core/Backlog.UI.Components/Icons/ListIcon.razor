@*
    A list: three short marks, each with a line of text beside it.

    Drawn here rather than fetched, for the reason ChevronUpIcon gives, and in
    Lucide's idiom on exactly the terms `.devbook/design/typography-and-layout.md#iconography`
    allows: an outline on the 24x24 grid, stroked at 2, round caps and joins,
    filled nowhere. Lucide's `list`.

    Named for the shape, not for a meaning. The shell's view switch puts it on the
    Tasks option, and the name the option answers to stays on the option, which is
    why this is hidden from assistive technology like every glyph in this folder.
*@

<svg class="@ClassValue"
     viewBox="0 0 24 24"
     width="@Size"
     height="@Size"
     fill="none"
     stroke="currentColor"
     stroke-width="2"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true"
     focusable="false"
     data-testid="@TestId"
     @attributes="AdditionalAttributes">
    @* The marks, then the lines beside them. *@
    <path d="M3 6h.01" />
    <path d="M3 12h.01" />
    <path d="M3 18h.01" />
    <path d="M8 6h13" />
    <path d="M8 12h13" />
    <path d="M8 18h13" />
</svg>

@code {
    /// <summary>Edge length, written straight onto <c>width</c> and <c>height</c>;
    /// see <see cref="ChevronUpIcon.Size"/> for the scale it is drawn on.</summary>
    [Parameter]
    public string Size { get; set; } = "16";

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ClassValue => string.IsNullOrWhiteSpace(CssClass) ? "list-icon" : $"list-icon {CssClass}";
}
