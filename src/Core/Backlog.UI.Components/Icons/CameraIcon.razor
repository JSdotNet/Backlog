@*
    A camera body with its lens.

    Drawn here rather than fetched, for the reason ChevronUpIcon gives, in Lucide's
    idiom on the terms `.devbook/design/typography-and-layout.md#iconography` allows:
    an outline on the 24x24 grid, stroked at 2, round caps and joins, filled nowhere.
    Lucide's `camera`.

    Named for the shape, not for a meaning. The phone's Notes editor puts it on
    the tool that takes a photo; the button carries the name.
*@

<svg class="@ClassValue"
     viewBox="0 0 24 24"
     width="@Size"
     height="@Size"
     fill="none"
     stroke="currentColor"
     stroke-width="2"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true"
     focusable="false"
     data-testid="@TestId"
     @attributes="AdditionalAttributes">
    @* The body with its viewfinder hump, then the lens. *@
    <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z" />
    <circle cx="12" cy="13" r="3" />
</svg>

@code {
    /// <summary>Edge length, written straight onto <c>width</c> and <c>height</c>;
    /// see <see cref="ChevronUpIcon.Size"/> for the scale it is drawn on.</summary>
    [Parameter]
    public string Size { get; set; } = "16";

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ClassValue => string.IsNullOrWhiteSpace(CssClass) ? "camera-icon" : $"camera-icon {CssClass}";
}
