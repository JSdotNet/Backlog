@*
    A circle drawn as eight dashes: Lucide's `circle-dashed`.

    Drawn here rather than fetched, for the reason ChevronUpIcon gives, and in
    Lucide's idiom on exactly the terms `.devbook/design/typography-and-layout.md#iconography`
    allows: an outline on the 24x24 grid, stroked at 2, round caps and joins,
    filled nowhere.

    Named for the shape, not for a meaning. The pull request status line puts it on a checks mark with checks still running; the count and the hidden words beside it carry the meaning.
*@

<svg class="@ClassValue"
     viewBox="0 0 24 24"
     width="@Size"
     height="@Size"
     fill="none"
     stroke="currentColor"
     stroke-width="2"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true"
     focusable="false"
     data-testid="@TestId"
     @attributes="AdditionalAttributes">
    <path d="M10.1 2.182a10 10 0 0 1 3.8 0" />
    <path d="M13.9 21.818a10 10 0 0 1-3.8 0" />
    <path d="M17.609 3.721a10 10 0 0 1 2.69 2.7" />
    <path d="M2.182 13.9a10 10 0 0 1 0-3.8" />
    <path d="M20.279 17.609a10 10 0 0 1-2.7 2.69" />
    <path d="M21.818 10.1a10 10 0 0 1 0 3.8" />
    <path d="M3.721 6.391a10 10 0 0 1 2.7-2.69" />
    <path d="M6.391 20.279a10 10 0 0 1-2.69-2.7" />
</svg>

@code {
    /// <summary>Edge length, written straight onto <c>width</c> and <c>height</c>;
    /// see <see cref="ChevronUpIcon.Size"/> for the scale it is drawn on.</summary>
    [Parameter]
    public string Size { get; set; } = "16";

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ClassValue => string.IsNullOrWhiteSpace(CssClass) ? "circle-dashed-icon" : $"circle-dashed-icon {CssClass}";
}
