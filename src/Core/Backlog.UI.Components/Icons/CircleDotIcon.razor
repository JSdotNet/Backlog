@*
    A ring with a dot at its centre.

    Drawn here rather than fetched, for the reason ChevronUpIcon gives, in Lucide's
    idiom on the terms `.devbook/design/typography-and-layout.md#iconography` allows:
    an outline on the 24x24 grid, stroked at 2, round caps and joins, filled nowhere.
    Lucide's `circle-dot`.

    Named for the shape, not for a meaning. The phone's Notes editor puts it on
    Record, the meeting recording's tool; the button carries the name.
*@

<svg class="@ClassValue"
     viewBox="0 0 24 24"
     width="@Size"
     height="@Size"
     fill="none"
     stroke="currentColor"
     stroke-width="2"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true"
     focusable="false"
     data-testid="@TestId"
     @attributes="AdditionalAttributes">
    <circle cx="12" cy="12" r="10" />
    <circle cx="12" cy="12" r="1" />
</svg>

@code {
    /// <summary>Edge length, written straight onto <c>width</c> and <c>height</c>;
    /// see <see cref="ChevronUpIcon.Size"/> for the scale it is drawn on.</summary>
    [Parameter]
    public string Size { get; set; } = "16";

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ClassValue => string.IsNullOrWhiteSpace(CssClass) ? "circle-dot-icon" : $"circle-dot-icon {CssClass}";
}
