@*
    A to-do list: a box, a tick beneath it, and three lines beside them.

    Drawn here rather than fetched, for the reason ChevronUpIcon gives, and in
    Lucide's idiom on exactly the terms `.devbook/design/typography-and-layout.md#iconography`
    allows: an outline on the 24x24 grid, stroked at 2, round caps and joins,
    filled nowhere.

    Named for the shape, not for a meaning. The Tasks pane puts it on its Next
    actions scope — the open tasks that can be picked up now — and the name the
    chip answers to stays on the chip.
*@

<svg class="@ClassValue"
     viewBox="0 0 24 24"
     width="@Size"
     height="@Size"
     fill="none"
     stroke="currentColor"
     stroke-width="2"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true"
     focusable="false"
     data-testid="@TestId"
     @attributes="AdditionalAttributes">
    <path d="M4 5h4a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z" />
    <path d="m3 17 2 2 4-4" />
    <path d="M13 6h8" />
    <path d="M13 12h8" />
    <path d="M13 18h8" />
</svg>

@code {
    /// <summary>Edge length, written straight onto <c>width</c> and <c>height</c>;
    /// see <see cref="ChevronUpIcon.Size"/> for the scale it is drawn on.</summary>
    [Parameter]
    public string Size { get; set; } = "16";

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ClassValue => string.IsNullOrWhiteSpace(CssClass) ? "list-todo-icon" : $"list-todo-icon {CssClass}";
}
