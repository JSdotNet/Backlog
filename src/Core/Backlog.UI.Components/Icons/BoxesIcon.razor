@*
    Boxes: three cubes stacked as a pyramid, two below and one on top.

    Drawn here rather than fetched, for the reason ChevronUpIcon gives, and in
    Lucide's idiom on exactly the terms
    `.devbook/design/typography-and-layout.md#iconography` allows: Lucide's own
    `boxes` outline on the 24x24 grid, stroked at 2, round caps and joins.

    Named for the shape, not for a meaning. The Devbook pane puts it on the
    Domain section's tab and on a branch that changes the domain model: bounded
    contexts read as boxes beside each other. The name the glyph stands beside
    says what it means, so it is decorative and hidden from assistive
    technology. Colour and size are the caller's, as on every glyph in this
    folder.
*@

<svg class="@ClassValue"
     viewBox="0 0 24 24"
     width="@Size"
     height="@Size"
     fill="none"
     stroke="currentColor"
     stroke-width="2"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true"
     focusable="false"
     data-testid="@TestId"
     @attributes="AdditionalAttributes">
    <path d="M2.97 12.92A2 2 0 0 0 2 14.63v3.24a2 2 0 0 0 .97 1.71l3 1.8a2 2 0 0 0 2.06 0L12 19v-5.5l-5-3-4.03 2.42Z" />
    <path d="m7 16.5-4.74-2.85" />
    <path d="m7 16.5 5-3" />
    <path d="M7 16.5v5.17" />
    <path d="M12 13.5V19l3.97 2.38a2 2 0 0 0 2.06 0l3-1.8a2 2 0 0 0 .97-1.71v-3.24a2 2 0 0 0-.97-1.71L17 10.5l-5 3Z" />
    <path d="m17 16.5-5-3" />
    <path d="m17 16.5 4.74-2.85" />
    <path d="M17 16.5v5.17" />
    <path d="M7.97 4.42A2 2 0 0 0 7 6.13v4.37l5 3 5-3V6.13a2 2 0 0 0-.97-1.71l-3-1.8a2 2 0 0 0-2.06 0l-3 1.8Z" />
    <path d="M12 8 7.26 5.15" />
    <path d="m12 8 4.74-2.85" />
    <path d="M12 13.5V8" />
</svg>

@code {
    /// <summary>Edge length, written straight onto <c>width</c> and <c>height</c>;
    /// see <see cref="ChevronUpIcon.Size"/> for the scale it is drawn on.</summary>
    [Parameter]
    public string Size { get; set; } = "16";

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ClassValue => string.IsNullOrWhiteSpace(CssClass) ? "boxes-icon" : $"boxes-icon {CssClass}";
}
