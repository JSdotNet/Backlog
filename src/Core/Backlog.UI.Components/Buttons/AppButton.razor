@*
    The one button. Variant and size are modifiers on `btn`, matching the class
    conventions the app's stylesheet already uses, so a host can adopt this
    without restyling anything.

    A host that already ships a button of its own - a chip, a pill, a toolbar
    toggle - hands over the whole name through BaseClass instead. The modifiers
    are derived from it, so nothing of ours is left on the element: `btn` brings
    padding, a weight and a transition with it, and appending that to a `.chip`
    restyles the chip rather than adopting the component.

    Given an Href it is an anchor instead, wearing the same classes - the shape
    Badge and IntegrationLink already take when what they hold has an address. An
    act whose whole effect is "go and look at this on GitHub" is a link: it can be
    middle-clicked, copied and opened in a new window, and a button that navigates
    cannot. The alternative was an app anchor wearing `btn`, which is a second
    button the library cannot keep in step with this one. By default it opens in a
    new window, because such an address is another site's and the app has no
    browser history to come back through. A link to a page of the app itself -
    Settings, say - sets External to false and opens in place: the desktop and
    mobile WebViews hand every new-window link to the system browser, so a
    `target="_blank"` on an app route would leave the app instead of navigating
    through its router. A disabled or busy link has no href,
    since an anchor has no disabled state of its own - but an anchor without an
    href leaves the tab order and stops being a link, which would break Busy's
    promise that focus survives the round trip. So the inert one keeps both by
    hand: role="link", tabindex="0", and aria-disabled="true" on the link role,
    where ARIA defines it.

    The button is written last. Every caller that passes no Href renders a button.

    Busy keeps the button out of the native `disabled` state for the same promise
    (.devbook/design/interaction-guidelines.md#accessibility): `disabled` drops the
    element from the tab order and takes the focus off it mid-act, so a keyboard
    reader who pressed Save would land on the body. Busy says aria-disabled
    instead and the click is ignored here, and preventDefault keeps a busy submit
    button from submitting its form. Disabled is a standing state and keeps the
    native attribute.
*@

@if (Href is not null)
{
    var inert = Disabled || Busy;

    <a class="@ClassValue"
       href="@(inert ? null : Href)"
       target="@(External ? "_blank" : null)"
       rel="@(External ? "noopener noreferrer" : null)"
       data-testid="@TestId"
       role="@(inert ? "link" : null)"
       tabindex="@(inert ? "0" : null)"
       aria-disabled="@(inert ? "true" : null)"
       aria-busy="@(Busy ? "true" : null)"
       @attributes="AdditionalAttributes">
        @if (Busy)
        {
            <Spinner Size="SpinnerSize.Small" Label="@BusyLabel" />
        }
        else if (Icon is not null)
        {
            <span class="@IconClassValue" aria-hidden="true">@Icon</span>
        }
        @ChildContent
    </a>
}
else
{
<button type="@TypeAttribute"
        class="@ClassValue"
        data-testid="@TestId"
        disabled="@Disabled"
        aria-disabled="@(Busy && !Disabled ? "true" : null)"
        aria-busy="@(Busy ? "true" : null)"
        @onclick="ClickAsync"
        @onclick:preventDefault="Busy"
        @onclick:stopPropagation="StopPropagation"
        @attributes="AdditionalAttributes">
    @if (Busy)
    {
        <Spinner Size="SpinnerSize.Small" Label="@BusyLabel" />
    }
    else if (Icon is not null)
    {
        <span class="@IconClassValue" aria-hidden="true">@Icon</span>
    }
    @ChildContent
</button>
}

@code {
    [Parameter]
    public ButtonVariant Variant { get; set; } = ButtonVariant.Secondary;

    [Parameter]
    public ButtonSize Size { get; set; } = ButtonSize.Default;

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Shows a spinner and blocks the click without removing the button
    /// from the tab order, so focus survives the round trip.</summary>
    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public string BusyLabel { get; set; } = "Working";

    [Parameter]
    public string Type { get; set; } = "button";

    /// <summary>Where the act leads, when it is a page rather than something done
    /// here. Set, the button renders as an anchor opening that address - in a new
    /// window unless <see cref="External"/> is false - and <see cref="OnClick"/>,
    /// <see cref="Type"/> and <see cref="StopPropagation"/> do not apply.</summary>
    [Parameter]
    public string? Href { get; set; }

    /// <summary>Whether <see cref="Href"/> is another site's address, opened in a new
    /// window. False for a page of the app itself, which opens in place through the
    /// app's router.</summary>
    [Parameter]
    public bool External { get; set; } = true;

    [Parameter]
    public RenderFragment? Icon { get; set; }

    /// <summary>The icon is the whole button, with no label beside it. Only the
    /// component rendering the button knows this: the label is a text node rather
    /// than an element, so a CSS <c>:only-child</c> test would count a labelled
    /// button as an icon-only one and take away the gap it needs.</summary>
    [Parameter]
    public bool IconAlone { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string IconClassValue => IconAlone ? "btn__icon btn__icon--alone" : "btn__icon";

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>Stops the click reaching a clickable region around the button.
    /// It is a parameter and not something a host can splat: `@onclick:stopPropagation`
    /// is a directive attribute on an element, and writing it on a component is
    /// a compile error - so without this, a button inside a click-to-edit card
    /// could not be one of ours.</summary>
    [Parameter]
    public bool StopPropagation { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>Replaces <c>btn</c>, and with it the stem every variant and size
    /// modifier is built on.</summary>
    [Parameter]
    public string BaseClass { get; set; } = "btn";

    [Parameter]
    public string? TestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string TypeAttribute => Type is "submit" ? "submit" : "button";

    /// <summary>A press on a busy button is a second press of an act already
    /// running, so it is dropped rather than raised.</summary>
    private Task ClickAsync(MouseEventArgs args) =>
        Busy || Disabled ? Task.CompletedTask : OnClick.InvokeAsync(args);

    private string ClassValue
    {
        get
        {
            var variant = Variant switch
            {
                ButtonVariant.Primary => $" {BaseClass}--primary",
                ButtonVariant.Ghost => $" {BaseClass}--ghost",
                ButtonVariant.Danger => $" {BaseClass}--danger",
                ButtonVariant.None => string.Empty,
                _ => $" {BaseClass}--secondary"
            };

            var size = Size is ButtonSize.Small ? $" {BaseClass}--small" : string.Empty;

            var extra = string.IsNullOrWhiteSpace(CssClass) ? string.Empty : " " + CssClass;

            return $"{BaseClass}{variant}{size}{extra}";
        }
    }
}
