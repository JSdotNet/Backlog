@*
    A button that stays pressed. `aria-pressed` is the state; the `--pressed`
    modifier only mirrors it for the eye.

    Both class names are hooks, and they are separate ones on purpose: a host
    that already ships pressable chips almost never calls the pressed state
    `--pressed`. It is `chip--active` here and `--selected` there, and a base
    class alone could not express that.
*@

@if (InRadioGroup)
{
    @* Inside a radio-mode ButtonGroup the button is one option of a choice:
       `aria-checked` replaces `aria-pressed`, and the roving tabindex keeps the
       whole group one stop. The pressed class still mirrors the state, so a
       host's styling does not change with the mode. *@
    <button type="button"
            class="@ClassValue"
            data-testid="@TestId"
            role="radio"
            aria-checked="@(Pressed ? "true" : "false")"
            tabindex="@(Group!.IsTabStop(this) ? 0 : -1)"
            disabled="@Disabled"
            title="@Title"
            aria-label="@AriaLabel"
            @ref="_element"
            @onclick="TogglePressed"
            @onclick:stopPropagation="StopPropagation"
            @onkeydown="OnKeyDownAsync"
            @attributes="AdditionalAttributes">
        @ChildContent
    </button>
}
else
{
    <button type="button"
            class="@ClassValue"
            data-testid="@TestId"
            aria-pressed="@(Pressed ? "true" : "false")"
            disabled="@Disabled"
            title="@Title"
            aria-label="@AriaLabel"
            @onclick="TogglePressed"
            @onclick:stopPropagation="StopPropagation"
            @attributes="AdditionalAttributes">
        @ChildContent
    </button>
}

@implements IDisposable

@code {
    private ElementReference _element;
    private bool _focusPending;

    /// <summary>The group around this button, when there is one. Only a group in
    /// <see cref="ButtonGroup.Radio"/> mode changes anything here.</summary>
    [CascadingParameter]
    public ButtonGroup? Group { get; set; }

    [Parameter]
    public bool Pressed { get; set; }

    [Parameter]
    public EventCallback<bool> PressedChanged { get; set; }

    /// <summary>The press itself, modifiers and all, raised after
    /// <see cref="PressedChanged"/>. For a host whose strip means something
    /// different with a modifier held — one of many on a plain press, one more with
    /// Ctrl — and so needs the event rather than only the new state. A button the
    /// keyboard activates synthesises a click carrying the same modifiers, so a
    /// host reading them here needs no keydown handler of its own.</summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Stops the click reaching a clickable region around the button;
    /// see <see cref="AppButton.StopPropagation"/> for why it cannot be splatted.</summary>
    [Parameter]
    public bool StopPropagation { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>Replaces <c>btn btn--toggle</c> entirely.</summary>
    [Parameter]
    public string BaseClass { get; set; } = "btn btn--toggle";

    /// <summary>Replaces <c>btn--pressed</c>, the class added while
    /// <see cref="Pressed"/> is set.</summary>
    [Parameter]
    public string PressedCssClass { get; set; } = "btn--pressed";

    [Parameter]
    public string? TestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ClassValue
    {
        get
        {
            var pressed = Pressed && !string.IsNullOrWhiteSpace(PressedCssClass) ? " " + PressedCssClass : string.Empty;
            var extra = string.IsNullOrWhiteSpace(CssClass) ? string.Empty : " " + CssClass;
            return $"{BaseClass}{pressed}{extra}";
        }
    }

    private bool InRadioGroup => Group is { Radio: true };

    protected override void OnInitialized()
    {
        if (InRadioGroup) Group!.Register(this);
    }

    public void Dispose() => Group?.Unregister(this);

    private async Task TogglePressed(MouseEventArgs args)
    {
        // The new state is announced rather than kept: a host driving a
        // one-of-many strip sets Pressed from its own selection on the next
        // render, and pressing the pressed one there must not unpress it.
        // A radio is never unchecked by pressing it, so it announces true.
        var pressed = InRadioGroup || !Pressed;
        Pressed = pressed;
        await PressedChanged.InvokeAsync(pressed);
        await OnClick.InvokeAsync(args);
    }

    /// <summary>
    /// Selection follows focus, as in Tabs: the arrow lands on the next radio and
    /// chooses it, so a keyboard reader changes the choice with one key where a
    /// pointer reader uses one click. The page would otherwise scroll on the same
    /// keys; components.js refuses that default on a radio, because a
    /// state-bound <c>@onkeydown:preventDefault</c> applies to the key after.
    /// </summary>
    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        var target = Group?.Step(this, args.Key);
        if (target is null) return;

        await target.SelectFromKeyboardAsync();
    }

    private async Task SelectFromKeyboardAsync()
    {
        _focusPending = true;
        await TogglePressed(new MouseEventArgs());
        StateHasChanged();
    }

    /// <summary>
    /// Moving the roving tabindex is not moving focus. Without this the ring would
    /// stay on the radio the reader left, now at <c>tabindex="-1"</c>, and the next
    /// arrow would be computed from it.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending) return;

        _focusPending = false;

        try
        {
            await _element.FocusAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }
}
