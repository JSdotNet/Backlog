@*
    An icon on its own says nothing to a screen reader, so AriaLabel and Title
    are required rather than optional.

    BaseClass hands the whole class name to a host that already dresses its own
    icon buttons. `.btn--icon` carries a 2rem minimum, so appending it to a
    tighter row action would grow the row rather than adopt the component.
*@

<button type="button"
        class="@ClassValue"
        data-testid="@TestId"
        aria-label="@AriaLabel"
        title="@TitleValue"
        disabled="@Disabled"
        @onclick="OnClick"
        @attributes="AdditionalAttributes">
    <span aria-hidden="true">@ChildContent</span>
</button>

@code {
    [Parameter, EditorRequired]
    public string AriaLabel { get; set; } = string.Empty;

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>Replaces <c>btn btn--icon</c> entirely.</summary>
    [Parameter]
    public string BaseClass { get; set; } = "btn btn--icon";

    [Parameter]
    public string? TestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string TitleValue => string.IsNullOrWhiteSpace(Title) ? AriaLabel : Title;

    private string ClassValue => string.IsNullOrWhiteSpace(CssClass)
        ? BaseClass
        : $"{BaseClass} {CssClass}";
}
