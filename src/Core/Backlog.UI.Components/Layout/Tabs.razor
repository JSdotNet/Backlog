@*
    Roving tabindex: exactly one tab is reachable with Tab, and the arrow keys
    move between them. That is what keeps a tab strip one stop in the tab order
    instead of one stop per tab.

    The class hooks below *replace* the defaults instead of appending to them. A
    host that already ships a tab strip of its own (a pill row, a card grid) has
    to be able to hand over the whole class name, or it ends up styling against
    ours as well as its own.
*@

<CascadingValue Value="this" IsFixed="true">
    @if (Bare)
    {
        @* The host already owns the surrounding layout, so wrappers here would
           only push its spacing around. CascadingValue renders no DOM of its
           own, so the strip and the panels come out as plain siblings. *@
        @RenderStrip()
        @ChildContent
    }
    else
    {
        <div class="@ClassValue" data-testid="@TestId" @attributes="AdditionalAttributes">
            @RenderStrip()
            <div class="@PanelsClassValue">
                @ChildContent
            </div>
        </div>
    }
</CascadingValue>

@code {
    private readonly List<TabPanel> _panels = [];
    private ElementReference[] _elements = [];
    private int _focusTarget = -1;

    [Parameter]
    public string? ActiveId { get; set; }

    [Parameter]
    public EventCallback<string> ActiveIdChanged { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Rendered on the same line as the tab strip, after it.
    ///
    /// <para>For the action that belongs beside a set of tabs rather than inside
    /// them — a strip-level toggle, a count, a link out. It cannot go inside the
    /// list: that element is the <c>tablist</c>, and a tablist's children are
    /// tabs, so a button in there is a lie to a screen reader.</para>
    ///
    /// <para>Supplying this is the one thing that makes <c>Bare</c> emit a wrapper,
    /// because two elements cannot share a line without one. A host that passes
    /// nothing gets exactly the DOM it got before this existed.</para></summary>
    [Parameter]
    public RenderFragment? ListTrailing { get; set; }

    /// <summary>Replaces <c>tabs__strip</c> on the row holding the list and
    /// <see cref="ListTrailing"/>. Only rendered when there is trailing content.</summary>
    [Parameter]
    public string? StripCssClass { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    /// <summary>Renders the strip and the panels without the wrapping
    /// <c>tabs</c> and <c>tabs__panels</c> elements, for hosts whose own layout
    /// already places them.</summary>
    [Parameter]
    public bool Bare { get; set; }

    /// <summary>The element the tab list is rendered as: <c>div</c> or <c>nav</c>.</summary>
    [Parameter]
    public string ListElement { get; set; } = "div";

    /// <summary>Replaces <c>tabs__list</c> on the tab list.</summary>
    [Parameter]
    public string? ListCssClass { get; set; }

    /// <summary>Replaces <c>tabs__tab</c> on every inactive tab.</summary>
    [Parameter]
    public string? TabCssClass { get; set; }

    /// <summary>Replaces <c>tabs__tab tabs__tab--active</c> on the active tab.</summary>
    [Parameter]
    public string? ActiveTabCssClass { get; set; }

    /// <summary>Replaces <c>tabs__panels</c> on the element wrapping the panels.
    /// Ignored when <see cref="Bare"/> is set.</summary>
    [Parameter]
    public string? PanelCssClass { get; set; }

    /// <summary>The test id on the tab list itself; <see cref="TestId"/> stays on
    /// the outer element.</summary>
    [Parameter]
    public string? ListTestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ClassValue => string.IsNullOrWhiteSpace(CssClass) ? "tabs" : $"tabs {CssClass}";

    private string ListClassValue => string.IsNullOrWhiteSpace(ListCssClass) ? "tabs__list" : ListCssClass;

    private string PanelsClassValue => string.IsNullOrWhiteSpace(PanelCssClass) ? "tabs__panels" : PanelCssClass;

    internal string TabId(string id) => $"tab-{id}";

    internal string PanelId(string id) => $"tabpanel-{id}";

    internal bool IsActive(string id) =>
        string.Equals(ActiveId, id, StringComparison.Ordinal)
        || (string.IsNullOrEmpty(ActiveId) && _panels.Count > 0 && _panels[0].Id == id);

    private string TabClass(string id) => IsActive(id)
        ? (string.IsNullOrWhiteSpace(ActiveTabCssClass) ? "tabs__tab tabs__tab--active" : ActiveTabCssClass)
        : (string.IsNullOrWhiteSpace(TabCssClass) ? "tabs__tab" : TabCssClass);

    private string StripClassValue => string.IsNullOrWhiteSpace(StripCssClass) ? "tabs__strip" : StripCssClass;

    /// <summary>The list, or the list and whatever the host put beside it.</summary>
    private RenderFragment RenderStrip() => ListTrailing is null
        ? RenderTabList()
        : @<div class="@StripClassValue">
              @RenderTabList()
              @ListTrailing
          </div>;

    private RenderFragment RenderTabList() =>
        string.Equals(ListElement, "nav", StringComparison.OrdinalIgnoreCase) ? NavTabList : DivTabList;

    private RenderFragment NavTabList =>
        @<nav class="@ListClassValue"
              data-testid="@ListTestId"
              role="tablist"
              aria-label="@AriaLabel"
              aria-orientation="horizontal">@RenderTabs()</nav>;

    private RenderFragment DivTabList =>
        @<div class="@ListClassValue"
              data-testid="@ListTestId"
              role="tablist"
              aria-label="@AriaLabel"
              aria-orientation="horizontal">@RenderTabs()</div>;

    private RenderFragment RenderTabs() =>
        @<text>
            @for (var index = 0; index < _panels.Count; index++)
            {
                var panel = _panels[index];
                var id = panel.Id;
                var slot = index;
                <button type="button"
                        id="@TabId(id)"
                        @ref="_elements[slot]"
                        class="@TabClass(id)"
                        data-testid="@panel.TabTestId"
                        role="tab"
                        aria-selected="@(IsActive(id) ? "true" : "false")"
                        aria-controls="@PanelId(id)"
                        tabindex="@(IsActive(id) ? 0 : -1)"
                        disabled="@panel.Disabled"
                        @onclick="() => ActivateAsync(id)"
                        @onkeydown="e => OnKeyDownAsync(e, id)">@(panel.TitleContent ?? RenderTitle(panel))</button>
            }
        </text>;

    private static RenderFragment RenderTitle(TabPanel panel) => builder => builder.AddContent(0, panel.Title);

    internal void Register(TabPanel panel)
    {
        if (_panels.Contains(panel)) return;

        _panels.Add(panel);
        Resize();
        StateHasChanged();
    }

    internal void Unregister(TabPanel panel)
    {
        if (!_panels.Remove(panel)) return;

        Resize();
        StateHasChanged();
    }

    private void Resize()
    {
        if (_elements.Length != _panels.Count) _elements = new ElementReference[_panels.Count];
    }

    /// <summary>
    /// Moving the roving tabindex is not moving focus. Without this the ring stays
    /// on the tab the reader arrived at while the selection walks away from it —
    /// and because that tab is now the one at <c>tabindex="-1"</c>, the next arrow
    /// is computed from the stale tab rather than the visible one. ArrowRight then
    /// ArrowLeft would leave the reader on the second tab with no way back.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusTarget < 0) return;

        var target = _focusTarget;
        _focusTarget = -1;

        if (target >= _elements.Length) return;

        try
        {
            await _elements[target].FocusAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private Task ActivateAsync(string id)
    {
        if (string.Equals(ActiveId, id, StringComparison.Ordinal)) return Task.CompletedTask;

        ActiveId = id;
        StateHasChanged();
        return ActiveIdChanged.InvokeAsync(id);
    }

    private Task OnKeyDownAsync(KeyboardEventArgs e, string id)
    {
        var enabled = _panels.Where(panel => !panel.Disabled).Select(panel => panel.Id).ToList();
        if (enabled.Count == 0) return Task.CompletedTask;

        var current = enabled.IndexOf(id);
        if (current < 0) current = 0;

        var target = e.Key switch
        {
            "ArrowRight" => (current + 1) % enabled.Count,
            "ArrowLeft" => (current - 1 + enabled.Count) % enabled.Count,
            "Home" => 0,
            "End" => enabled.Count - 1,
            _ => -1
        };

        if (target < 0) return Task.CompletedTask;

        // The index into the strip, not into the enabled subset: a disabled tab is
        // skipped over by the keyboard but still rendered, so it still has a slot.
        _focusTarget = _panels.FindIndex(panel => panel.Id == enabled[target]);

        return ActivateAsync(enabled[target]);
    }
}
