@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime Js

@*
    A plan drawn against time: quarters across the top, a two-level column of
    swimlanes down the left, and everything else placed by its dates.

    The model is entirely the caller's. A group has been a department, a product
    area and a person; a row has been a name, a team and a milestones track; and
    this component can tell none of them apart. It is handed groups, it draws
    the rows under each in the order given, and it never asks what one means.
    That is why there is no Owner, no Area and no Repository here — filtering on
    those three works, and works without this file knowing the words, because a
    bar carries facets whose names the caller chose. See RoadmapFacet.

    Two of the gestures need saying plainly. Dragging is a pointer gesture with
    no keyboard equivalent of its own, so every one of them has a key: a bar is
    grabbed with Space, walked with the arrows, and dropped or abandoned. And
    nothing here is committed. A drag proposes a placement, the timeline draws
    the proposal, and the host is told once, on drop, what the reader decided —
    because only the host knows whether the new dates are allowed, whether they
    save, and what else has to move with them.
*@

<section class="roadmap-timeline @(OnSlotActivated.HasDelegate ? "roadmap-timeline--insertable" : null) @(HoursLineShown ? "roadmap-timeline--hours" : null) @CssClass"
         style="@Metrics"
         aria-labelledby="@(string.IsNullOrWhiteSpace(LabelledBy) ? _headingId : LabelledBy)"
         data-testid="@TestId">
    <header class="roadmap-timeline__header">
        <div class="roadmap-timeline__heading">
            @(TitleContent ?? Heading)
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p class="roadmap-timeline__description">@Description</p>
            }
        </div>

        @* The filter controls exist only where there is something to filter. A
           caller whose bars carry no facets gets no filter bar rather than an
           empty one, which would promise a narrowing that cannot happen.

           No visible label above each one. The facet name is the placeholder
           instead, which says the same word in half the height — and height is the
           scarce axis wherever this chart is drawn in a band rather than a page.
           Nothing is lost to a screen reader: TagMultiSelect gives its input an
           aria-label from the placeholder exactly when there is no label element,
           so the control is still announced as "Repository" rather than as an
           unnamed combobox. *@
        @if (ShowFilters && FacetNames.Count > 0)
        {
            <div class="roadmap-timeline__filters" data-testid="@Suffix("filters")">
                @foreach (var name in FacetNames)
                {
                    <TagMultiSelect @key="name"
                                    Placeholder="@name"
                                    Options="@OptionsFor(name)"
                                    SelectedValues="@SelectedIn(name)"
                                    SelectedValuesChanged="values => Filter(name, values)"
                                    CssClass="roadmap-timeline__filter"
                                    TestId="@Suffix($"filter-{Slug(name)}")" />
                }

                @if (_filters.Values.Any(values => values.Count > 0))
                {
                    <AppButton Variant="ButtonVariant.Ghost"
                               OnClick="ClearFilters"
                               TestId="@Suffix("filter-clear")">
                        Clear filters
                    </AppButton>
                }
            </div>
        }
    </header>

    @* One copy of the keyboard contract, pointed at by every bar. Repeating it
       per bar would have a screen reader read the manual three hundred times. *@
    <p id="@_helpId" class="sr-only">
        Press Enter to open. Press Space to pick the bar up, then Left and Right to move it a week,
        Up and Down to move it to another row, Shift with Left or Right to change its end date,
        and Alt with Left or Right to change its start date. Space drops it, Escape puts it back.
        A bar that shows a dashed outline cannot be moved, and its start stays fixed; where it offers
        its end, Shift with Left or Right changes that end date alone.
        A bar with steps has a button beside it that shows or hides them, one row each.
        A step is drawn by its share of the effort, not by date.
        @if (OnLinkCreated.HasDelegate)
        {
            <text>With a pointer, drag the dot past a bar's end onto another bar or a date to make that one wait for it.</text>
        }
        @if (OnSlotActivated.HasDelegate)
        {
            <text>With a pointer, double-click an empty place on a row to add something there, in that week, or drag across one to add something that long.</text>
        }
    </p>

    <p class="sr-only" role="status" aria-live="polite" data-testid="@Suffix("announcement")">@_announcement</p>

    @if (Rows.Count == 0)
    {
        <p class="roadmap-timeline__empty" data-testid="@Suffix("empty")">@EmptyMessage</p>
    }
    else
    {
        <div class="roadmap-timeline__frame">
            @* The left column does not scroll sideways with the track, so the
               row a bar belongs to stays readable in November. It is a sibling
               of the scroller rather than something sticky inside it: the rows
               and the labels are then two lists of the same height in the same
               order, which is a far cheaper promise to keep than a sticky cell
               inside a scrolling, transformed grid. *@
            @if (Slotted)
            {
                @* With a host's content in a band, the sidebar is still one column, and
                   each band reads top to bottom: its name, then the content, then its
                   named lanes on their rows. The content is drawn over the band's first
                   rows, and the chart makes sure nothing with a name is on those rows
                   (see Pad), so it never covers one. The content is the caller's and may
                   be interactive, so this sidebar is not hidden as a whole: only the
                   names are, which the track's rows already say aloud. Each band's
                   content is a group named by its band, so a control in it is announced
                   with the band it belongs to. *@
                <div class="roadmap-timeline__sidebar roadmap-timeline__sidebar--slotted"
                     data-testid="@Suffix("sidebar")">
                    <div class="roadmap-timeline__sidebar-axis" aria-hidden="true"></div>

                    @foreach (var group in PopulatedGroups)
                    {
                        var content = HasContent(group);
                        <div class="@GroupClass(group, content)"
                             style="@GroupStyle(group)"
                             data-testid="@Suffix($"group-{Slug(group.Id)}")">
                            @CollapseToggle(group)
                            @NamesColumn(group, hidden: true)

                            @if (content)
                            {
                                <div class="roadmap-timeline__group-content"
                                     style="@ContentBox(group)"
                                     role="group"
                                     aria-label="@group.Title"
                                     data-testid="@Suffix($"group-{Slug(group.Id)}-content")">
                                    @GroupContent!(group)
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
            @* Hidden as a whole, unless bands can be collapsed: then each band's toggle is
               a control a screen reader has to reach, and only the names are hidden. *@
            <div class="roadmap-timeline__sidebar" aria-hidden="@(Collapsible ? null : "true")">
                <div class="roadmap-timeline__sidebar-axis" aria-hidden="true"></div>

                @foreach (var group in PopulatedGroups)
                {
                    <div class="@GroupClass(group, content: false)"
                         style="@GroupStyle(group)"
                         data-testid="@Suffix($"group-{Slug(group.Id)}")">
                        @CollapseToggle(group)
                        @NamesColumn(group, hidden: Collapsible)
                    </div>
                }
            </div>
            }

            <div @ref="_scroller"
                 class="roadmap-timeline__scroll"
                 role="region"
                 tabindex="0"
                 aria-label="@ScrollLabel">
                <div @ref="_track" class="roadmap-timeline__track" style="width: @Rem(Geometry.TrackWidthRem)" data-roadmap-snaps="@ResizeSnaps">

                    <div class="roadmap-timeline__axis" data-testid="@Suffix("axis")">
                        @foreach (var column in Span.Columns)
                        {
                            @* A day's head blocks or unblocks its date where the host listens
                               (local ADR 0019, §4): a real button, so a click, Enter and Space
                               all press it, named for what pressing it does. It sits in the
                               axis, outside every row the script marks as a slot, and the
                               script ignores a press on any button besides — so pressing a
                               head never starts a drag or adds something. Weeks, months and
                               quarters are not dates and stay plain. *@
                            @if (IsToggle(column))
                            {
                                <button type="button"
                                        class="@ColumnClass(column) roadmap-timeline__quarter--toggle"
                                        style="left: @Rem(Geometry.XFor(column.Start)); width: @Rem(Geometry.WidthFor(column.Start, column.End))"
                                        title="@ColumnTitle(column)"
                                        aria-label="@ToggleName(column)"
                                        aria-current="@(IsCurrent(column) ? "date" : null)"
                                        data-testid="@Suffix($"day-{column.Start.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}")"
                                        @onclick="() => ToggleDay(column.Start)">
                                    @HeadContent(column)
                                </button>
                            }
                            else
                            {
                                <div class="@ColumnClass(column)"
                                     style="left: @Rem(Geometry.XFor(column.Start)); width: @Rem(Geometry.WidthFor(column.Start, column.End))"
                                     title="@ColumnTitle(column)"
                                     aria-current="@(IsCurrent(column) ? "date" : null)">
                                    @HeadContent(column)
                                </div>
                            }

                            @* A begun head's actual hours open the report behind them, where
                               the host listens (local ADR 0019, §6). A layer of its own over
                               the head rather than a button inside it: a day head is already
                               a button, and one button may not hold another. The layer lays
                               out the head's three lines again, the first two unseen, so the
                               hours button sits exactly where the head's hours line is, and
                               only that button takes a press. *@
                            @if (HoursOpenable(column))
                            {
                                var iso = column.Start.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
                                <div class="roadmap-timeline__quarter roadmap-timeline__hours-layer"
                                     style="left: @Rem(Geometry.XFor(column.Start)); width: @Rem(Geometry.WidthFor(column.Start, column.End))">
                                    <span class="roadmap-timeline__quarter-label" aria-hidden="true">@HeadLabel(column)</span>
                                    <span class="roadmap-timeline__quarter-year" aria-hidden="true">@HeadCaption(column)</span>
                                    <button type="button"
                                            class="roadmap-timeline__quarter-hours roadmap-timeline__hours-open"
                                            id="@($"roadmap-hours-{iso}")"
                                            aria-label="@HoursOpenName(column)"
                                            data-testid="@Suffix($"hours-{iso}")"
                                            @onclick="() => OnHoursOpened.InvokeAsync(column.Start)">
                                        @HoursCaption(column)
                                    </button>
                                </div>
                            }
                        }
                    </div>

                    <div class="roadmap-timeline__body" style="height: @Rem(TrackHeight)">

                        <div class="roadmap-timeline__grid" aria-hidden="true">
                            @* This week, shaded down the whole chart behind the bars, so
                               the near-term rows read against it without looking up. *@
                            @if (ThisWeek is { } thisWeek)
                            {
                                <span class="roadmap-timeline__current-week"
                                      style="left: @Rem(Geometry.XFor(thisWeek.Start)); width: @Rem(Geometry.WidthFor(thisWeek.Start, thisWeek.End))"></span>
                            }

                            @* The days off, where the axis is ruled in days, shaded down
                               the chart at their own width: the axis stays time, so a bar
                               still spans the days off inside it (local ADR 0019). A
                               coarser column has no room to show two days of seven. *@
                            @foreach (var day in Span.Columns.Where(IsDayOff))
                            {
                                <span class="roadmap-timeline__weekend"
                                      style="left: @Rem(Geometry.XFor(day.Start)); width: @Rem(Geometry.WidthFor(day.Start, day.End))"></span>
                            }

                            @for (var index = 1; index < Span.Columns.Count; index++)
                            {
                                var column = Span.Columns[index];

                                @* A stronger rule where the ruler changes scale, so the
                                   reader sees where a column stops meaning a week. *@
                                <span class="@(column.Scale != Span.Columns[index - 1].Scale ? "roadmap-timeline__rule roadmap-timeline__rule--scale" : "roadmap-timeline__rule")"
                                      style="left: @Rem(Geometry.XFor(column.Start))"></span>
                            }

                            @* Today is the caller's to state. A component that read
                               the clock would draw a different picture in every test
                               run and in every time zone it was opened in. *@
                            @* A milestone that asked for a line gets one down the whole
                               chart. Drawn in the grid layer with the quarter rules and
                               the today line, because that is what it is: a rule at a
                               date, behind everything and pointer-transparent, so it
                               cannot take a click meant for a bar it crosses. The
                               marker itself still sits on its own row. *@
                            @foreach (var milestone in SpanningMilestones)
                            {
                                <span @key="milestone.Id"
                                      class="roadmap-timeline__milestone-rule"
                                      style="left: @Rem(Geometry.XFor(milestone.On))"
                                      data-testid="@Suffix($"milestone-rule-{Slug(milestone.Id)}")"></span>
                            }

                            @* A milestone filed under some bands rules those bands alone,
                               top of their first row to the bottom of their last. *@
                            @foreach (var rule in BandRules)
                            {
                                <span @key="(rule.Milestone.Id, rule.Group.Id)"
                                      class="roadmap-timeline__milestone-rule roadmap-timeline__milestone-rule--band"
                                      style="left: @Rem(Geometry.XFor(rule.Milestone.On)); top: @Rem(Geometry.RowTop(rule.First)); height: @Rem(Geometry.RowTop(rule.Last + 1) - Geometry.RowTop(rule.First))"
                                      data-testid="@Suffix($"milestone-rule-{Slug(rule.Milestone.Id)}-{Slug(rule.Group.Id)}")"></span>
                            }

                            @if (Today is { } today && Span.Contains(today))
                            {
                                <span class="roadmap-timeline__today" style="left: @Rem(Geometry.XFor(today))"></span>
                            }
                        </div>

                        @* Arrows sit under the bars and take no pointer events: they
                           describe a relationship between two things the reader
                           clicks, and are not themselves clickable. Each is redrawn
                           from where its two ends are right now, which is what keeps
                           one attached to a bar part-way through being dragged. *@
                        @if (Arrows.Count > 0)
                        {
                            <svg class="@LinksClass"
                                 aria-hidden="true"
                                 focusable="false"
                                 viewBox="@ViewBox"
                                 style="width: @Rem(Geometry.TrackWidthRem); height: @Rem(TrackHeight)"
                                 data-testid="@Suffix("links")">
                                <defs>
                                    <marker id="@_arrowheadId" markerWidth="4" markerHeight="4" refX="3.4" refY="2"
                                            markerUnits="strokeWidth" orient="auto">
                                        <path class="roadmap-timeline__arrowhead" d="M 0 0.4 L 3.4 2 L 0 3.6 z" />
                                    </marker>
                                    @* A marker is painted in its own colour, not the line's,
                                       so a traced arrow needs an arrowhead of its own. *@
                                    <marker id="@_tracedArrowheadId" markerWidth="4" markerHeight="4" refX="3.4" refY="2"
                                            markerUnits="strokeWidth" orient="auto">
                                        <path class="roadmap-timeline__arrowhead roadmap-timeline__arrowhead--traced" d="M 0 0.4 L 3.4 2 L 0 3.6 z" />
                                    </marker>
                                </defs>

                                @* Unkeyed on purpose. These paths hold no state and
                                   have no identity to preserve between renders — they
                                   are pure output, rebuilt from the current positions
                                   every time. Keying them on their two ids looked
                                   tidier and was wrong: "a"+"bc" and "ab"+"c" are the
                                   same string, and a duplicate key throws on the
                                   second render rather than the first, so the crash
                                   arrives on the reader's first drag. *@
                                @* Traced arrows last: SVG paints in document order, so
                                   that is what lifts them over the ones they cross. *@
                                @foreach (var arrow in Arrows.OrderBy(Traced))
                                {
                                    @if (Traced(arrow))
                                    {
                                        <path class="roadmap-timeline__link roadmap-timeline__link--traced" d="@arrow.Path" marker-end="@TracedArrowheadRef" />
                                    }
                                    else
                                    {
                                        <path class="roadmap-timeline__link" d="@arrow.Path" marker-end="@ArrowheadRef" />
                                    }
                                }
                            </svg>
                        }

                        @foreach (var placed in Rows)
                        {
                            @if (placed.Padding)
                            {
                                @* Room for a band's sidebar content, nothing more: no role,
                                   no name, nothing to press. A bar dragged into it lands on
                                   the band's last lane — see Landing. *@
                                <div @key="placed.Row.Id"
                                     class="roadmap-timeline__row roadmap-timeline__row--padding"
                                     style="top: @Rem(Geometry.RowTop(placed.Index)); height: @Rem(Geometry.RowHeightRem); @GroupStyle(placed.Group)"
                                     aria-hidden="true"
                                     data-roadmap-slot="@SlotRowId(PaddingLane(placed))"
                                     data-testid="@Suffix($"padding-{Slug(placed.Row.Id)}")"></div>
                                continue;
                            }

                            @if (placed is { Step: { } step, Owner: { } owner, Span: { } span })
                            {
                                @* A step row: one segment, placed as a proportion of its
                                   bar's window. Not a group of controls — there is
                                   nothing on it to press — so the segment is an image
                                   with a name, and the name says it is a share rather
                                   than a date. *@
                                <div @key="placed.Row.Id"
                                     class="roadmap-timeline__row roadmap-timeline__row--step"
                                     style="top: @Rem(Geometry.RowTop(placed.Index)); height: @Rem(Geometry.RowHeightRem); @GroupStyle(placed.Group)"
                                     role="group"
                                     aria-label="@Context(placed)"
                                     data-testid="@Suffix($"step-row-{Slug(owner.Id)}-{placed.StepIndex}")">
                                    <span class="@StepClass(step)"
                                          style="left: @Rem(Geometry.XFor(owner.Start) + span.Offset); width: @Rem(span.Width)"
                                          role="img"
                                          aria-label="@Spoken(step, span)"
                                          title="@Spoken(step, span)"
                                          data-roadmap-step-share="@RoadmapGeometry.N(span.Share)"
                                          data-testid="@Suffix($"step-{Slug(owner.Id)}-{Slug(step.Id)}")">
                                        @if (!step.IsEstimated)
                                        {
                                            <span class="roadmap-step__marker" aria-hidden="true">?</span>
                                        }
                                        <span class="roadmap-step__title" aria-hidden="true">@step.Title</span>
                                    </span>
                                </div>
                                continue;
                            }

                            <div @key="placed.Row.Id"
                                 class="@(placed.Row.Kind == RoadmapRowKind.Milestones ? "roadmap-timeline__row roadmap-timeline__row--milestones" : "roadmap-timeline__row")"
                                 style="top: @Rem(Geometry.RowTop(placed.Index)); height: @Rem(Geometry.RowHeightRem); @GroupStyle(placed.Group)"
                                 role="group"
                                 aria-label="@Context(placed)"
                                 data-roadmap-row="@placed.Row.Id"
                                 data-roadmap-slot="@SlotRowId(placed.Row)"
                                 data-testid="@Suffix($"row-{Slug(placed.Row.Id)}")">

                                @foreach (var bar in BarsOn(placed.Row.Id))
                                {
                                    <RoadmapTimelineBar @key="bar.Id"
                                                        Bar="bar"
                                                        Geometry="Geometry"
                                                        Preview="@PreviewFor(bar.Id)"
                                                        DependencyCount="@DependencyCount(bar.Id)"
                                                        Selected="@Is(SelectedId, bar.Id)"
                                                        Related="@Related(bar.Id)"
                                                        OnTrace="Trace"
                                                        OnUntrace="Untrace"
                                                        Grabbed="@Is(_grabbedId, bar.Id)"
                                                        Dragging="@Is(_dragId, bar.Id)"
                                                        Invalid="@(Refused && Is(ActiveId, bar.Id))"
                                                        AllowResize="@AllowResize"
                                                        Linkable="@OnLinkCreated.HasDelegate"
                                                        ContextLabel="@Context(placed)"
                                                        DateLabel="@DateLabel"
                                                        DescribedById="@_helpId"
                                                        PreventDefaultKeys="@Is(_grabbedId, bar.Id)"
                                                        ButtonId="@BarButtonId(bar.Id)"
                                                        Expanded="@IsExpanded(bar)"
                                                        Expandable="@ShowSteps"
                                                        OnToggle="Toggle"
                                                        ToggleId="@ToggleButtonId(bar.Id)"
                                                        OnActivate="Activate"
                                                        OnKeyDown="args => Key(bar, args)"
                                                        TestId="@Suffix($"bar-{Slug(bar.Id)}")" />
                                }

                                @foreach (var milestone in MilestonesOn(placed.Row.Id))
                                {
                                    <span @key="milestone.Id"
                                          class="@(Related(milestone.Id) ? MilestoneClass(milestone) + " roadmap-milestone--related" : MilestoneClass(milestone))"
                                          style="left: @Rem(Geometry.XFor(milestone.On))"
                                          data-roadmap-node="@milestone.Id"
                                          @onpointerenter="() => Trace(milestone.Id)"
                                          @onpointerleave="() => Untrace(milestone.Id)"
                                          @onfocusin="() => Trace(milestone.Id)"
                                          @onfocusout="() => Untrace(milestone.Id)">
                                        <button type="button"
                                                class="roadmap-milestone__marker"
                                                aria-current="@(Is(SelectedId, milestone.Id) ? "true" : null)"
                                                title="@Tooltip(milestone)"
                                                data-testid="@Suffix($"milestone-{Slug(milestone.Id)}")"
                                                @onclick="() => Activate(milestone.Id)">
                                            <span class="roadmap-milestone__glyph" aria-hidden="true">@Glyph(milestone.Marker)</span>
                                            <span class="sr-only">@Spoken(milestone, placed)</span>
                                        </button>
                                        <span class="roadmap-milestone__label" aria-hidden="true">@milestone.Title</span>
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</section>

@code {
    // A page may hold more than one timeline, so every id that is pointed at
    // from elsewhere has to be unique per instance, or the second one's bars
    // describe themselves using the first one's help text.
    private readonly string _instance = Guid.NewGuid().ToString("N");

    private ElementReference _track;
    private ElementReference _scroller;
    private DotNetObjectReference<RoadmapTimeline>? _self;
    private bool _attached;

    // How wide the scroller is on screen, in rem, once the page has measured it —
    // null until then, and for good where there is no script to measure it, which
    // leaves the chart at its natural width rather than guessing a screen.
    private double? _viewportRem;

    // Whether the scroller has been brought to this week yet. Once only: after that
    // where the reader has scrolled to is theirs.
    private bool _scrolledToNow;

    /// <summary>Which bar a pointer has hold of, and which one a keyboard has
    /// picked up. Two fields rather than one because they are drawn
    /// differently: a grabbed bar stays lifted between keypresses, a dragged
    /// one is under the pointer only while the button is down.</summary>
    private string? _dragId;
    private string? _grabbedId;

    // Whether the next click is the tail of a pointer drag rather than a click. Set
    // when a drag commits having moved something, and cleared either by that click or
    // by the next gesture starting — so a drag whose click never arrives (released
    // outside the bar, say) cannot leave this armed for somebody's next real click.
    private bool _clickEndsADrag;

    // A bar whose button the next render replaces, and which should have the focus
    // ring once it has. A bar is drawn inside its row's element, so a bar that
    // changes row is a new button and the old one goes, focus and all, to <body>.
    // Asked for after the render rather than at the keypress, because before it
    // the button being named is the one about to be thrown away.
    private string? _refocusId;

    private RoadmapDrag _kind = RoadmapDrag.Move;
    private int _steps;
    private int _rowOffset;
    private string? _announcement;

    private readonly Dictionary<string, IReadOnlyList<string>> _filters = new(StringComparer.Ordinal);

    // Which bars are showing their steps. By bar id, so it survives the host
    // rebuilding every bar after a save — the same work is still the same work.
    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);

    // Which bands are folded to one lane. By group id, for the same reason.
    private readonly HashSet<string> _collapsed = new(StringComparer.Ordinal);

    // Whether the row offset in flight was counted by a pointer, over every drawn
    // row, or by the keyboard, over the rows a bar can land on. See Landing.
    private bool _pointerRows;

    // Worked out once per change rather than once per read. The chart asks
    // where every row is, which bars survive the filter and where every arrow
    // lands many times over in a single render, and each of those answers is
    // the same for the whole pass.
    private IReadOnlyList<PlacedRow>? _rows;
    private IReadOnlyList<RoadmapBar>? _visible;
    private IReadOnlyList<RoadmapArrow>? _arrows;
    private Dictionary<string, string>? _foldedRows;
    private RoadmapWindow? _span;
    private double? _stretch;

    [Parameter, EditorRequired]
    public IReadOnlyList<RoadmapGroup> Groups { get; set; } = [];

    [Parameter]
    public IReadOnlyList<RoadmapBar> Bars { get; set; } = [];

    [Parameter]
    public IReadOnlyList<RoadmapMilestone> Milestones { get; set; } = [];

    /// <summary>The dependencies drawn between bars and milestones.</summary>
    [Parameter]
    public IReadOnlyList<RoadmapLink> Links { get; set; } = [];

    /// <summary>The stretch of time drawn. Left unset, it is the narrowest run
    /// of whole quarters that holds everything the plan contains.</summary>
    [Parameter]
    public RoadmapWindow? Window { get; set; }

    /// <summary>
    /// Whether the axis is ruled coarser the further it is from <see cref="Today"/>:
    /// weeks for the next three months, months for the three after, quarters beyond.
    /// See <see cref="RoadmapWindow.Graduated"/>. Ignored when a <see cref="Window"/>
    /// is set, and off by default so a chart with no "today" keeps its plain quarters.
    /// </summary>
    [Parameter]
    public bool Graduated { get; set; }

    /// <summary>Where to draw the "now" line, if anywhere. The caller's,
    /// because a component that read the clock could not be tested twice.</summary>
    [Parameter]
    public DateOnly? Today { get; set; }

    /// <summary>
    /// The hours planned on each date, for the heads to show and the dates not worked
    /// to be shaded (local ADR 0019). A date at zero is not worked. Per date rather than
    /// per weekday, because a person blocks a single Friday or unblocks a single
    /// Saturday. Left unset, the axis says nothing about a working week. The caller's,
    /// as a plain function, because this library knows no working week of its own.
    /// </summary>
    [Parameter]
    public Func<DateOnly, double>? PlannedHoursOn { get; set; }

    /// <summary>
    /// Whether a date differs from its weekday's pattern — blocked or unblocked on its
    /// own — so its head carries a marker and its tooltip says which. Left unset, no
    /// head is marked.
    /// </summary>
    [Parameter]
    public Func<DateOnly, bool>? IsOverridden { get; set; }

    /// <summary>
    /// The hours actually worked on each date that has begun (local ADR 0019, §6). A day
    /// or week head whose column starts on or before <see cref="Today"/> shows these in
    /// place of its planned hours — "6.2h", today counting the hours so far — and never
    /// both. A date missing from the map counts none, so a begun worked day nobody worked
    /// reads "0h".
    /// <para>
    /// Null when the host cannot state them, or could not read them: a begun head then
    /// shows no figure at all, because a planned figure there would be read as hours
    /// worked. Heads still to come show their planned hours either way.
    /// </para>
    /// </summary>
    [Parameter]
    public IReadOnlyDictionary<DateOnly, double>? ActualHoursByDate { get; set; }

    /// <summary>
    /// Whether the day and week heads carry their hours line — the host's "Hours" switch
    /// (local ADR 0019, §4). On by default. Off, no head shows an hours figure and the
    /// axis loses the line, while the days off stay shaded and every column keeps its
    /// width. Has no effect without <see cref="PlannedHoursOn"/>.
    /// </summary>
    [Parameter]
    public bool ShowHours { get; set; } = true;

    /// <summary>
    /// Raised with a date when its day head is pressed. With a listener, every day
    /// column's head is a button that offers to block a worked date and unblock one not
    /// worked; whether it does, and what moves, is the host's.
    /// </summary>
    [Parameter]
    public EventCallback<DateOnly> OnDayToggled { get; set; }

    /// <summary>
    /// Raised with a column's first date when the actual hours on its head are pressed,
    /// so the host can show the working stretches they add up from (local ADR 0019, §6).
    /// With a listener, the hours of every begun day or week head that shows them are a
    /// button of their own, beside the day head's own button rather than inside it.
    /// </summary>
    [Parameter]
    public EventCallback<DateOnly> OnHoursOpened { get; set; }

    /// <summary>Which day a week starts on here, and so where a drag lands.</summary>
    [Parameter]
    public DayOfWeek WeekStart { get; set; } = DayOfWeek.Monday;

    /// <summary>How wide one quarter is drawn, in rem. The zoom control: every
    /// horizontal measurement on the chart is derived from it.</summary>
    [Parameter]
    public double QuarterWidth { get; set; } = 16;

    /// <summary>
    /// Whether the chart stretches to fill the width it is given. On, every column
    /// is widened by the same factor until the stretch from this week to the end —
    /// or the whole window, with no today on it — is at least as wide as the
    /// scroller, so a short plan never leaves the right of the chart empty.
    /// <see cref="QuarterWidth"/> stays the least a quarter is drawn; the stretch
    /// only ever widens.
    /// </summary>
    [Parameter]
    public bool FillWidth { get; set; } = true;

    /// <summary>
    /// How tall one row is drawn, in rem. The vertical counterpart to
    /// <see cref="QuarterWidth"/>, and for the same reason: only the caller knows how
    /// much of the screen this chart is allowed.
    /// <para>
    /// It is a parameter rather than a constant because the two places this chart is
    /// drawn want different answers. On a page there is room to breathe. In a band
    /// capped at a quarter of the window, every rem of row height is a row that has
    /// to be scrolled to instead of seen, and a plan you have to scroll is a plan you
    /// are reading a piece at a time.
    /// </para>
    /// </summary>
    [Parameter]
    public double RowHeight { get; set; } = 2.75;

    /// <summary>How tall a bar is drawn inside its row, in rem. Kept separate from
    /// <see cref="RowHeight"/> rather than derived from it, because the gap between
    /// two stacked bars is what makes them read as two, and how much of that a
    /// shorter row can spare is a judgement about the design rather than
    /// arithmetic.</summary>
    [Parameter]
    public double BarHeight { get; set; } = 1.5;

    /// <summary>Whether a bar can be moved in time at all.</summary>
    [Parameter]
    public bool AllowMove { get; set; } = true;

    /// <summary>Whether a bar's edges can be pulled to change its dates.</summary>
    [Parameter]
    public bool AllowResize { get; set; } = true;

    /// <summary>Whether a move may also change which row a bar is on. Off for a
    /// plan whose rows are decided elsewhere — an owner assigned by a system of
    /// record is not something to reassign by dropping a rectangle on it.</summary>
    [Parameter]
    public bool AllowRowChange { get; set; } = true;

    /// <summary>Whether the filter bar is offered. It appears only when the
    /// bars carry facets to filter on.</summary>
    [Parameter]
    public bool ShowFilters { get; set; } = true;

    /// <summary>Whether a bar with steps offers to expand into them. Off, a bar keeps
    /// its progress fill and its figures but never opens into rows of its work — for a
    /// host that reads the plan at its own level and leaves the work to the list.</summary>
    [Parameter]
    public bool ShowSteps { get; set; } = true;

    /// <summary>
    /// Whether a band with bars offers to fold into one lane: a toggle beside its name
    /// that draws every bar of the band's rows on a single row, overlapping where their
    /// dates do, and opens it again. A way of looking, like a bar's steps — the rows the
    /// caller handed over are unchanged, a bar keeps the row it reports, and one dropped
    /// on a folded band lands on the band's first lane. Folded, a band has no room for
    /// its <see cref="GroupContent"/>, so the content is not drawn.
    /// </summary>
    [Parameter]
    public bool Collapsible { get; set; }

    /// <summary>
    /// Something of the host's under a band's name in the sidebar — a control that
    /// belongs to the band rather than to any one row of it. Drawn for a group whose
    /// <see cref="RoadmapGroup.ContentRows"/> is above zero, and for no other.
    /// <para>
    /// The sidebar stays one column, at its own width. A band with content reads top to
    /// bottom: its name, the content over its first
    /// <see cref="RoadmapGroup.ContentRows"/> rows, then its named lanes. Nothing with a
    /// name is ever under the content: empty rows are put in before the band's first
    /// named row until it starts at <see cref="RoadmapGroup.ContentRows"/> — after the
    /// band's unnamed lane rows, which have nothing to cover, or at the top when it has
    /// none — in the sidebar and in the track alike, so the two stay the same height in
    /// the same order. An empty row takes no drop of its own and the keyboard steps over
    /// it.
    /// </para>
    /// <para>
    /// The content is announced — it is the host's, and a host puts controls there —
    /// inside a group named for its band. What stays hidden from a screen reader is
    /// the names beside it, which every row in the track already says aloud.
    /// </para>
    /// </summary>
    [Parameter]
    public RenderFragment<RoadmapGroup>? GroupContent { get; set; }

    [Parameter]
    public string? SelectedId { get; set; }

    [Parameter]
    public EventCallback<string> OnBarSelected { get; set; }

    /// <summary>Where a bar ended up. Raised once, when the gesture settles,
    /// and never before: see RoadmapChange for why applying it is the host's.</summary>
    [Parameter]
    public EventCallback<RoadmapChange> OnBarChanged { get; set; }

    /// <summary>
    /// A dependency the reader drew: the handle past one bar's end dragged onto
    /// another bar or a milestone, which is to wait for it. Proposed, not applied —
    /// whether the plan accepts it, a cycle for one, is the host's to answer, and the
    /// arrow appears when the host hands the link back in <see cref="Links"/>.
    /// <para>
    /// Left unset, no bar offers the handle.
    /// </para>
    /// </summary>
    [Parameter]
    public EventCallback<RoadmapLink> OnLinkCreated { get; set; }

    /// <summary>
    /// An empty place on a row the reader double-clicked or dragged across, to put
    /// something there: the row and the week, and for a drag the weeks it covered. Proposed, not created — what to add, and whether it may
    /// go there, is the host's, and it appears when the host hands it back.
    /// <para>
    /// A pointer shortcut and nothing more. Left unset, a double-click on a row does
    /// nothing, and a host that sets it still owes a keyboard way to add — the button
    /// that adds without saying where.
    /// </para>
    /// </summary>
    [Parameter]
    public EventCallback<RoadmapSlot> OnSlotActivated { get; set; }

    /// <summary>What is being filtered on now, for a host that wants to mirror
    /// it into a URL. The narrowing itself is done here — which bars are on
    /// screen is a way of looking at the plan, not a change to it.</summary>
    [Parameter]
    public EventCallback<IReadOnlyDictionary<string, IReadOnlyList<string>>> OnFilterChanged { get; set; }

    [Parameter]
    public string Title { get; set; } = "Roadmap";

    /// <summary>
    /// The heading, written by the caller instead of built from
    /// <see cref="Title"/> and <see cref="HeadingLevel"/>.
    /// <para>
    /// It exists for a host that already has a heading for this chart and would
    /// otherwise draw a second one underneath it. Handing the one it has to the
    /// chart puts it on the same row as the filter controls — which is the row the
    /// header already lays out that way — instead of stacking two headings and a
    /// filter bar down the block axis.
    /// </para>
    /// <para>
    /// A caller that supplies this owns the accessible name too: the generated
    /// heading is what <c>aria-labelledby</c> points at, so set
    /// <see cref="LabelledBy"/> to the id of whatever heading arrives here.
    /// </para>
    /// </summary>
    [Parameter]
    public RenderFragment? TitleContent { get; set; }

    /// <summary>The id of the element naming this chart, for a caller supplying its
    /// own <see cref="TitleContent"/>. Left unset, the chart names itself from the
    /// heading it generated.</summary>
    [Parameter]
    public string? LabelledBy { get; set; }

    [Parameter]
    public string? Description { get; set; }

    /// <summary>Which heading level the title is, so a page can nest one of
    /// these without breaking its outline.</summary>
    [Parameter]
    public int HeadingLevel { get; set; } = 2;

    [Parameter]
    public string AriaLabel { get; set; } = "Roadmap timeline";

    [Parameter]
    public string EmptyMessage { get; set; } = "No roadmap yet. Add a group with a row in it.";

    /// <summary>How a date is written, wherever one is read out. The host's:
    /// what language it is said in is not this library's to decide.</summary>
    [Parameter]
    public Func<DateOnly, string> DateLabel { get; set; } =
        date => date.ToString("d MMM yyyy", CultureInfo.CurrentCulture);

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    private string _headingId => "roadmap-timeline-title-" + _instance;

    private string _helpId => "roadmap-timeline-help-" + _instance;

    private string _arrowheadId => "roadmap-timeline-arrowhead-" + _instance;

    private IReadOnlyList<RoadmapGroup> GroupList => Groups ?? [];

    private IReadOnlyList<RoadmapBar> BarList => Bars ?? [];

    private IReadOnlyList<RoadmapMilestone> MilestoneList => Milestones ?? [];

    private IReadOnlyList<RoadmapLink> LinkList => Links ?? [];

    /// <summary>A group with no rows takes up no height, so drawing its label
    /// would leave a heading pointing at nothing.</summary>
    private IEnumerable<RoadmapGroup> PopulatedGroups => GroupList.Where(group => group.RowList.Count > 0);

    /// <summary>
    /// Every row, flattened and numbered, with an expanded bar's steps opened
    /// beneath the row the bar sits on. The number is the row's vertical position,
    /// and it is what a pointer drag up or down counts in.
    /// <para>
    /// A step row follows the bar's own row rather than wherever a drag in flight is
    /// taking it: the rows are what a drag is measured against, so they cannot also
    /// move with it.
    /// </para>
    /// </summary>
    private IReadOnlyList<PlacedRow> Rows => _rows ??= PlaceRows();

    private List<PlacedRow> PlaceRows()
    {
        var placed = new List<PlacedRow>();

        foreach (var group in PopulatedGroups)
        {
            if (IsCollapsed(group))
            {
                placed.Add(new PlacedRow(group, new RoadmapRow(FoldedRowId(group), string.Empty), placed.Count, Folded: true));
                continue;
            }

            var rows = new List<PlacedRow>();
            PlaceGroup(group, rows);

            if (HasContent(group)) Pad(group, rows);

            foreach (var row in rows) placed.Add(row with { Index = placed.Count });
        }

        return placed;
    }

    /// <summary>
    /// Makes room for a band's content, which is drawn over the band's first rows
    /// under its name. Nothing with a name may sit under it, so every row before the
    /// first one that shows a name — a named lane, a step, a milestones row — is
    /// counted, and empty rows are put in before that one until it starts at
    /// <see cref="RoadmapGroup.ContentRows"/> or lower. The band's unnamed lane rows
    /// can sit beside the content, since there is nothing on them to cover; a band
    /// with none gets all of its room at the top, and one with no named row at all
    /// gets it at the end.
    /// </summary>
    private static void Pad(RoadmapGroup group, List<PlacedRow> rows)
    {
        var named = rows.FindIndex(ShowsAName);
        if (named < 0) named = rows.Count;

        var room = Math.Max(0, group.ContentRows - named);

        rows.InsertRange(named, Enumerable.Range(0, room).Select(index => new PlacedRow(
            group,
            new RoadmapRow($"{group.Id}::padding::{index}", string.Empty),
            0,
            Padding: true)));
    }

    /// <summary>Whether a row puts a name in the sidebar.</summary>
    private static bool ShowsAName(PlacedRow row) =>
        row.Step is not null
        || row.Row.Kind != RoadmapRowKind.Bars
        || !string.IsNullOrWhiteSpace(row.Row.Title);

    /// <summary>One group's rows, each followed by the steps of any bar on it that
    /// is open.</summary>
    private void PlaceGroup(RoadmapGroup group, List<PlacedRow> placed)
    {
        foreach (var row in group.RowList)
        {
            placed.Add(new PlacedRow(group, row, placed.Count));

            if (row.Kind != RoadmapRowKind.Bars) continue;

            foreach (var bar in VisibleBars.Where(bar => Is(bar.RowId, row.Id) && IsExpanded(bar)))
            {
                var spans = RoadmapStepLayout.Lay(bar.StepList, Geometry.WidthFor(bar.Start, bar.End));

                for (var index = 0; index < bar.StepList.Count; index++)
                {
                    var step = bar.StepList[index];

                    placed.Add(new PlacedRow(
                        group,
                        new RoadmapRow($"{bar.Id}::step::{step.Id}", step.Title),
                        placed.Count,
                        bar,
                        step,
                        index,
                        spans[index]));
                }
            }
        }
    }

    /// <summary>The rows a bar can be dropped on, in order — the step rows are
    /// drawings of a bar's insides, and a padding row is room for a band's sidebar
    /// content, so neither is a place to put one.</summary>
    private IReadOnlyList<PlacedRow> LandingRows => [.. Rows.Where(row => row.Step is null && !row.Padding)];

    /// <summary>Whether <paramref name="group"/> has sidebar content drawn for it.</summary>
    private bool HasContent(RoadmapGroup group) => GroupContent is not null && group.ContentRows > 0 && !IsCollapsed(group);

    // --- Folding a band ----------------------------------------------------

    /// <summary>Whether <paramref name="group"/> offers to fold: only on a chart that
    /// opts in, and only for a band with bars — a row of milestones is already one.</summary>
    private bool CanCollapse(RoadmapGroup group) =>
        Collapsible && group.RowList.Any(row => row.Kind == RoadmapRowKind.Bars);

    private bool IsCollapsed(RoadmapGroup group) => CanCollapse(group) && _collapsed.Contains(group.Id);

    /// <summary>The one row a folded band is drawn as. Bracketed so it cannot be a
    /// caller's lane: a host never hears it, because <see cref="FoldedLane"/> answers
    /// for it wherever a row is reported.</summary>
    private static string FoldedRowId(RoadmapGroup group) => $"{group.Id}::(collapsed)";

    /// <summary>The lane a folded band stands for when something is put on it: its
    /// first row that takes bars.</summary>
    private static RoadmapRow? FoldedLane(RoadmapGroup group) =>
        group.RowList.FirstOrDefault(row => row.Kind == RoadmapRowKind.Bars);

    /// <summary>The row <paramref name="rowId"/> is drawn on: its band's one row when
    /// the band is folded, and itself otherwise.</summary>
    private string DrawnRow(string rowId) =>
        (_foldedRows ??= FoldedRows()).GetValueOrDefault(rowId, rowId);

    private Dictionary<string, string> FoldedRows()
    {
        var folded = new Dictionary<string, string>(StringComparer.Ordinal);

        foreach (var group in PopulatedGroups.Where(IsCollapsed))
        {
            foreach (var row in group.RowList) folded.TryAdd(row.Id, FoldedRowId(group));
        }

        return folded;
    }

    private string GroupClass(RoadmapGroup group, bool content) => string.Join(' ', new[]
    {
        "roadmap-timeline__group",
        content ? "roadmap-timeline__group--slotted" : null,
        CanCollapse(group) ? "roadmap-timeline__group--collapsible" : null
    }.Where(part => part is not null));

    private RenderFragment CollapseToggle(RoadmapGroup group) => __builder =>
    {
        if (!CanCollapse(group)) return;

        var folded = IsCollapsed(group);
        var label = folded ? $"Expand {group.Title} into its lanes" : $"Collapse {group.Title} to one lane";

        <button type="button"
                id="@CollapseButtonId(group.Id)"
                class="roadmap-timeline__group-toggle"
                aria-expanded="@(folded ? "false" : "true")"
                aria-label="@label"
                title="@label"
                data-testid="@Suffix($"group-{Slug(group.Id)}-collapse")"
                @onclick="() => Fold(group)">
            <span aria-hidden="true">@(folded ? "▸" : "▾")</span>
        </button>
    };

    /// <summary>A band folded or opened, said aloud, and the focus put back on its
    /// toggle — the sidebar around it has just been rebuilt.</summary>
    private async Task Fold(RoadmapGroup group)
    {
        if (!CanCollapse(group)) return;

        if (_collapsed.Remove(group.Id))
        {
            Announce($"{group.Title} expanded into its lanes.");
        }
        else
        {
            _collapsed.Add(group.Id);
            Announce($"{group.Title} collapsed to one lane.");
        }

        Invalidate();
        StateHasChanged();

        try
        {
            await Js.InvokeVoidAsync("backlogFocus", CollapseButtonId(group.Id));
        }
        catch (JSException)
        {
        }
    }

    private string CollapseButtonId(string groupId) => $"roadmap-group-toggle-{_instance}-{Slug(groupId)}";

    /// <summary>The two-column sidebar, drawn only when some band has content — so a
    /// chart with none renders exactly as it did before the slot existed.</summary>
    private bool Slotted => GroupContent is not null && PopulatedGroups.Any(HasContent);

    /// <summary>
    /// A band's names: every placed row of the group, step rows and padding rows
    /// included, so the sidebar and the track stay the same height in the same order.
    /// The group is named once, across its first row; a row below it is named only
    /// where its name changes, so a lane stacked over three rows reads as one lane.
    /// <para>
    /// One fragment for both sidebars, so the names column of a sidebar with band
    /// content is the plain sidebar's column and not a second copy of it. Hidden on
    /// its own element only in the sidebar with content, where the whole sidebar is
    /// not hidden; the plain sidebar is hidden as a whole, as it always was.
    /// </para>
    /// </summary>
    private RenderFragment NamesColumn(RoadmapGroup group, bool hidden) => __builder =>
    {
        string? previous = null;
        var first = true;

        <div class="roadmap-timeline__group-rows" aria-hidden="@(hidden ? "true" : null)">
            @foreach (var placed in Rows.Where(row => ReferenceEquals(row.Group, group)))
            {
                var lane = placed.Step is null && !placed.Padding && placed.Row.Title != previous ? placed.Row.Title : null;
                <p class="@RowNameClass(placed)"
                   style="height: @Rem(Geometry.RowHeightRem)"
                   title="@(placed.Padding ? null : Context(placed))">
                    @if (first && !group.Unnamed)
                    {
                        @* The sidebar is narrow, so a long name is cut short with an
                           ellipsis; the title carries it whole. *@
                        <span class="roadmap-timeline__group-name" title="@group.Title">@group.Title</span>
                    }
                    @if (placed.Step is not null)
                    {
                        @placed.Row.Title
                    }
                    else if (!string.IsNullOrWhiteSpace(lane))
                    {
                        <span class="roadmap-timeline__lane-name">@lane</span>
                    }
                </p>
                if (placed.Step is null && !placed.Padding) previous = placed.Row.Title;
                first = false;
            }
        </div>
    };

    /// <summary>How far down a band's content starts — past the band's name, which is
    /// centred on the band's first row — in rem.</summary>
    private double ContentTop => Geometry.RowHeightRem / 2 + ContentGapUnderName;

    /// <summary>Room under the band's name before the content starts: half the name's
    /// line, so the content starts clear of it.</summary>
    private const double ContentGapUnderName = 0.75;

    /// <summary>Where a band's content is drawn: from under its name to the end of the
    /// rows the band asked for, and no further, so it never reaches a named row.</summary>
    private string ContentBox(RoadmapGroup group) =>
        $"top: {Rem(ContentTop)}; height: {Rem(Math.Max(0, group.ContentRows * Geometry.RowHeightRem - ContentTop))}";

    private static string RowNameClass(PlacedRow placed) =>
        placed.Step is not null ? "roadmap-timeline__row-name roadmap-timeline__row-name--step"
        : placed.Padding ? "roadmap-timeline__row-name roadmap-timeline__row-name--padding"
        : "roadmap-timeline__row-name";

    /// <summary>The lane a bar dragged into a band's padding lands on: the nearest
    /// row of the same band that takes bars, looking up first — the lane drawn above
    /// the padding — and then down. Null for a band with no such row, where the bar
    /// stays where it was.</summary>
    private RoadmapRow? PaddingLane(PlacedRow padding)
    {
        bool Lands(PlacedRow row) =>
            ReferenceEquals(row.Group, padding.Group)
            && row.Step is null
            && !row.Padding
            && row.Row.Kind == RoadmapRowKind.Bars;

        return Rows.Take(padding.Index).LastOrDefault(Lands)?.Row
            ?? Rows.Skip(padding.Index + 1).FirstOrDefault(Lands)?.Row;
    }

    private bool IsExpanded(RoadmapBar bar) => ShowSteps && bar.HasSteps && _expanded.Contains(bar.Id);

    /// <summary>
    /// The window being drawn: the caller's, or the narrowest one that holds
    /// everything. Every date in the plan is offered to it, milestones
    /// included, so a launch three quarters past the last bar is still on the
    /// chart.
    /// </summary>
    private RoadmapWindow Span => _span ??= Window ?? (Graduated
        ? RoadmapWindow.Graduated(PlanDates, Today ?? DateOnly.FromDateTime(DateTime.Now), WeekStart)
        : RoadmapWindow.Covering(PlanDates, Today ?? DateOnly.FromDateTime(DateTime.Now)));

    private IEnumerable<DateOnly> PlanDates =>
        BarList.SelectMany(bar => new[] { bar.Start, bar.End })
            .Concat(MilestoneList.Select(milestone => milestone.On));

    private RoadmapGeometry Geometry => new(Span, QuarterWidth * Stretch, RowHeight, BarHeight);

    /// <summary>Where the part of the chart that has to fill the screen begins: the
    /// week before this one when it is on the chart — so the days either side of
    /// today are what it opens on, and older history to the left is scrolled to
    /// rather than squeezed in — and the window's start otherwise.</summary>
    private DateOnly FillFrom
    {
        get
        {
            if (Today is not { } today || !Span.Contains(today)) return Span.Start;

            var week = RoadmapWindow.StartOfWeek(today, WeekStart).AddDays(Span.IsGraduated ? -7 * RoadmapWindow.GraduatedDayWeeks : 0);

            return week < Span.Start ? Span.Start : week;
        }
    }

    /// <summary>
    /// How much wider than its natural width the chart is drawn: enough that the
    /// stretch from <see cref="FillFrom"/> to the end fills the scroller, and never
    /// less than one. Every column widens by the same factor, so the stretch from
    /// there to the end widens by it too — one division, not a search.
    /// </summary>
    private double Stretch => _stretch ??= MeasureStretch();

    private double MeasureStretch()
    {
        if (!FillWidth || _viewportRem is not { } viewport) return 1;

        var natural = new RoadmapGeometry(Span, QuarterWidth, RowHeight, BarHeight);
        var shown = natural.TrackWidthRem - natural.XFor(FillFrom);

        return shown <= 0 ? 1 : Math.Max(1, viewport / shown);
    }

    private double TrackHeight => Geometry.TrackHeightRem(Rows.Count);

    /// <summary>
    /// The two heights the stylesheet has to agree with the geometry about: the
    /// pitch of a row, and how tall the axis is.
    /// <para>
    /// Published rather than written down twice. The row banding, the sidebar
    /// labels and the track rows all have to line up to the pixel, and a
    /// stylesheet holding its own copy of 2.75rem is a stylesheet that will
    /// disagree with this file the first time either is tuned.
    /// </para>
    /// </summary>
    private string Metrics =>
        $"--roadmap-row-height: {Rem(Geometry.RowHeightRem)}; --roadmap-bar-height: {Rem(Geometry.BarHeightRem)}";

    private string ViewBox =>
        $"0 0 {RoadmapGeometry.N(Geometry.TrackWidthRem)} {RoadmapGeometry.N(TrackHeight)}";

    private string ArrowheadRef => $"url(#{_arrowheadId})";

    private string _tracedArrowheadId => "roadmap-timeline-arrowhead-traced-" + _instance;

    private string TracedArrowheadRef => $"url(#{_tracedArrowheadId})";

    private string ScrollLabel => $"{AriaLabel}, {Span.Start.Year} to {Span.End.Year}";

    private RenderFragment Heading => builder =>
    {
        builder.OpenElement(0, "h" + Math.Clamp(HeadingLevel, 1, 6).ToString(CultureInfo.InvariantCulture));
        builder.AddAttribute(1, "id", _headingId);
        builder.AddAttribute(2, "class", "roadmap-timeline__title");
        builder.AddContent(3, Title);
        builder.CloseElement();
    };

    /// <summary>Which bar the current gesture is about, whichever kind of
    /// gesture it is.</summary>
    private string? ActiveId => _dragId ?? _grabbedId;

    protected override void OnParametersSet() => Invalidate();

    /// <summary>Everything derived, forgotten. Called wherever the plan or the
    /// gesture changes — which is the whole list of places any of it can.</summary>
    private void Invalidate()
    {
        _rows = null;
        _visible = null;
        _arrows = null;
        _foldedRows = null;
        _span = null;
        _stretch = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_refocusId is { } refocus)
        {
            _refocusId = null;

            try
            {
                await Js.InvokeVoidAsync("backlogFocus", BarButtonId(refocus));
            }
            catch (JSException)
            {
            }
        }

        // Brought to this week once the fill is known, so the chart opens on now with
        // what is finished to the left, a scroll away, rather than at its first month.
        if (_attached && !_scrolledToNow && _viewportRem is not null && Rows.Count > 0)
        {
            _scrolledToNow = true;

            try
            {
                await Js.InvokeVoidAsync("backlogRoadmapTimeline.scrollTo", _instance, Geometry.XFor(FillFrom));
            }
            catch (JSException)
            {
            }
        }

        // Attached once the track exists, and only then. A plan with no rows
        // renders no track at all, so the reference would be to nothing.
        if (_attached || Rows.Count == 0) return;

        _self ??= DotNetObjectReference.Create(this);

        try
        {
            await Js.InvokeVoidAsync(
                "backlogRoadmapTimeline.attach",
                _track,
                _instance,
                _self,
                new { weekRem = Geometry.WeekWidthRem, rowRem = Geometry.RowHeightRem, scroller = _scroller });

            _attached = true;
        }
        catch (JSException)
        {
            // The library script is not on the page. Everything except pointer
            // dragging still works, keyboard editing included, so the chart is
            // degraded rather than broken and there is nothing to report.
        }
    }

    /// <summary>The scroller's width on screen, in rem, whenever it changes — what
    /// <see cref="FillWidth"/> stretches the chart to.</summary>
    [JSInvokable]
    public void Measured(double widthRem)
    {
        if (widthRem <= 0 || (_viewportRem is { } known && Math.Abs(known - widthRem) < 0.25)) return;

        _viewportRem = widthRem;
        Invalidate();
        StateHasChanged();
    }

    // --- The gesture, from either direction --------------------------------

    /// <summary>A pointer has taken hold of a bar. Which part of it decides
    /// whether the gesture reschedules the work or re-estimates it.</summary>
    [JSInvokable]
    public void DragBegin(string barId, string grip)
    {
        // The script already refuses these; this is the same rule where it cannot be
        // bypassed. A locked bar yields its end grip and nothing else.
        if (Bar(barId) is { Locked: true } locked && !(EndOnly(locked) && grip == "end")) return;

        _clickEndsADrag = false;
        _dragId = barId;
        _grabbedId = null;
        _pointerRows = true;
        _kind = GripKind(grip);
        _steps = 0;
        _rowOffset = 0;

        Invalidate();
        StateHasChanged();
    }

    /// <summary>How far the drag has got, in whole weeks and whole rows — or, for an
    /// edge on a graduated axis, in column lines crossed. Called
    /// only when that answer changes, which is why it is cheap enough to redraw
    /// the whole chart — arrows included — on every one.</summary>
    [JSInvokable]
    public void DragPreview(int weekSteps, int rowSteps)
    {
        if (_dragId is null) return;

        _steps = AllowMove || _kind != RoadmapDrag.Move ? weekSteps : 0;
        _rowOffset = AllowRowChange && _kind == RoadmapDrag.Move ? rowSteps : 0;

        Invalidate();
        StateHasChanged();
    }

    [JSInvokable]
    public async Task DragCommit()
    {
        if (_dragId is null) return;

        // Asked before Settle, because settling releases the gesture and the answer
        // goes with it.
        var moved = PreviewFor(_dragId) is not null;

        await Settle(_dragId);

        _clickEndsADrag = moved;
    }

    [JSInvokable]
    public void DragCancel()
    {
        var abandoned = ActiveId;
        var bar = abandoned is null ? null : Bar(abandoned);

        // Escape abandons the move, but the pointer is still down: releasing it will
        // still synthesise a click, and a gesture the reader just cancelled is not a
        // request to open anything.
        _clickEndsADrag = _dragId is not null && (_steps != 0 || _rowOffset != 0);

        Release();

        if (bar is not null)
        {
            Announce($"Move cancelled. {bar.Title} returned to {DateLabel(bar.Start)}.");
        }

        StateHasChanged();
    }

    /// <summary>
    /// A double-click on an empty place on <paramref name="rowId"/>,
    /// <paramref name="xRem"/> in from the track's left edge. Answered with the week
    /// under the pointer, snapped to its first day; a row the chart does not draw, or
    /// one that takes nothing, says nothing.
    /// </summary>
    [JSInvokable]
    public async Task SlotActivated(string rowId, double xRem)
    {
        if (SlotRow(rowId) is not { } row) return;

        var on = RoadmapWindow.StartOfWeek(Geometry.DateAt(xRem), WeekStart);

        await OnSlotActivated.InvokeAsync(new RoadmapSlot(row.Id, on, row.Kind));
    }

    /// <summary>
    /// Where a span dragged across an empty place on <paramref name="rowId"/>, from
    /// <paramref name="fromRem"/> to <paramref name="toRem"/>, would be drawn — the
    /// weeks <see cref="SlotDrawn"/> would propose for the same two points, so what the
    /// reader sees while dragging is what the release asks for. Null on a row that
    /// takes no span: a milestones row, a row the chart does not draw, or any row when
    /// nothing is listening.
    /// </summary>
    [JSInvokable]
    public RoadmapSlotDraft? SlotDrawPreview(string rowId, double fromRem, double toRem)
    {
        if (SlotRow(rowId) is not { Kind: RoadmapRowKind.Bars }) return null;

        var (start, end) = SlotSpan(fromRem, toRem);
        var weeks = (end.DayNumber - start.DayNumber + 1) / 7;

        return new RoadmapSlotDraft(
            Geometry.XFor(start),
            Geometry.WidthFor(start, end),
            $"{DateLabel(start)} – {DateLabel(end)}, {weeks} {(weeks == 1 ? "week" : "weeks")}");
    }

    /// <summary>
    /// A drag across an empty place on <paramref name="rowId"/> was released: proposed
    /// as the whole weeks from the one pressed in through the one let go in, whichever
    /// way the pointer travelled. A milestones row takes the pressed week alone, as a
    /// double-click there does — a date has no length to drag out.
    /// </summary>
    [JSInvokable]
    public async Task SlotDrawn(string rowId, double fromRem, double toRem)
    {
        if (SlotRow(rowId) is not { } row) return;

        if (row.Kind == RoadmapRowKind.Milestones)
        {
            await OnSlotActivated.InvokeAsync(new RoadmapSlot(row.Id, RoadmapWindow.StartOfWeek(Geometry.DateAt(fromRem), WeekStart), row.Kind));
            return;
        }

        var (start, end) = SlotSpan(fromRem, toRem);

        await OnSlotActivated.InvokeAsync(new RoadmapSlot(row.Id, start, row.Kind, end));
    }

    /// <summary>The row an add-in-place gesture names, when somebody is listening and the
    /// chart draws it as a row of its own.</summary>
    private RoadmapRow? SlotRow(string rowId) =>
        OnSlotActivated.HasDelegate
        && Rows.FirstOrDefault(placed => placed.Step is null && !placed.Padding && placed.Row.Id == rowId) is { } placed
            ? placed.Folded ? FoldedLane(placed.Group) : placed.Row
            : null;

    /// <summary>Two points along a row widened to the whole weeks they fall in: the
    /// first day of the earlier one's week through the last day of the later one's.</summary>
    private (DateOnly Start, DateOnly End) SlotSpan(double fromRem, double toRem)
    {
        var start = RoadmapWindow.StartOfWeek(Geometry.DateAt(Math.Min(fromRem, toRem)), WeekStart);
        var end = RoadmapWindow.StartOfWeek(Geometry.DateAt(Math.Max(fromRem, toRem)), WeekStart).AddDays(6);

        return (start, end);
    }

    /// <summary>The row a double-click there adds to, or null — no attribute, so the
    /// script ignores it — when nothing is listening.</summary>
    private string? SlotRowId(RoadmapRow? row) => OnSlotActivated.HasDelegate ? row?.Id : null;

    /// <summary>
    /// The dependency handle of <paramref name="fromId"/> was dropped on
    /// <paramref name="toId"/>. Dropping it back on its own bar, or on nothing the
    /// timeline drew, says nothing and is ignored.
    /// </summary>
    [JSInvokable]
    public async Task LinkCommit(string fromId, string toId)
    {
        if (Is(fromId, toId) || Bar(fromId) is null) return;
        if (Bar(toId) is null && MilestoneList.All(milestone => !Is(milestone.Id, toId))) return;

        Announce($"{Name(toId)} now waits for {Name(fromId)}.");

        await OnLinkCreated.InvokeAsync(new RoadmapLink(fromId, toId));
    }

    /// <summary>
    /// The keyboard half of the same gesture, and not an afterthought: dragging
    /// has no keyboard equivalent of its own, so a timeline that could only be
    /// dragged would be one some readers could look at and never edit.
    /// </summary>
    private async Task Key(RoadmapBar bar, KeyboardEventArgs args)
    {
        // Enter opens and Space picks up: two verbs, two keys, and opening is the
        // one a reader does by accident far more often than moving.
        //
        // Enter is deliberately not handled here while the bar is loose. The bar
        // is a real button, so the browser already turns Enter into a click, and
        // catching it here as well would raise the host's selection callback
        // twice for one keypress. Once grabbed, the default is suppressed and
        // Enter means the same as Space: put it down.
        if (args.Key is " " or "Spacebar" || (args.Key == "Enter" && _grabbedId is not null))
        {
            if (_grabbedId is not null)
            {
                await Settle(_grabbedId);
                return;
            }

            if (bar.Locked && !EndOnly(bar)) return;
            if (!AllowMove && !AllowResize) return;

            _dragId = null;
            _grabbedId = bar.Id;
            _pointerRows = false;
            _kind = bar.Locked ? RoadmapDrag.ResizeEnd : RoadmapDrag.Move;
            _steps = 0;
            _rowOffset = 0;

            Invalidate();
            Announce(bar.Locked
                ? $"Grabbed {bar.Title}. Its start is fixed. Use Shift with the arrow keys to move its end, Space to drop, Escape to cancel."
                : $"Grabbed {bar.Title}. Use arrow keys to move, Space to drop, Escape to cancel.");
            return;
        }

        if (_grabbedId is null) return;

        if (args.Key == "Escape")
        {
            // Cancelling puts the bar back on the row it came from, which is
            // another new button if the arrows had carried it off that row.
            if (!Is(EffectiveRow(bar), bar.RowId)) _refocusId = bar.Id;

            DragCancel();
            return;
        }

        var along = args.Key switch
        {
            "ArrowRight" => 1,
            "ArrowLeft" => -1,
            _ => 0
        };

        if (along != 0)
        {
            // Which two dates the arrows are moving is decided by the modifier
            // held with them, and changing modifier mid-grab starts that edit
            // over. Carrying the step count across would apply a move's three
            // weeks to an edge the moment Shift went down.
            var kind = args.ShiftKey ? RoadmapDrag.ResizeEnd
                : args.AltKey ? RoadmapDrag.ResizeStart
                : RoadmapDrag.Move;

            if (kind == RoadmapDrag.Move && !AllowMove) return;
            if (kind != RoadmapDrag.Move && !AllowResize) return;

            // A locked bar that offers its end moves nothing else.
            if (bar.Locked && kind != RoadmapDrag.ResizeEnd) return;

            if (kind != _kind)
            {
                _kind = kind;
                _steps = 0;
                _rowOffset = 0;
            }

            _steps += along;

            Invalidate();
            AnnouncePlacement(bar);
            return;
        }

        var across = args.Key switch
        {
            "ArrowDown" => 1,
            "ArrowUp" => -1,
            _ => 0
        };

        if (across == 0 || !AllowRowChange || _kind != RoadmapDrag.Move) return;

        var from = EffectiveRow(bar);

        _rowOffset += across;

        Invalidate();
        if (!Is(EffectiveRow(bar), from)) _refocusId = bar.Id;
        AnnouncePlacement(bar);
    }

    /// <summary>
    /// The end of a gesture, from a pointer or from a key. One path for both:
    /// the two differ in how the reader said "here", not in what happens next.
    /// </summary>
    private async Task Settle(string barId)
    {
        var change = PreviewFor(barId);
        var bar = Bar(barId);

        Release();

        if (change is null || bar is null)
        {
            if (bar is not null) Announce($"{bar.Title} left where it was.");

            StateHasChanged();
            return;
        }

        Announce($"Dropped {bar.Title} at {DateLabel(change.Start)} to {DateLabel(change.End)}.");

        await OnBarChanged.InvokeAsync(change);

        // The row it landed on may be rebuilt around it, and a moved bar whose
        // focus ring stayed with the old element is a bar the reader has to
        // find again with the Tab key. After the render the host's change
        // causes, not now: a host applying it from inside this keypress has
        // only queued that render, and focusing now would focus the node it
        // is about to replace.
        _refocusId = barId;
        StateHasChanged();
    }

    private void Release()
    {
        _dragId = null;
        _grabbedId = null;
        _steps = 0;
        _rowOffset = 0;

        Invalidate();
    }

    /// <summary>Whether a locked bar still offers its end — and so is grabbed, but
    /// only to move that.</summary>
    private bool EndOnly(RoadmapBar bar) => AllowResize && bar.Locked && bar.EndResizable;

    private static RoadmapDrag GripKind(string grip) => grip switch
    {
        "start" => RoadmapDrag.ResizeStart,
        "end" => RoadmapDrag.ResizeEnd,
        _ => RoadmapDrag.Move
    };

    /// <summary>
    /// What the gesture in flight would do to this bar, or null when it would
    /// do nothing. This is what the bar is drawn from and what the arrows are
    /// resolved against, so the preview and the drop can never disagree — they
    /// are the same value.
    /// </summary>
    private RoadmapChange? PreviewFor(string barId)
    {
        if (!Is(ActiveId, barId) || Bar(barId) is not { } bar) return null;

        return RoadmapChange.For(bar, _kind, _steps, Landing(bar) ?? bar.RowId, WeekStart, ResizeBoundaries);
    }

    /// <summary>The lines a resized edge snaps to when the axis is graduated — its own
    /// columns, so an edge near today moves by the day — or null on a plain window,
    /// whose quarter columns are too coarse and whose edges snap to the week.</summary>
    private IReadOnlyList<DateOnly>? ResizeBoundaries => Span.IsGraduated ? Span.ColumnBoundaries : null;

    /// <summary>Where each of <see cref="ResizeBoundaries"/> is drawn, for the script
    /// to count the lines a dragged edge has crossed; null leaves it counting weeks.</summary>
    private string? ResizeSnaps => ResizeBoundaries is { } boundaries
        ? string.Join(' ', boundaries.Select(boundary => RoadmapGeometry.N(Geometry.XFor(boundary))))
        : null;

    /// <summary>
    /// Which row a move would land on, or null when it would land somewhere it
    /// cannot go.
    /// <para>
    /// A milestones row holds points in time and has no duration to lend a bar,
    /// so dropping one there is refused outright rather than allowed and then
    /// silently undone. Null is the refusal, and the caller turns it back into
    /// the row the bar came from — the difference between "you cannot" and
    /// "nothing happened" is what the reader is shown, not where the bar ends
    /// up.
    /// </para>
    /// <para>
    /// Open step rows are counted differently by the two gestures. A pointer
    /// reports how many drawn rows it travelled, step rows included, and a step
    /// row it stops on lands the bar on the row that step belongs to. The keyboard
    /// counts only the rows a bar can land on, so Down always means the next lane
    /// and never "into the middle of somebody's steps".
    /// </para>
    /// </summary>
    private string? Landing(RoadmapBar bar)
    {
        if (_rowOffset == 0 || !AllowRowChange || _kind != RoadmapDrag.Move) return bar.RowId;

        var rows = _pointerRows ? Rows : LandingRows;
        var drawn = DrawnRow(bar.RowId);
        var from = rows.Select((row, position) => (row, position)).FirstOrDefault(entry => Is(entry.row.Row.Id, drawn));

        if (from.row is null) return bar.RowId;

        var landing = rows[Math.Clamp(from.position + _rowOffset, 0, rows.Count - 1)];

        if (landing.Owner is { } owner) return owner.RowId;

        // Only a pointer reaches a padding row — the keyboard counts landing rows
        // alone — and a drop there means the band, so it lands on the band's nearest
        // lane.
        if (landing.Padding) return PaddingLane(landing)?.Id ?? bar.RowId;

        // A folded band is one lane to look at and several underneath: a bar staying in
        // it keeps its own, and one arriving from elsewhere takes the band's first.
        if (landing.Folded) return ReferenceEquals(landing, from.row) ? bar.RowId : FoldedLane(landing.Group)?.Id ?? bar.RowId;

        return landing.Row.Kind == RoadmapRowKind.Bars ? landing.Row.Id : null;
    }

    // --- Steps -------------------------------------------------------------

    /// <summary>
    /// A bar's steps shown or hidden, and said aloud either way.
    /// <para>
    /// Announced through the same live region a keyboard move uses, because the
    /// disclosure's own expanded state is only read when focus arrives on it — and
    /// the reader's focus is already there. Focus is put back on the disclosure by
    /// id afterwards, since the rows around it have just been rebuilt.
    /// </para>
    /// </summary>
    private async Task Toggle(string barId)
    {
        if (!ShowSteps || Bar(barId) is not { HasSteps: true } bar) return;

        if (_expanded.Remove(barId))
        {
            Announce($"Steps of {bar.Title} hidden.");
        }
        else
        {
            _expanded.Add(barId);
            Announce($"Showing {StepCount(bar.StepList.Count)} of {bar.Title}, one row each, sized by effort rather than by date.");
        }

        Invalidate();
        StateHasChanged();

        try
        {
            await Js.InvokeVoidAsync("backlogFocus", ToggleButtonId(barId));
        }
        catch (JSException)
        {
        }
    }

    private static string StepCount(int count) => count == 1 ? "1 step" : $"{count} steps";

    /// <summary>What a step is, said in full: its status in the caller's words, its
    /// size as a share rather than a date — or that it has none — and what it waits
    /// for. Its place in the order is on the row it sits in.</summary>
    private static string Spoken(RoadmapStep step, RoadmapStepSpan span) =>
        string.Join(". ", new[]
        {
            step.Title,
            step.Status,
            step.IsEstimated
                ? $"{step.Effort} {(step.Effort == 1 ? "point" : "points")}, {RoadmapGeometry.N(Math.Round(span.Share * 100))}% of the estimated effort"
                : "Not estimated, drawn at the minimum width",
            step.Detail
        }.Where(part => !string.IsNullOrWhiteSpace(part))) + ".";

    private static string StepClass(RoadmapStep step) => string.Join(' ', new[]
    {
        "roadmap-step",
        "roadmap-step--" + step.Tone.ToString().ToLowerInvariant(),
        step.IsEstimated ? null : "roadmap-step--unestimated"
    }.Where(part => part is not null));

    private string ToggleButtonId(string barId) => $"roadmap-bar-toggle-{_instance}-{Slug(barId)}";

    /// <summary>Whether the gesture in flight is being refused.</summary>
    private bool Refused => ActiveId is { } id && Bar(id) is { } bar && Landing(bar) is null;

    /// <summary>
    /// A bar was opened: clicked, or Enter pressed on it.
    /// <para>
    /// Except when the click is the one the browser synthesises at the end of a
    /// pointer drag. The bar's body is a <c>button</c>, so a press, a travel and a
    /// release is both a drag and a click as far as the DOM is concerned — and a host
    /// that opens an editor on activation would open it every single time somebody
    /// rescheduled something. A gesture that moved the work is not a request to open
    /// it, so that one click is swallowed here rather than every host having to learn
    /// to ignore it.
    /// </para>
    /// <para>
    /// Only a drag that <em>changed</em> something suppresses the click. A press and
    /// release that went nowhere is exactly what a click is, and still opens.
    /// </para>
    /// </summary>
    private async Task Activate(string id)
    {
        if (_clickEndsADrag)
        {
            _clickEndsADrag = false;
            return;
        }

        // A bar the keyboard is holding is being moved, not opened. The Space that
        // grabbed it is left to the browser on keydown — the bar only starts
        // suppressing keys once it is grabbed — so the browser turns its keyup into a
        // click, and opening the host's editor then would take the keyboard away from
        // the grab it just made. components.js suppresses that click in a browser;
        // this is the same rule for any click that still arrives.
        if (_grabbedId == id) return;

        if (OnBarSelected.HasDelegate) await OnBarSelected.InvokeAsync(id);
    }

    private void AnnouncePlacement(RoadmapBar bar)
    {
        if (Refused)
        {
            Announce("That row takes milestones, not bars.");
            return;
        }

        var placed = PreviewFor(bar.Id)?.ApplyTo(bar) ?? bar;
        var row = Rows.FirstOrDefault(candidate => Is(candidate.Row.Id, DrawnRow(placed.RowId)));

        Announce($"{DateLabel(placed.Start)} to {DateLabel(placed.End)}{(row is null ? null : ", " + Context(row))}.");
    }

    private void Announce(string message) => _announcement = message;

    // --- Filtering ---------------------------------------------------------

    /// <summary>Facet names in the order the bars first mention them, so the
    /// filter controls appear in the order the caller thought of them rather
    /// than alphabetically.</summary>
    private IReadOnlyList<string> FacetNames =>
        [.. BarList.SelectMany(bar => bar.FacetList).Select(facet => facet.Name).Distinct(StringComparer.Ordinal)];

    /// <summary>Every value a facet takes, across all bars rather than the
    /// visible ones. Narrowing the options as you filter would make a choice
    /// disappear the moment it became the only one left.</summary>
    private IReadOnlyList<SelectorOption> OptionsFor(string name) =>
        [.. BarList.SelectMany(bar => bar.FacetList)
            .Where(facet => string.Equals(facet.Name, name, StringComparison.Ordinal))
            .Select(facet => facet.Value)
            .Distinct(StringComparer.Ordinal)
            .OrderBy(value => value, StringComparer.CurrentCultureIgnoreCase)
            .Select(value => new SelectorOption(value, value))];

    private IReadOnlyList<string> SelectedIn(string name) =>
        _filters.TryGetValue(name, out var values) ? values : [];

    private async Task Filter(string name, IReadOnlyList<string> values)
    {
        _filters[name] = values;

        Invalidate();

        await OnFilterChanged.InvokeAsync(_filters.ToDictionary(pair => pair.Key, pair => pair.Value));
    }

    private async Task ClearFilters()
    {
        _filters.Clear();

        Invalidate();

        await OnFilterChanged.InvokeAsync(new Dictionary<string, IReadOnlyList<string>>());
    }

    /// <summary>
    /// The bars still on screen. A bar has to match every facet being filtered
    /// on, and any one of the values chosen within each — "tagged design AND in
    /// either of these two repositories", which is how a reader reads two
    /// controls standing side by side.
    /// </summary>
    private IReadOnlyList<RoadmapBar> VisibleBars => _visible ??=
        [.. BarList.Where(bar => _filters
            .Where(filter => filter.Value.Count > 0)
            .All(filter => bar.FacetList.Any(facet =>
                string.Equals(facet.Name, filter.Key, StringComparison.Ordinal)
                && filter.Value.Contains(facet.Value, StringComparer.Ordinal))))];

    private IEnumerable<RoadmapBar> BarsOn(string rowId) =>
        VisibleBars.Where(bar => Is(DrawnRow(EffectiveRow(bar)), rowId));

    /// <summary>Which row a bar is drawn on right now — including part-way
    /// through being dragged onto another one.</summary>
    private string EffectiveRow(RoadmapBar bar) => PreviewFor(bar.Id)?.RowId ?? bar.RowId;

    private IEnumerable<RoadmapMilestone> MilestonesOn(string rowId) =>
        MilestoneList.Where(milestone => Is(DrawnRow(milestone.RowId), rowId));

    /// <summary>
    /// The milestones that asked for a rule down the whole chart, and whose date is
    /// actually in the window.
    /// <para>
    /// A milestone whose row was filtered off the chart still draws its line. That is
    /// deliberate: the line is a fact about the whole plan at that date, and a filter
    /// narrows which work is shown rather than which dates exist.
    /// </para>
    /// </summary>
    private IEnumerable<RoadmapMilestone> SpanningMilestones =>
        MilestoneList.Where(milestone => milestone.Line && Span.Contains(milestone.On));

    /// <summary>
    /// The rules of the milestones filed under particular bands, one to each band that
    /// is drawn: its first placed row to its last, padding and a folded lane included,
    /// so the rule is as tall as the band reads. A plan-wide line already crosses them.
    /// </summary>
    private IEnumerable<(RoadmapMilestone Milestone, RoadmapGroup Group, int First, int Last)> BandRules =>
        from milestone in MilestoneList
        let bands = milestone.Bands ?? []
        where !milestone.Line && bands.Count > 0 && Span.Contains(milestone.On)
        from band in Rows.GroupBy(placed => placed.Group)
        where bands.Any(id => Is(id, band.Key.Id))
        select (milestone, band.Key, band.Min(placed => placed.Index), band.Max(placed => placed.Index));

    private RoadmapBar? Bar(string id) => BarList.FirstOrDefault(bar => Is(bar.Id, id));

    // --- Dependencies ------------------------------------------------------

    /// <summary>
    /// Every arrow that can actually be drawn.
    /// <para>
    /// A link whose end is missing, or has been filtered off the chart, is
    /// dropped rather than drawn to where the thing would have been. An arrow
    /// pointing at empty space is not a weaker version of a dependency; it is a
    /// claim about a relationship the reader has no way to check.
    /// </para>
    /// </summary>
    private IReadOnlyList<RoadmapArrow> Arrows => _arrows ??=
        [.. LinkList
            // The same dependency stated twice is one dependency. Left in, it
            // would draw one arrow exactly on top of another and count two
            // against the badge, which is a number the reader cannot reconcile
            // with the arrows they can see.
            .Distinct()
            .Select(link => (link, from: RightAnchor(link.FromId), to: LeftAnchor(link.ToId)))
            .Where(candidate => candidate.from is not null && candidate.to is not null)
            .Select(candidate => new RoadmapArrow(
                candidate.link.FromId,
                candidate.link.ToId,
                Geometry.LinkPath(
                    candidate.from!.Value.X,
                    candidate.from!.Value.Y,
                    candidate.to!.Value.X,
                    candidate.to!.Value.Y),
                $"{Name(candidate.link.FromId)} before {Name(candidate.link.ToId)}"))];

    /// <summary>How many dependencies point at something. The badge on the bar,
    /// counted from the links that survived resolution so the number and the
    /// arrows on screen always agree.</summary>
    private int DependencyCount(string id) => Arrows.Count(arrow => Is(arrow.ToId, id));

    /// <summary>What the pointer is over, or focus is on, whose arrows are
    /// drawn out from the rest. A dashed line crossing six others is only
    /// traceable by eye when the ones it is not are out of the way.</summary>
    private string? _traceId;

    private void Trace(string id)
    {
        // A drag passes over every bar between where it started and where it
        // lands; tracing each of those in turn would be noise, not information.
        if (_dragId is null) _traceId = id;
    }

    private void Untrace(string id)
    {
        if (Is(_traceId, id)) _traceId = null;
    }

    private bool Traced(RoadmapArrow arrow) =>
        _traceId is { } id && (Is(arrow.FromId, id) || Is(arrow.ToId, id));

    /// <summary>Whether <paramref name="id"/> is at the far end of a traced
    /// arrow. The traced thing itself is not: it already has the pointer.</summary>
    private bool Related(string id) =>
        _traceId is { } traced && !Is(traced, id)
        && Arrows.Any(arrow => (Is(arrow.FromId, traced) && Is(arrow.ToId, id))
                            || (Is(arrow.ToId, traced) && Is(arrow.FromId, id)));

    /// <summary>Only dims the other arrows when there is something to trace, so
    /// crossing a bar with no dependencies leaves the chart as it was.</summary>
    private string LinksClass => Arrows.Any(Traced)
        ? "roadmap-timeline__links roadmap-timeline__links--tracing"
        : "roadmap-timeline__links";

    /// <summary>Where an arrow leaves something: its right edge, at the
    /// vertical centre of whichever row it is currently drawn on.</summary>
    private (double X, double Y)? RightAnchor(string id) => Anchor(id, trailing: true);

    /// <summary>Where an arrow meets something: its left edge.</summary>
    private (double X, double Y)? LeftAnchor(string id) => Anchor(id, trailing: false);

    private (double X, double Y)? Anchor(string id, bool trailing)
    {
        if (Bar(id) is { } bar && VisibleBars.Any(visible => Is(visible.Id, id)))
        {
            var placed = PreviewFor(id)?.ApplyTo(bar) ?? bar;
            var row = RowIndex(placed.RowId);

            if (row is null) return null;

            var left = Geometry.XFor(placed.Start);

            return (trailing ? left + Geometry.WidthFor(placed.Start, placed.End) : left, Geometry.RowCenter(row.Value));
        }

        var milestone = MilestoneList.FirstOrDefault(candidate => Is(candidate.Id, id));

        if (milestone is null) return null;

        var milestoneRow = RowIndex(milestone.RowId);

        // Both ends of a milestone are the same point: it has no width to leave
        // one side of and arrive at the other.
        return milestoneRow is null ? null : (Geometry.XFor(milestone.On), Geometry.RowCenter(milestoneRow.Value));
    }

    private int? RowIndex(string rowId) =>
        Rows.FirstOrDefault(candidate => Is(candidate.Row.Id, DrawnRow(rowId)))?.Index;

    private string Name(string id) =>
        Bar(id)?.Title
        ?? MilestoneList.FirstOrDefault(milestone => Is(milestone.Id, id))?.Title
        ?? id;

    // --- Presentation helpers ----------------------------------------------

    /// <summary>
    /// The group's colour, handed to the stylesheet as a custom property.
    /// <para>
    /// The library declines to pick these. Its palette guide is explicit that
    /// product code must not grow a second semantic palette, and six separable
    /// hues is exactly that — so a group's colour arrives from the caller, the
    /// same way the graph explorer's legend colours do. No colour is a neutral
    /// band, which reads as "nobody said" rather than as one more category.
    /// </para>
    /// </summary>
    private static string? GroupStyle(RoadmapGroup group) =>
        string.IsNullOrWhiteSpace(group.Color) ? null : $"--roadmap-group-color: {group.Color};";

    /// <summary>How narrow a column may be and still carry its head — room for
    /// "W53" or "Oct" at the axis's type size, plus its padding.</summary>
    private const double MinLabelledColumnRem = 2;

    /// <summary>How wide a day column has to be to carry its weekday as well as its
    /// number — "Wed 23" rather than "23".</summary>
    private const double MinNamedDayRem = 3.25;

    /// <summary>Whether a column is the week today falls in. Weeks only: a month or
    /// a quarter shaded as "now" would claim far more of the chart than today is.</summary>
    private bool IsCurrentWeek(RoadmapColumn column) =>
        column.Scale == RoadmapColumnScale.Week && Today is { } today && today >= column.Start && today <= column.End;

    /// <summary>Whether a column is today's own: a day column on today, or the week
    /// column today is in where the week is not ruled in days.</summary>
    private bool IsCurrent(RoadmapColumn column) =>
        IsCurrentWeek(column) || (column.Scale == RoadmapColumnScale.Day && Today == column.Start);

    /// <summary>
    /// The stretch of the axis shaded as "this week": the week column today falls
    /// in, or — where this week is ruled a column a day — the run of day columns.
    /// </summary>
    private (DateOnly Start, DateOnly End)? ThisWeek
    {
        get
        {
            if (Today is not { } today) return null;
            if (Span.Columns.FirstOrDefault(IsCurrentWeek) is { } week) return (week.Start, week.End);

            var start = RoadmapWindow.StartOfWeek(today, WeekStart);
            var days = Span.Columns.Where(column => column.Scale == RoadmapColumnScale.Day && column.Start >= start && column.Start < start.AddDays(7)).ToList();

            return days.Count == 0 ? null : (days[0].Start, days[^1].End);
        }
    }

    /// <summary>How wide a day column has to be to carry its working hours as well —
    /// "Wed 23 · 8.5h".</summary>
    private const double MinHoursDayRem = 5.5;

    /// <summary>How wide a week column has to be to carry its working hours —
    /// "W41 · 42.5h".</summary>
    private const double MinHoursWeekRem = 5;

    /// <summary>
    /// A head's lines, the same whether the head is a plain column or a day's toggle. A
    /// week clipped to a few days at a month start has no room for its number; the
    /// tooltip still names it. Given a working week and the hours switched on, every head
    /// keeps a third line for its one hours figure, empty where there is none, so all
    /// heads read along one baseline as the caption line does.
    /// </summary>
    private RenderFragment HeadContent(RoadmapColumn column) => @<text>
        @if (Geometry.WidthFor(column.Start, column.End) >= MinLabelled(column))
        {
            <span class="roadmap-timeline__quarter-label">@HeadLabel(column)</span>
            <span class="roadmap-timeline__quarter-year">@HeadCaption(column)</span>
            @if (HoursLineShown)
            {
                @* Under the layer that opens the report, the line keeps its place and
                   is not drawn or read twice. *@
                <span class="@(HoursOpenable(column) ? "roadmap-timeline__quarter-hours roadmap-timeline__quarter-hours--covered" : "roadmap-timeline__quarter-hours")"
                      aria-hidden="@(HoursOpenable(column) ? "true" : null)">@HoursCaption(column)</span>
            }
        }
    </text>;

    /// <summary>Whether the heads carry an hours line at all: a working week is given and
    /// the host's Hours switch is on.</summary>
    private bool HoursLineShown => PlannedHoursOn is not null && ShowHours;

    /// <summary>
    /// What a column head reads. A day column too narrow for its weekday keeps the
    /// number here and names the day on the caption line (<see cref="HeadCaption"/>). Where a working week is given, a worked day's head and
    /// a week's head carry their working hours when there is room for them; the tooltip
    /// always says them.
    /// </summary>
    private string HeadLabel(RoadmapColumn column)
    {
        if (column.Scale == RoadmapColumnScale.Day && Geometry.WidthFor(column.Start, column.End) < MinNamedDayRem)
        {
            return column.Start.Day.ToString(CultureInfo.CurrentCulture);
        }

        return HoursInline(column) && !HoursOpenable(column) && HoursText(column) is { } hours ? $"{column.Label} · {hours}" : column.Label;
    }

    /// <summary>Whether a column is wide enough to say its hours on the head's own line:
    /// "Wed 23 · 8.5h", "Thu 8 · 6.2h".</summary>
    private bool HoursInline(RoadmapColumn column) =>
        Geometry.WidthFor(column.Start, column.End)
            >= (column.Scale == RoadmapColumnScale.Day ? MinHoursDayRem : MinHoursWeekRem);

    /// <summary>The caption font's size and a character's rough width in it, in rem —
    /// what decides whether "8.5h" fits under a day or gives up its unit, and whether
    /// "Mo W41" fits under a week's first day.</summary>
    private const double CaptionFontRem = 0.75;

    /// <summary>A letter, digit or space in Inter at the caption size, rounded up from
    /// the browser's own measure: "Mo W39" lays out 45.25px at 12px, about 0.63em a
    /// character.</summary>
    private const double CaptionCharEm = 0.65;

    /// <summary>A decimal point or comma, which Inter draws at about half a digit, so
    /// "8.5h" still fits under a 2rem day.</summary>
    private const double CaptionPunctuationEm = 0.3;

    /// <summary>A full-width East Asian character — "月", "周" — which takes the whole
    /// em a Latin letter takes two thirds of.</summary>
    private const double CaptionFullWidthEm = 1;

    /// <summary>What a head loses to its left border (1px); it has no padding.</summary>
    private const double HeadBorderRem = 0.0625;

    /// <summary>
    /// The head's one hours figure on its last line, for a column too narrow to say it
    /// inline (<see cref="HoursText"/>): "6.2h" or "8.5h" under a day and "42.5h" under a
    /// week, or "8.5" where the unit would not fit, since the week's head beside it says
    /// what the figure counts. Nothing where the head says no hours, or says them inline.
    /// </summary>
    private string? HoursCaption(RoadmapColumn column) =>
        HoursText(column) is { } withUnit && (!HoursInline(column) || HoursOpenable(column)) ? Fitted(column, withUnit) : null;

    /// <summary>
    /// Whether a head's hours open the report behind them: the host listens, the head has
    /// begun, its actual hours were read and it shows them, and it is wide enough to be
    /// labelled at all. Such a head says its hours on its own line, never beside its name,
    /// so the line can be pressed on its own.
    /// </summary>
    private bool HoursOpenable(RoadmapColumn column) =>
        OnHoursOpened.HasDelegate
        && HasBegun(column)
        && ActualIn(column) is not null
        && HoursText(column) is not null
        && Geometry.WidthFor(column.Start, column.End) >= MinLabelled(column);

    /// <summary>The hours button's accessible name: what it opens, for which day or week,
    /// and the figure — "Hours worked on Thu 1 Oct, 4.0h, show the stretches".</summary>
    private string HoursOpenName(RoadmapColumn column) =>
        (column.Scale == RoadmapColumnScale.Day
            ? $"Hours worked on {column.Start.ToString("ddd d MMM", CultureInfo.CurrentCulture)}"
            : $"Hours worked in {column.Label}")
        + $", {HoursText(column)}, show the stretches";

    /// <summary>A figure with its unit where that fits the column, else without it.</summary>
    private string Fitted(RoadmapColumn column, string withUnit) =>
        FitsCaption(column, withUnit) ? withUnit : withUnit[..^1];

    /// <summary>
    /// The head's caption line. A day too narrow to name its weekday beside its number
    /// names it here instead, in two letters of the culture's own — "Mo", "ma" — so every
    /// day column with room for its name says which day it is; one without keeps just its
    /// number, and the tooltip names the day. On the week's first day the week's number rides
    /// here too: "Mo W41" where both fit, else "W41" alone, because the number is the
    /// one thing no other head says and the tooltip still names the day. Every other
    /// column keeps the caption the window gave it.
    /// </summary>
    private string? HeadCaption(RoadmapColumn column)
    {
        if (column.Scale != RoadmapColumnScale.Day || Geometry.WidthFor(column.Start, column.End) >= MinNamedDayRem)
        {
            return column.Caption;
        }

        var weekday = ShortWeekday(column.Start.DayOfWeek);
        if (column.Caption is not { } week) return FitsCaption(column, weekday) ? weekday : null;

        var both = $"{weekday} {week}";
        return FitsCaption(column, both) ? both : week;
    }

    /// <summary>
    /// A weekday in two letters of the culture's own abbreviation — "Mo", "Tu"; "ma",
    /// "di". Not <see cref="DateTimeFormatInfo.ShortestDayNames"/>: under ICU, which .NET
    /// uses on every head, that is a single letter, and "T" and "S" each name two days.
    /// Counted in text elements so a combined character is never split.
    /// <para>
    /// Where two letters do not tell the seven days apart — Vietnamese "Th 2" … "Th 7",
    /// Hebrew and Arabic, whose abbreviations share a prefix — the whole abbreviation is
    /// used, and <see cref="FitsCaption"/> decides whether a day has room for it.
    /// </para>
    /// </summary>
    private static string ShortWeekday(DayOfWeek day)
    {
        var format = CultureInfo.CurrentCulture.DateTimeFormat;
        var twoLetters = AllWeekdays.Select(other => TwoLetters(format.GetAbbreviatedDayName(other).TrimEnd('.')));

        return twoLetters.Distinct(StringComparer.Ordinal).Count() == AllWeekdays.Length
            ? TwoLetters(format.GetAbbreviatedDayName(day).TrimEnd('.'))
            : format.GetAbbreviatedDayName(day).TrimEnd('.');
    }

    /// <summary>Every day of the week, in the order <see cref="DayOfWeek"/> numbers them.</summary>
    private static readonly DayOfWeek[] AllWeekdays = Enum.GetValues<DayOfWeek>();

    private static string TwoLetters(string abbreviated)
    {
        var letters = new StringInfo(abbreviated);
        return letters.LengthInTextElements <= 2 ? abbreviated : letters.SubstringByTextElements(0, 2);
    }

    /// <summary>Whether <paramref name="text"/> fits on a head's caption line inside
    /// the column's border, at the caption font's character widths: an East Asian
    /// full-width character about a whole em, a decimal point or comma about half a
    /// digit, anything else a Latin letter's.</summary>
    private bool FitsCaption(RoadmapColumn column, string text) =>
        text.EnumerateRunes().Sum(CaptionEm) * CaptionFontRem
            <= Geometry.WidthFor(column.Start, column.End) - HeadBorderRem;

    private static double CaptionEm(System.Text.Rune character) =>
        character.Value is '.' or ',' ? CaptionPunctuationEm
        : IsFullWidth(character.Value) ? CaptionFullWidthEm
        : CaptionCharEm;

    /// <summary>A full-width East Asian character: Hangul jamo and syllables, the CJK
    /// blocks from radicals to Yi, compatibility ideographs, the full-width forms and
    /// the ideographic planes.</summary>
    private static bool IsFullWidth(int codePoint) =>
        codePoint is (>= 0x1100 and <= 0x115F)
            or (>= 0x2E80 and <= 0xA4CF)
            or (>= 0xAC00 and <= 0xD7A3)
            or (>= 0xF900 and <= 0xFAFF)
            or (>= 0xFE30 and <= 0xFE4F)
            or (>= 0xFF00 and <= 0xFF60)
            or (>= 0xFFE0 and <= 0xFFE6)
            or (>= 0x20000 and <= 0x3FFFD);

    /// <summary>
    /// The column's tooltip: its long label, whether it is now, that it is not worked,
    /// its hours, and whether the person blocked or unblocked the date — "Friday 9 October
    /// 2026 · not worked · blocked". A head still to come says its planned hours as its
    /// head does, "· 8.5h". A head that has begun says both figures the head never shows
    /// together (local ADR 0019, §4): "Tuesday 29 September 2026 · 6.2h worked of 8.5h
    /// planned". Said whether or not the Hours switch shows them on the head.
    /// </summary>
    private string ColumnTitle(RoadmapColumn column)
    {
        var title = IsCurrentWeek(column) ? column.LongLabel + " (this week)"
            : IsCurrent(column) ? column.LongLabel + " (today)"
            : column.LongLabel;

        if (PlannedHoursOn is not null && IsDayOff(column)) title += " · not worked";
        if (TitleHours(column) is { } hours) title += " · " + hours;
        if (IsMarked(column)) title += IsDayOff(column) ? " · blocked" : " · unblocked";

        return title;
    }

    /// <summary>
    /// What a tooltip says of a column's hours, or null where it says nothing:
    /// <list type="bullet">
    /// <item>still to come: its planned hours, "8.5h", or nothing for a day off;</item>
    /// <item>begun, with the actual hours read: "6.2h worked of 8.5h planned", or on a day
    /// off somebody worked "2.0h worked";</item>
    /// <item>begun, with the actual hours unread: "8.5h planned", named so it is never
    /// taken for hours worked.</item>
    /// </list>
    /// </summary>
    private string? TitleHours(RoadmapColumn column)
    {
        if (PlannedIn(column) is not { } planned) return null;

        var hasPlan = planned > 0;
        if (!HasBegun(column)) return hasPlan ? Hours(planned) : null;

        if (ActualIn(column) is not { } actual) return hasPlan ? Hours(planned) + " planned" : null;
        if (hasPlan) return $"{ActualHours(actual)} worked of {Hours(planned)} planned";

        return HasWorked(actual) ? ActualHours(actual) + " worked" : null;
    }

    /// <summary>
    /// The one hours figure a day or week head shows, unit and all, or null where it
    /// shows none (local ADR 0019, §§4 and 6). A head never shows two.
    /// <list type="bullet">
    /// <item>a head still to come: its planned hours, "8.5h" or "42.5h", and nothing for
    /// a day not worked;</item>
    /// <item>a head that has begun — today and the current week included: its actual
    /// hours so far, "6.2h", a worked day nobody worked "0h", and a day not worked only
    /// when somebody worked it anyway, "2.0h";</item>
    /// <item>a head that has begun while the actual hours are unread: nothing, never its
    /// planned hours, which would read as hours worked.</item>
    /// </list>
    /// Nothing for a month or a quarter, with no working week given, or with the Hours
    /// switch off.
    /// </summary>
    private string? HoursText(RoadmapColumn column)
    {
        if (!ShowHours || PlannedIn(column) is not { } planned) return null;

        var dayOff = column.Scale == RoadmapColumnScale.Day && planned <= 0;

        if (!HasBegun(column)) return dayOff ? null : Hours(planned);
        if (ActualIn(column) is not { } actual) return null;

        return dayOff && !HasWorked(actual) ? null : ActualHours(actual);
    }

    /// <summary>Whether a column has begun: it starts on or before today. A column with
    /// no today given has not.</summary>
    private bool HasBegun(RoadmapColumn column) => Today is { } today && column.Start <= today;

    /// <summary>
    /// The planned hours in a day or week column, overrides included, or null where the
    /// axis says none: no working week given, or a month or a quarter.
    /// </summary>
    private double? PlannedIn(RoadmapColumn column)
    {
        if (PlannedHoursOn is null) return null;
        if (column.Scale is not (RoadmapColumnScale.Day or RoadmapColumnScale.Week)) return null;

        var hours = 0d;
        for (var day = column.Start; day <= column.End; day = day.AddDays(1)) hours += PlannedOn(day);

        return hours;
    }

    private double PlannedOn(DateOnly date) =>
        PlannedHoursOn is { } planned && planned(date) is var hours && hours > 0 ? hours : 0;

    /// <summary>
    /// The hours actually worked in a day or week column that has begun, counting only
    /// its dates up to today; null where none are given, for a column after today, and
    /// for a month or a quarter.
    /// </summary>
    private double? ActualIn(RoadmapColumn column)
    {
        if (ActualHoursByDate is not { } actual || PlannedHoursOn is null || Today is not { } today) return null;
        if (column.Scale is not (RoadmapColumnScale.Day or RoadmapColumnScale.Week) || column.Start > today) return null;

        var last = column.End < today ? column.End : today;
        var hours = 0d;
        for (var day = column.Start; day <= last; day = day.AddDays(1)) hours += actual.GetValueOrDefault(day);

        return hours;
    }

    /// <summary>
    /// Whether a column is a day ruled on its own that is not worked: one the working
    /// week does not work on that date, or — given no week — a Saturday or a Sunday, so
    /// a caller without one still sees the weekend.
    /// </summary>
    private bool IsDayOff(RoadmapColumn column) =>
        column.Scale == RoadmapColumnScale.Day
        && (PlannedHoursOn is null
            ? column.Start.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday
            : PlannedOn(column.Start) <= 0);

    /// <summary>Whether a day column's date differs from its weekday's pattern.</summary>
    private bool IsMarked(RoadmapColumn column) =>
        column.Scale == RoadmapColumnScale.Day && IsOverridden is { } overridden && overridden(column.Start);

    /// <summary>Whether a column's head is a button that blocks or unblocks its date:
    /// a day's, where the host listens.</summary>
    private bool IsToggle(RoadmapColumn column) =>
        column.Scale == RoadmapColumnScale.Day && OnDayToggled.HasDelegate;

    /// <summary>
    /// A day head's accessible name: what pressing it does, then the date in the
    /// culture's own short weekday and month — "Block Fri 9 Oct", "Unblock Sat 10 Oct".
    /// The visible "Fri 9" stays inside it, so a person who says what they see reaches
    /// the button.
    /// </summary>
    private string ToggleName(RoadmapColumn column) =>
        $"{(IsDayOff(column) ? "Unblock" : "Block")} {column.Start.ToString("ddd d MMM", CultureInfo.CurrentCulture)}";

    private Task ToggleDay(DateOnly date) => OnDayToggled.InvokeAsync(date);

    /// <summary>Hours as a head says them: invariant, at most two decimals, and none
    /// for a whole hour — "8h", "8.5h", "42.5h".</summary>
    private static string Hours(double hours) =>
        Math.Round(hours, 2).ToString("0.##", CultureInfo.InvariantCulture) + "h";

    /// <summary>Actual hours as a head says them: invariant and one decimal — "6.2h",
    /// "2.0h", "33.1h" — the precision a measure of a day's work holds, and "0h" for none,
    /// so nothing worked does not read as a figure measured to a tenth.</summary>
    private static string ActualHours(double hours) =>
        HasWorked(hours) ? hours.ToString("0.0", CultureInfo.InvariantCulture) + "h" : "0h";

    /// <summary>Whether actual hours come to anything at the precision they are shown at.</summary>
    private static bool HasWorked(double hours) => Math.Round(hours, 1) > 0;

    private double MinLabelled(RoadmapColumn column) =>
        column.Scale == RoadmapColumnScale.Day ? MinLabelledDayRem : MinLabelledColumnRem;

    /// <summary>A day's number needs less room than "W53".</summary>
    private const double MinLabelledDayRem = 1.25;

    private string ColumnClass(RoadmapColumn column) =>
        $"roadmap-timeline__quarter roadmap-timeline__quarter--{column.Scale.ToString().ToLowerInvariant()}"
        + (IsDayOff(column) ? " roadmap-timeline__quarter--weekend" : null)
        + (IsMarked(column) ? " roadmap-timeline__quarter--override" : null)
        + (IsCurrent(column) ? " roadmap-timeline__quarter--current" : null);

    private static string MilestoneClass(RoadmapMilestone milestone) =>
        "roadmap-milestone roadmap-milestone--" + milestone.Marker.ToString().ToLowerInvariant()
        + (!milestone.Line && milestone.Bands is { Count: > 0 } ? " roadmap-milestone--banded" : null);

    /// <summary>Where a row is, said the way a reader would: the band first,
    /// then the line within it.</summary>
    private static string Context(PlacedRow placed) => placed.Owner is { } owner
        ? $"{placed.Group.Title}, {owner.Title}, step {placed.StepIndex + 1} of {owner.StepList.Count}"
        : string.IsNullOrWhiteSpace(placed.Row.Title) ? placed.Group.Title : $"{placed.Group.Title}, {placed.Row.Title}";

    private static string Glyph(RoadmapMarker marker) => marker switch
    {
        RoadmapMarker.Star => "★",
        RoadmapMarker.Square => "■",
        _ => "◆"
    };

    private string Tooltip(RoadmapMilestone milestone) =>
        RoadmapDetail.Report(new[] { milestone.Title, DateLabel(milestone.On) }.Concat(RoadmapDetail.Lines(milestone.Detail)));

    private string Spoken(RoadmapMilestone milestone, PlacedRow placed) =>
        string.Join(". ", new[] { $"Milestone: {milestone.Title}", Context(placed), DateLabel(milestone.On), RoadmapDetail.Spoken(milestone.Detail) }
            .Where(part => !string.IsNullOrWhiteSpace(part))) + ".";

    private string BarButtonId(string barId) => $"roadmap-bar-{_instance}-{Slug(barId)}";

    private string? Suffix(string part) => TestId is null ? null : $"{TestId}-{part}";

    private static bool Is(string? left, string right) => string.Equals(left, right, StringComparison.Ordinal);

    private static string Rem(double value) => $"{RoadmapGeometry.N(value)}rem";

    /// <summary>An id or a name reduced to something safe in a test hook and in
    /// an element id. Not reversible and not meant to be: it names an element,
    /// it does not carry the value.</summary>
    private static string Slug(string value) =>
        new([.. value.Select(character => char.IsLetterOrDigit(character) ? char.ToLowerInvariant(character) : '-')]);

    /// <summary>A row and where it sits, once the two-level structure has been
    /// flattened into the single list the chart actually draws.</summary>
    /// <remarks>A step row also carries the bar it opened from, the step, where
    /// that step sits in the bar's order, and where it is drawn. A padding row is
    /// room a band's sidebar content asked for, and holds nothing. A folded row is a
    /// whole band drawn as one.</remarks>
    private sealed record PlacedRow(
        RoadmapGroup Group,
        RoadmapRow Row,
        int Index,
        RoadmapBar? Owner = null,
        RoadmapStep? Step = null,
        int StepIndex = 0,
        RoadmapStepSpan? Span = null,
        bool Padding = false,
        bool Folded = false);

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("backlogRoadmapTimeline.dispose", _instance);
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
            // Disposed from a prerender, where interop is not available yet.
            // Nothing was attached, so there is nothing to detach.
        }

        _self?.Dispose();
    }
}
