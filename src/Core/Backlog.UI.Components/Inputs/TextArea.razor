@*
    Auto-grow is the CSS-only trick the raw editor already uses: a `.grow-wrap`
    whose ::after replica carries the same text and the same font metrics sets
    the grid track, and the textarea stretches to fill it. No JS, no resize
    observer, no flicker on the first paint.

    `Bare` drops the outer wrapper for a host that already lays the label and the
    box out itself, the same way TextField does. The grow wrapper is not part of
    that bargain: it carries the border and sets the height, so removing it would
    remove auto-grow. Turn AutoGrow off instead and it becomes a plain div.
*@

@if (Bare)
{
    @FieldParts
}
else
{
    <div class="@ClassValue" data-testid="@TestId">
        @FieldParts
    </div>
}

@code {
    private readonly string _id = "field-" + Guid.NewGuid().ToString("N");

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Readonly { get; set; }

    [Parameter]
    public bool AutoGrow { get; set; } = true;

    [Parameter]
    public int Rows { get; set; } = 3;

    [Parameter]
    public string? HelpText { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>Renders the label, box, help and error without the wrapping
    /// <c>field</c> element, for hosts whose own layout already places them.</summary>
    [Parameter]
    public bool Bare { get; set; }

    /// <summary>Replaces <c>field</c> on the wrapper, and the stem its invalid
    /// modifier is built on. Ignored when <see cref="Bare"/> is set.</summary>
    [Parameter]
    public string BaseClass { get; set; } = "field";

    /// <summary>Replaces <c>field__label</c> on the label.</summary>
    [Parameter]
    public string LabelCssClass { get; set; } = "field__label";

    /// <summary>Replaces <c>field__input</c> on the textarea. A host with an
    /// error style of its own puts it here, because the <c>field--invalid</c>
    /// modifier lives on a wrapper <see cref="Bare"/> does not render.</summary>
    [Parameter]
    public string InputCssClass { get; set; } = "field__input";

    /// <summary>Replaces <c>field__grow</c> on the element around the textarea.
    /// That element carries the border, so a host whose textarea is already
    /// bordered passes an empty string rather than doubling it up.</summary>
    [Parameter]
    public string GrowCssClass { get; set; } = "field__grow";

    /// <summary>Lands on the wrapper, or on the textarea itself when
    /// <see cref="Bare"/> removes the wrapper.</summary>
    [Parameter]
    public string? TestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string FieldId => string.IsNullOrWhiteSpace(Id) ? _id : Id;

    /// <summary>The test id the textarea wears, which is one only when there is
    /// no wrapper to wear it instead. Writing it in both places would put the
    /// same id on two elements, and an id that matches twice is worse than one
    /// that matches once: it makes every locator for it ambiguous.</summary>
    private string? BareTestId => Bare ? TestId : null;

    private string HelpId => FieldId + "-help";

    private string ErrorId => FieldId + "-error";

    private bool HasError => !string.IsNullOrWhiteSpace(ErrorMessage);

    private string? WrapClass
    {
        get
        {
            var grow = AutoGrow ? ("grow-wrap " + GrowCssClass).TrimEnd() : GrowCssClass;
            return string.IsNullOrWhiteSpace(grow) ? null : grow;
        }
    }

    private string? DescribedBy
    {
        get
        {
            var parts = new List<string>(2);
            if (!string.IsNullOrWhiteSpace(HelpText)) parts.Add(HelpId);
            if (HasError) parts.Add(ErrorId);

            return parts.Count == 0 ? null : string.Join(' ', parts);
        }
    }

    private string ClassValue
    {
        get
        {
            var error = HasError ? $" {BaseClass}--invalid" : string.Empty;
            var extra = string.IsNullOrWhiteSpace(CssClass) ? string.Empty : " " + CssClass;
            return $"{BaseClass} {BaseClass}--textarea{error}{extra}";
        }
    }

    private RenderFragment FieldParts =>
        @<text>
            @if (!string.IsNullOrWhiteSpace(Label))
            {
                <label class="@LabelCssClass" for="@FieldId">@Label</label>
            }
            <div class="@WrapClass" data-replicated-value="@Value">
                <textarea id="@FieldId"
                          class="@InputCssClass"
                          data-testid="@BareTestId"
                          rows="@Rows"
                          placeholder="@Placeholder"
                          disabled="@Disabled"
                          readonly="@Readonly"
                          aria-invalid="@(HasError ? "true" : null)"
                          aria-describedby="@DescribedBy"
                          aria-label="@(string.IsNullOrWhiteSpace(Label) ? AriaLabel : null)"
                          @oninput="OnInput"
                          @attributes="AdditionalAttributes">@Value</textarea>
            </div>
            @if (!string.IsNullOrWhiteSpace(HelpText))
            {
                <p id="@HelpId" class="field__help">@HelpText</p>
            }
            @if (HasError)
            {
                <Alert Message="@ErrorMessage" CssClass="field__error" Id="@ErrorId" />
            }
        </text>;

    private Task OnInput(ChangeEventArgs e)
    {
        // The replica reads from Value, so it has to be current before the next
        // render or the box lags one keystroke behind the text.
        Value = e.Value?.ToString() ?? string.Empty;
        return ValueChanged.InvokeAsync(Value);
    }
}
