@*
    A labelled single-line field. The help text and the error message are wired
    into `aria-describedby` rather than left floating next to the input, so the
    reason a value was rejected reaches a screen reader with the field.

    The wrapper is optional. A settings form that already lays a label and an
    input out as siblings has nowhere to put a grid container, and adding one
    would push its spacing around, so `Bare` emits the parts on their own -
    the same escape hatch Tabs offers a host that owns its own layout.
*@

@if (Bare)
{
    @FieldParts
}
else
{
    <div class="@ClassValue" data-testid="@TestId">
        @FieldParts
    </div>
}

@code {
    private readonly string _id = "field-" + Guid.NewGuid().ToString("N");

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Readonly { get; set; }

    /// <summary>One of text, number, url, email, date, time or datetime-local;
    /// anything else falls back to text.
    /// <para>
    /// The three date and time types are here rather than in a DateField of their
    /// own because nothing else about the field would differ: same label pairing, same
    /// <c>aria-describedby</c> wiring, same error state. A second component would
    /// have been this one with a different <c>type</c> attribute, and a host that
    /// wanted a date would then have had two places to look for one.
    /// </para>
    /// <para>
    /// A date field raises <c>oninput</c> while the value is still incomplete, and
    /// an incomplete date reads as empty. A host for which empty means "clear the
    /// field" should therefore splat an <c>onchange</c> handler rather than bind
    /// <see cref="ValueChanged"/>: a date commits when it is a date.
    /// </para></summary>
    [Parameter]
    public string Type { get; set; } = "text";

    [Parameter]
    public string? HelpText { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>Renders the label, input, help and error without the wrapping
    /// <c>field</c> element, for hosts whose own layout already places them.</summary>
    [Parameter]
    public bool Bare { get; set; }

    /// <summary>Replaces <c>field</c> on the wrapper, and the stem its invalid
    /// modifier is built on. Ignored when <see cref="Bare"/> is set.</summary>
    [Parameter]
    public string BaseClass { get; set; } = "field";

    /// <summary>Replaces <c>field__label</c> on the label.</summary>
    [Parameter]
    public string LabelCssClass { get; set; } = "field__label";

    /// <summary>Replaces <c>field__input</c> on the input. A host with an error
    /// style of its own puts it here, because the <c>field--invalid</c> modifier
    /// lives on a wrapper <see cref="Bare"/> does not render.</summary>
    [Parameter]
    public string InputCssClass { get; set; } = "field__input";

    /// <summary>
    /// The small inline shape: a field on a strip rather than a row in a form.
    /// <para>
    /// The default input is a form input — full width, form padding — which is
    /// right in a dialog and far too big beside a chip on a toolbar. Both panels
    /// that needed the small one were passing a private class of their own to get
    /// it, which is the arrangement <c>ui-components.instructions.md</c> exists to
    /// stop: two hosts naming the same string to make a control the right size
    /// means the size belongs to the library.
    /// </para>
    /// <para>
    /// Added to the input's class rather than replacing it, so it is a modifier
    /// over whatever skin the field is wearing — including a host's own, if the
    /// host replaced <see cref="InputCssClass"/>. It changes the geometry and
    /// nothing else: a compact field is the same control, smaller.
    /// </para>
    /// </summary>
    [Parameter]
    public bool Compact { get; set; }

    /// <summary>Something inside the input's trailing edge: a state marker, a
    /// unit, a lock. The library positions it and pads the input to leave room,
    /// so a long value scrolls behind nothing and a click on it still lands in
    /// the field.
    /// <para>
    /// The positioning box it needs is only rendered when it is set. A field with
    /// no suffix emits the input as its own child exactly as it always did, which
    /// is what every form already laid out against this component depends on.
    /// </para></summary>
    [Parameter]
    public RenderFragment? Suffix { get; set; }

    /// <summary>Replaces <c>field__suffix</c> on the element the suffix is placed
    /// in. The box around it has no hook of its own: the trailing padding that
    /// keeps the value clear of the suffix is measured against
    /// <c>field__control</c>, so a host replacing that name would take the room
    /// away rather than restyle it.</summary>
    [Parameter]
    public string SuffixCssClass { get; set; } = "field__suffix";

    /// <summary>Lands on the wrapper, or on the input itself when
    /// <see cref="Bare"/> removes the wrapper.</summary>
    [Parameter]
    public string? TestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string FieldId => string.IsNullOrWhiteSpace(Id) ? _id : Id;

    /// <summary>The test id the input wears, which is one only when there is no
    /// wrapper to wear it instead. Writing it in both places would put the same
    /// id on two elements, and an id that matches twice is worse than one that
    /// matches once: it makes every locator for it ambiguous.</summary>
    private string? BareTestId => Bare ? TestId : null;

    private string HelpId => FieldId + "-help";

    private string ErrorId => FieldId + "-error";

    private bool HasError => !string.IsNullOrWhiteSpace(ErrorMessage);

    private string? DescribedBy
    {
        get
        {
            var parts = new List<string>(2);
            if (!string.IsNullOrWhiteSpace(HelpText)) parts.Add(HelpId);
            if (HasError) parts.Add(ErrorId);

            return parts.Count == 0 ? null : string.Join(' ', parts);
        }
    }

    private string ClassValue
    {
        get
        {
            var error = HasError ? $" {BaseClass}--invalid" : string.Empty;
            var extra = string.IsNullOrWhiteSpace(CssClass) ? string.Empty : " " + CssClass;
            return $"{BaseClass} {BaseClass}--text{error}{extra}";
        }
    }

    private RenderFragment FieldParts =>
        @<text>
            @if (!string.IsNullOrWhiteSpace(Label))
            {
                <label class="@LabelCssClass" for="@FieldId">@Label</label>
            }
            @if (Suffix is null)
            {
                @InputPart
            }
            else
            {
                <span class="field__control">
                    @InputPart
                    <span class="@SuffixCssClass">@Suffix</span>
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(HelpText))
            {
                <p id="@HelpId" class="field__help">@HelpText</p>
            }
            @if (HasError)
            {
                <Alert Message="@ErrorMessage" CssClass="field__error" Id="@ErrorId" />
            }
        </text>;

    /// <summary>Its own fragment only so the suffix can be wrapped around it
    /// without the input being written twice - two copies of this attribute list
    /// is how they stop matching.</summary>
    private RenderFragment InputPart =>
        @<input id="@FieldId"
                class="@InputClass"
                data-testid="@BareTestId"
                type="@Type"
                value="@Value"
                placeholder="@Placeholder"
                disabled="@Disabled"
                readonly="@Readonly"
                aria-invalid="@(HasError ? "true" : null)"
                aria-describedby="@DescribedBy"
                aria-label="@(string.IsNullOrWhiteSpace(Label) ? AriaLabel : null)"
                @oninput="OnInput"
                @attributes="AdditionalAttributes" />;

    private string InputClass =>
        Compact ? $"{InputCssClass} field__input--compact" : InputCssClass;

    protected override void OnParametersSet()
    {
        if (Type is not ("text" or "number" or "url" or "email" or "date" or "time" or "datetime-local")) Type = "text";
    }

    private Task OnInput(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);
}
