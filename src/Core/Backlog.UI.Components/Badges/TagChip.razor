@*
    A tag reads as a chip. Clickable and removable are independent: filtering by
    a tag and dropping it are different intents, so they are different controls.

    A suggested chip is one the product proposes and nothing has applied yet: it
    is drawn outlined in a dashed edge, the label is the act that takes it, and
    the remove control is the act that turns it down. A shortcut, when the
    caller binds one, is drawn as a keycap in front of the label so the key is
    read where the chip is.
*@

<span class="@ClassValue" data-testid="@TestId" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrWhiteSpace(Shortcut))
    {
        <kbd class="tag-chip__key" aria-hidden="true">@Shortcut</kbd>
    }
    @if (OnClick.HasDelegate)
    {
        @* The label is the tag; the name is what pressing it does. "#sync" alone
           names the thing under the pointer and not the act, and a column of them
           reads as a list of tags rather than as a set of controls — so a caller
           that has an act in mind says so and the word is still what is drawn. *@
        <button type="button"
                class="tag-chip__label"
                aria-label="@Label"
                title="@Label"
                aria-keyshortcuts="@(string.IsNullOrWhiteSpace(Shortcut) ? null : Shortcut)"
                @onclick="OnClick"
                @onclick:stopPropagation="true"
                disabled="@Disabled">@Text</button>
    }
    else
    {
        <span class="tag-chip__label">@Text</span>
    }
    @if (Removable)
    {
        @* A multiplication sign, not the letter x: the letter sits on the
           baseline and reads as part of the tag's text. *@
        <IconButton AriaLabel="@(RemoveLabel ?? $"Remove {Text}")"
                    CssClass="tag-chip__remove"
                    Disabled="@Disabled"
                    OnClick="OnRemoveClicked">&#215;</IconButton>
    }
</span>

@code {
    [Parameter]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public bool Removable { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<string> OnRemove { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>What pressing the chip does, for the accessible name and the
    /// tooltip — "Filter by #sync" rather than "#sync". Null leaves the drawn text
    /// as the name, which is what a chip that only reads as a tag wants.</summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>A chip the product proposes and nothing has applied yet — drawn
    /// outlined in a dashed edge, whatever kind of tag its text names.</summary>
    [Parameter]
    public bool Suggested { get; set; }

    /// <summary>The key that takes the chip, drawn as a keycap in front of the
    /// label and announced on the label's button. The caller binds the key; the
    /// chip only says which it is.</summary>
    [Parameter]
    public string? Shortcut { get; set; }

    /// <summary>The accessible name of the remove control — "Dismiss #sync" on a
    /// suggestion rather than "Remove #sync". Null keeps "Remove {Text}".</summary>
    [Parameter]
    public string? RemoveLabel { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// The chip reads its own kind off the text it was handed: a leading <c>@</c>
    /// means a person, a leading <c>+</c> means a plan tag, anything else is a
    /// general tag.
    /// <para>
    /// Derived rather than a parameter on purpose. The sigil is already in the
    /// stored value — that is what makes an unsigilled tag still mean "general"
    /// with no migration — so a separate flag would be a second copy of a fact the
    /// text already carries, and the two would eventually disagree. It also means
    /// every existing caller gets the variant for free rather than having to be
    /// found and updated.
    /// </para>
    /// <para>
    /// Colour is never the only carrier: the sigil is drawn, so the distinction
    /// survives a reader who cannot see the surface behind it.
    /// </para></summary>
    private string ClassValue
    {
        get
        {
            var classes = TagText.Kind(Text) switch
            {
                TagKind.Person => "tag-chip tag-chip--person",
                TagKind.Plan => "tag-chip tag-chip--plan",
                _ => "tag-chip"
            };

            if (Suggested) classes += " tag-chip--suggested";

            return string.IsNullOrWhiteSpace(CssClass) ? classes : $"{classes} {CssClass}";
        }
    }

    private Task OnRemoveClicked() => OnRemove.InvokeAsync(Text);
}
