<Badge Kind="@Kind" Slug="@Slug" BaseClass="@BaseClass" TestId="@TestId" CssClass="@CssClass" Title="@Title" Href="@Href" @attributes="AdditionalAttributes">@Label</Badge>

@code {
    [Parameter]
    public string Status { get; set; } = string.Empty;

    /// <summary>Overrides the visible text; the slug still comes from Status.</summary>
    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public string FallbackSlug { get; set; } = "draft";

    /// <summary>The badge dimension. Empty collapses the modifier to
    /// <c>&lt;base&gt;--&lt;slug&gt;</c>.</summary>
    [Parameter]
    public string Kind { get; set; } = "status";

    [Parameter]
    public string BaseClass { get; set; } = "badge";

    [Parameter]
    public string? Title { get; set; }

    /// <summary>Where the status leads, when it leads somewhere. Handed through to
    /// the badge, which then renders an anchor rather than a span — a status that
    /// names a tracker item a reader wants to open is the case that earned it.</summary>
    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string Slug => BadgeSlug.Of(Status, FallbackSlug);

    private string Label => string.IsNullOrWhiteSpace(Text) ? Status : Text;
}
