@*
    A sprint item's note and open-question mark
    (.devbook/domain/progress/features.md#keeping-a-note-on-an-item), edited together
    because the sprint view draws them together: an open question reads its note as
    the question.

    The note is one line — a text field, so a line break cannot be typed — and blank
    clears it. Both belong to the sprint, not to the task; the dialog says so, because
    a person editing a task's note expects it on the task. Save hands both back at once;
    the host writes them through the module and closes the dialog, or keeps it open
    with the module's refusal in Error.
*@
<Modal Open="Open"
       OpenChanged="OpenChanged"
       Title="@($"Note on “{TaskTitle}”")"
       CssClass="sprint-note-dialog"
       TestId="@TestId">
    <ChildContent>
        <p class="sprint-note-dialog__description">Kept in @SprintName, not on the task. The next sprint starts without it.</p>
        <TextField Label="Note"
                   Value="@_note"
                   ValueChanged="value => _note = value"
                   Placeholder="One line"
                   TestId="sprint-note-text" />
        <Checkbox Checked="_question"
                  CheckedChanged="value => _question = value"
                  Label="Open question"
                  TestId="sprint-note-question" />
        <Alert Message="@Error" TestId="sprint-note-error" />
    </ChildContent>
    <Footer>
        <AppButton Variant="ButtonVariant.Ghost" OnClick="() => OpenChanged.InvokeAsync(false)" TestId="sprint-note-cancel">Cancel</AppButton>
        <AppButton Variant="ButtonVariant.Primary" Busy="Busy" BusyLabel="Saving" OnClick="SaveAsync" TestId="sprint-note-save">Save</AppButton>
    </Footer>
</Modal>

@code {
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>The task the note is on, for the title.</summary>
    [Parameter]
    public string TaskTitle { get; set; } = string.Empty;

    /// <summary>The sprint that keeps the note.</summary>
    [Parameter]
    public string SprintName { get; set; } = "this sprint";

    /// <summary>What the sprint records now: the fields start from it at each opening.</summary>
    [Parameter]
    public SprintItemNote Current { get; set; } = new(null, false);

    /// <summary>Save was pressed, with the note trimmed — null when blank.</summary>
    [Parameter]
    public EventCallback<SprintItemNote> OnSave { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    /// <summary>Why the save was refused, in the module's words.</summary>
    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public string? TestId { get; set; } = "sprint-note-dialog";

    private string? _note;
    private bool _question;
    private bool _wasOpen;

    protected override void OnParametersSet()
    {
        if (Open && !_wasOpen)
        {
            _note = Current.Note;
            _question = Current.OpenQuestion;
        }

        _wasOpen = Open;
    }

    private Task SaveAsync() =>
        OnSave.InvokeAsync(new SprintItemNote(string.IsNullOrWhiteSpace(_note) ? null : _note.Trim(), _question));
}
