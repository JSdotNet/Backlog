@*
    The open sprint's goal in words (.devbook/domain/progress/features.md
    #writing-the-sprint-goal), written or changed from the sprint view's goal card. The
    goal is the sprint's, not its series': the next sprint gets its own when this one
    closes. Blank clears it. Save hands the goal back trimmed; the host writes it through
    the module and closes the dialog, or keeps it open with the module's refusal in Error.
*@
<Modal Open="Open"
       OpenChanged="OpenChanged"
       Title="@($"Goal for {SprintName}")"
       CssClass="sprint-goal-dialog"
       TestId="@TestId">
    <ChildContent>
        <TextField Label="Goal"
                   Value="@_goal"
                   ValueChanged="value => _goal = value"
                   Placeholder="What this sprint is for"
                   TestId="sprint-goal-text" />
        <Alert Message="@Error" TestId="sprint-goal-error" />
    </ChildContent>
    <Footer>
        <AppButton Variant="ButtonVariant.Ghost" OnClick="() => OpenChanged.InvokeAsync(false)" TestId="sprint-goal-cancel">Cancel</AppButton>
        <AppButton Variant="ButtonVariant.Primary" Busy="Busy" BusyLabel="Saving" OnClick="SaveAsync" TestId="sprint-goal-save">Save</AppButton>
    </Footer>
</Modal>

@code {
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>The sprint the goal belongs to, for the title.</summary>
    [Parameter]
    public string SprintName { get; set; } = "this sprint";

    /// <summary>The goal the sprint holds now: the field starts from it at each opening.</summary>
    [Parameter]
    public string? Current { get; set; }

    /// <summary>Save was pressed, with the goal trimmed — empty to clear it.</summary>
    [Parameter]
    public EventCallback<string> OnSave { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    /// <summary>Why the save was refused, in the module's words.</summary>
    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public string? TestId { get; set; } = "sprint-goal-dialog";

    private string? _goal;
    private bool _wasOpen;

    protected override void OnParametersSet()
    {
        if (Open && !_wasOpen) _goal = Current;
        _wasOpen = Open;
    }

    private Task SaveAsync() => OnSave.InvokeAsync(_goal?.Trim() ?? string.Empty);
}
