@using System.Globalization
@*
    Starting a series' first sprint (.devbook/domain/progress/features.md
    #starting-the-first-sprint): its goal in words and the day it starts. Every later
    sprint starts by closing the one before it, so this is asked once per series.

    The day starts at DefaultStart, which the host works out from its clock — the next
    start weekday, today when today is one. A day on another weekday is held back with
    the reason beside the field rather than sent to be refused; whatever else the module
    refuses comes back in Error, in its words, and the dialog stays open.
*@
<Modal Open="Open"
       OpenChanged="OpenChanged"
       Title="@($"Start {SprintName}")"
       CssClass="sprint-start-dialog"
       TestId="@TestId">
    <ChildContent>
        <p class="sprint-start-dialog__description" data-testid="sprint-start-hint">Sprints of @SeriesName start on a @StartWeekday. Each one after this starts when the one before it closes.</p>
        <TextField Label="Goal"
                   Value="@_goal"
                   ValueChanged="value => _goal = value"
                   Placeholder="What this sprint is for"
                   TestId="sprint-start-goal" />
        <TextField Label="Starts on"
                   Type="date"
                   Value="@_day"
                   ValueChanged="OnDayChanged"
                   ErrorMessage="@_dayError"
                   TestId="sprint-start-day" />
        <Alert Message="@Error" TestId="sprint-start-error" />
    </ChildContent>
    <Footer>
        <AppButton Variant="ButtonVariant.Ghost" OnClick="() => OpenChanged.InvokeAsync(false)" TestId="sprint-start-cancel">Cancel</AppButton>
        <AppButton Variant="ButtonVariant.Primary" Busy="Busy" BusyLabel="Starting" OnClick="StartAsync" TestId="sprint-start-confirm">Start @SprintName</AppButton>
    </Footer>
</Modal>

@code {
    private const string DayFormat = "yyyy-MM-dd";

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>The name the first sprint will carry — "Sprint 1".</summary>
    [Parameter]
    public string SprintName { get; set; } = "the sprint";

    /// <summary>The series the sprint belongs to.</summary>
    [Parameter]
    public string SeriesName { get; set; } = string.Empty;

    /// <summary>The weekday every sprint of the series starts on.</summary>
    [Parameter]
    public DayOfWeek StartWeekday { get; set; } = DayOfWeek.Monday;

    /// <summary>The day the field starts at on each opening.</summary>
    [Parameter]
    public DateOnly DefaultStart { get; set; }

    /// <summary>Start was pressed on a day of the start weekday: the day and the goal,
    /// trimmed.</summary>
    [Parameter]
    public EventCallback<SprintStart> OnStart { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    /// <summary>Why the start was refused, in the module's words.</summary>
    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public string? TestId { get; set; } = "sprint-start-dialog";

    private string? _goal;
    private string? _day;
    private string? _dayError;
    private bool _wasOpen;

    protected override void OnParametersSet()
    {
        if (Open && !_wasOpen)
        {
            _goal = null;
            _day = DefaultStart.ToString(DayFormat, CultureInfo.InvariantCulture);
            _dayError = null;
        }

        _wasOpen = Open;
    }

    private void OnDayChanged(string? value)
    {
        _day = value;
        _dayError = null;
    }

    private Task StartAsync()
    {
        if (!DateOnly.TryParseExact(_day, DayFormat, CultureInfo.InvariantCulture, DateTimeStyles.None, out var day))
        {
            _dayError = "Pick the day the sprint starts.";
            return Task.CompletedTask;
        }

        if (!SprintStartRules.IsStartDay(day, StartWeekday))
        {
            _dayError = $"Pick a {StartWeekday}: sprints of {SeriesName} start on one.";
            return Task.CompletedTask;
        }

        _dayError = null;
        return OnStart.InvokeAsync(new SprintStart(day, _goal?.Trim() ?? string.Empty));
    }
}
