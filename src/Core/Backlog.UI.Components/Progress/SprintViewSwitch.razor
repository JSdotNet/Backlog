@*
    The In progress tab's Now | Sprint n switch (.devbook/domain/progress/features.md
    #following-a-sprint): Now is the view by task, Sprint n the sprint view of the
    series in scope. A radio group of two, one checked — the host decides
    which and is told of a press, so it sits in the header of whichever view is drawn
    and never moves.
*@

<ButtonGroup CssClass="sprint-view-switch" AriaLabel="View" Radio="true" TestId="@TestId">
    <ToggleButton Pressed="@(!Sprint)"
                  TestId="@($"{TestId}-now")"
                  PressedChanged="_ => Choose(false)">Now</ToggleButton>
    <ToggleButton Pressed="@Sprint"
                  TestId="@($"{TestId}-sprint")"
                  PressedChanged="_ => Choose(true)">@SprintName</ToggleButton>
</ButtonGroup>

@code {
    /// <summary>Whether the sprint view is the one showing.</summary>
    [Parameter]
    public bool Sprint { get; set; }

    /// <summary>Raised with true for the sprint view and false for Now. Pressing the
    /// side already showing raises nothing.</summary>
    [Parameter]
    public EventCallback<bool> SprintChanged { get; set; }

    /// <summary>The sprint the switch names, "Sprint 42".</summary>
    [Parameter, EditorRequired]
    public string SprintName { get; set; } = string.Empty;

    [Parameter]
    public string TestId { get; set; } = "in-progress-view-switch";

    // A radio group: a press always names its own side, and the side already showing
    // stays.
    private Task Choose(bool sprint) => sprint == Sprint ? Task.CompletedTask : SprintChanged.InvokeAsync(sprint);
}
