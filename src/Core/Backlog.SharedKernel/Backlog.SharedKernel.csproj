<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared kernel: the small set of types every module is allowed to depend on.
    Keep this deliberately thin — it is a contract surface, not a utility dump.
    Nothing here may reference a module, an infrastructure adapter, or a host.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.SharedKernel</RootNamespace>
  </PropertyGroup>

  <!-- MarkdownSourceBlocks fails safe on a parse whose spans cannot be trusted,
       and the parser never hands it one; its tests hand it one directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Backlog.SharedKernel.UnitTests" />
  </ItemGroup>

</Project>
