@namespace Backlog.Mobile.UI.Components.Notifications
@using Backlog.Mobile.UI.Notifications
@using Backlog.Modules.Notifications.Abstractions
@inject TimeProvider Clock

@*
    One notification on the phone, as the proposal's phone mockup draws it: the
    kind and severity with its age, where it came from (the origin's system badge
    and place, as the desktop card draws them), the title, the summary, the answer controls
    while the phone may answer, where it stands, and the desktop that owns it
    with whether that desktop is running (.devbook/domain/notifications/context.md).

    The list draws it without the body and links the title to the detail; the
    detail draws the Markdown body through MarkdownView, so a ```mermaid fence is
    a diagram like it is everywhere else.

    The answer controls are NotificationAnswerControls, the one implementation of
    the answer shapes, which the pager draws too.
    The tray offers no actions for a question with a choice that takes text, so
    this card is where the phone answers it.
    A question that says answerOn: owner draws none: only its owner takes an
    answer. An alert draws none either; acknowledging one stays on the desktop.

    The card answers nothing itself. It raises OnReply, the page queues the reply
    through the outbox, and the card shows where the reply stands from then on —
    waiting to send, waiting for the owner, rejected with the owner's reason (and
    the controls back, to answer again), or the owner's answer: from this phone,
    or from elsewhere with the answer that won.
*@

<article class="phone-notification" data-testid="notification-card" data-standing="@StandingSlug"
         data-notification="@Notification.Id" aria-labelledby="@TitleId">
    <header class="phone-notification__meta">
        <span class="phone-notification__tags">
            <Badge BaseClass="phone-notification__tag" Kind="" Slug="@KindSlug" TestId="notification-kind">@KindLabel</Badge>
            <Badge BaseClass="phone-notification__tag" Kind="" Slug="@SeveritySlug" TestId="notification-severity">@SeverityLabel</Badge>
        </span>
        <span class="phone-notification__age" data-testid="notification-age">@Age</span>
    </header>

    @if (Item.Origin is { } origin)
    {
        <p class="phone-notification__origin" data-testid="notification-origin">
            <Badge Kind="notification-origin" Slug="system" TestId="notification-origin-system">@origin.System</Badge>
            @if (!string.IsNullOrWhiteSpace(origin.Place))
            {
                <span class="phone-notification__place" data-testid="notification-origin-place">@origin.Place</span>
            }
        </p>
    }

    @if (Href is not null)
    {
        <h2 class="phone-notification__title" id="@TitleId">
            <a href="@Href" data-testid="notification-open">@Item.Title</a>
        </h2>
    }
    else
    {
        <h1 class="phone-notification__title" id="@TitleId" data-testid="notification-title">@Item.Title</h1>
    }

    @if (!string.IsNullOrWhiteSpace(Item.Summary))
    {
        <p class="phone-notification__summary" data-testid="notification-summary">@Item.Summary</p>
    }

    @if (ShowBody && !string.IsNullOrWhiteSpace(Item.BodyMarkdown))
    {
        <div class="phone-notification__body" data-testid="notification-body">
            <MarkdownView Blocks="@MarkdownPreview.ParseDocument(Item.BodyMarkdown)" Source="@Item.BodyMarkdown" />
        </div>
    }

    @if (Notification.Standing == NotificationStanding.Rejected && !string.IsNullOrWhiteSpace(Notification.Verdict))
    {
        <Alert Message="@RejectedText" Inline="true" TestId="notification-rejected" />
    }

    <NotificationAnswerControls Notification="@Notification" Busy="@Busy" OnReply="@OnReply" />

    <Alert Message="@StandingText" Role="status" BaseClass="phone-notification__standing" TestId="notification-standing" />

    @if (Notification.Waiting is { IsParked: true, Refused: false } parked)
    {
        <Alert Message="@($"Your answer is not sent yet: {parked.LastError}")"
               Inline="true"
               ActionLabel="Try again"
               OnAction="() => OnRetry.InvokeAsync(parked.Id)"
               ActionTestId="notification-retry"
               TestId="notification-stuck" />
    }

    <p class="phone-notification__owner" data-testid="notification-owner">
        @if (Notification.Presence != OwnerPresence.Unknown)
        {
            <StatusDot Tone="@(Notification.Presence == OwnerPresence.Online ? FlowStepTone.Done : FlowStepTone.Pending)"
                       CssClass="phone-notification__presence" TestId="notification-presence" />
        }
        @OwnerLine
    </p>
</article>

@code {
    private readonly string _titleId = "notification-" + Guid.NewGuid().ToString("N");

    /// <summary>The notification and where it stands for this phone.</summary>
    [Parameter, EditorRequired]
    public PhoneNotification Notification { get; set; } = default!;

    /// <summary>Where the title leads — the detail — or null on the detail itself, where the
    /// title is the page's heading.</summary>
    [Parameter]
    public string? Href { get; set; }

    /// <summary>Whether the Markdown body is drawn: on the detail, not in the list.</summary>
    [Parameter]
    public bool ShowBody { get; set; }

    /// <summary>True while the host is keeping a reply.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>The picked choice ids and the typed text, for the host to queue.</summary>
    [Parameter]
    public EventCallback<NotificationAnswerPick> OnReply { get; set; }

    /// <summary>A parked reply's outbox entry, to try again.</summary>
    [Parameter]
    public EventCallback<Guid> OnRetry { get; set; }

    private NotificationSnapshot Item => Notification.Notification;

    private string TitleId => _titleId;

    private string KindSlug => Item.Kind == NotificationKind.Question ? "question" : "alert";

    private string KindLabel => Item.Kind == NotificationKind.Question ? "Question" : "Alert";

    private string SeveritySlug => Item.Severity.ToString().ToLowerInvariant();

    private string SeverityLabel => Item.Severity switch
    {
        NotificationSeverity.Critical => "Critical",
        NotificationSeverity.Warning => "Warning",
        _ => "Info"
    };

    private string StandingSlug => Notification.Standing switch
    {
        NotificationStanding.OwnerOnly => "owner-only",
        NotificationStanding.AwaitingOwner => "awaiting-owner",
        NotificationStanding.AnsweredHere => "answered-here",
        NotificationStanding.AnsweredElsewhere => "answered-elsewhere",
        var other => other.ToString().ToLowerInvariant()
    };

    private string Age => SyncStatusLine.Relative(Clock.GetUtcNow() - Item.CreatedAt);

    private string OwnerWord => string.IsNullOrWhiteSpace(Notification.OwnerName) ? "The desktop" : Notification.OwnerName!;

    /// <summary>The owner's reason, or cloud sync's refusal when the reply never reached it.</summary>
    private string RejectedText => Notification.Waiting is { Refused: true }
        ? $"Your answer was not sent: {Notification.Verdict} You can answer again."
        : $"{OwnerWord} turned your answer down: {Notification.Verdict} You can answer again.";

    private string OwnerName => string.IsNullOrWhiteSpace(Notification.OwnerName) ? "a desktop" : Notification.OwnerName!;

    private string OwnerLine => Notification.Presence switch
    {
        OwnerPresence.Online => $"Owned by {OwnerName} · online",
        OwnerPresence.Offline when Notification.OwnerSeenAt is { } seen =>
            $"Owned by {OwnerName} · offline since {Local(seen)}, delivers on wake",
        OwnerPresence.Offline => $"Owned by {OwnerName} · offline, delivers on wake",
        _ => $"Owned by {OwnerName}"
    };

    private string? StandingText => Notification.Standing switch
    {
        NotificationStanding.OwnerOnly => $"Only {OwnerName} takes an answer to this one.",
        NotificationStanding.Sending when Notification.Waiting is { IsParked: true, Refused: false } => null,
        NotificationStanding.Sending => "Your answer is waiting to be sent.",
        NotificationStanding.AwaitingOwner when Notification.Presence == OwnerPresence.Offline =>
            $"Answer sent. It counts once {OwnerName} wakes and accepts it.",
        NotificationStanding.AwaitingOwner => $"Answer sent, waiting for {OwnerName} to accept it.",
        NotificationStanding.AnsweredHere => $"Answered from this phone · {Notification.Verdict}",
        NotificationStanding.AnsweredElsewhere => $"Answered elsewhere · {Notification.Verdict}",
        NotificationStanding.Acknowledged => "Acknowledged",
        NotificationStanding.Closed => Notification.Verdict is { } reason ? $"Closed · {reason}" : "Closed",
        _ => null
    };

    private string Local(DateTimeOffset at)
    {
        var local = TimeZoneInfo.ConvertTime(at, Clock.LocalTimeZone);
        var now = TimeZoneInfo.ConvertTime(Clock.GetUtcNow(), Clock.LocalTimeZone);

        return Backlog.Mobile.UI.Notes.NoteTimeLabel.For(local, now);
    }
}
