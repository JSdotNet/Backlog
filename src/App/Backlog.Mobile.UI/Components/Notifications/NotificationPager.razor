@namespace Backlog.Mobile.UI.Components.Notifications
@using Backlog.Mobile.UI.Notifications
@inject NotificationViewProjection Projection
@inject TimeProvider Clock
@inject IJSRuntime Js
@implements IAsyncDisposable

@*
    The Notifications tab's default view: one open item waiting on the person per
    screen, oldest first (NotificationStack), as
    .devbook/domain/notifications/features.md#answering-from-another-device describes.

    Each screen is the whole PhoneNotificationCard with its Markdown body. The page
    scrolls the card; the answer controls stay pinned at the bottom above the tab bar
    (app.css), so they are in reach wherever the body is read. An owner-only question
    shows the card's "only the desktop takes an answer" line and no controls; an
    alert shows none either — acknowledging one stays on the desktop.

    A horizontal swipe (swipe-pager.js) moves to the next or previous item and never
    answers: it is ignored when it starts on a control, and a mostly vertical drag is
    the page scrolling. Previous and Next buttons beside it do the same, because every
    gesture has a control beside it (design/component-libraries.md). While a reply
    is kept they are busy, not disabled: they keep their tab stop, say aria-disabled
    and ignore a press (.devbook/design/interaction-guidelines.md#accessibility). Previous
    on the first card, and Next on the end screen, have nowhere to go: unavailable
    rather than waiting, they keep the native disabled. Neither shows the spinner: the pressed
    answer is the trigger and carries it.

    An answer is a tap on the controls. The reply is queued through
    NotificationViewProjection.ReplyAsync, the only write; the confirmation names the
    answer, the card stays for ConfirmationPause, then the pager lands on the next
    item and the confirmation goes with the card it was about. The card slides in on
    the motion tokens, and not at all under reduced motion. After every move the focus
    goes to the card it lands on, or to the end screen.

    A swipe that starts inside something scrolling sideways (a wide code block or
    table) is that scroller's, not the pager's.

    Past the last item: "All caught up", or how many were skipped and how many arrived
    since, with a way through them again.
*@

<section class="notifications-pager" aria-label="Notifications, one at a time" data-testid="notifications-pager">
    <div class="notifications-pager__nav">
        <AppButton Variant="ButtonVariant.Secondary"
                   Disabled="@(!_stack.CanGoPrevious)"
                   aria-disabled="@Blocked"
                   CssClass="notifications-pager__step"
                   TestId="notifications-pager-previous"
                   OnClick="Previous">Previous</AppButton>

        <span class="notifications-pager__where">
            <span class="notifications-pager__position" aria-live="polite" data-testid="notifications-pager-position">@PositionText</span>
            @if (_stack.Total > 1)
            {
                <span class="notifications-pager__dots" aria-hidden="true" data-testid="notifications-pager-dots">
                    @foreach (var item in _stack.Items)
                    {
                        <span @key="item.Id" class="@DotClass(item)"></span>
                    }
                </span>
            }
        </span>

        <AppButton Variant="ButtonVariant.Secondary"
                   Disabled="@(!_stack.CanGoNext)"
                   aria-disabled="@Blocked"
                   CssClass="notifications-pager__step"
                   TestId="notifications-pager-next"
                   OnClick="Next">Next</AppButton>
    </div>

    <Alert Message="@_confirmation" Role="status" BaseClass="notifications-pager__confirmation" TestId="notifications-pager-confirmation" />
    <Alert Message="@_replyError" Role="status" BaseClass="capture__notice" TestId="notifications-pager-reply-error" />

    <div class="notifications-pager__surface" @ref="_surface" data-testid="notifications-pager-surface">
        @if (_stack.Current is { } current)
        {
            @* Focus lands here after every move: the card, named by its title. *@
            <div class="notifications-pager__card" @key="current.Id" @ref="_focusTarget"
                 tabindex="-1" role="group" aria-label="@current.Notification.Title" data-testid="notifications-pager-card">
                <PhoneNotificationCard Notification="current"
                                       Href="@($"notifications/{current.Id}")"
                                       ShowBody="true"
                                       Busy="_answering"
                                       OnReply="pick => ReplyAsync(current, pick)" />
            </div>
        }
        else if (_stack.End is { } end)
        {
            <div class="notifications-pager__end" @ref="_focusTarget" tabindex="-1" data-testid="notifications-pager-end-screen">
                @if (end.AllCaughtUp)
                {
                    <EmptyState Title="All caught up"
                                Description="Nothing is waiting for you."
                                TestId="notifications-pager-done">
                        <Action>
                            <AppButton Variant="ButtonVariant.Secondary" CssClass="notifications-pager__action"
                                       TestId="notifications-pager-show-list" OnClick="ShowList">Show all notifications</AppButton>
                        </Action>
                    </EmptyState>
                }
                else
                {
                    <EmptyState Title="@EndTitle(end)"
                                Description="They are still waiting for you."
                                TestId="notifications-pager-end">
                        <Action>
                            <AppButton Variant="ButtonVariant.Primary" CssClass="notifications-pager__action"
                                       TestId="notifications-pager-again" OnClick="Restart">Go through them again</AppButton>
                        </Action>
                    </EmptyState>
                }
            </div>
        }
    </div>
</section>

@code {
    /// <summary>How long the confirmation shows with its card before the pager moves on and
    /// clears it, so it never stands over the next, unanswered card.</summary>
    public static readonly TimeSpan ConfirmationPause = TimeSpan.FromMilliseconds(1200);

    private readonly CancellationTokenSource _disposing = new();
    private NotificationStack _stack = new([]);
    private IReadOnlyList<PhoneNotification>? _shown;
    private bool _answering;
    private bool _moved;
    private bool _disposed;
    private string? _confirmation;
    private string? _replyError;
    private ElementReference _surface;
    private ElementReference _focusTarget;
    private IJSObjectReference? _module;
    private IJSObjectReference? _gesture;
    private DotNetObjectReference<NotificationPager>? _self;

    /// <summary>Every notification the phone holds, as the projection orders them; the
    /// pager keeps those waiting on the person. A new list is a refresh.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<PhoneNotification> Notifications { get; set; } = [];

    /// <summary>Switches the tab to the list of every notification.</summary>
    [Parameter]
    public EventCallback OnShowList { get; set; }

    /// <summary>aria-disabled for Previous and Next while a reply is kept. Never the native
    /// attribute: that would drop the button from the tab order and take the focus off it
    /// mid-act. Next and Previous drop the press themselves.</summary>
    private string? Blocked => _answering ? "true" : null;

    /// <summary>"n / total" on a card — the accessible position the dots only echo — and
    /// nothing past the end, where the end screen speaks for itself.</summary>
    private string PositionText => _stack.Position is { } position ? $"{position} / {_stack.Total}" : string.Empty;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(Notifications, _shown)) return;

        if (_shown is null) _stack = new NotificationStack(Notifications);
        else _stack.Refresh(Notifications);

        _shown = Notifications;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AttachSwipeAsync();
            return;
        }

        if (!_moved) return;
        _moved = false;

        try
        {
            // A move replaces the card the focus was on; without this it falls to the page
            // and a screen reader starts again from the top.
            await _focusTarget.FocusAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // Nothing to focus where there is no browser.
        }
    }

    private async Task AttachSwipeAsync()
    {
        try
        {
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/Backlog.Mobile.UI/swipe-pager.js");
            if (_module is null || _disposed)
            {
                await ReleaseAsync();
                return;
            }

            _self = DotNetObjectReference.Create(this);
            _gesture = await _module.InvokeAsync<IJSObjectReference>("attach", _surface, _self);

            // Disposed while the module loaded or attached: what arrived late is let go here,
            // since DisposeAsync found nothing to let go of.
            if (_disposed) await ReleaseAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // No gesture where there is no browser; Previous and Next still work.
        }
    }

    /// <summary>A horizontal swipe on the card: <c>next</c> or <c>previous</c>. It moves and
    /// never answers.</summary>
    [JSInvokable]
    public Task OnSwiped(string direction) => InvokeAsync(() =>
    {
        if (direction == "next") Next();
        else if (direction == "previous") Previous();
        StateHasChanged();
    });

    private string DotClass(PhoneNotification item) => item.Id == _stack.Current?.Id
        ? "notifications-pager__dot notifications-pager__dot--current"
        : "notifications-pager__dot";

    private static string EndTitle(NotificationStackEnd end)
    {
        var parts = new List<string>(2);
        if (end.Skipped > 0) parts.Add($"{end.Skipped} skipped");
        if (end.New > 0) parts.Add($"{end.New} new");
        return string.Join(" · ", parts);
    }

    private void Next()
    {
        if (_answering || !_stack.CanGoNext) return;
        Moved();
        _stack.Next();
    }

    private void Previous()
    {
        if (_answering || !_stack.CanGoPrevious) return;
        Moved();
        _stack.Previous();
    }

    private void Restart()
    {
        Moved();
        _stack.Restart();
    }

    /// <summary>Every move clears what was said about the card left behind, and takes the
    /// focus to the card it lands on.</summary>
    private void Moved()
    {
        _confirmation = null;
        _replyError = null;
        _moved = true;
    }

    private Task ShowList() => OnShowList.InvokeAsync();

    private async Task ReplyAsync(PhoneNotification item, NotificationAnswerPick pick)
    {
        if (_answering) return;

        _answering = true;
        _confirmation = null;
        _replyError = null;
        _stack.BeginAnswer(item.Id);

        NotificationReplyPost? reply;
        try
        {
            reply = await Projection.ReplyAsync(item.Id, pick.ChoiceIds, pick.Text, pick.Note);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // The phone could not keep the reply — its own file, not the network, which the
            // outbox rides out. The card stays, to be answered again.
            _stack.CancelAnswer();
            _answering = false;
            _replyError = NotificationStandings.CouldNotKeepAnswer;
            return;
        }

        if (reply is null)
        {
            // Not one the phone may answer now: the next refresh says where it stands.
            _stack.CancelAnswer();
            _answering = false;
            return;
        }

        _confirmation = NotificationStandings.Confirmation(item.Notification.AnswerSpec, pick);
        StateHasChanged();

        if (_disposed) return;

        try
        {
            await Task.Delay(ConfirmationPause, Clock, _disposing.Token);
        }
        catch (OperationCanceledException)
        {
            // The pager went away during the pause; the reply is already queued.
            return;
        }

        Moved();
        _stack.AfterAnswer(item.Id);
        _answering = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await _disposing.CancelAsync();
        _disposing.Dispose();
        await ReleaseAsync();
    }

    private async Task ReleaseAsync()
    {
        try
        {
            if (_gesture is not null)
            {
                await _gesture.InvokeVoidAsync("dispose");
                await _gesture.DisposeAsync();
                _gesture = null;
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
                _module = null;
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // The view is gone with the page; nothing is left to detach from.
        }

        _self?.Dispose();
        _self = null;
    }
}
