@namespace Backlog.Mobile.UI.Components.Notifications
@using Backlog.Mobile.UI.Notifications
@using Backlog.Modules.Notifications.Abstractions

@*
    The answer controls of one notification on the phone: the one implementation of the
    answer shapes, which the card (list and detail) and the pager both draw
    (.devbook/domain/notifications/features.md#answering-from-another-device).

    They follow the question's shape and nothing else:
      single choice      one AppButton per set answer, pressed to answer; a choice
                         that takes text opens a plain-text TextArea with Send
                         instead, and answers with the choice and its words
      multiple choice    one Checkbox per set answer, and Answer to send the picks
      open               a plain-text TextArea and Send
      choices with open  the buttons, and the box with Send below them
    The choices stack full width, one per row, so every button is the same width;
    seven or eight wrap into two even columns. A question that takes a note adds
    "Add a note (optional)" beside the last Send or Answer (on its own row under
    choice buttons alone), folded until the person opens it; the box opens under
    the answers, and whatever is in it goes with the answer.

    Nothing is drawn unless the phone may answer now (PhoneNotification.CanAnswer):
    a question that says answerOn: owner, an alert, and a reply on its way draw none.

    The controls answer nothing themselves. They raise OnReply, and the host queues
    the reply through the outbox. Handed another notification, they start over.
*@

@if (Notification.CanAnswer && Spec is { } spec)
{
    <div class="phone-notification__answer" data-testid="notification-answer">
        @if (spec.AllowMultiple)
        {
            <fieldset class="phone-notification__checks" data-testid="notification-checkboxes">
                <legend class="phone-notification__legend">@PickHint(spec)</legend>
                @foreach (var choice in spec.Choices)
                {
                    <Checkbox Label="@choice.Label"
                              Checked="@_picked.Contains(choice.Id)"
                              CheckedChanged="@(on => Toggle(choice.Id, on))"
                              Disabled="@Busy"
                              TestId="@($"notification-check-{choice.Id}")" />
                }
            </fieldset>
            <div class="phone-notification__choices">
                <AppButton Variant="ButtonVariant.Primary"
                           Busy="@Busy"
                           BusyLabel="Answering"
                           Disabled="@(!NotificationStandings.Fits(spec, _picked, null, _note))"
                           TestId="notification-submit"
                           OnClick="SubmitPicksAsync">Answer</AppButton>
                @if (spec.Open is null)
                {
                    @NoteToggle(spec)
                }
            </div>
        }
        else if (spec.Choices.Count > 0)
        {
            <div class="@ChoicesClass(spec)" data-testid="notification-choices">
                @foreach (var choice in spec.Choices)
                {
                    <AppButton Variant="@VariantFor(choice.Style)"
                               Disabled="@Busy"
                               TestId="@($"notification-choice-{choice.Id}")"
                               OnClick="@(() => ChooseAsync(choice))">@choice.Label</AppButton>
                }
            </div>

            @if (Composing is { } composing)
            {
                <div class="phone-notification__open" data-testid="notification-choice-text">
                    <TextArea Label="@($"{composing.Label}: in your own words")"
                              @bind-Value="_choiceText"
                              Placeholder="@(composing.Placeholder ?? "Write what you mean…")"
                              Disabled="@Busy"
                              Rows="2"
                              maxlength="@(spec.Open?.MaxLength ?? OpenAnswer.DefaultMaxLength)" />
                    <div class="phone-notification__choices">
                        <AppButton Variant="ButtonVariant.Primary"
                                   Busy="@Busy"
                                   BusyLabel="Sending"
                                   Disabled="@(!NotificationStandings.Fits(spec, [composing.Id], _choiceText, _note))"
                                   TestId="notification-choice-send"
                                   OnClick="@(() => ReplyAsync([composing.Id], _choiceText))">Send</AppButton>
                        <AppButton Variant="ButtonVariant.Secondary"
                                   Disabled="@Busy"
                                   TestId="notification-choice-cancel"
                                   OnClick="CancelChoiceText">Cancel</AppButton>
                    </div>
                </div>
            }
        }

        @if (spec.Open is { } open)
        {
            <div class="phone-notification__open" data-testid="notification-open-answer">
                <TextArea Label="@(spec.Choices.Count > 0 ? "Or answer in your own words" : "Your answer")"
                          @bind-Value="_text"
                          Placeholder="@(open.Placeholder ?? "Write an answer…")"
                          Disabled="@Busy"
                          Rows="2"
                          TestId="notification-text"
                          maxlength="@open.MaxLength" />
                <div class="phone-notification__choices">
                    <AppButton Variant="@(spec.Choices.Count > 0 ? ButtonVariant.Secondary : ButtonVariant.Primary)"
                               Busy="@Busy"
                               BusyLabel="Sending"
                               Disabled="@(string.IsNullOrWhiteSpace(_text))"
                               TestId="notification-send"
                               OnClick="@(() => ReplyAsync([], _text))">Send</AppButton>
                    @NoteToggle(spec)
                </div>
            </div>
        }

        @if (spec.Note is { } note)
        {
            @if (spec.Open is null && !spec.AllowMultiple)
            {
                <div class="phone-notification__choices">@NoteToggle(spec)</div>
            }
            <div class="phone-notification__note" id="@_noteRegionId" hidden="@(!_noteOpen)" data-testid="notification-note">
                <TextArea Label="Note"
                          @bind-Value="_note"
                          Placeholder="@note.Placeholder"
                          Disabled="@Busy"
                          Rows="2"
                          TestId="notification-note-text"
                          maxlength="@note.MaxLength" />
            </div>
        }
    </div>
}

@code {
    private readonly HashSet<string> _picked = new(StringComparer.Ordinal);
    private string? _text;
    private string? _composing;
    private string? _choiceText;
    private string? _note;
    private bool _noteOpen;
    private readonly string _noteRegionId = "notification-note-" + Guid.NewGuid().ToString("N");
    private Guid _shownId;

    /// <summary>The notification to answer and where it stands for this phone.</summary>
    [Parameter, EditorRequired]
    public PhoneNotification Notification { get; set; } = default!;

    /// <summary>True while the host is keeping a reply.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>The picked choice ids and the typed text, for the host to queue.</summary>
    [Parameter]
    public EventCallback<NotificationAnswerPick> OnReply { get; set; }

    private AnswerSpec? Spec => Notification.Notification.AnswerSpec;

    protected override void OnParametersSet()
    {
        // Controls handed another notification start their answer over.
        if (_shownId == Notification.Id) return;

        _shownId = Notification.Id;
        _picked.Clear();
        _text = null;
        _composing = null;
        _choiceText = null;
        _note = null;
        _noteOpen = false;
    }

    /// <summary>
    /// The fold that opens the note box. It sits beside the last Send or Answer, so a
    /// folded note costs no row of its own; with only choice buttons it gets one.
    /// </summary>
    private RenderFragment NoteToggle(AnswerSpec spec) => spec.Note is null
        ? _ => { }
        : @<FoldControl Label="Add a note (optional)"
                        Expanded="_noteOpen"
                        ExpandedChanged="open => _noteOpen = open"
                        Controls="@_noteRegionId"
                        CssClass="phone-notification__note-toggle"
                        TestId="notification-note-toggle" />;

    /// <summary>The choices stack full width, one per row; seven or eight wrap into two even columns.</summary>
    private static string ChoicesClass(AnswerSpec spec) => spec.Choices.Count >= 7
        ? "phone-notification__choices phone-notification__choices--many"
        : "phone-notification__choices phone-notification__choices--stack";

    private static string PickHint(AnswerSpec spec)
    {
        var least = spec.MinChoices ?? 1;
        var most = spec.MaxChoices ?? spec.Choices.Count;

        return least == most ? $"Pick {least}" : most >= spec.Choices.Count ? $"Pick {least} or more" : $"Pick {least} to {most}";
    }

    private static ButtonVariant VariantFor(AnswerChoiceStyle style) => style switch
    {
        AnswerChoiceStyle.Primary => ButtonVariant.Primary,
        AnswerChoiceStyle.Destructive => ButtonVariant.Danger,
        _ => ButtonVariant.Secondary
    };

    private void Toggle(string id, bool on)
    {
        if (on) _picked.Add(id);
        else _picked.Remove(id);
    }

    /// <summary>The choice whose words are being typed, or null.</summary>
    private AnswerChoice? Composing => _composing is null
        ? null
        : Spec?.Choices.FirstOrDefault(choice => string.Equals(choice.Id, _composing, StringComparison.Ordinal));

    private Task ChooseAsync(AnswerChoice choice)
    {
        if (choice.TakesText)
        {
            // Its words come first: the box opens and nothing is queued until Send.
            if (!string.Equals(_composing, choice.Id, StringComparison.Ordinal)) _choiceText = null;
            _composing = choice.Id;
            return Task.CompletedTask;
        }

        return ReplyAsync([choice.Id], null);
    }

    private void CancelChoiceText()
    {
        _composing = null;
        _choiceText = null;
    }

    private Task SubmitPicksAsync() =>
        ReplyAsync([.. Spec!.Choices.Where(choice => _picked.Contains(choice.Id)).Select(choice => choice.Id)], null);

    private async Task ReplyAsync(IReadOnlyList<string> choiceIds, string? text)
    {
        if (Busy) return;

        var note = Spec?.Note is not null && !string.IsNullOrWhiteSpace(_note) ? _note.Trim() : null;
        await OnReply.InvokeAsync(new NotificationAnswerPick(choiceIds, text, note));

        _picked.Clear();
        _text = null;
        _composing = null;
        _choiceText = null;
        _note = null;
        _noteOpen = false;
    }
}
