<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Backlog</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <NavList Items="NavItems" AriaLabel="Main" CssClass="flex-column" />
</div>

@code {
    // The template's icon spans are gone with the hand-rolled list; the shared
    // NavList carries the styling and the router-aware active state instead.
    private static readonly IReadOnlyList<NavItem> NavItems =
    [
        new("", "Home", Match: true),
        new("counter", "Counter"),
        new("weather", "Weather")
    ];
}
