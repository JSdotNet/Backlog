@inherits LayoutComponentBase

@*
    The shell is one page deep — Inbox is the only route — so there is no menu
    to collapse and nothing for a sidebar to hold. What is left is a title bar:
    the BlazorWebView fills the MAUI page edge to edge, so nothing else names
    the app on screen.
*@

<div class="page">
    <header class="app-bar">Backlog</header>

    <main class="content">
        @Body
    </main>
</div>
