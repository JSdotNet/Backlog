@inherits LayoutComponentBase
@using Backlog.Infrastructure.Sync
@using Backlog.Mobile.UI.Progress
@inject IDeviceCredentialStore Credentials
@inject SharedContentCapture SharedCapture
@inject ProgressViewProjection Progress
@inject AppLifecycle Lifecycle
@implements IDisposable

@*
    The phone's shell: a title bar that names the app and its version - the
    way into the update window - and says where sync stands, the page, and a
    row of tabs along the bottom where a thumb already is. The BlazorWebView
    fills the MAUI page edge to edge, so nothing else names the app on screen.

    The pairing gate lives here rather than in a page. Every tab needs a paired
    device, so every tab is gated once, the same way, and the pairing box is
    what the app opens on whichever route it opens on. The tabs are withheld
    until then: every one of them would lead back to the same box.

    Shares from other apps are taken here too, for the same reason: a share can
    arrive on any tab, and this is the one component every tab sits inside. A
    share made before pairing waits in the outbox with the rest.

    The Stand-up tab sits between Inbox and Notes only while goals are on, which
    the phone reads as holding a stand-up context (ProgressViewProjection.GoalsOn).
    The layout pulls Progress once it is drawn, again when the app comes back to
    the front and when the phone is paired anew, so the tab can appear on
    whichever tab the app is on — after a first pull that did not answer, or a
    desktop that turned goals on since — and draws the bar again whenever
    Progress changes.
*@

<div class="page">
    <LifecycleBridge />

    <header class="app-bar">
        <AppUpdateControl />
        <SyncStatus />
    </header>

    <main class="content">
        @if (Paired)
        {
            @Body
        }
        else
        {
            <PairingGate />
        }
    </main>

    @if (Paired)
    {
        <TabBar Items="Tabs" AriaLabel="Sections" CssClass="app-tabs" TestId="tab-bar" />
    }
</div>

@code {
    private static readonly IReadOnlyList<NavItem> TabsWithoutStandUp =
    [
        new("", "Today", Match: true),
        new("inbox", "Inbox"),
        new("notes", "Notes")
    ];

    private static readonly IReadOnlyList<NavItem> TabsWithStandUp =
    [
        new("", "Today", Match: true),
        new("inbox", "Inbox"),
        new("standup", "Stand-up"),
        new("notes", "Notes")
    ];

    private bool _pullingProgress;

    private IReadOnlyList<NavItem> Tabs => Progress.GoalsOn ? TabsWithStandUp : TabsWithoutStandUp;

    private bool Paired => Credentials.Current is not null;

    protected override void OnInitialized()
    {
        Credentials.Changed += OnCredentialsChanged;
        Progress.Changed += OnProgressChanged;
        Lifecycle.Resumed += OnResumed;
    }

    // Pairing is redeemed on the render thread, but a store may raise from
    // wherever it was saved; InvokeAsync is right in both cases.
    private void OnCredentialsChanged() => _ = InvokeAsync(() =>
    {
        StateHasChanged();
        return PullProgressAsync();
    });

    private void OnProgressChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnResumed() => _ = InvokeAsync(PullProgressAsync);

    /// <summary>
    /// Started after the first render rather than on initialisation: the browser
    /// harness prerenders on the server, and a share captured there would be
    /// captured again by the interactive render that follows.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        SharedCapture.Start(work => InvokeAsync(work));
        await PullProgressAsync();
    }

    /// <summary>
    /// Pulls Progress while a paired phone is on screen, so the Stand-up tab shows
    /// without the person having to find it first. One pull at a time; a failure
    /// leaves the bar as the phone last knew it and the next resume or pairing tries
    /// again. The Stand-up page is where a pull that did not answer is put in words.
    /// </summary>
    private async Task PullProgressAsync()
    {
        if (_pullingProgress || !Paired) return;
        _pullingProgress = true;

        try
        {
            await Progress.PullAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Said on the Stand-up page; tried again on the next resume.
        }
        finally
        {
            _pullingProgress = false;
        }
    }

    public void Dispose()
    {
        Credentials.Changed -= OnCredentialsChanged;
        Progress.Changed -= OnProgressChanged;
        Lifecycle.Resumed -= OnResumed;

        // The capture is the scope's and may outlive this layout; it must not
        // dispatch through a component the renderer has let go.
        SharedCapture.Stop();
    }
}
