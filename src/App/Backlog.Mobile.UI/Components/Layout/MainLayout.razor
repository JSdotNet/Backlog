@inherits LayoutComponentBase
@using Backlog.Infrastructure.Sync
@inject IDeviceCredentialStore Credentials
@inject SharedContentCapture SharedCapture
@implements IDisposable

@*
    The phone's shell: a title bar that says where sync stands, the page, and a
    row of tabs along the bottom where a thumb already is. The BlazorWebView
    fills the MAUI page edge to edge, so nothing else names the app on screen.

    The pairing gate lives here rather than in a page. Every tab needs a paired
    device, so every tab is gated once, the same way, and the pairing box is
    what the app opens on whichever route it opens on. The tabs are withheld
    until then: every one of them would lead back to the same box.

    Shares from other apps are taken here too, for the same reason: a share can
    arrive on any tab, and this is the one component every tab sits inside. A
    share made before pairing waits in the outbox with the rest.
*@

<div class="page">
    <LifecycleBridge />

    <header class="app-bar">
        <span class="app-bar__title">Backlog</span>
        <SyncStatus />
    </header>

    <main class="content">
        @if (Paired)
        {
            @Body
        }
        else
        {
            <PairingGate />
        }
    </main>

    @if (Paired)
    {
        <TabBar Items="Tabs" AriaLabel="Sections" CssClass="app-tabs" TestId="tab-bar" />
    }
</div>

@code {
    private static readonly IReadOnlyList<NavItem> Tabs =
    [
        new("", "Inbox", Match: true),
        new("note", "Note"),
        new("tasks", "Tasks")
    ];

    private bool Paired => Credentials.Current is not null;

    protected override void OnInitialized() => Credentials.Changed += OnCredentialsChanged;

    // Pairing is redeemed on the render thread, but a store may raise from
    // wherever it was saved; InvokeAsync is right in both cases.
    private void OnCredentialsChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// Started after the first render rather than on initialisation: the browser
    /// harness prerenders on the server, and a share captured there would be
    /// captured again by the interactive render that follows.
    /// </summary>
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) SharedCapture.Start(work => InvokeAsync(work));
    }

    public void Dispose()
    {
        Credentials.Changed -= OnCredentialsChanged;

        // The capture is the scope's and may outlive this layout; it must not
        // dispatch through a component the renderer has let go.
        SharedCapture.Stop();
    }
}
