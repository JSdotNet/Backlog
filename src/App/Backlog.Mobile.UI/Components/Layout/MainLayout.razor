@inherits LayoutComponentBase
@using Backlog.Infrastructure.Sync
@using Backlog.Mobile.UI.Notifications
@using Backlog.Mobile.UI.Progress
@inject IDeviceCredentialStore Credentials
@inject SharedContentCapture SharedCapture
@inject ProgressViewProjection Progress
@inject NotificationViewProjection Notifications
@inject AppLifecycle Lifecycle
@inject SyncCompatibility Compatibility
@implements IDisposable

@*
    The phone's shell: a title bar that names the app and its version - the
    way into the update window - and says where sync stands, the page, and a
    row of tabs along the bottom where a thumb already is. The BlazorWebView
    fills the MAUI page edge to edge, so nothing else names the app on screen.

    The pairing gate lives here rather than in a page. Every tab needs a paired
    device, so every tab is gated once, the same way, and the pairing box is
    what the app opens on whichever route it opens on. The tabs are withheld
    until then: every one of them would lead back to the same box.

    Shares from other apps are taken here too, for the same reason: a share can
    arrive on any tab, and this is the one component every tab sits inside. A
    share made before pairing waits in the outbox with the rest.

    The Stand-up tab sits between Inbox and Notes once a desktop has sent the
    stand-up, which the phone reads as holding a stand-up context
    (ProgressViewProjection.HoldsStandUp).
    The layout pulls Progress once it is drawn, again when the app comes back to
    the front and when the phone is paired anew, so the tab can appear on
    whichever tab the app is on — after a first pull that did not answer, or a
    desktop that set its first goal since — and draws the bar again whenever
    Progress changes.

    When the sync service is newer than this app, nothing syncs
    (SyncCompatibility) and a callout under the bar says so on every tab, with
    the update window as its one action. Queued captures wait in the outbox
    meanwhile; none is set aside.

    The Notifications tab follows Inbox once the phone holds a notification
    (NotificationViewProjection.HoldsAny): a desktop pushes them only with its
    notifications feature on, so a phone whose desktops have it off never shows
    the tab. The layout pulls the notification feed with Progress — once drawn,
    on every return to the front and on a new pairing — so a question reaches
    the phone on whichever tab it is (local ADR 0038).
*@

<div class="page">
    <LifecycleBridge />

    <header class="app-bar">
        <AppUpdateControl @ref="_updates" />
        <SyncStatus />
    </header>

    @if (Paired && Compatibility.UpdateRequired)
    {
        <Callout Tone="warning" Heading="Sync is paused"
                 ActionLabel="Update Backlog" OnAction="OpenUpdates"
                 ActionTestId="sync-update-required-action"
                 CssClass="app-sync-paused" TestId="sync-update-required">
            @SyncCompatibility.UpdateRequiredMessage
        </Callout>
    }

    <main class="content">
        @if (Paired)
        {
            @Body
        }
        else
        {
            <PairingGate />
        }
    </main>

    @if (Paired)
    {
        <TabBar Items="Tabs" AriaLabel="Sections" CssClass="app-tabs" TestId="tab-bar" />
    }
</div>

@code {
    // Every tab leads with a glyph, or none would: a bar where one tab has a
    // picture and the rest do not reads as that one being different. The glyphs
    // are drawn at icon-md and hidden from assistive technology, so each tab's
    // name stays its word (.devbook/design/interaction-guidelines.md#phone-tab-bar).
    private static readonly RenderFragment TodayGlyph = @<SunIcon Size="20" />;
    private static readonly RenderFragment InboxGlyph = @<InboxIcon Size="20" />;
    private static readonly RenderFragment StandUpGlyph = @<TargetIcon Size="20" />;
    private static readonly RenderFragment NotesGlyph = @<StickyNoteIcon Size="20" />;
    private static readonly RenderFragment NotificationsGlyph = @<BellIcon Size="20" />;

    private static readonly NavItem NotificationsTab = new("notifications", "Notifications", Icon: NotificationsGlyph);

    private static readonly IReadOnlyList<NavItem> TabsWithoutStandUp =
    [
        new("", "Today", Match: true, Icon: TodayGlyph),
        new("inbox", "Inbox", Icon: InboxGlyph),
        new("notes", "Notes", Icon: NotesGlyph)
    ];

    private static readonly IReadOnlyList<NavItem> TabsWithStandUp =
    [
        new("", "Today", Match: true, Icon: TodayGlyph),
        new("inbox", "Inbox", Icon: InboxGlyph),
        new("standup", "Stand-up", Icon: StandUpGlyph),
        new("notes", "Notes", Icon: NotesGlyph)
    ];

    private bool _pullingProgress;
    private bool _pullingNotifications;
    private AppUpdateControl? _updates;

    private IReadOnlyList<NavItem> Tabs
    {
        get
        {
            var tabs = Progress.HoldsStandUp ? TabsWithStandUp : TabsWithoutStandUp;

            // After Inbox: both are what reached the phone, and a question waiting is the
            // tab a person comes back for.
            return Notifications.HoldsAny ? [.. tabs.Take(2), NotificationsTab, .. tabs.Skip(2)] : tabs;
        }
    }

    private bool Paired => Credentials.Current is not null;

    protected override void OnInitialized()
    {
        Credentials.Changed += OnCredentialsChanged;
        Progress.Changed += OnProgressChanged;
        Notifications.Changed += OnNotificationsChanged;
        Lifecycle.Resumed += OnResumed;
        Compatibility.Changed += OnCompatibilityChanged;
    }

    // Raised on whichever thread asked the service.
    private void OnCompatibilityChanged() => _ = InvokeAsync(StateHasChanged);

    private void OpenUpdates() => _updates?.OpenWindow();

    // Pairing is redeemed on the render thread, but a store may raise from
    // wherever it was saved; InvokeAsync is right in both cases.
    private void OnCredentialsChanged() => _ = InvokeAsync(() =>
    {
        StateHasChanged();
        return PullAllAsync();
    });

    private void OnProgressChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnNotificationsChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnResumed() => _ = InvokeAsync(PullAllAsync);

    /// <summary>
    /// Started after the first render rather than on initialisation: the browser
    /// harness prerenders on the server, and a share captured there would be
    /// captured again by the interactive render that follows.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        SharedCapture.Start(work => InvokeAsync(work));
        await PullAllAsync();
    }

    private Task PullAllAsync() => Task.WhenAll(PullProgressAsync(), PullNotificationsAsync());

    /// <summary>
    /// Pulls the notification feed while a paired phone is on screen — on open and on every
    /// return to the front — so the tab appears, and a question reaches the phone, on whichever
    /// tab it is. One pull at a time; a failure leaves the phone as it last knew it, and the
    /// Notifications page is where it is put in words.
    /// </summary>
    private async Task PullNotificationsAsync()
    {
        if (_pullingNotifications || !Paired) return;
        _pullingNotifications = true;

        try
        {
            await Notifications.PullAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Said on the Notifications page; tried again on the next resume.
        }
        finally
        {
            _pullingNotifications = false;
        }
    }

    /// <summary>
    /// Pulls Progress while a paired phone is on screen, so the Stand-up tab shows
    /// without the person having to find it first. One pull at a time; a failure
    /// leaves the bar as the phone last knew it and the next resume or pairing tries
    /// again. The Stand-up page is where a pull that did not answer is put in words.
    /// </summary>
    private async Task PullProgressAsync()
    {
        if (_pullingProgress || !Paired) return;
        _pullingProgress = true;

        try
        {
            await Progress.PullAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Said on the Stand-up page; tried again on the next resume.
        }
        finally
        {
            _pullingProgress = false;
        }
    }

    public void Dispose()
    {
        Credentials.Changed -= OnCredentialsChanged;
        Progress.Changed -= OnProgressChanged;
        Notifications.Changed -= OnNotificationsChanged;
        Lifecycle.Resumed -= OnResumed;
        Compatibility.Changed -= OnCompatibilityChanged;

        // The capture is the scope's and may outlive this layout; it must not
        // dispatch through a component the renderer has let go.
        SharedCapture.Stop();
    }
}
