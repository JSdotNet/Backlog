@using System.Globalization
@using Backlog.Modules.Progress.Abstractions
@using Backlog.Modules.Progress.Abstractions.DataTransferObjects

@*
    One pull request's line on the phone's stand-up and goal pages: its number as
    a chip in the tone of its state — merged the success tone, open the alert tone,
    a draft dashed and neutral — and its two status marks, checks and approvals,
    as a desktop last read them (.devbook/domain/progress/features.md#pull-request-status,
    .devbook/design/color-scheme.md#pull-request-status-marks).

    The visible marks print counts only; the words "checks" and "approvals" are
    for a screen reader, which hears "14 of 14 checks passed" and "1 of 2
    approvals" while the counts beside them are hidden from it
    (.devbook/domain/progress/requirements.md, the checks and approvals marks).
    A mark nothing was read for is left out rather than guessed, and a merged pull
    request draws none: its checks and approvals no longer decide anything.

    A stand-in for the shared PullRequestStatus a parallel change adds to the
    component library for the desktop's Goals view. It lives on the phone only
    because the two land separately; once both have, the phone's pages render the
    library's component and this one goes.
*@

<span class="@ClassValue" data-testid="@TestId">
    <Badge Kind="standup-pr" Slug="@Slug" TestId="@PartTestId("number")">#@Number<span class="sr-only">@($" {StateWord}")</span></Badge>
    @if (State != LinkedPullRequestState.Merged && Checks is { Total: > 0 } checks)
    {
        var variant = checks.Failed > 0 ? "failing" : checks.Pending > 0 ? "running" : "passed";
        <span class="@($"pr-line__mark pr-line__mark--{variant}")" data-testid="@PartTestId("checks")">
            @if (variant == "passed")
            {
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M8 12l3 3 5-6" /></svg>
            }
            else if (variant == "running")
            {
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5"
                     stroke-linecap="round" stroke-dasharray="3 3" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /></svg>
            }
            else
            {
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M15 9l-6 6M9 9l6 6" /></svg>
            }
            <span aria-hidden="true">@checks.Passed/@checks.Total</span>
            <span class="sr-only">@ChecksWords(checks, variant)</span>
        </span>
    }
    @if (State != LinkedPullRequestState.Merged && Approvals is { Required: > 0 } approvals)
    {
        var met = approvals.Received >= approvals.Required;
        <span class="@(met ? "pr-line__mark pr-line__mark--met" : "pr-line__mark pr-line__mark--short")" data-testid="@PartTestId("approvals")">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="4" /><path d="M2 21c0-4 3-6 7-6" /><path d="M14 18l2 2 5-5" /></svg>
            <span aria-hidden="true">@approvals.Received/@approvals.Required</span>
            <span class="sr-only">@($"{approvals.Received} of {approvals.Required} approvals")</span>
        </span>
    }
</span>

@code {
    /// <summary>The pull request's number, without its <c>#</c>. This component is a
    /// stand-in for the library's shared <c>PullRequestStatus</c> (see the header).</summary>
    [Parameter, EditorRequired]
    public string Number { get; set; } = string.Empty;

    /// <summary>The pull request's state as a desktop last read it.</summary>
    [Parameter]
    public LinkedPullRequestState State { get; set; }

    /// <summary>How its checks stand, or null where none were read.</summary>
    [Parameter]
    public GoalPullRequestChecksDto? Checks { get; set; }

    /// <summary>Its approvals against what its base branch requires, or null where none were read.</summary>
    [Parameter]
    public GoalPullRequestApprovalsDto? Approvals { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>The line's test id; its parts get <c>{TestId}-number</c>, <c>-checks</c>
    /// and <c>-approvals</c>.</summary>
    [Parameter]
    public string? TestId { get; set; }

    /// <summary>The state as one word: "merged", "open", "draft", "closed", or "not read yet".</summary>
    public static string Word(LinkedPullRequestState state) => state switch
    {
        LinkedPullRequestState.Merged => "merged",
        LinkedPullRequestState.Open => "open",
        LinkedPullRequestState.Draft => "draft",
        LinkedPullRequestState.Closed => "closed",
        _ => "not read yet"
    };

    private string StateWord => Word(State);

    private string Slug => State == LinkedPullRequestState.Unknown ? "unknown" : State.ToString().ToLowerInvariant();

    private string ClassValue => string.IsNullOrWhiteSpace(CssClass) ? "pr-line" : $"pr-line {CssClass}";

    private string? PartTestId(string part) => string.IsNullOrWhiteSpace(TestId) ? null : $"{TestId}-{part}";

    private static string ChecksWords(GoalPullRequestChecksDto checks, string variant)
    {
        var counted = $"{checks.Passed.ToString(CultureInfo.InvariantCulture)} of {checks.Total.ToString(CultureInfo.InvariantCulture)} checks";
        return variant switch
        {
            "running" => $"{counted} passed, {checks.Pending} running",
            "failing" => $"{counted} passed, {checks.Failed} failing",
            _ => $"{counted} passed"
        };
    }
}
