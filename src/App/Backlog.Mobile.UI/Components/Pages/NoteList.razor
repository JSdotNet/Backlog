@page "/notes"
@inject NavigationManager Navigation

@*
    The old address of the Notes tab. The phone has no Notes tab any more: notes and
    meetings are listed in the Inbox, so /notes opens the Inbox with the Notes chip
    pressed (.devbook/design/interaction-guidelines.md#phone-inbox), replacing this
    address in the history so Back does not land here again. /notes/new and
    /notes/{id} are the note editor's and stay.
*@

@code {
    /// <summary>Where <c>/notes</c> leads.</summary>
    public const string Target = "inbox?kind=notes";

    /// <summary>Navigates after a yield rather than inside the first render, so the
    /// tab bar's links hear the new address as any other navigation and light Inbox.</summary>
    protected override async Task OnInitializedAsync()
    {
        await Task.Yield();
        Navigation.NavigateTo(Target, replace: true);
    }
}
