@page "/note"
@using Backlog.Mobile.UI.Services
@using Backlog.Mobile.UI.TalkNotes
@inject TalkNoteDraft Draft
@inject TalkNoteFiles Files
@inject TalkNoteComposer Composer
@inject DeviceOutbox Outbox
@inject IAttachmentPicker Picker
@inject ISpeechTranscriber Speech
@implements IDisposable

@*
    A talk note: what was said in a talk, the slide photo and the handout, kept
    on the phone until cloud sync takes it and delivered to the desktop Inbox as
    one ordinary capture. Not a "session note" — Sessions is its own bounded
    context here, and one word for two things is what this name avoids.
*@

<PageTitle>Talk note</PageTitle>

<h1>Talk note</h1>

<div class="talk-note">
    <TextField @bind-Value="Draft.Title" Label="Title" Placeholder="Or the first line of the note"
               CssClass="talk-note__field" TestId="note-title" />

    <div class="talk-note__body">
        <TextArea @bind-Value="Draft.Body" Label="Note" Placeholder="What was said — Markdown works" Rows="6"
                  CssClass="talk-note__field" TestId="note-body" />
        @* Dictation appends to the body, as it does to the Inbox's quick capture:
           nothing is sent that the person has not read first. *@
        <ToggleButton Pressed="_listening"
                      PressedChanged="OnSpeechToggledAsync"
                      Disabled="@(_speechSupported != true)"
                      AriaLabel="@(_listening ? "Stop dictating" : "Dictate into the note")"
                      Title="@(_listening ? "Stop dictating" : "Dictate into the note")"
                      CssClass="talk-note__mic"
                      TestId="note-speech-toggle">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor"
                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="6" y="1.75" width="4" height="7.5" rx="2" />
                <path d="M3.75 7.25v.75a4.25 4.25 0 0 0 8.5 0v-.75" />
                <path d="M8 12.25v2" />
            </svg>
        </ToggleButton>
    </div>

    @if (_speechStatus is not null)
    {
        <Alert Message="@_speechStatus" Role="status" BaseClass="capture__status" TestId="note-speech-status" />
    }

    <TextField @bind-Value="Draft.Speaker" Label="Speaker" Placeholder="@@name"
               ErrorMessage="@Draft.SpeakerProblem" CssClass="talk-note__field" TestId="note-speaker" />

    <TextField @bind-Value="Draft.Tags" Label="Tags" Placeholder="#conference, #keynote"
               CssClass="talk-note__field" TestId="note-tags" />

    <div class="talk-note__attach" role="group" aria-label="Attach">
        @if (_canTakePhoto)
        {
            <AppButton Size="ButtonSize.Small" Disabled="_picking" OnClick="() => PickAsync(Picker.TakePhotoAsync)"
                       TestId="note-take-photo">Take photo</AppButton>
        }
        <AppButton Size="ButtonSize.Small" Disabled="_picking" OnClick="() => PickAsync(Picker.PickPicturesAsync)"
                   TestId="note-choose-pictures">Choose pictures</AppButton>
        <AppButton Size="ButtonSize.Small" Disabled="_picking" OnClick="() => PickAsync(Picker.PickFilesAsync)"
                   TestId="note-choose-files">Choose files</AppButton>
    </div>

    @if (Picker is WebAttachmentPicker web)
    {
        <WebAttachmentInputs Picker="web" />
    }

    @if (_pickError is not null)
    {
        <Alert Message="@_pickError" BaseClass="error" TestId="note-pick-error" />
    }

    <AttachmentStrip Tiles="Tiles" OnRemove="RemoveAsync" AriaLabel="Attached to this note" TestId="note-attachments" />

    @if (Draft.Attachments.Any(attachment => attachment.IsPicture))
    {
        <Toggle @bind-Checked="Draft.SendOriginals" Label="Send originals"
                Description="Keep pictures as taken. Otherwise they go as 1600 px JPEGs, without location or camera details."
                TestId="note-send-originals" />
    }

    @if (Draft.HasRefused)
    {
        <Alert Message="Remove the files marked above to send the note — they would not go with it." Role="status"
               BaseClass="capture__notice" TestId="note-refused-notice" />
    }

    @* Not "Save": the draft already keeps itself (interaction-guidelines.md#auto-save-no-save-buttons).
       This hands the note to the outbox, the way Capture does on the Inbox. *@
    <AppButton Variant="ButtonVariant.Primary" Disabled="@(!Draft.CanSave || _saving)" OnClick="SaveAsync"
               TestId="note-send">Send to Inbox</AppButton>

    @if (_saveError is not null)
    {
        <Alert Message="@_saveError" BaseClass="error" TestId="note-save-error" />
    }

    @if (Draft.LastSaved is { } saved)
    {
        var status = TalkNoteOutboxKind.StatusOf(Outbox, saved);

        <p class="talk-note__status" role="status" data-testid="note-status" data-status="@status">
            <span>Last note: @status</span>
            @if (status.EndsWith("tap to retry", StringComparison.Ordinal))
            {
                <AppButton Size="ButtonSize.Small" OnClick="() => Outbox.RetryAsync(saved)" TestId="note-retry">Retry</AppButton>
            }
        </p>
    }
</div>

@code {
    private const string Listening = "Listening…";

    private bool? _speechSupported;
    private bool _listening;
    private string? _speechStatus;

    private bool _canTakePhoto;
    private bool _picking;
    private string? _pickError;

    private bool _saving;
    private string? _saveError;

    private IReadOnlyList<AttachmentTile> Tiles =>
    [
        .. Draft.Attachments.Select(attachment => new AttachmentTile(
            attachment.Id.ToString("N"),
            attachment.Name,
            AttachmentRules.Describe(attachment.ContentType),
            AttachmentRules.DescribeSize(attachment.SizeBytes),
            attachment.IsPicture,
            attachment.Refusal))
    ];

    protected override void OnInitialized()
    {
        Outbox.Changed += OnOutboxChanged;
        if (Picker is WebAttachmentPicker web) web.Unrequested += OnUnrequestedAsync;
    }

    public void Dispose()
    {
        Outbox.Changed -= OnOutboxChanged;
        if (Picker is WebAttachmentPicker web) web.Unrequested -= OnUnrequestedAsync;
    }

    /// <summary>Asked after the first render, as the Inbox asks: prerendered on
    /// the server there is no browser to ask, and "no" would be a lie.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _canTakePhoto = await Picker.CanTakePhotoAsync();
        _speechSupported = await Speech.IsSupportedAsync();
        StateHasChanged();
    }

    private void OnOutboxChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task PickAsync(Func<CancellationToken, Task<AttachmentPick>> pick)
    {
        _picking = true;
        _pickError = null;

        try
        {
            await AddAsync(await pick(CancellationToken.None));
        }
        finally
        {
            _picking = false;
        }
    }

    /// <summary>Files set on the harness's input without a button press —
    /// Playwright's way in — are taken like any other pick.</summary>
    private Task OnUnrequestedAsync(AttachmentPick pick) => InvokeAsync(async () =>
    {
        await AddAsync(pick);
        StateHasChanged();
    });

    /// <summary>Each file is staged on the device at once: a browser file is
    /// readable only until the next pick, and a draft has to outlive the page.</summary>
    private async Task AddAsync(AttachmentPick pick)
    {
        if (pick.IsError)
        {
            _pickError = pick.Error;
            return;
        }

        foreach (var file in pick.Files)
        {
            try
            {
                Draft.Attachments.Add(await Files.StageAsync(file, Draft.Attachments.Count));
            }
            catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
            {
                _pickError = $"Couldn't attach {file.Name}: {ex.Message}";
            }
        }
    }

    private Task RemoveAsync(AttachmentTile tile)
    {
        var attachment = Draft.Attachments.Find(candidate => candidate.Id.ToString("N") == tile.Key);
        if (attachment is not null)
        {
            Draft.Attachments.Remove(attachment);
            TalkNoteFiles.Discard(attachment);
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Queues the note and clears the fields. The outbox takes it from here —
    /// the uploads, then the capture — and the line under the button follows it.
    /// </summary>
    private async Task SaveAsync()
    {
        _saving = true;
        _saveError = null;

        try
        {
            await Composer.SaveAsync(Draft);
            _speechStatus = null;
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _saveError = $"Couldn't send the note: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OnSpeechToggledAsync(bool pressed)
    {
        if (!pressed)
        {
            await Speech.StopAsync();
            return;
        }

        _listening = true;
        _speechStatus = Listening;

        // Not awaited: ListenAsync ends when recognition does, and the pressed
        // state has to reach the screen before that.
        _ = ListenAsync();
    }

    private async Task ListenAsync()
    {
        SpeechTranscript result;

        try
        {
            result = await Speech.ListenAsync();
        }
        catch (Exception ex)
        {
            result = SpeechTranscript.Failed(ex.Message);
        }

        _listening = false;

        if (result.IsError)
        {
            _speechStatus = result.Error;
        }
        else if (result.Text.Length == 0)
        {
            _speechStatus = "Nothing was heard.";
        }
        else
        {
            _speechStatus = null;
            var existing = Draft.Body.TrimEnd();
            Draft.Body = existing.Length == 0 ? result.Text : $"{existing} {result.Text}";
        }

        await InvokeAsync(StateHasChanged);
    }
}
