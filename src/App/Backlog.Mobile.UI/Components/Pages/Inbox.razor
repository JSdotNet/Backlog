@page "/inbox"
@using Backlog.Mobile.UI.Services
@inject CloudSyncClient Sync
@inject DeviceOutbox Outbox
@inject IDeviceStore Store
@inject CaptureDraft Draft
@inject SyncStatusTracker Status
@inject AppLifecycle Lifecycle
@inject TimeProvider Clock
@inject ISpeechTranscriber Speech
@inject SharedContentCapture SharedCapture
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>Inbox</PageTitle>

<div class="inbox-heading">
    <h1>Inbox</h1>
    @* The pull gesture's twin, for a pointer, a keyboard and a screen reader —
       none of which can pull. *@
    <IconButton AriaLabel="Refresh the inbox" Title="Refresh the inbox" Disabled="_refreshing"
                OnClick="RefreshAsync" CssClass="inbox-heading__refresh" TestId="inbox-refresh">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor"
             stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M13.25 8a5.25 5.25 0 1 1-1.54-3.71" />
            <path d="M13.25 2.75v2.5h-2.5" />
        </svg>
    </IconButton>
</div>

<div class="capture">
    <TextField @bind-Value="Draft.Text" AriaLabel="Quick capture" Placeholder="Quick capture…"
               CssClass="capture__field" TestId="capture-field" />
    @* Speech only ever fills this field. Capture is still the one thing that
       syncs, so nothing reaches the cloud that the person has not read first. *@
    <ToggleButton Pressed="_listening"
                  PressedChanged="OnSpeechToggledAsync"
                  Disabled="@(_speechSupported != true)"
                  AriaLabel="@(_listening ? "Stop dictating" : "Dictate a capture")"
                  Title="@(_listening ? "Stop dictating" : "Dictate a capture")"
                  CssClass="capture__mic"
                  TestId="speech-toggle">
        @* Drawn rather than fetched, for the same reason CopyButton draws its
           clipboard: a WebView with no egress still has to show the button. *@
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor"
             stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="6" y="1.75" width="4" height="7.5" rx="2" />
            <path d="M3.75 7.25v.75a4.25 4.25 0 0 0 8.5 0v-.75" />
            <path d="M8 12.25v2" />
        </svg>
    </ToggleButton>
    <AppButton Variant="ButtonVariant.Primary" Disabled="@string.IsNullOrWhiteSpace(Draft.Text)"
               OnClick="CaptureAsync" TestId="capture-submit">Capture</AppButton>
</div>

@if (SharedCapture.Status is { } shareStatus)
{
    @* A share is captured the moment it arrives, wherever the app was; this line
       is what says where the new row at the top came from. The field is left as
       it was — a draft being typed is not the share's to touch. *@
    <Alert Message="@shareStatus" Role="status" BaseClass="capture__notice" TestId="share-status" />
}

@if (_speechSupported == false)
{
    <Alert Message="Speech recognition is not available on this device — type your capture instead."
           Role="status" BaseClass="capture__notice" TestId="speech-unavailable" />
}

@if (_speechStatus is not null)
{
    @* role="status" rather than "alert": this is the running commentary on a
       thing the person just started, not an interruption. *@
    <Alert Message="@_speechStatus" Role="status" BaseClass="capture__status" TestId="speech-status" />
}

@if (_speechError is not null)
{
    <Alert Message="@_speechError" BaseClass="error" TestId="speech-error" />
}

@if (_pullNotice is not null)
{
    @* A calm line, not an error: the list below is still the last one the phone
       saw, and a capture made now is kept and sent later. *@
    <Alert Message="@_pullNotice" Role="status" BaseClass="capture__notice" TestId="inbox-pull-notice" />
}

@if (_actionError is not null)
{
    <Alert Message="@_actionError" BaseClass="error" TestId="inbox-action-error" />
}

<section class="inbox" @ref="_listElement" aria-label="Captures">
    @if (_items is null && Rows.Count == 0)
    {
        <Spinner Label="Loading the inbox" />
    }
    else if (Rows.Count == 0)
    {
        <EmptyState Title="Inbox is empty" />
    }
    else
    {
        <ul class="inbox__list" data-testid="inbox-list">
            @foreach (var row in Rows)
            {
                var item = row.Item;
                var preview = PreviewLine(item.BodyMd);

                <li class="inbox__row" data-testid="inbox-row" data-waiting="@(row.Pending is null ? "false" : "true")" @key="item.Id">
                    <AppButton BaseClass="inbox__open" id="@RowId(item.Id)" aria-label="@($"Open {item.Title}")"
                               OnClick="() => Open(row)" TestId="inbox-open">
                        <span class="inbox__meta">
                            <CaptureKindMarker Value="@CaptureKindGuess.Of(item.Title, item.BodyMd)" />
                            <span class="inbox__time" data-testid="inbox-time">@Ago(item.CapturedAt)</span>
                        </span>
                        <span class="inbox__title">@item.Title</span>
                        @if (preview is not null)
                        {
                            <span class="inbox__preview" data-testid="inbox-preview">@preview</span>
                        }
                    </AppButton>

                    @if (row.Pending is { IsParked: true } parked)
                    {
                        <AppButton Size="ButtonSize.Small" aria-label="@($"Waiting — tap to retry {item.Title}")"
                                   title="@parked.LastError" OnClick="() => RetryAsync(parked.Id)"
                                   CssClass="inbox__action" TestId="inbox-retry">Waiting — tap to retry</AppButton>
                    }
                    else if (row.Pending is not null)
                    {
                        <Badge Kind="sync" Slug="waiting" Title="Kept on this phone until cloud sync takes it"
                               CssClass="inbox__action" TestId="inbox-waiting">Waiting</Badge>
                    }
                    else
                    {
                        <AppButton Size="ButtonSize.Small" aria-label="@($"Dismiss {item.Title}")"
                                   OnClick="() => DismissAsync(item.Id)" CssClass="inbox__action"
                                   TestId="inbox-dismiss">Dismiss</AppButton>
                    }
                </li>
            }
        </ul>
    }
</section>

<DetailSheet Open="_selected is not null" OpenChanged="OnSheetOpenChanged"
             Kicker="@(_selected is null ? null : $"Captured {Ago(_selected.Item.CapturedAt)}")"
             Title="@_selected?.Item.Title" AriaLabel="Capture" CloseLabel="Close capture"
             RestoreFocusToId="@(_selected is null ? null : RowId(_selected.Item.Id))"
             CssClass="inbox-sheet" TestId="inbox-sheet">
    @if (_selected is { Item: var shown })
    {
        @if (!string.IsNullOrWhiteSpace(shown.BodyMd))
        {
            <div class="inbox-sheet__body" data-testid="inbox-sheet-body">
                <MarkdownView Blocks="@MarkdownPreview.ParseDocument(shown.BodyMd)" Source="@shown.BodyMd" />
            </div>
        }

        <dl class="inbox-sheet__facts">
            <dt>Source</dt>
            <dd data-testid="inbox-sheet-source">@(string.IsNullOrWhiteSpace(shown.Source) ? "—" : shown.Source)</dd>

            @if (!string.IsNullOrWhiteSpace(shown.Person))
            {
                <dt>Person</dt>
                <dd data-testid="inbox-sheet-person">@("@" + shown.Person)</dd>
            }

            @if (shown.Tags is { Count: > 0 } tags)
            {
                <dt>Tags</dt>
                <dd class="inbox-sheet__tags" data-testid="inbox-sheet-tags">
                    @foreach (var tag in tags)
                    {
                        <TagChip Text="@tag.TrimStart('#')" />
                    }
                </dd>
            }

            @if (_selected.Pending is { } pending)
            {
                <dt>Sync</dt>
                <dd data-testid="inbox-sheet-sync">
                    @(pending.IsParked ? $"Waiting — {pending.LastError}" : "Waiting to be sent")
                </dd>
            }
        </dl>
    }
</DetailSheet>

@code {
    private const string Listening = "Listening…";

    /// <summary>One line of the list: what the service has, or a capture still in
    /// the outbox — in which case <see cref="Pending"/> is its entry.</summary>
    private sealed record Row(InboxItem Item, OutboxEntry? Pending);

    /// <summary>The last list the service answered with — this device's cached
    /// copy until the first pull of this visit lands. Null only when the phone
    /// has never pulled and the first pull has not answered yet.</summary>
    private IReadOnlyList<InboxItem>? _items;

    private DateTimeOffset? _pulledAt;
    private string? _pullNotice;
    private string? _actionError;
    private bool _refreshing;
    private bool _refreshAgain;
    private Row? _selected;

    /// <summary>
    /// Captures the outbox has delivered that no pull asked for since, each with
    /// the delivery's number. The outbox has the service's word for them, so they
    /// are listed as delivered until a pull that began after the delivery answers
    /// — the one in flight may have been read before the capture landed, and the
    /// next one may fail.
    /// </summary>
    private readonly Dictionary<Guid, (InboxItem Item, long Delivery)> _delivered = [];
    private long _deliveries;

    /// <summary>Null until the recogniser has been asked. Neither "yes" nor "no"
    /// is true during the first render, and claiming either would flash a
    /// message or an enabled button that the answer then contradicts.</summary>
    private bool? _speechSupported;

    private bool _listening;
    private string? _speechStatus;
    private string? _speechError;

    private ElementReference _listElement;
    private IJSObjectReference? _pullModule;
    private IJSObjectReference? _pullGesture;
    private DotNetObjectReference<Inbox>? _self;

    /// <summary>
    /// What the outbox still holds, above what the service has sent back — one
    /// list, newest first, so a capture made a moment ago is at the top whether or
    /// not it has left the phone. A capture the service has but the outbox has
    /// not yet heard back about is shown once, as the outbox's. One the outbox
    /// has delivered is shown as delivered, whether or not a pull has brought it
    /// back yet.
    /// </summary>
    private IReadOnlyList<Row> Rows
    {
        get
        {
            var pending = Outbox.Entries
                .Where(IsCapture)
                .Select(entry => new Row(ItemOf(entry), entry))
                .ToList();

            var shown = pending.Select(row => row.Item.Id).ToHashSet();
            var pulled = (_items ?? []).Where(item => shown.Add(item.Id)).Select(item => new Row(item, null)).ToList();
            var delivered = _delivered.Values.Where(sent => shown.Add(sent.Item.Id)).Select(sent => new Row(sent.Item, null));

            return
            [
                .. pending
                    .Concat(pulled)
                    .Concat(delivered)
                    .OrderByDescending(row => row.Item.CapturedAt)
            ];
        }
    }

    private static bool IsCapture(OutboxEntry entry) =>
        entry.Kind is CaptureOutboxKind.Token or TalkNoteOutboxKind.Token;

    /// <summary>The capture an entry will become. A talk note is a capture with
    /// its uploads in front of it; on the list it is that capture.</summary>
    private static InboxItem ItemOf(OutboxEntry entry)
    {
        var capture = entry.Kind == TalkNoteOutboxKind.Token
            ? TalkNoteOutboxKind.Read(entry).Capture
            : CaptureOutboxKind.Read(entry);

        return new InboxItem(entry.Id, capture.Title, capture.Source, entry.CreatedAt, capture.BodyMd, capture.Tags, capture.Person, capture.Attachments);
    }

    /// <summary>
    /// The cached list is drawn before the service is asked anything. A replica
    /// still warming up, or no signal at all, then costs a status line rather than
    /// a blank screen.
    /// <para>
    /// The device is paired by the time this runs: the layout draws the pairing
    /// gate instead of any page until it is.
    /// </para>
    /// </summary>
    protected override Task OnInitializedAsync()
    {
        SharedCapture.Changed += OnShareStatusChanged;
        Outbox.Changed += OnOutboxChanged;
        Outbox.Delivered += OnDelivered;
        Lifecycle.Resumed += OnResumed;

        if (Store.ReadInbox() is { } cached)
        {
            _items = cached.Items;
            _pulledAt = cached.PulledAt;
        }

        return RefreshAsync();
    }

    public async ValueTask DisposeAsync()
    {
        SharedCapture.Changed -= OnShareStatusChanged;
        Outbox.Changed -= OnOutboxChanged;
        Outbox.Delivered -= OnDelivered;
        Lifecycle.Resumed -= OnResumed;

        try
        {
            if (_pullGesture is not null)
            {
                await _pullGesture.InvokeVoidAsync("dispose");
                await _pullGesture.DisposeAsync();
            }

            if (_pullModule is not null) await _pullModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }

        _self?.Dispose();
    }

    /// <summary>The share itself is already in the outbox, and its row arrives
    /// through <see cref="OnOutboxChanged"/>; this only redraws the line that
    /// explains it.</summary>
    private void OnShareStatusChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// The support question is asked after the first render, not before it: in
    /// the browser harness the component prerenders on the server, where there
    /// is no browser to ask and the honest answer would be a misleading "no".
    /// The pull gesture is attached then too, for the same reason.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await AttachPullGestureAsync();

        _speechSupported = await Speech.IsSupportedAsync();
        StateHasChanged();
    }

    private async Task AttachPullGestureAsync()
    {
        try
        {
            _pullModule = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/Backlog.Mobile.UI/pull-refresh.js");
            if (_pullModule is null) return;

            _self = DotNetObjectReference.Create(this);
            _pullGesture = await _pullModule.InvokeAsync<IJSObjectReference>("attach", _listElement, _self);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // No gesture where there is no browser; the refresh button still works.
        }
    }

    [JSInvokable]
    public Task OnPulled() => InvokeAsync(RefreshAsync);

    private void OnResumed() => _ = InvokeAsync(RefreshAsync);

    private void OnOutboxChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>The service has the capture now: the row stops saying it is
    /// waiting at once, and the list the service answers with next replaces it.</summary>
    private void OnDelivered(OutboxEntry entry) => _ = InvokeAsync(() =>
    {
        if (IsCapture(entry)) _delivered[entry.Id] = (ItemOf(entry), ++_deliveries);
        StateHasChanged();
        return RefreshAsync();
    });

    private async Task OnSpeechToggledAsync(bool pressed)
    {
        if (!pressed)
        {
            // Stop only asks; the words arrive on the listening turn below.
            await Speech.StopAsync();
            return;
        }

        _listening = true;
        _speechError = null;
        _speechStatus = Listening;

        // ListenAsync does not complete until recognition ends, so it is
        // deliberately not awaited here: this handler has to return for the
        // pressed state and the "Listening…" line to reach the screen at all.
        _ = ListenAsync();
    }

    private async Task ListenAsync()
    {
        SpeechTranscript result;

        try
        {
            result = await Speech.ListenAsync();
        }
        catch (Exception ex)
        {
            // The transcribers report their failures as results; anything that
            // still arrives as an exception is unexpected, and swallowing it
            // would leave the button stuck on.
            result = SpeechTranscript.Failed(ex.Message);
        }

        _listening = false;

        if (result.IsError)
        {
            _speechStatus = null;
            _speechError = result.Error;
        }
        else if (result.Text.Length == 0)
        {
            _speechStatus = "Nothing was heard.";
        }
        else
        {
            _speechStatus = $"Heard: {result.Text}";
            Draft.Text = Append(Draft.Text, result.Text);
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Dictation extends what is in the field rather than replacing it — a second
    /// sentence added to a half-written note is the ordinary case, and
    /// overwriting would lose the first one with no way back.
    /// </summary>
    private static string Append(string draft, string addition)
    {
        var existing = draft.TrimEnd();
        return existing.Length == 0 ? addition : $"{existing} {addition}";
    }

    /// <summary>
    /// Pulls the inbox and keeps it as this device's cached copy. A failure keeps
    /// whatever is on screen and says why in one line: a replica still warming up
    /// (503 <c>sync.replica_unavailable</c>) is a wait, anything else is a network
    /// the phone cannot reach — and neither is a reason to blank the list.
    /// <para>
    /// A refresh asked for while one is out runs once that one answers, never
    /// instead of it: the pull in flight may have been read before the capture
    /// that asked for the next one landed.
    /// </para>
    /// </summary>
    private async Task RefreshAsync()
    {
        if (_refreshing)
        {
            _refreshAgain = true;
            return;
        }

        _refreshing = true;

        try
        {
            do
            {
                _refreshAgain = false;
                await PullAsync();
            }
            while (_refreshAgain);
        }
        finally
        {
            _refreshing = false;
        }

        StateHasChanged();
    }

    private async Task PullAsync()
    {
        var asked = _deliveries;

        try
        {
            var items = await Sync.GetInboxAsync();
            var now = Clock.GetUtcNow();

            _items = items;
            _pulledAt = now;
            _pullNotice = null;

            // Asked after these were delivered, so the list has them — or they
            // have left the inbox since, dismissed on the desktop.
            foreach (var (id, sent) in _delivered.ToList())
            {
                if (sent.Delivery <= asked) _delivered.Remove(id);
            }

            await Store.SaveInboxAsync(new CachedInbox(items, now));
            Status.RecordSynced();
        }
        catch (Exception ex)
        {
            _items ??= [];
            _pullNotice = PullNotice(ex);
            Status.RecordUnreachable();
        }
    }

    private string PullNotice(Exception failure)
    {
        var reason = failure is SyncUnavailableException { Code: "sync.replica_unavailable" }
            ? "Cloud sync is still starting up."
            : "Cloud sync can't be reached.";

        var showing = _pulledAt is { } at
            ? $"Showing the inbox as it was {Ago(at)}."
            : "Nothing has been pulled to this phone yet.";

        return $"{reason} {showing} New captures are kept here and sent when it answers.";
    }

    /// <summary>
    /// Keeps the capture before anything else happens. The outbox writes it to
    /// the device, starts sending it, and returns — so the field clears and the
    /// row appears at once, marked waiting, whether or not there is a network.
    /// </summary>
    private async Task CaptureAsync()
    {
        var title = Draft.Text.Trim();
        if (title.Length == 0) return;

        var capture = CaptureOutboxKind.Create(title);
        await Outbox.EnqueueAsync(CaptureOutboxKind.Token, capture.Id!.Value, CaptureOutboxKind.Write(capture));

        Draft.Text = string.Empty;
        _speechStatus = null;
        SharedCapture.ClearStatus();
    }

    private Task RetryAsync(Guid id)
    {
        _actionError = null;
        return Outbox.RetryAsync(id);
    }

    /// <summary>The phone acknowledges; it does not triage. Dismissing takes the
    /// capture out of the inbox here and leaves deciding what it becomes to the
    /// desktop, which has already pulled it.</summary>
    private async Task DismissAsync(Guid id)
    {
        _actionError = null;

        try
        {
            await Sync.AcknowledgeAsync(id);
        }
        catch (Exception ex)
        {
            _actionError = $"Couldn't dismiss it: {ex.Message}";
            return;
        }

        if (_selected?.Item.Id == id) _selected = null;
        await RefreshAsync();
    }

    private void Open(Row row) => _selected = row;

    private void OnSheetOpenChanged(bool open)
    {
        if (!open) _selected = null;
    }

    private string Ago(DateTimeOffset at) => SyncStatusLine.Relative(Clock.GetUtcNow() - at);

    private static string RowId(Guid id) => $"inbox-row-{id:N}";

    /// <summary>The body's first line with anything on it, or null. The row shows
    /// one line; the sheet shows the rest.</summary>
    private static string? PreviewLine(string? bodyMd) =>
        bodyMd?.Split('\n').Select(line => line.Trim()).FirstOrDefault(line => line.Length > 0);
}
