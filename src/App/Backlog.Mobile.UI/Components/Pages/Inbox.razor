@page "/inbox"
@using Backlog.Mobile.UI.Services
@inject CloudSyncClient Sync
@inject DeviceOutbox Outbox
@inject IDeviceStore Store
@inject CaptureDraft Draft
@inject SyncStatusTracker Status
@inject AppLifecycle Lifecycle
@inject TimeProvider Clock
@inject SharedContentCapture SharedCapture
@inject IJSRuntime Js
@inject CaptureEdits Edits
@inject CaptureDealtWithNotices DealtWith
@implements IAsyncDisposable

<PageTitle>Inbox</PageTitle>

@*
    The phone's Inbox: the captures this phone made, each with where it stands
    on its way to the desktop, until the desktop decides it. A row opens the
    whole capture, where its title and notes can be reworded — saved on its own
    once typing stops, as a note is — and the capture deleted. Both are the
    phone's own words about its own thought, not a decision: deleting takes it
    off this phone and archives it on the desktop, and the phone still offers
    no route, defer, accept or archive — triage stays on the desktop
    (.devbook/domain/inbox/features.md#triage-stays-on-the-desktop). A change
    the desktop beat is answered with one calm line rather than lost.
    Dictation, notes and photos are the capture sheet's; this field is the
    quick one-liner.
*@

@{
    // The list is projected once per render: the count, the list and the open
    // sheet all read this one copy rather than laying the outbox over the inbox
    // again each time they ask.
    _rows = null;
}

<header class="inbox-heading">
    <div class="inbox-heading__titles">
        <span class="inbox-heading__lede" data-testid="inbox-count">@CountLabel</span>
        @* The tab bar names the page on screen; the heading is kept for screen readers. *@
        <h1 class="sr-only">Inbox</h1>
    </div>
    @* The pull gesture's twin, for a pointer, a keyboard and a screen reader —
       none of which can pull. *@
    <IconButton AriaLabel="Refresh the inbox" Title="Refresh the inbox" Disabled="_refreshing"
                OnClick="RefreshAsync" CssClass="inbox-heading__refresh" TestId="inbox-refresh">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor"
             stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M13.25 8a5.25 5.25 0 1 1-1.54-3.71" />
            <path d="M13.25 2.75v2.5h-2.5" />
        </svg>
    </IconButton>
</header>

<div class="capture">
    <TextField @bind-Value="Draft.Text" AriaLabel="Add to inbox" Placeholder="Add to inbox…" Id="@CaptureFieldId"
               CssClass="capture__field" TestId="capture-field" />
    <IconButton AriaLabel="Add to inbox" Title="Add to inbox" Disabled="@string.IsNullOrWhiteSpace(Draft.Text)"
                OnClick="CaptureAsync" CssClass="capture__add" TestId="capture-submit">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4"
             stroke-linecap="round" aria-hidden="true" focusable="false">
            <path d="M12 5v14M5 12h14" />
        </svg>
    </IconButton>
</div>

@if (SharedCapture.Status is { } shareStatus)
{
    @* A share is captured the moment it arrives, wherever the app was; this line
       is what says where the new row at the top came from. The field is left as
       it was — a draft being typed is not the share's to touch. *@
    <Alert Message="@shareStatus" Role="status" BaseClass="capture__notice" TestId="share-status" />
}

@if (_pullNotice is not null)
{
    @* A calm line, not an error: the list below is still the last one the phone
       saw, and a capture made now is kept and sent later. *@
    <Alert Message="@_pullNotice" Role="status" BaseClass="capture__notice" TestId="inbox-pull-notice" />
}

@if (DealtWith.Captures.Count > 0)
{
    @* Conflict handling (interaction-guidelines.md): the desktop decided the
       capture before the phone's change reached it. Nothing to retry — the
       desktop's decision stands — but the change is not dropped without a word. *@
    <Alert Message="@DealtWithLine" Role="status" BaseClass="capture__notice"
           ActionLabel="OK" OnAction="DealtWith.Clear" TestId="inbox-dealt-with" />
}

<section class="inbox" @ref="_listElement" aria-label="Captures">
    @if (_items is null && Rows.Count == 0)
    {
        <Spinner Label="Loading the inbox" />
    }
    else if (Rows.Count == 0)
    {
        <EmptyState Title="Inbox clear" Description="Everything has a place." TestId="inbox-empty" />
    }
    else
    {
        <ul class="inbox__list" data-testid="inbox-list">
            @foreach (var row in Rows)
            {
                var item = row.Item;

                <li @key="item.Id">
                    <CaptureRow Title="@item.Title" Kind="@CaptureKindGuess.Of(item.Title, item.BodyMd)"
                                Time="@Ago(item.CapturedAt)" Preview="@PreviewLine(item.BodyMd)"
                                State="StateOf(row)" StuckReason="@row.Waiting?.LastError"
                                Id="@RowId(item.Id)" OnOpen="() => Open(row)"
                                OnRetry="() => RetryAsync(row)" TestId="inbox-row" />
                </li>
            }
        </ul>
    }
</section>

<DetailSheet Open="_selected is not null" OpenChanged="OnSheetOpenChanged"
             Kicker="@(_selected is null ? null : $"Captured {Ago(_selected.Item.CapturedAt)}")"
             Title="@SelectedRow?.Item.Title" AriaLabel="Capture" CloseLabel="Close capture"
             RestoreFocusToId="@(_selected is null ? null : RowId(_selected.Item.Id))"
             Dismissible="@(!_confirmingDelete)" BeforeClose="CanCloseSheetAsync"
             CssClass="inbox-sheet" TestId="inbox-sheet">
    <ChildContent>
        @if (SelectedRow is { Item: var shown } selectedRow)
        {
            @* The capture's own words, editable as a note's are and saved the same
               way: once typing stops, and when the field or the sheet is left. *@
            <div class="inbox-sheet__editor">
                <TextField Value="@_editTitle" ValueChanged="OnTitleChanged" Label="Title"
                           @onblur="FlushAsync" TestId="inbox-sheet-title" />
                <TextArea Value="@_editNotes" ValueChanged="OnNotesChanged" Label="Notes"
                          Placeholder="Add notes — Markdown works" Rows="6"
                          @onblur="FlushAsync" TestId="inbox-sheet-notes" />
                <SaveIndicator State="_saveState" SavedText="@(selectedRow.Waiting is null ? "Saved" : "Waiting to sync")"
                               FailedText="Not saved" CssClass="inbox-sheet__save" TestId="inbox-sheet-saved" />

                @if (_saveState == SaveState.Failed)
                {
                    @* Kept on screen, and the sheet with it, as the Notes editor keeps a
                       failed save: closing now would lose the words without a word. *@
                    <Alert Message="@_saveFailure" ActionLabel="@(_titleMissing ? null : "Try again")"
                           OnAction="FlushAsync" TestId="inbox-sheet-unsaved" />
                    <AppButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="DiscardEdit"
                               TestId="inbox-sheet-discard">Discard changes</AppButton>
                }
            </div>

            <dl class="inbox-sheet__facts">
                <dt>Source</dt>
                <dd data-testid="inbox-sheet-source">@(string.IsNullOrWhiteSpace(shown.Source) ? "—" : shown.Source)</dd>

                @if (!string.IsNullOrWhiteSpace(shown.Person))
                {
                    <dt>Person</dt>
                    <dd data-testid="inbox-sheet-person">@("@" + shown.Person)</dd>
                }

                @if (shown.Tags is { Count: > 0 } tags)
                {
                    <dt>Tags</dt>
                    <dd class="inbox-sheet__tags" data-testid="inbox-sheet-tags">
                        @foreach (var tag in tags)
                        {
                            <TagChip Text="@tag.TrimStart('#')" />
                        }
                    </dd>
                }

                @if (selectedRow.Waiting is { } pending)
                {
                    <dt>Sync</dt>
                    <dd data-testid="inbox-sheet-sync">
                        @(pending.IsParked ? $"Waiting — {pending.LastError}" : "Waiting to be sent")
                    </dd>
                }
            </dl>
        }
    </ChildContent>
    <Footer>
        @if (_selected is not null)
        {
            <AppButton Variant="ButtonVariant.Danger" OnClick="AskToDelete" TestId="inbox-sheet-delete">Delete</AppButton>
        }
    </Footer>
</DetailSheet>

<ConfirmDialog Open="_confirmingDelete" OpenChanged="open => _confirmingDelete = open"
               Title="Delete this capture?"
               Message="Removes it from this phone and archives it on the desktop."
               ConfirmText="Delete" Destructive="true"
               OnConfirm="DeleteAsync"
               TestId="inbox-delete-confirm" ConfirmTestId="inbox-delete-confirm-yes" CancelTestId="inbox-delete-confirm-no" />

@code {
    /// <summary>How long typing in the sheet has to stop for before the edit is
    /// kept — the Notes editor's wait (<see cref="NotePage.SaveDelay"/>).</summary>
    public static TimeSpan SaveDelay => NotePage.SaveDelay;

    /// <summary>One line of the list: what the service has, or a capture still in
    /// the outbox — in which case <see cref="Pending"/> is its entry — with the
    /// phone's own edits laid over it. <see cref="Change"/> is the newest edit or
    /// Delete of it still on its way.</summary>
    private sealed record Row(InboxItem Item, OutboxEntry? Pending, OutboxEntry? Change = null)
    {
        /// <summary>What the row is waiting for: the capture itself, else a change to it.</summary>
        public OutboxEntry? Waiting => Pending ?? Change;
    }

    /// <summary>The last list the service answered with — this device's cached
    /// copy until the first pull of this visit lands. Null only when the phone
    /// has never pulled and the first pull has not answered yet.</summary>
    private IReadOnlyList<InboxItem>? _items;

    private DateTimeOffset? _pulledAt;
    private string? _pullNotice;
    private bool _refreshing;
    private bool _refreshAgain;
    private Row? _selected;

    /// <summary>
    /// Captures the outbox has delivered that no pull asked for since, each with
    /// the delivery's number. The outbox has the service's word for them, so they
    /// are listed as delivered until a pull that began after the delivery answers
    /// — the one in flight may have been read before the capture landed, and the
    /// next one may fail.
    /// </summary>
    private readonly Dictionary<Guid, (InboxItem Item, long Delivery)> _delivered = [];
    private long _deliveries;

    /// <summary>
    /// Edits and Deletes the outbox has delivered that no pull asked for since,
    /// with the delivery's number, kept for the reason <see cref="_delivered"/> is:
    /// until a pull that began after them answers, the list the phone holds is
    /// older than they are, and without them a reworded row would read its old
    /// words and a deleted one would come back.
    /// </summary>
    private readonly List<(OutboxEntry Entry, long Delivery)> _settled = [];

    /// <summary>The sheet's fields: the capture's title and notes as the person is
    /// writing them.</summary>
    private string _editTitle = string.Empty;
    private string _editNotes = string.Empty;
    private bool _dirty;
    private ITimer? _debounce;
    private SaveState _saveState = SaveState.Idle;
    private string _saveFailure = "Couldn't keep the change.";
    private bool _titleMissing;
    private bool _confirmingDelete;
    private bool _disposed;

    /// <summary>One save at a time, as the Notes editor's: a blur during a save
    /// waits for it rather than starting a second against the same outbox, and a
    /// Delete waits for it so the edit is in the outbox before the Delete looks.</summary>
    private readonly SemaphoreSlim _saveGate = new(1, 1);

    /// <summary>Moves on whenever the sheet turns to another capture or deletes
    /// this one, so a save that finishes for the capture before leaves this one's
    /// state alone.</summary>
    private int _generation;

    /// <summary>Where the focus goes after a Delete: the row that took the deleted
    /// one's place, or the capture field when none is left.</summary>
    private string? _focusAfterDelete;

    private IReadOnlyList<Row>? _rows;

    private const string CaptureFieldId = "inbox-capture-field";

    private ElementReference _listElement;
    private IJSObjectReference? _pullModule;
    private IJSObjectReference? _pullGesture;
    private DotNetObjectReference<Inbox>? _self;

    /// <summary>
    /// What the outbox still holds, above what the service has sent back — one
    /// list, newest first, so a capture made a moment ago is at the top whether or
    /// not it has left the phone. A capture the service has but the outbox has
    /// not yet heard back about is shown once, as the outbox's. One the outbox
    /// has delivered is shown as delivered, whether or not a pull has brought it
    /// back yet.
    /// </summary>
    private IReadOnlyList<Row> Rows => _rows ??= BuildRows();

    private IReadOnlyList<Row> BuildRows()
    {
        // The phone's own edits and Deletes are laid over every row: a reworded
        // capture reads its new words at once and a deleted one leaves the list
        // at once, whether or not the change has reached the service — and,
        // until a pull catches up, after it has.
        var outbox = Outbox.Entries;
        IReadOnlyList<OutboxEntry> changes = [.. _settled.Select(settled => settled.Entry), .. outbox];

        var pending = outbox
            .Where(IsCapture)
            .Select(entry => new Row(ItemOf(entry), entry))
            .ToList();

        var shown = pending.Select(row => row.Item.Id).ToHashSet();
        var pulled = (_items ?? []).Where(IsThisPhones).Where(item => shown.Add(item.Id)).Select(item => new Row(item, null)).ToList();
        var delivered = _delivered.Values.Where(sent => shown.Add(sent.Item.Id)).Select(sent => new Row(sent.Item, null));

        return
        [
            .. pending
                .Concat(pulled)
                .Concat(delivered)
                .Select(row => CaptureEdits.Overlay(row.Item, changes) is { } item
                    ? row with { Item = item, Change = CaptureEdits.WaitingChange(item.Id, outbox) }
                    : null)
                .OfType<Row>()
                .OrderByDescending(row => row.Item.CapturedAt)
        ];
    }

    /// <summary>The open capture as the list now has it — reworded — or the row it
    /// was opened from when the list no longer holds it.</summary>
    private Row? SelectedRow => _selected is { } selected
        ? Rows.FirstOrDefault(row => row.Item.Id == selected.Item.Id) ?? selected
        : null;

    private string DealtWithLine => DealtWith.Captures.Count == 1
        ? "The desktop had already dealt with that capture, so the change wasn't needed."
        : $"The desktop had already dealt with {DealtWith.Captures.Count} of these captures, so the changes weren't needed.";

    /// <summary>
    /// The service answers with every capture the desktop has not taken in yet,
    /// from wherever it came. The tab is the phone's own captures, so a pulled
    /// one is listed when it came from the phone channel.
    /// </summary>
    private static bool IsThisPhones(InboxItem item) =>
        string.Equals(item.Source, CaptureOutboxKind.Source, StringComparison.OrdinalIgnoreCase);

    /// <summary>"3 items to sort", "1 item to sort", "Nothing to sort".</summary>
    private string CountLabel => Rows.Count switch
    {
        0 => "Nothing to sort",
        1 => "1 item to sort",
        var n => $"{n} items to sort"
    };

    private static CaptureSyncState StateOf(Row row) => row.Waiting switch
    {
        null => CaptureSyncState.Sent,
        { IsParked: true } => CaptureSyncState.Stuck,
        _ => CaptureSyncState.Waiting
    };

    private static bool IsCapture(OutboxEntry entry) =>
        entry.Kind is CaptureOutboxKind.Token or TalkNoteOutboxKind.Token;

    /// <summary>The capture an entry will become. A talk note is a capture with
    /// its uploads in front of it; on the list it is that capture.</summary>
    private static InboxItem ItemOf(OutboxEntry entry)
    {
        var capture = entry.Kind == TalkNoteOutboxKind.Token
            ? TalkNoteOutboxKind.Read(entry).Capture
            : CaptureOutboxKind.Read(entry);

        return new InboxItem(entry.Id, capture.Title, capture.Source, entry.CreatedAt, capture.BodyMd, capture.Tags, capture.Person, capture.Attachments);
    }

    /// <summary>
    /// The cached list is drawn before the service is asked anything. A replica
    /// still warming up, or no signal at all, then costs a status line rather than
    /// a blank screen.
    /// <para>
    /// The device is paired by the time this runs: the layout draws the pairing
    /// gate instead of any page until it is.
    /// </para>
    /// </summary>
    protected override Task OnInitializedAsync()
    {
        SharedCapture.Changed += OnShareStatusChanged;
        Outbox.Changed += OnOutboxChanged;
        Outbox.Delivered += OnDelivered;
        Lifecycle.Resumed += OnResumed;
        Lifecycle.Paused += OnPaused;
        DealtWith.Changed += OnDealtWithChanged;

        if (Store.ReadInbox() is { } cached)
        {
            _items = cached.Items;
            _pulledAt = cached.PulledAt;
        }

        return RefreshAsync();
    }

    public async ValueTask DisposeAsync()
    {
        SharedCapture.Changed -= OnShareStatusChanged;
        Outbox.Changed -= OnOutboxChanged;
        Outbox.Delivered -= OnDelivered;
        Lifecycle.Resumed -= OnResumed;
        Lifecycle.Paused -= OnPaused;
        DealtWith.Changed -= OnDealtWithChanged;

        // An edit typed just before leaving is still the person's: the wait is cut
        // short and it is kept, as the Notes editor keeps one.
        _disposed = true;
        _debounce?.Dispose();
        _debounce = null;

        // Leaving the page is a way out the sheet's close does not guard. A blank
        // title cannot be kept, but the notes typed with it can: under the title the
        // capture last had, so nothing typed is dropped on the way out.
        if (_dirty && _editTitle.Trim().Length == 0 && _selected is { } leaving)
        {
            _editTitle = (SelectedRow ?? leaving).Item.Title;
        }

        if (_dirty) await SaveAsync();

        try
        {
            if (_pullGesture is not null)
            {
                await _pullGesture.InvokeVoidAsync("dispose");
                await _pullGesture.DisposeAsync();
            }

            if (_pullModule is not null) await _pullModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }

        _self?.Dispose();
    }

    /// <summary>The share itself is already in the outbox, and its row arrives
    /// through <see cref="OnOutboxChanged"/>; this only redraws the line that
    /// explains it.</summary>
    private void OnShareStatusChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// The pull gesture is attached after the first render, not before it: in
    /// the browser harness the component prerenders on the server, where there
    /// is no browser to attach it to.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusAfterDelete is { } target)
        {
            _focusAfterDelete = null;

            try
            {
                // Only a focus that is lost: the sheet and the dialog both hand it
                // back to what they were opened from, and after a Delete neither is
                // there to take it.
                await Js.InvokeVoidAsync("backlogFocusIfLost", target, ".inbox-sheet");
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
            {
            }
        }

        if (!firstRender) return;

        await AttachPullGestureAsync();
    }

    private async Task AttachPullGestureAsync()
    {
        try
        {
            _pullModule = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/Backlog.Mobile.UI/pull-refresh.js");
            if (_pullModule is null) return;

            _self = DotNetObjectReference.Create(this);
            _pullGesture = await _pullModule.InvokeAsync<IJSObjectReference>("attach", _listElement, _self);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // No gesture where there is no browser; the refresh button still works.
        }
    }

    [JSInvokable]
    public Task OnPulled() => InvokeAsync(RefreshAsync);

    private void OnResumed() => _ = InvokeAsync(RefreshAsync);

    private void OnOutboxChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>The service has the capture now: the row stops saying it is
    /// waiting at once, and the list the service answers with next replaces it.</summary>
    private void OnDelivered(OutboxEntry entry) => _ = InvokeAsync(() =>
    {
        if (IsCapture(entry)) _delivered[entry.Id] = (ItemOf(entry), ++_deliveries);
        if (IsChange(entry)) _settled.Add((entry, ++_deliveries));
        StateHasChanged();
        return RefreshAsync();
    });

    /// <summary>The desktop had already dealt with a capture this phone changed.
    /// When it is the one open in the sheet, nothing is left on this phone to save
    /// — any further edit would be answered the same — so the sheet closes and the
    /// calm line above the list says why, rather than an old header over "Saved".</summary>
    private void OnDealtWithChanged() => _ = InvokeAsync(() =>
    {
        if (_selected is { } open && DealtWith.Captures.Contains(open.Item.Id)) Release();
        StateHasChanged();
    });

    /// <summary>
    /// Pulls the inbox and keeps it as this device's cached copy. A failure keeps
    /// whatever is on screen and says why in one line: a replica still warming up
    /// (503 <c>sync.replica_unavailable</c>) is a wait, anything else is a network
    /// the phone cannot reach — and neither is a reason to blank the list.
    /// <para>
    /// A refresh asked for while one is out runs once that one answers, never
    /// instead of it: the pull in flight may have been read before the capture
    /// that asked for the next one landed.
    /// </para>
    /// </summary>
    private async Task RefreshAsync()
    {
        if (_refreshing)
        {
            _refreshAgain = true;
            return;
        }

        _refreshing = true;

        try
        {
            do
            {
                _refreshAgain = false;
                await PullAsync();
            }
            while (_refreshAgain);
        }
        finally
        {
            _refreshing = false;
        }

        StateHasChanged();
    }

    private async Task PullAsync()
    {
        var asked = _deliveries;

        try
        {
            var items = await Sync.GetInboxAsync();
            var now = Clock.GetUtcNow();

            _items = items;
            _pulledAt = now;
            _pullNotice = null;

            // Asked after these were delivered, so the list has them — or they
            // have left the inbox since, dismissed on the desktop.
            foreach (var (id, sent) in _delivered.ToList())
            {
                if (sent.Delivery <= asked) _delivered.Remove(id);
            }

            _settled.RemoveAll(settled => settled.Delivery <= asked);

            await Store.SaveInboxAsync(new CachedInbox(items, now));
            Status.RecordSynced();
        }
        catch (Exception ex)
        {
            _items ??= [];
            _pullNotice = PullNotice(ex);
            if (SyncPullFailure.IsUnreachable(ex)) Status.RecordUnreachable();
        }
    }

    private string PullNotice(Exception failure)
    {
        var reason = SyncPullFailure.Reason(failure);

        var showing = _pulledAt is { } at
            ? $"Showing the inbox as it was {Ago(at)}."
            : "Nothing has been pulled to this phone yet.";

        return $"{reason} {showing} New captures are kept here and sent when it answers.";
    }

    /// <summary>
    /// Keeps the capture before anything else happens. The outbox writes it to
    /// the device, starts sending it, and returns — so the field clears and the
    /// row appears at once, marked waiting, whether or not there is a network.
    /// </summary>
    private async Task CaptureAsync()
    {
        var title = Draft.Text.Trim();
        if (title.Length == 0) return;

        var capture = CaptureOutboxKind.Create(title);
        await Outbox.EnqueueAsync(CaptureOutboxKind.Token, capture.Id!.Value, CaptureOutboxKind.Write(capture));

        Draft.Text = string.Empty;
        SharedCapture.ClearStatus();
    }

    private Task RetryAsync(Row row) => row.Waiting is { } waiting ? Outbox.RetryAsync(waiting.Id) : Task.CompletedTask;

    private static bool IsChange(OutboxEntry entry) =>
        entry.Kind is CaptureEditOutboxKind.Token or CaptureWithdrawOutboxKind.Token;

    private void Open(Row row)
    {
        _generation++;
        _debounce?.Dispose();
        _debounce = null;
        _titleMissing = false;
        _selected = row;
        _editTitle = row.Item.Title;
        _editNotes = row.Item.BodyMd ?? string.Empty;
        _dirty = false;
        _saveState = SaveState.Idle;
    }

    /// <summary>
    /// Asked before the sheet closes, however it is closed: what was typed is kept
    /// first, and the sheet stays open — with the reason, and a way to try again or
    /// discard — when it could not be, so no edit is lost with the sheet.
    /// </summary>
    private async Task<bool> CanCloseSheetAsync()
    {
        // A save already writing — the field's blur fires before the close — has
        // cleared the dirty mark before it knows whether it kept anything. Waited for
        // first, so a failure of that save is seen here and keeps the sheet open.
        await _saveGate.WaitAsync();
        _saveGate.Release();

        await FlushAsync();
        return !_dirty;
    }

    private void OnSheetOpenChanged(bool open)
    {
        if (!open) _selected = null;
    }

    /// <summary>The person gives up the edit that could not be kept, which is the
    /// way out they asked for: the sheet closes, and the capture keeps the words it
    /// had.</summary>
    private void DiscardEdit() => Release();

    /// <summary>Lets the open capture go with nothing left to keep: the wait and the
    /// unsaved mark are dropped, the generation moves on so a save still finishing
    /// for it leaves the next sheet alone, and the sheet closes.</summary>
    private void Release()
    {
        _debounce?.Dispose();
        _debounce = null;
        _generation++;
        _dirty = false;
        _titleMissing = false;
        _saveState = SaveState.Idle;
        _selected = null;
    }

    private void OnTitleChanged(string value)
    {
        _editTitle = value ?? string.Empty;
        ScheduleSave();
    }

    private void OnNotesChanged(string value)
    {
        _editNotes = value ?? string.Empty;
        ScheduleSave();
    }

    /// <summary>Restarts the wait on every keystroke: the edit is kept once typing
    /// has stopped for <see cref="SaveDelay"/>, as the Notes editor's is.</summary>
    private void ScheduleSave()
    {
        _dirty = true;
        _saveState = SaveState.Saving;
        if (_disposed) return;

        _debounce?.Dispose();
        _debounce = Clock.CreateTimer(_ => _ = InvokeAsync(SaveAsync), null, SaveDelay, Timeout.InfiniteTimeSpan);
    }

    /// <summary>The app is going to the background, where the OS may end it before
    /// the wait is up: the edit is kept now.</summary>
    private void OnPaused()
    {
        if (_disposed) return;

        _ = InvokeAsync(FlushAsync);
    }

    private Task FlushAsync()
    {
        if (!_dirty) return Task.CompletedTask;

        _debounce?.Dispose();
        _debounce = null;
        return SaveAsync();
    }

    /// <summary>
    /// Keeps the edit as it stands, through the outbox: rewritten where the capture
    /// still waits, queued behind it otherwise (<see cref="CaptureEdits"/>). A
    /// capture cannot be without a title, so a blank one is not kept and the sheet
    /// says so; the capture keeps its last title until one is typed.
    /// </summary>
    private async Task SaveAsync()
    {
        await _saveGate.WaitAsync();
        var generation = _generation;

        try
        {
            if (!_dirty || _selected is not { } selected) return;

            var title = _editTitle.Trim();
            if (title.Length == 0)
            {
                // Still dirty: the words are kept here until there is a title, and
                // the sheet will not close on them.
                _titleMissing = true;
                _saveFailure = "A capture needs a title. Type one to keep these changes, or discard them.";
                _saveState = SaveState.Failed;
                return;
            }

            _dirty = false;
            var notes = string.IsNullOrWhiteSpace(_editNotes) ? null : _editNotes.Trim();

            try
            {
                await Edits.EditAsync(selected.Item.Id, title, notes);

                if (generation == _generation)
                {
                    _titleMissing = false;
                    _saveState = _dirty ? SaveState.Saving : SaveState.Saved;
                }
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                if (generation == _generation)
                {
                    _dirty = true;
                    _titleMissing = false;
                    _saveFailure = $"Couldn't keep the change: {ex.Message}";
                    _saveState = SaveState.Failed;
                }
            }
        }
        finally
        {
            _saveGate.Release();
            if (!_disposed) StateHasChanged();
        }
    }

    private void AskToDelete() => _confirmingDelete = true;

    /// <summary>
    /// Deletes the open capture: out of the outbox if it has not left, otherwise a
    /// Delete queued for the service, which the desktop reads as the capture
    /// dismissed and archives. The row leaves the list at once either way, and
    /// anything still being typed goes with it.
    /// </summary>
    private async Task DeleteAsync()
    {
        if (_selected is not { } selected) return;

        _debounce?.Dispose();
        _debounce = null;

        // A save already under way finishes first, so its edit is in the outbox when
        // the Delete looks — and is dropped with the capture, not sent after it.
        await _saveGate.WaitAsync();

        try
        {
            var next = FocusAfterDelete(selected.Item.Id);

            await Edits.WithdrawAsync(selected.Item.Id);

            // Only now: had the Delete failed, the words typed would still be the
            // person's, and kept when the sheet closes.
            _generation++;
            _dirty = false;
            _titleMissing = false;
            _saveState = SaveState.Idle;
            _confirmingDelete = false;
            _selected = null;
            _focusAfterDelete = next;
        }
        finally
        {
            _saveGate.Release();
        }
    }

    /// <summary>The row that will stand where <paramref name="deleted"/> stood —
    /// the next one down, else the one above — or the capture field when it was
    /// the last.</summary>
    private string FocusAfterDelete(Guid deleted)
    {
        var rows = BuildRows();
        var index = rows.ToList().FindIndex(row => row.Item.Id == deleted);
        if (index < 0) return CaptureFieldId;

        var next = index + 1 < rows.Count ? rows[index + 1] : index > 0 ? rows[index - 1] : null;
        return next is null ? CaptureFieldId : RowId(next.Item.Id);
    }

    private string Ago(DateTimeOffset at) => SyncStatusLine.Relative(Clock.GetUtcNow() - at);

    private static string RowId(Guid id) => $"inbox-row-{id:N}";

    /// <summary>The body's first line with anything on it, or null. The row shows
    /// one line; the sheet shows the rest.</summary>
    private static string? PreviewLine(string? bodyMd) =>
        bodyMd?.Split('\n').Select(line => line.Trim()).FirstOrDefault(line => line.Length > 0);
}
