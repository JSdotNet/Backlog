@page "/"
@using Backlog.Mobile.UI.Services
@using Backlog.Infrastructure.Sync
@inject CloudSyncClient Sync
@inject IDeviceCredentialStore Credentials
@inject DevicePairingClient Pairing
@inject ISpeechTranscriber Speech
@inject ISharedContentReceiver SharedContentReceiver
@implements IDisposable

<PageTitle>Inbox</PageTitle>

<h1>Inbox</h1>

@if (Credentials.Current is null)
{
    @* Everything below is gated on this rather than left on screen and failing.
       The inbox endpoints are bearer-only, so an unpaired device typing a capture
       would get a 401 for its trouble - and "Cloud sync unavailable: 401" is not
       an answer anybody can act on. One thing to do, and it is the thing that
       makes the rest work. *@
    <Alert Message="Pair this device to sync." Role="status" BaseClass="capture__notice" TestId="pairing-notice" />

    <div class="capture">
        <TextField @bind-Value="_pairingCode" AriaLabel="Pairing code" Placeholder="XXXX-XXXX"
                   CssClass="capture__field" TestId="pairing-code-field" />
        <AppButton Variant="ButtonVariant.Primary" Disabled="@string.IsNullOrWhiteSpace(_pairingCode)"
                   OnClick="PairAsync" TestId="pairing-submit">Pair</AppButton>
    </div>

    @if (_pairingError is not null)
    {
        <Alert Message="@_pairingError" BaseClass="error" TestId="pairing-error" />
    }
}
else
{
    <div class="capture">
        <TextField @bind-Value="_draft" AriaLabel="Quick capture" Placeholder="Quick capture…"
                   CssClass="capture__field" TestId="capture-field" />
        @* Speech only ever fills this field. Capture is still the one thing that
           syncs, so nothing reaches the cloud that the person has not read first. *@
        <ToggleButton Pressed="_listening"
                      PressedChanged="OnSpeechToggledAsync"
                      Disabled="@(_speechSupported != true)"
                      AriaLabel="@(_listening ? "Stop dictating" : "Dictate a capture")"
                      Title="@(_listening ? "Stop dictating" : "Dictate a capture")"
                      CssClass="capture__mic"
                      TestId="speech-toggle">
            @* Drawn rather than fetched, for the same reason CopyButton draws its
               clipboard: a WebView with no egress still has to show the button. *@
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor"
                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="6" y="1.75" width="4" height="7.5" rx="2" />
                <path d="M3.75 7.25v.75a4.25 4.25 0 0 0 8.5 0v-.75" />
                <path d="M8 12.25v2" />
            </svg>
        </ToggleButton>
        <AppButton Variant="ButtonVariant.Primary" Disabled="@string.IsNullOrWhiteSpace(_draft)"
                   OnClick="CaptureAsync" TestId="capture-submit">Capture</AppButton>
    </div>

    @if (_shareStatus is not null)
    {
        @* A share fills the field and says so, and stops there. Capture is still the
           one thing that syncs, so nothing reaches the cloud that the person has not
           read first. *@
        <Alert Message="@_shareStatus" Role="status" BaseClass="capture__notice" TestId="share-status" />
    }

    @if (_speechSupported == false)
    {
        <Alert Message="Speech recognition is not available on this device — type your capture instead."
               Role="status" BaseClass="capture__notice" TestId="speech-unavailable" />
    }

    @if (_speechStatus is not null)
    {
        @* role="status" rather than "alert": this is the running commentary on a
           thing the person just started, not an interruption. *@
        <Alert Message="@_speechStatus" Role="status" BaseClass="capture__status" TestId="speech-status" />
    }

    @if (_speechError is not null)
    {
        <Alert Message="@_speechError" BaseClass="error" TestId="speech-error" />
    }

    @if (_error is not null)
    {
        <Alert Message="@($"Cloud sync unavailable: {_error}")" BaseClass="error" />
    }
    else if (_items is null)
    {
        <Spinner Label="Loading the inbox" />
    }
    else if (_items.Count == 0)
    {
        <EmptyState Title="Inbox is empty." />
    }
    else
    {
        <ul class="inbox">
            @foreach (var item in _items)
            {
                <li>
                    <span class="title">@item.Title</span>
                    <span class="source">@item.Source</span>
                    <AppButton aria-label="@($"Triage {item.Title}")" OnClick="() => AcknowledgeAsync(item.Id)">Triage</AppButton>
                </li>
            }
        </ul>
    }
}

@code {
    private const string Listening = "Listening…";

    private IReadOnlyList<InboxItem>? _items;
    private string _draft = string.Empty;
    private string? _error;

    private string _pairingCode = string.Empty;
    private string? _pairingError;

    /// <summary>Null until the recogniser has been asked. Neither "yes" nor "no"
    /// is true during the first render, and claiming either would flash a
    /// message or an enabled button that the answer then contradicts.</summary>
    private bool? _speechSupported;

    private bool _listening;
    private string? _speechStatus;
    private string? _speechError;

    private string? _shareStatus;
    private IDisposable? _shareSubscription;

    /// <summary>
    /// The share source is subscribed to before the first await, because on
    /// Android the share is what launched the app: the intent was read while this
    /// component was still being built, and the payload is sitting in the
    /// receiver's buffer waiting for the first subscriber. Waiting until after the
    /// inbox has loaded would only delay a draft the person is already looking for.
    /// </summary>
    protected override Task OnInitializedAsync()
    {
        _shareSubscription = SharedContentReceiver.Subscribe(OnContentShared);

        // An unpaired device has nothing to load and no token to load it with, so
        // it does not ask: a 401 on first render would put "Cloud sync
        // unavailable" above the pairing box that is the answer to it.
        return Credentials.Current is null ? Task.CompletedTask : RefreshAsync();
    }

    public void Dispose() => _shareSubscription?.Dispose();

    /// <summary>
    /// A share is a draft, never a capture. It lands in the field where it can
    /// still be read and edited, with a line saying where it came from, and
    /// nothing leaves the device until Capture is pressed.
    /// </summary>
    private void OnContentShared(SharedContent content)
    {
        var draft = content.Draft;
        if (draft.Length == 0) return;

        _draft = Append(_draft, draft);
        _shareStatus = "Shared from another app. Edit it if you like, then press Capture.";

        // Not awaited, and not a plain StateHasChanged: an Android share is
        // published from the platform's main thread, and a replay arrives while
        // this component is still initialising. InvokeAsync is the one call that
        // is right in both cases.
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// The support question is asked after the first render, not before it: in
    /// the browser harness the component prerenders on the server, where there
    /// is no browser to ask and the honest answer would be a misleading "no".
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _speechSupported = await Speech.IsSupportedAsync();
        StateHasChanged();
    }

    private async Task OnSpeechToggledAsync(bool pressed)
    {
        if (!pressed)
        {
            // Stop only asks; the words arrive on the listening turn below.
            await Speech.StopAsync();
            return;
        }

        _listening = true;
        _speechError = null;
        _speechStatus = Listening;

        // ListenAsync does not complete until recognition ends, so it is
        // deliberately not awaited here: this handler has to return for the
        // pressed state and the "Listening…" line to reach the screen at all.
        _ = ListenAsync();
    }

    private async Task ListenAsync()
    {
        SpeechTranscript result;

        try
        {
            result = await Speech.ListenAsync();
        }
        catch (Exception ex)
        {
            // The transcribers report their failures as results; anything that
            // still arrives as an exception is unexpected, and swallowing it
            // would leave the button stuck on.
            result = SpeechTranscript.Failed(ex.Message);
        }

        _listening = false;

        if (result.IsError)
        {
            _speechStatus = null;
            _speechError = result.Error;
        }
        else if (result.Text.Length == 0)
        {
            _speechStatus = "Nothing was heard.";
        }
        else
        {
            _speechStatus = $"Heard: {result.Text}";
            _draft = Append(_draft, result.Text);
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Dictation and shares extend what is in the field rather than replacing it
    /// — a second sentence, or a link added to a half-written note, is the
    /// ordinary case, and overwriting would lose the first one with no way back.
    /// </summary>
    private static string Append(string draft, string addition)
    {
        var existing = draft.TrimEnd();
        return existing.Length == 0 ? addition : $"{existing} {addition}";
    }

    private async Task RefreshAsync()
    {
        try
        {
            _error = null;
            _items = await Sync.GetInboxAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CaptureAsync()
    {
        var title = _draft.Trim();
        if (title.Length == 0) return;

        _draft = string.Empty;
        _speechStatus = null;
        _shareStatus = null;

        try
        {
            await Sync.CaptureAsync(title);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            return;
        }

        await RefreshAsync();
    }

    /// <summary>
    /// Redeems the code somebody read out on the device that is already in. The
    /// client stores the credential it gets back, so all this has to do is load
    /// the inbox the screen can finally see.
    /// <para>
    /// The device is named rather than asked about: a phone has one name that
    /// matters and it is already on the phone, and a second field between a
    /// person and the one thing this screen is for would be a field they type
    /// through rather than read.
    /// </para>
    /// </summary>
    private async Task PairAsync()
    {
        _pairingError = null;

        try
        {
            var result = await Pairing.PairAsync(_pairingCode, DeviceName);

            if (result.IsFailure)
            {
                _pairingError = result.Error.Message;
                return;
            }

            _pairingCode = string.Empty;
        }
        catch (Exception ex)
        {
            // Expected failures come back as a result; anything still arriving as
            // an exception has to reach the screen, because one swallowed in an
            // event handler leaves the button looking like it did nothing.
            _pairingError = ex.Message;
            return;
        }

        await RefreshAsync();
    }

    private static string DeviceName =>
        string.IsNullOrWhiteSpace(Environment.MachineName) ? "Phone" : Environment.MachineName;

    private async Task AcknowledgeAsync(Guid id)
    {
        try
        {
            await Sync.AcknowledgeAsync(id);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            return;
        }

        await RefreshAsync();
    }
}
