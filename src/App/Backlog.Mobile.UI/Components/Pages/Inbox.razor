@page "/inbox"
@using Backlog.Mobile.UI.Notes
@inject CloudSyncClient Sync
@inject DeviceOutbox Outbox
@inject IDeviceStore Store
@inject NoteViewProjection Notes
@inject CaptureDraft Draft
@inject SyncStatusTracker Status
@inject AppLifecycle Lifecycle
@inject TimeProvider Clock
@inject SharedContentCapture SharedCapture
@inject NavigationManager Navigation
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>Inbox</PageTitle>

@*
    The phone Inbox (.devbook/design/interaction-guidelines.md#phone-inbox): one list of
    the captures this phone made, each with where it stands on its way to the desktop
    until the desktop takes it in, and every note and meeting the phone holds, which
    stay. Every row leads its metadata line with its kind's mark. A capture row opens
    the whole capture and offers nothing else — no Today, Later, To note or delete:
    triage stays on the desktop (.devbook/domain/inbox/features.md#triage-stays-on-the-desktop).
    A note or meeting row opens it in the note editor.

    The kind chips — All, Captures, Notes, Meetings — are one fused group with exactly
    one pressed, and one tab stop the arrows move (data-roving-buttons). The page has
    one +, beside the quick field: with words in the field it adds them as a capture,
    as Enter does; with the field empty it is New, a menu of Note and Meeting. Note
    opens an empty editor, Meeting a new meeting already recording. /notes opens this
    page on the Notes chip (?kind=notes).
*@

@{
    // Read once per render: each read walks the outbox and copies the notes.
    var (everything, shown) = Lists();
}

<header class="inbox-heading">
    <div class="inbox-heading__titles">
        <span class="inbox-heading__lede" data-testid="inbox-count">@CountLabel(shown.Count)</span>
        @* The tab bar names the page on screen; the heading is kept for screen readers. *@
        <h1 class="sr-only">Inbox</h1>
    </div>
    @* The pull gesture's twin, for a pointer, a keyboard and a screen reader —
       none of which can pull. *@
    <IconButton AriaLabel="Refresh the inbox" Title="Refresh the inbox" Disabled="_refreshing"
                OnClick="RefreshAsync" CssClass="inbox-heading__refresh" TestId="inbox-refresh">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor"
             stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M13.25 8a5.25 5.25 0 1 1-1.54-3.71" />
            <path d="M13.25 2.75v2.5h-2.5" />
        </svg>
    </IconButton>
</header>

<div class="inbox-kinds">
    <ButtonGroup CssClass="inbox-kinds__chips" AriaLabel="Kind" TestId="inbox-kinds" data-roving-buttons>
        @foreach (var chip in Chips)
        {
            <ToggleButton Pressed="@(_filter == chip.Filter)"
                          PressedChanged="_ => Choose(chip.Filter)"
                          CssClass="inbox-kinds__chip"
                          tabindex="@(_firstStop == chip.Filter ? "0" : "-1")"
                          TestId="@($"inbox-kind-{chip.Slug}")">@chip.Label</ToggleButton>
        }
    </ButtonGroup>
</div>

@* The one + on the page. With words in the field it adds them as a capture, as
   Enter does; with the field empty it is New, a menu of Note and Meeting. Its
   name follows what it will do, and only the menu mode says it opens a menu. *@
<div class="capture">
    <TextField @bind-Value="Draft.Text" AriaLabel="Add to inbox" Placeholder="Add to inbox…"
               CssClass="capture__field" TestId="capture-field" @onkeydown="OnFieldKeyDownAsync" />
    <IconButton AriaLabel="@PlusLabel" Title="@PlusLabel" OnClick="OnPlusAsync"
                CssClass="capture__add" TestId="capture-submit" id="@PlusId"
                aria-haspopup="@(HasDraft ? null : "menu")"
                aria-expanded="@(HasDraft ? null : _newMenuOpen ? "true" : "false")">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4"
             stroke-linecap="round" aria-hidden="true" focusable="false">
            <path d="M12 5v14M5 12h14" />
        </svg>
    </IconButton>
    <ContextMenu Open="_newMenuOpen" OpenChanged="open => _newMenuOpen = open"
                 X="@_newMenuX" Y="@_newMenuY" AlignEnd="true" Items="@NewItems" AriaLabel="New"
                 TestId="inbox-new-menu" OnItemSelected="OnNewChosen" />
</div>

@if (SharedCapture.Status is { } shareStatus)
{
    @* A share is captured the moment it arrives, wherever the app was; this line
       is what says where the new row at the top came from. The field is left as
       it was — a draft being typed is not the share's to touch. *@
    <Alert Message="@shareStatus" Role="status" BaseClass="capture__notice" TestId="share-status" />
}

@if (_pullNotice is not null)
{
    @* A calm line, not an error: the list below is still the last one the phone
       saw, and a capture made now is kept and sent later. *@
    <Alert Message="@_pullNotice" Role="status" BaseClass="capture__notice" TestId="inbox-pull-notice" />
}
else if (_notesNotice is not null)
{
    <Alert Message="@_notesNotice" Role="status" BaseClass="capture__notice" TestId="notes-pull-notice" />
}

@if (everything.Count > 0)
{
    <SearchBox Value="@_query" ValueChanged="OnSearch" Placeholder="Search the inbox" AriaLabel="Search the inbox"
               DebounceMilliseconds="0" CssClass="inbox__search" TestId="inbox-search" />
}

<section class="inbox" @ref="_listElement" aria-label="Inbox items">
    @if (_items is null && everything.Count == 0)
    {
        <Spinner Label="Loading the inbox" />
    }
    else if (shown.Count == 0 && !string.IsNullOrWhiteSpace(_query))
    {
        <EmptyState Title="Nothing matches"
                    Description="@($"Nothing in a title or a body says “{_query.Trim()}”.")"
                    TestId="inbox-no-match" />
    }
    else if (shown.Count == 0)
    {
        @switch (_filter)
        {
            case PhoneInboxFilter.Notes:
                <EmptyState Title="No notes yet"
                            Description="Write one with Note in the + menu. Notes you take on the desktop show here too."
                            TestId="notes-empty" />
                break;
            case PhoneInboxFilter.Meetings:
                <EmptyState Title="No meetings yet"
                            Description="Start one with Meeting in the + menu: it opens already recording."
                            TestId="meetings-empty" />
                break;
            default:
                <EmptyState Title="Inbox clear" Description="Everything has a place." TestId="inbox-empty" />
                break;
        }
    }
    else
    {
        <ul class="inbox__list" data-testid="inbox-list">
            @foreach (var row in shown)
            {
                <li @key="row.Id">
                    @if (row.Capture is { } capture)
                    {
                        var item = capture.Item;

                        <CaptureRow Title="@item.Title" Kind="@CaptureKindGuess.Of(item.Title, item.BodyMd)"
                                    Time="@Ago(item.CapturedAt)" Preview="@PreviewLine(item.BodyMd)"
                                    State="StateOf(capture)" StuckReason="@capture.Pending?.LastError"
                                    Id="@RowId(item.Id)" OnOpen="() => Open(capture)"
                                    OnRetry="() => RetryAsync(item.Id)" TestId="inbox-row" />
                    }
                    else if (row.Note is { } note)
                    {
                        <NoteRow Title="@note.Title" Kind="@(note.IsMeeting ? "meeting" : "note")"
                                 When="@When(note)" Snippet="@NoteSnippet.Of(note.Body, note.Title)"
                                 Href="@($"notes/{note.Id}")" TestId="note-row" />
                    }
                </li>
            }
        </ul>
    }
</section>

<DetailSheet Open="_selected is not null" OpenChanged="OnSheetOpenChanged"
             Kicker="@(_selected is null ? null : $"Captured {Ago(_selected.Item.CapturedAt)}")"
             Title="@_selected?.Item.Title" AriaLabel="Capture" CloseLabel="Close capture"
             RestoreFocusToId="@(_selected is null ? null : RowId(_selected.Item.Id))"
             CssClass="inbox-sheet" TestId="inbox-sheet">
    @if (_selected is { Item: var shownItem })
    {
        @if (!string.IsNullOrWhiteSpace(shownItem.BodyMd))
        {
            <div class="inbox-sheet__body" data-testid="inbox-sheet-body">
                <MarkdownView Blocks="@MarkdownPreview.ParseDocument(shownItem.BodyMd)" Source="@shownItem.BodyMd" />
            </div>
        }

        <dl class="inbox-sheet__facts">
            <dt>Source</dt>
            <dd data-testid="inbox-sheet-source">@(string.IsNullOrWhiteSpace(shownItem.Source) ? "—" : shownItem.Source)</dd>

            @if (!string.IsNullOrWhiteSpace(shownItem.Person))
            {
                <dt>Person</dt>
                <dd data-testid="inbox-sheet-person">@("@" + shownItem.Person)</dd>
            }

            @if (shownItem.Tags is { Count: > 0 } tags)
            {
                <dt>Tags</dt>
                <dd class="inbox-sheet__tags" data-testid="inbox-sheet-tags">
                    @foreach (var tag in tags)
                    {
                        <TagChip Text="@tag.TrimStart('#')" />
                    }
                </dd>
            }

            @if (_selected.Pending is { } pending)
            {
                <dt>Sync</dt>
                <dd data-testid="inbox-sheet-sync">
                    @(pending.IsParked ? $"Waiting — {pending.LastError}" : "Waiting to be sent")
                </dd>
            }
        </dl>
    }
</DetailSheet>

@code {
    /// <summary>One kind chip: the filter it sets, its slug in the test id and the
    /// <c>?kind=</c> address, and its word.</summary>
    private sealed record Chip(PhoneInboxFilter Filter, string Slug, string Label);

    private static readonly IReadOnlyList<Chip> Chips =
    [
        new(PhoneInboxFilter.All, "all", "All"),
        new(PhoneInboxFilter.Captures, "captures", "Captures"),
        new(PhoneInboxFilter.Notes, "notes", "Notes"),
        new(PhoneInboxFilter.Meetings, "meetings", "Meetings")
    ];

    /// <summary>The + menu: two items, which earn a menu where one would not
    /// (interaction-guidelines.md#action-density-and-overflow).</summary>
    private static readonly IReadOnlyList<MenuItem> NewItems =
    [
        new("note", "Note"),
        new("meeting", "Meeting")
    ];

    /// <summary>The address of a new meeting: the note editor, told to open a meeting
    /// already recording.</summary>
    public const string NewMeetingRoute = "notes/new?kind=meeting";

    /// <summary>The chip <c>?kind=</c> presses when the page opens — <c>notes</c> from the
    /// old <c>/notes</c> address. Read only when it changes, so a chip pressed since
    /// is not undone by a redraw.</summary>
    [SupplyParameterFromQuery(Name = "kind")]
    public string? KindQuery { get; set; }

    private string? _appliedKindQuery;
    private PhoneInboxFilter _filter = PhoneInboxFilter.All;

    /// <summary>The chip that holds the group's tab stop when the page is first drawn,
    /// written the same on every render after: components.js moves the stop on the
    /// arrows, and a re-render that wrote the pressed chip's stop instead would leave
    /// the group with two (accessibility.md#roving-button-groups).</summary>
    private PhoneInboxFilter? _firstStop;
    private string _query = string.Empty;

    private bool _newMenuOpen;
    private double _newMenuX;
    private double _newMenuY;

    /// <summary>The last list the service answered with — this device's cached
    /// copy until the first pull of this visit lands. Null only when the phone
    /// has never pulled and the first pull has not answered yet.</summary>
    private IReadOnlyList<InboxItem>? _items;

    private DateTimeOffset? _pulledAt;
    private string? _pullNotice;
    private string? _notesNotice;
    private bool _refreshing;
    private bool _refreshAgain;
    private PhoneCaptureRow? _selected;

    /// <summary>
    /// Captures the outbox has delivered that no pull asked for since, each with
    /// the delivery's number. The outbox has the service's word for them, so they
    /// are listed as delivered until a pull that began after the delivery answers
    /// — the one in flight may have been read before the capture landed, and the
    /// next one may fail.
    /// </summary>
    private readonly Dictionary<Guid, (InboxItem Item, long Delivery)> _delivered = [];
    private long _deliveries;

    private ElementReference _listElement;
    private IJSObjectReference? _pullModule;
    private IJSObjectReference? _pullGesture;
    private DotNetObjectReference<Inbox>? _self;

    /// <summary>Every row before the chips and the search narrow them, and the rows on
    /// screen: the chip pressed, then the words searched for. Both from one read of the
    /// captures and the notes.</summary>
    private (IReadOnlyList<PhoneInboxRow> Everything, IReadOnlyList<PhoneInboxRow> Shown) Lists()
    {
        var captures = Captures;
        var notes = Notes.Notes();

        return (PhoneInboxList.Of(captures, notes, PhoneInboxFilter.All), PhoneInboxList.Of(captures, notes, _filter, _query));
    }

    /// <summary>
    /// What the outbox still holds, above what the service has sent back. A capture
    /// the service has but the outbox has not yet heard back about is shown once, as
    /// the outbox's. One the outbox has delivered is shown as delivered, whether or
    /// not a pull has brought it back yet.
    /// </summary>
    private IReadOnlyList<PhoneCaptureRow> Captures
    {
        get
        {
            var pending = Outbox.Entries
                .Where(IsCapture)
                .Select(entry => new PhoneCaptureRow(ItemOf(entry), entry))
                .ToList();

            var shown = pending.Select(row => row.Item.Id).ToHashSet();
            var pulled = (_items ?? []).Where(IsThisPhones).Where(item => shown.Add(item.Id)).Select(item => new PhoneCaptureRow(item, null)).ToList();
            var delivered = _delivered.Values.Where(sent => shown.Add(sent.Item.Id)).Select(sent => new PhoneCaptureRow(sent.Item, null));

            return [.. pending.Concat(pulled).Concat(delivered)];
        }
    }

    /// <summary>
    /// The service answers with every capture the desktop has not taken in yet,
    /// from wherever it came. The Inbox lists the phone's own captures, so a pulled
    /// one is listed when it came from the phone channel.
    /// </summary>
    private static bool IsThisPhones(InboxItem item) =>
        string.Equals(item.Source, CaptureOutboxKind.Source, StringComparison.OrdinalIgnoreCase);

    /// <summary>"3 items to sort", "1 item to sort", "Nothing to sort".</summary>
    private static string CountLabel(int count) => count switch
    {
        0 => "Nothing to sort",
        1 => "1 item to sort",
        var n => $"{n} items to sort"
    };

    private static CaptureSyncState StateOf(PhoneCaptureRow row) => row.Pending switch
    {
        null => CaptureSyncState.Sent,
        { IsParked: true } => CaptureSyncState.Stuck,
        _ => CaptureSyncState.Waiting
    };

    private static bool IsCapture(OutboxEntry entry) =>
        entry.Kind is CaptureOutboxKind.Token or TalkNoteOutboxKind.Token;

    /// <summary>The capture an entry will become. A talk note is a capture with
    /// its uploads in front of it; on the list it is that capture.</summary>
    private static InboxItem ItemOf(OutboxEntry entry)
    {
        var capture = entry.Kind == TalkNoteOutboxKind.Token
            ? TalkNoteOutboxKind.Read(entry).Capture
            : CaptureOutboxKind.Read(entry);

        return new InboxItem(entry.Id, capture.Title, capture.Source, entry.CreatedAt, capture.BodyMd, capture.Tags, capture.Person, capture.Attachments);
    }

    /// <summary>
    /// The cached list and the notes the phone holds are drawn before the service
    /// is asked anything. A replica still warming up, or no signal at all, then
    /// costs a status line rather than a blank screen.
    /// <para>
    /// The device is paired by the time this runs: the layout draws the pairing
    /// gate instead of any page until it is.
    /// </para>
    /// </summary>
    protected override Task OnInitializedAsync()
    {
        SharedCapture.Changed += OnShareStatusChanged;
        Outbox.Changed += OnOutboxChanged;
        Outbox.Delivered += OnDelivered;
        Notes.Changed += OnNotesChanged;
        Lifecycle.Resumed += OnResumed;

        if (Store.ReadInbox() is { } cached)
        {
            _items = cached.Items;
            _pulledAt = cached.PulledAt;
        }

        return RefreshAsync();
    }

    protected override void OnParametersSet()
    {
        if (!string.Equals(KindQuery, _appliedKindQuery, StringComparison.Ordinal))
        {
            _appliedKindQuery = KindQuery;
            _filter = Chips.FirstOrDefault(chip => string.Equals(chip.Slug, KindQuery, StringComparison.OrdinalIgnoreCase))?.Filter
                ?? PhoneInboxFilter.All;
        }

        _firstStop ??= _filter;
    }

    public async ValueTask DisposeAsync()
    {
        SharedCapture.Changed -= OnShareStatusChanged;
        Outbox.Changed -= OnOutboxChanged;
        Outbox.Delivered -= OnDelivered;
        Notes.Changed -= OnNotesChanged;
        Lifecycle.Resumed -= OnResumed;

        try
        {
            if (_pullGesture is not null)
            {
                await _pullGesture.InvokeVoidAsync("dispose");
                await _pullGesture.DisposeAsync();
            }

            if (_pullModule is not null) await _pullModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }

        _self?.Dispose();
    }

    /// <summary>Exactly one chip is pressed: a press on the pressed one leaves it on.</summary>
    private void Choose(PhoneInboxFilter filter) => _filter = filter;

    private void OnSearch(string query) => _query = query ?? string.Empty;

    /// <summary>Whether the quick field holds words: the + then adds them.</summary>
    private bool HasDraft => !string.IsNullOrWhiteSpace(Draft.Text);

    private string PlusLabel => HasDraft ? "Add to inbox" : "New";

    /// <summary>The + button's id, which the menu is anchored to.</summary>
    private const string PlusId = "inbox-plus";

    /// <summary>
    /// Adds the words as a capture, or with none opens New under the +, its end edge
    /// on the button's (ContextMenu.AlignEnd), so the menu opens inward from the
    /// window's right edge. Anchored to the button for a tap and a key alike: a key's
    /// click has no pointer, and a tap's point would put the menu's corner under the
    /// finger. The pointer stands in only when the page cannot say where the + is.
    /// </summary>
    private async Task OnPlusAsync(MouseEventArgs e)
    {
        if (HasDraft)
        {
            await CaptureAsync();
            return;
        }

        (_newMenuX, _newMenuY) = (e.ClientX, e.ClientY);

        try
        {
            if (await Js.InvokeAsync<double[]?>("backlogAnchorBelow", PlusId, true) is [var x, var y])
            {
                (_newMenuX, _newMenuY) = (x, y);
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // No browser to ask: the pointer's position stands.
        }

        _newMenuOpen = true;
    }

    /// <summary>
    /// Enter adds the words, once. The field binds on input, not on change, so the
    /// change event Enter also raises commits nothing; and the capture clears the
    /// draft, so a second Enter on the same words finds nothing to add.
    /// </summary>
    private Task OnFieldKeyDownAsync(KeyboardEventArgs e) =>
        e is { Key: "Enter", ShiftKey: false, AltKey: false, CtrlKey: false, MetaKey: false, Repeat: false }
            ? CaptureAsync()
            : Task.CompletedTask;

    /// <summary>Note opens an empty editor; Meeting opens a new meeting already recording.</summary>
    private void OnNewChosen(MenuItem item)
    {
        _newMenuOpen = false;
        Navigation.NavigateTo(item.Id == "meeting" ? NewMeetingRoute : "notes/new");
    }

    /// <summary>The share itself is already in the outbox, and its row arrives
    /// through <see cref="OnOutboxChanged"/>; this only redraws the line that
    /// explains it.</summary>
    private void OnShareStatusChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// The pull gesture is attached after the first render, not before it: in
    /// the browser harness the component prerenders on the server, where there
    /// is no browser to attach it to.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await AttachPullGestureAsync();
    }

    private async Task AttachPullGestureAsync()
    {
        try
        {
            _pullModule = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/Backlog.Mobile.UI/pull-refresh.js");
            if (_pullModule is null) return;

            _self = DotNetObjectReference.Create(this);
            _pullGesture = await _pullModule.InvokeAsync<IJSObjectReference>("attach", _listElement, _self);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // No gesture where there is no browser; the refresh button still works.
        }
    }

    [JSInvokable]
    public Task OnPulled() => InvokeAsync(RefreshAsync);

    private void OnResumed() => _ = InvokeAsync(RefreshAsync);

    private void OnOutboxChanged() => _ = InvokeAsync(StateHasChanged);

    // Raised off the render thread by a pull or a write.
    private void OnNotesChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>The service has the capture now: the row stops saying it is
    /// waiting at once, and the list the service answers with next replaces it.
    /// A note delivered is pulled back, so the row carries the replica's copy.</summary>
    private void OnDelivered(OutboxEntry entry) => _ = InvokeAsync(() =>
    {
        if (IsCapture(entry)) _delivered[entry.Id] = (ItemOf(entry), ++_deliveries);
        StateHasChanged();
        return RefreshAsync();
    });

    /// <summary>
    /// Pulls the inbox and the notes. The inbox is kept as this device's cached
    /// copy. A failure keeps whatever is on screen and says why in one line: a
    /// replica still warming up (503 <c>sync.replica_unavailable</c>) is a wait,
    /// anything else is a network the phone cannot reach — and neither is a reason
    /// to blank the list.
    /// <para>
    /// A refresh asked for while one is out runs once that one answers, never
    /// instead of it: the pull in flight may have been read before the capture
    /// that asked for the next one landed.
    /// </para>
    /// </summary>
    private async Task RefreshAsync()
    {
        if (_refreshing)
        {
            _refreshAgain = true;
            return;
        }

        _refreshing = true;

        try
        {
            do
            {
                _refreshAgain = false;
                await PullAsync();
                await PullNotesAsync();
            }
            while (_refreshAgain);
        }
        finally
        {
            _refreshing = false;
        }

        StateHasChanged();
    }

    private async Task PullAsync()
    {
        var asked = _deliveries;

        try
        {
            var items = await Sync.GetInboxAsync();
            var now = Clock.GetUtcNow();

            _items = items;
            _pulledAt = now;
            _pullNotice = null;

            // Asked after these were delivered, so the list has them — or they
            // have left the inbox since, dismissed on the desktop.
            foreach (var (id, sent) in _delivered.ToList())
            {
                if (sent.Delivery <= asked) _delivered.Remove(id);
            }

            await Store.SaveInboxAsync(new CachedInbox(items, now));
            Status.RecordSynced();
        }
        catch (Exception ex)
        {
            _items ??= [];
            _pullNotice = PullNotice(ex);
            if (SyncPullFailure.IsUnreachable(ex)) Status.RecordUnreachable();
        }
    }

    /// <summary>Pulls the notes and meetings changed since the last pull. A failure
    /// keeps them on screen as the phone last saw them, and says so.</summary>
    private async Task PullNotesAsync()
    {
        try
        {
            await Notes.PullAsync();
            _notesNotice = null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            var reason = SyncPullFailure.Reason(ex);

            _notesNotice = $"{reason} Showing notes as this phone last saw them. Notes written here are kept and sent when it answers.";
            if (SyncPullFailure.IsUnreachable(ex)) Status.RecordUnreachable();
        }
    }

    private string PullNotice(Exception failure)
    {
        var reason = SyncPullFailure.Reason(failure);

        var showing = _pulledAt is { } at
            ? $"Showing the inbox as it was {Ago(at)}."
            : "Nothing has been pulled to this phone yet.";

        return $"{reason} {showing} New captures are kept here and sent when it answers.";
    }

    /// <summary>
    /// Keeps the capture before anything else happens. The outbox writes it to
    /// the device, starts sending it, and returns — so the field clears and the
    /// row appears at once, marked waiting, whether or not there is a network.
    /// </summary>
    private async Task CaptureAsync()
    {
        var title = Draft.Text.Trim();
        if (title.Length == 0) return;

        var capture = CaptureOutboxKind.Create(title);
        await Outbox.EnqueueAsync(CaptureOutboxKind.Token, capture.Id!.Value, CaptureOutboxKind.Write(capture));

        Draft.Text = string.Empty;
        SharedCapture.ClearStatus();
    }

    private Task RetryAsync(Guid id) => Outbox.RetryAsync(id);

    private void Open(PhoneCaptureRow row) => _selected = row;

    private void OnSheetOpenChanged(bool open)
    {
        if (!open) _selected = null;
    }

    private string Ago(DateTimeOffset at) => SyncStatusLine.Relative(Clock.GetUtcNow() - at);

    private string When(NoteViewRow note) =>
        NoteTimeLabel.For(
            TimeZoneInfo.ConvertTime(note.UpdatedAt, Clock.LocalTimeZone),
            Clock.GetLocalNow());

    private static string RowId(Guid id) => $"inbox-row-{id:N}";

    /// <summary>The body's first line with anything on it, or null. The row shows
    /// one line; the sheet shows the rest.</summary>
    private static string? PreviewLine(string? bodyMd) =>
        bodyMd?.Split('\n').Select(line => line.Trim()).FirstOrDefault(line => line.Length > 0);
}
