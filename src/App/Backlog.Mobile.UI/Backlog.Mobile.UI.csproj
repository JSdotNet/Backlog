<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>Backlog.Mobile.UI</RootNamespace>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- The outbox and the cached inbox: what the phone keeps on itself so a
         capture outlives a dead network and the list outlives a cold replica. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests wait on the outbox going idle, which only they need to see. -->
    <InternalsVisibleTo Include="Backlog.Mobile.UI.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Backlog.UI.Components\Backlog.UI.Components.csproj" />
    <!-- The shell asks whether this device is paired before it shows any tab,
         and pairs it when it is not. Both hosts register the
         credential store behind that port; the screen only asks. -->
    <ProjectReference Include="..\..\Infrastructure\Backlog.Infrastructure.Sync\Backlog.Infrastructure.Sync.csproj" />
  </ItemGroup>

</Project>
