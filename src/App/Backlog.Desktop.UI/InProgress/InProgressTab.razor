@*
    The In progress tab: the view by task (InProgressView), shown while the goals flag is
    off (.devbook/domain/sessions/features.md#in-progress-by-task). With the flag on the
    shell draws the Goals view in its place (GoalsTab).
*@
<InProgressView Reader="Reader"
                OnOpenTask="OnOpenTask"
                OnOpenSession="OnOpenSession"
                OnOpenPullRequest="OnOpenPullRequest"
                ShowSessions="ShowSessions"
                ShowPullRequests="ShowPullRequests"
                NeedsYouFirst="NeedsYouFirst"
                NeedsYouFirstChanged="NeedsYouFirstChanged"
                IncludeFinishedToday="IncludeFinishedToday"
                IncludeFinishedTodayChanged="IncludeFinishedTodayChanged" />

@code {
    /// <summary>The shell's reader, shared with the side panel.</summary>
    [Parameter, EditorRequired]
    public WorkInProgressReader Reader { get; set; } = default!;

    [Parameter]
    public EventCallback<Guid> OnOpenTask { get; set; }

    [Parameter]
    public EventCallback<string> OnOpenSession { get; set; }

    [Parameter]
    public EventCallback<string> OnOpenPullRequest { get; set; }

    [Parameter]
    public bool ShowSessions { get; set; } = true;

    [Parameter]
    public bool ShowPullRequests { get; set; } = true;

    [Parameter]
    public bool NeedsYouFirst { get; set; } = true;

    [Parameter]
    public EventCallback<bool> NeedsYouFirstChanged { get; set; }

    [Parameter]
    public bool IncludeFinishedToday { get; set; }

    [Parameter]
    public EventCallback<bool> IncludeFinishedTodayChanged { get; set; }
}
