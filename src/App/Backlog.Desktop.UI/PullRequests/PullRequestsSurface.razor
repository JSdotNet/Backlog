@using Backlog.SharedKernel
@using Backlog.Modules.Sessions.Abstractions
@using Backlog.Modules.Sessions.UI
@using Backlog.Desktop.UI.Shell
@using Backlog.Desktop.UI.Tasks
@inject ISurfaceNavigator Navigator
@inject ISurfaceCatalog Catalog
@inject IServiceProvider Services

@*
    The Sessions context's open pull requests as a shell surface (local ADR 0040 §1,
    §3, §6): a takeover, in the main window in place of the main view or in a window of
    its own. `pullRequest=<owner/name#number>` opens it on that pull request, its row
    marked — a jump from a work card on a task's side panel.

    Drawn from the host rather than from the Sessions module, because the list reads
    GitHub through the host's integration, which no module UI project may reference.
    It reads the window's own task list and repository scope, and its jumps — to the
    entry a pull request belongs to, to the session it came from — go through the
    window's navigator, so they land in the window they were pressed in.
*@
<PullRequestsPane OnClose="OnClose"
                  RepositoryScope="@(_state?.SelectedRepositoryAliases ?? [])"
                  RepositoryAlias="@RepositoryAlias"
                  RepositoryColour="@RepositoryColour"
                  PullRequestTask="@(_references is { } references ? references.PullRequestTaskFor : null)"
                  OnOpenTask="@OpenTaskCallback"
                  OnOpenSession="OpenSession"
                  FocusPullRequest="@FocusPullRequest" />

@code {
    /// <summary>The pull requests surface's id.</summary>
    public const string SurfaceId = SessionsSurfaceRegistration.PullRequestsSurfaceId;

    /// <summary>The query key naming the pull request the list opens on, as
    /// <c>owner/name#number</c>.</summary>
    public const string PullRequestKey = "pullRequest";

    /// <summary>The test id of the toast when the session list is switched off.</summary>
    public const string SessionsOffTestId = "tasks-session-sessions-off";

    /// <summary>The query the surface was shown with: <c>pullRequest</c>, or nothing.</summary>
    [Parameter]
    public IReadOnlyDictionary<string, string>? Query { get; set; }

    /// <summary>Closes the surface: back to the main view, or the window closed.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private TasksDesktopState? _state;
    private ShellTaskReferences? _references;
    private IToastChannel? _toasts;

    protected override void OnInitialized()
    {
        _state = Services.GetService<TasksDesktopState>();
        _references = Services.GetService<ShellTaskReferences>();
        _toasts = Services.GetService<IToastChannel>();
    }

    private Func<string?, string?>? RepositoryAlias => _state is { } state ? state.RepositoryAliasFor : null;

    private Func<string?, int?>? RepositoryColour => _state is { } state ? state.RepositoryColourFor : null;

    private string? FocusPullRequest =>
        Query is not null && Query.TryGetValue(PullRequestKey, out var key) && key.Length > 0 ? key : null;

    private EventCallback<DeliveryRunReference> OpenTaskCallback =>
        _references is { } references ? EventCallback.Factory.Create<DeliveryRunReference>(this, references.OpenTaskAsync) : default;

    /// <summary>A pull request's session: the session list on that session, in this
    /// window. A list switched off is said out loud rather than forced open over a
    /// setting the reader chose.</summary>
    private void OpenSession(string sessionId)
    {
        if (!Catalog.TryGet(SessionsSurfaceRegistration.SurfaceId, out _))
        {
            _toasts?.Publish(ToastMessage.Warning(
                "The sessions list is switched off, so this session cannot be opened here.",
                SessionsOffTestId));
            return;
        }

        Navigator.Show(
            SessionsSurfaceRegistration.SurfaceId,
            new Dictionary<string, string>(StringComparer.Ordinal) { [SessionsSurfaceRegistration.SessionKey] = sessionId });
    }
}
