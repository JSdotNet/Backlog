@* Deliberately free of the app's own domain namespaces. Each context now lives
   in its own module UI project with its own _Imports.razor, so a component can
   only reach into another context by saying so in writing — the Shell folder's
   _Imports.razor is the one place that does. What is left here is what the
   shell itself renders; the lines the moved contexts needed went with them. *@
@using System.Net.Http
@using System.IO
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.JSInterop
@using Backlog.Infrastructure.AzureFoundry
@using Backlog.Infrastructure.GitHub
@using Backlog.UI.Components.Feedback
@using Backlog.UI.Components.Buttons
@using Backlog.UI.Components.Inputs
@using Backlog.UI.Components.Layout
@using Backlog.UI.Components.Overlays
@inherits LayoutComponentBase
