@implements IDisposable
@inject IJSRuntime JS
@inject FeedbackReporter Feedback
@inject IAppFeatureSettings Features
@inject FeedbackReportChannel Reports

@*
    The "Report issue" trigger and its dialog, self-contained so the trigger and
    the state machine underneath it travel together rather than each page growing
    its own copy.

    It is mounted in exactly one place: AppFooter, which MainLayout renders below
    the routed body. Both routes used to mount it themselves, which was the only
    arrangement available while the layout was a bare `@Body` — and it meant
    adding a route meant remembering to add this tag. Now a third route gets the
    button by existing, and nothing about reporting an issue is a page's business
    any more.

    So the shape it wears is `.header-util`, which is the utility-button shape
    rather than a header-only class, and it is unchanged by the move.
*@

@if (IsFeatureEnabled(AppFeatures.FeedbackReporting))
{
    <AppButton BaseClass="header-util"
               Variant="ButtonVariant.None"
               id="feedback-button"
               TestId="feedback-button"
               aria-haspopup="dialog"
               OnClick="OpenFeedbackDialog">
        Report issue
        <FeatureStatusBadge Status="@FeatureStatusSlug(AppFeatures.FeedbackReporting)"
                             Title="@FeatureStatusTitle(AppFeatures.FeedbackReporting)"
                             TestId="feedback-feature-status" />
    </AppButton>

    <Modal Open="_feedbackOpen"
           OpenChanged="value => { if (!value) CloseFeedbackDialog(); }"
           Element="section"
           BaseClass="feedback-dialog"
           BackdropCssClass="feedback-backdrop"
           BackdropRole="presentation"
           UseBodyWrapper="false"
           CloseOnBackdropClick="false"
           CloseOnEscape="@(!_feedbackSubmitting)"
           TestId="feedback-dialog"
           FooterCssClass="feedback-dialog__actions"
           aria-labelledby="feedback-title"
           aria-describedby="feedback-description">
        <Header>
            @* The library's section header, dressed as this dialog — the same
               arrangement the update dialog uses, so the two keep one shape. *@
            <SectionHeader BaseClass="feedback-dialog__header"
                           TextCssClass=""
                           EyebrowCssClass="feedback-dialog__eyebrow"
                           TitleCssClass=""
                           ActionsCssClass=""
                           Eyebrow="GitHub feedback"
                           TitleId="feedback-title"
                           Title="Report an issue">
                <Actions>
                    <IconButton AriaLabel="Close feedback dialog" CssClass="btn--ghost" Disabled="@_feedbackSubmitting" OnClick="CloseFeedbackDialog">x</IconButton>
                </Actions>
            </SectionHeader>
        </Header>
        <ChildContent>
            <p id="feedback-description" class="feedback-dialog__description">Send a Desktop app issue to JSdotNet/Backlog. Attach a screenshot if it helps show what's wrong.</p>

            <TextField Label="Title"
                       Id="feedback-title-input"
                       data-testid="feedback-title-input"
                       Value="@_feedbackTitle"
                       ValueChanged="OnFeedbackTitleInput"
                       maxlength="120"
                       Disabled="@_feedbackSubmitting" />

            <TextArea Label="Details"
                      Id="feedback-details-input"
                      data-testid="feedback-details-input"
                      Value="@_feedbackDetails"
                      ValueChanged="OnFeedbackDetailsInput"
                      Rows="6"
                      Disabled="@_feedbackSubmitting" />

            <div class="feedback-dialog__screenshot">
                @if (_feedbackScreenshot is not null)
                {
                    @* "Attached" rather than "Captured": the same preview holds a
                       pasted image as well as a captured one. *@
                    <img class="feedback-dialog__screenshot-preview"
                         data-testid="feedback-screenshot-preview"
                         src="@_feedbackScreenshot.DataUrl"
                         alt="Attached screenshot preview" />
                    <div class="feedback-dialog__screenshot-actions">
                        <AppButton Variant="ButtonVariant.Secondary" data-testid="feedback-screenshot-retake" Disabled="@ScreenshotBusy" OnClick="CaptureScreenshotAsync">
                            @(_feedbackCapturing ? "Capturing..." : "Retake screenshot")
                        </AppButton>
                        <AppButton Variant="ButtonVariant.Secondary" data-testid="feedback-screenshot-paste" Disabled="@ScreenshotBusy" OnClick="PasteScreenshotAsync">
                            @(_feedbackPasting ? "Pasting..." : "Paste image")
                        </AppButton>
                        <AppButton Variant="ButtonVariant.Ghost" data-testid="feedback-screenshot-remove" Disabled="@ScreenshotBusy" OnClick="RemoveScreenshot">
                            Remove
                        </AppButton>
                    </div>
                }
                else
                {
                    @* Both origins side by side rather than one under the other:
                       capturing and pasting are the same offer, and a reader who
                       has already copied the picture should not have to read past
                       the capture to find that out. *@
                    <div class="feedback-dialog__screenshot-actions">
                        <AppButton Variant="ButtonVariant.Secondary" data-testid="feedback-screenshot-attach" Disabled="@ScreenshotBusy" OnClick="CaptureScreenshotAsync">
                            @(_feedbackCapturing ? "Capturing..." : "Attach screenshot")
                        </AppButton>
                        <AppButton Variant="ButtonVariant.Secondary" data-testid="feedback-screenshot-paste" Disabled="@ScreenshotBusy" OnClick="PasteScreenshotAsync">
                            @(_feedbackPasting ? "Pasting..." : "Paste image")
                        </AppButton>
                    </div>
                }
            </div>

            @* The link goes inside the status line rather than beside it: the
               line is the live region, and a way back to the issue announced
               separately from the sentence saying it exists is either read
               twice or not at all. The library ships no link component — see the
               `md-link` entry in SharedControlAdoptionTests — so the anchor is
               written here, in Alert's own slot. *@
            <Alert Message="@_feedbackMessage" BaseClass="@FeedbackStatusClass" Role="@FeedbackStatusRole">
                @if (_feedbackIssueLink is { } issue)
                {
                    @* The gap is written here rather than left to CSS: the line is
                       read out and copied as text, and a margin is neither. *@
                    <text>&nbsp;</text>
                    <a class="feedback-status__link"
                       data-testid="feedback-issue-link"
                       href="@issue.Url"
                       target="_blank"
                       rel="noopener"
                       aria-label="@($"Open issue {issue.RepoFullName}{issue.Label} on GitHub")">@($"{issue.RepoFullName}{issue.Label}")</a>
                }
            </Alert>
        </ChildContent>
        <Footer>
            <AppButton Variant="ButtonVariant.Ghost" Disabled="@_feedbackSubmitting" OnClick="CloseFeedbackDialog">Cancel</AppButton>
            <AppButton Variant="ButtonVariant.Primary" data-testid="feedback-submit" Disabled="@(_feedbackSubmitting || string.IsNullOrWhiteSpace(_feedbackTitle))" OnClick="SubmitFeedbackAsync">
                @(_feedbackSubmitting ? "Sending..." : "Create GitHub issue")
            </AppButton>
        </Footer>
    </Modal>
}

@code {
    private bool _feedbackOpen;
    private bool _feedbackSubmitting;
    private bool _feedbackCapturing;
    private bool _feedbackPasting;
    private FeedbackTone _feedbackTone;
    private string _feedbackTitle = string.Empty;
    private string _feedbackDetails = string.Empty;
    private string? _feedbackMessage;
    private GitHubFeedbackScreenshot? _feedbackScreenshot;
    private string? _feedbackScreenshotError;
    private GitHubIssueLink? _feedbackIssueLink;

    protected override void OnInitialized()
    {
        Features.Changed += HandleFeaturesChanged;
        Reports.Requested += HandleReportRequested;
    }

    public void Dispose()
    {
        Features.Changed -= HandleFeaturesChanged;
        Reports.Requested -= HandleReportRequested;
    }

    private void HandleFeaturesChanged() => _ = InvokeAsync(StateHasChanged);

    private bool IsFeatureEnabled(string featureKey) => Features.IsEnabled(featureKey);

    private string FeatureStatusSlug(string featureKey) =>
        AppFeatureStatusBadge.SlugFor(AppFeatures.All, Features, featureKey);

    private string? FeatureStatusTitle(string featureKey) =>
        AppFeatureStatusBadge.TitleFor(AppFeatures.All, Features, featureKey);

    /// <summary>
    /// How the status line announces itself. Three tones rather than the
    /// succeeded/failed pair this started as, because a clipboard holding text
    /// is neither: it is the normal state of a clipboard, and the live-region
    /// table in <c>.devbook/design/accessibility.md</c> keeps <c>role="alert"</c> and the
    /// error surface for Conflict and Error. An answer that interrupts to say
    /// nothing is wrong spends both.
    /// </summary>
    private enum FeedbackTone
    {
        // The default, and what a cleared line falls back to — nothing is drawn
        // without a message, and every message set without saying otherwise is a
        // failure: a missing title, a refused capture, GitHub turning the report
        // away.
        Error,
        Info,
        Ok
    }

    private string FeedbackStatusClass => $"feedback-status {_feedbackTone switch
    {
        FeedbackTone.Ok => "feedback-status--ok",
        FeedbackTone.Info => "feedback-status--info",
        _ => "feedback-status--error"
    }}";

    private string FeedbackStatusRole => _feedbackTone == FeedbackTone.Error ? "alert" : "status";

    /// <summary>Whether an image is on its way in. One flag for both origins,
    /// because they end in the same attachment: reading the clipboard while a
    /// capture is still resolving would decide which of the two won by whichever
    /// finished last.</summary>
    private bool ScreenshotBusy => _feedbackCapturing || _feedbackPasting || _feedbackSubmitting;

    private void OpenFeedbackDialog()
    {
        _feedbackOpen = true;
        _feedbackTone = FeedbackTone.Error;
        _feedbackMessage = null;
        _feedbackIssueLink = null;
    }

    /// <summary>
    /// The dialog opened from somewhere else, with its text already written —
    /// today the app's error screen, handing over the exception it caught.
    /// <para>
    /// The draft replaces whatever was typed rather than appending to it: a
    /// request arrives because something broke just now, and a half-written
    /// report about something else is not what the reader is looking at any
    /// more. A screenshot already attached is kept, on the same reasoning the
    /// paste path uses — it was attached deliberately. Re-entered through
    /// InvokeAsync because the channel raises on the caller's thread and nothing
    /// says that is the renderer's.
    /// </para>
    /// </summary>
    private void HandleReportRequested(FeedbackReportDraft draft) => _ = InvokeAsync(() =>
    {
        if (!IsFeatureEnabled(AppFeatures.FeedbackReporting) || _feedbackSubmitting) return;

        _feedbackTitle = draft.Title;
        _feedbackDetails = draft.Details;
        OpenFeedbackDialog();
        StateHasChanged();
    });

    private void CloseFeedbackDialog()
    {
        if (_feedbackSubmitting) return;

        _feedbackOpen = false;
        _feedbackTone = FeedbackTone.Error;
        _feedbackMessage = null;
        _feedbackIssueLink = null;
    }

    private void OnFeedbackTitleInput(string value)
    {
        _feedbackTitle = value;
        _feedbackTone = FeedbackTone.Error;
        _feedbackMessage = null;
        _feedbackIssueLink = null;
    }

    private void OnFeedbackDetailsInput(string value)
    {
        _feedbackDetails = value;
        _feedbackTone = FeedbackTone.Error;
        _feedbackMessage = null;
        _feedbackIssueLink = null;
    }

    private async Task CaptureScreenshotAsync()
    {
        if (_feedbackCapturing) return;

        _feedbackCapturing = true;
        _feedbackScreenshotError = null;
        _feedbackTone = FeedbackTone.Error;
        _feedbackMessage = null;
        _feedbackIssueLink = null;

        try
        {
            var screenshot = await JS.InvokeAsync<GitHubFeedbackScreenshot?>("backlogCaptureScreenshot");
            if (screenshot is null)
            {
                _feedbackScreenshotError = "No screenshot was captured.";
                _feedbackMessage = _feedbackScreenshotError;
            }
            else
            {
                _feedbackScreenshot = screenshot;
            }
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            // Named here rather than in the reporter: the reporter is handed a
            // failure and cannot tell which of the two origins produced it, and
            // whoever reads the filed issue was not at the machine.
            _feedbackScreenshotError = $"Screenshot capture failed: {ex.Message}";
            _feedbackMessage = _feedbackScreenshotError;
        }
        finally
        {
            _feedbackCapturing = false;
        }
    }

    /// <summary>
    /// The clipboard's image, attached exactly as a capture is.
    /// <para>
    /// The one place it differs is the empty answer. A capture that produced
    /// nothing failed; a clipboard holding text or nothing at all is the normal
    /// state of a clipboard, so it is reported and nothing else changes — in
    /// particular the attachment already made stays made, because clearing it
    /// would lose a screenshot the reporter took deliberately over one wrong
    /// click.
    /// </para>
    /// </summary>
    private async Task PasteScreenshotAsync()
    {
        if (_feedbackPasting) return;

        _feedbackPasting = true;
        _feedbackScreenshotError = null;
        _feedbackTone = FeedbackTone.Error;
        _feedbackMessage = null;
        _feedbackIssueLink = null;

        try
        {
            var screenshot = await JS.InvokeAsync<GitHubFeedbackScreenshot?>("backlogReadClipboardImage");
            if (screenshot is null)
            {
                _feedbackTone = FeedbackTone.Info;
                _feedbackMessage = "The clipboard doesn't hold an image. Copy one, or attach a screenshot instead.";
            }
            else
            {
                _feedbackScreenshot = screenshot;
            }
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            // The clipboard, said so — the reporter cannot tell the two origins
            // apart, and a refusal filed as a capture failure sends whoever reads
            // the issue looking for a display picker nobody ever opened.
            _feedbackScreenshotError = $"Reading the clipboard failed: {ex.Message}";
            _feedbackMessage = _feedbackScreenshotError;
        }
        finally
        {
            _feedbackPasting = false;
        }
    }

    // The link is cleared wherever the message is, here included: it is the tail
    // of one line, so it lives exactly as long as the sentence it followed.
    private void RemoveScreenshot()
    {
        _feedbackScreenshot = null;
        _feedbackScreenshotError = null;
        _feedbackMessage = null;
        _feedbackIssueLink = null;
    }

    private async Task SubmitFeedbackAsync()
    {
        if (string.IsNullOrWhiteSpace(_feedbackTitle))
        {
            _feedbackTone = FeedbackTone.Error;
            _feedbackMessage = "Add a short title before creating the issue.";
            _feedbackIssueLink = null;
            return;
        }

        _feedbackSubmitting = true;
        _feedbackTone = FeedbackTone.Error;
        _feedbackMessage = _feedbackScreenshot is null ? "Creating the GitHub issue..." : "Uploading the screenshot...";
        _feedbackIssueLink = null;

        try
        {
            var link = await Feedback.ReportAsync(_feedbackTitle, _feedbackDetails, _feedbackScreenshot, _feedbackScreenshotError);
            _feedbackTone = FeedbackTone.Ok;
            // The repository and the number are the link's own text, so the
            // sentence stops before them rather than printing them twice.
            _feedbackMessage = "Created";
            _feedbackIssueLink = link;
            _feedbackTitle = string.Empty;
            _feedbackDetails = string.Empty;
            _feedbackScreenshot = null;
            _feedbackScreenshotError = null;
        }
        catch (GitHubException ex)
        {
            _feedbackTone = FeedbackTone.Error;
            _feedbackMessage = ex.Message;
        }
        finally
        {
            _feedbackSubmitting = false;
        }
    }
}
