    /// its <c>owner/name#number</c> key, until the reader leaves the list.</summary>
    private string? _focusPullRequest;

    /// <summary>
    /// A pull request a card on the In progress view or a task's side panel names,
    /// opened from the card: the pull requests list on screen with its row marked.
    /// The mirror of <see cref="OpenSessionAsync"/>, on the same terms.
    /// </summary>
