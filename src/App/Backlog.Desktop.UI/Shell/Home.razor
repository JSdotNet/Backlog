    {
        if (State.Rows.FirstOrDefault(candidate => candidate.Id == id) is not { } row) return;

        ShowView(ShellView.Tasks);

        // In progress shows entries the list's own filters may hide; the list is
        // widened to it, as a press on the row would be.
