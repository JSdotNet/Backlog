    private void HandleStateChanged() => _ = InvokeAsync(() =>
    {
        // A row's links, status or assignee can change in place, which the list's
        // identity would not show, so any change rebuilds the pull request matcher.
        _pullRequestMatcher = null;
        SynchronizePaneAvailability();
        StateHasChanged();
    });

    private void HandleFeaturesChanged() => _ = InvokeAsync(() =>
    {
        SynchronizePaneAvailability();

        // Switched on after the list loaded: check now rather than at a reload
        // that may not come. Only on the switch, so another flag moving does not
        // set off a check of its own.
        var gitHubOn = IsFeatureEnabled(TasksFeatures.GitHubIntegration);
        if (gitHubOn && !_gitHubIntegrationWasOn) CheckPullRequestsAfterLoad();
        _gitHubIntegrationWasOn = gitHubOn;

        StateHasChanged();
    });

    /// <summary>Whether the GitHub integration was on when the feature switches
    /// were last looked at. See <see cref="HandleFeaturesChanged"/>.</summary>
    private bool _gitHubIntegrationWasOn;

    /// <summary>Whether the Inbox has been told to load. Once per page: the
    /// state itself outlives the page and keeps what it loaded, so a second
    /// Home — Settings and back — asks again and gets a fresh read, which is
    /// the cheap and correct answer for a store another device may have
    /// written to meanwhile.</summary>
    private bool _inboxInitialized;

    /// <summary>Whether the Inbox pane was on screen at the last render, so a
    /// closed-then-opened pane is noticed as an opening.</summary>
    private bool _inboxWasVisible;

    /// <summary>The replication loop, or null in a host that composes none. The
    /// Inbox listens to it here rather than itself because the Inbox's UI may
    /// not see the sync adapter — the shell may, and forwarding one event is
    /// the whole of what it does with it.</summary>
    private TaskSyncWorker? _taskSync;

    /// <summary>This window's registration with <see cref="SessionsSurfaceActivator"/>,
    /// held only so it can be given up. Null where the host composed no activator.</summary>
    private IDisposable? _surfaceAttachment;

    private TaskSyncWorker? ResolveTaskSync()
    {
        try
        {
            return Services.GetService<TaskSyncWorker>();
        }
        catch (InvalidOperationException)
        {
            // Registered but not constructible here — the same case Settings
            // reads as "this host does not replicate".
            return null;
        }
    }

    /// <summary>A pull may have delivered a capture or another device's edits.
    /// Reloading either pane is a database read, so the Inbox is re-read only
    /// once it has loaded at all — before that the first load will read
    /// whatever arrived — and the Tasks pane only when a cycle actually
    /// applied something it had not applied before. The worker raises this at
    /// both ends of a cycle and for cycles that changed nothing, and a list
    /// that started over on every one of those would replace its rows every
    /// five minutes for no reader's benefit.
    /// <para>
    /// The Tasks reload is what the timestamp poll used to do — a pull writes
    /// the same database the poll watched — and the state keeps that poll's
    /// guard: a reload that arrives under a live caret is owed rather than
    /// dropped, and lands when the caret goes.
    /// </para>
    /// <para>
    /// The task is not awaited — the event is synchronous and the renderer's
    /// dispatcher owns the continuation — so a failure inside it has nowhere
    /// to go but the toast. The catch is on this side of <c>InvokeAsync</c> so
    /// an unobserved exception cannot take the circuit down for a read the
    /// reader never asked for.
    /// </para></summary>
    private void HandleTaskSyncChanged() => _ = InvokeAsync(async () =>
    {
        if (_taskSync is { IsSyncing: false, LastSummary: { Applied: > 0 } summary } && summary.At != _lastAppliedSyncAt)
        {
            _lastAppliedSyncAt = summary.At;

            try
            {
                await State.ReloadFromStoreAsync();
                CheckPullRequestsAfterLoad();
            }
            catch (Exception ex)
            {
                Toasts.Publish(ToastMessage.Error($"The backlog could not be refreshed after a sync: {ex.Message}", TasksReloadErrorTestId));
            }
        }

        if (!_inboxInitialized) return;

        try
        {
            await InboxState.ReloadAsync();
        }
        catch (Exception ex)
        {
            Toasts.Publish(ToastMessage.Error($"The Inbox could not be refreshed after a sync: {ex.Message}", InboxReloadErrorTestId));
        }
    });

    /// <summary>The cycle whose applied changes the Tasks pane last reloaded
    /// for, so the raise at the end of that same cycle — and every raise for
    /// a cycle that applied nothing since — reloads it no second time.</summary>
    private DateTimeOffset? _lastAppliedSyncAt;

    /// <summary>
    /// A task was written somewhere other than the Tasks pane — most often the
    /// MCP server an agent drives while the person watches the list — so the
    /// pane reloads from the store.
    /// <para>
    /// On the renderer's dispatcher, because the state raises this on the
    /// writer's thread and a reload replaces the rows the renderer reads. And
    /// coalesced, because an agent's burst — an import, a run of transitions — is
    /// one signal per write: a signal that lands while a reload is running marks
    /// one more as owed instead of starting a second over the first, so at most one
    /// reload is in flight and the last write is always read. The reload keeps its
    /// own guard and waits out an open editor; see
    /// <c>TasksDesktopState.ReloadFromStoreAsync</c>.
    /// </para></summary>
    private void HandleTasksWrittenElsewhere() => _ = InvokeAsync(async () =>
    {
        _tasksReloadOwed = true;
        if (_tasksReloadRunning) return;

        _tasksReloadRunning = true;

        try
        {
            while (_tasksReloadOwed)
            {
                _tasksReloadOwed = false;
                await State.ReloadFromStoreAsync();
                CheckPullRequestsAfterLoad();
            }
        }
        catch (Exception ex)
        {
            _tasksReloadOwed = false;
            Toasts.Publish(ToastMessage.Error($"The backlog could not be refreshed after a change made outside it: {ex.Message}", TasksReloadErrorTestId));
        }
        finally
        {
            _tasksReloadRunning = false;
        }
    });

    /// <summary>Whether <see cref="HandleTasksWrittenElsewhere"/> has a reload
    /// running, and whether another is owed behind it. Only touched on the
    /// renderer's dispatcher.</summary>
    private bool _tasksReloadRunning;

    private bool _tasksReloadOwed;

    /// <summary>Where the two discarded reloads report a failure, for a test
    /// to find and a reader to read.</summary>
    private const string InboxReloadErrorTestId = "inbox-reload-error";
    private const string TasksReloadErrorTestId = "tasks-reload-error";

    /// <summary>Whether a capture run is in flight, and what the last one said.
    /// Held here rather than in the pane for the reason the Inbox's own view
    /// state lives in <see cref="InboxDesktopState"/>: the pane re-mounts when
    /// it changes slot, and a run's result dropping at that moment would leave
    /// the reader with a button that did nothing. The Inbox's Add is not
    /// answered here at all — the pane files it through its own module.</summary>
    private bool _captureRunning;
    private string? _captureMessage;

    /// <summary>
    /// The Inbox pane as this shell composes it, once, for both slots it can
    /// sit in: the Capture button answered by <see cref="RunCaptureAsync"/>,
    /// and the Capture context's own sources panel in the pane's sources slot,
    /// which the pane shows as its Sources tab. The pane draws that slot
    /// without naming what is in it, so the Inbox stays free of Capture's
    /// types while its button and its switches sit together on one pane.
    /// </summary>
    private RenderFragment InboxPaneContent =>
        @<InboxPane OnCapture="RunCaptureAsync" CaptureRunning="_captureRunning" CaptureMessage="@_captureMessage">
            <Sources>
                <CaptureSourcesPanel OnImported="ImportedAsync" />
            </Sources>
        </InboxPane>;

    /// <summary>
    /// The Inbox's Capture, answered: one run over the sources switched on in
    /// Settings, reported back as a sentence the pane can print — and, when the
    /// run delivered anything, the Inbox re-read so the new rows are on screen
    /// without a restart, the way a sync pull re-reads it.
    /// <para>
    /// The runner never throws for a source — each answers for itself in the
    /// result — so a throw here is the run itself failing to start, and that is
    /// reported in the same line rather than left to the console. The re-read
    /// is kept out of that try: its failure is the Inbox's to report, not the
    /// run's, and the run's own line stands.
    /// </para>
    /// </summary>
    private async Task RunCaptureAsync()
    {
        if (_captureRunning) return;

        _captureRunning = true;
        _captureMessage = null;
        CaptureRunResultDto? run = null;

        try
        {
            run = await CaptureRunner.RunAsync();
            _captureMessage = Describe(run);
        }
        catch (Exception ex)
        {
            _captureMessage = $"Capture could not run: {ex.Message}";
        }
        finally
        {
            _captureRunning = false;
        }

        if (run is { TotalNewItems: > 0 }) await ReloadInboxAfterCaptureAsync();
    }

    /// <summary>The sources panel's Import file…, answered the way the Capture
    /// button's run is: when it delivered anything, the Inbox is re-read so the
    /// imported rows are on screen. The panel prints the import's own line.</summary>
    private async Task ImportedAsync(CaptureRunResultDto run)
    {
        if (run.TotalNewItems > 0) await ReloadInboxAfterCaptureAsync();
    }

    /// <summary>The same read <see cref="HandleTaskSyncChanged"/> does after a
    /// pull, for the same reason and with the same guard: before the pane has
    /// loaded at all, the first load will read whatever the run delivered.</summary>
    private async Task ReloadInboxAfterCaptureAsync()
    {
        if (!_inboxInitialized) return;

        try
        {
            await InboxState.ReloadAsync();
        }
        catch (Exception ex)
        {
            Toasts.Publish(ToastMessage.Error($"The Inbox could not be refreshed after a capture: {ex.Message}", InboxReloadErrorTestId));
        }
    }

    /// <summary>A run's result in one line. Nothing enabled points at the
    /// tab that would change that — it is on the same pane, beside the queue;
    /// otherwise each source's own sentence — which already carries that
    /// source's count — and, when there was more than one source, the total,
    /// so a reader is not left adding up.</summary>
    private static string Describe(CaptureRunResultDto run)
    {
        if (run.NothingEnabled)
        {
            return "No capture sources are enabled. Open the Sources tab and switch one on.";
        }

        var sources = string.Join(" ", run.Sources.Select(source => source.Message));

        if (run.Sources.Count == 1) return sources;

        var total = run.TotalNewItems == 1 ? "1 new item in all." : $"{run.TotalNewItems} new items in all.";

        return $"{sources} {total}";
    }

    private void SynchronizePaneAvailability()
    {
        _globalPanes.TrySetAvailable(GlobalPane.Inbox, InboxPaneOptionVisible);
        _globalPanes.TrySetAvailable(GlobalPane.Devbook, DevbookPaneOptionVisible);
        PersistPaneSelection();
    }

    /// <summary>Remembers which side panes are open, so the next fresh shell
    /// instance — a relaunch, or the Router rebuilding this component after a
    /// trip to Settings — reopens with them beside its view.</summary>
    private void PersistPaneSelection()
    {
        KeepRepositoryScopeSingleWhereOnlyOneFits();

        var enabled = _globalPanes.Enabled.Select(pane => pane.ToString()).ToArray();
        ShellNavigation.SetLastPanes(enabled);
    }

    /// <summary>
    /// The scope holds several repositories only while something on screen can show
    /// several — see <see cref="RepositoryScopeTakesSeveral"/>.
    /// <para>
    /// Several at once is a list affordance: the backlog list and the dashboard can
    /// show more than one repository, and the Devbook pane reads exactly one. So
    /// when the list goes — closed by the reader, trimmed by a window that no longer
    /// fits it, or left behind for a surface that reads one — the scope drops back
    /// to the anchor, and what the Devbook pane was reading is what it keeps
    /// reading. Called from every path that changes what is on screen: the pane
    /// toggles and the restore go through <see cref="PersistPaneSelection"/>, the
    /// surface switches call it themselves, and so does the capacity trim, because
    /// a trim is deliberately not persisted.
    /// </para>
    /// </summary>
    private void KeepRepositoryScopeSingleWhereOnlyOneFits()
    {
        if (!RepositoryScopeTakesSeveral) State.NarrowRepositoryScopeToAnchor();
    }

    /// <summary>Whether a side pane's toggle reads pressed: its pane is open and on
    /// screen. During a takeover no pane is on screen, so none reads pressed — the
    /// selection is kept underneath, and shows again on the way back.</summary>
    private bool PaneOptionPressed(GlobalPane pane) => WorkspaceVisible && _globalPanes.IsEnabled(pane);

    /// <summary>
    /// A press on a side pane's toggle: the pane opens beside the main view, or
    /// closes. Closing is always allowed — the view stays on screen — and opening
    /// into a window with no room for one more closes the first open side pane.
    /// <para>
    /// During a takeover the press is first the way back: it closes the takeover,
    /// as <see cref="CloseSurface"/> does for Escape. A pane already open is then
    /// simply shown again with the workspace as it was — closing it would answer
    /// "show me the Inbox" by hiding the Inbox.
    /// </para>
    /// </summary>
    private void PressPane(GlobalPane pane)
    {
        if (!WorkspaceVisible)
        {
            CloseSurface();
            _globalPanes.TryOpen(pane);
        }
        else
        {
            _globalPanes.Toggle(pane);
        }

        // A press that left the pane open opened it, and that is the area the
        // reader wants to ask about next.
        if (_globalPanes.IsEnabled(pane)) RememberAiScope(AiScopeFor(pane));

        PersistPaneSelection();
    }

    /// <summary>What the press will do, named beside the view it acts on.</summary>
    private string PaneOptionTitle(GlobalPane pane, string name)
    {
        if (!WorkspaceVisible) return $"Back to the workspace with {name} open";

        return _globalPanes.IsEnabled(pane)
            ? $"Close {name}"
            : $"Open {name} beside {EffectiveView}";
    }

    /// <summary>Triage: the Inbox turned an item into backlog entries, and the
    /// shell shows them where work actually happens.
    /// <para>
    /// The Tasks view, with the Inbox kept open beside it: the entries are on the
    /// list, and closing the Inbox they just routed the item from would take away
    /// the queue they were working through. Routed from beside the Roadmap view, the
    /// view switches to Tasks, since the new entries are not on the roadmap yet.
    /// </para>
    /// <para>
    /// The Tasks pane is reloaded from the store rather than told what changed.
    /// The Inbox's module wrote the entries through a port an adapter answers,
    /// so as far as the Tasks state is concerned somebody else wrote its
    /// database — which is exactly the case its store reload already handles.
    /// The shell knows both panes exist and nothing about what either holds.
    /// </para></summary>
    private void HandleInboxRouted(InboxRoutedDto routed) => RefreshTasksAfterRouting();

    /// <summary>The same, once for a whole batch: one import made every entry,
    /// so one reload shows them all.</summary>
    private void HandleInboxBatchRouted(InboxBatchRoutedDto batch) => RefreshTasksAfterRouting();

    private void RefreshTasksAfterRouting() => _ = InvokeAsync(async () =>
    {
        // The entries are on the task list, so that is the view the workspace
        // shows, unless the Board or the Calendar is already laying the same
        // rows out; the Inbox stays open beside it.
        if (EffectiveView is not (ShellView.Tasks or ShellView.Board or ShellView.Calendar)) SetView(ShellView.Tasks);

        try
        {
            await State.ReloadFromStoreAsync();
            CheckPullRequestsAfterLoad();
        }
        catch (Exception ex)
        {
            // The entries were made — the Inbox said so — and only the pane
            // beside it failed to show them. Said on a toast, for the reason
            // HandleTaskSyncChanged gives: nothing awaits this.
            Toasts.Publish(ToastMessage.Error($"The backlog could not be refreshed after routing: {ex.Message}", TasksReloadErrorTestId));
        }

        StateHasChanged();
    });

    /// <summary>
    /// The repository's identity mark, as classes.
    /// <para>
    /// Which hue is the settings store's answer and not this screen's — every surface
    /// asks the same place, which is what stops the same project being two colours.
    /// The mark is additive: the chip keeps the surface, border and text it already
    /// had, and gains a rule down its leading edge. See
    /// <c>.devbook/design/color-scheme.md#band-identity-tokens</c>.
    /// </para>
    /// </summary>
    private string? RepositoryMarkClass(string alias) =>
        State.RepositoryColours.TryGetValue(alias, out var colour) ? $"repo-mark repo-mark--{colour}" : null;

    /// <summary>
    /// The hue for a repository named the way a session names one — <c>owner/name</c>,
    /// or nothing at all. Null for a session whose repository is not configured here,
    /// which is the ordinary case for work done in a clone this workspace does not
    /// know about.
    /// </summary>
    private int? RepositoryColourFor(string? repository) => State.RepositoryColourFor(repository);

    /// <summary>
    /// The alias a session's recorded repository goes by here — the sessions list
    /// matches the header's scope through this, and the scope is aliases. Null for a
    /// repository this workspace has not configured, and for a session that recorded
    /// none; the pane treats both as out of any scope.
    /// </summary>
    private string? RepositoryAliasFor(string? repository) => State.RepositoryAliasFor(repository);

    /// <summary>
    /// Shows or hides the repository identity hues across every surface.
    /// <para>
    /// The state class writes it, because the settings store is where the hue itself is
    /// answered and this is the same fact seen from the other side. The store's message
    /// on a failed write is dropped rather than shown: the choice has taken effect for
    /// this session either way, and the header has no room for a line of prose that
    /// would outlive the gesture it belongs to. Settings is where a settings file that
    /// cannot be written gets reported.
    /// </para>
    /// </summary>
    private void ShowRepositoryColours(bool visible) => _ = State.SetRepositoryColoursVisible(visible);

    /// <summary>
    /// A press on a scope chip.
    /// <para>
    /// The repository scope is global: it narrows the backlog list and, through the
    /// anchor handed to the pane, what knowledge is read beside it. A plain press is
    /// the single select the strip always had — this repository, or none when it was
    /// already alone in the scope. With Ctrl held (Cmd on a Mac) the press adds the
    /// repository beside the ones already scoped, or takes it back out: the
    /// convention every file manager has, so it needs no teaching beyond the tooltip.
    /// A plain press on a chip inside a wider scope narrows to that one, for the
    /// same reason — that is what a plain click on one of several selected files does.
    /// </para>
    /// <para>
    /// The modifier counts only while what is on screen can show several — the task
    /// list, the Dashboard, or the session list; see <see cref="RepositoryScopeTakesSeveral"/>. Without
    /// one of those there is nothing a second repository could be shown in, so the
    /// press is an ordinary one.
    /// </para>
    /// </summary>
    private void ScopeRepository(string repositoryAlias, MouseEventArgs args)
    {
        if ((args.CtrlKey || args.MetaKey) && RepositoryScopeTakesSeveral)
        {
            State.ToggleRepositoryInScope(repositoryAlias);
            return;
        }

        var alone = State.SelectedRepositoryAliases is [var only]
            && string.Equals(only, repositoryAlias, StringComparison.Ordinal);
        State.SetRepositoryFilter(alone ? string.Empty : repositoryAlias);
    }

    /// <summary>The identity mark, plus the anchor's own class while there is a
    /// second chip for it to be distinct from.</summary>
    private string? RepositoryScopeChipClass(string alias, bool anchor)
    {
        var mark = RepositoryMarkClass(alias);
        if (!anchor) return mark;

        return mark is null ? "chip--anchor" : mark + " chip--anchor";
    }

    /// <summary>What the chip does next, since the modifier is the one thing about
    /// the strip nothing on screen shows.</summary>
    private string RepositoryScopeChipTitle(GitHubRepositoryRef repository, bool selected, bool anchor)
    {
        // Nothing to show several in, no modifier to name: the chip says what a
        // single select says.
        if (!RepositoryScopeTakesSeveral) return selected ? $"Deselect {repository.FullName}" : repository.FullName;

        if (!selected) return $"{repository.FullName}. Ctrl+click to add it to the scope";
        if (State.SelectedRepositoryAliases.Count == 1) return $"Deselect {repository.FullName}";

        var name = anchor ? $"{repository.FullName} — Devbook follows this one" : repository.FullName;
        return $"{name}. Click to scope to it alone, Ctrl+click to remove it from the scope";
    }

    [JSInvokable]
    public Task SetSidePaneWidthAsync(double widthRem)
    {
        var clamped = SidePaneWidth.Clamp(widthRem, _maxSidePaneWidthRem);
        if (Math.Abs(clamped - _devbookPanelWidthRem) < 0.001) return Task.CompletedTask;

        _devbookPanelWidthRem = clamped;
        StateHasChanged();
        return Task.CompletedTask;
    }

    // How wide the pane may actually get depends on the window, which only the
    // browser knows; without it the separator would keep counting past the edge.
    [JSInvokable]
    public Task SetSidePaneMaxWidthAsync(double maxRem)
    {
        var clamped = SidePaneWidth.Clamp(maxRem, SidePaneWidth.MaxRem);
        var width = Math.Min(_devbookPanelWidthRem, clamped);
        if (Math.Abs(clamped - _maxSidePaneWidthRem) < 0.001 && Math.Abs(width - _devbookPanelWidthRem) < 0.001)
        {
            return Task.CompletedTask;
        }

        _maxSidePaneWidthRem = clamped;
        _devbookPanelWidthRem = width;
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task SetGlobalPaneCapacityAsync(int capacity)
    {
        if (!_globalPanes.TrySetCapacity(capacity))
        {
            return Task.CompletedTask;
        }

        KeepRepositoryScopeSingleWhereOnlyOneFits();
        StateHasChanged();
        return Task.CompletedTask;
    }

    // The drag lives in JavaScript because pointer capture does; the keyboard
    // equivalent stays here so the separator has one clamped source of truth.
    private void OnResizerKeyDown(KeyboardEventArgs e) =>
        _devbookPanelWidthRem = SidePaneWidth.Adjust(_devbookPanelWidthRem, e.Key, _maxSidePaneWidthRem);

    // Asynchronous, because leaving the shell has an interop call to make on the
    // way out. The resizer holds a map of owners and invokes every one of them on
    // each window resize, so a Home that registered and never unregistered is a
    // dead reference the next resize calls into — the page still on screen throws
    // on a window drag because a page that is gone is still in the map.
    public async ValueTask DisposeAsync()
    {
        CancelAsk();
        State.Changed -= HandleStateChanged;
        State.WrittenElsewhere -= HandleTasksWrittenElsewhere;
        InboxState.Changed -= HandleStateChanged;
        InboxState.Routed -= HandleInboxRouted;
        InboxState.BatchRouted -= HandleInboxBatchRouted;
        Features.Changed -= HandleFeaturesChanged;
        if (_taskSync is not null) _taskSync.Changed -= HandleTaskSyncChanged;

        // Detached before anything else of this component goes, for the reason the
        // JS reference below is: the activator holds a delegate over this instance,
        // and a window that stays registered after it is gone is one the next
        // open_dashboard tries to render into.
        _surfaceAttachment?.Dispose();
        _surfaceAttachment = null;

        // Unregistered before the reference is disposed, so the map can never hold
        // one that is already dead. The other order leaves a window between the two
        // in which a resize finds a registration it cannot invoke.
        if (_selfReference is not null)
        {
            try
            {
                // No key, matching the keyless initialize above: the resizer reads
                // an omitted key as the empty slot, which is the app's own layout —
                // it carries no data-pane-owner because it predates the key. A key
                // invented here would delete nothing and leave this owner in place.
                //
                // The empty slot is shared with any future Home, so this would take
                // a newer instance's registration out if disposal of the old one ran
                // after the new one registered. The router disposes the outgoing page
                // before rendering the incoming one, so it does not — stated here so
                // that a change to that ordering is read as breaking this.
                await JS.InvokeVoidAsync("backlogPaneResizer.dispose");
                await JS.InvokeVoidAsync("backlogTakeoverEscape.unregister");
            }
            catch (JSException)
            {
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
                // Disposed from a prerender: the resizer was never initialized,
                // so there is nothing to dispose.
            }
        }

        _selfReference?.Dispose();
        _selfReference = null;
    }
}
