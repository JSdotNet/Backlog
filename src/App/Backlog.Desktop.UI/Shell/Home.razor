@page "/"
@implements IDisposable
@using Backlog.Infrastructure.FileSystem
@inject TasksDesktopState State
@inject IJSRuntime JS
@inject IAppFeatureSettings Features
@inject IAppUpdateService Updates
@inject IAzureFoundryChatClient AzureFoundryChat
@inject KnowledgeScope Knowledge
@inject IServiceProvider Services
@inject ShellNavigationStore ShellNavigation

@*
    The shell. It owns the app chrome — header, update and feedback windows, the
    AI panel — and decides which surface sits below it.

    There are four, and exactly one of them renders: the workspace, which is the
    roadmap band above the global panes; the tools surface; the dashboard; and the
    session list. The last three are takeovers — Dev PC Management, the Dashboard
    and Sessions are whole domains, and opening one means the reader has stopped
    looking at the backlog, so it takes the screen and hides every other domain
    concern rather than docking beside them. Whichever branch renders owns the
    page's single <main> landmark.

    What is inside a surface is not the shell's business: Inbox, Backlog
    Management, Second Brain, Roadmap, Dev PC Management, Sessions and the
    Dashboard each render themselves from their own project, and the only thing
    that crosses between them here is the repository scope handed to the knowledge
    pane and the triaged item handed back from the inbox.
*@

<div class="shell shell--wide">
    @* The header is four regions rather than one row of controls: who you are and
       over which repositories, what you are looking at, how the workspace is
       doing, and the things that cut across all of it.

       They used to be one flat strip of near-identical pills, which made a
       multi-select, an exclusive view switch, a panel disclosure and two modal
       utilities look like the same kind of control. Grouping them is the whole
       change — almost every behaviour below is the behaviour that was already
       here. *@
    <header class="app-header">
        @* Region A. The wordmark is chrome, not a page title, so it sits at
           `font-size-lg` here while the other screens' `.app-header h1` — a real
           page title — keeps the 2xl default. *@
        <div class="app-header__identity">
            <h1>Backlog</h1>

            @if (State.Repositories.Count > 0)
            {
                <div class="app-header__repository-scope" role="group" aria-label="Repository scope">
                    @foreach (var repository in State.Repositories)
                    {
                        var selected = State.SelectedRepositoryAlias == repository.Alias;
                        <ToggleButton BaseClass="chip chip--scope"
                                      CssClass="@RepositoryMarkClass(repository.Alias)"
                                      PressedCssClass="chip--active"
                                      Pressed="selected"
                                      TestId="repository-filter-option"
                                      Title="@(selected ? $"Deselect {repository.FullName}" : repository.FullName)"
                                      PressedChanged="() => ToggleRepositoryScopeAsync(repository.Alias)">
                            @repository.Alias
                        </ToggleButton>
                    }
                </div>

                @* Whether the identity hues are drawn at all — here, beside the chips
                   that wear the most visible ones, rather than buried in Settings with
                   the choice of which hue each repository gets. Those are two different
                   questions asked by two different people at two different moments: one
                   is "this project is green", set once and left alone, and this one is
                   "not right now", which is a decision about the screen in front of you
                   and belongs on it.

                   Outside the scope group on purpose. Inside it this would read as a
                   sixth repository, and it is not a scope — using it narrows nothing.

                   A switch rather than a chip, and the difference is what it is about.
                   Every other control in this strip answers "which of these am I looking
                   at" and holds a selection; this one answers "is this layer on", which
                   is the one question a switch is for. So the shared Toggle in its
                   default shape: role="switch" and aria-checked on a real button, with
                   the name written beside the track instead of on it — which is also why
                   there is no aria-label here. Toggle labels itself from that text
                   through aria-labelledby, and a second accessible name would displace
                   the one the reader can actually see.

                   It renders with the chips or not at all. With nothing configured there
                   is no repository to be an identity for, and a control governing the
                   look of an empty set is a control with nothing to do — the same reason
                   the surface switcher below hides itself when there is only one
                   surface. *@
                <Toggle CssClass="header-switch"
                        LabelCssClass="header-switch__label"
                        ControlCssClass="toggle__track header-switch__track"
                        Label="Repository colours"
                        Id="repository-colours-switch"
                        TestId="repository-colours-toggle"
                        Checked="State.RepositoryColoursVisible"
                        CheckedChanged="ShowRepositoryColours" />
            }
        </div>

        @* Region B — navigation, and nothing else. Two groups, because there are
           two different questions with two different shapes of answer: which
           surface owns the screen (exactly one) and which sections are on it (any
           number). Two shared ButtonGroups make that difference visible; one
           undifferentiated row of pills could not. *@
        <nav class="app-header__nav" aria-label="Workspace views">
            @* One field with four states, in markup that finally says so.
               WorkspaceSurface has always been a single enum precisely because a
               takeover cannot coexist with the workspace or with another
               takeover — but the header rendered independent buttons carrying
               aria-expanded, which described neither the exclusivity nor the fact
               that a takeover replaces the workspace instead of expanding beside
               it. A segmented group of pressed states describes both, and it gives
               the way back a control of its own rather than leaving it to a second
               press or the in-surface close button.

               Ask AI keeps aria-expanded further down, because that one really is
               a disclosure: its panel opens beside the content it belongs to.

               The group renders only when there is a takeover to switch to. With
               every takeover feature off, a lone "Workspace" segment would be a
               control with nothing to choose between. *@
            @if (SurfaceSwitcherVisible)
            {
                <ButtonGroup CssClass="header-group header-group--surface"
                             AriaLabel="Surface"
                             TestId="workspace-surface-switcher">
                    <ToggleButton BaseClass="header-group__option"
                                  PressedCssClass="header-group__option--selected"
                                  Pressed="WorkspaceVisible"
                                  id="workspace-surface-option"
                                  TestId="workspace-surface-option"
                                  aria-controls="workspace"
                                  PressedChanged="CloseSurface">
                        Workspace
                    </ToggleButton>

                    @if (IsFeatureEnabled(DevPcFeatures.SystemTools))
                    {
                        <ToggleButton BaseClass="header-group__option"
                                      PressedCssClass="header-group__option--selected"
                                      Pressed="ToolsVisible"
                                      id="tools-toggle-button"
                                      TestId="tools-toggle-button"
                                      aria-controls="tools-pane"
                                      PressedChanged="ToggleTools">
                            Tools
                            <FeatureStatusBadge Status="@FeatureStatusSlug(DevPcFeatures.SystemTools)"
                                                Title="@FeatureStatusTitle(DevPcFeatures.SystemTools)"
                                                TestId="tools-feature-status" />
                        </ToggleButton>
                    }

                    @if (IsFeatureEnabled(DashboardFeatures.Dashboard))
                    {
                        <ToggleButton BaseClass="header-group__option"
                                      PressedCssClass="header-group__option--selected"
                                      Pressed="DashboardVisible"
                                      id="dashboard-toggle-button"
                                      TestId="dashboard-toggle-button"
                                      aria-controls="dashboard-pane"
                                      PressedChanged="ToggleDashboard">
                            Dashboard
                            <FeatureStatusBadge Status="@FeatureStatusSlug(DashboardFeatures.Dashboard)"
                                                Title="@FeatureStatusTitle(DashboardFeatures.Dashboard)"
                                                TestId="dashboard-feature-status" />
                        </ToggleButton>
                    }

                    @if (IsFeatureEnabled(SessionFeatures.Sessions))
                    {
                        <ToggleButton BaseClass="header-group__option"
                                      PressedCssClass="header-group__option--selected"
                                      Pressed="SessionsVisible"
                                      id="sessions-toggle-button"
                                      TestId="sessions-toggle-button"
                                      aria-controls="sessions-pane"
                                      PressedChanged="ToggleSessions">
                            Sessions
                            <FeatureStatusBadge Status="@FeatureStatusSlug(SessionFeatures.Sessions)"
                                                Title="@FeatureStatusTitle(SessionFeatures.Sessions)"
                                                TestId="sessions-feature-status" />
                        </ToggleButton>
                    }
                </ButtonGroup>
            }

            @* What is on screen below, in one strip. "Sections" rather than "panes"
               because the first option is the roadmap band, and a band is a row above
               the panes rather than one of them.

               That difference is also why it is not a GlobalPane. The selection holds a
               viewport-driven capacity and a "one is always on screen" invariant, both
               of which exist because the three panes compete for the same width; the
               band competes for nothing — it is a horizontal row with its own grid
               track. Folding it in would put it in TrimToCapacity's reach and let a
               narrowed window silently evict the reader's roadmap. So it looks and feels
               like its siblings and keeps its own shell field, the same split that keeps
               WorkspaceSurface out of the selection. It is the one option here with no
               Disabled binding, because it is the one with no capacity rule to block it.

               The strip is the shared ButtonGroup now rather than a hand-rolled div,
               so its role and label come from the component and its test id reaches
               the DOM through TestId. Its options stay aria-pressed toggles:
               several sections are on screen at once, so this is a multi-select and
               not a tab strip. It stays live during a takeover on purpose — the
               pane selection deliberately lives outside WorkspaceSurface so it
               survives a round trip, which means these configure the workspace the
               reader is about to come back to. *@
            <ButtonGroup CssClass="header-group header-group--sections"
                         AriaLabel="Visible sections"
                         TestId="global-pane-multiselect">
                @if (RoadmapPaneOptionVisible)
                {
                    <ToggleButton BaseClass="header-group__option"
                                  PressedCssClass="header-group__option--selected"
                                  Pressed="RoadmapBandVisible"
                                  id="roadmap-pane-option"
                                  TestId="roadmap-pane-option"
                                  aria-controls="roadmap-band"
                                  PressedChanged="ToggleRoadmapBand">
                        Roadmap
                        <FeatureStatusBadge Status="@FeatureStatusSlug(RoadmapFeatures.Roadmap)"
                                            Title="@FeatureStatusTitle(RoadmapFeatures.Roadmap)"
                                            TestId="roadmap-feature-status" />
                    </ToggleButton>
                }

                @* A pane and its pin are one cell: the section, then the act of keeping
                   it. Switching to a section closes the panes the reader did not pin,
                   so the pin is the only way to ask for two at once — which is why it
                   sits on the option rather than somewhere else in the chrome. The
                   band has no pin because it takes no width from the panes and so has
                   nothing to be saved from. *@
                @if (InboxPaneOptionVisible)
                {
                    <span class="header-group__pane">
                        <ToggleButton BaseClass="header-group__option"
                                      PressedCssClass="header-group__option--selected"
                                      Pressed="InboxPaneVisible"
                                      id="inbox-pane-option"
                                      TestId="inbox-pane-option"
                                      aria-controls="inbox-pane"
                                      Disabled="@PaneToggleDisabled(GlobalPane.Inbox)"
                                      PressedChanged="ToggleInboxPane">
                            Inbox
                            <FeatureStatusBadge Status="@FeatureStatusSlug(AppFeatures.InboxPane)"
                                                Title="@FeatureStatusTitle(AppFeatures.InboxPane)"
                                                TestId="inbox-feature-status" />
                        </ToggleButton>

                        <ToggleButton BaseClass="header-group__pin"
                                      PressedCssClass="header-group__pin--pinned"
                                      Pressed="@PanePinned(GlobalPane.Inbox)"
                                      TestId="inbox-pane-pin"
                                      aria-controls="inbox-pane"
                                      Disabled="@PinToggleDisabled(GlobalPane.Inbox)"
                                      AriaLabel="@PinLabel(GlobalPane.Inbox, "Inbox")"
                                      Title="@PinTitle(GlobalPane.Inbox, "Inbox")"
                                      PressedChanged="ToggleInboxPin">
                            📌
                        </ToggleButton>
                    </span>
                }

                <span class="header-group__pane">
                    <ToggleButton BaseClass="header-group__option"
                                  PressedCssClass="header-group__option--selected"
                                  Pressed="TasksPaneVisible"
                                  id="backlog-pane-option"
                                  TestId="backlog-pane-option"
                                  aria-controls="backlog-pane"
                                  Disabled="@PaneToggleDisabled(GlobalPane.Tasks)"
                                  PressedChanged="ToggleTasksPane">
                        Tasks
                    </ToggleButton>

                    <ToggleButton BaseClass="header-group__pin"
                                  PressedCssClass="header-group__pin--pinned"
                                  Pressed="@PanePinned(GlobalPane.Tasks)"
                                  TestId="backlog-pane-pin"
                                  aria-controls="backlog-pane"
                                  Disabled="@PinToggleDisabled(GlobalPane.Tasks)"
                                  AriaLabel="@PinLabel(GlobalPane.Tasks, "Tasks")"
                                  Title="@PinTitle(GlobalPane.Tasks, "Tasks")"
                                  PressedChanged="ToggleTasksPin">
                        📌
                    </ToggleButton>
                </span>

                @if (KnowledgePaneOptionVisible)
                {
                    <span class="header-group__pane">
                        <ToggleButton BaseClass="header-group__option"
                                      PressedCssClass="header-group__option--selected"
                                      Pressed="KnowledgePaneVisible"
                                      id="knowledge-pane-option"
                                      TestId="knowledge-pane-option"
                                      aria-controls="repository-knowledge-pane"
                                      Disabled="@PaneToggleDisabled(GlobalPane.Knowledge)"
                                      PressedChanged="ToggleKnowledgePane">
                            Knowledge
                            <FeatureStatusBadge Status="@FeatureStatusSlug(KnowledgeFeatures.RepositoryKnowledge)"
                                                Title="@FeatureStatusTitle(KnowledgeFeatures.RepositoryKnowledge)"
                                                TestId="knowledge-feature-status" />
                        </ToggleButton>

                        <ToggleButton BaseClass="header-group__pin"
                                      PressedCssClass="header-group__pin--pinned"
                                      Pressed="@PanePinned(GlobalPane.Knowledge)"
                                      TestId="knowledge-pane-pin"
                                      aria-controls="repository-knowledge-pane"
                                      Disabled="@PinToggleDisabled(GlobalPane.Knowledge)"
                                      AriaLabel="@PinLabel(GlobalPane.Knowledge, "Knowledge")"
                                      Title="@PinTitle(GlobalPane.Knowledge, "Knowledge")"
                                      PressedChanged="ToggleKnowledgePin">
                            📌
                        </ToggleButton>
                    </span>
                }
            </ButtonGroup>
        </nav>

        @* Region C — how the workspace is doing. Ambient rather than actionable,
           which is why it is the quietest thing in the row and why it no longer
           sits in the middle of the navigation. The auto margin lives here now, so
           the status and the utilities travel to the right edge together. *@
        <div class="app-header__status">
            @* The library's indicator, not a second copy of it. The hand-rolled block
               that used to sit here emitted the same two elements and the same
               classes, and got aria-live wrong by omission: a live region that never
               announces is the one thing this control exists to do. AppSaveState has
               no Idle, so the mapping below never reaches SaveState.Idle and the
               indicator is never the hidden shape. The wording stays the app's. *@
            <SaveIndicator State="@SaveIndicatorState"
                           SavingText="Saving…"
                           SavedText="Saved"
                           FailedText="Couldn't save"
                           id="save-state-indicator"
                           TestId="save-state-indicator" />

            @* Monitoring is a deliberate act, not a background poll: the backlog has
               to open instantly and offline, so nothing here waits on GitHub until
               somebody asks it to. *@
            @if (IsFeatureEnabled(TasksFeatures.GitHubIntegration) && State.GitHubConfigured && State.HasLinkedRows)
            {
                <IconButton BaseClass="icon-link"
                            id="github-sync-button"
                            TestId="github-sync-button"
                            Disabled="@State.GitHubSyncing"
                            AriaLabel="Check GitHub for issue and pull request updates"
                            OnClick="() => State.SyncGitHubAsync()">
                    @(State.GitHubSyncing ? "…" : "⟳")
                </IconButton>
            }
        </div>

        @* Region D — the cross-cutting concerns, at the far edge and last in
           reading order: not one of them is about the work on screen.

           Ask AI is the one accented control in the whole header. It is a designed
           first-class surface rather than a utility, and holding the accent back to
           a single control is what lets it mean something instead of becoming the
           header's wallpaper — which is what the old all-gold row had made it. *@
        <div class="app-header__utilities">
            @if (IsFeatureEnabled(AppFeatures.AiAssistant))
            {
                @* A disclosure, not a pressed state: this opens a panel beside the
                   content, so it carries aria-expanded and stays AppButton rather
                   than ToggleButton. The surface switcher above is the other case —
                   a selection, not an expansion.

                   The state is written out rather than bound to the bool: Blazor
                   renders a true bool attribute as `aria-expanded=""` and omits it
                   entirely when false, and neither is a value aria-expanded accepts.
                   Now that this is the header's only disclosure, it is the one place
                   that has to say "true" or "false" — which is what the two takeover
                   buttons did before they became a selection. *@
                <AppButton BaseClass="header-accent"
                           Variant="ButtonVariant.None"
                           id="ai-toggle-button"
                           TestId="ai-toggle-button"
                           aria-controls="ai-assistant-panel"
                           aria-expanded="@(_aiExpanded ? "true" : "false")"
                           OnClick="ToggleAiPanel">
                    Ask AI
                    <FeatureStatusBadge Status="@FeatureStatusSlug(AppFeatures.AiAssistant)"
                                        Title="@FeatureStatusTitle(AppFeatures.AiAssistant)"
                                        TestId="ai-feature-status" />
                </AppButton>
            }

            <FeedbackReportButton />

            @* The header keeps the current version visible. Checking and installing
               updates happen in the separate update window opened from this control.
               It sits at the right edge with settings after it, where the other
               things that are not about the work on screen live.

               When the host runs out of a checkout it registers which one, and
               that takes the version's place: several worktrees are run side by
               side and which window belongs to which is the thing you cannot
               tell by looking. The version is still one click away, in the
               update window this control opens. *@
            <AppButton BaseClass="header-util app-version"
                       Variant="ButtonVariant.None"
                       TestId="app-version"
                       title="Open update window"
                       aria-label="@VersionControlLabel"
                       OnClick="OpenUpdateWindow">
                @if (_workspace is null)
                {
                    <text>Version <code>@Updates.CurrentVersion</code></text>
                }
                else
                {
                    <text>Worktree <code data-testid="app-workspace">@_workspace.Marker</code></text>
                }
            </AppButton>

            <a class="icon-link" href="settings" id="settings-link" data-testid="settings-link" title="Settings" aria-label="Settings">⚙</a>
        </div>
    </header>

    @* The update and feedback shells are the shared Modal wearing their own
       classes: same focus, Escape and open/close handling, same DOM. *@
    <Modal Open="_appUpdateWindowOpen"
           OpenChanged="value => { if (!value) CloseUpdateWindow(); }"
           Element="section"
           BaseClass="app-update-dialog"
           BackdropCssClass="app-update-backdrop"
           BackdropRole="presentation"
           UseBodyWrapper="false"
           CloseOnBackdropClick="false"
           CloseOnEscape="@(!_updateBusy)"
           TestId="app-update-dialog"
           aria-labelledby="app-update-title"
           aria-describedby="app-update-description">
        <Header>
            <header class="app-update-dialog__header">
                <div>
                    <p class="app-update-dialog__eyebrow">Application updates</p>
                    <h2 id="app-update-title">Update Backlog</h2>
                </div>
                <IconButton AriaLabel="Close update window" CssClass="btn--ghost" Disabled="@_updateBusy" OnClick="CloseUpdateWindow">x</IconButton>
            </header>
        </Header>
        <ChildContent>
            <p id="app-update-description" class="app-update-dialog__description">
                You are running Version <code>@Updates.CurrentVersion</code>. Check for a newer build here without crowding the header.
            </p>
            <div class="app-update-dialog__actions">
                <AppButton Variant="ButtonVariant.Secondary"
                           data-testid="check-for-updates"
                           Disabled="@_updateBusy"
                           OnClick="CheckForUpdatesAsync">
                    @AppUpdatePresentation.CheckLabel(_checkingForAppUpdate)
                </AppButton>
                @if (_appUpdateReady)
                {
                    <AppButton Variant="ButtonVariant.Primary"
                               data-testid="install-update"
                               Disabled="@_updateBusy"
                               OnClick="InstallUpdateAsync">
                        @(_installingAppUpdate ? "Installing..." : "Install update")
                    </AppButton>
                }
            </div>
            <Alert Message="@_appUpdateMessage" BaseClass="@_appUpdateStatusClass" TestId="app-update-status" Role="status" />
        </ChildContent>
    </Modal>
    @if (IsFeatureEnabled(AppFeatures.AiAssistant) && _aiExpanded)
    {
        <section class="ai-panel" id="ai-assistant-panel" data-testid="ai-assistant-panel" aria-labelledby="ai-assistant-title">
            <div class="ai-panel__header">
                <div>
                    <p class="ai-panel__eyebrow">Azure Foundry</p>
                    <h2 id="ai-assistant-title">Ask about this content</h2>
                </div>
                <a class="ai-panel__settings" href="settings">Settings</a>
            </div>
            <p class="ai-panel__body">
                The question is answered from the entries currently in view and loaded backlog knowledge.
            </p>
            @* The box keeps its own class and its own border, so the library's
               grow wrapper is emitted without one. *@
            <TextArea Bare="true"
                      AutoGrow="false"
                      GrowCssClass=""
                      InputCssClass="ai-panel__question"
                      AriaLabel="Ask about this content"
                      data-testid="ai-question-input"
                      Rows="3"
                      Placeholder="What should I focus on next?"
                      Value="@_aiQuestion"
                      ValueChanged="value => _aiQuestion = value"
                      @onkeydown="OnAiQuestionKeyDownAsync" />
            <div class="ai-panel__actions">
                <AppButton Variant="ButtonVariant.Secondary"
                           data-testid="ai-ask-button"
                           Disabled="@_aiBusy"
                           OnClick="AskAiAsync">
                    @(_aiBusy ? "Asking..." : "Ask")
                </AppButton>
            </div>
            <Alert Message="@_aiError" BaseClass="ai-panel__error" TestId="ai-error" />
            @if (_aiAnswer is not null)
            {
                <article class="ai-panel__answer" data-testid="ai-answer">
                    <h3>Answer</h3>
                    <p>@_aiAnswer</p>
                </article>
            }
        </section>
    }

    @* Exactly one of these renders, and each one's root is the page's only
       <main>. A takeover is deliberately not a Modal: there is no scrim and no
       focus trap, because the header behind it is not inert — it is where the
       control that closes the surface lives. Modal.razor still owns the modal
       semantics for the update and feedback dialogs, which really are modal. *@
    @if (ToolsVisible)
    {
        <main class="workspace-surface"
              data-testid="tools-surface"
              tabindex="-1"
              @ref="_surfaceElement"
              @onkeydown="OnSurfaceKeyDown"
              aria-label="System tools">
            <ToolsPane OnClose="CloseSurface" />
        </main>
    }
    else if (DashboardVisible)
    {
        <main class="workspace-surface"
              data-testid="dashboard-surface"
              tabindex="-1"
              @ref="_surfaceElement"
              @onkeydown="OnSurfaceKeyDown"
              aria-label="Dashboard">
            <DashboardPane OnClose="CloseSurface" />
        </main>
    }
    else if (SessionsVisible)
    {
        <main class="workspace-surface"
              data-testid="sessions-surface"
              tabindex="-1"
              @ref="_surfaceElement"
              @onkeydown="OnSurfaceKeyDown"
              aria-label="Sessions">
            <SessionsPane OnClose="CloseSurface" RepositoryColour="@RepositoryColourFor" />
        </main>
    }
    else
    {
        <main class="@WorkspaceClass" id="workspace" data-testid="workspace">
            @if (RoadmapBandVisible)
            {
                <RoadmapBand />
            }

            @* The pane row. It was the <main> itself until the band arrived above
               it; the class, the width variable and the test id are unchanged,
               because the resizer's JavaScript finds the layout by that test id. *@
            <div class="knowledge-layout @((TasksPaneVisible && RightSidePaneVisible) ? "knowledge-layout--side-open" : "knowledge-layout--side-closed") @(InboxBeforeTasksVisible ? "knowledge-layout--inbox-before-backlog" : string.Empty)" style="--knowledge-panel-width: @_knowledgePanelWidthRem.ToString(System.Globalization.CultureInfo.InvariantCulture)rem" data-testid="knowledge-layout">
                @if (InboxBeforeTasksVisible)
                {
                    <InboxPane Items="InboxItems" OnOpen="OpenInboxItemAsync" />
                }

                @if (TasksPaneVisible)
                {
                    <TasksPane />
                }

                @if (RightSidePaneVisible)
                {
                    @if (TasksPaneVisible)
                    {
                        @* The pane edge is the handle. Dragging it is the obvious gesture, so
                           the slider that used to sit inside the pane is gone; arrow keys on
                           the same separator carry the keyboard equivalent. *@
                        <div class="pane-resizer"
                             data-testid="side-pane-resizer"
                             data-pane-resizer="true"
                             role="separator"
                             aria-orientation="vertical"
                             aria-label="Side pane width"
                             aria-valuemin="@MinSidePaneWidthRem"
                             aria-valuemax="@_maxSidePaneWidthRem.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                             aria-valuenow="@_knowledgePanelWidthRem.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                             tabindex="0"
                             @onkeydown="OnResizerKeyDown"
                             @onkeydown:preventDefault="true">
                            <span class="pane-resizer__grip" aria-hidden="true"></span>
                        </div>
                    }

                    <aside @key=@("side-pane-stack") class="side-pane-stack @(TasksPaneVisible ? string.Empty : "side-pane-stack--full")" data-testid="side-pane-stack" aria-label="Tasks side panes">
                        @if (!TasksPaneVisible && InboxPaneVisible)
                        {
                            <InboxPane Items="InboxItems" OnOpen="OpenInboxItemAsync" />
                        }

                        @if (KnowledgePaneVisible)
                        {
                            <KnowledgePane RepositoryAlias="@State.SelectedRepositoryAlias" />
                        }
                    </aside>
                }
            </div>
        </main>
    }
</div>

@code {
    private WorkspaceSurface _surface = WorkspaceSurface.Workspace;
    private bool _aiExpanded;
    private GlobalPaneSelection _globalPanes = new();
    private double _knowledgePanelWidthRem = SidePaneWidth.DefaultRem;

    // Null in an installed build, where no host registers one and the header
    // shows the version instead.
    private DevelopmentWorkspaceLabel? _workspace;

    // Whether the roadmap band is on screen. Session-only and deliberately so:
    // WorkspaceSettingsStore scopes itself to where the backlog lives, which GitHub
    // repository backs that folder and which knowledge folders are configured —
    // three settings that are one decision, and what the reader currently has in
    // view is not that decision. The precedent for shell view state is
    // _knowledgePanelWidthRem above, which is session-only for the same reason. It
    // is not a feature flag either: the flag decides whether a band exists at all,
    // this decides whether the one that exists is showing, so nothing here is reset
    // when the flag changes.
    //
    // Its own field rather than a GlobalPane, for the reason written on the
    // multiselect group in the markup above: the band has no capacity rule and must
    // not acquire one by joining a selection that has.
    //
    // Hidden by default, and left at the field default to say so. The workspace
    // opens on the panes, which are what a session is usually about; a planning row
    // above them every time is a claim that every session starts with planning, and
    // most do not. The option in the header strip is the way in, and once pressed the
    // band stays up for the rest of the session.
    private bool _roadmapVisible;
    private double _maxSidePaneWidthRem = SidePaneWidth.MaxRem;
    private DotNetObjectReference<Home>? _selfReference;
    private ElementReference _surfaceElement;
    private bool _focusSurfacePending;
    private bool _workspaceWasHidden;

    private const double MinSidePaneWidthRem = SidePaneWidth.MinRem;
    private string? _appUpdateMessage;
    private string _appUpdateStatusClass = AppUpdatePresentation.StatusClass(AppUpdateAvailability.Unknown);
    private bool _checkingForAppUpdate;
    private bool _installingAppUpdate;
    private bool _appUpdateReady;
    private bool _appUpdateWindowOpen;
    private string _aiQuestion = string.Empty;
    private string? _aiAnswer;
    private string? _aiError;
    private bool _aiBusy;

    private bool _updateBusy => _checkingForAppUpdate || _installingAppUpdate;

    // The shell's save state in the library's vocabulary. The two enums are
    // deliberately not the same type: AppSaveState is the backlog's, named for
    // what the store did, and SaveState is what an indicator draws. Error maps
    // onto Failed, which is the same word in the other vocabulary — and the same
    // "save-indicator--error" modifier the hand-rolled block emitted, so the
    // stylesheet is untouched.
    //
    // There is no Idle arm because AppSaveState has none: the backlog is always
    // in one of these three states, so the indicator's hidden shape is
    // unreachable from here and the header never loses the line.
    private SaveState SaveIndicatorState => State.SaveState switch
    {
        AppSaveState.Saving => SaveState.Saving,
        AppSaveState.Error => SaveState.Failed,
        _ => SaveState.Saved
    };

    private string VersionControlLabel => _workspace is null
        ? AppUpdatePresentation.VersionWindowLabel(Updates.CurrentVersion)
        : AppUpdatePresentation.WorkspaceWindowLabel(_workspace.Marker);

    protected override async Task OnInitializedAsync()
    {
        // Asked for rather than injected, so a host that registers nothing —
        // every installed build — still resolves this component.
        _workspace = Services.GetService<DevelopmentWorkspaceLabel>();

        // Reopen on the surface the reader was last looking at rather than
        // always defaulting to the workspace panes. An unrecognised or absent
        // value — first launch included — leaves the field default in place.
        if (Enum.TryParse<WorkspaceSurface>(ShellNavigation.LastSurface, out var restoredSurface))
        {
            _surface = restoredSurface;
        }

        // Same restore for which panes were open, and which of those were
        // pinned. This is what makes it survive Settings and back, not only a
        // full relaunch: the Router disposes and reconstructs this component
        // on every route change, so a fresh GlobalPaneSelection is exactly
        // what a bare `new()` field initializer would otherwise hand back.
        var restoredPanes = ShellNavigation.LastEnabledPanes
            .Select(name => GlobalPaneSelection.TryParsePersistedPane(name, out var pane) ? pane : (GlobalPane?)null)
            .Where(pane => pane.HasValue)
            .Select(pane => pane!.Value)
            .ToArray();

        if (restoredPanes.Length > 0)
        {
            _globalPanes = new GlobalPaneSelection(restoredPanes);

            foreach (var name in ShellNavigation.LastPinnedPanes)
            {
                if (GlobalPaneSelection.TryParsePersistedPane(name, out var pinnedPane))
                {
                    _globalPanes.TrySetPinned(pinnedPane, pinned: true);
                }
            }
        }

        State.Changed += HandleStateChanged;
        Features.Changed += HandleFeaturesChanged;
        await State.InitializeAsync();
        SynchronizePaneAvailability();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfReference = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("backlogPaneResizer.initialize", _selfReference);
            }
            catch (Exception)
            {
                // Without the interop the separator still resizes by keyboard.
            }
        }

        // The two branches below run on every render, not only the first: a
        // surface can open and close any number of times after it.
        if (WorkspaceVisible)
        {
            _focusSurfacePending = false;

            if (_workspaceWasHidden)
            {
                _workspaceWasHidden = false;

                // A takeover unmounts the pane layout, and the bounds are measured
                // from that element, so the window's resize listener has nothing to
                // report for as long as one is open. Without this, a window resized
                // during a takeover would leave the pane capacity describing the
                // window as it was before — until the next resize happened to
                // correct it. Re-measuring here applies the capacity rule for the
                // window the reader actually came back to.
                try
                {
                    await JS.InvokeVoidAsync("backlogPaneResizer.refresh");
                }
                catch (Exception)
                {
                    // Non-fatal for the same reason initialize is: without the
                    // interop the capacity simply stays where it was.
                }
            }

            return;
        }

        _workspaceWasHidden = true;

        // Moving focus onto the surface is what announces the context change and
        // makes Escape work without a click first. Once per open — guarded on the
        // flag rather than on firstRender, because a re-render inside an open
        // surface must not drag focus back out of whatever it is now on.
        if (!_focusSurfacePending) return;

        _focusSurfacePending = false;
        try
        {
            await _surfaceElement.FocusAsync();
        }
        catch (Exception)
        {
            // Focus is an improvement on where the browser would have left it,
            // not something the surface depends on.
        }
    }

    /// <summary>Whether the tools surface is on screen. Unlike the three global
    /// panes this is a plain disclosure with no capacity rule — it takes the whole
    /// screen instead of a place in the side stack, so nothing else renders beside
    /// it — but it is still gated on the feature, so turning the feature off
    /// returns the reader to the workspace.</summary>
    private bool ToolsVisible => _surface == WorkspaceSurface.Tools && IsFeatureEnabled(DevPcFeatures.SystemTools);

    /// <summary>Whether the dashboard is on screen. The same shape as
    /// <see cref="ToolsVisible"/>, and mutually exclusive with it by construction
    /// rather than by a rule written here: both read the one surface field.</summary>
    private bool DashboardVisible => _surface == WorkspaceSurface.Dashboard && IsFeatureEnabled(DashboardFeatures.Dashboard);

    /// <summary>Whether the session list is on screen. The same shape again, for a
    /// third context: the flag it reads is Sessions', not the Shell's, because the
    /// pane is that context's too.</summary>
    private bool SessionsVisible => _surface == WorkspaceSurface.Sessions && IsFeatureEnabled(SessionFeatures.Sessions);

    /// <summary>Whether the panes are on screen. Anything that is not a takeover
    /// is the workspace, including a surface whose feature has been switched off.</summary>
    private bool WorkspaceVisible => !ToolsVisible && !DashboardVisible && !SessionsVisible;

    /// <summary>Whether the surface switcher is offered at all. It needs something
    /// to switch to: with every takeover feature off its only member would be the
    /// workspace the reader is already looking at, which is a control with no choice
    /// in it. Each takeover keeps its own segment gated on its own feature, so this
    /// is the "is there a segment beyond Workspace" question and nothing more.</summary>
    private bool SurfaceSwitcherVisible =>
        IsFeatureEnabled(DevPcFeatures.SystemTools)
        || IsFeatureEnabled(DashboardFeatures.Dashboard)
        || IsFeatureEnabled(SessionFeatures.Sessions);

    /// <summary>Whether the Roadmap option is offered at all. The same two-level
    /// split as <see cref="InboxPaneOptionVisible"/>: the feature decides whether
    /// there is an option, the option decides what is on screen.</summary>
    private bool RoadmapPaneOptionVisible => IsFeatureEnabled(RoadmapFeatures.Roadmap);

    /// <summary>Whether the roadmap band renders above the panes. Only inside the
    /// workspace: a takeover hides every other domain concern, the band included.
    /// The flag is read first, so turning the feature off hides the band whatever
    /// the toggle says — and leaves the toggle's own state untouched for when it
    /// comes back.</summary>
    private bool RoadmapBandVisible => RoadmapPaneOptionVisible && _roadmapVisible;

    /// <summary>The workspace grid's classes. One modifier, because show and hide is
    /// binary: with no band on screen its track goes rather than being left empty
    /// above the panes, and there is no in-between size for a second variant to
    /// describe. The feature being off and the toggle being off are the same
    /// layout.</summary>
    private string WorkspaceClass => RoadmapBandVisible ? "workspace" : "workspace workspace--no-roadmap";

    private void ToggleAiPanel() => _aiExpanded = !_aiExpanded;

    private void ToggleTools() => ToggleSurface(WorkspaceSurface.Tools);

    private void ToggleDashboard() => ToggleSurface(WorkspaceSurface.Dashboard);

    private void ToggleSessions() => ToggleSurface(WorkspaceSurface.Sessions);

    /// <summary>Opens a surface, or returns to the workspace if it was already the
    /// one on screen. Assigning rather than flipping a flag is what makes the
    /// takeovers exclusive: opening one is the same act as closing the other.</summary>
    private void ToggleSurface(WorkspaceSurface surface)
    {
        _surface = _surface == surface ? WorkspaceSurface.Workspace : surface;
        _focusSurfacePending = _surface != WorkspaceSurface.Workspace;
        ShellNavigation.SetLastSurface(_surface.ToString());
    }

    /// <summary>Back to the panes. The pane selection was never touched, so there
    /// is nothing to restore — it is simply visible again.</summary>
    private void CloseSurface()
    {
        _surface = WorkspaceSurface.Workspace;
        ShellNavigation.SetLastSurface(_surface.ToString());
    }

    private void OnSurfaceKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseSurface();
    }

    private async Task AskAiAsync()
    {
        if (_aiBusy) return;

        _aiBusy = true;
        _aiError = null;
        _aiAnswer = null;

        try
        {
            var response = await AzureFoundryChat.AskAsync(new AzureFoundryChatRequest(BuildAiContent(), _aiQuestion));
            _aiAnswer = response.Answer;
        }
        catch (AzureFoundryException ex)
        {
            _aiError = ex.Message;
        }
        catch (HttpRequestException ex)
        {
            _aiError = $"Azure Foundry could not be reached: {ex.Message}";
        }
        catch (TaskCanceledException)
        {
            _aiError = "Azure Foundry did not answer before the request timed out.";
        }
        finally
        {
            _aiBusy = false;
        }
    }

    private Task OnAiQuestionKeyDownAsync(KeyboardEventArgs e) =>
        e.Key == "Enter" && (e.CtrlKey || e.MetaKey) ? AskAiAsync() : Task.CompletedTask;

    private string BuildAiContent()
    {
        var builder = new System.Text.StringBuilder();
        builder.AppendLine("Visible tasks:");
        foreach (var row in State.FilteredRows.Where(row => !row.IsUntouched))
        {
            builder.AppendLine("---");
            builder.AppendLine(row.RawText.Trim());
        }

        var content = builder.ToString().Trim();
        return content.Length <= 12000 ? content : content[..12000];
    }

    private bool TasksPaneVisible => _globalPanes.IsEnabled(GlobalPane.Tasks);

    private bool InboxFeatureEnabled => IsFeatureEnabled(AppFeatures.InboxPane);

    private bool InboxPaneOptionVisible => InboxFeatureEnabled;

    private bool InboxPaneVisible => InboxPaneOptionVisible && _globalPanes.IsEnabled(GlobalPane.Inbox);

    /// <summary>Whether there is any knowledge to offer. The shell asks Second
    /// Brain rather than working it out from folder settings itself.</summary>
    private bool KnowledgePaneOptionVisible =>
        IsFeatureEnabled(KnowledgeFeatures.RepositoryKnowledge)
        && Knowledge.VisibleAreas(State.SelectedRepositoryAlias).Count > 0;

    private bool KnowledgePaneVisible => KnowledgePaneOptionVisible && _globalPanes.IsEnabled(GlobalPane.Knowledge);

    private bool InboxBeforeTasksVisible => TasksPaneVisible && InboxPaneVisible;

    /// <summary>Whether the side stack has anything in it. Tools used to count
    /// here; it no longer lives in the stack at all, so a stack holding only the
    /// tools pane can no longer happen and the split cannot open for it.</summary>
    private bool RightSidePaneVisible => KnowledgePaneVisible || (InboxPaneVisible && !TasksPaneVisible);

    private bool IsFeatureEnabled(string featureKey) => Features.IsEnabled(featureKey);

    /// <summary>The maturity flag an entry point wears — empty unless the feature
    /// behind it is both switched on and unfinished.
    ///
    /// <para>The settings screen shows a status whether or not the switch is on,
    /// because it is describing the switch. Here the badge is describing
    /// something you can reach and click, so a feature that is off has nothing to
    /// flag. Both halves of that live in <see cref="AppFeatureStatusBadge"/>
    /// rather than being spelled out at each of the entry points below.</para></summary>
    private string FeatureStatusSlug(string featureKey) =>
        AppFeatureStatusBadge.SlugFor(AppFeatures.All, Features, featureKey);

    private string? FeatureStatusTitle(string featureKey) =>
        AppFeatureStatusBadge.TitleFor(AppFeatures.All, Features, featureKey);

    private void HandleStateChanged() => _ = InvokeAsync(() =>
    {
        SynchronizePaneAvailability();
        StateHasChanged();
    });

    private void HandleFeaturesChanged() => _ = InvokeAsync(() =>
    {
        SynchronizePaneAvailability();
        StateHasChanged();
    });

    private void OpenUpdateWindow() => _appUpdateWindowOpen = true;

    private void CloseUpdateWindow()
    {
        if (_updateBusy) return;

        _appUpdateWindowOpen = false;
    }

    private async Task CheckForUpdatesAsync()
    {
        if (_updateBusy) return;

        _checkingForAppUpdate = true;
        _appUpdateMessage = null;
        _appUpdateReady = false;

        try
        {
            var result = await Updates.CheckForUpdateAsync();
            _appUpdateReady = result.UpdateReady;
            _appUpdateMessage = result.Message;
            _appUpdateStatusClass = AppUpdatePresentation.StatusClass(result.Availability);
        }
        catch
        {
            _appUpdateReady = false;
            _appUpdateMessage = "The update check could not be completed.";
            _appUpdateStatusClass = AppUpdatePresentation.StatusClass(AppUpdateAvailability.Failed);
        }
        finally
        {
            _checkingForAppUpdate = false;
        }
    }

    private async Task InstallUpdateAsync()
    {
        if (_updateBusy) return;

        _installingAppUpdate = true;

        try
        {
            var result = await Updates.StartUpdateAsync();
            _appUpdateMessage = result.Message;
            _appUpdateStatusClass = AppUpdatePresentation.StatusClass(
                result.Started ? AppUpdateAvailability.UpToDate : AppUpdateAvailability.Failed);
            if (!result.Started) _appUpdateReady = false;
        }
        catch
        {
            _appUpdateMessage = "The update could not be installed.";
            _appUpdateStatusClass = AppUpdatePresentation.StatusClass(AppUpdateAvailability.Failed);
        }
        finally
        {
            _installingAppUpdate = false;
        }
    }

    /// <summary>What the Inbox has to show, in the Inbox's own contract. The
    /// shell only passes it along; the projection itself belongs to the context
    /// that owns the entries.</summary>
    private IReadOnlyList<InboxItem> InboxItems => TasksDrafts.ForInbox(State.Rows);

    private void SynchronizePaneAvailability()
    {
        _globalPanes.TrySetAvailable(GlobalPane.Tasks, available: true);
        _globalPanes.TrySetAvailable(GlobalPane.Inbox, InboxPaneOptionVisible);
        _globalPanes.TrySetAvailable(GlobalPane.Knowledge, KnowledgePaneOptionVisible);
        PersistPaneSelection();
    }

    /// <summary>Remembers which panes are open and pinned, so the next fresh
    /// shell instance — a relaunch, or the Router rebuilding this component
    /// after a trip to Settings — reopens on them instead of the single
    /// default pane.</summary>
    private void PersistPaneSelection()
    {
        var enabled = Enum.GetValues<GlobalPane>().Where(_globalPanes.IsEnabled).Select(pane => pane.ToString()).ToArray();
        var pinned = Enum.GetValues<GlobalPane>().Where(_globalPanes.IsPinned).Select(pane => pane.ToString()).ToArray();
        ShellNavigation.SetLastPanes(enabled, pinned);
    }

    private bool PaneToggleDisabled(GlobalPane pane)
    {
        if (_globalPanes.IsEnabled(pane))
        {
            return !_globalPanes.CanDisable(pane);
        }

        return !_globalPanes.CanEnable(pane);
    }

    /// <summary>Show or hide the band. A plain flip of a shell field rather than a
    /// call into <see cref="GlobalPaneSelection"/>, and it never consults capacity:
    /// the band is always freely toggleable because it takes no width from the panes.
    /// See the multiselect group in the markup for why it stays out of the selection.</summary>
    private void ToggleRoadmapBand() => _roadmapVisible = !_roadmapVisible;

    private void ToggleInboxPane()
    {
        _globalPanes.Toggle(GlobalPane.Inbox);
        PersistPaneSelection();
    }

    private void ToggleTasksPane()
    {
        _globalPanes.Toggle(GlobalPane.Tasks);
        PersistPaneSelection();
    }

    private void ToggleKnowledgePane()
    {
        _globalPanes.Toggle(GlobalPane.Knowledge);
        PersistPaneSelection();
    }

    private bool PanePinned(GlobalPane pane) => _globalPanes.IsPinned(pane);

    /// <summary>A pin describes a pane on screen, so a closed pane has nothing to
    /// pin — and in a window that fits one pane no pin could keep its promise. An
    /// existing pin stays pressable either way, because withdrawing one is always
    /// allowed.</summary>
    private bool PinToggleDisabled(GlobalPane pane) => !_globalPanes.IsPinned(pane) && !_globalPanes.CanPin(pane);

    private string PinLabel(GlobalPane pane, string name) =>
        _globalPanes.IsPinned(pane) ? $"Stop keeping {name} open" : $"Keep {name} open when switching panes";

    /// <summary>Why the pin is inert, when it is — the label alone would only repeat
    /// the offer the control cannot currently honour.</summary>
    private string PinTitle(GlobalPane pane, string name) =>
        _globalPanes.Capacity == 1 ? "This window only fits one pane at a time"
        : !_globalPanes.IsEnabled(pane) ? $"Open {name} to keep it open"
        : PinLabel(pane, name);

    private void ToggleInboxPin()
    {
        _globalPanes.TogglePin(GlobalPane.Inbox);
        PersistPaneSelection();
    }

    private void ToggleTasksPin()
    {
        _globalPanes.TogglePin(GlobalPane.Tasks);
        PersistPaneSelection();
    }

    private void ToggleKnowledgePin()
    {
        _globalPanes.TogglePin(GlobalPane.Knowledge);
        PersistPaneSelection();
    }

    /// <summary>Triage: the Inbox hands back the item it was asked to open, and
    /// the shell shows it where work actually happens.
    /// <para>
    /// Alongside rather than a switch: this is the shell opening a pane on the
    /// reader's behalf, and closing the Inbox they just picked the item from would
    /// take away the list they were working through.
    /// </para></summary>
    private Task OpenInboxItemAsync(InboxItem item)
    {
        if (TasksDrafts.Find(State.Rows, item) is not { } row) return Task.CompletedTask;

        _globalPanes.TryOpenAlongside(GlobalPane.Tasks);
        PersistPaneSelection();
        State.BeginEdit(row);
        return Task.CompletedTask;
    }

    /// <summary>The repository scope is global: it narrows the backlog list and,
    /// through the alias handed to the pane, what knowledge is read beside it.</summary>
    /// <summary>
    /// The repository's identity mark, as classes.
    /// <para>
    /// Which hue is the settings store's answer and not this screen's — every surface
    /// asks the same place, which is what stops the same project being two colours.
    /// The mark is additive: the chip keeps the surface, border and text it already
    /// had, and gains a rule down its leading edge. See
    /// <c>.design/color-scheme.md#band-identity-tokens</c>.
    /// </para>
    /// </summary>
    private string? RepositoryMarkClass(string alias) =>
        State.RepositoryColours.TryGetValue(alias, out var colour) ? $"repo-mark repo-mark--{colour}" : null;

    /// <summary>
    /// The hue for a repository named the way a session names one — <c>owner/name</c>,
    /// or nothing at all. Null for a session whose repository is not configured here,
    /// which is the ordinary case for work done in a clone this workspace does not
    /// know about.
    /// </summary>
    private int? RepositoryColourFor(string? repository) => State.RepositoryColourFor(repository);

    /// <summary>
    /// Shows or hides the repository identity hues across every surface.
    /// <para>
    /// The state class writes it, because the settings store is where the hue itself is
    /// answered and this is the same fact seen from the other side. The store's message
    /// on a failed write is dropped rather than shown: the choice has taken effect for
    /// this session either way, and the header has no room for a line of prose that
    /// would outlive the gesture it belongs to. Settings is where a settings file that
    /// cannot be written gets reported.
    /// </para>
    /// </summary>
    private void ShowRepositoryColours(bool visible) => _ = State.SetRepositoryColoursVisible(visible);

    private void ToggleRepositoryScopeAsync(string repositoryAlias)
    {
        var nextAlias = string.Equals(State.SelectedRepositoryAlias, repositoryAlias, StringComparison.Ordinal)
            ? string.Empty
            : repositoryAlias;
        State.SetRepositoryFilter(nextAlias);
    }

    [JSInvokable]
    public Task SetSidePaneWidthAsync(double widthRem)
    {
        var clamped = SidePaneWidth.Clamp(widthRem, _maxSidePaneWidthRem);
        if (Math.Abs(clamped - _knowledgePanelWidthRem) < 0.001) return Task.CompletedTask;

        _knowledgePanelWidthRem = clamped;
        StateHasChanged();
        return Task.CompletedTask;
    }

    // How wide the pane may actually get depends on the window, which only the
    // browser knows; without it the separator would keep counting past the edge.
    [JSInvokable]
    public Task SetSidePaneMaxWidthAsync(double maxRem)
    {
        var clamped = SidePaneWidth.Clamp(maxRem, SidePaneWidth.MaxRem);
        var width = Math.Min(_knowledgePanelWidthRem, clamped);
        if (Math.Abs(clamped - _maxSidePaneWidthRem) < 0.001 && Math.Abs(width - _knowledgePanelWidthRem) < 0.001)
        {
            return Task.CompletedTask;
        }

        _maxSidePaneWidthRem = clamped;
        _knowledgePanelWidthRem = width;
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task SetGlobalPaneCapacityAsync(int capacity)
    {
        if (!_globalPanes.TrySetCapacity(capacity))
        {
            return Task.CompletedTask;
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    // The drag lives in JavaScript because pointer capture does; the keyboard
    // equivalent stays here so the separator has one clamped source of truth.
    private void OnResizerKeyDown(KeyboardEventArgs e) =>
        _knowledgePanelWidthRem = SidePaneWidth.Adjust(_knowledgePanelWidthRem, e.Key, _maxSidePaneWidthRem);

    public void Dispose()
    {
        State.Changed -= HandleStateChanged;
        Features.Changed -= HandleFeaturesChanged;
        _selfReference?.Dispose();
        _selfReference = null;
    }
}
