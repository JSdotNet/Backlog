    /// <summary>
    /// The repository an entry's reference asked the Devbook pane to read, and the
    /// scope anchor it was asked under — or null when nothing has asked, or the
    /// entry's repository was the anchor anyway.
    /// <para>
    /// Held beside the scope rather than written into it, and that is the decision.
    /// Scoping the list to the entry's repository would also show the pane the right
    /// devbook, and it would narrow the backlog the reader was working in to answer a
    /// question about one chapter — and with nothing scoped there is no anchor at
    /// all, so the pane would have nothing to read. Keyed on the anchor so it lasts
    /// exactly as long as the scope the reader left alone: choosing a repository in
    /// the header is choosing what the pane reads, and the request is forgotten.
    /// </para>
    /// </summary>
    private DevbookRepositoryRequest? _devbookRepositoryRequest;

    private sealed record DevbookRepositoryRequest(string Anchor, string RepositoryAlias);

    /// <summary>The reference handed to the Devbook pane and not yet followed,
    /// numbered so the same one pressed twice is two requests. See
    /// <see cref="DevbookOpenRequest"/>. Dropped once the pane reports it followed —
    /// see <see cref="OnDevbookReferenceFollowed"/>.</summary>
    private DevbookOpenRequest? _devbookOpenRequest;

    /// <summary>
    /// The pane took the request, so the shell stops handing it on.
    /// <para>
    /// The pane remembers what it followed only while it is mounted, and this
    /// parameter outlives it: hidden and shown again, or remounted for any other
    /// reason, a fresh pane handed the same request followed it again and pulled
    /// the reader back to the task's chapter. Only that request is dropped — one
    /// pressed since carries a newer number and is still owed.
    /// </para>
    /// </summary>
    private void OnDevbookReferenceFollowed(long sequence)
    {
        if (_devbookOpenRequest?.Sequence == sequence) _devbookOpenRequest = null;
    }

    private long _devbookOpenSequence;

    /// <summary>The repository the Devbook pane reads: the one an entry's reference
    /// asked for while the scope it was asked under still stands, else the scope's
    /// anchor.</summary>
    private string DevbookRepositoryAlias =>
        _devbookRepositoryRequest is { } asked
        && string.Equals(asked.Anchor, State.AnchorRepositoryAlias, StringComparison.Ordinal)
            ? asked.RepositoryAlias
            : State.AnchorRepositoryAlias;

    /// <summary>
    /// One of an entry's Devbook references, opened from the entry: the Devbook pane
    /// on screen beside the list, reading the entry's repository, on that chapter.
    /// <para>
    /// The mirror of <see cref="OpenSessionAsync"/>: the entry belongs to Tasks and
    /// the chapter to Devbook, and the shell is the one place holding both. Opened
    /// beside the view — the reader pressed it from the list and is still working in
    /// it — and where the window has no room for another side pane, the Inbox makes
    /// way rather than the request being dropped.
    /// A repository with no devbook to show, or the Devbook switched off, is said out
    /// loud rather than opening an empty pane.
    /// </para>
    /// </summary>
    private Task OpenDevbookReferenceAsync(DevbookReferenceRequest request)
    {
        var alias = string.IsNullOrWhiteSpace(request.RepositoryAlias)
            ? State.AnchorRepositoryAlias
            : request.RepositoryAlias;

        if (!IsFeatureEnabled(DevbookFeatures.RepositoryDevbook)
            || alias.Length == 0
            || Devbook.VisibleAreas(alias).Count == 0)
        {
            Toasts.Publish(ToastMessage.Warning(
                alias.Length == 0
                    ? "This entry names no repository, so there is no Devbook to open it in."
                    : $"The Devbook of {alias} is not available here, so this reference cannot be opened.",
                DevbookUnavailableTestId));

            return Task.CompletedTask;
        }

        _devbookRepositoryRequest = string.Equals(alias, State.AnchorRepositoryAlias, StringComparison.Ordinal)
            ? null
            : new DevbookRepositoryRequest(State.AnchorRepositoryAlias, alias);
        _devbookOpenRequest = new DevbookOpenRequest(request.Reference, ++_devbookOpenSequence);

        // The pane's option may only now be on offer: with nothing scoped there was
        // no repository to read until the request named one.
        SynchronizePaneAvailability();
        _globalPanes.TryOpen(GlobalPane.Devbook);
        RememberAiScope(AiScopeFor(GlobalPane.Devbook));
        PersistPaneSelection();

        return Task.CompletedTask;
    }

    private const string DevbookUnavailableTestId = "tasks-devbook-unavailable";

    /// <summary>
    /// The Backlog entry a delivery run was started from, opened from the sessions
    /// list: back to the panes, the task list on screen, that entry selected.
    /// <para>
    /// Here rather than in the sessions pane because an entry belongs to Tasks and
    /// that pane holds sessions: it knows a run names an entry and nothing about how
    /// this workspace shows one. The shell owns both, which is what makes it the one
    /// place the two can meet.
    /// </para>
    /// <para>
    /// Matched first on the entry's stored id where the reference carries one — the
    /// line the app puts on every entry it copies names it, and so does an entry that
    /// linked the session — because nothing identifies an entry more surely. Then on
    /// the pair the import writes down — the plan and the item's id within it —
    /// because that is what identifies an entry across plan versions; the plan is
    /// stored with its sigil and the marker states the slug, so the comparison drops
    /// it. An entry this workspace does not hold is said out loud rather than
    /// silently doing nothing: the run was real and the entry is somewhere, just not
    /// here.
    /// </para>
    /// </summary>
    private async Task OpenPlanEntryAsync(DeliveryRunReference reference)
    {
        // Named by id alone, the label is the entry's title rather than an item id,
        // so there is no plan item to fall back on.
        var byIdOnly = reference.EntryId is not null && reference.Plan is null;

        var row = reference.EntryId is { } entryId
            ? State.Rows.FirstOrDefault(candidate => candidate.Id == entryId)
            : null;

        row ??= byIdOnly
            ? null
            : State.Rows.FirstOrDefault(candidate =>
                string.Equals(candidate.PreviewImportItemId, reference.Label, StringComparison.OrdinalIgnoreCase)
                && InPlan(candidate, reference.Plan));

        if (row is null)
        {
            Toasts.Publish(ToastMessage.Warning(
                byIdOnly
                    ? $"The entry {reference.Label} is not in this workspace."
                    : $"No entry of plan {reference.Plan} with the id {reference.Label} is in this workspace.",
                PlanEntryMissingTestId));

            return;
        }

        ShowView(ShellView.Tasks);

        await State.SelectAsync(row);
    }

    /// <summary>
    /// Whether an entry belongs to the plan a run names. Two ways, because an entry
    /// can carry the plan in two: Import stamps the plan id on what it writes, and an
    /// entry typed by hand carries the plan tag and nothing else. Either is the plan
    /// saying so; neither is a guess.
    /// <para>
    /// The sigil is trimmed on both sides — the app stores a plan tag as
    /// <c>+slug</c> and the marker states the slug bare — and a reference that names
    /// no plan matches on the item id alone, which the caller has already compared.
    /// </para>
    /// </summary>
    private static bool InPlan(EntryRow row, string? plan)
    {
        if (plan is null) return true;

        var wanted = plan.TrimStart('+');

        return string.Equals((row.ImportPlanId ?? string.Empty).TrimStart('+'), wanted, StringComparison.OrdinalIgnoreCase)
            || row.PreviewTags.Any(tag => string.Equals(tag.TrimStart('+'), wanted, StringComparison.OrdinalIgnoreCase));
    }

    private const string PlanEntryMissingTestId = "sessions-plan-entry-missing";

    /// <summary>
    /// The entry that linked a session, as the sessions list asks for it: the entry's
    /// own record of the session it was worked in, written by the Backlog server's
    /// <c>link_session</c>. Answered here for the reason <see cref="OpenPlanEntryAsync"/>
    /// is — the link is stored on the entry and the session is in the other pane — and
    /// by stored id, so opening it is the surest match that method makes.
    /// </summary>
    private DeliveryRunReference? SessionTaskFor(string sessionId)
    {
        var row = State.Rows.FirstOrDefault(candidate =>
            candidate.Id is not null
            && candidate.SessionLinks.Any(link => string.Equals(link.SessionId, sessionId, StringComparison.OrdinalIgnoreCase)));

        return TaskReference(row);
    }

    /// <summary>
    /// The entry a pull request belongs to, as the pull requests list asks for it,
    /// found by <see cref="PullRequestTaskMatcher"/> in order of how sure each
    /// relation is: the entry's own <c>pull-request</c> projection, a GitHub issue a
    /// linked task follows that the pull request closes, a linked task's external key
    /// in its title or branch, and the entry that linked its session. Answered here
    /// for the reason <see cref="SessionTaskFor"/> is — the record is on the entry and
    /// the pull request is in another pane — and by stored id, so opening it is the
    /// surest match <see cref="OpenPlanEntryAsync"/> makes.
    /// <para>
    /// With <paramref name="mineOnly"/> only my tasks are asked — open ones, and a
    /// linked task only where the Tasks pane would count it as mine — which is what the
    /// pane's "Mine" adds to the pull requests I opened myself.
    /// </para>
    /// </summary>
    private DeliveryRunReference? PullRequestTaskFor(PullRequestTaskSubject pull, bool mineOnly)
    {
        var (matcher, rows) = PullRequestMatcher;
        return matcher.Match(pull, mineOnly) is { } match && rows.TryGetValue(match.Candidate.EntryId, out var row)
            ? TaskReference(row)
            : null;
    }

    private (PullRequestTaskMatcher Matcher, Dictionary<Guid, EntryRow> Rows)? _pullRequestMatcher;
    private List<EntryRow>? _pullRequestMatcherRows;

    /// <summary>One matcher over every entry, built on first ask and again whenever
    /// the task list changed — not per row the pane draws, which asks once per cell.</summary>
    private (PullRequestTaskMatcher Matcher, Dictionary<Guid, EntryRow> Rows) PullRequestMatcher
    {
        get
        {
            if (_pullRequestMatcher is { } built && ReferenceEquals(_pullRequestMatcherRows, State.Rows)) return built;

            var rows = new Dictionary<Guid, EntryRow>();
            var candidates = new List<PullRequestTaskCandidate>();
            foreach (var row in State.Rows)
            {
                if (row.Id is not { } id || !rows.TryAdd(id, row)) continue;

                var source = row.SourceRef;
                candidates.Add(new PullRequestTaskCandidate(
                    id,
                    [.. row.PullRequestLinks.Select(link => new RecordedPullRequest(link.Repository, link.Number))],
                    source is null ? null : PullRequestTaskMatcher.GitHubIssueOf(source.ConnectorId, source.Target, source.DisplayKey, source.Url),
                    PullRequestTaskMatcher.ExternalKeysOf(source?.DisplayKey),
                    [.. row.SessionLinks.Select(link => link.SessionId)],
                    IsMine: row.PreviewStatus is not (EntryStatus.Done or EntryStatus.Archived)));
            }

            _pullRequestMatcherRows = State.Rows;
            _pullRequestMatcher = (new PullRequestTaskMatcher(candidates), rows);
            return _pullRequestMatcher.Value;
        }
    }

    /// <summary>An entry as a task reference another pane can hand back: its title, or
    /// the first block of its id where it has none, and the id itself to open it by.</summary>
    private static DeliveryRunReference? TaskReference(EntryRow? row) =>
        row is { Id: { } id }
            ? new DeliveryRunReference(
                DeliveryRunReferenceKind.Task,
                string.IsNullOrWhiteSpace(row.PreviewTitle) ? id.ToString()[..8] : row.PreviewTitle,
                Title: null,
                Url: null,
                Repository: null,
                EntryId: id)
            : null;

    private void OnSurfaceKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseSurface();
    }

    /// <summary>The same Escape, heard at the document because focus is on
    /// <c>&lt;body&gt;</c> — where a focused control that went disabled, such as a
    /// Refresh button while its read runs, leaves it — and so never reached the
    /// surface's own handler. The script checks a closing surface is open; this
    /// checks again, because the render may have moved on since the key.</summary>
    [JSInvokable]
    public Task CloseSurfaceOnEscapeAsync()
    {
        // The Roadmap view is the workspace and has no Escape of its own here.
        if (WorkspaceVisible) return Task.CompletedTask;

        CloseSurface();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task AskAiAsync()
    {
        if (EffectiveAiScope is not { } scope || !_aiSources.TryGetValue(scope, out var source)) return;

        // One token per ask, and a new ask ends the one before it: an answer to
        // the question the reader has moved on from is not worth its quota, and a
        // compose still reading a store for it is not worth its I/O. The button is
        // disabled while an ask is in flight, so this reaches a second ask only by
        // the keyboard shortcut — and the one in flight is the older of the two.
        var ask = ReplaceAsk();
        _aiBusy = true;
        _aiAnswer = null;

        try
        {
            // The scoped area composes its own content for the question, within
            // the budget the deployment can take in one turn. The shell hands over
            // the body and learns nothing about what is in it.
            //
            // Its own try, because the source reads a store — the tool catalog's
            // JSON, the plan's SQLite file, the devbook database, GitHub — and any
            // of those can throw. That throw is a fact about the area, not about
            // the assistant, so it is said as one; and it must not reach the error
            // boundary, which would take the page for a question that was never
            // sent.
            AiContent content;
            try
            {
                content = await source.ComposeAsync(new AiContentRequest(_aiQuestion, AiContentBudget.DefaultCharacters), ask.Token);
            }
            catch (OperationCanceledException) when (ask.IsCancellationRequested)
            {
                return;
            }
            catch (Exception ex)
            {
                Toasts.Publish(ToastMessage.Error($"Could not gather the {source.AreaTitle} content: {ex.Message}", AiErrorTestId));
                return;
            }

            var response = await AzureFoundryChat.AskAsync(new AzureFoundryChatRequest(content.Body, _aiQuestion), ask.Token);
            if (!ask.IsCancellationRequested) _aiAnswer = response.Answer;
        }
        catch (OperationCanceledException) when (ask.IsCancellationRequested)
        {
            // The reader closed the panel, left the page, or asked again: nothing
            // to say about an answer nobody is waiting for.
        }
        catch (AzureFoundryException ex) when (!ask.IsCancellationRequested)
        {
            // The one exception the client throws for every way an answer fails
            // to be one: a bad status, an endpoint that could not be reached, and
            // a request that ran out of time - the pipeline's timeout included,
            // which used to arrive here as Polly's own exception, past the two
            // transport catches this handler kept, and stop the whole page.
            Toasts.Publish(ToastMessage.Error(ex.Message, AiErrorTestId));
        }
        catch (AzureFoundryException)
        {
            // Cancelled mid-flight and the client said so in its own words; the
            // reader has already moved on.
        }
        finally
        {
            // Only the ask that is still current clears the flag: a cancelled one
            // finishing late must not mark its successor idle.
            if (ReferenceEquals(_aiAsk, ask)) _aiBusy = false;
        }
    }

    /// <summary>The in-flight ask's cancellation, or null when none is in flight.
    /// Cancelled by the next ask, by closing the panel, and on dispose.</summary>
    private CancellationTokenSource? _aiAsk;

    /// <summary>Ends whatever ask is in flight and starts the token for the next.</summary>
    private CancellationTokenSource ReplaceAsk()
    {
        CancelAsk();
        return _aiAsk = new CancellationTokenSource();
    }

    /// <summary>Ends the ask in flight, if any. Disposed here rather than at the
    /// end of the ask, so a token a late continuation still reads is a cancelled
    /// token and not a disposed one.</summary>
    private void CancelAsk()
    {
        var ask = _aiAsk;
        if (ask is null) return;

        _aiAsk = null;
        _aiBusy = false;
        ask.Cancel();
        ask.Dispose();
    }

    private Task OnAiQuestionKeyDownAsync(KeyboardEventArgs e) =>
        e.Key == "Enter" && (e.CtrlKey || e.MetaKey) ? AskAiAsync() : Task.CompletedTask;

