@*
    The app's priority badge, now a thin skin over the library's EnumSelect. The
    parameters and the rendered markup are unchanged.
*@

<EnumSelect TEnum="Priority"
            CurrentValue="@CurrentValue"
            Options="@Options"
            Label="@Label"
            TestId="@TestId"
            Disabled="@Disabled"
            BadgeKind="priority"
            CssClass="metadata-editor--priority"
            OnChanged="OnChanged" />

@code {
    [Parameter]
    public Priority CurrentValue { get; set; } = Priority.Medium;

    [Parameter]
    public IReadOnlyList<Priority>? Options { get; set; }

    [Parameter]
    public string Label { get; set; } = "Change priority";

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<Priority> OnChanged { get; set; }
}
