<label class="status-editor badge badge--status badge--status-@StatusClassValue" data-testid="@TestId">
    <span class="sr-only">@Label</span>
    <select id="@Id"
            class="status-editor__select"
            value="@CurrentValue"
            aria-label="@Label"
            title="@Label"
            disabled="@Disabled"
            @onchange="OnChange">
        @foreach (var option in Options)
        {
            <option value="@option.Value">@option.Label</option>
        }
    </select>
</label>

@code {
    [Parameter]
    public string CurrentValue { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<SelectorOption> Options { get; set; } = [];

    [Parameter]
    public string Label { get; set; } = "Change status";

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<string> OnChanged { get; set; }

    private string StatusClassValue => string.IsNullOrWhiteSpace(CurrentValue)
        ? "draft"
        : new string(CurrentValue.Trim().ToLowerInvariant().Where(ch => char.IsLetterOrDigit(ch) || ch == '-').ToArray());

    private Task OnChange(ChangeEventArgs e) => OnChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);
}
