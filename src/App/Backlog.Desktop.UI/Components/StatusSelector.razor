@*
    The app's status badge, now a thin skin over the library's BadgeSelect. The
    parameters and the rendered markup are unchanged.
*@

<BadgeSelect CurrentValue="@CurrentValue"
             Options="@Options"
             Label="@Label"
             TestId="@TestId"
             Id="@Id"
             Disabled="@Disabled"
             BadgeKind="status"
             FallbackSlug="draft"
             OnChanged="OnChanged" />

@code {
    [Parameter]
    public string CurrentValue { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<SelectorOption> Options { get; set; } = [];

    [Parameter]
    public string Label { get; set; } = "Change status";

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<string> OnChanged { get; set; }
}
