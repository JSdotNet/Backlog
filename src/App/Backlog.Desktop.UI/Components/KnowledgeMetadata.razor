@if (Meta.HasFields)
{
    <div class="knowledge-meta" aria-label="Metadata">
        <span class="knowledge-status knowledge-status--@Meta.Status">@Meta.Status</span>
        @foreach (var related in Meta.Related)
        {
            <code class="knowledge-related">@related</code>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public DesignKnowledgeMeta Meta { get; set; } = DesignKnowledgeMeta.Empty;
}

