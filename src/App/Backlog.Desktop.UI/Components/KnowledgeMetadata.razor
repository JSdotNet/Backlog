@*
    The strip itself is a shared component; all this file does is unpack the
    app's DesignKnowledgeMeta into it. HasFields stays the gate here because
    Status always reads back as "unknown" rather than empty.
*@

@if (Meta.HasFields)
{
    <MetadataBadge Status="@Meta.Status" Related="@Meta.Related" />
}

@code {
    [Parameter, EditorRequired]
    public DesignKnowledgeMeta Meta { get; set; } = DesignKnowledgeMeta.Empty;
}
