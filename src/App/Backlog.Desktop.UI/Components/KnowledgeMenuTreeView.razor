@*
    The knowledge menu is the library's TreeView with this app's vocabulary
    mapped onto it. KnowledgeMenuNode keys are only unique within a folder, so
    the adapter numbers rows by their position in the tree and keeps the original
    node behind that id — callers still receive the node they handed in.
*@

<TreeView ClassPrefix="knowledge-menu"
          NavClass="knowledge-stack__menu"
          HeadingClass="knowledge-stack__menu-heading"
          MessageClass="knowledge-stack__menu-message"
          OpenErrorClass="knowledge-stack__menu-error"
          HeadingTestId="knowledge-menu-heading"
          OpenButtonTestId="knowledge-open-vscode-button"
          OpenErrorTestId="knowledge-menu-open-error"
          NavAriaLabel="Knowledge menu"
          TreeAriaLabel="Knowledge chapters"
          LoadingMessage="Loading knowledge menu..."
          EmptyMessage="No chapters are available for this area."
          HeadingLabel="@HeadingLabel"
          RootFolder="@RootTreeNode"
          Nodes="@TreeNodes"
          IsLoading="@IsLoading"
          OpenErrorMessage="@OpenErrorMessage"
          IsNodeSelected="node => IsNodeSelected(Original(node))"
          IsNodeExpanded="node => IsNodeExpanded(Original(node))"
          NodeClass="node => NodeClass(Original(node))"
          IsFolderOpening="node => IsFolderOpening(Original(node))"
          OnNodeSelected="node => OnNodeSelected.InvokeAsync(Original(node))"
          OnOpenFolder="node => OnOpenFolder.InvokeAsync(Original(node))" />

@code {
    private readonly Dictionary<string, KnowledgeMenuNode> _originals = new(StringComparer.Ordinal);

    [Parameter]
    public string HeadingLabel { get; set; } = "Knowledge";

    [Parameter]
    public KnowledgeMenuNode? RootFolder { get; set; }

    [Parameter]
    public IReadOnlyList<KnowledgeMenuNode> Nodes { get; set; } = [];

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? OpenErrorMessage { get; set; }

    [Parameter]
    public Func<KnowledgeMenuNode, bool> IsNodeSelected { get; set; } = static _ => false;

    [Parameter]
    public Func<KnowledgeMenuNode, bool> IsNodeExpanded { get; set; } = static _ => false;

    [Parameter]
    public Func<KnowledgeMenuNode, string> NodeClass { get; set; } = static _ => "knowledge-menu__item";

    [Parameter]
    public Func<KnowledgeMenuNode, bool> IsFolderOpening { get; set; } = static _ => false;

    [Parameter]
    public EventCallback<KnowledgeMenuNode> OnNodeSelected { get; set; }

    [Parameter]
    public EventCallback<KnowledgeMenuNode> OnOpenFolder { get; set; }

    private TreeNode? RootTreeNode { get; set; }

    private IReadOnlyList<TreeNode> TreeNodes { get; set; } = [];

    protected override void OnParametersSet()
    {
        _originals.Clear();
        RootTreeNode = RootFolder is null ? null : Map(RootFolder, "root");
        TreeNodes = [.. Nodes.Select((node, index) => Map(node, index.ToString()))];
    }

    private TreeNode Map(KnowledgeMenuNode node, string id)
    {
        _originals[id] = node;

        return new TreeNode(
            id,
            node.Label,
            node.Kind switch
            {
                KnowledgeMenuNodeKind.Folder => TreeNodeKind.Folder,
                KnowledgeMenuNodeKind.Message => TreeNodeKind.Message,
                _ => TreeNodeKind.Item
            },
            node.Available,
            node.Message,
            [.. node.Children.Select((child, index) => Map(child, $"{id}/{index}"))]);
    }

    private KnowledgeMenuNode Original(TreeNode node) =>
        _originals.TryGetValue(node.Id, out var original)
            ? original
            : new KnowledgeMenuNode(node.Id, node.Label, node.Id, KnowledgeMenuNodeKind.Message, string.Empty, [], node.Available, node.Message);
}
