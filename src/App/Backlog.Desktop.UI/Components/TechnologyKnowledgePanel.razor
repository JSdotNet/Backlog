@implements IDisposable
@inject TechnologyKnowledgeService TechnologyKnowledge

<aside class="knowledge-pane tech-knowledge-pane" data-testid="technology-knowledge-panel" aria-labelledby="technology-knowledge-title">
    @if (_view is null)
    {
        <p class="knowledge-empty" role="status">Loading technology knowledge...</p>
    }
    else if (!_view.Available)
    {
        <header class="knowledge-pane__header">
            <p class="knowledge-pane__eyebrow">Knowledge base</p>
            <h2 id="technology-knowledge-title">Technology</h2>
        </header>
        <div class="knowledge-empty" role="status"><p>@_view.Summary</p><a href="settings">Open repository settings</a></div>
    }
    else
    {
        <header class="knowledge-pane__header">
            <p class="knowledge-pane__eyebrow">Knowledge base</p>
            <h2 id="technology-knowledge-title">@_view.Title</h2>
            <p class="knowledge-pane__source">
                @if (_view.Location.Repository is { } repository)
                {
                    <span>@repository.FullName</span>
                }
                @if (_view.Location.FullPath is { } path)
                {
                    <code>@path</code>
                }
            </p>
        </header>

        <p class="knowledge-pane__subtitle">@_view.Summary</p>

        <section class="tech-stats" aria-label="Technology graph summary">
            <div class="tech-stat">
                <span class="tech-stat__value">@NodeCount</span>
                <span class="tech-stat__label">Technologies</span>
            </div>
            <div class="tech-stat">
                <span class="tech-stat__value">@RelationshipCount</span>
                <span class="tech-stat__label">Depends-on edges</span>
            </div>
            <div class="tech-stat">
                <span class="tech-stat__value">@_view.Layers.Count</span>
                <span class="tech-stat__label">Layers</span>
            </div>
        </section>

        @if (_view.Diagrams.Count > 0)
        {
            <DiagramView Language="@_view.Diagrams[0].Language" Source="@_view.Diagrams[0].Source" />
        }

        <section class="tech-layer-tabs" aria-label="Technology layers">
            @foreach (var layer in _view.Layers)
            {
                <button type="button"
                        class="tech-layer-tab @(ReferenceEquals(layer, ActiveLayer) ? "tech-layer-tab--active" : string.Empty)"
                        aria-pressed="@(ReferenceEquals(layer, ActiveLayer) ? "true" : "false")"
                        @onclick="() => _activeLayerFile = layer.FileName">
                    <span>@LayerLabel(layer)</span>
                    <span class="tech-layer-tab__count">@layer.Nodes.Count</span>
                </button>
            }
        </section>

        @if (ActiveLayer is { } activeLayer)
        {
            <section class="tech-layer" aria-label="@activeLayer.Title">
                <header class="tech-layer__header">
                    <div>
                        <h3>@activeLayer.Title</h3>
                        <p>@activeLayer.FileName</p>
                    </div>
                    <span class="badge badge--status">@activeLayer.Metadata.Status</span>
                </header>

                <div class="tech-node-grid">
                    @foreach (var node in activeLayer.Nodes)
                    {
                        <article class="tech-node tech-node--@node.Status" data-testid="technology-node">
                            <header class="tech-node__header">
                                <div>
                                    <h4>@node.Label</h4>
                                    <p>@node.Description</p>
                                </div>
                                <span class="tech-node__kind">@node.Kind</span>
                            </header>

                            <div class="tech-node__meta">
                                <span class="badge badge--status">@node.Status</span>
                                @if (!string.IsNullOrWhiteSpace(node.Metadata.Version))
                                {
                                    <span class="badge">@node.Metadata.Version</span>
                                }
                            </div>

                            @if (node.DependsOn.Count > 0)
                            {
                                <div class="tech-node__relations">
                                    <span>Depends on</span>
                                    <div>
                                        @foreach (var dependency in node.DependsOn)
                                        {
                                            <a href="@ReferenceHref(dependency)" class="relation-chip">@ReferenceLabel(dependency)</a>
                                        }
                                    </div>
                                </div>
                            }

                            @if (node.Related.Count > 0)
                            {
                                <div class="tech-node__relations">
                                    <span>Related</span>
                                    <div>
                                        @foreach (var related in node.Related)
                                        {
                                            <a href="@ReferenceHref(related)" class="relation-chip relation-chip--muted">@ReferenceLabel(related)</a>
                                        }
                                    </div>
                                </div>
                            }
                        </article>
                    }
                </div>
            </section>
        }
    }
</aside>

@code {
    private TechnologyKnowledgeView? _view;
    private string? _activeLayerFile;
    private string? _loadedRepositoryAlias;

    [Parameter]
    public string? RepositoryAlias { get; set; }

    private TechnologyLayer? ActiveLayer => _view?.Layers.FirstOrDefault(layer => layer.FileName == _activeLayerFile) ?? _view?.Layers.FirstOrDefault();

    private int NodeCount => _view?.Layers.Sum(layer => layer.Nodes.Count) ?? 0;

    private int RelationshipCount => _view?.Relationships.Count ?? 0;

    protected override void OnInitialized()
    {
        TechnologyKnowledge.Changed += OnKnowledgeChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_view is null || !string.Equals(_loadedRepositoryAlias, RepositoryAlias, StringComparison.Ordinal))
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _view = await TechnologyKnowledge.ReadAsync(RepositoryAlias);
        _loadedRepositoryAlias = RepositoryAlias;
        if (_view.Layers.All(layer => layer.FileName != _activeLayerFile))
        {
            _activeLayerFile = _view.Layers.FirstOrDefault()?.FileName;
        }
    }

    private async void OnKnowledgeChanged()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private static string LayerLabel(TechnologyLayer layer) => layer.Title.EndsWith(" Technologies", StringComparison.OrdinalIgnoreCase)
        ? layer.Title[..^" Technologies".Length]
        : layer.Title.EndsWith(" Stack", StringComparison.OrdinalIgnoreCase)
            ? layer.Title[..^" Stack".Length]
            : layer.Title;

    private static string ReferenceLabel(string reference)
    {
        var label = reference[(reference.LastIndexOf('#') + 1)..];
        if (label.Length == reference.Length) label = Path.GetFileNameWithoutExtension(reference);
        return string.Join(' ', label.Split('-', StringSplitOptions.RemoveEmptyEntries).Select(word => char.ToUpperInvariant(word[0]) + word[1..]));
    }

    private static string ReferenceHref(string reference) => reference.StartsWith(".", StringComparison.Ordinal)
        ? reference.Replace('\\', '/')
        : reference;

    public void Dispose()
    {
        TechnologyKnowledge.Changed -= OnKnowledgeChanged;
    }
}