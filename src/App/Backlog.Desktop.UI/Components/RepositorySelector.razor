<label class="metadata-editor metadata-editor--repo badge badge--area" data-testid="@TestId">
    <span class="sr-only">@Label</span>
    <select class="metadata-editor__select"
            value="@CurrentValue"
            aria-label="@Label"
            title="@Label"
            disabled="@Disabled"
            @onchange="OnChange">
        @if (IncludeEmptyOption)
        {
            <option value="">@EmptyLabel</option>
        }
        @foreach (var option in Options)
        {
            <option value="@option.Value">@option.Label</option>
        }
    </select>
</label>

@code {
    [Parameter]
    public string? CurrentValue { get; set; }

    [Parameter]
    public IReadOnlyList<SelectorOption> Options { get; set; } = [];

    [Parameter]
    public string Label { get; set; } = "Change repository";

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool IncludeEmptyOption { get; set; } = true;

    [Parameter]
    public string EmptyLabel { get; set; } = "No repo";

    [Parameter]
    public EventCallback<string?> OnChanged { get; set; }

    private Task OnChange(ChangeEventArgs e) => OnChanged.InvokeAsync(e.Value?.ToString());
}
