@*
    The app's error line, kept as its own component so existing call sites and
    their markup do not change. The rendering now lives in the shared library.
*@

<Alert Message="@Message" Role="@Role" TestId="@TestId" CssClass="@CssClass" />

@code {
    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public string Role { get; set; } = "alert";

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public string? CssClass { get; set; }
}
