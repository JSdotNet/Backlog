<figure class="diagram-view" data-testid="diagram-view">
    <figcaption class="diagram-view__header">
        <span class="diagram-view__title">@Title</span>
        <span class="diagram-view__language">@Language</span>
    </figcaption>
    <div class="diagram-view__canvas" role="img" aria-label="@AriaLabel">
        <pre class="diagram-view__source"><code>@Source</code></pre>
    </div>
</figure>

@code {
    [Parameter]
    public string Title { get; set; } = "Diagram";

    [Parameter]
    public string Language { get; set; } = "mermaid";

    [Parameter, EditorRequired]
    public string Source { get; set; } = string.Empty;

    private string AriaLabel => $"{Title} diagram source rendered in a reusable visualization panel";
}
