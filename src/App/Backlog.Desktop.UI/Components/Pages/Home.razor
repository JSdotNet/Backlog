@page "/"
@implements IDisposable
@inject BacklogDesktopState State
@inject IJSRuntime JS
@inject ICopilotToolService CopilotTools
@inject GitHubIntegration GitHub
@inject AppFeatureSettingsStore Features
@inject IAppUpdateService Updates
@inject IAzureFoundryChatClient AzureFoundryChat
@inject KnowledgeMenu KnowledgeMenu

@*
    One entry is one block of markdown. Not focused, it reads as a document;
    focused, it is the raw text. Nothing in between, and no field-level form
    control anywhere — see BacklogDesktopState and EntryTextParser.
*@

<div class="shell shell--wide">
    <header class="app-header">
        <h1>Backlog</h1>

        @* The version is the control: clicking it asks for a newer one. There is no
           separate button, and it stays clickable on heads that do not manage their
           own updates so the answer is a stated reason rather than nothing. *@
        <div class="app-header__version">
            <button type="button"
                    class="app-version"
                    data-testid="app-version"
                    disabled="@_updateBusy"
                    title="@AppUpdatePresentation.CheckLabel(_checkingForAppUpdate)"
                    aria-label="@AppUpdatePresentation.VersionActionLabel(Updates.CurrentVersion, _checkingForAppUpdate)"
                    @onclick="CheckForUpdatesAsync">
                Version <code>@Updates.CurrentVersion</code>
                <span class="app-version__hint" aria-hidden="true">@AppUpdatePresentation.CheckLabel(_checkingForAppUpdate)</span>
            </button>
            @if (_appUpdateReady)
            {
                <button type="button"
                        class="header-tool-toggle"
                        data-testid="install-update"
                        disabled="@_updateBusy"
                        @onclick="InstallUpdateAsync">
                    @(_installingAppUpdate ? "Installing..." : "Install update")
                </button>
            }
            @if (_appUpdateMessage is not null)
            {
                <span class="@_appUpdateStatusClass" data-testid="app-update-status" role="status">@_appUpdateMessage</span>
            }
        </div>
        <div class="save-indicator save-indicator--@State.SaveState.ToString().ToLowerInvariant()" id="save-state-indicator" data-testid="save-state-indicator" role="status">
            <span class="save-indicator__dot" aria-hidden="true"></span>
            @State.SaveStateLabel
        </div>

        @* Monitoring is a deliberate act, not a background poll: the backlog has
           to open instantly and offline, so nothing here waits on GitHub until
           somebody asks it to. *@
        @if (IsFeatureEnabled(AppFeatureSettingsStore.GitHubIntegration) && State.GitHubConfigured && State.HasLinkedRows)
        {
            <button type="button"
                    class="icon-link"
                    id="github-sync-button"
                    data-testid="github-sync-button"
                    disabled="@State.GitHubSyncing"
                    title="Check GitHub for issue and pull request updates"
                    aria-label="Check GitHub for issue and pull request updates"
                    @onclick="() => State.SyncGitHubAsync()">
                @(State.GitHubSyncing ? "…" : "⟳")
            </button>
        }

        @if (IsFeatureEnabled(AppFeatureSettingsStore.RepositoryKnowledge) && VisibleKnowledgeAreas.Count > 0)
        {
            <button type="button"
                    class="header-tool-toggle"
                    id="knowledge-toggle-button"
                    data-testid="knowledge-toggle-button"
                    aria-controls="repository-knowledge-pane"
                    aria-expanded="@(_knowledgeExpanded ? "true" : "false")"
                    @onclick="ToggleKnowledgePane">
                @(_knowledgeExpanded ? "Hide knowledge" : "Show knowledge")
            </button>
        }
        @if (IsFeatureEnabled(AppFeatureSettingsStore.AiAssistant))
        {
            <button type="button"
                    class="header-tool-toggle"
                    id="ai-toggle-button"
                    data-testid="ai-toggle-button"
                    aria-controls="ai-assistant-panel"
                    aria-expanded="@_aiExpanded"
                    @onclick="ToggleAiPanel">
                Ask AI
            </button>
        }
        @if (IsFeatureEnabled(AppFeatureSettingsStore.SystemTools))
        {
            <button type="button"
                    class="header-tool-toggle"
                    id="tools-toggle-button"
                    data-testid="tools-toggle-button"
                    aria-controls="tools-pane"
                    aria-expanded="@(ToolsVisible ? "true" : "false")"
                    @onclick="OnToolsToggleAsync">
                Tools
            </button>
        }

        @if (IsFeatureEnabled(AppFeatureSettingsStore.FeedbackReporting))
        {
            <button type="button"
                    class="header-tool-toggle"
                    id="feedback-button"
                    data-testid="feedback-button"
                    aria-haspopup="dialog"
                    @onclick="OpenFeedbackDialog">
                Report issue
            </button>
        }

        <a class="icon-link" href="settings" id="settings-link" data-testid="settings-link" title="Settings" aria-label="Settings">⚙</a>
    </header>

    @if (IsFeatureEnabled(AppFeatureSettingsStore.FeedbackReporting) && _feedbackOpen)
    {
        <div class="feedback-backdrop" role="presentation">
            <section class="feedback-dialog" role="dialog" aria-modal="true" aria-labelledby="feedback-title" aria-describedby="feedback-description" data-testid="feedback-dialog">
                <header class="feedback-dialog__header">
                    <div>
                        <p class="feedback-dialog__eyebrow">GitHub feedback</p>
                        <h2 id="feedback-title">Report an issue</h2>
                    </div>
                    <button type="button" class="btn btn--ghost btn--icon" aria-label="Close feedback dialog" disabled="@_feedbackSubmitting" @onclick="CloseFeedbackDialog">x</button>
                </header>
                <p id="feedback-description" class="feedback-dialog__description">Send a Desktop app issue to JSdotNet/Backlog. Add where on the current screen it happens; the app will ask which screen to capture when you submit.</p>
                <label class="feedback-field" for="feedback-screen-area-input">
                    <span>Screen area</span>
                    <input id="feedback-screen-area-input" data-testid="feedback-screen-area-input" value="@_feedbackScreenArea" @oninput="OnFeedbackScreenAreaInput" maxlength="120" placeholder="For example: header, backlog list, settings repositories" disabled="@_feedbackSubmitting" />
                </label>
                <label class="feedback-field" for="feedback-title-input">
                    <span>Title</span>
                    <input id="feedback-title-input" data-testid="feedback-title-input" value="@_feedbackTitle" @oninput="OnFeedbackTitleInput" maxlength="120" disabled="@_feedbackSubmitting" />
                </label>

                <label class="feedback-field" for="feedback-details-input">
                    <span>Details</span>
                    <textarea id="feedback-details-input" data-testid="feedback-details-input" value="@_feedbackDetails" @oninput="OnFeedbackDetailsInput" rows="6" disabled="@_feedbackSubmitting"></textarea>
                </label>

                @if (_feedbackMessage is not null)
                {
                    <p class="@FeedbackStatusClass" role="@FeedbackStatusRole">@_feedbackMessage</p>
                }

                <footer class="feedback-dialog__actions">
                    <button type="button" class="btn btn--ghost" disabled="@_feedbackSubmitting" @onclick="CloseFeedbackDialog">Cancel</button>
                    <button type="button" class="btn btn--primary" data-testid="feedback-submit" disabled="@(_feedbackSubmitting || string.IsNullOrWhiteSpace(_feedbackTitle))" @onclick="SubmitFeedbackAsync">
                        @(_feedbackSubmitting ? "Sending..." : "Create GitHub issue")
                    </button>
                </footer>
            </section>
        </div>
    }

    @if (IsFeatureEnabled(AppFeatureSettingsStore.AiAssistant) && _aiExpanded)
    {
        <section class="ai-panel" id="ai-assistant-panel" data-testid="ai-assistant-panel" aria-labelledby="ai-assistant-title">
            <div class="ai-panel__header">
                <div>
                    <p class="ai-panel__eyebrow">Azure Foundry</p>
                    <h2 id="ai-assistant-title">Ask about this content</h2>
                </div>
                <a class="ai-panel__settings" href="settings">Settings</a>
            </div>
            <p class="ai-panel__body">
                The question is answered from the entries currently in view and loaded backlog knowledge.
            </p>
            <textarea class="ai-panel__question"
                      data-testid="ai-question-input"
                      rows="3"
                      placeholder="What should I focus on next?"
                      value="@_aiQuestion"
                      @oninput="e => _aiQuestion = e.Value?.ToString() ?? string.Empty"
                      @onkeydown="OnAiQuestionKeyDownAsync"></textarea>
            <div class="ai-panel__actions">
                <button type="button"
                        class="btn btn--secondary"
                        data-testid="ai-ask-button"
                        disabled="@_aiBusy"
                        @onclick="AskAiAsync">
                    @(_aiBusy ? "Asking..." : "Ask")
                </button>
            </div>
            @if (_aiError is not null)
            {
                <p class="ai-panel__error" data-testid="ai-error" role="alert">@_aiError</p>
            }
            @if (_aiAnswer is not null)
            {
                <article class="ai-panel__answer" data-testid="ai-answer">
                    <h3>Answer</h3>
                    <p>@_aiAnswer</p>
                </article>
            }
        </section>
    }

    <main class="knowledge-layout @(SidePaneVisible ? "knowledge-layout--side-open" : "knowledge-layout--side-closed")" style="--knowledge-panel-width: @_knowledgePanelWidthRem.ToString(System.Globalization.CultureInfo.InvariantCulture)rem" data-testid="knowledge-layout">
        <section class="backlog-workspace" aria-label="Backlog entries">

    @* Areas on the left, because that is what you pick first — which pile am I
       in. Status narrows what is already in view, so it sits on the right. *@
    <div class="filter-bar">
        <div class="filter-group filter-group--areas" role="radiogroup" aria-label="Filter by area">
            @foreach (var area in State.AreaFilters)
            {
                <button type="button"
                        class="chip chip--filter @(State.SelectedArea == area.Value ? "chip--active" : string.Empty)"
                        data-testid="area-filter-option"
                        role="radio"
                        aria-checked="@(State.SelectedArea == area.Value ? "true" : "false")"
                        @onclick="() => State.SetAreaFilter(area.Value)">
                    @area.Label<span class="chip__count">@area.Count</span>
                </button>
            }
        </div>

        <div class="filter-group filter-group--status" role="radiogroup" aria-label="Filter by status">
            @foreach (var filter in State.StatusFilters)
            {
                <button type="button"
                        class="chip chip--filter @(State.SelectedStatusFilterWire == filter.Wire ? "chip--active" : string.Empty)"
                        id="status-filter-@(string.IsNullOrEmpty(filter.Wire) ? "all" : filter.Wire)"
                        data-testid="status-filter-option"
                        role="radio"
                        aria-checked="@(State.SelectedStatusFilterWire == filter.Wire ? "true" : "false")"
                        @onclick="() => OnFilterChanged(filter.Wire)">
                    @filter.Label
                </button>
            }
        </div>
    </div>

    @if (State.FilteredRows.Count == 0)
    {
        <div class="empty-state" data-testid="empty-state">
            <p class="empty-state__title">Nothing here yet.</p>
            <p class="empty-state__body">Write your first entry to start triaging the backlog.</p>
        </div>
    }
    else
    {
        <ul id="entry-list" data-testid="entry-list" class="entry-list @(State.DraggedRow is null ? string.Empty : "entry-list--dragging")">
            @foreach (var row in State.FilteredRows)
            {
                var editing = ReferenceEquals(State.EditingRow, row);
                var oneLine = !editing && row.UsesOneLineLayout;

                <li class="entry-group" @key="row.Key">
                <div class="entry-doc status-accent--@row.PreviewStatus.ToString().ToLowerInvariant() @(editing ? "entry-doc--editing" : string.Empty) @(oneLine ? "entry-doc--one-line" : string.Empty) @(row.IsReadOnly ? "entry-doc--read-only" : string.Empty) @(ReferenceEquals(State.DraggedRow, row) ? "entry-doc--dragged" : string.Empty) @(row.JustSaved ? "entry-doc--saved-flash" : string.Empty)">

                    @RenderGrip(row, before: true, "top")
                    @RenderGrip(row, before: true, "left")

                    @* A 12px rail is a fine thing to grab and a miserable thing
                       to hit. While a drag is in flight the whole card becomes
                       the target, split into a top half that drops above and a
                       bottom half that drops below. *@
                    @if (State.DraggedRow is not null && !ReferenceEquals(State.DraggedRow, row))
                    {
                        <div class="entry-doc__drops" aria-hidden="true">
                            <div class="entry-doc__drop entry-doc__drop--before"
                                 data-testid="entry-drop-before"
                                 data-drop-zone="@row.Key"
                                 @ondragenter:preventDefault="true"
                                 @ondragover:preventDefault="true"
                                 @ondrop="() => State.DropAsync(row, true)"></div>
                            <div class="entry-doc__drop entry-doc__drop--after"
                                 data-testid="entry-drop-after"
                                 data-drop-zone="@row.Key"
                                 @ondragenter:preventDefault="true"
                                 @ondragover:preventDefault="true"
                                 @ondrop="() => State.DropAsync(row, false)"></div>
                        </div>
                    }

                    <div class="entry-doc__body">
                        @if (editing || oneLine)
                        {
                            @RenderEntryMetadata(row, oneLine)
                        }

                        @if (IsFeatureEnabled(AppFeatureSettingsStore.GitHubIntegration) && row.GitHubError is not null)
                        {
                            <p class="entry-doc__gh-error" data-testid="github-error" role="status">@row.GitHubError</p>
                        }

                        @if (IsFeatureEnabled(AppFeatureSettingsStore.CopilotCli) && row.CopilotError is not null)
                        {
                            <p class="entry-doc__gh-error" data-testid="copilot-cli-error" role="status">@row.CopilotError</p>
                        }
                        @if (editing)
                        {
                            <div class="grow-wrap" data-replicated-value="@(State.EntryEditText(row) + "\n")">
                                <textarea class="entry-doc__editor"
                                          id="entry-raw-@row.Key"
                                          data-testid="entry-raw-input"
                                          aria-label="Entry markdown"
                                          placeholder="@BacklogDesktopState.NewEntryPlaceholder"
                                          @ref="_editor"
                                          @oninput="e => State.OnRawTextInput(row, e.Value?.ToString() ?? string.Empty)"
                                          @onkeydown="e => OnEditorKeyDownAsync(row, e)"
                                          @onfocus="() => FocusTextEntry(row)"
                                          @onblur="() => OnEditorBlurAsync(row)">@State.EntryEditText(row)</textarea>

                                @* Answers "which one is the status?" by simply
                                   saying so, live, from the same parse the save
                                   will use. *@
                                <p class="entry-doc__reading" data-testid="entry-meta-reading">
                                    <span class="entry-doc__reading-lead">reads as</span>
                                    @foreach (var reading in row.MetaReadings)
                                    {
                                        <span class="entry-doc__reading-item @(reading.Explicit ? string.Empty : "entry-doc__reading-item--default") @(reading.Note is null ? string.Empty : "entry-doc__reading-item--refused")">
                                            <span class="entry-doc__reading-kind">@reading.Kind</span>
                                            <span class="entry-doc__reading-value">@reading.Value</span>
                                            @if (reading.Note is not null)
                                            {
                                                <span class="entry-doc__reading-note">@reading.Note</span>
                                            }
                                        </span>
                                    }
                                </p>
                            </div>
                        }
                        else
                        {
                            <div class="entry-doc__read"
                                 id="entry-content-@row.Key"
                                 data-testid="entry-read-view"
                                 role="group"
                                 tabindex="0"
                                 aria-label="@(row.IsReadOnly
                                     ? $"Read-only entry from {row.Origin!.RepositoryFullName}: {(string.IsNullOrWhiteSpace(row.PreviewTitle) ? "untitled entry" : row.PreviewTitle)}"
                                     : $"Edit markdown for {(string.IsNullOrWhiteSpace(row.PreviewTitle) ? "untitled entry" : row.PreviewTitle)}")"
                                 @onclick="() => State.BeginEdit(row)"
                                 @onkeydown="e => OnReadViewKeyDown(row, e)">

                                <div class="entry-doc__title-line">

                                    @if (row.HasExpandableContent)
                                    {
                                        <button type="button"
                                                class="entry-doc__title-toggle"
                                                id="fold-entry-@row.Key"
                                                data-testid="entry-fold-button"
                                                aria-expanded="@(row.EntryCollapsed ? "false" : "true")"
                                                aria-controls="entry-content-@row.Key"
                                                aria-label="@(row.EntryCollapsed ? "Show entry details" : "Collapse entry to one line")"
                                                @onmousedown:preventDefault="true"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => State.ToggleEntry(row)">
                                            @if (string.IsNullOrWhiteSpace(row.PreviewTitle))
                                            {
                                                <span class="entry-doc__title entry-doc__title--empty">Untitled</span>
                                            }
                                            else
                                            {
                                                <span class="entry-doc__title" data-testid="entry-title">@row.PreviewTitle</span>
                                            }
                                            <span class="entry-doc__fold-chevron @(row.EntryCollapsed ? string.Empty : "entry-doc__fold-chevron--open")" aria-hidden="true">▸</span>
                                        </button>
                                    }
                                    else if (string.IsNullOrWhiteSpace(row.PreviewTitle))
                                    {
                                        <p class="entry-doc__title entry-doc__title--empty">Untitled</p>
                                    }
                                    else
                                    {
                                        <p class="entry-doc__title" data-testid="entry-title">@row.PreviewTitle</p>
                                    }
                                    @if (!oneLine)
                                    {
                                        @RenderEntryMetadata(row, oneLine)
                                    }
                                </div>

                                @if (!row.UsesOneLineLayout)
                                {
                                    <MarkdownView Blocks="row.PreviewBlocks" OnTaskItemToggled="index => State.ToggleTaskItemAsync(row, index)" />
                                }
                            </div>
                        }
                    </div>

                    @RenderGrip(row, before: false, "right")
                    @RenderGrip(row, before: false, "bottom")
                </div>

                @* Sub-items are items, not paragraphs: they sit below the entry,
                   indented under it, each one its own card that can be grabbed
                   and re-ranked. Folded away, the count on the entry still says
                   they are there. Parent editing is scoped to the parent chapter,
                   so sub-item cards remain visible below it. *@
                @if (row.PreviewSubItems.Count > 0 && !row.EntryCollapsed)
                {
                    <ul class="subitem-list @(ReferenceEquals(State.SubItemDragRow, row) ? "subitem-list--dragging" : string.Empty)"
                        id="subitems-@row.Key"
                        data-testid="subitem-list">
                        @for (var index = 0; index < row.PreviewSubItems.Count; index++)
                        {
                            var position = index;
                            var subItem = row.PreviewSubItems[position];
                            var editingSubItem = State.IsEditingSubItem(row, position);

                            <li class="subitem-card subitem-card--level-@subItem.Level @(subItem.Done ? "subitem-card--done" : string.Empty) @(editingSubItem ? "subitem-card--editing" : string.Empty) @(State.IsDraggingSubItem(row, position) ? "subitem-card--dragged" : string.Empty)"
                                @key="position"
                                data-testid="entry-subitem">

                                <button type="button"
                                        class="subitem-card__grip"
                                        id="subitem-grip-@row.Key-@position"
                                        data-testid="subitem-grip"
                                        data-drag-grip="@row.Key-@position"
                                        draggable="@(!row.IsReadOnly)"
                                        tabindex="@(row.IsReadOnly ? "-1" : "0")"
                                        aria-label="Reorder sub-item — drag, or use the up and down arrow keys"
                                        @ondragstart="() => State.BeginSubItemDrag(row, position)"
                                        @ondragend="() => State.EndSubItemDrag()"
                                        @ondragenter:preventDefault="true"
                                        @ondragover:preventDefault="true"
                                        @ondrop="() => State.DropSubItemAsync(row, position, true)"
                                        @onkeydown="e => OnSubItemGripKeyDownAsync(row, position, e)">
                                    <span class="subitem-card__grip-dots" aria-hidden="true"></span>
                                </button>

                                @if (editingSubItem && !row.IsReadOnly)
                                {
                                    <div class="subitem-card__body subitem-card__body--editing">
                                        <div class="grow-wrap" data-replicated-value="@(State.SubItemEditText(row, position) + "\n")">
                                            <textarea class="entry-doc__editor subitem-card__editor"
                                                      data-testid="subitem-raw-input"
                                                      aria-label="Sub-item markdown"
                                                      @ref="_editor"
                                                      @oninput="e => State.OnSubItemRawTextInput(row, position, e.Value?.ToString() ?? string.Empty)"
                                                      @onblur="() => OnSubItemEditorBlurAsync(row, position)">@State.SubItemEditText(row, position)</textarea>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="subitem-card__body"
                                         role="group"
                                         tabindex="@(row.IsReadOnly ? "-1" : "0")"
                                         aria-label="@(row.IsReadOnly ? "Read-only sub-item" : "Edit sub-item")"
                                         @onclick="() => State.BeginSubItemEdit(row, position)"
                                         @onkeydown="e => OnSubItemReadViewKeyDown(row, position, e)">
                                        <div class="subitem-card__title-row">
                                            @if (subItem.HasCheckbox)
                                            {
                                                <button type="button"
                                                        class="md-check subitem-card__check @(subItem.Done ? "md-check--done" : string.Empty)"
                                                        data-testid="subitem-checkbox"
                                                        aria-pressed="@(subItem.Done ? "true" : "false")"
                                                        aria-label="@(subItem.Done ? "Mark sub-item not done" : "Mark sub-item done")"
                                                        disabled="@row.IsReadOnly"
                                                        @onmousedown:preventDefault="true"
                                                        @onclick:stopPropagation="true"
                                                        @onclick="() => State.ToggleSubItemAsync(row, position)">@(subItem.Done ? "✔" : string.Empty)</button>
                                            }
                                            <h3 class="subitem-card__title">@MarkdownRender.Inlines(subItem.Title)</h3>
                                        </div>
                                        @RenderSubItemMetadata(row, subItem, position)
                                        @if (subItem.Children.Count > 0)
                                        {
                                            <div class="subitem-card__notes">
                                                <MarkdownView Blocks="subItem.Children" OnTaskItemToggled="index => State.ToggleTaskItemAsync(row, index)" />
                                            </div>
                                        }
                                    </div>
                                }
                                @* Same bargain as the entries: mid-drag the whole
                                   card is the target, top half drops above and
                                   bottom half below. *@
                                @if (ReferenceEquals(State.SubItemDragRow, row) && State.SubItemDragIndex != position)
                                {
                                    <div class="subitem-card__drops" aria-hidden="true">
                                        <div class="subitem-card__drop subitem-card__drop--before"
                                             data-testid="subitem-drop-before"
                                             data-drop-zone="@row.Key-@position"
                                             @ondragenter:preventDefault="true"
                                             @ondragover:preventDefault="true"
                                             @ondrop="() => State.DropSubItemAsync(row, position, true)"></div>
                                        <div class="subitem-card__drop subitem-card__drop--after"
                                             data-testid="subitem-drop-after"
                                             data-drop-zone="@row.Key-@position"
                                             @ondragenter:preventDefault="true"
                                             @ondragover:preventDefault="true"
                                             @ondrop="() => State.DropSubItemAsync(row, position, false)"></div>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                }
                </li>
            }
        </ul>
    }

    @* Creating an entry is the same gesture as writing in one, so the control
       sits where the next entry will actually appear rather than up in the
       chrome. *@
    <button type="button"
            class="entry-add"
            id="new-entry-button"
            data-testid="new-entry-button"
            @onclick="OnNewEntry">
        <span class="entry-add__plus" aria-hidden="true">+</span>
        New entry
    </button>
        </section>

        @if (SidePaneVisible)
        {
            @* The pane edge is the handle. Dragging it is the obvious gesture, so
               the slider that used to sit inside the pane is gone; arrow keys on
               the same separator carry the keyboard equivalent. *@
            <div class="pane-resizer"
                 data-testid="side-pane-resizer"
                 data-pane-resizer="true"
                 role="separator"
                 aria-orientation="vertical"
                 aria-label="Side pane width"
                 aria-valuemin="@MinSidePaneWidthRem"
                 aria-valuemax="@_maxSidePaneWidthRem.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                 aria-valuenow="@_knowledgePanelWidthRem.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                 tabindex="0"
                 @onkeydown="OnResizerKeyDown"
                 @onkeydown:preventDefault="true">
                <span class="pane-resizer__grip" aria-hidden="true"></span>
            </div>

            <aside class="side-pane-stack" data-testid="side-pane-stack" aria-label="Backlog side panes">
                @if (ToolsVisible)
                {
                    @RenderToolsPane()
                }

                @if (KnowledgeVisible)
                {
                    <section class="knowledge-stack" id="repository-knowledge-pane" data-testid="knowledge-stack" aria-label="Repository knowledge base">
                        @* Which repository is being read is not a second choice to
                           make here: it follows the area filter above the backlog,
                           so the knowledge beside an entry is the knowledge of the
                           repository that entry belongs to. *@
                        @if (ActiveKnowledgeRepository is { } knowledgeRepository)
                        {
                            <p class="knowledge-stack__repository" data-testid="knowledge-repository">@knowledgeRepository.FullName</p>
                        }

                <nav class="knowledge-stack__nav" aria-label="Knowledge sections" role="tablist">
                    @foreach (var area in VisibleKnowledgeAreas)
                    {
                        <button type="button"
                                class="knowledge-stack__nav-item @(IsKnowledgeSectionActive(area.Key) ? "knowledge-stack__nav-item--active" : string.Empty)"
                                role="tab"
                                aria-selected="@(IsKnowledgeSectionActive(area.Key) ? "true" : "false")"
                                aria-controls="knowledge-active-section"
                                @onclick="() => SelectKnowledgeSection(area.Key)">
                            @area.Label
                        </button>
                    }
                </nav>

                <div class="knowledge-stack__body @(KnowledgeSectionUsesMenu ? string.Empty : "knowledge-stack__body--without-menu")">
                    @if (KnowledgeSectionUsesMenu)
                    {
                        <nav class="knowledge-stack__menu" aria-label="Knowledge menu">
                        <div class="knowledge-stack__menu-heading">@(VisibleKnowledgeAreas.FirstOrDefault(area => IsKnowledgeSectionActive(area.Key))?.Label ?? "Knowledge")</div>
                        @if (_knowledgeMenuLoading)
                        {
                            <p class="knowledge-stack__menu-message">Loading knowledge menu...</p>
                        }
                        else if (ActiveKnowledgeMenuNodes.Count == 0)
                        {
                            <p class="knowledge-stack__menu-message">No chapters are available for this area.</p>
                        }
                        else
                        {
                            <ul class="knowledge-menu" role="tree" aria-label="Knowledge chapters">
                                @foreach (var node in ActiveKnowledgeMenuNodes)
                                {
                                    @RenderKnowledgeMenuNode(node, 0)
                                }
                            </ul>
                        }
                    </nav>
                    }

                    <div class="knowledge-stack__section" id="knowledge-active-section" role="tabpanel">
                        @RenderActiveKnowledge()
                    </div>
                </div>
                    </section>
                }
            </aside>
        }
    </main>
</div>

@code {
    private ElementReference _editor;
    private bool _toolsExpanded;
    private bool _aiExpanded;
    private bool _knowledgeExpanded;
    private double _knowledgePanelWidthRem = SidePaneWidth.DefaultRem;
    private double _maxSidePaneWidthRem = SidePaneWidth.MaxRem;
    private DotNetObjectReference<Home>? _selfReference;

    private const double MinSidePaneWidthRem = SidePaneWidth.MinRem;
    private bool _toolsLoading;
    private string? _toolMessage;
    private string? _toolActionKey;
    private IReadOnlyList<CopilotToolInfo> _tools = [];
    private KnowledgeMenuTree _knowledgeMenuTree = KnowledgeMenuTree.Empty;
    private readonly HashSet<string> _expandedKnowledgeMenuNodes = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _selectedKnowledgeChapterPaths = new(StringComparer.Ordinal);
    private bool _knowledgeMenuLoading;
    private string _selectedKnowledgeSection = KnowledgeAreas[0].Key;
    private string? _loadedKnowledgeMenuRepositoryAlias;
    private string _loadedKnowledgeMenuVisibleKeyFingerprint = string.Empty;
    private string? _appUpdateMessage;
    private string _appUpdateStatusClass = AppUpdatePresentation.StatusClass(AppUpdateAvailability.Unknown);
    private bool _checkingForAppUpdate;
    private bool _installingAppUpdate;
    private bool _appUpdateReady;
    private Guid? _textFocusedEntryKey;
    private bool _feedbackOpen;
    private bool _feedbackSubmitting;
    private bool _feedbackSucceeded;
    private string _feedbackTitle = string.Empty;
    private string _feedbackScreenArea = string.Empty;
    private string _feedbackDetails = string.Empty;
    private string? _feedbackMessage;
    private string _aiQuestion = string.Empty;
    private string? _aiAnswer;
    private string? _aiError;
    private bool _aiBusy;

    private bool _updateBusy => _checkingForAppUpdate || _installingAppUpdate;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += HandleStateChanged;
        await State.InitializeAsync();
        await RefreshKnowledgeMenuForActiveRepositoryAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfReference = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("backlogPaneResizer.initialize", _selfReference);
            }
            catch (Exception)
            {
                // Without the interop the separator still resizes by keyboard.
            }
        }

        // A sub-item that was just moved with the keyboard has to take the caret
        // with it, or the next press moves whatever slid into the old slot.
        if (State.SubItemFocus is { } focus)
        {
            State.ConsumeSubItemFocus();
            try
            {
                await JS.InvokeVoidAsync("backlogFocus", $"subitem-grip-{focus.Row.Key}-{focus.Index}");
            }
            catch (Exception)
            {
                // Losing the focus ring is not worth tearing down the page.
            }
        }

        if (!State.FocusPending || State.EditingRow is null) return;

        State.FocusPending = false;
        try
        {
            await _editor.FocusAsync();
        }
        catch (Exception)
        {
            // The editor can be gone again by the time this runs (a fast click
            // elsewhere); losing the caret is not worth tearing down the page.
        }
    }

    private bool ToolsVisible => IsFeatureEnabled(AppFeatureSettingsStore.SystemTools) && _toolsExpanded;

    private void ToggleAiPanel() => _aiExpanded = !_aiExpanded;

    private async Task AskAiAsync()
    {
        if (_aiBusy) return;

        _aiBusy = true;
        _aiError = null;
        _aiAnswer = null;

        try
        {
            var response = await AzureFoundryChat.AskAsync(new AzureFoundryChatRequest(BuildAiContent(), _aiQuestion));
            _aiAnswer = response.Answer;
        }
        catch (AzureFoundryException ex)
        {
            _aiError = ex.Message;
        }
        catch (HttpRequestException ex)
        {
            _aiError = $"Azure Foundry could not be reached: {ex.Message}";
        }
        catch (TaskCanceledException)
        {
            _aiError = "Azure Foundry did not answer before the request timed out.";
        }
        finally
        {
            _aiBusy = false;
        }
    }

    private Task OnAiQuestionKeyDownAsync(KeyboardEventArgs e) =>
        e.Key == "Enter" && (e.CtrlKey || e.MetaKey) ? AskAiAsync() : Task.CompletedTask;

    private string BuildAiContent()
    {
        var builder = new System.Text.StringBuilder();
        builder.AppendLine("Visible backlog entries:");
        foreach (var row in State.FilteredRows.Where(row => !row.IsUntouched))
        {
            builder.AppendLine("---");
            builder.AppendLine(row.RawText.Trim());
        }

        var content = builder.ToString().Trim();
        return content.Length <= 12000 ? content : content[..12000];
    }

    private bool KnowledgeVisible =>
        IsFeatureEnabled(AppFeatureSettingsStore.RepositoryKnowledge)
        && VisibleKnowledgeAreas.Count > 0
        && _knowledgeExpanded;

    private bool ToolActionBusy => _toolActionKey is not null;

    private bool CanUpdateAnyTool => _tools.Any(tool => tool.CanUpdate);

    private bool SidePaneVisible => ToolsVisible || KnowledgeVisible;

    private bool AdditionalRepositoriesEnabled => IsFeatureEnabled(AppFeatureSettingsStore.AdditionalRepositories);

    private IReadOnlyList<GitHubRepositoryRef> KnowledgeRepositories
    {
        get
        {
            if (AdditionalRepositoriesEnabled) return GitHub.Repositories;

            var repository = GitHub.Repositories.FirstOrDefault();
            return repository is null ? [] : [repository];
        }
    }

    private bool IsFeatureEnabled(string featureKey) => Features.IsEnabled(featureKey);
    private string FeedbackStatusClass => $"feedback-status {(_feedbackSucceeded ? "feedback-status--ok" : "feedback-status--error")}";

    private string FeedbackStatusRole => _feedbackSucceeded ? "status" : "alert";

    private void OpenFeedbackDialog()
    {
        _feedbackOpen = true;
        _feedbackSucceeded = false;
        _feedbackMessage = null;
    }

    private void CloseFeedbackDialog()
    {
        if (_feedbackSubmitting) return;

        _feedbackOpen = false;
        _feedbackSucceeded = false;
        _feedbackMessage = null;
    }

    private void OnFeedbackTitleInput(ChangeEventArgs e)
    {
        _feedbackTitle = e.Value?.ToString() ?? string.Empty;
        _feedbackSucceeded = false;
        _feedbackMessage = null;
    }

    private void OnFeedbackDetailsInput(ChangeEventArgs e)
    {
        _feedbackDetails = e.Value?.ToString() ?? string.Empty;
        _feedbackSucceeded = false;
        _feedbackMessage = null;
    }

    private void OnFeedbackScreenAreaInput(ChangeEventArgs e)
    {
        _feedbackScreenArea = e.Value?.ToString() ?? string.Empty;
        _feedbackSucceeded = false;
        _feedbackMessage = null;
    }

    private async Task SubmitFeedbackAsync()
    {
        if (string.IsNullOrWhiteSpace(_feedbackTitle))
        {
            _feedbackSucceeded = false;
            _feedbackMessage = "Add a short title before creating the issue.";
            return;
        }

        _feedbackSubmitting = true;
        _feedbackSucceeded = false;
        _feedbackMessage = "Capturing a screenshot...";

        GitHubFeedbackScreenshot? screenshot = null;
        string? screenshotError = null;

        try
        {
            screenshot = await JS.InvokeAsync<GitHubFeedbackScreenshot?>("backlogCaptureScreenshot");
            if (screenshot is null)
            {
                screenshotError = "No screenshot was captured.";
            }
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            screenshotError = ex.Message;
        }

        _feedbackMessage = "Creating the GitHub issue...";

        try
        {
            var link = await GitHub.ReportFeedbackAsync(_feedbackTitle, _feedbackDetails, _feedbackScreenArea, screenshot, screenshotError);
            _feedbackSucceeded = true;
            _feedbackMessage = $"Created {link.RepoFullName}{link.Label}.";
            _feedbackTitle = string.Empty;
            _feedbackScreenArea = string.Empty;
            _feedbackDetails = string.Empty;
        }
        catch (GitHubException ex)
        {
            _feedbackSucceeded = false;
            _feedbackMessage = ex.Message;
        }
        finally
        {
            _feedbackSubmitting = false;
        }
    }

    private IReadOnlyList<KnowledgeArea> VisibleKnowledgeAreas
    {
        get
        {
            if (!IsFeatureEnabled(AppFeatureSettingsStore.KnowledgeSections)) return [];

            return ActiveRepositoryInstructionsEnabled
                ? KnowledgeAreas
                : [.. KnowledgeAreas.Where(area => !string.Equals(area.Key, "instructions", StringComparison.Ordinal))];
        }
    }

    // The repository's own work items are no longer a section here — they are
    // entries in the backlog itself, filed under the repository's area.
    private static readonly KnowledgeArea[] KnowledgeAreas =
    [
        new("instructions", "Instructions"),
        new("domain", "Domain"),
        new("arc42", "Architecture"),
        new("tech", "Technology"),
        new("design", "Design")
    ];

    /// <summary>The area filter above the backlog doubles as the repository
    /// picker: filing entries under <c>`@alias`</c> is already how the app says
    /// which repository something belongs to.</summary>
    private GitHubRepositoryRef? ActiveKnowledgeRepository
    {
        get
        {
            if (!AdditionalRepositoriesEnabled)
            {
                return GitHub.Repositories.FirstOrDefault();
            }

            var area = State.SelectedArea;
            if (area.Length == 0 || string.Equals(area, BacklogDesktopState.UnfiledArea, StringComparison.Ordinal))
            {
                return GitHub.Repositories.FirstOrDefault();
            }

            return GitHub.Settings.Current.Find(area);
        }
    }

    private string? ActiveKnowledgeRepositoryAlias => ActiveKnowledgeRepository?.Alias;

    private bool ActiveRepositoryInstructionsEnabled
    {
        get
        {
            var repository = ActiveKnowledgeRepository;
            if (repository is null) return true;

            var instructions = KnowledgeFolderSetting.Normalize(repository.KnowledgeFolders)
                .FirstOrDefault(folder => string.Equals(folder.Key, "instructions", StringComparison.OrdinalIgnoreCase));
            return instructions?.Enabled != false;
        }
    }

    /// <summary>The section actually shown. A section can stop being available
    /// (instructions turned off for this repository), and a tab panel pointing at
    /// nothing is worse than one that has moved on to the next section.</summary>
    private string EffectiveKnowledgeSection
    {
        get
        {
            var areas = VisibleKnowledgeAreas;
            if (areas.Count == 0) return string.Empty;

            return areas.Any(area => string.Equals(area.Key, _selectedKnowledgeSection, StringComparison.Ordinal))
                ? _selectedKnowledgeSection
                : areas[0].Key;
        }
    }

    private bool IsKnowledgeSectionActive(string key) =>
        string.Equals(EffectiveKnowledgeSection, key, StringComparison.Ordinal);

    private IReadOnlyList<KnowledgeMenuNode> ActiveKnowledgeMenuNodes => ActiveKnowledgeMenuRoot switch
    {
        null => [],
        { Children.Count: > 0 } root => root.Children,
        var root => [root]
    };

    private KnowledgeMenuNode? ActiveKnowledgeMenuRoot =>
        _knowledgeMenuTree.Roots.FirstOrDefault(node => string.Equals(node.AreaKey, EffectiveKnowledgeSection, StringComparison.Ordinal));

    private bool KnowledgeSectionUsesMenu => !string.Equals(EffectiveKnowledgeSection, "tech", StringComparison.Ordinal);

    private string? SelectedKnowledgeChapterPath =>
        KnowledgeSectionUsesMenu && _selectedKnowledgeChapterPaths.TryGetValue(EffectiveKnowledgeSection, out var path) ? path : null;

    private void SelectKnowledgeSection(string key)
    {
        _selectedKnowledgeSection = key;
        if (KnowledgeSectionUsesMenu)
        {
            EnsureSelectedKnowledgeChapter();
        }
    }

    private void SelectKnowledgeMenuNode(KnowledgeMenuNode node)
    {
        if (!node.Available || node.Kind == KnowledgeMenuNodeKind.Message) return;

        _selectedKnowledgeSection = node.AreaKey;
        if (node.Kind == KnowledgeMenuNodeKind.File || !node.HasChildren)
        {
            _selectedKnowledgeChapterPaths[node.AreaKey] = node.Path;
            return;
        }

        var key = KnowledgeMenuNodeKey(node);
        if (!_expandedKnowledgeMenuNodes.Add(key))
        {
            _expandedKnowledgeMenuNodes.Remove(key);
        }
    }

    private bool IsKnowledgeMenuNodeExpanded(KnowledgeMenuNode node) => _expandedKnowledgeMenuNodes.Contains(KnowledgeMenuNodeKey(node));

    private static string KnowledgeMenuNodeKey(KnowledgeMenuNode node) => $"{node.AreaKey}:{node.Key}";

    private bool IsKnowledgeMenuNodeSelected(KnowledgeMenuNode node) =>
        string.Equals(SelectedKnowledgeChapterPath, node.Path, StringComparison.OrdinalIgnoreCase);

    private string KnowledgeMenuNodeClass(KnowledgeMenuNode node) => string.Join(' ', new[]
    {
        "knowledge-menu__item",
        node.Kind == KnowledgeMenuNodeKind.Folder ? "knowledge-menu__item--folder" : "knowledge-menu__item--file",
        IsKnowledgeMenuNodeSelected(node) ? "knowledge-menu__item--active" : null,
        !node.Available ? "knowledge-menu__item--unavailable" : null
    }.Where(value => value is not null));

    private RenderFragment RenderKnowledgeMenuNode(KnowledgeMenuNode node, int depth) => @<li class="knowledge-menu__node" role="none">
        @if (node.Kind == KnowledgeMenuNodeKind.Message)
        {
            <p class="knowledge-menu__message" role="treeitem" style="--knowledge-menu-depth: @depth">@node.Message</p>
        }
        else
        {
            var expanded = node.HasChildren ? IsKnowledgeMenuNodeExpanded(node) : (bool?)null;
            <button type="button"
                    class="@KnowledgeMenuNodeClass(node)"
                    role="treeitem"
                    aria-selected="@(IsKnowledgeMenuNodeSelected(node) ? "true" : "false")"
                    aria-expanded="@(node.HasChildren ? (IsKnowledgeMenuNodeExpanded(node) ? "true" : "false") : null)"
                    disabled="@(!node.Available)"
                    title="@node.Message"
                    style="--knowledge-menu-depth: @depth"
                    @onclick="() => SelectKnowledgeMenuNode(node)">
                @if (node.HasChildren)
                {
                    <span class="knowledge-menu__twisty" aria-hidden="true">@(IsKnowledgeMenuNodeExpanded(node) ? "-" : "+")</span>
                }
                else
                {
                    <span class="knowledge-menu__twisty" aria-hidden="true"></span>
                }
                <span class="knowledge-menu__label">@node.Label</span>
            </button>
            @if (node.HasChildren && IsKnowledgeMenuNodeExpanded(node))
            {
                <ul class="knowledge-menu__children" role="group">
                    @foreach (var child in node.Children)
                    {
                        @RenderKnowledgeMenuNode(child, depth + 1)
                    }
                </ul>
            }
        }
    </li>;

    private GitHubRepositoryRef? RepositoryFor(EntryRow row) =>
        AdditionalRepositoriesEnabled ? State.RepositoryFor(row) : GitHub.Repositories.FirstOrDefault();

    private async Task RefreshKnowledgeMenuForActiveRepositoryAsync()
    {
        if (!IsFeatureEnabled(AppFeatureSettingsStore.RepositoryKnowledge)) return;

        var repositoryAlias = ActiveKnowledgeRepositoryAlias;
        var visibleKeys = VisibleKnowledgeAreas.Select(area => area.Key).ToArray();
        var fingerprint = string.Join("|", visibleKeys);
        if (string.Equals(_loadedKnowledgeMenuRepositoryAlias, repositoryAlias, StringComparison.Ordinal)
            && string.Equals(_loadedKnowledgeMenuVisibleKeyFingerprint, fingerprint, StringComparison.Ordinal))
        {
            return;
        }

        await LoadKnowledgeMenuAsync(visibleKeys, repositoryAlias, fingerprint);
    }

    private async Task LoadKnowledgeMenuAsync(string[] visibleKeys, string? repositoryAlias, string fingerprint)
    {
        _knowledgeMenuLoading = true;
        try
        {
            _knowledgeMenuTree = await KnowledgeMenu.LoadAsync(visibleKeys, repositoryAlias);
            _loadedKnowledgeMenuRepositoryAlias = repositoryAlias;
            _loadedKnowledgeMenuVisibleKeyFingerprint = fingerprint;

            var selectedVisible = visibleKeys.Contains(_selectedKnowledgeSection, StringComparer.Ordinal);
            if (!selectedVisible && visibleKeys.Length > 0)
            {
                _selectedKnowledgeSection = visibleKeys[0];
            }

            foreach (var root in _knowledgeMenuTree.Roots)
            {
                _expandedKnowledgeMenuNodes.Add(KnowledgeMenuNodeKey(root));
            }

            EnsureSelectedKnowledgeChapter();
        }
        finally
        {
            _knowledgeMenuLoading = false;
        }
    }

    private void EnsureSelectedKnowledgeChapter()
    {
        var root = ActiveKnowledgeMenuRoot;
        if (root is null) return;

        var selectedPath = SelectedKnowledgeChapterPath;
        if (selectedPath is null || !ContainsPath(root, selectedPath))
        {
            var first = PreferredKnowledgeChapter(root) ?? FirstSelectableChapter(root);
            if (first is not null)
            {
                _selectedKnowledgeChapterPaths[root.AreaKey] = first.Path;
                selectedPath = first.Path;
            }
        }

        ExpandAncestorsToSelected(root.Children, selectedPath);
    }

    private void ExpandAncestorsToSelected(IEnumerable<KnowledgeMenuNode> nodes, string? selectedPath)
    {
        if (string.IsNullOrWhiteSpace(selectedPath)) return;

        foreach (var node in nodes.Where(node => node.HasChildren && ContainsPath(node, selectedPath)))
        {
            _expandedKnowledgeMenuNodes.Add(KnowledgeMenuNodeKey(node));
            ExpandAncestorsToSelected(node.Children, selectedPath);
        }
    }

    private static KnowledgeMenuNode? PreferredKnowledgeChapter(KnowledgeMenuNode root) => root.AreaKey switch
    {
        "domain" => FindSelectableChapter(root, "context-map.md"),
        _ => null
    };

    private static KnowledgeMenuNode? FindSelectableChapter(KnowledgeMenuNode node, string path)
    {
        if (node.Kind == KnowledgeMenuNodeKind.File && node.Available && string.Equals(node.Path, path, StringComparison.OrdinalIgnoreCase)) return node;

        foreach (var child in node.Children)
        {
            var selected = FindSelectableChapter(child, path);
            if (selected is not null) return selected;
        }

        return null;
    }

    private static KnowledgeMenuNode? FirstSelectableChapter(KnowledgeMenuNode node)
    {
        if (node.Kind == KnowledgeMenuNodeKind.File && node.Available) return node;

        foreach (var child in node.Children)
        {
            var selected = FirstSelectableChapter(child);
            if (selected is not null) return selected;
        }

        return node.Available && node.Kind != KnowledgeMenuNodeKind.Message ? node : null;
    }

    private static bool ContainsPath(KnowledgeMenuNode node, string selectedPath) =>
        string.Equals(node.Path, selectedPath, StringComparison.OrdinalIgnoreCase)
        || node.Children.Any(child => ContainsPath(child, selectedPath));

    private RenderFragment RenderActiveKnowledge() => EffectiveKnowledgeSection switch
    {
        "design" => @<DesignKnowledgeView RepositoryAlias="@ActiveKnowledgeRepositoryAlias" SelectedPath="@SelectedKnowledgeChapterPath" />,
        "arc42" => @<Arc42KnowledgePanel RepositoryAlias="@ActiveKnowledgeRepositoryAlias" SelectedPath="@SelectedKnowledgeChapterPath" />,
        "domain" => @<DomainKnowledgePanel Compact="true" RepositoryAlias="@ActiveKnowledgeRepositoryAlias" SelectedPath="@SelectedKnowledgeChapterPath" />,
        "tech" => @<TechnologyKnowledgePanel RepositoryAlias="@ActiveKnowledgeRepositoryAlias" />,
        "instructions" => @<InstructionsKnowledgePanel RepositoryAlias="@ActiveKnowledgeRepositoryAlias" SelectedPath="@SelectedKnowledgeChapterPath" />,
        _ => @<p class="knowledge-empty" role="status">Turn on knowledge sections in Settings to read repository knowledge here.</p>
    };

    private sealed record KnowledgeArea(string Key, string Label);

    private RenderFragment RenderToolsPane() =>
        @<section class="tools-panel" id="tools-pane" aria-labelledby="installed-tools-title" data-testid="tools-panel">
            <header class="tools-panel__header">
                <div>
                    <p class="tools-panel__eyebrow">System tools</p>
                    <h2 id="installed-tools-title" class="tools-panel__title">System tools</h2>
                    <p class="tools-panel__subtitle">Configured and disabled Copilot plugins, repository tools, and MCP servers.</p>
                </div>
                <div class="tools-panel__header-actions">
                    <span class="tools-panel__count">@(_tools.Count == 0 ? "Check tools" : $"{_tools.Count} tools")</span>
                    <button type="button" class="btn btn--ghost btn--icon" aria-label="Close tools pane" @onclick="OnToolsToggleAsync">✕</button>
                </div>
            </header>

            <div class="tools-panel__content" id="installed-tools-content">
                <div class="tools-panel__toolbar">
                    <p class="tools-panel__message" role="status">@(_toolMessage ?? "Checking configured tools...")</p>
                    <div class="tools-panel__toolbar-actions">
                        <button type="button" class="btn btn--secondary" disabled="@(_toolsLoading || ToolActionBusy)" @onclick="RefreshToolsAsync">
                            @(_toolsLoading ? "Checking..." : "Check for updates")
                        </button>
                        <button type="button" class="btn btn--primary" disabled="@(_toolsLoading || ToolActionBusy || !CanUpdateAnyTool)" @onclick="UpdateAllToolsAsync">
                            @(_toolActionKey == "__all__" ? "Updating..." : "Update all")
                        </button>
                    </div>
                </div>

                @if (_toolsLoading && _tools.Count == 0)
                {
                    <p class="tools-panel__empty">Loading installed tool versions.</p>
                }
                else if (_tools.Count == 0)
                {
                    <p class="tools-panel__empty">No configured tools were found.</p>
                }
                else
                {
                    <div class="tools-table" role="table" aria-label="Configured Copilot tools">
                        <div class="tools-table__row tools-table__row--head" role="row">
                            <span role="columnheader">Tool</span>
                            <span role="columnheader">Installed</span>
                            <span role="columnheader">Available</span>
                            <span role="columnheader">Actions</span>
                        </div>

                        @foreach (var tool in _tools)
                        {
                            <div class="tools-table__row @(tool.ConfiguredEnabled ? string.Empty : "tools-table__row--disabled")" role="row" @key="tool.Key">
                                <div role="cell" class="tools-table__tool">
                                    <strong>@tool.Name</strong>
                                    <span class="tools-table__meta">@Humanize(tool.Kind.ToString()) · @tool.Status</span>
                                </div>
                                <span role="cell" class="tools-table__version">@tool.InstalledVersion</span>
                                <span role="cell" class="tools-table__version @(tool.CanUpdate ? "tools-table__version--new" : string.Empty)">@tool.AvailableVersion</span>
                                <div role="cell" class="tools-table__actions">
                                    @if (tool.CanUpdate)
                                    {
                                        <button type="button"
                                                class="btn btn--secondary"
                                                disabled="@(_toolsLoading || ToolActionBusy)"
                                                @onclick="() => ApplyToolActionAsync(tool, CopilotToolAction.Update)">
                                            Update
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="tools-table__action-note">@(tool.ConfiguredEnabled ? "Up to date" : "Disabled")</span>
                                    }
                                    <button type="button"
                                            class="btn btn--ghost"
                                            disabled="@(_toolsLoading || ToolActionBusy)"
                                            @onclick="() => ApplyToolActionAsync(tool, tool.ConfiguredEnabled ? CopilotToolAction.Disable : CopilotToolAction.Enable)">
                                        @(tool.ConfiguredEnabled ? "Disable" : "Enable")
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>;


    private RenderFragment RenderEntryMetadata(EntryRow row, bool oneLine) =>
        @<div class="entry-doc__meta" @onclick:stopPropagation="true">
            <span class="entry-doc__meta-start">
                <label class="metadata-editor metadata-editor--type badge badge--type" data-testid="type-badge">
