                                {
                                    <span aria-hidden="true">…</span>
                                }
                                else
                                {
                                    <svg class="entry-doc__button-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                        <path d="M1.705 8a6.303 6.303 0 0 1 10.848-4.365L11.318 4.87a.75.75 0 0 0 .53 1.281h3.329a.75.75 0 0 0 .75-.75V2.073a.75.75 0 0 0-1.28-.53l-1.018 1.018A7.804 7.804 0 0 0 .204 8a.75.75 0 0 0 1.501 0Zm14.091 0a.75.75 0 0 0-1.501 0 6.303 6.303 0 0 1-10.848 4.365l1.235-1.235a.75.75 0 0 0-.53-1.281H.823a.75.75 0 0 0-.75.75v3.328a.75.75 0 0 0 1.28.53l1.018-1.018A7.804 7.804 0 0 0 15.796 8Z" />
                                    </svg>
