    private GitHubRepositoryRef? ActiveKnowledgeRepository =>
        KnowledgeRepositories.FirstOrDefault(repo => string.Equals(repo.Alias, _selectedKnowledgeRepositoryAlias, StringComparison.Ordinal))
        ?? GitHub.Settings.Current.PrimaryRepository
        ?? KnowledgeRepositories.FirstOrDefault();

    private string? ActiveKnowledgeRepositoryAlias => ActiveKnowledgeRepository?.Alias;

    private bool ActiveRepositoryInstructionsEnabled
    {
        get
        {
            var repository = ActiveKnowledgeRepository;
            if (repository is null) return true;

            var instructions = KnowledgeFolderSetting.Normalize(repository.KnowledgeFolders)
                .FirstOrDefault(folder => string.Equals(folder.Key, "instructions", StringComparison.OrdinalIgnoreCase));
            return instructions?.Enabled != false;
        }
    }

