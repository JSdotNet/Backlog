    private static IReadOnlyList<EntryType> TypeOptions() => Enum.GetValues<EntryType>();

    private static IReadOnlyList<Priority> PriorityOptions() => [Priority.Low, Priority.Medium, Priority.High];

    private static IReadOnlyList<EntryStatus> StatusOptions() => Enum.GetValues<EntryStatus>();

    private void FocusTextEntry(EntryRow row)
    {
        _textFocusedEntryKey = row.Key;
    }

    private void BlurTextEntry(EntryRow row)
    {
        if (_textFocusedEntryKey == row.Key)
        {
            _textFocusedEntryKey = null;
        }
    }

    private bool IsTextEntryFocused(EntryRow row) => _textFocusedEntryKey == row.Key;

    private IReadOnlyList<string> TagOptions(EntryRow row) =>
        State.Rows
            .SelectMany(existing => existing.PreviewMetadataTags)
            .Concat(row.PreviewMetadataTags)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(tag => tag, StringComparer.OrdinalIgnoreCase)
            .ToList();
    private static string TagsInputValue(EntryRow row) => string.Join(" ", row.PreviewMetadataTags.Select(tag => "#" + tag));

    private static string TagsInputValue(MdSubItem subItem) =>
        string.Join(" ", (subItem.MetadataTags ?? []).Select(tag => "#" + tag));

    private void OnKnowledgeWidthChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var width))
        {
            _knowledgePanelWidthRem = Math.Clamp(width, 24, 54);
        }
    }

    private async Task OnEditorKeyDownAsync(EntryRow row, KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await State.EndEditAsync(row);
    }

    private void OnReadViewKeyDown(EntryRow row, KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") State.BeginEdit(row);
    }

    private async Task OnGripKeyDownAsync(EntryRow row, KeyboardEventArgs e)
    {
        if (e.Key == "ArrowUp") await State.MoveAsync(row, -1);
        else if (e.Key == "ArrowDown") await State.MoveAsync(row, 1);
    }

    private async Task OnSubItemGripKeyDownAsync(EntryRow row, int index, KeyboardEventArgs e)
    {
        if (e.Key == "ArrowUp") await State.MoveSubItemAsync(row, index, -1);
        else if (e.Key == "ArrowDown") await State.MoveSubItemAsync(row, index, 1);
    }

    private static string Humanize(string enumName)
    {
        var text = System.Text.RegularExpressions.Regex.Replace(enumName, "(?<!^)([A-Z])", " $1");
        return text.ToLowerInvariant();
    }

    /// <summary>"never checked" is a real, distinct answer from "open" — the
    /// badge says so rather than implying a state nobody has verified.</summary>
    private static string GitHubStateLabel(GitHubItemState? state) => state switch
    {
        GitHubItemState.Open => "open",
        GitHubItemState.Draft => "draft",
        GitHubItemState.Merged => "merged",
        GitHubItemState.Closed => "closed",
        _ => "not checked"
    };

    private static string GitHubStateClass(GitHubItemState? state) =>
        state?.ToString().ToLowerInvariant() ?? "unknown";

    public void Dispose()
    {
        State.Changed -= HandleStateChanged;
    }
}
