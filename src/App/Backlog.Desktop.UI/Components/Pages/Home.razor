    private RenderFragment RenderBacklogKnowledge() =>
        @<aside class="knowledge-pane" data-testid="backlog-knowledge-pane" aria-labelledby="backlog-knowledge-title">
            <div class="knowledge-pane__header">
                <p class="knowledge-pane__eyebrow">Knowledge base</p>
                <h2 id="backlog-knowledge-title">.backlog work items</h2>
                <p class="knowledge-pane__subtitle">Repository-authored Items and Sub-items, shown beside the active backlog.</p>
            </div>

            @if (_backlogKnowledge is null)
            {
                <p class="knowledge-empty">Loading repository knowledge...</p>
            }
            else if (!_backlogKnowledge.IsReady)
            {
                <div class="knowledge-empty" role="status">
                    <p>@_backlogKnowledge.Message</p>
                    <a href="settings">Open repository settings</a>
                </div>
            }
            else if (_backlogKnowledge.Concerns.Count == 0)
            {
                <div class="knowledge-empty" role="status">
                    <p>No authored .backlog Markdown files were found.</p>
                    <span>@_backlogKnowledge.Directory</span>
                </div>
            }
            else
            {
                <div class="knowledge-pane__source">
                    <span>@_backlogKnowledge.RepositoryFullName</span>
                    <code>@_backlogKnowledge.Directory</code>
                </div>

                <div class="knowledge-concerns">
                    @foreach (var concern in _backlogKnowledge.Concerns)
                    {
                        <article class="knowledge-concern" data-testid="backlog-knowledge-concern">
                            <header class="knowledge-concern__header">
                                <div>
                                    <h3>@concern.Title</h3>
                                    <code>@concern.RelativePath</code>
                                </div>
                                <span class="knowledge-count">@concern.Items.Count item@(concern.Items.Count == 1 ? string.Empty : "s")</span>
                            </header>

                            @RenderKnowledgeMetadata(concern.Metadata)

                            <div class="knowledge-items">
                                @foreach (var item in concern.Items)
                                {
                                    @RenderKnowledgeItem(item, isSubItem: false)
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </aside>;
    private RenderFragment RenderKnowledgeItem(BacklogWorkItemKnowledge item, bool isSubItem) =>
        @<article class="knowledge-item @(isSubItem ? "knowledge-item--sub" : string.Empty)" data-testid="backlog-knowledge-item">
            <header class="knowledge-item__header">
                <h4>@item.Title</h4>
                @if (TryMetadata(item.Metadata, "status") is { Length: > 0 } status)
                {
                    <span class="badge badge--status status-accent--@status.ToLowerInvariant()">@status</span>
                }
            </header>

            @RenderKnowledgeMetadata(item.Metadata)

            @if (item.Description.Count > 0)
            {
                <div class="knowledge-item__body">
                    <MarkdownView Blocks="@item.Description" />
                </div>
            }

            @if (item.SubItems.Count > 0)
            {
                <div class="knowledge-subitems">
                    @foreach (var subItem in item.SubItems)
                    {
                        @RenderKnowledgeItem(subItem, isSubItem: true)
                    }
                </div>
            }
        </article>;

