@page "/"
@implements IDisposable
@inject BacklogDesktopState State
@inject IJSRuntime JS
@inject ICopilotToolService CopilotTools
@inject KnowledgeBacklog RepositoryBacklog
@inject GitHubIntegration GitHub
@inject AppFeatureSettingsStore Features
@inject IAppUpdateService Updates
@inject IAzureFoundryChatClient AzureFoundryChat

@*
    One entry is one block of markdown. Not focused, it reads as a document;
    focused, it is the raw text. Nothing in between, and no field-level form
    control anywhere — see BacklogDesktopState and EntryTextParser.
*@

<div class="shell shell--wide">
    <header class="app-header">
        <h1>Backlog</h1>

        <div class="app-header__version" data-testid="app-version">
            Version <code>@Updates.CurrentVersion</code>
            @if (Updates.IsSupported)
            {
                <button type="button"
                        class="header-tool-toggle"
                        data-testid="check-for-updates"
                        disabled="@_updateBusy"
                        @onclick="CheckForUpdatesAsync">
                    @(_checkingForAppUpdate ? "Checking..." : "Check for updates")
                </button>
                @if (_appUpdateReady)
                {
                    <button type="button"
                            class="header-tool-toggle"
                            data-testid="install-update"
                            disabled="@_updateBusy"
                            @onclick="InstallUpdateAsync">
                        @(_installingAppUpdate ? "Installing..." : "Install update")
                    </button>
                }
            }
            @if (_appUpdateMessage is not null)
            {
                <span class="@_appUpdateStatusClass" role="status">@_appUpdateMessage</span>
            }
        </div>
        <div class="save-indicator save-indicator--@State.SaveState.ToString().ToLowerInvariant()" id="save-state-indicator" data-testid="save-state-indicator" role="status">
            <span class="save-indicator__dot" aria-hidden="true"></span>
            @State.SaveStateLabel
        </div>

        @* Monitoring is a deliberate act, not a background poll: the backlog has
           to open instantly and offline, so nothing here waits on GitHub until
           somebody asks it to. *@
        @if (IsFeatureEnabled(AppFeatureSettingsStore.GitHubIntegration) && State.GitHubConfigured && State.HasLinkedRows)
        {
            <button type="button"
                    class="icon-link"
                    id="github-sync-button"
                    data-testid="github-sync-button"
                    disabled="@State.GitHubSyncing"
                    title="Check GitHub for issue and pull request updates"
                    aria-label="Check GitHub for issue and pull request updates"
                    @onclick="() => State.SyncGitHubAsync()">
                @(State.GitHubSyncing ? "…" : "⟳")
            </button>
        }

        @if (IsFeatureEnabled(AppFeatureSettingsStore.RepositoryKnowledge))
        {
            <button type="button"
                    class="header-tool-toggle"
                    id="knowledge-toggle-button"
                    data-testid="knowledge-toggle-button"
                    aria-controls="repository-knowledge-pane"
                    aria-expanded="@(_knowledgeExpanded ? "true" : "false")"
                    @onclick="ToggleKnowledgePane">
                @(_knowledgeExpanded ? "Hide knowledge" : "Show knowledge")
            </button>
        }
        @if (IsFeatureEnabled(AppFeatureSettingsStore.AiAssistant))
        {
            <button type="button"
                    class="header-tool-toggle"
                    id="ai-toggle-button"
                    data-testid="ai-toggle-button"
                    aria-controls="ai-assistant-panel"
                    aria-expanded="@_aiExpanded"
                    @onclick="ToggleAiPanel">
                Ask AI
            </button>
        }
        @if (IsFeatureEnabled(AppFeatureSettingsStore.SystemTools))
        {
            <button type="button"
                    class="header-tool-toggle"
                    id="tools-toggle-button"
                    data-testid="tools-toggle-button"
                    aria-controls="tools-pane"
                    aria-expanded="@(ToolsVisible ? "true" : "false")"
                    @onclick="OnToolsToggleAsync">
                Tools
            </button>
        }

        @if (IsFeatureEnabled(AppFeatureSettingsStore.FeedbackReporting))
        {
            <button type="button"
                    class="header-tool-toggle"
                    id="feedback-button"
                    data-testid="feedback-button"
                    aria-haspopup="dialog"
                    @onclick="OpenFeedbackDialog">
                Report issue
            </button>
        }

        <a class="icon-link" href="settings" id="settings-link" data-testid="settings-link" title="Settings" aria-label="Settings">⚙</a>
    </header>

    @if (IsFeatureEnabled(AppFeatureSettingsStore.FeedbackReporting) && _feedbackOpen)
    {
        <div class="feedback-backdrop" role="presentation">
            <section class="feedback-dialog" role="dialog" aria-modal="true" aria-labelledby="feedback-title" aria-describedby="feedback-description" data-testid="feedback-dialog">
                <header class="feedback-dialog__header">
                    <div>
                        <p class="feedback-dialog__eyebrow">GitHub feedback</p>
                        <h2 id="feedback-title">Report an issue</h2>
                    </div>
                    <button type="button" class="btn btn--ghost btn--icon" aria-label="Close feedback dialog" disabled="@_feedbackSubmitting" @onclick="CloseFeedbackDialog">x</button>
                </header>
                <p id="feedback-description" class="feedback-dialog__description">Send a Desktop app issue to JSdotNet/Backlog. Add where on the current screen it happens; the app will ask which screen to capture when you submit.</p>
                <label class="feedback-field" for="feedback-screen-area-input">
                    <span>Screen area</span>
                    <input id="feedback-screen-area-input" data-testid="feedback-screen-area-input" value="@_feedbackScreenArea" @oninput="OnFeedbackScreenAreaInput" maxlength="120" placeholder="For example: header, backlog list, settings repositories" disabled="@_feedbackSubmitting" />
                </label>
                <label class="feedback-field" for="feedback-title-input">
                    <span>Title</span>
                    <input id="feedback-title-input" data-testid="feedback-title-input" value="@_feedbackTitle" @oninput="OnFeedbackTitleInput" maxlength="120" disabled="@_feedbackSubmitting" />
                </label>

                <label class="feedback-field" for="feedback-details-input">
                    <span>Details</span>
                    <textarea id="feedback-details-input" data-testid="feedback-details-input" value="@_feedbackDetails" @oninput="OnFeedbackDetailsInput" rows="6" disabled="@_feedbackSubmitting"></textarea>
                </label>

                @if (_feedbackMessage is not null)
                {
                    <p class="@FeedbackStatusClass" role="@FeedbackStatusRole">@_feedbackMessage</p>
                }

                <footer class="feedback-dialog__actions">
                    <button type="button" class="btn btn--ghost" disabled="@_feedbackSubmitting" @onclick="CloseFeedbackDialog">Cancel</button>
                    <button type="button" class="btn btn--primary" data-testid="feedback-submit" disabled="@(_feedbackSubmitting || string.IsNullOrWhiteSpace(_feedbackTitle))" @onclick="SubmitFeedbackAsync">
                        @(_feedbackSubmitting ? "Sending..." : "Create GitHub issue")
                    </button>
                </footer>
            </section>
        </div>
    }

    @if (IsFeatureEnabled(AppFeatureSettingsStore.AiAssistant) && _aiExpanded)
    {
        <section class="ai-panel" id="ai-assistant-panel" data-testid="ai-assistant-panel" aria-labelledby="ai-assistant-title">
            <div class="ai-panel__header">
                <div>
                    <p class="ai-panel__eyebrow">Azure Foundry</p>
                    <h2 id="ai-assistant-title">Ask about this content</h2>
                </div>
                <a class="ai-panel__settings" href="settings">Settings</a>
            </div>
            <p class="ai-panel__body">
                The question is answered from the entries currently in view and loaded backlog knowledge.
            </p>
            <textarea class="ai-panel__question"
                      data-testid="ai-question-input"
                      rows="3"
                      placeholder="What should I focus on next?"
                      value="@_aiQuestion"
                      @oninput="e => _aiQuestion = e.Value?.ToString() ?? string.Empty"
                      @onkeydown="OnAiQuestionKeyDownAsync"></textarea>
            <div class="ai-panel__actions">
                <button type="button"
                        class="btn btn--secondary"
                        data-testid="ai-ask-button"
                        disabled="@_aiBusy"
                        @onclick="AskAiAsync">
                    @(_aiBusy ? "Asking..." : "Ask")
                </button>
            </div>
            @if (_aiError is not null)
            {
                <p class="ai-panel__error" data-testid="ai-error" role="alert">@_aiError</p>
            }
            @if (_aiAnswer is not null)
            {
                <article class="ai-panel__answer" data-testid="ai-answer">
                    <h3>Answer</h3>
                    <p>@_aiAnswer</p>
                </article>
            }
        </section>
    }

    <main class="knowledge-layout @(SidePaneVisible ? "knowledge-layout--side-open" : "knowledge-layout--side-closed")" style="--knowledge-panel-width: @_knowledgePanelWidthRem.ToString(System.Globalization.CultureInfo.InvariantCulture)rem" data-testid="knowledge-layout">
        <section class="backlog-workspace" aria-label="Backlog entries">

    @* Areas on the left, because that is what you pick first — which pile am I
       in. Status narrows what is already in view, so it sits on the right. *@
    <div class="filter-bar">
        <div class="filter-group filter-group--areas" role="radiogroup" aria-label="Filter by area">
            @foreach (var area in State.AreaFilters)
            {
                <button type="button"
                        class="chip chip--filter @(State.SelectedArea == area.Value ? "chip--active" : string.Empty)"
                        data-testid="area-filter-option"
                        role="radio"
                        aria-checked="@(State.SelectedArea == area.Value ? "true" : "false")"
                        @onclick="() => State.SetAreaFilter(area.Value)">
                    @area.Label<span class="chip__count">@area.Count</span>
                </button>
            }
        </div>

        <div class="filter-group filter-group--status" role="radiogroup" aria-label="Filter by status">
            @foreach (var filter in State.StatusFilters)
            {
                <button type="button"
                        class="chip chip--filter @(State.SelectedStatusFilterWire == filter.Wire ? "chip--active" : string.Empty)"
                        id="status-filter-@(string.IsNullOrEmpty(filter.Wire) ? "all" : filter.Wire)"
                        data-testid="status-filter-option"
                        role="radio"
                        aria-checked="@(State.SelectedStatusFilterWire == filter.Wire ? "true" : "false")"
                        @onclick="() => OnFilterChanged(filter.Wire)">
                    @filter.Label
                </button>
            }
        </div>
    </div>

    @if (State.FilteredRows.Count == 0)
    {
        <div class="empty-state" data-testid="empty-state">
            <p class="empty-state__title">Nothing here yet.</p>
            <p class="empty-state__body">Write your first entry to start triaging the backlog.</p>
        </div>
    }
    else
    {
        <ul id="entry-list" data-testid="entry-list" class="entry-list @(State.DraggedRow is null ? string.Empty : "entry-list--dragging")">
            @foreach (var row in State.FilteredRows)
            {
                var editing = ReferenceEquals(State.EditingRow, row);
                var oneLine = !editing && row.UsesOneLineLayout;

                <li class="entry-group" @key="row.Key">
                <div class="entry-doc status-accent--@row.PreviewStatus.ToString().ToLowerInvariant() @(editing ? "entry-doc--editing" : string.Empty) @(oneLine ? "entry-doc--one-line" : string.Empty) @(ReferenceEquals(State.DraggedRow, row) ? "entry-doc--dragged" : string.Empty) @(row.JustSaved ? "entry-doc--saved-flash" : string.Empty)">

                    @RenderGrip(row, before: true, "top")
                    @RenderGrip(row, before: true, "left")

                    @* A 12px rail is a fine thing to grab and a miserable thing
                       to hit. While a drag is in flight the whole card becomes
                       the target, split into a top half that drops above and a
                       bottom half that drops below. *@
                    @if (State.DraggedRow is not null && !ReferenceEquals(State.DraggedRow, row))
                    {
                        <div class="entry-doc__drops" aria-hidden="true">
                            <div class="entry-doc__drop entry-doc__drop--before"
                                 data-testid="entry-drop-before"
                                 data-drop-zone="@row.Key"
                                 @ondragenter:preventDefault="true"
                                 @ondragover:preventDefault="true"
                                 @ondrop="() => State.DropAsync(row, true)"></div>
                            <div class="entry-doc__drop entry-doc__drop--after"
                                 data-testid="entry-drop-after"
                                 data-drop-zone="@row.Key"
                                 @ondragenter:preventDefault="true"
                                 @ondragover:preventDefault="true"
                                 @ondrop="() => State.DropAsync(row, false)"></div>
                        </div>
                    }

                    <div class="entry-doc__body">
                        @if (editing || oneLine)
                        {
                            @RenderEntryMetadata(row, oneLine)
                        }

                        @if (IsFeatureEnabled(AppFeatureSettingsStore.GitHubIntegration) && row.GitHubError is not null)
                        {
                            <p class="entry-doc__gh-error" data-testid="github-error" role="status">@row.GitHubError</p>
                        }

                        @if (IsFeatureEnabled(AppFeatureSettingsStore.CopilotCli) && row.CopilotError is not null)
                        {
                            <p class="entry-doc__gh-error" data-testid="copilot-cli-error" role="status">@row.CopilotError</p>
                        }
                        @if (editing)
                        {
                            <div class="grow-wrap" data-replicated-value="@(row.RawText + "\n")">
                                <textarea class="entry-doc__editor"
                                          id="entry-raw-@row.Key"
                                          data-testid="entry-raw-input"
                                          aria-label="Entry markdown"
                                          placeholder="@BacklogDesktopState.NewEntryPlaceholder"
                                          @ref="_editor"
                                          @oninput="e => State.OnRawTextInput(row, e.Value?.ToString() ?? string.Empty)"
                                          @onkeydown="e => OnEditorKeyDownAsync(row, e)"
                                          @onfocus="() => FocusTextEntry(row)"
                                          @onblur="() => OnEditorBlurAsync(row)">@row.RawText</textarea>

                                @* Answers "which one is the status?" by simply
                                   saying so, live, from the same parse the save
                                   will use. *@
                                <p class="entry-doc__reading" data-testid="entry-meta-reading">
                                    <span class="entry-doc__reading-lead">reads as</span>
                                    @foreach (var reading in row.MetaReadings)
                                    {
                                        <span class="entry-doc__reading-item @(reading.Explicit ? string.Empty : "entry-doc__reading-item--default") @(reading.Note is null ? string.Empty : "entry-doc__reading-item--refused")">
                                            <span class="entry-doc__reading-kind">@reading.Kind</span>
                                            <span class="entry-doc__reading-value">@reading.Value</span>
                                            @if (reading.Note is not null)
                                            {
                                                <span class="entry-doc__reading-note">@reading.Note</span>
                                            }
                                        </span>
                                    }
                                </p>
                            </div>
                        }
                        else
                        {
                            <div class="entry-doc__read"
                                 id="entry-content-@row.Key"
                                 data-testid="entry-read-view"
                                 role="group"
                                 tabindex="0"
                                 aria-label="Edit markdown for @(string.IsNullOrWhiteSpace(row.PreviewTitle) ? "untitled entry" : row.PreviewTitle)"
                                 @onclick="() => State.BeginEdit(row)"
                                 @onkeydown="e => OnReadViewKeyDown(row, e)">

                                <div class="entry-doc__title-line">

                                    @if (string.IsNullOrWhiteSpace(row.PreviewTitle))
                                    {
                                        <p class="entry-doc__title entry-doc__title--empty">Untitled</p>
                                    }
                                    else
                                    {
                                        <p class="entry-doc__title" data-testid="entry-title">@row.PreviewTitle</p>
                                    }

                                    @if (row.HasExpandableContent)
                                    {
                                        <button type="button"
                                                class="entry-doc__fold"
                                                id="fold-entry-@row.Key"
                                                data-testid="entry-fold-button"
                                                aria-expanded="@(row.EntryCollapsed ? "false" : "true")"
                                                aria-controls="entry-content-@row.Key"
                                                aria-label="@(row.EntryCollapsed ? "Show entry details" : "Collapse entry to one line")"
                                                @onmousedown:preventDefault="true"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => State.ToggleEntry(row)">
                                            <span class="entry-doc__fold-chevron @(row.EntryCollapsed ? string.Empty : "entry-doc__fold-chevron--open")" aria-hidden="true">▸</span>
                                        </button>
                                    }
                                    @if (!oneLine)
                                    {
                                        @RenderEntryMetadata(row, oneLine)
                                    }
                                </div>

                                @if (!row.UsesOneLineLayout)
                                {
                                    <MarkdownView Blocks="row.PreviewBlocks" OnTaskItemToggled="index => State.ToggleTaskItemAsync(row, index)" />
                                }
                            </div>
                        }
                    </div>

                    @RenderGrip(row, before: false, "right")
                    @RenderGrip(row, before: false, "bottom")
                </div>

                @* Sub-items are items, not paragraphs: they sit below the entry,
                   indented under it, each one its own card that can be grabbed
                   and re-ranked. Folded away, the count on the entry still says
                   they are there. While the raw text is open they belong to the
                   textarea, so the cards step aside. *@
                @if (!editing && row.PreviewSubItems.Count > 0 && !row.EntryCollapsed)
                {
                    <ul class="subitem-list @(ReferenceEquals(State.SubItemDragRow, row) ? "subitem-list--dragging" : string.Empty)"
                        id="subitems-@row.Key"
                        data-testid="subitem-list">
                        @for (var index = 0; index < row.PreviewSubItems.Count; index++)
                        {
                            var position = index;
                            var subItem = row.PreviewSubItems[position];

                            <li class="subitem-card @(subItem.Done ? "subitem-card--done" : string.Empty) @(State.IsDraggingSubItem(row, position) ? "subitem-card--dragged" : string.Empty)"
                                @key="position"
                                data-testid="entry-subitem">

                                <button type="button"
                                        class="subitem-card__grip"
                                        id="subitem-grip-@row.Key-@position"
                                        data-testid="subitem-grip"
                                        data-drag-grip="@row.Key-@position"
                                        draggable="true"
                                        aria-label="Reorder sub-item — drag, or use the up and down arrow keys"
                                        @ondragstart="() => State.BeginSubItemDrag(row, position)"
                                        @ondragend="() => State.EndSubItemDrag()"
                                        @ondragenter:preventDefault="true"
                                        @ondragover:preventDefault="true"
                                        @ondrop="() => State.DropSubItemAsync(row, position, true)"
                                        @onkeydown="e => OnSubItemGripKeyDownAsync(row, position, e)">
                                    <span class="subitem-card__grip-dots" aria-hidden="true"></span>
                                </button>

                                <div class="subitem-card__body"
                                     role="group"
                                     tabindex="0"
                                     aria-label="Edit sub-item"
                                     @onclick="() => State.BeginEdit(row)"
                                     @onkeydown="e => OnReadViewKeyDown(row, e)">
                                    <div class="subitem-card__title-row">
                                        @if (subItem.HasCheckbox)
                                        {
                                            <button type="button"
                                                    class="md-check subitem-card__check @(subItem.Done ? "md-check--done" : string.Empty)"
                                                    data-testid="subitem-checkbox"
                                                    aria-pressed="@(subItem.Done ? "true" : "false")"
                                                    aria-label="@(subItem.Done ? "Mark sub-item not done" : "Mark sub-item done")"
                                                    @onmousedown:preventDefault="true"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => State.ToggleSubItemAsync(row, position)">@(subItem.Done ? "✔" : string.Empty)</button>
                                        }
                                        <h3 class="subitem-card__title">@MarkdownRender.Inlines(subItem.Title)</h3>
                                    </div>
                                    @RenderSubItemMetadata(row, subItem, position)
                                    @if (subItem.Children.Count > 0)
                                    {
                                        <div class="subitem-card__notes">
                                            <MarkdownView Blocks="subItem.Children" OnTaskItemToggled="index => State.ToggleTaskItemAsync(row, index)" />
                                        </div>
                                    }
                                </div>
                                @* Same bargain as the entries: mid-drag the whole
                                   card is the target, top half drops above and
                                   bottom half below. *@
                                @if (ReferenceEquals(State.SubItemDragRow, row) && State.SubItemDragIndex != position)
                                {
                                    <div class="subitem-card__drops" aria-hidden="true">
                                        <div class="subitem-card__drop subitem-card__drop--before"
                                             data-testid="subitem-drop-before"
                                             data-drop-zone="@row.Key-@position"
                                             @ondragenter:preventDefault="true"
                                             @ondragover:preventDefault="true"
                                             @ondrop="() => State.DropSubItemAsync(row, position, true)"></div>
                                        <div class="subitem-card__drop subitem-card__drop--after"
                                             data-testid="subitem-drop-after"
                                             data-drop-zone="@row.Key-@position"
                                             @ondragenter:preventDefault="true"
                                             @ondragover:preventDefault="true"
                                             @ondrop="() => State.DropSubItemAsync(row, position, false)"></div>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                }
                </li>
            }
        </ul>
    }

    @* Creating an entry is the same gesture as writing in one, so the control
       sits where the next entry will actually appear rather than up in the
       chrome. *@
    <button type="button"
            class="entry-add"
            id="new-entry-button"
            data-testid="new-entry-button"
            @onclick="OnNewEntry">
        <span class="entry-add__plus" aria-hidden="true">+</span>
        New entry
    </button>
        </section>

        @if (SidePaneVisible)
        {
            <aside class="side-pane-stack" data-testid="side-pane-stack" aria-label="Backlog side panes">
                <label class="knowledge-stack__resizer">
                    <span>Side pane width</span>
                    <input type="range" min="24" max="54" step="1" value="@_knowledgePanelWidthRem.ToString(System.Globalization.CultureInfo.InvariantCulture)" @oninput="OnKnowledgeWidthChanged" />
                </label>
                @if (ToolsVisible)
                {
                    @RenderToolsPane()
                }

                @if (KnowledgeVisible)
                {
                    <section class="knowledge-stack" id="repository-knowledge-pane" data-testid="knowledge-stack" aria-label="Repository knowledge base">
                        @if (KnowledgeRepositories.Count > 1)
                {
                    <nav class="knowledge-stack__repositories" aria-label="Knowledge repository">
                        @foreach (var repository in KnowledgeRepositories)
                        {
                            <button type="button"
                                    class="knowledge-stack__repo @(IsKnowledgeRepositoryActive(repository.Alias) ? "knowledge-stack__repo--active" : string.Empty)"
                                    aria-pressed="@IsKnowledgeRepositoryActive(repository.Alias)"
                                    @onclick="() => SelectKnowledgeRepositoryAsync(repository.Alias)">
                                @repository.FullName
                            </button>
                        }
                    </nav>
                }

                <nav class="knowledge-stack__nav" aria-label="Knowledge sections" role="tablist">
                    @foreach (var area in VisibleKnowledgeAreas)
                    {
                        <button type="button"
                                class="knowledge-stack__nav-item @(IsKnowledgeSectionActive(area.Key) ? "knowledge-stack__nav-item--active" : string.Empty)"
                                role="tab"
                                aria-selected="@IsKnowledgeSectionActive(area.Key)"
                                aria-controls="knowledge-active-section"
                                @onclick="() => SelectKnowledgeSection(area.Key)">
                            @area.Label
                        </button>
                    }
                </nav>

                <div class="knowledge-stack__section" id="knowledge-active-section" role="tabpanel">
                    @RenderActiveKnowledge()
                </div>
                    </section>
                }
            </aside>
        }
    </main>
</div>

@code {
    private ElementReference _editor;
    private bool _toolsExpanded;
    private bool _aiExpanded;
    private bool _knowledgeExpanded;
    private double _knowledgePanelWidthRem = 36;
    private bool _toolsLoading;
    private string? _toolMessage;
    private string? _toolActionKey;
    private IReadOnlyList<CopilotToolInfo> _tools = [];
    private BacklogKnowledgeView? _backlogKnowledge;
    private string _selectedKnowledgeSection = "backlog";
    private string? _selectedKnowledgeRepositoryAlias;
    private string? _appUpdateMessage;
    private string _appUpdateStatusClass = string.Empty;
    private bool _checkingForAppUpdate;
    private bool _installingAppUpdate;
    private bool _appUpdateReady;
    private Guid? _textFocusedEntryKey;
    private bool _feedbackOpen;
    private bool _feedbackSubmitting;
    private bool _feedbackSucceeded;
    private string _feedbackTitle = string.Empty;
    private string _feedbackScreenArea = string.Empty;
    private string _feedbackDetails = string.Empty;
    private string? _feedbackMessage;
    private string _aiQuestion = string.Empty;
    private string? _aiAnswer;
    private string? _aiError;
    private bool _aiBusy;

    private bool _updateBusy => _checkingForAppUpdate || _installingAppUpdate;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += HandleStateChanged;
        await State.InitializeAsync();
        if (IsFeatureEnabled(AppFeatureSettingsStore.RepositoryKnowledge))
        {
            await LoadBacklogKnowledgeAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A sub-item that was just moved with the keyboard has to take the caret
        // with it, or the next press moves whatever slid into the old slot.
        if (State.SubItemFocus is { } focus)
        {
            State.ConsumeSubItemFocus();
            try
            {
                await JS.InvokeVoidAsync("backlogFocus", $"subitem-grip-{focus.Row.Key}-{focus.Index}");
            }
            catch (Exception)
            {
                // Losing the focus ring is not worth tearing down the page.
            }
        }

        if (!State.FocusPending || State.EditingRow is null) return;

        State.FocusPending = false;
        try
        {
            await _editor.FocusAsync();
        }
        catch (Exception)
        {
            // The editor can be gone again by the time this runs (a fast click
            // elsewhere); losing the caret is not worth tearing down the page.
        }
    }

    private bool ToolsVisible => IsFeatureEnabled(AppFeatureSettingsStore.SystemTools) && _toolsExpanded;

    private void ToggleAiPanel() => _aiExpanded = !_aiExpanded;

    private async Task AskAiAsync()
    {
        if (_aiBusy) return;

        _aiBusy = true;
        _aiError = null;
        _aiAnswer = null;

        try
        {
            var response = await AzureFoundryChat.AskAsync(new AzureFoundryChatRequest(BuildAiContent(), _aiQuestion));
            _aiAnswer = response.Answer;
        }
        catch (AzureFoundryException ex)
        {
            _aiError = ex.Message;
        }
        catch (HttpRequestException ex)
        {
            _aiError = $"Azure Foundry could not be reached: {ex.Message}";
        }
        catch (TaskCanceledException)
        {
            _aiError = "Azure Foundry did not answer before the request timed out.";
        }
        finally
        {
            _aiBusy = false;
        }
    }

    private Task OnAiQuestionKeyDownAsync(KeyboardEventArgs e) =>
        e.Key == "Enter" && (e.CtrlKey || e.MetaKey) ? AskAiAsync() : Task.CompletedTask;

    private string BuildAiContent()
    {
        var builder = new System.Text.StringBuilder();
        builder.AppendLine("Visible backlog entries:");
        foreach (var row in State.FilteredRows.Where(row => !row.IsUntouched))
        {
            builder.AppendLine("---");
            builder.AppendLine(row.RawText.Trim());
        }

        if (_backlogKnowledge?.IsReady == true && _backlogKnowledge.Concerns.Count > 0)
        {
            builder.AppendLine();
            builder.AppendLine("Loaded .backlog knowledge:");
            foreach (var concern in _backlogKnowledge.Concerns)
            {
                builder.AppendLine($"- {concern.Title} ({concern.RelativePath})");
                foreach (var item in concern.Items)
                {
                    AppendKnowledgeItem(builder, item, indent: "  ");
                }
            }
        }

        var content = builder.ToString().Trim();
        return content.Length <= 12000 ? content : content[..12000];
    }

    private static void AppendKnowledgeItem(System.Text.StringBuilder builder, BacklogWorkItemKnowledge item, string indent)
    {
        builder.AppendLine($"{indent}- {item.Title}");
        foreach (var subItem in item.SubItems)
        {
            AppendKnowledgeItem(builder, subItem, indent + "  ");
        }
    }

