@page "/"
@implements IDisposable
@inject BacklogDesktopState State
@inject IJSRuntime JS
@inject ICopilotToolService CopilotTools
@inject KnowledgeBacklog RepositoryBacklog
@inject GitHubIntegration GitHub
@inject AppFeatureSettingsStore Features
@inject IAppUpdateService Updates

@*
    One entry is one block of markdown. Not focused, it reads as a document;
    focused, it is the raw text. Nothing in between, and no field-level form
    control anywhere — see BacklogDesktopState and EntryTextParser.
*@

<div class="shell shell--wide">
    <header class="app-header">
        <h1>Backlog</h1>

        <div class="app-header__version" data-testid="app-version">
            Version <code>@Updates.CurrentVersion</code>
            @if (Updates.IsSupported)
            {
                <button type="button"
                        class="header-tool-toggle"
                        data-testid="check-for-updates"
                        disabled="@_updateBusy"
                        @onclick="CheckForUpdatesAsync">
                    @(_checkingForAppUpdate ? "Checking..." : "Check for updates")
                </button>
                @if (_appUpdateReady)
                {
                    <button type="button"
                            class="header-tool-toggle"
                            data-testid="install-update"
                            disabled="@_updateBusy"
                            @onclick="InstallUpdateAsync">
                        @(_installingAppUpdate ? "Installing..." : "Install update")
                    </button>
                }
            }
            @if (_appUpdateMessage is not null)
            {
                <span class="@_appUpdateStatusClass" role="status">@_appUpdateMessage</span>
            }
        </div>
        <div class="save-indicator save-indicator--@State.SaveState.ToString().ToLowerInvariant()" id="save-state-indicator" data-testid="save-state-indicator" role="status">
            <span class="save-indicator__dot" aria-hidden="true"></span>
            @State.SaveStateLabel
        </div>

        @* Monitoring is a deliberate act, not a background poll: the backlog has
           to open instantly and offline, so nothing here waits on GitHub until
           somebody asks it to. *@
        @if (IsFeatureEnabled(AppFeatureSettingsStore.GitHubIntegration) && State.GitHubConfigured && State.HasLinkedRows)
        {
            <button type="button"
                    class="icon-link"
                    id="github-sync-button"
                    data-testid="github-sync-button"
                    disabled="@State.GitHubSyncing"
                    title="Check GitHub for issue and pull request updates"
                    aria-label="Check GitHub for issue and pull request updates"
                    @onclick="() => State.SyncGitHubAsync()">
                @(State.GitHubSyncing ? "…" : "⟳")
            </button>
        }

        @if (IsFeatureEnabled(AppFeatureSettingsStore.RepositoryKnowledge))
        {
            <button type="button"
                    class="header-tool-toggle"
                    id="knowledge-toggle-button"
                    data-testid="knowledge-toggle-button"
                    aria-controls="repository-knowledge-pane"
                    aria-expanded="@(_knowledgeExpanded ? "true" : "false")"
                    @onclick="ToggleKnowledgePane">
                @(_knowledgeExpanded ? "Hide knowledge" : "Show knowledge")
            </button>
        }
        @if (IsFeatureEnabled(AppFeatureSettingsStore.SystemTools))
        {
            <button type="button"
                    class="header-tool-toggle"
                    id="tools-toggle-button"
                    data-testid="tools-toggle-button"
                    aria-controls="installed-tools-content"
                    aria-expanded="@_toolsExpanded"
                    @onclick="OnToolsToggleAsync">
                Tools
            </button>
        }

        <button type="button"
                class="header-tool-toggle"
                id="feedback-button"
                data-testid="feedback-button"
                aria-haspopup="dialog"
                @onclick="OpenFeedbackDialog">
            Report issue
        </button>

        <a class="icon-link" href="settings" id="settings-link" data-testid="settings-link" title="Settings" aria-label="Settings">⚙</a>
    </header>

    @if (_feedbackOpen)
    {
        <div class="feedback-backdrop" role="presentation">
            <section class="feedback-dialog" role="dialog" aria-modal="true" aria-labelledby="feedback-title" aria-describedby="feedback-description" data-testid="feedback-dialog">
                <header class="feedback-dialog__header">
                    <div>
                        <p class="feedback-dialog__eyebrow">GitHub feedback</p>
                        <h2 id="feedback-title">Report an issue</h2>
                    </div>
                    <button type="button" class="btn btn--ghost btn--icon" aria-label="Close feedback dialog" disabled="@_feedbackSubmitting" @onclick="CloseFeedbackDialog">x</button>
                </header>
                <p id="feedback-description" class="feedback-dialog__description">Send a GitHub issue to JSdotNet/Backlog. The app will ask which screen to capture when you submit.</p>
                <label class="feedback-field" for="feedback-area-input">
                    <span>Area</span>
                    <select id="feedback-area-input" data-testid="feedback-area-input" value="@_feedbackArea" @onchange="OnFeedbackAreaInput" disabled="@_feedbackSubmitting">
                        @foreach (var area in FeedbackAreas)
                        {
                            <option value="@area">@area</option>
                        }
                    </select>
                </label>
                <label class="feedback-field" for="feedback-title-input">
                    <span>Title</span>
                    <input id="feedback-title-input" data-testid="feedback-title-input" value="@_feedbackTitle" @oninput="OnFeedbackTitleInput" maxlength="120" disabled="@_feedbackSubmitting" />
                </label>

                <label class="feedback-field" for="feedback-details-input">
                    <span>Details</span>
                    <textarea id="feedback-details-input" data-testid="feedback-details-input" value="@_feedbackDetails" @oninput="OnFeedbackDetailsInput" rows="6" disabled="@_feedbackSubmitting"></textarea>
                </label>

                @if (_feedbackMessage is not null)
                {
                    <p class="@FeedbackStatusClass" role="@FeedbackStatusRole">@_feedbackMessage</p>
                }

                <footer class="feedback-dialog__actions">
                    <button type="button" class="btn btn--ghost" disabled="@_feedbackSubmitting" @onclick="CloseFeedbackDialog">Cancel</button>
                    <button type="button" class="btn btn--primary" data-testid="feedback-submit" disabled="@(_feedbackSubmitting || string.IsNullOrWhiteSpace(_feedbackTitle))" @onclick="SubmitFeedbackAsync">
                        @(_feedbackSubmitting ? "Sending..." : "Create GitHub issue")
                    </button>
                </footer>
            </section>
        </div>
    }

    @if (IsFeatureEnabled(AppFeatureSettingsStore.SystemTools))
    {
        <section class="tools-panel" aria-labelledby="installed-tools-title" data-testid="tools-panel">
            <button type="button"
                    class="tools-panel__summary"
                    aria-expanded="@_toolsExpanded"
                    aria-controls="installed-tools-content"
                    @onclick="OnToolsToggleAsync">
                <span class="tools-panel__chevron" aria-hidden="true">@(_toolsExpanded ? "▾" : "▸")</span>
                <span>
                    <span id="installed-tools-title" class="tools-panel__title">System tools</span>
                    <span class="tools-panel__subtitle">Manage Copilot plugins, repository tools, and MCP servers</span>
                </span>
                <span class="tools-panel__count">@(_tools.Count == 0 ? "Check tools" : $"{_tools.Count} configured")</span>
            </button>

            @if (_toolsExpanded)
            {
                <div class="tools-panel__content" id="installed-tools-content">
                    <div class="tools-panel__toolbar">
                        <p class="tools-panel__message" role="status">@(_toolMessage ?? "Checking configured tools...")</p>
                        <button type="button" class="btn btn--secondary" disabled="@_toolsLoading" @onclick="RefreshToolsAsync">
                            @(_toolsLoading ? "Checking..." : "Check for updates")
                        </button>
                    </div>

                    @if (_toolsLoading && _tools.Count == 0)
                    {
                        <p class="tools-panel__empty">Loading installed tool versions.</p>
                    }
                    else if (_tools.Count == 0)
                    {
                        <p class="tools-panel__empty">No configured tools were found.</p>
                    }
                    else
                    {
                        <div class="tools-table" role="table" aria-label="Installed Copilot tools">
                            <div class="tools-table__row tools-table__row--head" role="row">
                                <span role="columnheader">Tool</span>
                                <span role="columnheader">Installed</span>
                                <span role="columnheader">Available</span>
                                <span role="columnheader">Actions</span>
                            </div>

                            @foreach (var tool in _tools)
                            {
                                <div class="tools-table__row" role="row" @key="tool.Key">
                                    <div role="cell" class="tools-table__tool">
                                        <strong>@tool.Name</strong>
                                        <span class="tools-table__meta">@Humanize(tool.Kind.ToString()) · @tool.Status</span>
                                    </div>
                                    <span role="cell" class="tools-table__version">@tool.InstalledVersion</span>
                                    <span role="cell" class="tools-table__version @(tool.UpdateAvailable ? "tools-table__version--new" : string.Empty)">@tool.AvailableVersion</span>
                                    <div role="cell" class="tools-table__actions">
                                        <button type="button"
                                                class="btn btn--secondary"
                                                disabled="@(_toolsLoading || _toolActionKey == tool.Key || !tool.ConfiguredEnabled)"
                                                @onclick="() => ApplyToolActionAsync(tool, CopilotToolAction.Update)">
                                            Update
                                        </button>
                                        <button type="button"
                                                class="btn btn--ghost"
                                                disabled="@(_toolsLoading || _toolActionKey == tool.Key)"
                                                @onclick="() => ApplyToolActionAsync(tool, tool.ConfiguredEnabled ? CopilotToolAction.Disable : CopilotToolAction.Enable)">
                                            @(tool.ConfiguredEnabled ? "Disable" : "Enable")
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </section>
    }

    <main class="knowledge-layout @(KnowledgeVisible ? "knowledge-layout--knowledge-open" : "knowledge-layout--knowledge-closed")" data-testid="knowledge-layout">
        <section class="backlog-workspace" aria-label="Backlog entries">

    @* Areas on the left, because that is what you pick first — which pile am I
       in. Status narrows what is already in view, so it sits on the right. *@
    <div class="filter-bar">
        <div class="filter-group filter-group--areas" role="radiogroup" aria-label="Filter by area">
            @foreach (var area in State.AreaFilters)
            {
                <button type="button"
                        class="chip chip--filter @(State.SelectedArea == area.Value ? "chip--active" : string.Empty)"
                        data-testid="area-filter-option"
                        role="radio"
                        aria-checked="@(State.SelectedArea == area.Value ? "true" : "false")"
                        @onclick="() => State.SetAreaFilter(area.Value)">
                    @area.Label<span class="chip__count">@area.Count</span>
                </button>
            }
        </div>

        <div class="filter-group filter-group--status" role="radiogroup" aria-label="Filter by status">
            @foreach (var filter in State.StatusFilters)
            {
                <button type="button"
                        class="chip chip--filter @(State.SelectedStatusFilterWire == filter.Wire ? "chip--active" : string.Empty)"
                        id="status-filter-@(string.IsNullOrEmpty(filter.Wire) ? "all" : filter.Wire)"
                        data-testid="status-filter-option"
                        role="radio"
                        aria-checked="@(State.SelectedStatusFilterWire == filter.Wire ? "true" : "false")"
                        @onclick="() => OnFilterChanged(filter.Wire)">
                    @filter.Label
                </button>
            }
        </div>
    </div>

    @if (State.FilteredRows.Count == 0)
    {
        <div class="empty-state" data-testid="empty-state">
            <p class="empty-state__title">Nothing here yet.</p>
            <p class="empty-state__body">Write your first entry to start triaging the backlog.</p>
        </div>
    }
    else
    {
        <ul id="entry-list" data-testid="entry-list" class="entry-list @(State.DraggedRow is null ? string.Empty : "entry-list--dragging")">
            @foreach (var row in State.FilteredRows)
            {
                var editing = ReferenceEquals(State.EditingRow, row);
                var oneLine = !editing && row.UsesOneLineLayout;

                <li class="entry-group" @key="row.Key">
                <div class="entry-doc status-accent--@row.PreviewStatus.ToString().ToLowerInvariant() @(editing ? "entry-doc--editing" : string.Empty) @(oneLine ? "entry-doc--one-line" : string.Empty) @(ReferenceEquals(State.DraggedRow, row) ? "entry-doc--dragged" : string.Empty) @(row.JustSaved ? "entry-doc--saved-flash" : string.Empty)">

                    @RenderGrip(row, before: true, "top")
                    @RenderGrip(row, before: true, "left")

                    @* A 12px rail is a fine thing to grab and a miserable thing
                       to hit. While a drag is in flight the whole card becomes
                       the target, split into a top half that drops above and a
                       bottom half that drops below. *@
                    @if (State.DraggedRow is not null && !ReferenceEquals(State.DraggedRow, row))
                    {
                        <div class="entry-doc__drops" aria-hidden="true">
                            <div class="entry-doc__drop entry-doc__drop--before"
                                 data-testid="entry-drop-before"
                                 data-drop-zone="@row.Key"
                                 @ondragenter:preventDefault="true"
                                 @ondragover:preventDefault="true"
                                 @ondrop="() => State.DropAsync(row, true)"></div>
                            <div class="entry-doc__drop entry-doc__drop--after"
                                 data-testid="entry-drop-after"
                                 data-drop-zone="@row.Key"
                                 @ondragenter:preventDefault="true"
                                 @ondragover:preventDefault="true"
                                 @ondrop="() => State.DropAsync(row, false)"></div>
                        </div>
                    }

                    <div class="entry-doc__body">
                        @if (editing || oneLine)
                        {
                            @RenderEntryMetadata(row, oneLine)
                        }

                        @if (IsFeatureEnabled(AppFeatureSettingsStore.GitHubIntegration) && row.GitHubError is not null)
                        {
                            <p class="entry-doc__gh-error" data-testid="github-error" role="status">@row.GitHubError</p>
                        }

                        @if (IsFeatureEnabled(AppFeatureSettingsStore.CopilotCli) && row.CopilotError is not null)
                        {
                            <p class="entry-doc__gh-error" data-testid="copilot-cli-error" role="status">@row.CopilotError</p>
                        }
                        @if (editing)
                        {
                            <div class="grow-wrap" data-replicated-value="@(row.RawText + "\n")">
                                <textarea class="entry-doc__editor"
                                          id="entry-raw-@row.Key"
                                          data-testid="entry-raw-input"
                                          aria-label="Entry markdown"
                                          placeholder="@BacklogDesktopState.NewEntryPlaceholder"
                                          @ref="_editor"
                                          @oninput="e => State.OnRawTextInput(row, e.Value?.ToString() ?? string.Empty)"
                                          @onkeydown="e => OnEditorKeyDownAsync(row, e)"
                                          @onblur="() => OnEndEditAsync(row)">@row.RawText</textarea>

                                @* Answers "which one is the status?" by simply
                                   saying so, live, from the same parse the save
                                   will use. *@
                                <p class="entry-doc__reading" data-testid="entry-meta-reading">
                                    <span class="entry-doc__reading-lead">reads as</span>
                                    @foreach (var reading in row.MetaReadings)
                                    {
                                        <span class="entry-doc__reading-item @(reading.Explicit ? string.Empty : "entry-doc__reading-item--default") @(reading.Note is null ? string.Empty : "entry-doc__reading-item--refused")">
                                            <span class="entry-doc__reading-kind">@reading.Kind</span>
                                            <span class="entry-doc__reading-value">@reading.Value</span>
                                            @if (reading.Note is not null)
                                            {
                                                <span class="entry-doc__reading-note">@reading.Note</span>
                                            }
                                        </span>
                                    }
                                </p>
                            </div>
                        }
                        else
                        {
                            <div class="entry-doc__read"
                                 id="entry-content-@row.Key"
                                 data-testid="entry-read-view"
                                 role="button"
                                 tabindex="0"
                                 aria-label="Edit markdown for @(string.IsNullOrWhiteSpace(row.PreviewTitle) ? "untitled entry" : row.PreviewTitle)"
                                 @onclick="() => State.BeginEdit(row)"
                                 @onkeydown="e => OnReadViewKeyDown(row, e)">

                                <div class="entry-doc__title-line">
                                    @if (row.HasExpandableContent)
                                    {
                                        <button type="button"
                                                class="entry-doc__fold"
                                                id="fold-entry-@row.Key"
                                                data-testid="entry-fold-button"
                                                aria-expanded="@(row.EntryCollapsed ? "false" : "true")"
                                                aria-controls="entry-content-@row.Key"
                                                aria-label="@(row.EntryCollapsed ? "Show entry details" : "Collapse entry to one line")"
                                                @onmousedown:preventDefault="true"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => State.ToggleEntry(row)">
                                            <span class="entry-doc__fold-chevron @(row.EntryCollapsed ? string.Empty : "entry-doc__fold-chevron--open")" aria-hidden="true">▸</span>
                                        </button>
                                    }

                                    @if (string.IsNullOrWhiteSpace(row.PreviewTitle))
                                    {
                                        <p class="entry-doc__title entry-doc__title--empty">Untitled</p>
                                    }
                                    else
                                    {
                                        <p class="entry-doc__title" data-testid="entry-title">@row.PreviewTitle</p>
                                    }

                                    @if (!oneLine)
                                    {
                                        @RenderEntryMetadata(row, oneLine)
                                    }
                                </div>

                                @if (!row.UsesOneLineLayout)
                                {
                                    <MarkdownView Blocks="row.PreviewBlocks" OnTaskItemToggled="index => State.ToggleTaskItemAsync(row, index)" />
                                }
                            </div>
                        }
                    </div>

                    @RenderGrip(row, before: false, "right")
                    @RenderGrip(row, before: false, "bottom")
                </div>

                @* Sub-items are items, not paragraphs: they sit below the entry,
                   indented under it, each one its own card that can be grabbed
                   and re-ranked. Folded away, the count on the entry still says
                   they are there. While the raw text is open they belong to the
                   textarea, so the cards step aside. *@
                @if (!editing && row.PreviewSubItems.Count > 0 && !row.EntryCollapsed)
                {
                    <ul class="subitem-list @(ReferenceEquals(State.SubItemDragRow, row) ? "subitem-list--dragging" : string.Empty)"
                        id="subitems-@row.Key"
                        data-testid="subitem-list">
                        @for (var index = 0; index < row.PreviewSubItems.Count; index++)
                        {
                            var position = index;
                            var subItem = row.PreviewSubItems[position];

                            <li class="subitem-card @(subItem.Done ? "subitem-card--done" : string.Empty) @(State.IsDraggingSubItem(row, position) ? "subitem-card--dragged" : string.Empty)"
                                @key="position"
                                data-testid="entry-subitem">

                                <button type="button"
                                        class="subitem-card__grip"
                                        id="subitem-grip-@row.Key-@position"
                                        data-testid="subitem-grip"
                                        data-drag-grip="@row.Key-@position"
                                        draggable="true"
                                        aria-label="Reorder sub-item — drag, or use the up and down arrow keys"
                                        @ondragstart="() => State.BeginSubItemDrag(row, position)"
                                        @ondragend="() => State.EndSubItemDrag()"
                                        @ondragenter:preventDefault="true"
                                        @ondragover:preventDefault="true"
                                        @ondrop="() => State.DropSubItemAsync(row, position, true)"
                                        @onkeydown="e => OnSubItemGripKeyDownAsync(row, position, e)">
                                    <span class="subitem-card__grip-dots" aria-hidden="true"></span>
                                </button>

                                <div class="subitem-card__body">
                                    <div class="subitem-card__title-row">
                                        @if (subItem.HasCheckbox)
                                        {
                                            <button type="button"
                                                    class="md-check subitem-card__check @(subItem.Done ? "md-check--done" : string.Empty)"
                                                    data-testid="subitem-checkbox"
                                                    aria-pressed="@(subItem.Done ? "true" : "false")"
                                                    aria-label="@(subItem.Done ? "Mark sub-item not done" : "Mark sub-item done")"
                                                    @onmousedown:preventDefault="true"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => State.ToggleSubItemAsync(row, position)">@(subItem.Done ? "✔" : string.Empty)</button>
                                        }
                                        <h3 class="subitem-card__title">@MarkdownRender.Inlines(subItem.Title)</h3>
                                    </div>
                                    @if (subItem.Children.Count > 0)
                                    {
                                        <div class="subitem-card__notes">
                                            <MarkdownView Blocks="subItem.Children" OnTaskItemToggled="index => State.ToggleTaskItemAsync(row, index)" />
                                        </div>
                                    }
                                </div>

                                @* Same bargain as the entries: mid-drag the whole
                                   card is the target, top half drops above and
                                   bottom half below. *@
                                @if (ReferenceEquals(State.SubItemDragRow, row) && State.SubItemDragIndex != position)
                                {
                                    <div class="subitem-card__drops" aria-hidden="true">
                                        <div class="subitem-card__drop subitem-card__drop--before"
                                             data-testid="subitem-drop-before"
                                             data-drop-zone="@row.Key-@position"
                                             @ondragenter:preventDefault="true"
                                             @ondragover:preventDefault="true"
                                             @ondrop="() => State.DropSubItemAsync(row, position, true)"></div>
                                        <div class="subitem-card__drop subitem-card__drop--after"
                                             data-testid="subitem-drop-after"
                                             data-drop-zone="@row.Key-@position"
                                             @ondragenter:preventDefault="true"
                                             @ondragover:preventDefault="true"
                                             @ondrop="() => State.DropSubItemAsync(row, position, false)"></div>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                }
                </li>
            }
        </ul>
    }

    @* Creating an entry is the same gesture as writing in one, so the control
       sits where the next entry will actually appear rather than up in the
       chrome. *@
    <button type="button"
            class="entry-add"
            id="new-entry-button"
            data-testid="new-entry-button"
            @onclick="OnNewEntry">
        <span class="entry-add__plus" aria-hidden="true">+</span>
        New entry
    </button>
        </section>

        @if (KnowledgeVisible)
        {
            <aside class="knowledge-stack" id="repository-knowledge-pane" data-testid="knowledge-stack" aria-label="Repository knowledge base">
                @if (KnowledgeRepositories.Count > 1)
                {
                    <nav class="knowledge-stack__repositories" aria-label="Knowledge repository">
                        @foreach (var repository in KnowledgeRepositories)
                        {
                            <button type="button"
                                    class="knowledge-stack__repo @(IsKnowledgeRepositoryActive(repository.Alias) ? "knowledge-stack__repo--active" : string.Empty)"
                                    aria-pressed="@IsKnowledgeRepositoryActive(repository.Alias)"
                                    @onclick="() => SelectKnowledgeRepositoryAsync(repository.Alias)">
                                @repository.FullName
                            </button>
                        }
                    </nav>
                }

                <nav class="knowledge-stack__nav" aria-label="Knowledge sections" role="tablist">
                    @foreach (var area in VisibleKnowledgeAreas)
                    {
                        <button type="button"
                                class="knowledge-stack__nav-item @(IsKnowledgeSectionActive(area.Key) ? "knowledge-stack__nav-item--active" : string.Empty)"
                                role="tab"
                                aria-selected="@IsKnowledgeSectionActive(area.Key)"
                                aria-controls="knowledge-active-section"
                                @onclick="() => SelectKnowledgeSection(area.Key)">
                            @area.Label
                        </button>
                    }
                </nav>

                <div class="knowledge-stack__section" id="knowledge-active-section" role="tabpanel">
                    @RenderActiveKnowledge()
                </div>
            </aside>
        }
    </main>
</div>

@code {
    private ElementReference _editor;
    private bool _toolsExpanded;
    private bool _knowledgeExpanded;
    private bool _toolsLoading;
    private string? _toolMessage;
    private string? _toolActionKey;
    private IReadOnlyList<CopilotToolInfo> _tools = [];
    private BacklogKnowledgeView? _backlogKnowledge;
    private string _selectedKnowledgeSection = "backlog";
    private string? _selectedKnowledgeRepositoryAlias;
    private string? _appUpdateMessage;
    private string _appUpdateStatusClass = string.Empty;
    private bool _checkingForAppUpdate;
    private bool _installingAppUpdate;
    private bool _appUpdateReady;
    private static readonly string[] FeedbackAreas = ["Desktop app", "Mobile app", "IDE extension", "Backlog/work items", "GitHub integration", "Other"];

    private bool _feedbackOpen;
    private bool _feedbackSubmitting;
    private bool _feedbackSucceeded;
    private string _feedbackTitle = string.Empty;
    private string _feedbackArea = FeedbackAreas[0];
    private string _feedbackDetails = string.Empty;
    private string? _feedbackMessage;

    private bool _updateBusy => _checkingForAppUpdate || _installingAppUpdate;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += HandleStateChanged;
        await State.InitializeAsync();
        if (IsFeatureEnabled(AppFeatureSettingsStore.RepositoryKnowledge))
        {
            await LoadBacklogKnowledgeAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A sub-item that was just moved with the keyboard has to take the caret
        // with it, or the next press moves whatever slid into the old slot.
        if (State.SubItemFocus is { } focus)
        {
            State.ConsumeSubItemFocus();
            try
            {
                await JS.InvokeVoidAsync("backlogFocus", $"subitem-grip-{focus.Row.Key}-{focus.Index}");
            }
            catch (Exception)
            {
                // Losing the focus ring is not worth tearing down the page.
            }
        }

        if (!State.FocusPending || State.EditingRow is null) return;

        State.FocusPending = false;
        try
        {
            await _editor.FocusAsync();
        }
        catch (Exception)
        {
            // The editor can be gone again by the time this runs (a fast click
            // elsewhere); losing the caret is not worth tearing down the page.
        }
    }

    private bool KnowledgeVisible => IsFeatureEnabled(AppFeatureSettingsStore.RepositoryKnowledge) && _knowledgeExpanded;

    private bool AdditionalRepositoriesEnabled => IsFeatureEnabled(AppFeatureSettingsStore.AdditionalRepositories);

    private IReadOnlyList<GitHubRepositoryRef> KnowledgeRepositories
    {
        get
        {
            if (AdditionalRepositoriesEnabled) return GitHub.Repositories;

            var primary = GitHub.Settings.Current.PrimaryRepository ?? GitHub.Repositories.FirstOrDefault();
            return primary is null ? [] : [primary];
        }
    }

    private bool IsFeatureEnabled(string featureKey) => Features.IsEnabled(featureKey);
    private string FeedbackStatusClass => $"feedback-status {(_feedbackSucceeded ? "feedback-status--ok" : "feedback-status--error")}";

    private string FeedbackStatusRole => _feedbackSucceeded ? "status" : "alert";

    private void OpenFeedbackDialog()
    {
        _feedbackOpen = true;
        _feedbackSucceeded = false;
        _feedbackMessage = null;
    }

    private void CloseFeedbackDialog()
    {
        if (_feedbackSubmitting) return;

        _feedbackOpen = false;
        _feedbackSucceeded = false;
        _feedbackMessage = null;
    }

    private void OnFeedbackTitleInput(ChangeEventArgs e)
    {
        _feedbackTitle = e.Value?.ToString() ?? string.Empty;
        _feedbackSucceeded = false;
        _feedbackMessage = null;
    }

    private void OnFeedbackDetailsInput(ChangeEventArgs e)
    {
        _feedbackDetails = e.Value?.ToString() ?? string.Empty;
        _feedbackSucceeded = false;
        _feedbackMessage = null;
    }
    private void OnFeedbackAreaInput(ChangeEventArgs e)
    {
        _feedbackArea = e.Value?.ToString() ?? FeedbackAreas[0];
        _feedbackSucceeded = false;
        _feedbackMessage = null;
    }
    private async Task SubmitFeedbackAsync()
    {
        if (string.IsNullOrWhiteSpace(_feedbackTitle))
        {
            _feedbackSucceeded = false;
            _feedbackMessage = "Add a short title before creating the issue.";
            return;
        }

        _feedbackSubmitting = true;
        _feedbackSucceeded = false;
        _feedbackMessage = "Capturing a screenshot...";

        GitHubFeedbackScreenshot? screenshot = null;
        string? screenshotError = null;

        try
        {
            screenshot = await JS.InvokeAsync<GitHubFeedbackScreenshot?>("backlogCaptureScreenshot");
            if (screenshot is null)
            {
                screenshotError = "No screenshot was captured.";
            }
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            screenshotError = ex.Message;
        }

        _feedbackMessage = "Creating the GitHub issue...";

        try
        {
            var link = await GitHub.ReportFeedbackAsync(_feedbackTitle, _feedbackDetails, _feedbackArea, screenshot, screenshotError);
            _feedbackSucceeded = true;
            _feedbackMessage = $"Created {link.RepoFullName}{link.Label}.";
            _feedbackTitle = string.Empty;
            _feedbackArea = FeedbackAreas[0];
            _feedbackDetails = string.Empty;
        }
        catch (GitHubException ex)
        {
            _feedbackSucceeded = false;
            _feedbackMessage = ex.Message;
        }
        finally
        {
            _feedbackSubmitting = false;
        }
    }

    private IReadOnlyList<KnowledgeArea> VisibleKnowledgeAreas
    {
        get
        {
            var areas = IsFeatureEnabled(AppFeatureSettingsStore.KnowledgeSections)
                ? KnowledgeAreas
                : KnowledgeAreas[..1];

            return ActiveRepositoryInstructionsEnabled
                ? areas
                : [.. areas.Where(area => !string.Equals(area.Key, "instructions", StringComparison.Ordinal))];
        }
    }

    private static readonly KnowledgeArea[] KnowledgeAreas =
    [
        new("backlog", "Backlog"),
        new("instructions", "Instructions"),
        new("domain", "Domain"),
        new("arc42", "Architecture"),
        new("tech", "Technology"),
        new("design", "Design")
    ];

    private GitHubRepositoryRef? ActiveKnowledgeRepository =>
        KnowledgeRepositories.FirstOrDefault(repo => string.Equals(repo.Alias, _selectedKnowledgeRepositoryAlias, StringComparison.Ordinal))
        ?? GitHub.Settings.Current.PrimaryRepository
        ?? KnowledgeRepositories.FirstOrDefault();

    private string? ActiveKnowledgeRepositoryAlias => ActiveKnowledgeRepository?.Alias;

    private bool ActiveRepositoryInstructionsEnabled
    {
        get
        {
            var repository = ActiveKnowledgeRepository;
            if (repository is null) return true;

            var instructions = KnowledgeFolderSetting.Normalize(repository.KnowledgeFolders)
                .FirstOrDefault(folder => string.Equals(folder.Key, "instructions", StringComparison.OrdinalIgnoreCase));
            return instructions?.Enabled != false;
        }
    }

    private bool IsKnowledgeSectionActive(string key) =>
        string.Equals(_selectedKnowledgeSection, key, StringComparison.Ordinal);

    private bool IsKnowledgeRepositoryActive(string alias) =>
        string.Equals(ActiveKnowledgeRepositoryAlias, alias, StringComparison.Ordinal);

    private void SelectKnowledgeSection(string key)
    {
        _selectedKnowledgeSection = key;
    }

    private GitHubRepositoryRef? RepositoryFor(EntryRow row) =>
        AdditionalRepositoriesEnabled ? State.RepositoryFor(row) : GitHub.Settings.Current.PrimaryRepository;

    private async Task SelectKnowledgeRepositoryAsync(string alias)
    {
        if (string.Equals(_selectedKnowledgeRepositoryAlias, alias, StringComparison.Ordinal)) return;

        _selectedKnowledgeRepositoryAlias = alias;
        if (IsFeatureEnabled(AppFeatureSettingsStore.RepositoryKnowledge))
        {
            await LoadBacklogKnowledgeAsync();
        }
    }

    private async Task LoadBacklogKnowledgeAsync()
    {
        _backlogKnowledge = await RepositoryBacklog.LoadAsync(ActiveKnowledgeRepositoryAlias);
    }

    private RenderFragment RenderActiveKnowledge() => _selectedKnowledgeSection switch
    {
        "design" => @<DesignKnowledgeView RepositoryAlias="@ActiveKnowledgeRepositoryAlias" />,
        "arc42" => @<Arc42KnowledgePanel RepositoryAlias="@ActiveKnowledgeRepositoryAlias" />,
        "domain" => @<DomainKnowledgePanel Compact="true" RepositoryAlias="@ActiveKnowledgeRepositoryAlias" />,
        "tech" => @<TechnologyKnowledgePanel RepositoryAlias="@ActiveKnowledgeRepositoryAlias" />,
        "instructions" => @<InstructionsKnowledgePanel RepositoryAlias="@ActiveKnowledgeRepositoryAlias" />,
        _ => RenderBacklogKnowledge()
    };

    private sealed record KnowledgeArea(string Key, string Label);
    private RenderFragment RenderBacklogKnowledge() =>
        @<aside class="knowledge-pane" data-testid="backlog-knowledge-pane" aria-labelledby="backlog-knowledge-title">
            <div class="knowledge-pane__header">
                <p class="knowledge-pane__eyebrow">Knowledge base</p>
                <h2 id="backlog-knowledge-title">.backlog work items</h2>
                <p class="knowledge-pane__subtitle">Repository-authored Items and Sub-items, shown beside the active backlog.</p>
            </div>

            @if (_backlogKnowledge is null)
            {
                <p class="knowledge-empty">Loading repository knowledge...</p>
            }
            else if (!_backlogKnowledge.IsReady)
            {
                <div class="knowledge-empty" role="status">
                    <p>@_backlogKnowledge.Message</p>
                    <a href="settings">Open repository settings</a>
                </div>
            }
            else if (_backlogKnowledge.Concerns.Count == 0)
            {
                <div class="knowledge-empty" role="status">
                    <p>No authored .backlog Markdown files were found.</p>
                    <span>@_backlogKnowledge.Directory</span>
                </div>
            }
            else
            {
                <div class="knowledge-pane__source">
                    <span>@_backlogKnowledge.RepositoryFullName</span>
                    <code>@_backlogKnowledge.Directory</code>
                </div>

                <div class="knowledge-concerns">
                    @foreach (var concern in _backlogKnowledge.Concerns)
                    {
                        <article class="knowledge-concern" data-testid="backlog-knowledge-concern">
                            <header class="knowledge-concern__header">
                                <div>
                                    <h3>@concern.Title</h3>
                                    <code>@concern.RelativePath</code>
                                </div>
                                <span class="knowledge-count">@concern.Items.Count item@(concern.Items.Count == 1 ? string.Empty : "s")</span>
                            </header>

                            @RenderKnowledgeMetadata(concern.Metadata)

                            <div class="knowledge-items">
                                @foreach (var item in concern.Items)
                                {
                                    @RenderKnowledgeItem(item, isSubItem: false)
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </aside>;

    private RenderFragment RenderKnowledgeItem(BacklogWorkItemKnowledge item, bool isSubItem) =>
        @<article class="knowledge-item @(isSubItem ? "knowledge-item--sub" : string.Empty)" data-testid="backlog-knowledge-item">
            <header class="knowledge-item__header">
                <h4>@item.Title</h4>
                @if (TryMetadata(item.Metadata, "status") is { Length: > 0 } status)
                {
                    <span class="badge badge--status status-accent--@status.ToLowerInvariant()">@status</span>
                }
            </header>

            @RenderKnowledgeMetadata(item.Metadata)

            @if (item.Description.Count > 0)
            {
                <div class="knowledge-item__body">
                    <MarkdownView Blocks="@item.Description" />
                </div>
            }

            @if (item.SubItems.Count > 0)
            {
                <div class="knowledge-subitems">
                    @foreach (var subItem in item.SubItems)
                    {
                        @RenderKnowledgeItem(subItem, isSubItem: true)
                    }
                </div>
            }
        </article>;

    private RenderFragment RenderKnowledgeMetadata(IReadOnlyDictionary<string, string> metadata) =>
        @<div class="knowledge-meta" aria-label="Knowledge metadata">
            @foreach (var pair in metadata)
            {
                <span class="knowledge-meta__chip">
                    <strong>@pair.Key</strong>
                    <span>@pair.Value</span>
                </span>
            }
        </div>;

    private static string? TryMetadata(IReadOnlyDictionary<string, string> metadata, string key) =>
        metadata.TryGetValue(key, out var value) ? value : null;
    private RenderFragment RenderEntryMetadata(EntryRow row, bool oneLine) =>
        @<div class="entry-doc__meta" @onclick:stopPropagation="true">
            <span class="entry-doc__meta-start">
                <span class="badge badge--type" data-testid="type-badge">@Humanize(row.PreviewType.ToString())</span>
                <span class="badge badge--priority badge--priority-@row.PreviewPriority.ToString().ToLowerInvariant()" data-testid="priority-badge">@Humanize(row.PreviewPriority.ToString())</span>

                @if (!string.IsNullOrEmpty(row.PreviewArea))
                {
                    <span class="badge badge--area" data-testid="area-badge">@("@" + row.PreviewArea)</span>
                }

                @if (row.SubItemCount > 0)
                {
                    <span class="badge badge--progress" data-testid="progress-text">@row.ProgressText</span>
                }
            </span>

            @if (oneLine)
            {
                @if (row.PreviewTags.Count > 0)
                {
                    <span class="entry-doc__tags">
                        @foreach (var tag in row.PreviewTags)
                        {
                            <span class="tag-chip" data-testid="entry-tag">#@tag</span>
                        }
                    </span>
                }
                else
                {
                    <span class="entry-doc__tags" aria-hidden="true"></span>
                }
            }

            <span class="entry-doc__meta-end">
                @if (!oneLine && row.PreviewTags.Count > 0)
                {
                    <span class="entry-doc__tags entry-doc__tags--end">
                        @foreach (var tag in row.PreviewTags)
                        {
                            <span class="tag-chip" data-testid="entry-tag">#@tag</span>
                        }
                    </span>
                }

                @if (IsFeatureEnabled(AppFeatureSettingsStore.GitHubIntegration) && State.GitHubConfigured)
                {
                    var repository = RepositoryFor(row);

                    @if (row.IssueLink is { } link)
                    {
                        <a class="badge badge--gh badge--gh-@(GitHubStateClass(row.Snapshot?.Issue.State))"
                           data-testid="github-issue-badge"
                           href="@link.Url"
                           target="_blank"
                           rel="noopener"
                           title="@link.RepoFullName issue @link.Label">
                            @link.Label
                            <span class="badge__state">@GitHubStateLabel(row.Snapshot?.Issue.State)</span>
                        </a>

                        @if (row.Snapshot?.Headline is { } pull)
                        {
                            <a class="badge badge--gh badge--gh-@(GitHubStateClass(pull.State))"
                               data-testid="github-pr-badge"
                               href="@pull.Url"
                               target="_blank"
                               rel="noopener"
                               title="@pull.Title">
                                PR #@pull.Number
                                <span class="badge__state">@GitHubStateLabel(pull.State)</span>
                            </a>
                        }

                        <button type="button"
                                class="entry-doc__gh"
                                data-testid="github-refresh-button"
                                disabled="@row.GitHubBusy"
                                title="Check this issue on GitHub"
                                aria-label="Check this issue on GitHub"
                                @onmousedown:preventDefault="true"
                                @onclick="() => State.RefreshGitHubAsync(row)">
                            @(row.GitHubBusy ? "…" : "↻")
                        </button>
                    }
                    else if (repository is not null && row.IsPersisted)
                    {
                        <button type="button"
                                class="entry-doc__gh entry-doc__gh--push"
                                data-testid="github-push-button"
                                disabled="@row.GitHubBusy"
                                title="Create an issue in @repository.FullName"
                                @onmousedown:preventDefault="true"
                                @onclick="() => State.PushToGitHubAsync(row)">
                            @(row.GitHubBusy ? "Pushing…" : "Push to GitHub")
                        </button>
                    }
                }

                @if (IsFeatureEnabled(AppFeatureSettingsStore.CopilotCli) && row.IsPersisted)
                {
                    <button type="button"
                            class="entry-doc__gh entry-doc__copilot"
                            data-testid="copilot-cli-button"
                            disabled="@row.CopilotBusy"
                            title="Start GitHub Copilot CLI for this entry"
                            @onmousedown:preventDefault="true"
                            @onclick="() => State.StartCopilotCliAsync(row)">
                        @(row.CopilotBusy ? "Starting..." : "Copilot CLI")
                    </button>
                }

                @if (!row.IsPersisted)
                {
                    <span class="badge badge--draft" data-testid="draft-hint">Unsaved — give it a title line</span>
                }

                <span class="badge badge--status badge--status-@row.PreviewStatus.ToString().ToLowerInvariant()" data-testid="status-badge">@Humanize(row.PreviewStatus.ToString())</span>

                <button type="button"
                        class="entry-doc__delete"
                        id="delete-entry-@row.Key"
                        data-testid="delete-entry-button"
                        aria-label="Delete entry"
                        @onmousedown:preventDefault="true"
                        @onclick="() => OnDeleteEntryAsync(row)">
                    ✕
                </button>
            </span>
        </div>;

    /// <summary>The grab areas around an entry — one on each side. All four are
    /// drag sources and drop targets. Only the top rail takes tab focus (four
    /// stops per entry would wreck keyboard travel through the list), and it
    /// carries the arrow-key reorder that every drag needs an equivalent
    /// for.</summary>
    private RenderFragment RenderGrip(EntryRow row, bool before, string side) =>
        @<button type="button"
                 class="entry-doc__grip entry-doc__grip--@side"
                 data-testid="entry-grip-@side"
                 data-drag-grip="@row.Key"
                 draggable="true"
                 tabindex="@(side == "top" ? "0" : "-1")"
                 aria-hidden="@(side == "top" ? "false" : "true")"
                 aria-label="Reorder entry — drag, or use the up and down arrow keys"
                 @ondragstart="() => State.BeginDrag(row)"
                 @ondragend="() => State.EndDrag()"
                 @ondragover:preventDefault="true"
                 @ondragenter:preventDefault="true"
                 @ondrop="() => State.DropAsync(row, before)"
                 @onkeydown="e => OnGripKeyDownAsync(row, e)">
            <span class="entry-doc__grip-dots" aria-hidden="true"></span>
        </button>;


    private async Task OnToolsToggleAsync()
    {
        _toolsExpanded = !_toolsExpanded;
        if (_toolsExpanded && _tools.Count == 0)
        {
            await RefreshToolsAsync();
        }
    }

    private async Task RefreshToolsAsync()
    {
        _toolsLoading = true;
        _toolMessage = null;
        try
        {
            var catalog = await CopilotTools.ListAsync();
            _tools = catalog.Tools;
            _toolMessage = catalog.Message;
        }
        catch (Exception ex)
        {
            _toolMessage = $"Tools could not be checked: {ex.Message}";
        }
        finally
        {
            _toolsLoading = false;
        }
    }

    private async Task ApplyToolActionAsync(CopilotToolInfo tool, CopilotToolAction action)
    {
        _toolActionKey = tool.Key;
        try
        {
            var result = action switch
            {
                CopilotToolAction.Update => await CopilotTools.UpdateAsync(tool.Key),
                CopilotToolAction.Enable => await CopilotTools.EnableAsync(tool.Key),
                CopilotToolAction.Disable => await CopilotTools.DisableAsync(tool.Key),
                _ => CopilotToolActionResult.Failed("Unknown tool action.")
            };

            _toolMessage = result.Message;
            if (result.Succeeded)
            {
                await RefreshToolsAsync();
            }
        }
        finally
        {
            _toolActionKey = null;
        }
    }
    private void HandleStateChanged() => InvokeAsync(StateHasChanged);


    private async Task CheckForUpdatesAsync()
    {
        if (_updateBusy) return;

        _checkingForAppUpdate = true;
        _appUpdateMessage = null;
        _appUpdateReady = false;

        try
        {
            var result = await Updates.CheckForUpdateAsync();
            _appUpdateReady = result.UpdateReady;
            _appUpdateMessage = result.Message;
            _appUpdateStatusClass = result.Availability switch
            {
                AppUpdateAvailability.UpToDate => "setting__status--ok",
                AppUpdateAvailability.Failed => "setting__status--error",
                _ => string.Empty
            };
        }
        catch
        {
            _appUpdateReady = false;
            _appUpdateMessage = "The update check could not be completed.";
            _appUpdateStatusClass = "setting__status--error";
        }
        finally
        {
            _checkingForAppUpdate = false;
        }
    }

    private async Task InstallUpdateAsync()
    {
        if (_updateBusy) return;

        _installingAppUpdate = true;

        try
        {
            var result = await Updates.StartUpdateAsync();
            _appUpdateMessage = result.Message;
            _appUpdateStatusClass = result.Started ? "setting__status--ok" : "setting__status--error";
            if (!result.Started) _appUpdateReady = false;
        }
        catch
        {
            _appUpdateMessage = "The update could not be installed.";
            _appUpdateStatusClass = "setting__status--error";
        }
        finally
        {
            _installingAppUpdate = false;
        }
    }
    private void ToggleKnowledgePane() => _knowledgeExpanded = !_knowledgeExpanded;

    private void OnNewEntry() => State.NewRow();

    private async Task OnEndEditAsync(EntryRow row) => await State.EndEditAsync(row);

    private async Task OnDeleteEntryAsync(EntryRow row) => await State.DeleteRowAsync(row);

    private void OnFilterChanged(string wire) => State.SetStatusFilter(wire);

    private async Task OnEditorKeyDownAsync(EntryRow row, KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await State.EndEditAsync(row);
    }

    private void OnReadViewKeyDown(EntryRow row, KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") State.BeginEdit(row);
    }

    private async Task OnGripKeyDownAsync(EntryRow row, KeyboardEventArgs e)
    {
        if (e.Key == "ArrowUp") await State.MoveAsync(row, -1);
        else if (e.Key == "ArrowDown") await State.MoveAsync(row, 1);
    }

    private async Task OnSubItemGripKeyDownAsync(EntryRow row, int index, KeyboardEventArgs e)
    {
        if (e.Key == "ArrowUp") await State.MoveSubItemAsync(row, index, -1);
        else if (e.Key == "ArrowDown") await State.MoveSubItemAsync(row, index, 1);
    }

    private static string Humanize(string enumName)
    {
        var text = System.Text.RegularExpressions.Regex.Replace(enumName, "(?<!^)([A-Z])", " $1");
        return text.ToLowerInvariant();
    }

    /// <summary>"never checked" is a real, distinct answer from "open" — the
    /// badge says so rather than implying a state nobody has verified.</summary>
    private static string GitHubStateLabel(GitHubItemState? state) => state switch
    {
        GitHubItemState.Open => "open",
        GitHubItemState.Draft => "draft",
        GitHubItemState.Merged => "merged",
        GitHubItemState.Closed => "closed",
        _ => "not checked"
    };

    private static string GitHubStateClass(GitHubItemState? state) =>
        state?.ToString().ToLowerInvariant() ?? "unknown";

    public void Dispose()
    {
        State.Changed -= HandleStateChanged;
    }
}

