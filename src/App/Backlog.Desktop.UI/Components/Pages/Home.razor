            </span>

            <span class="entry-doc__meta-end">
                <span class="entry-doc__tags entry-doc__tags--end">
                    @RenderSubItemTagEditor(row, subItem, position)
                </span>

                <label class="status-editor badge badge--status badge--status-@((subItem.Status ?? (subItem.Done ? EntryStatus.Done : EntryStatus.Draft)).ToString().ToLowerInvariant())" data-testid="subitem-status-badge">
                    <span class="sr-only">Change sub-item status</span>
                    <select class="status-editor__select"
                            value="@(subItem.Status ?? (subItem.Done ? EntryStatus.Done : EntryStatus.Draft))"
                            aria-label="Change sub-item status"
                            title="Change sub-item status"
                            @onchange="e => OnSubItemStatusChangedAsync(row, position, e)">
                        @foreach (var status in StatusOptions())
                        {
                            <option value="@status">@Humanize(status.ToString())</option>
                        }
                    </select>
                </label>

                <span class="entry-doc__actions" aria-label="Sub-item actions">
                    @if (subItem.HasCheckbox)
                    {
                        <button type="button"
                                class="subitem-card__action"
                                aria-label="@(subItem.Done ? "Mark sub-item not done" : "Mark sub-item done")"
                                @onmousedown:preventDefault="true"
                                @onclick="() => State.ToggleSubItemAsync(row, position)">@(subItem.Done ? "Open" : "Done")</button>
                    }

                    <button type="button"
                            class="subitem-card__action"
                            aria-label="Edit sub-item"
                            @onmousedown:preventDefault="true"
                            @onclick="() => State.BeginEdit(row)">Edit</button>

                    @if (IsFeatureEnabled(AppFeatureSettingsStore.CopilotCli) && row.IsPersisted)
                    {
                        <button type="button"
                                class="entry-doc__icon-action entry-doc__icon-action--copilot"
                                data-testid="subitem-copilot-cli-button"
                                disabled="@row.CopilotBusy"
                                title="Start GitHub Copilot CLI from the parent entry"
                                aria-label="Start GitHub Copilot CLI from the parent entry"
                                @onmousedown:preventDefault="true"
                                @onclick="() => State.StartCopilotCliAsync(row)">
                            @if (row.CopilotBusy)
                            {
                                <span aria-hidden="true">…</span>
                            }
                            else
                            {
                                <span class="entry-doc__cli-mark" aria-hidden="true">gh</span>
                            }
                        </button>
                    }
                </span>
            </span>
        </div>;

    private RenderFragment RenderSubItemTagEditor(EntryRow row, MdSubItem subItem, int position) =>
        @<label class="entry-doc__tag-picker">
            <span class="sr-only">Edit sub-item tags</span>
            <input class="entry-doc__tag-input"
                   data-testid="subitem-tags-input"
                   aria-label="Edit sub-item tags"
                   title="Edit sub-item tags"
                   list="entry-tags-options-@row.Key"
                   placeholder="Tags"
                   value="@TagsInputValue(subItem)"
                   @onchange="e => OnSubItemTagsChangedAsync(row, position, e)" />
        </label>;
    private RenderFragment RenderTagEditor(EntryRow row) =>
        @<label class="entry-doc__tag-picker">
            <span class="sr-only">Edit tags</span>
            <input class="entry-doc__tag-input"
                   data-testid="entry-tags-input"
                   aria-label="Edit tags"
                   title="Edit tags"
                   list="entry-tags-options-@row.Key"
                   placeholder="Tags"
                   value="@TagsInputValue(row)"
                   @onchange="e => OnTagsChangedAsync(row, e)" />
            <datalist id="entry-tags-options-@row.Key">
                @foreach (var tag in TagOptions(row))
                {
                    <option value="#@tag"></option>
                }
            </datalist>
        </label>;
    /// <summary>The grab areas around an entry — one on each side. All four are
    /// drag sources and drop targets. Only the top rail takes tab focus (four
    /// stops per entry would wreck keyboard travel through the list), and it
    /// carries the arrow-key reorder that every drag needs an equivalent
    /// for.</summary>
    private RenderFragment RenderGrip(EntryRow row, bool before, string side) =>
        @<button type="button"
                 class="entry-doc__grip entry-doc__grip--@side"
                 data-testid="entry-grip-@side"
                 data-drag-grip="@row.Key"
                 draggable="true"
                 tabindex="@(side == "top" ? "0" : "-1")"
                 aria-hidden="@(side == "top" ? "false" : "true")"
                 aria-label="Reorder entry — drag, or use the up and down arrow keys"
                 @ondragstart="() => State.BeginDrag(row)"
                 @ondragend="() => State.EndDrag()"
                 @ondragover:preventDefault="true"
                 @ondragenter:preventDefault="true"
                 @ondrop="() => State.DropAsync(row, before)"
                 @onkeydown="e => OnGripKeyDownAsync(row, e)">
            <span class="entry-doc__grip-dots" aria-hidden="true"></span>
        </button>;


    private async Task OnToolsToggleAsync()
    {
        _toolsExpanded = !_toolsExpanded;
        if (_toolsExpanded && _tools.Count == 0)
        {
            await RefreshToolsAsync();
        }
    }

    private async Task RefreshToolsAsync()
    {
        _toolsLoading = true;
        _toolMessage = null;
        try
        {
            var catalog = await CopilotTools.ListAsync();
            _tools = catalog.Tools;
            _toolMessage = catalog.Message;
        }
        catch (Exception ex)
        {
            _toolMessage = $"Tools could not be checked: {ex.Message}";
        }
        finally
        {
            _toolsLoading = false;
        }
    }

    private async Task UpdateAllToolsAsync()
    {
        _toolActionKey = "__all__";
        try
        {
            var result = await CopilotTools.UpdateAllAsync();
            _toolMessage = result.Message;
            if (result.Succeeded)
            {
                await RefreshToolsAsync();
            }
        }
        finally
        {
            _toolActionKey = null;
        }
    }

    private async Task ApplyToolActionAsync(CopilotToolInfo tool, CopilotToolAction action)
    {
        _toolActionKey = tool.Key;
        try
        {
            var result = action switch
            {
                CopilotToolAction.Update => await CopilotTools.UpdateAsync(tool.Key),
                CopilotToolAction.Enable => await CopilotTools.EnableAsync(tool.Key),
                CopilotToolAction.Disable => await CopilotTools.DisableAsync(tool.Key),
                _ => CopilotToolActionResult.Failed("Unknown tool action.")
            };

            _toolMessage = result.Message;
            if (result.Succeeded)
            {
                await RefreshToolsAsync();
            }
        }
        finally
        {
            _toolActionKey = null;
        }
    }
    private void HandleStateChanged() => InvokeAsync(StateHasChanged);


    private async Task CheckForUpdatesAsync()
    {
        if (_updateBusy) return;

        _checkingForAppUpdate = true;
        _appUpdateMessage = null;
        _appUpdateReady = false;

        try
        {
            var result = await Updates.CheckForUpdateAsync();
            _appUpdateReady = result.UpdateReady;
            _appUpdateMessage = result.Message;
            _appUpdateStatusClass = result.Availability switch
            {
                AppUpdateAvailability.UpToDate => "setting__status--ok",
                AppUpdateAvailability.Failed => "setting__status--error",
                _ => string.Empty
            };
        }
        catch
        {
            _appUpdateReady = false;
            _appUpdateMessage = "The update check could not be completed.";
            _appUpdateStatusClass = "setting__status--error";
        }
        finally
        {
            _checkingForAppUpdate = false;
        }
    }

    private async Task InstallUpdateAsync()
    {
        if (_updateBusy) return;

        _installingAppUpdate = true;

        try
        {
            var result = await Updates.StartUpdateAsync();
            _appUpdateMessage = result.Message;
            _appUpdateStatusClass = result.Started ? "setting__status--ok" : "setting__status--error";
            if (!result.Started) _appUpdateReady = false;
        }
        catch
        {
            _appUpdateMessage = "The update could not be installed.";
            _appUpdateStatusClass = "setting__status--error";
        }
        finally
        {
            _installingAppUpdate = false;
        }
    }
    private void ToggleKnowledgePane() => _knowledgeExpanded = !_knowledgeExpanded;

