@*
    The Devbook block on each repository's card: where the repository's devbook is
    read from, and which of its knowledge folders Backlog reads.

    The Repositories page is the Tasks module's, and a module UI may not reach
    Devbook, so this block is the shell's and reaches the card as a
    RepositorySettingsPart (AddRepositoryDevbookSettings). The card renders it once
    per repository with the repository's alias; everything else it reads from the
    container, and it redraws when the folder source announces a change - a setting
    saved anywhere, the workspace moving, or a branch snapshot landing.

    The namespace is the shell's, for the reason the note at the top of
    Settings.razor gives: a component in a ...UI.Settings namespace shadows the
    settings screen. The imports this folder's missing _Imports would have
    carried are written below.
*@
@namespace Backlog.Desktop.UI.Shell
@using Backlog.Modules.Devbook.Abstractions
@* Said in writing, which is the rule this project's _Imports.razor states for
   reaching into a context. The devbook-source control is Devbook's, and
   this block offers the same one its pane does rather than a second copy. *@
@using Backlog.Desktop.UI.Devbook
@using Backlog.UI.Components.Selects
@implements IDisposable
@inject GitHubIntegration GitHub
@inject IDevbookFolderSource DevbookFolders
@inject DevbookSourceSelection DevbookSource

@if (Repository is { } activeRepo)
{
<div>
    @* Where this repository's knowledge is read from.
       One control for what is stored as two settings:
       the branch travels with the workspace, the
       decision to read the clone instead is this
       machine's, and nobody choosing between them
       thinks of that as two questions. *@
    <div class="repo-card__section" data-testid="repo-devbook-source">
        <h4 class="devbook-folders__title">Devbook source</h4>
        @* Keyed for the reason the pane's copy is:
           loading the branch list has to rebuild the
           control, or the browser keeps the value of
           the entry that triggered the load and shows
           a branch nobody selected. *@
        <SelectField @key="@($"{activeRepo.Alias}:{DevbookSource.HasBranches(activeRepo.Alias)}")"
                     LabelCssClass="setting__label"
                     SelectCssClass="setting__input"
                     Label="Read the devbook from"
                     Id="@($"devbook-source-{activeRepo.Alias}")"
                     TestId="repo-devbook-source-select"
                     CurrentValue="@DevbookSource.CurrentValue(activeRepo.Alias)"
                     Options="@DevbookSource.Options(activeRepo.Alias)"
                     OnChanged="value => ApplyDevbookSourceAsync(activeRepo, value)" />
        <p class="setting__status" data-testid="repo-devbook-source-status" role="status">
            @DevbookSource.Summary(activeRepo.Alias)
        </p>
        <div class="setting__actions">
            <AppButton Variant="ButtonVariant.None"
                       data-testid="repo-devbook-branches-button"
                       Disabled="@_loadingBranches"
                       OnClick="() => LoadBranchesAsync(activeRepo)">
                @(_loadingBranches ? "Loading branches..." : "Load branches")
            </AppButton>
        </div>
        <Alert Message="@_branchError" TestId="repo-devbook-branches-error" />
    </div>

    <div class="devbook-folders" data-testid="devbook-folder-settings">
        <h4 class="devbook-folders__title">Devbook sections</h4>
        <p class="setting__note">
            Repository knowledge folders default to their conventional paths.
            Clear an override to return to the default, or turn a section off for this repository.
            Instructions are on/off only and use Backlog's standard repository discovery.
        </p>

        <div class="devbook-folder-list">
            @foreach (var folder in activeRepo.DevbookFolders)
            {
                var devbookInputId = $"devbook-{activeRepo.Alias}-{folder.Key.TrimStart('.')}";

                @* Asked of the module port rather than checked here, so the row
                   reports what a reader of this folder would actually get - and
                   says "add a clone directory" or "not a valid path" where those
                   are the real answer, instead of a flat "missing". Nothing to
                   resolve for a section that is off or has no folder of its own. *@
                var location = folder.Enabled && folder.SupportsPathOverride
                    ? DevbookFolders.Resolve(folder.Key, activeRepo.Alias)
                    : null;

                <div class="devbook-folder" data-testid="devbook-folder-row">
                    <Checkbox CssClass="devbook-folder__toggle"
                              Label="@folder.DisplayName"
                              Checked="@folder.Enabled"
                              CheckedChanged="enabled => SetDevbookFolderEnabled(activeRepo, folder, enabled)"
                              data-testid="devbook-folder-enabled">
                        <code>@folder.Key</code>
                    </Checkbox>

                    @if (folder.SupportsPathOverride)
                    {
                        <TextField Bare="true"
                                   InputCssClass="setting__input"
                                   Id="@devbookInputId"
                                   data-testid="devbook-folder-path-input"
                                   spellcheck="false"
                                   autocomplete="off"
                                   Disabled="@(!folder.Enabled)"
                                   Placeholder="@folder.DefaultRelativePath"
                                   AriaLabel="@($"{activeRepo.FullName} {folder.DisplayName} folder path")"
                                   Value="@DevbookPathDraft(activeRepo, folder)"
                                   ValueChanged="value => _draftDevbookPaths[DevbookDraftKey(activeRepo.Alias, folder.Key)] = value"
                                   Suffix="@DevbookFolderMarker(location)"
                                   @onchange="() => ApplyDevbookFolderPath(activeRepo, folder)"
                                   @onkeydown="e => OnDevbookPathKeyDown(e, activeRepo, folder)" />
                    }

                    <p class="devbook-folder__status"
                       data-testid="devbook-folder-status"
                       data-folder-state="@DevbookFolderState(location)">
                        @if (!folder.Enabled)
                        {
                            <span>Off for this repository.</span>
                        }
                        else if (!folder.SupportsPathOverride)
                        {
                            <span>Uses standard repository instruction discovery.</span>
                        }
                        else
                        {
                            @if (string.IsNullOrWhiteSpace(folder.Path))
                            {
                                @* Resolution falls back to the legacy root folder on its own, so
                                   the row names the one it actually found: a repository still on
                                   the root layout should not read as if it were using .devbook/. *@
                                @if (location!.Available && location.Folder?.ResolvedPath is { } legacy)
                                {
                                    <span>Uses <code>@legacy</code> at the repository root, the layout before <code>@DevbookFolderSetting.DevbookRoot/</code>.</span>
                                }
                                else
                                {
                                    <span>Uses <code>@folder.DefaultRelativePath</code>.</span>
                                }
                            }
                            else
                            {
                                <span>Uses <code>@folder.EffectivePath</code>.</span>
                            }

                            @* Nothing is added when the folder is there: the marker in the
                               field above has already said so, and a sentence repeating it
                               was the redundancy. Only the absent case has something left
                               to say - which path was looked at, or that no clone directory
                               is configured yet - and the reason comes from the port rather
                               than being reworded here, because which of the three ways a
                               folder can be absent it is decides what to do about it. *@
                            @if (!location!.Available)
                            {
                                @* The space is written out because Razor drops whitespace-only
                                   text between elements, and these two spans are one sentence
                                   apiece: without it the line reads "at the repository
                                   root.Architecture knowledge folder was not found at ...". *@
                                @(" ")
                                @* A branch being fetched for the first time is news, not a
                                   fault: nothing here is wrong and nothing needs fixing, so it
                                   wears the pending modifier and the row re-renders when the
                                   folder source announces the download landed. *@
                                <span class="@(location.Pending ? "devbook-folder__status--pending" : "devbook-folder__status--error")">@location.Message</span>
                            }
                        }
                    </p>
                </div>
            }
        </div>
        @* What the last Devbook setting saved here was refused for, said on
           this block: the status line under the repositories box is the
           Repositories page's. *@
        <Alert Message="@_settingError" TestId="repo-devbook-setting-error" />
    </div>
</div>
}

@code {
    /// <summary>The alias of the repository whose card this block is on.</summary>
    [Parameter, EditorRequired]
    public string RepositoryAlias { get; set; } = string.Empty;

    private readonly Dictionary<string, string> _draftDevbookPaths = new(StringComparer.OrdinalIgnoreCase);
    private bool _loadingBranches;
    private string? _branchError;

    /// <summary>The refusal of the last Devbook setting saved here, said on this
    /// block now that the card's status line is the Repositories page's.</summary>
    private string? _settingError;

    /// <summary>The card's repository, read from the store on every render so the
    /// block shows what is stored.</summary>
    private GitHubRepositoryRef? Repository =>
        GitHub.Repositories.FirstOrDefault(repo => string.Equals(repo.Alias, RepositoryAlias, StringComparison.Ordinal));

    protected override void OnInitialized()
    {
        // A branch snapshot fetched in the background lands on a thread that is
        // not this one, and the section rows are what show "fetching" until it
        // does - hence the marshal, and hence subscribing at all.
        DevbookFolders.Changed += OnDevbookFoldersChanged;
        SyncDrafts();
    }

    public void Dispose() => DevbookFolders.Changed -= OnDevbookFoldersChanged;

    private void OnDevbookFoldersChanged() => _ = InvokeAsync(() =>
    {
        SyncDrafts();
        StateHasChanged();
    });

    /// <summary>
    /// The devbook-source control is <see cref="DevbookSourceSelection"/>'s,
    /// not this block's. The pane offers the same choice, and two copies of the
    /// options would drift the first time a case was added to one of them.
    /// </summary>
    private async Task ApplyDevbookSourceAsync(GitHubRepositoryRef repository, string? value)
    {
        if (DevbookSourceSelection.IsLoadRequest(value))
        {
            await LoadBranchesAsync(repository);
            return;
        }

        _settingError = DevbookSource.Select(repository.Alias, value);
        SyncDrafts();
    }

    private async Task LoadBranchesAsync(GitHubRepositoryRef repository)
    {
        _branchError = null;
        _loadingBranches = true;

        try
        {
            _branchError = await DevbookSource.LoadBranchesAsync(repository.Alias, CancellationToken.None);
        }
        finally
        {
            _loadingBranches = false;
        }
    }

    /// <summary>
    /// The badge inside the path field, or nothing at all for a section that was
    /// never looked up - off, or with no folder of its own. Returning null rather
    /// than an empty fragment is what keeps the field's suffix box off those rows
    /// entirely, so their input keeps the width it always had.
    /// </summary>
    /// <remarks>
    /// The sentence under the field no longer says "Folder found.", so this badge
    /// is where that fact lives: it carries its own accessible name rather than
    /// leaving the answer to the colour, and the two states differ by glyph as
    /// well as by fill for a reader who sees neither.
    /// </remarks>
    private static RenderFragment? DevbookFolderMarker(DevbookFolderLocation? location)
    {
        if (location is null) return null;

        return location.Available
            ? @<span class="devbook-folder__marker devbook-folder__marker--found"
                     data-testid="devbook-folder-marker"
                     role="img"
                     aria-label="Folder found.">✓</span>
            : @<span class="devbook-folder__marker devbook-folder__marker--missing"
                     data-testid="devbook-folder-marker"
                     role="img"
                     aria-label="Folder not found.">✕</span>;
    }

    /// <summary>Whether the configured folder is there, for anything reading the row
    /// from outside - a test, or automation. Null for a section that was never looked
    /// up, so the attribute is left off rather than claiming a state it has not
    /// got.</summary>
    private static string? DevbookFolderState(DevbookFolderLocation? location) => location switch
    {
        null => null,
        { Available: true } => "found",
        { Pending: true } => "pending",
        _ => "missing"
    };

    private string DevbookPathDraft(GitHubRepositoryRef repo, DevbookFolderSetting folder)
    {
        var key = DevbookDraftKey(repo.Alias, folder.Key);
        if (!_draftDevbookPaths.TryGetValue(key, out var draft))
        {
            draft = folder.Path ?? string.Empty;
            _draftDevbookPaths[key] = draft;
        }

        return draft;
    }

    private void SetDevbookFolderEnabled(GitHubRepositoryRef repo, DevbookFolderSetting folder, bool enabled)
    {
        _settingError = GitHub.Settings.SetDevbookFolder(
            repo.Alias,
            folder.Key,
            enabled,
            DevbookPathDraft(repo, folder));
        SyncDrafts();
    }

    private void ApplyDevbookFolderPath(GitHubRepositoryRef repo, DevbookFolderSetting folder)
    {
        _settingError = GitHub.Settings.SetDevbookFolder(
            repo.Alias,
            folder.Key,
            folder.Enabled,
            DevbookPathDraft(repo, folder));
        SyncDrafts();
    }

    private void OnDevbookPathKeyDown(KeyboardEventArgs e, GitHubRepositoryRef repo, DevbookFolderSetting folder)
    {
        if (e.Key == "Enter") ApplyDevbookFolderPath(repo, folder);
        else if (e.Key == "Escape") _draftDevbookPaths[DevbookDraftKey(repo.Alias, folder.Key)] = folder.Path ?? string.Empty;
    }

    /// <summary>Refills the path drafts from the store: after a save here, and after
    /// any change the folder source announces, as the page did for every card when
    /// it held these rows itself.</summary>
    private void SyncDrafts()
    {
        if (Repository is not { } repo) return;

        foreach (var folder in repo.DevbookFolders)
        {
            _draftDevbookPaths[DevbookDraftKey(repo.Alias, folder.Key)] = folder.Path ?? string.Empty;
        }
    }

    private static string DevbookDraftKey(string alias, string folderKey) => $"{alias}|{folderKey}";
}
