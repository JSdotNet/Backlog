@*
    One page of the Settings screen, in a file of its own so a change to this
    page is a change to this file. The screen (Settings.razor) keeps the menu,
    the headline and the panel this is drawn in; what is on the page, and what it
    writes, is here.

    The namespace is the screen's rather than the folder's, and this folder has
    no _Imports.razor, for the reason the note at the top of Settings.razor
    gives.
*@
@namespace Backlog.Desktop.UI.Shell
@inherits SettingsPageBase
@* SelectField draws the credential choice; written here because this folder
   cannot have an _Imports of its own. *@
@using Backlog.UI.Components.Selects
@inject GitHubIntegration GitHub
@inject IJSRuntime JS

@* The page's sentence in the frame's headline: how many identities this
   machine can speak as, and which one the GitHub CLI is using now. *@
<SettingsHeadline><span data-testid="accounts-headline">@Headline</span></SettingsHeadline>

<p class="setting__status" id="github-accounts-status" data-testid="github-accounts-status" role="status">
    @if (_accountMessage is not null)
    {
        <span class="setting__status--error">@_accountMessage</span>
    }
</p>

@* A binding this machine cannot meet is a real state with a name, not
   a fault: it is the ordinary day-one shape of a second install. It is
   said here as well as on the repository's own card, because this panel
   is the place somebody comes to fix it. *@
@foreach (var unsatisfied in UnsatisfiedBindings())
{
    <p class="setting__status" data-testid="unsatisfied-binding" role="status">
        <span class="setting__status--error">@unsatisfied</span>
    </p>
}

<SettingsCard Title="GitHub accounts"
              Description="Signed in through the GitHub CLI. Each repository picks the account it reads with."
              TestId="github-accounts-card">
    <Action>
        <AppButton TestId="accounts-add-button" OnClick="FocusAddAccountAsync">
            Add account
        </AppButton>
    </Action>
    <ChildContent>
        @if (ConfiguredAccounts.Count == 0)
        {
            <p class="setting__note" data-testid="github-accounts-empty">
                No account yet. Every call goes out as whichever account this machine is
                signed in as, which is what Backlog has always done.
            </p>
        }
        else
        {
            @* One row per account; choosing a row opens its card under it, across
               the whole grid, and closes the one that was open. *@
            <ul class="account-list" data-testid="account-list">
                @foreach (var account in ConfiguredAccounts)
                {
                    var row = account;
                    var open = IsExpanded(row);

                    <li @key="row.Login" class="account-list__row">
                        <AppButton Variant="ButtonVariant.None"
                                   BaseClass="account-row"
                                   CssClass="@(open ? "account-row--expanded" : null)"
                                   TestId="account-row"
                                   aria-expanded="@(open ? "true" : "false")"
                                   aria-controls="@(open ? EditorId(row) : null)"
                                   OnClick="() => ToggleAccount(row)">
                            <span class="account-row__avatar" aria-hidden="true">@Initial(row)</span>
                            <span class="account-row__text">
                                <span class="account-row__login">@row.Login</span>
                                <span class="account-row__meta" data-testid="account-row-meta">@RowMeta(row)</span>
                            </span>
                        </AppButton>
                    </li>

                    @if (open && ExpandedAccount is { } expanded)
                    {
                        <li @key="@("editor:" + expanded.Login)" class="account-list__editor">
                            <article class="repo-card"
                                     id="@EditorId(expanded)"
                                     data-testid="github-account-card"
                                     aria-label="@($"{expanded.Login} account settings")">
                                <header class="repo-card__header">
                                    <div>
                                        <h3 class="repo-card__title">@expanded.Login</h3>
                                        <p class="repo-card__meta">
                                            <code>@(expanded.Host ?? "github.com")</code>
                                        </p>
                                    </div>

                                    <AppButton Variant="ButtonVariant.None"
                                               TestId="remove-account-button"
                                               OnClick="() => RemoveAccount(expanded)">
                                        Forget this account
                                    </AppButton>
                                </header>

                                <SetupSteps AriaLabel="Setting up this GitHub account"
                                            TestId="github-account-setup-steps"
                                            Steps="@GitHubSetupSteps(expanded)" />

                                @* A name picked from a list of two, which is the shape
                                   SelectField exists for. Not the colour swatches'
                                   radiogroup: those are a radiogroup because a colour
                                   has to be seen to be chosen, and a credential kind is
                                   a word. *@
                                <SelectField Form="true"
                                             Label="Credential"
                                             Id="@($"account-credential-{expanded.Login}")"
                                             TestId="account-credential-select"
                                             LabelCssClass="setting__label"
                                             SelectCssClass="setting__input"
                                             CurrentValue="@expanded.Credential.ToString()"
                                             Options="@CredentialKindOptions"
                                             HelpText="How this machine gets a token for this login when a call needs one."
                                             OnChanged="kind => ApplyAccountCredential(expanded, kind)" />

                                @if (expanded.Credential is GitHubCredentialKind.PersonalAccessToken)
                                {
                                    <TextField Bare="true"
                                               LabelCssClass="setting__label"
                                               InputCssClass="setting__input"
                                               Label="Personal access token"
                                               Id="@($"account-token-{expanded.Login}")"
                                               data-testid="account-token-input"
                                               type="password"
                                               spellcheck="false"
                                               autocomplete="off"
                                               Placeholder="@(expanded.HasToken ? "stored - hidden" : "ghp_...")"
                                               Value="@AccountTokenDraft(expanded)"
                                               ValueChanged="value => _draftAccountTokens[expanded.Login] = value"
                                               @onchange="() => ApplyAccountToken(expanded)"
                                               @onkeydown="e => OnAccountTokenKeyDown(e, expanded)" />

                                    <div class="setting__actions">
                                        <AppButton Variant="ButtonVariant.None"
                                                   TestId="account-clear-token-button"
                                                   Disabled="@(!expanded.HasToken)"
                                                   OnClick="() => ClearAccountToken(expanded)">
                                            Forget this token
                                        </AppButton>
                                    </div>
                                }

                                @* Where this login's API is. Blank follows the install-wide
                                   endpoint on the AI tab, which is every github.com account;
                                   a GitHub Enterprise Server login names its own here. *@
                                <TextField Bare="true"
                                           LabelCssClass="setting__label"
                                           InputCssClass="setting__input"
                                           Label="API endpoint (optional)"
                                           Id="@($"account-endpoint-{expanded.Login}")"
                                           data-testid="account-endpoint-input"
                                           Type="url"
                                           spellcheck="false"
                                           autocomplete="off"
                                           Placeholder="@GitHub.Settings.Current.ApiEndpoint"
                                           HelpText="Leave it empty to use the install-wide endpoint. Set it for a login on a GitHub Enterprise Server."
                                           Value="@AccountEndpointDraft(expanded)"
                                           ValueChanged="value => _draftAccountEndpoints[expanded.Login] = value"
                                           @onchange="() => ApplyAccountEndpoint(expanded)"
                                           @onkeydown="e => OnAccountEndpointKeyDown(e, expanded)" />

                                <p class="setting__status" data-testid="account-status" role="status">
                                    @if (Screen.AccountProblem(expanded) is { } problem)
                                    {
                                        <span class="setting__status--error">@problem</span>
                                    }
                                    else
                                    {
                                        <span>@AccountSummary(expanded)</span>
                                    }
                                </p>

                                @if (_accountChecks.GetValueOrDefault(expanded.Login) is { } accountCheck)
                                {
                                    <p class="setting__status" data-testid="account-check-status" role="status">
                                        @if (accountCheck.Passed)
                                        {
                                            <span>@accountCheck.Summary</span>
                                        }
                                        else
                                        {
                                            <span class="setting__status--error">@accountCheck.Summary</span>
                                        }
                                    </p>
                                }

                                <div class="setting__actions">
                                    <AppButton Variant="ButtonVariant.None"
                                               TestId="test-account-button"
                                               Busy="@_accountsTesting.Contains(expanded.Login)"
                                               BusyLabel="Asking GitHub"
                                               OnClick="() => TestAccountAsync(expanded)">
                                        Test this account
                                    </AppButton>
                                </div>

                                <p class="setting__note" data-testid="accounts-storage-note">
                                    Accounts are kept in <code>@GitHub.Settings.SettingsPath</code>, outside the backlog
                                    folder. Each account's login, name, host and endpoint sync to your paired devices;
                                    its token and whether it signs in through the GitHub CLI stay on this machine.
                                    A token the GitHub CLI hands over is never written down at all.
                                </p>
                            </article>
                        </li>
                    }
                }
            </ul>
        }
    </ChildContent>
</SettingsCard>

<div class="setting-columns">
    <div data-testid="gh-cli-accounts">
        <h3 class="devbook-folders__title">Signed in with the GitHub CLI</h3>
        <p class="setting__note">
            Adding one of these is the route that holds no secret: Backlog asks
            <code>gh</code> for a token when a call needs one and never writes it down,
            so the CLI keeps refreshing and revoking it.
        </p>

        @if (DiscoverableCliAccounts.Count == 0)
        {
            <p class="setting__note" data-testid="gh-cli-accounts-empty">
                @(Screen.CliAccounts.Count == 0
                    ? "The GitHub CLI reported no accounts on this machine. Add a login opposite and paste a personal access token for it instead."
                    : "Every account the GitHub CLI is signed in to is already configured.")
            </p>
        }
        else
        {
            <div class="setting__actions">
                @foreach (var discovered in DiscoverableCliAccounts)
                {
                    var candidate = discovered;

                    <AppButton Variant="ButtonVariant.None"
                               TestId="add-gh-cli-account-button"
                               OnClick="() => AddCliAccount(candidate)">
                        Add @candidate.Login
                    </AppButton>
                }
            </div>
        }

        <div class="setting__actions">
            <AppButton Variant="ButtonVariant.None"
                       TestId="gh-cli-accounts-refresh-button"
                       OnClick="Screen.RefreshCliAccountsAsync">
                Look again
            </AppButton>
        </div>
    </div>

    <div data-testid="add-account">
        <h3 class="devbook-folders__title">Add an account by login</h3>
        <p class="setting__note">
            For a machine without the GitHub CLI, or a login it does not know about.
            Leaving the field saves it, the way every other box on this page works.
            Give it a personal access token on its own card below.
        </p>

        <TextField Bare="true"
                   LabelCssClass="setting__label"
                   InputCssClass="@SettingsScreenContext.SettingInputClass(_accountMessage)"
                   Label="GitHub login"
                   Id="account-login"
                   data-testid="add-account-login-input"
                   spellcheck="false"
                   autocomplete="off"
                   aria-describedby="github-accounts-status"
                   Placeholder="octocat"
                   Value="@_draftAccountLogin"
                   ValueChanged="value => _draftAccountLogin = value"
                   @onchange="AddAccountFromDraft"
                   @onkeydown="OnAccountLoginKeyDown" />

        <div class="setting__actions">
            <AppButton Variant="ButtonVariant.None"
                       TestId="add-account-button"
                       OnClick="AddAccountFromDraft">
                Add account
            </AppButton>
        </div>
    </div>
</div>

@code {
    private readonly Dictionary<string, string> _draftAccountEndpoints = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _draftAccountTokens = new(StringComparer.OrdinalIgnoreCase);
    private string _draftAccountLogin = string.Empty;
    private string? _accountMessage;
    private string? _expandedAccountLogin;

    /// <summary>The two ways this machine can satisfy an account, in the order
    /// they are preferred. Static because the list is the enum and the enum does
    /// not change per render.</summary>
    private static readonly IReadOnlyList<SelectorOption> CredentialKindOptions =
    [
        new(nameof(GitHubCredentialKind.GhCli), "GitHub CLI"),
        new(nameof(GitHubCredentialKind.PersonalAccessToken), "Personal access token")
    ];

    private IReadOnlyList<GitHubAccount> ConfiguredAccounts => Screen.ConfiguredAccounts;

    /// <summary>The logins <c>gh</c> holds that are not configured yet - the whole
    /// reason this panel does not start with an empty text box. An account already
    /// configured is dropped rather than offered again, so the list is a list of
    /// things left to do.</summary>
    private IReadOnlyList<GhCliAccount> DiscoverableCliAccounts =>
        [.. Screen.CliAccounts.Where(candidate => GitHub.Settings.Current.Account(candidate.Login) is null)];

    /// <summary>The account whose card is open under its row, or null while every
    /// row is closed. One at a time: opening a row closes the one that was open.</summary>
    private GitHubAccount? ExpandedAccount =>
        string.IsNullOrWhiteSpace(_expandedAccountLogin) ? null : GitHub.Settings.Current.Account(_expandedAccountLogin);

    private bool IsExpanded(GitHubAccount account) =>
        ExpandedAccount is { } expanded && GitHubAccount.IsSameLogin(expanded.Login, account.Login);

    /// <summary>Choosing the open row closes it; choosing another opens that one
    /// instead.</summary>
    private void ToggleAccount(GitHubAccount account) =>
        _expandedAccountLogin = IsExpanded(account) ? null : GitHubAccount.NormalizeLogin(account.Login);

    private static string EditorId(GitHubAccount account) => $"account-editor-{account.Login}";

    /// <summary>The avatar's letter. Decorative: the login beside it is what is read.</summary>
    private static string Initial(GitHubAccount account) =>
        account.Login.Length == 0 ? "?" : char.ToUpperInvariant(account.Login[0]).ToString();

    /// <summary>The configured account the GitHub CLI is using now, or null when
    /// it is using none of them or there is no CLI to ask.</summary>
    private GitHubAccount? CliActiveAccount =>
        ConfiguredAccounts.FirstOrDefault(account => Screen.CliAccounts.Any(candidate =>
            candidate.Active && GitHubAccount.IsSameLogin(candidate.Login, account.Login)));

    private string Headline
    {
        get
        {
            var count = ConfiguredAccounts.Count;
            if (count == 0) return "No GitHub account is signed in yet.";

            var signedIn = count == 1 ? "1 GitHub account signed in" : $"{count} GitHub accounts signed in";

            return CliActiveAccount is { } active
                ? $"{signedIn}; {active.Login} is active."
                : $"{signedIn}.";
        }
    }

    /// <summary>What sits under a row's login: whether the CLI is using it now,
    /// and how many repositories are worked as it.</summary>
    private string RowMeta(GitHubAccount account)
    {
        var state = CliActiveAccount is { } active && GitHubAccount.IsSameLogin(active.Login, account.Login)
            ? "Active"
            : "Signed in";
        var repositories = BoundRepositoryCount(account);

        return $"{state} · {repositories} {(repositories == 1 ? "repository" : "repositories")}";
    }

    /// <summary>The repositories whose calls leave as this account - read the way
    /// the transport reads a binding, so the count is what would really happen.</summary>
    private int BoundRepositoryCount(GitHubAccount account) =>
        GitHub.Repositories
            .Select(Screen.RepositoryBinding)
            .Count(binding => binding.Account is not null && GitHubAccount.IsSameLogin(binding.Login, account.Login));

    /// <summary>The header's Add account: the login field and the CLI's logins are
    /// below the list, so it takes focus to the field.</summary>
    private async Task FocusAddAccountAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("backlogFocus", "account-login");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // Moving focus is a courtesy; the field is on the page either way.
        }
    }

    /// <summary>
    /// Adds the login <c>gh</c> reported, backed by the CLI.
    /// <para>
    /// github.com is the ordinary case and is stored as no host at all, so a host
    /// is only written down when it is a GitHub Enterprise Server one - otherwise
    /// every account on an ordinary machine would carry a value that means "the
    /// default" spelled out.
    /// </para>
    /// </summary>
    private void AddCliAccount(GhCliAccount candidate) => AddAccount(
        candidate.Login,
        GitHubCredentialKind.GhCli,
        string.Equals(candidate.Host, "github.com", StringComparison.OrdinalIgnoreCase) ? null : candidate.Host);

    /// <summary>Commits the typed login on blur or Enter. A blank box is not a
    /// refusal - leaving a field empty is the ordinary way of adding nothing, the
    /// same rule the repository token field follows - so it says nothing rather
    /// than reporting an error somebody did not ask for.</summary>
    private void AddAccountFromDraft()
    {
        if (string.IsNullOrWhiteSpace(_draftAccountLogin)) return;

        AddAccount(_draftAccountLogin, GitHubCredentialKind.GhCli, null);
    }

    private void AddAccount(string login, GitHubCredentialKind credential, string? host)
    {
        var normalized = GitHubAccount.NormalizeLogin(login);

        if (normalized is null)
        {
            _accountMessage = "Type the GitHub login to add.";
            return;
        }

        if (GitHub.Settings.Current.Account(normalized) is not null)
        {
            _accountMessage = $"'{normalized}' is already configured.";
            return;
        }

        _accountMessage = GitHub.Settings.SetAccounts(
        [
            .. ConfiguredAccounts,
            new GitHubAccount(normalized) { Credential = credential, Host = host }
        ]);

        _draftAccountLogin = string.Empty;

        // The card that just appeared is the one to be looking at: the credential
        // it needs is chosen there, and a CLI-backed login on a machine without
        // gh has to be switchable to a pasted token without hunting for it.
        if (_accountMessage is null) _expandedAccountLogin = normalized;
    }

    /// <summary>Forgets one account on this machine. The repositories bound to it
    /// are deliberately left alone by the store - the binding is workspace data and
    /// this is a machine act - so what is left behind is an unsatisfied binding,
    /// reported above rather than silently repaired.</summary>
    private void RemoveAccount(GitHubAccount account)
    {
        _accountMessage = GitHub.Settings.RemoveAccount(account.Login);
        _draftAccountTokens.Remove(account.Login);
        _draftAccountEndpoints.Remove(account.Login);

        if (GitHubAccount.IsSameLogin(_expandedAccountLogin, account.Login)) _expandedAccountLogin = null;
    }

    private void ApplyAccountCredential(GitHubAccount account, string? kind)
    {
        _accountChecks.Remove(account.Login);
        if (!Enum.TryParse<GitHubCredentialKind>(kind, ignoreCase: true, out var credential)) return;

        // A pasted token survives a change that keeps the kind that can hold one;
        // switching to the CLI drops it, which the store enforces anyway - a gho_
        // token is rotated by gh, so one written down would go stale and be sent.
        _accountMessage = GitHub.Settings.SetAccountCredential(
            account.Login,
            credential,
            credential is GitHubCredentialKind.PersonalAccessToken ? account.Token : null);
    }

    private string AccountTokenDraft(GitHubAccount account)
    {
        if (!_draftAccountTokens.TryGetValue(account.Login, out var draft))
        {
            draft = string.Empty;
            _draftAccountTokens[account.Login] = draft;
        }

        return draft;
    }

    private void ApplyAccountToken(GitHubAccount account)
    {
        var draft = AccountTokenDraft(account);
        if (string.IsNullOrWhiteSpace(draft)) return;

        _accountChecks.Remove(account.Login);

        _accountMessage = GitHub.Settings.SetAccountCredential(
            account.Login,
            GitHubCredentialKind.PersonalAccessToken,
            draft);
        _draftAccountTokens[account.Login] = string.Empty;
    }

    private void ClearAccountToken(GitHubAccount account)
    {
        _accountChecks.Remove(account.Login);
        _accountMessage = GitHub.Settings.SetAccountCredential(
            account.Login,
            GitHubCredentialKind.PersonalAccessToken,
            null);
        _draftAccountTokens[account.Login] = string.Empty;
    }

    private void OnAccountTokenKeyDown(KeyboardEventArgs e, GitHubAccount account)
    {
        if (e.Key == "Enter") ApplyAccountToken(account);
        else if (e.Key == "Escape") _draftAccountTokens[account.Login] = string.Empty;
    }

    private string AccountEndpointDraft(GitHubAccount account)
    {
        if (!_draftAccountEndpoints.TryGetValue(account.Login, out var draft))
        {
            draft = account.ApiEndpoint ?? string.Empty;
            _draftAccountEndpoints[account.Login] = draft;
        }

        return draft;
    }

    private void ApplyAccountEndpoint(GitHubAccount account)
    {
        _accountChecks.Remove(account.Login);
        _accountMessage = GitHub.Settings.SetAccountApiEndpoint(account.Login, AccountEndpointDraft(account));
        _draftAccountEndpoints[account.Login] = GitHub.Settings.Current.Account(account.Login)?.ApiEndpoint ?? string.Empty;
    }

    private void OnAccountEndpointKeyDown(KeyboardEventArgs e, GitHubAccount account)
    {
        if (e.Key == "Enter") ApplyAccountEndpoint(account);
        else if (e.Key == "Escape") _draftAccountEndpoints[account.Login] = account.ApiEndpoint ?? string.Empty;
    }

    private void OnAccountLoginKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddAccountFromDraft();
        else if (e.Key == "Escape") _draftAccountLogin = string.Empty;
    }

    /// <summary>What GitHub said the last time each account was tested, by login.
    /// Not persisted: it was true of the moment the button was pressed.</summary>
    private readonly Dictionary<string, GitHubAccountCheck> _accountChecks = new(StringComparer.OrdinalIgnoreCase);

    private readonly HashSet<string> _accountsTesting = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>The card's checklist, derived from the account each render. The
    /// credential step reads as done when nothing about it is a problem this
    /// machine can see; the test step, when GitHub agreed.</summary>
    private IReadOnlyList<SetupStep> GitHubSetupSteps(GitHubAccount account) =>
    [
        new(account.Credential is GitHubCredentialKind.GhCli
                ? $"Sign the GitHub CLI in as {account.Login}, or switch to a personal access token"
                : $"Create a personal access token for {account.Login} and paste it below",
            Screen.AccountProblem(account) is null,
            account.Credential is GitHubCredentialKind.GhCli
                ? "`gh auth login` on this machine; Backlog asks gh for a token when it needs one."
                : "A fine-grained token with access to the repositories worked as this account.",
            account.Credential is GitHubCredentialKind.GhCli ? null : "https://github.com/settings/personal-access-tokens",
            account.Credential is GitHubCredentialKind.GhCli ? null : "Open GitHub's personal access tokens page"),
        new("Name the API endpoint for a GitHub Enterprise Server login", !string.IsNullOrWhiteSpace(account.ApiEndpoint),
            "Leave it empty for github.com.", Optional: true),
        new("Test this account", _accountChecks.GetValueOrDefault(account.Login)?.Passed == true,
            "Asks GitHub whose credential this is, and holds the answer against the login above.")
    ];

    private async Task TestAccountAsync(GitHubAccount account)
    {
        if (!_accountsTesting.Add(account.Login)) return;

        _accountChecks.Remove(account.Login);
        StateHasChanged();

        try
        {
            _accountChecks[account.Login] = await GitHub.CheckAccountAsync(account);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _accountChecks[account.Login] = new GitHubAccountCheck(false, $"Couldn't ask GitHub: {ex.Message}");
        }
        finally
        {
            _accountsTesting.Remove(account.Login);
        }

        StateHasChanged();
    }

    private static string AccountSummary(GitHubAccount account) =>
        account.Credential is GitHubCredentialKind.PersonalAccessToken
            ? $"A personal access token is stored for '{account.Login}'."
            : $"Backlog asks the GitHub CLI for a token for '{account.Login}' when a call needs one, and never writes it down.";

    /// <summary>Every repository this workspace binds to a login this machine
    /// cannot satisfy. Empty on every install that never opened this panel.</summary>
    private IReadOnlyList<string> UnsatisfiedBindings() =>
    [
        .. GitHub.Repositories
            .Select(Screen.RepositoryBinding)
            .Where(binding => binding.IsUnsatisfied)
            .Select(SettingsScreenContext.BindingProblem)
    ];
}
