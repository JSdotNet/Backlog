    protected override Task OnInitializedAsync()
    {
        _devicePairing = Services.GetService<DevicePairingClient>();
        _deviceCredentials = Services.GetService<IDeviceCredentialStore>();
        // Optional the way the pairing client is: a head that composes the sync
