@page "/settings"
@*
    The namespace deliberately does not match the folder, and must not be
    "tidied" to match it — doing so does not compile.

    This file declares a component named Settings. Under the folder-matching
    namespace Backlog.Desktop.UI.Settings it becomes
    Backlog.Desktop.UI.Settings.Settings, and that sibling namespace then shadows
    the type for everything else under Backlog.Desktop.UI. The unit tests are
    where it lands: they sit in Backlog.Desktop.UI.UnitTests, so the simple name
    Settings resolves outward to Backlog.Desktop.UI and finds the namespace
    before it ever reaches the component —

        SettingsAiUsageTests.cs(69,61): error CS0118:
            'Settings' is a namespace but is used like a type

    — for IRenderedComponent<Settings>, Render<Settings>() and the record field
    that holds it. Nothing else in the solution broke; the collision is this
    component sharing its name with the folder it moved into.

    The file still left Shell/, which was the point: Shell/ is app chrome and the
    settings screen is not. Only the published namespace stayed put, so the move
    changed no using, @@using or namespace line anywhere.

    For the same reason this folder has no _Imports.razor: the generated
    _Imports class is a type like any other, so an _Imports.razor here would
    declare Backlog.Desktop.UI.Settings and shadow the component all over again —
    and a @@namespace on it to avoid that collides with Shell/_Imports.razor
    (CS0111, one _Imports per namespace). The two lines it would have carried are
    written in the pages that need them instead.

    The pages beside this file - FeaturesSettingsPage, AiSettingsPage,
    StorageSettingsPage, GitHubAccountsSettingsPage, RepositoriesSettingsPage -
    declare the same namespace for the same reason, and are named so that none
    of them is called Settings.
*@
@namespace Backlog.Desktop.UI.Shell
@using Backlog.SharedKernel
@using Backlog.Modules.Tasks.Abstractions
@using Backlog.Modules.Devbook.Abstractions
@inject GitHubIntegration GitHub
@inject NavigationManager Navigation
@inject IAppFeatureSettings Features
@inject IDevbookFolderSource DevbookFolders
@* Read off rather than injected, so a host that composes no Brain setting can
   still render the screen; see RevealBrainCardAsync. *@
@inject IServiceProvider Services
@* The pages the modules bring, each registered by its own .UI project; empty in
   a host that registers none, and then only the app-wide pages are drawn. *@
@inject IEnumerable<SettingsSection> RegisteredSections
@* Only to bring the Brain card's field into view when a link opened this page
   at it; see OnAfterRenderAsync. *@
@inject IJSRuntime JS
@implements IDisposable

@*
    The one screen in this app with form controls, and it earns them: a folder
    path is not something you can type inline into a backlog entry. Its pages
    still follow the house rule - no save button. Committing a field (blur or
    Enter) moves the store.
*@

<div class="shell shell--settings">
    <header class="app-header">
        @* The title and the way back, and nothing else. The Report issue button
           was here because a per-page mount was the only kind there was, and this
           page needing one of its own is exactly the duplication the app-shell
           footer removes: MainLayout mounts it once, below this page too. *@
        <h1>Settings</h1>
        <a class="icon-link" href="" data-testid="back-link" title="Back to your tasks" aria-label="Back to your tasks">←</a>
    </header>

    @* The pill strip is the shared Tabs component wearing this page's classes.
       Arrow-key movement between the pills comes with it. *@
    <Tabs Bare="true"
          ListElement="nav"
          ListCssClass="settings-tabs"
          AriaLabel="Settings pages"
          TabCssClass="settings-tab"
          ActiveTabCssClass="settings-tab settings-tab--active"
          ActiveId="@ActivePageId"
          ActiveIdChanged="ShowSettingsPageById">

        @* Each app-wide page is a component of its own beside this file, so a
           change to one page is a change to one file. The panels stay here: the
           strip is this screen's, and a panel registers with it in the order it is
           written, which a panel inside a page component would not keep. Kept
           alive for the reason the modules' pages below are - what a page holds
           (a status line, a test result, a half-typed draft) lives as long as the
           screen, as it did when this file held every page. The page's state
           survives a tab switch; its markup does too now, hidden, where before
           only the open page was drawn. A page whose feature is switched off is
           withdrawn with its panel, and its state with it. *@
        <TabPanel Id="features" Title="Features" KeepAlive="true" Element="section" BaseClass="setting" aria-label="Feature settings">
            <FeaturesSettingsPage Screen="@_screen" Active="@IsShowing(SettingsPage.Features)" />
        </TabPanel>

    @if (IsSettingsPageAvailable(SettingsPage.Ai))
    {
        <TabPanel Id="ai" Title="AI" KeepAlive="true" Element="section" BaseClass="setting" aria-label="AI settings">
            <AiSettingsPage Screen="@_screen" Active="@IsShowing(SettingsPage.Ai)" />
        </TabPanel>
    }

        <TabPanel Id="storage" Title="Storage" KeepAlive="true" Element="section" BaseClass="setting" aria-label="Storage settings">
            <StorageSettingsPage @ref="_storagePage" Screen="@_screen" Active="@IsShowing(SettingsPage.Storage)" />
        </TabPanel>

    @if (IsSettingsPageAvailable(SettingsPage.Accounts))
    {
        @* Read before Repositories on purpose: a repository is bound to one of
           these, so the list it is picked from has to be the thing already in
           front of somebody by the time they get there. *@
        <TabPanel Id="accounts"
                  Title="Accounts"
                  KeepAlive="true"
                  Element="section"
                  BaseClass="setting"
                  TestId="github-accounts-settings"
                  aria-label="Account settings">
            <GitHubAccountsSettingsPage Screen="@_screen" Active="@IsShowing(SettingsPage.Accounts)" />
        </TabPanel>
    }

        <TabPanel Id="repositories"
                  Title="Repositories"
                  KeepAlive="true"
                  Element="section"
                  BaseClass="setting"
                  TestId="github-settings"
                  aria-label="Repository settings">
            <RepositoriesSettingsPage Screen="@_screen" Active="@IsShowing(SettingsPage.Repositories)" />
        </TabPanel>

    @* The modules' own pages, after the app-wide ones and in their registered
       order. The shell knows each only as a title and a component: what is on
       the page, and what it writes, is the module's. Kept alive, so a section's
       state lives as long as the settings screen, as it did when the shell held
       it, instead of resetting on every tab switch. *@
    @foreach (var section in OfferedSections)
    {
        <TabPanel @key="section.Id"
                  Id="@section.Id"
                  Title="@section.Title"
                  KeepAlive="true"
                  Element="section"
                  BaseClass="setting"
                  aria-label="@($"{section.Title} settings")">
            <h2 class="setting__title">@section.Title</h2>
            <DynamicComponent Type="@section.Component" />
        </TabPanel>
    }
    </Tabs>
</div>

@code {
    /// <summary>The page a link opened this screen at — <c>settings?page=storage</c>
    /// — or null for the default one.</summary>
    [SupplyParameterFromQuery(Name = "page")]
    public string? Page { get; set; }

    /// <summary>What the pages share - see <see cref="SettingsScreenContext"/>.
    /// Built once, when the screen is, and handed to every page.</summary>
    private SettingsScreenContext _screen = default!;

    /// <summary>The Storage page once it has been opened, so opening it again can
    /// have the Brain card look at its folder again.</summary>
    private StorageSettingsPage? _storagePage;

    private SettingsPage _activePage = SettingsPage.Features;

    private enum SettingsPage
    {
        Features,
        Ai,
        Storage,
        Accounts,
        Repositories,
    }

    // The strip speaks in ids; the page still thinks in the enum.
    private static string PageId(SettingsPage page) => page.ToString().ToLowerInvariant();

    /// <summary>The registered section being shown, or null while one of the
    /// app-wide pages is.</summary>
    private string? _activeSectionId;

    private string ActivePageId => _activeSectionId ?? PageId(_activePage);

    /// <summary>Whether an app-wide page is the one on screen; a page that is not
    /// does not redraw - see <see cref="SettingsPageBase"/>.</summary>
    private bool IsShowing(SettingsPage page) => _activeSectionId is null && _activePage == page;

    private void ShowSettingsPageById(string id)
    {
        if (Enum.TryParse<SettingsPage>(id, ignoreCase: true, out var page)) ShowSettingsPage(page);
        else if (OfferedSections.Any(section => section.Id == id)) _activeSectionId = id;
    }

    /// <summary>The registered sections the strip offers, lowest order first: those
    /// whose feature is on, and never one that would take an app-wide page's id.</summary>
    private IEnumerable<SettingsSection> OfferedSections => RegisteredSections
        .Where(section => !Enum.TryParse<SettingsPage>(section.Id, ignoreCase: true, out _))
        .Where(section => section.FeatureKey is null || Features.IsEnabled(section.FeatureKey))
        .OrderBy(section => section.Order);

    private bool AiAssistantEnabled => Features.IsEnabled(AppFeatures.AiAssistant);

    private bool UsageMetricsEnabled => Features.IsEnabled(AppFeatures.UsageMetrics);

    private void ShowSettingsPage(SettingsPage page)
    {
        if (IsSettingsPageAvailable(page))
        {
            _activePage = page;
            _activeSectionId = null;

            // The Brain folder is the person's to change by hand, so what the card
            // says about it is looked at again each time Storage is opened.
            if (page is SettingsPage.Storage) _storagePage?.RefreshBrainStatus();
        }
    }

    private bool IsSettingsPageAvailable(SettingsPage page) => page switch
    {
        SettingsPage.Features or SettingsPage.Storage or SettingsPage.Repositories => true,
        SettingsPage.Ai => AiAssistantEnabled || UsageMetricsEnabled,

        // An account is only ever used to authenticate a GitHub call, and the two
        // features that make one are the integration itself and the organization
        // usage reports. With neither on there is nothing for the panel to say, so
        // it is not offered rather than offered empty.
        SettingsPage.Accounts => Features.IsEnabled(TasksFeatures.GitHubIntegration) || UsageMetricsEnabled,
        _ => false
    };

    private void EnsureActiveSettingsPage()
    {
        if (!IsSettingsPageAvailable(_activePage))
        {
            _activePage = SettingsPage.Features;
        }

        if (_activeSectionId is not null && !OfferedSections.Any(section => section.Id == _activeSectionId))
        {
            _activeSectionId = null;
            _activePage = SettingsPage.Features;
        }
    }

    protected override Task OnInitializedAsync()
    {
        _screen = new SettingsScreenContext(
            GitHub,
            StateHasChanged,
            () =>
            {
                EnsureActiveSettingsPage();
                StateHasChanged();
            });

        // A branch snapshot fetched in the background lands on a thread that is
        // not this one, and the Repositories page's section rows are what show
        // "fetching" until it does - hence the marshal, and hence subscribing at
        // all. Every opened page is redrawn with the screen.
        DevbookFolders.Changed += OnDevbookFoldersChanged;

        // A link may open this screen at a page - the Brain chip's "Set up your
        // Brain" opens Storage. An id that names no page leaves the default.
        if (!string.IsNullOrWhiteSpace(Page)) ShowSettingsPageById(Page.Trim());

        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await RevealBrainCardAsync();

        // Asking GitHub who we are is a network call, so it happens after the
        // page is on screen rather than holding it up. The usage card reads as
        // this machine's identity too, so its checklist wants the answer as well.
        if (Features.IsEnabled(TasksFeatures.GitHubIntegration) || UsageMetricsEnabled)
        {
            await _screen.CheckConnectionAsync();
        }

        if (Features.IsEnabled(TasksFeatures.GitHubIntegration))
        {
            await _screen.LoadCliAccountsAsync();
        }
    }

    /// <summary>Brings the Brain card's field into view and focus when a link
    /// opened the screen at the card - the chip's "Set up your Brain" - so the
    /// first thing in front of the person is the field they came to fill. The card
    /// is the Storage page's; whether there is one is the Brain setting's.</summary>
    private async Task RevealBrainCardAsync()
    {
        if (_activePage is not SettingsPage.Storage || Services.GetService<IBrainSettings>() is null) return;
        if (!new Uri(Navigation.Uri).Fragment.Equals("#" + BrainSetup.CardId, StringComparison.OrdinalIgnoreCase)) return;

        try
        {
            await JS.InvokeVoidAsync("backlogFocus", BrainSetup.CardId + "-input");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // Bringing the card into view is a courtesy; the page is already on it.
        }
    }

    /// <summary>Lets go of the one subscription the screen itself holds: a screen
    /// still on a singleton's event would be kept alive by it and would call
    /// <c>StateHasChanged</c> on a renderer that is gone. The pages let go of
    /// their own.</summary>
    public void Dispose() => DevbookFolders.Changed -= OnDevbookFoldersChanged;

    private void OnDevbookFoldersChanged() => _ = InvokeAsync(StateHasChanged);
}
