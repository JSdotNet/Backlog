@page "/settings"
@page "/settings/{PageId}"
@*
    The namespace deliberately does not match the folder, and must not be
    "tidied" to match it — doing so does not compile.

    This file declares a component named Settings. Under the folder-matching
    namespace Backlog.Desktop.UI.Settings it becomes
    Backlog.Desktop.UI.Settings.Settings, and that sibling namespace then shadows
    the type for everything else under Backlog.Desktop.UI. The unit tests are
    where it lands: they sit in Backlog.Desktop.UI.UnitTests, so the simple name
    Settings resolves outward to Backlog.Desktop.UI and finds the namespace
    before it ever reaches the component —

        SettingsAiUsageTests.cs(69,61): error CS0118:
            'Settings' is a namespace but is used like a type

    — for IRenderedComponent<Settings>, Render<Settings>() and the record field
    that holds it. Nothing else in the solution broke; the collision is this
    component sharing its name with the folder it moved into.

    The file still left Shell/, which was the point: Shell/ is app chrome and the
    settings screen is not. Only the published namespace stayed put, so the move
    changed no using, @@using or namespace line anywhere.

    For the same reason this folder has no _Imports.razor: the generated
    _Imports class is a type like any other, so an _Imports.razor here would
    declare Backlog.Desktop.UI.Settings and shadow the component all over again —
    and a @@namespace on it to avoid that collides with Shell/_Imports.razor
    (CS0111, one _Imports per namespace). The two lines it would have carried are
    written in the pages that need them instead.

    The pages beside this file - FeaturesSettingsPage, AiSettingsPage,
    StorageSettingsPage, GitHubAccountsSettingsPage, RepositoriesSettingsPage -
    declare the same namespace for the same reason, and are named so that none
    of them is called Settings.
*@
@namespace Backlog.Desktop.UI.Shell
@using Backlog.SharedKernel
@using Backlog.Modules.Tasks.Abstractions
@using Backlog.Modules.Devbook.Abstractions
@inject GitHubIntegration GitHub
@inject NavigationManager Navigation
@inject IAppFeatureSettings Features
@inject IDevbookFolderSource DevbookFolders
@* Read off rather than injected, so a host that composes no Brain setting can
   still render the screen; see RevealBrainCardAsync. *@
@inject IServiceProvider Services
@* The pages the modules bring, each registered by its own .UI project; empty in
   a host that registers none, and then only the app-wide pages are drawn. *@
@inject IEnumerable<SettingsSection> RegisteredSections
@* To bring the Brain card's field into view when a link opened this page at it,
   and a card the search found when its link is followed; see OnAfterRenderAsync. *@
@inject IJSRuntime JS
@implements IDisposable

@*
    The one screen in this app with form controls, and it earns them: a folder
    path is not something you can type inline into a backlog entry. Its pages
    still follow the house rule - no save button. Committing a field (blur or
    Enter) moves the store, and the frame's "Saved as you go" chip says so.

    Every page has its own address, settings/<page>, and the menu is links to
    them: choosing a page navigates, so Back returns to the page before. The
    router hands each address to this same component instance, so the pages a
    visit has opened stay alive across those moves.
*@

<div class="shell shell--settings">
    <SettingsFrame Title="@ActivePage.Title"
                   Eyebrow="@SettingsPages.Eyebrow(ActivePage.Group)"
                   PageChosen="@PageChosen"
                   TestId="settings-frame">
        <Search>
            <SettingsSearch Value="@_search" ValueChanged="@OnSearchChanged" TestId="settings-search" />
        </Search>
        <Menu>
            @* While the search has text the menu lists only what it matched, and
               a group it left empty is not drawn; see SettingsPages.Find. *@
            @if (SearchMatches.Count == 0)
            {
                <p class="settings-frame__no-match" role="status" data-testid="settings-search-empty">@SettingsPages.NoMatch(_search)</p>
            }
            @foreach (var group in SettingsPages.Menu([.. SearchMatches.Select(match => match.Page)], _activeId))
            {
                <SettingsMenuGroup @key="group.Group"
                                   Label="@SettingsPages.GroupLabel(group.Group)"
                                   Items="@WithMatchedCards(group.Items)"
                                   TestId="@($"settings-menu-{group.Group.ToString().ToLowerInvariant()}")" />
            }
        </Menu>
        <ChildContent>
            @* Each app-wide page is a component of its own beside this file, so a
               change to one page is a change to one file. A page is drawn from its
               first opening and kept alive, hidden, while another is on screen -
               what a page holds (a status line, a test result, a half-typed draft)
               lives as long as the screen. A page whose feature is switched off is
               withdrawn, and its state with it. The cascade tells the page's
               SettingsHeadline whether it is the one on screen, so a hidden page
               never writes the headline. *@
            @if (IsOpen(SettingsPages.Features))
            {
                <CascadingValue Name="@SettingsFrame.ActivePageCascade" Value="@IsShowing(SettingsPages.Features)">
                    <section class="setting" hidden="@(!IsShowing(SettingsPages.Features))" aria-label="Feature settings">
                        <FeaturesSettingsPage Screen="@_screen" Active="@IsShowing(SettingsPages.Features)" />
                    </section>
                </CascadingValue>
            }

            @if (IsOpen(SettingsPages.Ai))
            {
                <CascadingValue Name="@SettingsFrame.ActivePageCascade" Value="@IsShowing(SettingsPages.Ai)">
                    <section class="setting" hidden="@(!IsShowing(SettingsPages.Ai))" aria-label="AI settings">
                        <AiSettingsPage Screen="@_screen" Active="@IsShowing(SettingsPages.Ai)" />
                    </section>
                </CascadingValue>
            }

            @if (IsOpen(SettingsPages.Storage))
            {
                <CascadingValue Name="@SettingsFrame.ActivePageCascade" Value="@IsShowing(SettingsPages.Storage)">
                    <section class="setting" hidden="@(!IsShowing(SettingsPages.Storage))" aria-label="Storage settings">
                        <StorageSettingsPage @ref="_storagePage" Screen="@_screen" Active="@IsShowing(SettingsPages.Storage)" />
                    </section>
                </CascadingValue>
            }

            @if (IsOpen(SettingsPages.Accounts))
            {
                <CascadingValue Name="@SettingsFrame.ActivePageCascade" Value="@IsShowing(SettingsPages.Accounts)">
                    <section class="setting"
                             hidden="@(!IsShowing(SettingsPages.Accounts))"
                             data-testid="github-accounts-settings"
                             aria-label="Account settings">
                        <GitHubAccountsSettingsPage Screen="@_screen" Active="@IsShowing(SettingsPages.Accounts)" />
                    </section>
                </CascadingValue>
            }

            @if (IsOpen(SettingsPages.Repositories))
            {
                <CascadingValue Name="@SettingsFrame.ActivePageCascade" Value="@IsShowing(SettingsPages.Repositories)">
                    <section class="setting"
                             hidden="@(!IsShowing(SettingsPages.Repositories))"
                             data-testid="github-settings"
                             aria-label="Repository settings">
                        <RepositoriesSettingsPage Screen="@_screen" Active="@IsShowing(SettingsPages.Repositories)" />
                    </section>
                </CascadingValue>
            }

            @* The modules' own pages. The shell knows each only as a title, a group
               and a component: what is on the page, and what it writes, is the
               module's. Its headline is its title unless it renders a
               SettingsHeadline of its own. *@
            @foreach (var section in OfferedSections.Where(section => IsOpen(section.Id)))
            {
                <CascadingValue @key="section.Id" Name="@SettingsFrame.ActivePageCascade" Value="@IsShowing(section.Id)">
                    <section class="setting"
                             hidden="@(!IsShowing(section.Id))"
                             aria-label="@($"{section.Title} settings")">
                        <DynamicComponent Type="@section.Component" />
                    </section>
                </CascadingValue>
            }
        </ChildContent>
    </SettingsFrame>
</div>

@code {
    /// <summary>The page this address names - <c>settings/storage</c> - or null
    /// for <c>settings</c>, which opens Features. An id that names no page offered
    /// opens Features too.</summary>
    [Parameter]
    public string? PageId { get; set; }

    /// <summary>The page an older link names as a query - <c>settings?page=storage</c>.
    /// Still honoured where the address names no page, so a link written before the
    /// pages had addresses of their own opens the page it meant.</summary>
    [SupplyParameterFromQuery(Name = "page")]
    public string? Page { get; set; }

    /// <summary>Whether the address names a page, by route or by the older query.
    /// At phone width <c>settings</c> is the grouped menu on its own and
    /// <c>settings/storage</c> the page on its own; see <see cref="SettingsFrame.PageChosen"/>.
    /// Wider than that, both addresses draw the menu beside the page, as before.</summary>
    private bool PageChosen => !string.IsNullOrWhiteSpace(PageId) || !string.IsNullOrWhiteSpace(Page);

    /// <summary>What the pages share - see <see cref="SettingsScreenContext"/>.
    /// Built once, when the screen is, and handed to every page.</summary>
    private SettingsScreenContext _screen = default!;

    /// <summary>The Storage page once it has been opened, so opening it again can
    /// have the Brain card look at its folder again.</summary>
    private StorageSettingsPage? _storagePage;

    /// <summary>The page on screen.</summary>
    private string _activeId = SettingsPages.Features;

    /// <summary>The pages opened since the screen was, each kept alive until the
    /// screen closes or its feature is switched off.</summary>
    private readonly HashSet<string> _opened = new(StringComparer.Ordinal);

    private bool IsOpen(string id) => _opened.Contains(id) && OfferedPages.Any(page => page.Id == id);

    /// <summary>Whether the page is the one on screen; a page that is not does
    /// not redraw - see <see cref="SettingsPageBase"/>.</summary>
    private bool IsShowing(string id) => string.Equals(_activeId, id, StringComparison.Ordinal);

    /// <summary>The page on screen, as the menu and the header know it.</summary>
    private SettingsSection ActivePage =>
        OfferedPages.FirstOrDefault(page => page.Id == _activeId) ?? SettingsPages.BuiltIn[0];

    /// <summary>What the header's search holds; blank lists every page.</summary>
    private string _search = string.Empty;

    /// <summary>The title of a card a followed search link named, to bring into
    /// view once the page is drawn; null when there is none waiting.</summary>
    private string? _cardToReveal;

    /// <summary>The pages the menu lists while <see cref="_search"/> holds what it
    /// does, each with the card titles it matched.</summary>
    private IReadOnlyList<SettingsSearchMatch> SearchMatches => SettingsPages.Find(OfferedPages, _search);

    private void OnSearchChanged(string value) => _search = value;

    /// <summary>The menu items of one group, each with the cards the search
    /// matched on its page listed under it as links.</summary>
    private IReadOnlyList<SettingsMenuItem> WithMatchedCards(IReadOnlyList<SettingsMenuItem> items)
    {
        if (!SettingsPages.IsSearching(_search)) return items;

        var matches = SearchMatches.ToDictionary(match => match.Page.Id, match => match.Cards, StringComparer.Ordinal);
        return
        [
            .. items.Select(item => matches.TryGetValue(item.Id, out var cards) && cards.Count > 0
                ? item with { Cards = [.. cards.Select(card => new SettingsMenuCardLink(card, SettingsPages.CardHref(item.Id, card)))] }
                : item)
        ];
    }

    /// <summary>Every page the menu offers, in menu order.</summary>
    private IReadOnlyList<SettingsSection> OfferedPages =>
        SettingsPages.InMenuOrder(SettingsPages.BuiltIn.Where(page => IsBuiltInPageAvailable(page.Id)), OfferedSections);

    /// <summary>The registered sections the menu offers, lowest order first: those
    /// whose feature is on, and never one that would take an app-wide page's id.</summary>
    private IEnumerable<SettingsSection> OfferedSections => RegisteredSections
        .Where(section => !SettingsPages.IsBuiltIn(section.Id))
        .Where(section => section.FeatureKey is null || Features.IsEnabled(section.FeatureKey))
        .OrderBy(section => section.Order);

    private bool UsageMetricsEnabled => Features.IsEnabled(AppFeatures.UsageMetrics);

    private bool IsBuiltInPageAvailable(string id) => id switch
    {
        SettingsPages.Features or SettingsPages.Storage or SettingsPages.Repositories => true,
        SettingsPages.Ai => Features.IsEnabled(AppFeatures.AiAssistant) || UsageMetricsEnabled,

        // An account is only ever used to authenticate a GitHub call, and the two
        // features that make one are the integration itself and the organization
        // usage reports. With neither on there is nothing for the page to say, so
        // it is not offered rather than offered empty.
        SettingsPages.Accounts => Features.IsEnabled(TasksFeatures.GitHubIntegration) || UsageMetricsEnabled,
        _ => false
    };

    /// <summary>Shows the page <paramref name="id"/> names, or Features where it
    /// names none on offer.</summary>
    private void ShowPage(string? id)
    {
        var page = string.IsNullOrWhiteSpace(id)
            ? null
            : OfferedPages.FirstOrDefault(candidate => string.Equals(candidate.Id, id.Trim(), StringComparison.OrdinalIgnoreCase));
        var target = page?.Id ?? SettingsPages.Features;
        var changed = !IsShowing(target);

        _activeId = target;
        _opened.Add(target);

        // The Brain folder is the person's to change by hand, so what the card
        // says about it is looked at again each time Storage is opened.
        if (changed && target == SettingsPages.Storage) _storagePage?.RefreshBrainStatus();
    }

    /// <summary>Falls back to Features when the page on screen stops being
    /// offered, and lets go of every page whose feature was switched off, so
    /// switching it back on starts it afresh.</summary>
    private void EnsureActiveSettingsPage()
    {
        var offered = OfferedPages.Select(page => page.Id).ToHashSet(StringComparer.Ordinal);

        _opened.RemoveWhere(id => !offered.Contains(id));

        if (!offered.Contains(_activeId))
        {
            _activeId = SettingsPages.Features;
            _opened.Add(_activeId);
        }
    }

    /// <summary>The router hands every settings address to this one instance, so
    /// this runs on each move between pages, not only when the screen opens.</summary>
    protected override void OnParametersSet() =>
        ShowPage(string.IsNullOrWhiteSpace(PageId) ? Page : PageId);

    protected override Task OnInitializedAsync()
    {
        _screen = new SettingsScreenContext(
            GitHub,
            StateHasChanged,
            () =>
            {
                EnsureActiveSettingsPage();
                StateHasChanged();
            });

        // A branch snapshot fetched in the background lands on a thread that is
        // not this one, and the Repositories page's section rows are what show
        // "fetching" until it does - hence the marshal, and hence subscribing at
        // all. Every opened page is redrawn with the screen.
        DevbookFolders.Changed += OnDevbookFoldersChanged;

        // A card link the search listed is the page's address with the card in
        // its fragment. The address is read on every move to another page - a
        // move that keeps the route may set no parameter - and once here for a
        // screen opened at a card. A link to a card of the page already on screen
        // moves only the fragment, which Blazor does not report; components.js
        // reveals that one from the link.
        Navigation.LocationChanged += OnLocationChanged;
        _cardToReveal = CardInAddress(Navigation.Uri);

        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await RevealFoundCardAsync();

        if (!firstRender) return;

        await RevealBrainCardAsync();

        // Asking GitHub who we are is a network call, so it happens after the
        // page is on screen rather than holding it up. The usage card reads as
        // this machine's identity too, so its checklist wants the answer as well.
        if (Features.IsEnabled(TasksFeatures.GitHubIntegration) || UsageMetricsEnabled)
        {
            await _screen.CheckConnectionAsync();
        }

        if (Features.IsEnabled(TasksFeatures.GitHubIntegration))
        {
            await _screen.LoadCliAccountsAsync();
        }
    }

    /// <summary>Brings the Brain card's field into view and focus when a link
    /// opened the screen at the card - the chip's "Set up your Brain" - so the
    /// first thing in front of the person is the field they came to fill. The card
    /// is the Storage page's; whether there is one is the Brain setting's.</summary>
    private async Task RevealBrainCardAsync()
    {
        if (_activeId != SettingsPages.Storage || Services.GetService<IBrainSettings>() is null) return;
        if (!new Uri(Navigation.Uri).Fragment.Equals("#" + BrainSetup.CardId, StringComparison.OrdinalIgnoreCase)) return;

        try
        {
            await JS.InvokeVoidAsync("backlogFocus", BrainSetup.CardId + "-input");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // Bringing the card into view is a courtesy; the page is already on it.
        }
    }

    /// <summary>The title of the card <paramref name="uri"/> names on the page it
    /// addresses, or null where it names none.</summary>
    private string? CardInAddress(string uri)
    {
        var address = new Uri(uri);
        if (string.IsNullOrEmpty(address.Fragment)) return null;

        var pageId = Navigation.ToBaseRelativePath(uri).Split('#', '?')[0].Split('/').LastOrDefault();
        var page = OfferedPages.FirstOrDefault(candidate => string.Equals(candidate.Id, pageId, StringComparison.OrdinalIgnoreCase));
        return page is null ? null : SettingsPages.CardNamedBy(page, address.Fragment);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var card = CardInAddress(e.Location);
        if (card is null) return;

        _cardToReveal = card;
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>Scrolls the card a followed search link named into view and
    /// lights its border for a moment. The script looks for the card's heading on
    /// the page on screen and waits a few frames for it, because the page may be
    /// drawn for the first time by the render that asked.</summary>
    private async Task RevealFoundCardAsync()
    {
        if (_cardToReveal is not { } card) return;
        _cardToReveal = null;

        try
        {
            await JS.InvokeVoidAsync("backlogRevealSettingsCard", card);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // Bringing the card into view is a courtesy; the page is already open.
        }
    }

    /// <summary>Lets go of the subscriptions the screen itself holds: a screen
    /// still on a singleton's event would be kept alive by it and would call
    /// <c>StateHasChanged</c> on a renderer that is gone. The pages let go of
    /// their own.</summary>
    public void Dispose()
    {
        DevbookFolders.Changed -= OnDevbookFoldersChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private void OnDevbookFoldersChanged() => _ = InvokeAsync(StateHasChanged);
}
