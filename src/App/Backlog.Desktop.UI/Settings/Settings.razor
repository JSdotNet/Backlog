    protected override Task OnInitializedAsync()
    {
        _devicePairing = Services.GetService<DevicePairingClient>();
        _deviceCredentials = Services.GetService<IDeviceCredentialStore>();
        _deviceLog = Services.GetService<ILoggerFactory>()?.CreateLogger(GetType());
        _deviceTokens = Services.GetService<SyncTokenProvider>();
        _activityCache = Services.GetService<IPullRequestDetailCache>();
        _taskSync = ResolveTaskSync();

        // The loop outlives this screen, so what it did while nobody was here is
        // already on it - and what it does while somebody is here has to reach
        // the page, because otherwise the line below the button never moves.
        if (_taskSync is not null) _taskSync.Changed += OnTaskSyncChanged;

        // A background sync is what usually hears the refusal first, on a thread
        // that is not this one - hence the marshal in the handler. That
        // background sync is now the loop above, which is what made the refusal
        // reachable without anybody pressing anything.
        if (_deviceTokens is not null) _deviceTokens.CredentialRejectedChanged += OnCredentialRejectedChanged;

        _draftDeviceName = StoredDevice?.DeviceName ?? Environment.MachineName;
        _draftPath = Store.RootDirectory;
        _draftStorageRepository = Store.RootRepository?.ToLine() ?? string.Empty;

        // Blank while it is the default, so the placeholder is what explains
        // where snapshots go rather than a path nobody typed.
        _draftKnowledgeCacheDirectory = Store.IsDefaultKnowledgeCacheDirectory ? string.Empty : Store.KnowledgeCacheDirectory;
        SyncRefreshDraft();
        SyncWorkingHoursDrafts();
        SyncStorageKnowledgeDrafts();
        SyncAzureFoundryDrafts();
        SyncUsageEndpointDrafts();
        _draftRepos = RepositorySettingsText();
        SyncRepositoryDrafts();
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Asking GitHub who we are is a network call, so it happens after the
        // page is on screen rather than holding it up.
        if (Features.IsEnabled(TasksFeatures.GitHubIntegration))
        {
            await CheckConnectionAsync();
            await LoadCliAccountsAsync();
        }

        // Same reasoning: asking the sync service who this device is goes over
        // the network, so the panel draws from what is stored and fills the
        // device count in when the answer arrives.
        if (DevicePairingEnabled && StoredDevice is not null)
        {
            await RefreshDeviceStatusAsync();
            StateHasChanged();
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ApplyAsync();
        else if (e.Key == "Escape") _draftPath = Store.RootDirectory;
