    private readonly Dictionary<string, string> _draftClaudeApiKeys = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _draftAccountEndpoints = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _draftCloneDirectories = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _draftDevbookPaths = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _cloningRepositories = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _draftTokens = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _draftAccountTokens = new(StringComparer.OrdinalIgnoreCase);
    private string _draftAccountLogin = string.Empty;
    private string? _accountMessage;
    private string? _activeAccountLogin;

    /// <summary>What the <c>gh</c> CLI last said it is signed in to. Empty until
