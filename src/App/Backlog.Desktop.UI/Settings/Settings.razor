        SyncWorkingHoursDrafts();
        SyncAzureFoundryDrafts();
        SyncUsageEndpointDrafts();
        _draftRepos = RepositorySettingsText();
        SyncRepositoryDrafts();
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Asking GitHub who we are is a network call, so it happens after the
        // page is on screen rather than holding it up.
        if (Features.IsEnabled(TasksFeatures.GitHubIntegration))
        {
            await CheckConnectionAsync();
            await LoadCliAccountsAsync();
        }

        // Same reasoning: asking the sync service who this device is goes over
        // the network, so the panel draws from what is stored and fills the
        // device count in when the answer arrives.
        if (SyncEnabled && StoredDevice is not null)
        {
            await RefreshDeviceStatusAsync();
            StateHasChanged();
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ApplyAsync();
        else if (e.Key == "Escape") _draftPath = Store.RootDirectory;
    }

    /// <summary>What "Move to this folder" and Enter in the field do: the
    /// backlog goes along to the folder typed in. The store copies before it
    /// repoints, and refuses a folder that already holds a backlog, so the
    /// worst a slip here can do is leave everything where it was and say why.</summary>
    private Task ApplyAsync()
    {
        var previous = Store.RootDirectory;
        var move = Store.TryMoveRoot(_draftPath);

        RecordRootChange(previous, move.Error, move.CopiedData);
        return Task.CompletedTask;
    }

    /// <summary>The old behaviour, kept for opening a backlog that already
    /// lives in the folder: the app is pointed there and nothing is copied.</summary>
    private Task SwitchAsync()
    {
        var previous = Store.RootDirectory;
        var error = Store.TryUseRoot(_draftPath);

        RecordRootChange(previous, error, copied: false);
        return Task.CompletedTask;
    }

    /// <summary>
    /// What the status line says after a commit. A commit that changed nothing
    /// and failed nothing leaves the last outcome standing: Enter pressed again
    /// on a field that now names the folder the app is in must not wipe "Moved"
    /// off the screen before anybody read which folder still holds the old copy.
    /// (It used to happen without a second key: the field committed on change
    /// as well, and Enter caused both.)
    /// </summary>
    private void RecordRootChange(string previous, string? error, bool copied)
    {
        _error = error;

        if (!string.Equals(previous, Store.RootDirectory, StringComparison.OrdinalIgnoreCase))
        {
            _moved = true;
            _copied = copied;
            _previousRoot = previous;
        }
        else if (error is not null)
        {
            _moved = false;
            _copied = false;
        }

        if (_error is null) _draftPath = Store.RootDirectory;
    }

    private Task MoveToDefaultAsync()
    {
        _draftPath = Store.DefaultRootDirectory;
        return ApplyAsync();
    }

    /// <summary>Whether the field still names the folder the app is in, in
    /// which case switching has nothing to switch to.</summary>
    private bool IsCurrentRootDraft =>
        string.Equals(
            Path.TrimEndingDirectorySeparator(_draftPath.Trim()),
            Path.TrimEndingDirectorySeparator(Store.RootDirectory),
            StringComparison.OrdinalIgnoreCase);

    private void ApplyStorageRepository()
    {
        _storageRepositoryError = string.IsNullOrWhiteSpace(_draftStorageRepository)
            ? Store.ClearRepository()
            : Store.TrySetRepository(_draftStorageRepository);
        _draftStorageRepository = Store.RootRepository?.ToLine() ?? string.Empty;
    }

    private void ClearStorageRepository()
    {
        _storageRepositoryError = Store.ClearRepository();
        _draftStorageRepository = string.Empty;
    }

    private void OnStorageRepositoryKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") ApplyStorageRepository();
        else if (e.Key == "Escape") _draftStorageRepository = Store.RootRepository?.ToLine() ?? string.Empty;
    }

    // ---- Backup schedule ---------------------------------------------------

    /// <summary>The worker, or null in a host that composes none — the same
    /// arrangement as <see cref="_taskSync"/>, resolved the same way.</summary>
    private BackupWorker? _backup;

    private static readonly IReadOnlyList<SelectorOption> BackupCadenceOptions =
    [
        new(nameof(BackupCadence.Off), "Off"),
        new(nameof(BackupCadence.Daily), "Every day"),
        new(nameof(BackupCadence.Weekly), "Every week")
    ];

    private static readonly IReadOnlyList<SelectorOption> BackupDayOptions =
        [.. WorkingHours.Week.Select(day => new SelectorOption(day.ToString(), day.ToString()))];

    /// <summary>What the time field shows: the schedule's time as the input
    /// wants it, re-read on every render because the field commits on change
    /// and the store is what it commits to.</summary>
    private string BackupTimeDraft => Store.BackupSchedule.At.ToString("HH:mm", CultureInfo.InvariantCulture);

    private void ApplyBackupCadence(string? value)
    {
        if (!Enum.TryParse<BackupCadence>(value, ignoreCase: true, out var cadence)) return;

        _backupScheduleError = Store.SetBackupSchedule(Store.BackupSchedule with { Cadence = cadence });
    }

    private void ApplyBackupDay(string? value)
    {
        if (!Enum.TryParse<DayOfWeek>(value, ignoreCase: true, out var day)) return;

        _backupScheduleError = Store.SetBackupSchedule(Store.BackupSchedule with { Day = day });
    }

    /// <summary>Commits the time from the change event's own value, for the
    /// reason <see cref="ApplyWorkingTime"/> gives: a time input raises empty
    /// input events while a time is half typed, and only the change event
    /// carries a whole one.</summary>
    private void ApplyBackupTime(ChangeEventArgs e)
    {
        if (!TryReadWorkingTime(e.Value?.ToString() ?? string.Empty, out var at))
        {
            _backupScheduleError = "Enter a time of day for the backup.";
            return;
        }

        _backupScheduleError = Store.SetBackupSchedule(Store.BackupSchedule with { At = at });
    }

    private void OnBackupTimeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _backupScheduleError = null;
    }

    /// <summary>Asks the worker for a backup now, and returns. Not awaited, for
    /// the reason <see cref="SyncTasks"/> is not: copying the database and
    /// uploading it is work a click handler should not hold the render loop
    /// for, and what happened arrives through the worker's <c>Changed</c>.</summary>
    private void BackUpNow() => _backup?.RequestBackup();

    private bool BackupStatusIsFailure =>
        _backupScheduleError is not null || (_backup is { IsRunning: false, Last.Error: not null });

    /// <summary>One sentence for the state of backups: the refusal of what was
    /// just typed first, then what the worker did last and when it will next,
    /// because a person reading this line is asking "is my backlog safe?" and
    /// the answer is the last backup, not the schedule.</summary>
    private string BackupStatusLine
    {
        get
        {
            if (_backupScheduleError is not null) return _backupScheduleError;
            if (_backup is null) return "Backups are not available in this build.";
            if (Store.RootRepository is null) return "Name a repository to back up to.";
            if (_backup.IsRunning) return "Backing up…";

            var last = _backup.Last;
            // Already local: the worker asks its clock for local time when it
            // arms, so converting again would shift it by the zone a second time.
            var next = _backup.NextDue is { } due
                ? $" Next backup {due:dddd d MMMM} at {due:HH:mm}."
                : Store.BackupSchedule.IsScheduled ? string.Empty : " Nothing is scheduled.";

            if (last.Error is not null)
            {
                var since = last.SucceededAt is { } ok ? $" The last backup that worked was {ok.ToLocalTime():d MMMM yyyy HH:mm}." : string.Empty;
                return $"The last backup failed: {last.Error}{since}{next}";
            }

            if (last.SucceededAt is { } at)
            {
                var did = last.Committed ? "a new copy was committed" : "nothing had changed";
                return $"Last backup {at.ToLocalTime():d MMMM yyyy HH:mm} - {did}.{next}";
            }

            return $"Never backed up.{next}";
        }
    }

    /// <summary>Resolved the way <see cref="ResolveTaskSync"/> resolves its
    /// worker, and for the same reason: both desktop heads compose one, a test
    /// rendering this page does not have to.</summary>
    private BackupWorker? ResolveBackup()
    {
        try
        {
            return Services.GetService<BackupWorker>();
        }
        catch (InvalidOperationException ex)
        {
            _deviceLog?.LogInformation(ex, "Backup is not composed in this host, so the backup controls are not offered.");
            return null;
        }
    }

    /// <summary>A run ended or started on a thread that is not this one, or
    /// the schedule moved the next due time. The line under the button is what
    /// shows it.</summary>
    private void OnBackupChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>What the seven rows are showing, keyed by day and by which end
    /// of it. One dictionary rather than fourteen fields, the way the knowledge
    /// folder rows keep theirs: the rows are generated, so what they are edited
    /// through has to be too.</summary>
    private static string WorkingHoursDraftKey(DayOfWeek day, bool start) =>
        $"{day}:{(start ? "start" : "end")}";

    private string WorkingHoursDraft(DayOfWeek day, bool start)
    {
        var key = WorkingHoursDraftKey(day, start);
        if (!_draftWorkingHours.TryGetValue(key, out var draft))
        {
            var working = WorkingWeek.Current.On(day);
            draft = FormatWorkingTime(start ? working.Start : working.End);
            _draftWorkingHours[key] = draft;
        }

        return draft;
    }

    private void SyncWorkingHoursDrafts()
    {
        foreach (var day in WorkingHours.Week)
        {
            var working = WorkingWeek.Current.On(day);
            _draftWorkingHours[WorkingHoursDraftKey(day, start: true)] = FormatWorkingTime(working.Start);
            _draftWorkingHours[WorkingHoursDraftKey(day, start: false)] = FormatWorkingTime(working.End);
        }
    }

    /// <summary>
    /// Commits one end of one day, on change, with no save button - the rule the
    /// rest of this screen follows.
    /// <para>
    /// The typed value is read off the change event rather than through
    /// <c>ValueChanged</c>, which is what <c>TextField</c> asks of a
    /// <c>Type="time"</c> host: a half-typed time raises input events that read
    /// as empty, and a draft moved by those would be cleared mid-keystroke.
    /// </para>
    /// <para>
    /// A refused time therefore stays in the field beside the reason it was
    /// refused, rather than snapping back to what is in force the way the
    /// interval above does. The snap-back works there because an input event
    /// had already moved the draft, so putting it back is a change the renderer
    /// can see; here the draft only ever moves at commit, and restoring it would
    /// leave the browser showing a value the page no longer has any way to
    /// explain.
    /// </para>
    /// </summary>
    private void ApplyWorkingTime(DayOfWeek day, bool start, ChangeEventArgs e)
    {
        var typed = e.Value?.ToString() ?? string.Empty;
        _draftWorkingHours[WorkingHoursDraftKey(day, start)] = typed;

        if (!TryReadWorkingTime(typed, out var time))
        {
            _workingHoursError = $"Give {day} a {(start ? "start" : "finishing")} time, as HH:mm.";
            return;
        }

        var working = WorkingWeek.Current.On(day);

        _workingHoursError = start
            ? WorkingWeek.SetDay(day, working.Working, time, working.End)
            : WorkingWeek.SetDay(day, working.Working, working.Start, time);

        if (_workingHoursError is null) SyncWorkingHoursDrafts();
    }

    /// <summary>
    /// Escape puts the row back to what is in force.
    /// <para>
    /// There is no Enter branch here, unlike every other field on this page:
    /// Enter on a time input already raises the change event that commits it,
    /// and a key handler cannot see the typed value to commit anything else.
    /// </para>
    /// </summary>
    private void OnWorkingHoursKeyDown(KeyboardEventArgs e, DayOfWeek day, bool start)
    {
        if (e.Key != "Escape") return;

        var working = WorkingWeek.Current.On(day);
        _draftWorkingHours[WorkingHoursDraftKey(day, start)] =
            FormatWorkingTime(start ? working.Start : working.End);
    }

    /// <summary>Turns a day on or off with the hours it already has rather than
    /// the ones in the fields. A half-typed time is not a choice, and the day
    /// coming back with the hours it had is the promise
    /// <see cref="WorkingDay.Working"/> makes.</summary>
    private void SetWorkingDayEnabled(DayOfWeek day, bool working)
    {
        var stored = WorkingWeek.Current.On(day);
        _workingHoursError = WorkingWeek.SetDay(day, working, stored.Start, stored.End);
        SyncWorkingHoursDrafts();
    }

    private void ResetWorkingHours()
    {
        _workingHoursError = WorkingWeek.ResetToDefault();
        SyncWorkingHoursDrafts();
    }

    private bool IsDefaultWorkingWeek =>
        WorkingHours.Week.All(day => WorkingWeek.Current.On(day) == WorkingHours.Default.On(day));

    /// <summary>The week in one sentence, so the section says what is in force
    /// without the reader adding seven rows up themselves.</summary>
    private string WorkingWeekSummary()
    {
        var worked = WorkingHours.Week.Select(WorkingWeek.Current.On).Where(day => day.Working).ToList();
        if (worked.Count == 0) return "No working days. Nothing is marked as working hours.";

        var names = string.Join(", ", worked.Select(day => day.Day.ToString()));

        return worked.All(day => day.Start == worked[0].Start && day.End == worked[0].End)
            ? $"{names}, {FormatWorkingTime(worked[0].Start)} to {FormatWorkingTime(worked[0].End)}."
            : $"{names}, each between the hours listed.";
    }

    /// <summary>The wire format a <c>time</c> input takes and returns, and the
    /// one the settings file is written in - invariant, so the two never drift
    /// apart on a machine whose locale writes times some other way.</summary>
    private static string FormatWorkingTime(TimeOnly time) =>
        time.ToString("HH:mm", CultureInfo.InvariantCulture);

    /// <summary>Seconds are accepted as well as minutes because a browser is
    /// entitled to send them, and refusing a time for being more precise than
    /// the field asked for is a rejection nobody could act on.</summary>
    private static bool TryReadWorkingTime(string text, out TimeOnly time) =>
        TimeOnly.TryParseExact(
            text,
            ["HH:mm", "HH:mm:ss"],
            CultureInfo.InvariantCulture,
            DateTimeStyles.None,
            out time);

    /// <summary>The input's classes for a field whose rejection is reported in
    /// the status line beside it rather than by the component.</summary>
    private static string SettingInputClass(string? error) =>
        error is null ? "setting__input" : "setting__input setting__input--error";

    /// <summary>What the store found the root to be inside, said as advice, or
    /// null when it found nothing - which renders no warning at all.</summary>
    private string? SyncedRootWarning => Store.SyncedRoot is null
        ? null
        : $"This folder is inside {Store.SyncedRoot.ProviderName}, which copies it between machines. It cannot merge the database, so entries and status edits can be lost - move the backlog to a folder on this disk.";

    /// <summary>The status line always, and the sync warning as well while there
    /// is one. Both are things the reader needs on reaching the field, and naming
    /// an element that is not rendered would describe the field with nothing.</summary>
    private string StoragePathDescribedBy => Store.SyncedRoot is null
        ? "storage-path-status"
        : "storage-path-status storage-path-sync-warning";

    /// <summary>Commits the repository list. Lines that aren't repositories are
    /// reported and skipped rather than throwing away the ones around them —
    /// a half-typed line is an ordinary thing to have in a text box.
    /// <para>
    /// The box cannot rename: rows are continued by id, so a line whose
    /// <c>owner/name</c> changed is a removed repository beside a new one. A save
    /// that did both is the shape a rename typed here would take, so it is the
    /// one save that earns a sentence pointing at the Rename control — after the
    /// fact, because refusing the edit would refuse every genuine swap too.
    /// </para></summary>
    private void ApplyRepositories()
    {
        var (repositories, errors) = GitHubSettings.ParseText(_draftRepos);
        var messages = new List<string>(errors);
        var before = GitHub.Settings.Current.Repositories.Select(r => r.FullName).ToList();

        var saveError = GitHub.Settings.SetRepositories(repositories);
        if (saveError is not null) messages.Add(saveError);
        _repoError = messages.Count > 0 ? string.Join(" ", messages) : null;
        _draftRepos = RepositorySettingsText();
        SyncRepositoryDrafts();

        var after = GitHub.Settings.Current.Repositories.Select(r => r.FullName).ToList();
        var removed = before.Where(id => !after.Contains(id, StringComparer.OrdinalIgnoreCase)).ToList();
        var added = after.Where(id => !before.Contains(id, StringComparer.OrdinalIgnoreCase)).ToList();

        _repoReplacedHint = removed.Count > 0 && added.Count > 0
            ? $"Removed {string.Join(", ", removed)} and added {string.Join(", ", added)}. To rename a repository and keep its settings and entries, use Rename on its card."
            : null;
    }

    private void BeginRename(GitHubRepositoryRef repository)
    {
        _renamingAlias = repository.Alias;
        _renameDraft = repository.FullName;
        _renameError = null;
    }

    private void CancelRename()
    {
        _renamingAlias = null;
        _renameDraft = string.Empty;
        _renameError = null;
    }

    private async Task OnRenameKeyDownAsync(KeyboardEventArgs e, GitHubRepositoryRef repository)
    {
        if (e.Key == "Enter") await ApplyRenameAsync(repository);
        else if (e.Key == "Escape") CancelRename();
    }

    /// <summary>
    /// Applies the rename the form asks for: the store moves its row and records
    /// the move, and the entries and inbox items filed against the old id are
    /// carried across here, one call per module. The registry's record means the
    /// next start would carry them anyway; doing it now is what lets the card say
    /// how many followed, and what spares the working set a session pointing at
    /// a coordinate the registry no longer lists.
    /// <para>
    /// A refusal from the store is the form's to show and leaves the form open:
    /// a name that is not a coordinate, or is taken, is a thing to correct, not
    /// a thing to have tried. Idempotent against the second commit an Enter key
    /// can raise, because a form that has closed has nothing left to apply.
    /// </para>
    /// </summary>
    private async Task ApplyRenameAsync(GitHubRepositoryRef repository)
    {
        if (_renamingAlias != repository.Alias) return;

        var error = GitHub.Settings.RenameRepository(repository.Alias, _renameDraft, out var rename);
        if (rename is null)
        {
            _renameError = error;
            return;
        }

        _repoError = error;
        _draftRepos = RepositorySettingsText();
        SyncRepositoryDrafts();
        CancelRename();

        _renameNote = await FollowRenameAsync(rename);
        _renameNoteAlias = repository.Alias;
    }

    /// <summary>
    /// Re-points the entries and inbox items that named the renamed repository
    /// by its old id, and words what happened for the card.
    /// <para>
    /// The two modules are optional here — a host that composes Settings without
    /// them (the storybook, a unit test) has nothing to carry — so each is
    /// resolved rather than injected, as the sync services above are. A module
    /// that refuses is reported in the same breath rather than swallowed: the
    /// registry has already moved on, and an entry left behind is exactly the
    /// thing somebody would want to know about — though the next start's pass
    /// will try it again.
    /// </para>
    /// </summary>
    private async Task<string> FollowRenameAsync(RepositoryRename rename)
    {
        var tasks = Services.GetService<ITaskItems>();
        var inbox = Services.GetService<IInboxItems>();

        var entries = tasks is null ? 0 : await CountOrReport(tasks.RenameRepositoryAsync(rename.OldId, rename.NewId), "Entries");
        var items = inbox is null ? 0 : await CountOrReport(inbox.RenameRepositoryAsync(rename.OldId, rename.NewId), "Inbox items");

        return $"Renamed {rename.OldId} to {rename.NewId}; {Plural(entries, "entry", "entries")} and {Plural(items, "inbox item", "inbox items")} followed it.";

        async Task<int> CountOrReport(Task<Result<int>> rewrite, string what)
        {
            var result = await rewrite;
            if (result.IsSuccess) return result.Value;

            var message = $"{what} could not follow the rename: {result.Error.Message}";
            _repoError = _repoError is null ? message : $"{_repoError} {message}";
            return 0;
        }

        static string Plural(int count, string one, string many) => $"{count} {(count == 1 ? one : many)}";
    }


    private void AddRepositoryDraft()
    {
        var separator = string.IsNullOrWhiteSpace(_draftRepos) ? string.Empty : Environment.NewLine;
        _draftRepos = $"{_draftRepos}{separator}new-repository = owner/repo";
        _repoError = "Replace the placeholder with the repository owner/repo, then leave the field to save it.";
    }

    private string CloneDirectoryDraft(GitHubRepositoryRef repo)
    {
        if (!_draftCloneDirectories.TryGetValue(repo.Alias, out var draft))
        {
            draft = repo.CloneDirectory ?? string.Empty;
            _draftCloneDirectories[repo.Alias] = draft;
        }

        return draft;
    }

    /// <summary>
    /// The badge inside the path field, or nothing at all for a section that was
    /// never looked up - off, or with no folder of its own. Returning null rather
    /// than an empty fragment is what keeps the field's suffix box off those rows
    /// entirely, so their input keeps the width it always had.
    /// </summary>
    /// <remarks>
    /// The sentence under the field no longer says "Folder found.", so this badge
    /// is where that fact lives: it carries its own accessible name rather than
    /// leaving the answer to the colour, and the two states differ by glyph as
    /// well as by fill for a reader who sees neither.
    /// </remarks>
    private static RenderFragment? DevbookFolderMarker(DevbookFolderLocation? location)
    {
        if (location is null) return null;

        return location.Available
            ? @<span class="devbook-folder__marker devbook-folder__marker--found"
                     data-testid="devbook-folder-marker"
                     role="img"
                     aria-label="Folder found.">✓</span>
            : @<span class="devbook-folder__marker devbook-folder__marker--missing"
                     data-testid="devbook-folder-marker"
                     role="img"
                     aria-label="Folder not found.">✕</span>;
    }

    /// <summary>Whether the configured folder is there, for anything reading the row
    /// from outside - a test, or automation. Null for a section that was never looked
    /// up, so the attribute is left off rather than claiming a state it has not
    /// got.</summary>
    private static string? DevbookFolderState(DevbookFolderLocation? location) => location switch
    {
        null => null,
        { Available: true } => "found",
        { Pending: true } => "pending",
        _ => "missing"
    };

    private string DevbookPathDraft(GitHubRepositoryRef repo, DevbookFolderSetting folder)
    {
        var key = DevbookDraftKey(repo.Alias, folder.Key);
        if (!_draftDevbookPaths.TryGetValue(key, out var draft))
        {
            draft = folder.Path ?? string.Empty;
            _draftDevbookPaths[key] = draft;
        }

        return draft;
    }

    private void RemoveRepository(GitHubRepositoryRef repository)
    {
        _repoError = GitHub.Settings.RemoveRepository(repository.Alias);
        _draftRepos = RepositorySettingsText();
        SyncRepositoryDrafts();
    }

    private void ApplyCloneDirectory(string alias)
    {
        _draftCloneDirectories.TryGetValue(alias, out var value);
        _repoError = GitHub.Settings.SetCloneDirectory(alias, value);
        SyncRepositoryDrafts();
    }

    /// <summary>
    /// The devbook-source control is <see cref="DevbookSourceSelection"/>'s,
    /// not this screen's. The pane offers the same choice, and two copies of the
    /// options would drift the first time a case was added to one of them.
    /// </summary>
    private async Task ApplyDevbookSourceAsync(GitHubRepositoryRef repository, string? value)
    {
        if (DevbookSourceSelection.IsLoadRequest(value))
        {
            await LoadBranchesAsync(repository);
            return;
        }

        _repoError = DevbookSource.Select(repository.Alias, value);
        SyncRepositoryDrafts();
    }

    private async Task LoadBranchesAsync(GitHubRepositoryRef repository)
    {
        _branchError = null;
        _loadingBranches = true;

        try
        {
            _branchError = await DevbookSource.LoadBranchesAsync(repository.Alias, CancellationToken.None);
        }
        finally
        {
            _loadingBranches = false;
        }
    }

    private bool _loadingBranches;
    private string? _branchError;

    private string _draftDevbookCacheDirectory = string.Empty;
    private string? _devbookCacheError;

    // ---- Dashboard activity detail --------------------------------------

    /// <summary>Resolved rather than injected, for the reason the Devices panel's
    /// collaborators are: it is registered by the two desktop heads and by nothing
    /// that only wants a settings screen, and a settings screen that failed to open
    /// because a dashboard cache was absent would be the worse of the two
    /// answers.</summary>
    private IPullRequestDetailCache? _activityCache;

    /// <summary>The listing beside the detail: which pull requests and issues there
    /// were, kept so the next read walks only what changed. Forgotten with the
    /// detail rather than on its own, because "forget this repository" means both
    /// to the person pressing it and a listing without its detail would only save
    /// the cheaper half of the fetch.</summary>
    private IActivityListingCache? _listingCache;

    /// <summary>Which repositories have been forgotten since this screen opened.
    /// Keyed on the alias, so the message follows the repository rather than
    /// whichever card happens to be open.</summary>
    private readonly HashSet<string> _forgottenActivity = new(StringComparer.Ordinal);

    /// <summary>What the section says. Both halves state the cost plainly, because
    /// the cost is the whole of the decision: the next dashboard read is a slow
    /// one.
    /// <para>
    /// The resting half states the rule rather than the state. Nothing here reads
    /// the cache folder, so "saved detail is reused" would be a claim about disk
    /// that this screen has not checked — and on a first run, before any dashboard
    /// read, it would be false. A sentence describing what the app does with detail
    /// once it has it is true whether or not any has been saved yet, which is the
    /// only version of it worth putting on screen.
    /// </para></summary>
    private string ActivityCacheStatus(GitHubRepositoryRef repository) =>
        _forgottenActivity.Contains(repository.Alias)
            ? $"Forgotten. The next dashboard read walks every page and fetches every pull request's detail in {repository.FullName} again, which takes noticeably longer than usual."
            : $"A merged pull request's detail never changes, so it is saved after it is read and only new pull requests cost a call. Forgetting it means the next dashboard read walks every page and fetches every pull request's detail in {repository.FullName} again.";

    /// <summary>Drops one repository's saved listing and pull-request detail.
    /// Nothing else is touched — the other repositories keep theirs, and this one
    /// keeps its settings.</summary>
    private void ForgetActivityCache(GitHubRepositoryRef repository)
    {
        _activityCache?.ForgetRepository(repository);
        _listingCache?.ForgetRepository(repository);
        _forgottenActivity.Add(repository.Alias);
    }

    /// <summary>Commits the snapshot folder. Blank returns it to the default,
    /// which is what clearing the field means everywhere else on this screen.</summary>
    private void ApplyDevbookCacheDirectory()
    {
        _devbookCacheError = Store.SetDevbookCacheDirectory(_draftDevbookCacheDirectory);
        _draftDevbookCacheDirectory = Store.IsDefaultDevbookCacheDirectory ? string.Empty : Store.DevbookCacheDirectory;
    }

    private void OnDevbookCacheDirectoryKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") ApplyDevbookCacheDirectory();
        else if (e.Key == "Escape") _draftDevbookCacheDirectory = Store.IsDefaultDevbookCacheDirectory ? string.Empty : Store.DevbookCacheDirectory;
    }

    private LocalGitRepositoryStatus CloneStatus(GitHubRepositoryRef repository) =>
        LocalGit.GetStatus(repository, CloneDirectoryDraft(repository));

    private bool CanClone(GitHubRepositoryRef repository) =>
        !_cloningRepositories.Contains(repository.Alias) && CloneStatus(repository).CanClone;

    private string CloneButtonText(GitHubRepositoryRef repository)
    {
        if (_cloningRepositories.Contains(repository.Alias)) return "Cloning...";

        var status = CloneStatus(repository);
        return status.IsCloned ? "Already cloned" : "Clone repository";
    }

    private async Task CloneRepositoryAsync(GitHubRepositoryRef repository)
    {
        _cloningRepositories.Add(repository.Alias);
        _repoError = null;

        try
        {
            var result = await LocalGit.CloneAsync(repository, CloneDirectoryDraft(repository));
            if (result.Success && result.CloneDirectory is not null)
            {
                _repoError = GitHub.Settings.SetCloneDirectory(repository.Alias, result.CloneDirectory);
            }
            else
            {
                _repoError = result.Message;
            }

            SyncRepositoryDrafts();
        }
        finally
        {
            _cloningRepositories.Remove(repository.Alias);
        }
    }

    private void SetDevbookFolderEnabled(GitHubRepositoryRef repo, DevbookFolderSetting folder, bool enabled)
    {
        _repoError = GitHub.Settings.SetDevbookFolder(
            repo.Alias,
            folder.Key,
            enabled,
            DevbookPathDraft(repo, folder));
        SyncRepositoryDrafts();
    }

    private void ApplyDevbookFolderPath(GitHubRepositoryRef repo, DevbookFolderSetting folder)
    {
        _repoError = GitHub.Settings.SetDevbookFolder(
            repo.Alias,
            folder.Key,
            folder.Enabled,
            DevbookPathDraft(repo, folder));
        SyncRepositoryDrafts();
    }

    private void OnClonePathKeyDown(KeyboardEventArgs e, GitHubRepositoryRef repo)
    {
        if (e.Key == "Enter") ApplyCloneDirectory(repo.Alias);
        else if (e.Key == "Escape") _draftCloneDirectories[repo.Alias] = repo.CloneDirectory ?? string.Empty;
    }

    private void OnDevbookPathKeyDown(KeyboardEventArgs e, GitHubRepositoryRef repo, DevbookFolderSetting folder)
    {
        if (e.Key == "Enter") ApplyDevbookFolderPath(repo, folder);
        else if (e.Key == "Escape") _draftDevbookPaths[DevbookDraftKey(repo.Alias, folder.Key)] = folder.Path ?? string.Empty;
    }

    private void SyncRepositoryDrafts()
    {
        foreach (var repo in GitHub.Repositories)
        {
            _draftCloneDirectories[repo.Alias] = repo.CloneDirectory ?? string.Empty;

            foreach (var folder in repo.DevbookFolders)
            {
                _draftDevbookPaths[DevbookDraftKey(repo.Alias, folder.Key)] = folder.Path ?? string.Empty;
            }
        }

        EnsureActiveRepositoryPage();
    }

    private GitHubRepositoryRef? FindActiveRepository()
    {
        if (!VisibleRepositories.Any()) return null;

        if (!string.IsNullOrWhiteSpace(_activeRepositoryAlias))
        {
            var selected = VisibleRepositories.FirstOrDefault(repo => string.Equals(repo.Alias, _activeRepositoryAlias, StringComparison.Ordinal));
            if (selected is not null) return selected;
        }

        return VisibleRepositories[0];
    }

    private bool IsActiveRepository(GitHubRepositoryRef repo) =>
        string.Equals(FindActiveRepository()?.Alias, repo.Alias, StringComparison.Ordinal);

    private void EnsureActiveRepositoryPage()
    {
        if (!VisibleRepositories.Any())
        {
            _activeRepositoryAlias = null;
            return;
        }

        _activeRepositoryAlias = FindActiveRepository()?.Alias;
    }

    private string RepositorySettingsText() => GitHub.Settings.Current.ToText();

    private static string DevbookDraftKey(string alias, string folderKey) => $"{alias}|{folderKey}";


    private string RepositoryTokenDraft(GitHubRepositoryRef repo)
    {
        if (!_draftTokens.TryGetValue(repo.Alias, out var draft))
        {
            draft = string.Empty;
            _draftTokens[repo.Alias] = draft;
        }

        return draft;
    }

    private async Task OnRepositoryTokenKeyDownAsync(KeyboardEventArgs e, GitHubRepositoryRef repo)
    {
        if (e.Key == "Enter") await ApplyRepositoryTokenAsync(repo);
        else if (e.Key == "Escape") _draftTokens[repo.Alias] = string.Empty;
    }

    private async Task ApplyRepositoryTokenAsync(GitHubRepositoryRef repo)
    {
        var draft = RepositoryTokenDraft(repo);
        if (string.IsNullOrWhiteSpace(draft)) return;

        _repoError = GitHub.Settings.SetRepositoryToken(repo.Alias, draft);
        _draftTokens[repo.Alias] = string.Empty;
        SyncRepositoryDrafts();
        await CheckConnectionAsync();
    }

    private async Task ClearRepositoryTokenAsync(GitHubRepositoryRef repo)
    {
        _repoError = GitHub.Settings.SetRepositoryToken(repo.Alias, null);
        _draftTokens[repo.Alias] = string.Empty;
        SyncRepositoryDrafts();
        await CheckConnectionAsync();
    }

    private async Task CheckConnectionAsync()
    {
        _connection = null;
        StateHasChanged();

        try
        {
            _connection = await GitHub.DescribeConnectionAsync();
        }
        catch (Exception)
        {
            _connection = new GitHubConnection(false, "Couldn't work out how to reach GitHub from this machine.");
        }

        StateHasChanged();
    }

    // ---- Accounts -------------------------------------------------------

    /// <summary>The two ways this machine can satisfy an account, in the order
    /// they are preferred. Static because the list is the enum and the enum does
    /// not change per render.</summary>
    private static readonly IReadOnlyList<SelectorOption> CredentialKindOptions =
    [
        new(nameof(GitHubCredentialKind.GhCli), "GitHub CLI"),
        new(nameof(GitHubCredentialKind.PersonalAccessToken), "Personal access token")
    ];

    private IReadOnlyList<GitHubAccount> ConfiguredAccounts => GitHub.Settings.Current.Accounts;

    /// <summary>The logins <c>gh</c> holds that are not configured yet - the whole
    /// reason this panel does not start with an empty text box. An account already
    /// configured is dropped rather than offered again, so the list is a list of
    /// things left to do.</summary>
    private IReadOnlyList<GhCliAccount> DiscoverableCliAccounts =>
        [.. _cliAccounts.Where(candidate => GitHub.Settings.Current.Account(candidate.Login) is null)];

    private GitHubAccount? ActiveAccount => FindActiveAccount();

    private GitHubAccount? FindActiveAccount()
    {
        if (ConfiguredAccounts.Count == 0) return null;

        if (!string.IsNullOrWhiteSpace(_activeAccountLogin))
        {
            var selected = GitHub.Settings.Current.Account(_activeAccountLogin);
            if (selected is not null) return selected;
        }

        return ConfiguredAccounts[0];
    }

    private void ShowAccountPage(string login) => _activeAccountLogin = GitHubAccount.NormalizeLogin(login);

    private string AccountsSummary() => ConfiguredAccounts.Count switch
    {
        0 => "No accounts yet - every call goes out as whichever account this machine is signed in as, which is what Backlog has always done.",
        1 => $"One account: {ConfiguredAccounts[0].Label}. Bind a repository to it on the Repositories tab.",
        var count => $"{count} accounts. Each repository picks the one it is worked as on the Repositories tab."
    };

    /// <summary>
    /// Adds the login <c>gh</c> reported, backed by the CLI.
    /// <para>
    /// github.com is the ordinary case and is stored as no host at all, so a host
    /// is only written down when it is a GitHub Enterprise Server one - otherwise
    /// every account on an ordinary machine would carry a value that means "the
    /// default" spelled out.
    /// </para>
    /// </summary>
    private void AddCliAccount(GhCliAccount candidate) => AddAccount(
        candidate.Login,
        GitHubCredentialKind.GhCli,
        string.Equals(candidate.Host, "github.com", StringComparison.OrdinalIgnoreCase) ? null : candidate.Host);

    /// <summary>Commits the typed login on blur or Enter. A blank box is not a
    /// refusal - leaving a field empty is the ordinary way of adding nothing, the
    /// same rule the repository token field follows - so it says nothing rather
    /// than reporting an error somebody did not ask for.</summary>
    private void AddAccountFromDraft()
    {
        if (string.IsNullOrWhiteSpace(_draftAccountLogin)) return;

        AddAccount(_draftAccountLogin, GitHubCredentialKind.GhCli, null);
    }

    private void AddAccount(string login, GitHubCredentialKind credential, string? host)
    {
        var normalized = GitHubAccount.NormalizeLogin(login);

        if (normalized is null)
        {
            _accountMessage = "Type the GitHub login to add.";
            return;
        }

        if (GitHub.Settings.Current.Account(normalized) is not null)
        {
            _accountMessage = $"'{normalized}' is already configured.";
            return;
        }

        _accountMessage = GitHub.Settings.SetAccounts(
        [
            .. ConfiguredAccounts,
            new GitHubAccount(normalized) { Credential = credential, Host = host }
        ]);

        _draftAccountLogin = string.Empty;

        // The card that just appeared is the one to be looking at: the credential
        // it needs is chosen there, and a CLI-backed login on a machine without
        // gh has to be switchable to a pasted token without hunting for it.
        if (_accountMessage is null) _activeAccountLogin = normalized;
    }

    /// <summary>Forgets one account on this machine. The repositories bound to it
    /// are deliberately left alone by the store - the binding is workspace data and
    /// this is a machine act - so what is left behind is an unsatisfied binding,
    /// reported above rather than silently repaired.</summary>
    private void RemoveAccount(GitHubAccount account)
    {
        _accountMessage = GitHub.Settings.RemoveAccount(account.Login);
        _draftAccountTokens.Remove(account.Login);
        _draftAccountEndpoints.Remove(account.Login);

        if (GitHubAccount.IsSameLogin(_activeAccountLogin, account.Login)) _activeAccountLogin = null;
    }

    private void ApplyAccountCredential(GitHubAccount account, string? kind)
    {
        if (!Enum.TryParse<GitHubCredentialKind>(kind, ignoreCase: true, out var credential)) return;

        // A pasted token survives a change that keeps the kind that can hold one;
        // switching to the CLI drops it, which the store enforces anyway - a gho_
        // token is rotated by gh, so one written down would go stale and be sent.
        _accountMessage = GitHub.Settings.SetAccountCredential(
            account.Login,
            credential,
            credential is GitHubCredentialKind.PersonalAccessToken ? account.Token : null);
    }

    private string AccountTokenDraft(GitHubAccount account)
    {
        if (!_draftAccountTokens.TryGetValue(account.Login, out var draft))
        {
            draft = string.Empty;
            _draftAccountTokens[account.Login] = draft;
        }

        return draft;
    }

    private void ApplyAccountToken(GitHubAccount account)
    {
        var draft = AccountTokenDraft(account);
        if (string.IsNullOrWhiteSpace(draft)) return;

        _accountMessage = GitHub.Settings.SetAccountCredential(
            account.Login,
            GitHubCredentialKind.PersonalAccessToken,
            draft);
        _draftAccountTokens[account.Login] = string.Empty;
    }

    private void ClearAccountToken(GitHubAccount account)
    {
        _accountMessage = GitHub.Settings.SetAccountCredential(
            account.Login,
            GitHubCredentialKind.PersonalAccessToken,
            null);
        _draftAccountTokens[account.Login] = string.Empty;
    }

    private void OnAccountTokenKeyDown(KeyboardEventArgs e, GitHubAccount account)
    {
        if (e.Key == "Enter") ApplyAccountToken(account);
        else if (e.Key == "Escape") _draftAccountTokens[account.Login] = string.Empty;
    }

    private string AccountEndpointDraft(GitHubAccount account)
    {
        if (!_draftAccountEndpoints.TryGetValue(account.Login, out var draft))
        {
            draft = account.ApiEndpoint ?? string.Empty;
            _draftAccountEndpoints[account.Login] = draft;
        }

        return draft;
    }

    private void ApplyAccountEndpoint(GitHubAccount account)
    {
        _accountMessage = GitHub.Settings.SetAccountApiEndpoint(account.Login, AccountEndpointDraft(account));
        _draftAccountEndpoints[account.Login] = GitHub.Settings.Current.Account(account.Login)?.ApiEndpoint ?? string.Empty;
    }

    private void OnAccountEndpointKeyDown(KeyboardEventArgs e, GitHubAccount account)
    {
        if (e.Key == "Enter") ApplyAccountEndpoint(account);
        else if (e.Key == "Escape") _draftAccountEndpoints[account.Login] = account.ApiEndpoint ?? string.Empty;
    }

    private void OnAccountLoginKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddAccountFromDraft();
        else if (e.Key == "Escape") _draftAccountLogin = string.Empty;
    }

    /// <summary>
    /// What stands between this account and a call going out as it, or null when
    /// nothing does.
    /// <para>
    /// Only what can be answered here. Whether <c>gh</c> would really hand over a
    /// token is a subprocess away, so the CLI case is judged against the list this
    /// page already read - and only when that list said something, because an empty
    /// list means "no gh here to ask", not "gh is not signed in as this".
    /// </para>
    /// </summary>
    private string? AccountProblem(GitHubAccount account)
    {
        if (account.Credential is GitHubCredentialKind.PersonalAccessToken && !account.HasToken)
        {
            return $"No personal access token has been pasted for '{account.Login}', so nothing worked as it can reach GitHub.";
        }

        if (account.Credential is GitHubCredentialKind.GhCli
            && _cliAccounts.Count > 0
            && !_cliAccounts.Any(candidate => GitHubAccount.IsSameLogin(candidate.Login, account.Login)))
        {
            return $"The GitHub CLI on this machine is not signed in as '{account.Login}'. Sign in with `gh auth login`, or give this account a personal access token instead.";
        }

        return null;
    }

    private static string AccountSummary(GitHubAccount account) =>
        account.Credential is GitHubCredentialKind.PersonalAccessToken
            ? $"A personal access token is stored for '{account.Login}'."
            : $"Backlog asks the GitHub CLI for a token for '{account.Login}' when a call needs one, and never writes it down.";

    /// <summary>The identity one repository's calls actually leave as, worked out
    /// the same way the transport works it out - by asking the settings for the
    /// path, rather than by reading the binding and hoping the two agree.</summary>
    private GitHubAccountChoice RepositoryBinding(GitHubRepositoryRef repository) =>
        GitHub.Settings.Current.AccountForPath($"repos/{repository.Owner}/{repository.Name}");

    /// <summary>A binding this machine cannot meet, said with both halves somebody
    /// needs: what was being reached for, which the choice carries as its subject,
    /// and which account it was to be reached as.</summary>
    private static string BindingProblem(GitHubAccountChoice binding) => binding.Account is null
        ? $"{binding.Subject} is worked as '{binding.Login}', and this machine has no account for that login. Add it on the Accounts tab, or pick another one here."
        : $"{binding.Subject} is worked as '{binding.Login}', and no personal access token has been pasted for it.";

    private static string BindingSummary(GitHubAccountChoice binding)
    {
        if (binding.IsBound) return $"Worked as '{binding.Login}'.";

        return binding.Token is null
            ? "Default - whichever account this machine is signed in as, which is what Backlog has always done."
            : "Default - falling back to this repository's own personal access token.";
    }

    /// <summary>Every repository this workspace binds to a login this machine
    /// cannot satisfy. Empty on every install that never opened this panel.</summary>
    private IReadOnlyList<string> UnsatisfiedBindings() =>
    [
        .. GitHub.Repositories
            .Select(RepositoryBinding)
            .Where(binding => binding.IsUnsatisfied)
            .Select(BindingProblem)
    ];

    /// <summary>
    /// The accounts a repository can be bound to.
    /// <para>
    /// A binding this machine cannot satisfy is carried as an option of its own,
    /// first, even though there is no account behind it. Without one the select
    /// would fall back to its first entry - the empty one - and read as "Default",
    /// which is the opposite of what the registry says and would hide the very
    /// state this panel exists to report.
    /// </para>
    /// <para>
    /// The reason an account cannot be used goes into the option's own text rather
    /// than into <c>SelectorOption.Hint</c>: a native <c>select</c> draws one string
    /// per option, so a hint on this control would be written and never shown.
    /// </para>
    /// </summary>
    private IReadOnlyList<SelectorOption> AccountOptions(GitHubRepositoryRef repository)
    {
        var options = new List<SelectorOption>();

        if (repository.Account is { } bound && GitHub.Settings.Current.Account(bound) is null)
        {
            options.Add(new SelectorOption(bound, $"{bound} - no account on this machine"));
        }

        options.AddRange(ConfiguredAccounts.Select(account => new SelectorOption(
            account.Login,
            AccountProblem(account) is null ? account.Label : $"{account.Label} - no credential on this machine")));

        return options;
    }

    /// <summary>Binds this repository to an account, or clears the binding back to
    /// the default. No save button, the way every other choice on this screen
    /// works.</summary>
    private void ApplyRepositoryAccount(GitHubRepositoryRef repository, string? login) =>
        _repoError = GitHub.Settings.SetRepositoryAccount(
            repository.Alias,
            string.IsNullOrWhiteSpace(login) ? null : login);

    /// <summary>
    /// Reads the logins <c>gh</c> is signed in to, once the page is on screen.
    /// <para>
    /// After the first render rather than during it, for the same reason the
    /// connection check is: it is a subprocess, and holding the page up on one
    /// would make Settings open slowly for everybody to serve one panel.
    /// </para>
    /// </summary>
    private async Task LoadCliAccountsAsync()
    {
        try
        {
            _cliAccounts = await GitHub.ListCliAccountsAsync();
        }
        catch (Exception)
        {
            // No gh, or a gh too old to answer. An empty list degrades the picker
            // to manual entry rather than blocking the panel.
            _cliAccounts = [];
        }

        StateHasChanged();
    }


    // --- Devices ---------------------------------------------------------
    //
    // The two sync collaborators are resolved rather than injected, and that is
    // the decision rather than a shortcut. Every host registers them, but seven
    // test files render this screen to ask about storage, repositories, accounts
    // and AI, and a required inject would make every one of them compose a sync
    // client to reach a panel they never open. AppFooter reads its optional
    // collaborators the same way, for the same reason.

    /// <summary>What a person is told when something nobody planned for went
    /// wrong. An exception message is written for whoever reads the log, and
    /// putting one on screen either says nothing usable or says too much — a
    /// path, a header, the shape of the service. The detail goes to
    /// <see cref="_deviceLog"/>; the sentence goes here.</summary>
    private const string DeviceUnexpectedFailure = "The sync service could not be reached. Try again in a moment.";

    private DevicePairingClient? _devicePairing;
    private SyncServiceSettingsStore? _syncService;
    private SyncServiceEndpoint? _syncServiceEndpoint;
    private string _draftSyncServiceUrl = string.Empty;
    private string? _syncServiceMessage;
    private bool _syncServiceFailed;

    /// <summary>Optional on purpose: the panel works without it, and the unit
    /// tests that predate the credential-rejected state compose the pairing
    /// client without a token pipeline at all. When it is there, it is the only
    /// thing that can tell a refused credential from an unreachable service.</summary>
    private SyncTokenProvider? _deviceTokens;
    private IDeviceCredentialStore? _deviceCredentials;

    /// <summary>Optional for the reason the pairing client is: a host that has
    /// not registered an <c>ITaskSyncStateStore</c> - which every host must do
    /// for itself, because a shared one would collapse two devices into one -
    /// cannot compose the loop, and a settings screen that failed at startup
    /// over a panel nobody opened would be the worse answer. Absent hides the
    /// section.
    /// <para>
    /// The worker rather than the session, because the exchange is no longer this
    /// screen's to run: the loop runs it on a schedule whether or not anybody is
    /// on this tab, and what is left here is a way to ask for one now and a place
    /// to read what the last one did.
    /// </para></summary>
    private TaskSyncWorker? _taskSync;

    /// <summary>The session loop, on the same terms as <see cref="_taskSync"/>:
    /// null on a head that composed none, and hidden with it.</summary>
    private SessionSyncWorker? _sessionSync;

    /// <summary>Where the desktop head writes its log file, so the Sync tasks
    /// card can point at it: the worker's sentence for an unplanned failure
    /// names no cause, and the file is where the cause went. Optional because
    /// only a host that keeps a file registers it.</summary>
    private AppLogLocation? _logs;

    /// <summary>Optional, like the two above and for the same reason: a test
    /// rendering this screen to ask about storage should not have to compose a
    /// logging stack to reach a panel it never opens.</summary>
    private ILogger? _deviceLog;
    private DeviceStatusResponse? _deviceStatus;
    private PairingCodeResponse? _issuedCode;

    /// <summary>Which of the two starting-over questions is on screen, or null
    /// when neither is. One field rather than two flags: the dialog is one, and
    /// two of them could otherwise both be open.</summary>
    private SyncReset? _syncResetPending;

    /// <summary>The two ways of telling a replica that has drifted to forget
    /// where it thought this device had got to.</summary>
    private enum SyncReset
    {
        /// <summary>Forget how far this device has pushed its session records,
        /// and send every one of them again.</summary>
        RepublishSessions,

        /// <summary>Forget how far this device has pushed, and send everything
        /// again.</summary>
        Republish,

        /// <summary>Forget the feed position, and read the owner's changes from
        /// the beginning.</summary>
        Rehydrate
    }
    private string _draftDeviceName = string.Empty;
    private string _draftPairingCode = string.Empty;
    private string? _devicesMessage;
    private bool _devicesFailed;
    private bool _devicesBusy;

    /// <summary>Set when the status call came back with the service's own code
    /// for it. Separate from the token provider's verdict because they are two
    /// different answers to the same question, and either one is enough.</summary>
    private bool _deviceStatusRejected;
    private bool _forgettingDevice;

    /// <summary>Redraws the expiry line while a code is on screen. Disposed with
    /// the screen, so a settings page left behind does not go on ticking.</summary>
    private System.Threading.Timer? _pairingCodeCountdown;

    private bool SyncEnabled => Features.IsEnabled(SyncFeatures.Sync);

    /// <summary>
    /// What the last exchange did, or an invitation when there has not been one.
    /// Never a failure - those go to the shared devices alert, which is where
    /// every other thing that went wrong on this tab already is.
    /// <para>
    /// The skipped count is only mentioned when it is non-zero, and it is
    /// mentioned at all because the alternative is silence: a document this build
    /// cannot read is dropped so that one bad row cannot stop the device syncing
    /// for ever, and a drop nobody is told about looks exactly like a task that
    /// was never sent.
    /// </para>
    /// <para>
    /// Read off the worker rather than off a field of this screen's own, because
    /// most exchanges now happen while nobody is looking at this tab: a summary
    /// kept here would start at "has not synced yet" every time the page was
    /// opened, however long the loop had been running.
    /// </para>
    /// </summary>
    private string TaskSyncSummaryLine => _taskSync?.LastSummary is { } summary
        ? $"Sent {summary.Pushed}, received {summary.Pulled}, applied {summary.Applied}."
            + (summary.Skipped > 0 ? $" {summary.Skipped} could not be read by this build." : string.Empty)
        : "This device has not synced yet.";

    private string SessionSyncSummaryLine => _sessionSync?.LastSummary is { } summary
        ? $"Sent {summary.Pushed}, received {summary.Pulled}, kept {summary.Applied}."
        : "This device has not synced its sessions yet.";

    private string SyncResetTitle => _syncResetPending switch
    {
        SyncReset.Republish => "Republish everything?",
        SyncReset.Rehydrate => "Rehydrate from scratch?",
        SyncReset.RepublishSessions => "Republish every session?",
        _ => string.Empty
    };

    /// <summary>Plainly what will happen, and how long it will take to say it.
    /// Neither of these loses anything, so neither is worded as a warning - what
    /// they cost is one long exchange, and that is what the sentence is for.</summary>
    private string SyncResetMessage => _syncResetPending switch
    {
        SyncReset.Republish =>
            "Every task on this machine, deleted ones included, will be sent to the cloud again. Nothing is lost: the other devices keep whichever version was edited last. It may take a while on a slow connection.",
        SyncReset.Rehydrate =>
            "This device will read every change the other devices have ever made, from the beginning, and apply the ones it does not already have. Nothing on this machine is deleted. It may take a while on a slow connection.",
        SyncReset.RepublishSessions =>
            "Every Claude and Copilot session record on this machine will be sent to the cloud again - the metadata only, as always. Nothing is lost: the other devices keep one record per session. It may take a while on a slow connection.",
        _ => string.Empty
    };

    private string SyncResetConfirm => _syncResetPending switch
    {
        SyncReset.Republish => "Republish",
        SyncReset.Rehydrate => "Rehydrate",
        SyncReset.RepublishSessions => "Republish",
        _ => "Confirm"
    };

    private DeviceCredential? StoredDevice => _deviceCredentials?.Current;

    /// <summary>
    /// The service has said it has no record of this device, from either of the
    /// two places that can say it conclusively: the token endpoint refusing the
    /// credential, or the status call answering with
    /// <see cref="SyncErrorCodes.DeviceCredentialInvalid"/>.
    /// <para>
    /// What is deliberately not in here is everything else - a timeout, an
    /// unreachable service, a bare 401 with no code. None of those is a verdict
    /// on the credential, and treating them as one would unpair a device every
    /// time a laptop woke up on a dead network.
    /// </para>
    /// </summary>
    private bool DeviceNoLongerRegistered =>
        StoredDevice is not null && (_deviceStatusRejected || _deviceTokens?.CredentialRejected == true);

    private string ForgetDeviceMessage =>
        StoredDevice is { } stored
            ? $"This machine will forget the credential it holds for {stored.DeviceName}. Nothing on the sync service is deleted, and the entries in this backlog are untouched - but pairing again means registering or redeeming a code."
            : "This machine will forget the credential it holds.";

    private string CredentialStorePath =>
        _deviceCredentials?.StorePath ?? "nowhere - cloud sync is not configured in this build";

    private static string PairedDeviceSummary(int count) => count switch
    {
        <= 1 => "No other device is paired yet.",
        2 => "One other device is paired.",
        _ => $"{count - 1} other devices are paired."
    };

    /// <summary>
    /// Whole minutes, rounded up. The number is read while somebody types eight
    /// characters on another device, so "expires in 4 minutes" is the useful
    /// shape and a ticking second count is not.
    /// </summary>
    private static string PairingCodeExpiry(PairingCodeResponse code)
    {
        var remaining = code.ExpiresAt - DateTimeOffset.UtcNow;

        if (remaining <= TimeSpan.Zero) return "This code has expired. Generate another one.";

        var minutes = (int)Math.Ceiling(remaining.TotalMinutes);
        return minutes == 1 ? "Expires in 1 minute." : $"Expires in {minutes} minutes.";
    }

    private async Task RegisterDeviceAsync()
    {
        if (_devicePairing is null)
        {
            ReportDeviceOutcome("Cloud sync is not configured in this build.", failed: true);
            return;
        }

        _devicesBusy = true;
        _devicesMessage = null;

        try
        {
            var result = await _devicePairing.RegisterAsync(_draftDeviceName);

            if (result.IsFailure)
            {
                ReportDeviceOutcome(result.Error.Message, failed: true);
                return;
            }

            ReportDeviceOutcome($"Registered as {result.Value.DeviceName}.", failed: false);
            await RefreshDeviceStatusAsync();
        }
        catch (Exception ex)
        {
            // The client answers its expected failures with a result, so anything
            // arriving here is unexpected - and it still has to reach the screen,
            // because an exception swallowed in an event handler leaves the panel
            // looking like nothing happened at all. What reaches the screen is a
            // sentence; what the exception itself said goes to the log.
            _deviceLog?.LogError(ex, "Registering this device with the sync service failed unexpectedly.");
            ReportDeviceOutcome(DeviceUnexpectedFailure, failed: true);
        }
        finally
        {
            _devicesBusy = false;
        }
    }

    private async Task PairDeviceAsync()
    {
        if (_devicePairing is null)
        {
            ReportDeviceOutcome("Cloud sync is not configured in this build.", failed: true);
            return;
        }

        _devicesBusy = true;
        _devicesMessage = null;

        try
        {
            var result = await _devicePairing.PairAsync(_draftPairingCode, _draftDeviceName);

            if (result.IsFailure)
            {
                ReportDeviceOutcome(result.Error.Message, failed: true);
                return;
            }

            _draftPairingCode = string.Empty;
            ReportDeviceOutcome($"Paired as {result.Value.DeviceName}.", failed: false);
            await RefreshDeviceStatusAsync();
        }
        catch (Exception ex)
        {
            _deviceLog?.LogError(ex, "Pairing this device with the sync service failed unexpectedly.");
            ReportDeviceOutcome(DeviceUnexpectedFailure, failed: true);
        }
        finally
        {
            _devicesBusy = false;
        }
    }

    private async Task IssuePairingCodeAsync()
    {
        if (_devicePairing is null)
        {
            ReportDeviceOutcome("Cloud sync is not configured in this build.", failed: true);
            return;
        }

        _devicesBusy = true;
        _devicesMessage = null;

        try
        {
            var result = await _devicePairing.IssuePairingCodeAsync();

            if (result.IsFailure)
            {
                _issuedCode = null;
                ReportDeviceOutcome(result.Error.Message, failed: true);
                return;
            }

            _issuedCode = result.Value;
            StartPairingCodeCountdown();
            ReportDeviceOutcome("Read this code out on the other device.", failed: false);
        }
        catch (Exception ex)
        {
            _issuedCode = null;
            _deviceLog?.LogError(ex, "Asking the sync service for a pairing code failed unexpectedly.");
            ReportDeviceOutcome(DeviceUnexpectedFailure, failed: true);
        }
        finally
        {
            _devicesBusy = false;
        }
    }

    /// <summary>
    /// The background sync loop, where this host composed one.
    /// <para>
    /// Not a plain <c>GetService</c>, because a missing registration is not the
    /// only way a host declines this. A head that called <c>AddTaskSyncClient</c>
    /// has the worker registered, and that call deliberately registers no
    /// <c>ITaskSyncStateStore</c> - which store is right is the one thing only the
    /// host knows - so on a head that has not chosen one the worker is registered
    /// and unconstructable, and asking for it throws rather than answering null.
    /// </para>
    /// <para>
    /// A head that has not opted in gets the section hidden. It is not swallowed:
    /// what it means goes to the log, because "the sync panel is missing" is a
    /// question somebody will eventually ask, and a settings screen that failed
    /// to open over a panel nobody asked for is the worse of the two answers.
    /// </para>
    /// <para>
    /// Resolving it here does not start it. Both desktop heads ask for it once
    /// after <c>Build()</c>, because a loop that only existed while somebody had
    /// this tab open would be a loop that runs when it is least needed.
    /// </para></summary>
    /// <inheritdoc cref="ResolveTaskSync"/>
    private SessionSyncWorker? ResolveSessionSync()
    {
        try
        {
            return Services.GetService<SessionSyncWorker>();
        }
        catch (InvalidOperationException ex)
        {
            _deviceLog?.LogWarning(ex, "The session sync loop is registered but could not be built; the sessions card is hidden.");
            return null;
        }
    }

    private TaskSyncWorker? ResolveTaskSync()
    {
        try
        {
            return Services.GetService<TaskSyncWorker>();
        }
        catch (InvalidOperationException ex)
        {
            _deviceLog?.LogInformation(
                ex, "Task sync is not composed in this host, so the sync section is not offered.");
            return null;
        }
    }

    /// <summary>
    /// Asks the loop for an exchange now, and returns.
    /// <para>
    /// There is a schedule and a background loop, so this is no longer where a
    /// sync happens - it is a way of not waiting for the next tick. Deliberately
    /// not awaited and deliberately not <c>async</c>: an exchange is a network
    /// call over an unknown connection, and awaiting one inside a click handler
    /// is what made this button hold the render loop for as long as the replica
    /// took to answer. What the exchange did comes back through the worker's
    /// <c>Changed</c>, the same way a tick's does.
    /// </para>
    /// </summary>
    private void SyncTasks()
    {
        if (_taskSync is null)
        {
            ReportDeviceOutcome("Cloud sync is not configured in this build.", failed: true);
            return;
        }

        _devicesMessage = null;
        _taskSync.RequestSync();
    }

    /// <inheritdoc cref="SyncTasks"/>
    private void SyncSessions()
    {
        if (_sessionSync is null)
        {
            ReportDeviceOutcome("Cloud sync is not configured in this build.", failed: true);
            return;
        }

        _devicesMessage = null;
        _sessionSync.RequestSync();
    }

    /// <summary>Carries out whichever starting-over question was answered yes.
    /// Both are one call on the worker: the reset is written to the state file
    /// and a cycle is asked for, so a request that lands during an exchange still
    /// takes effect on the next one.</summary>
    private void ConfirmSyncReset()
    {
        var pending = _syncResetPending;
        _syncResetPending = null;

        if (pending is null) return;

        switch (pending)
        {
            case SyncReset.Republish when _taskSync is not null:
                _taskSync.RepublishEverything();
                ReportDeviceOutcome("Republishing every task on this machine.", failed: false);
                break;

            case SyncReset.Rehydrate when _taskSync is not null:
                _taskSync.RehydrateFromScratch();
                ReportDeviceOutcome("Reading every change from the beginning.", failed: false);
                break;

            case SyncReset.RepublishSessions when _sessionSync is not null:
                _sessionSync.RepublishEverything();
                ReportDeviceOutcome("Republishing every session record on this machine.", failed: false);
                break;

            default:
                break;
        }
    }

    /// <summary>
    /// Redraws when the loop starts or finishes an exchange, and says so when one
    /// failed.
    /// <para>
    /// It arrives on a thread pool thread rather than the renderer's, so it is
    /// marshalled - and the failure goes to the shared devices alert, which is
    /// where every other thing that went wrong on this tab already is.
    /// </para>
    /// <para>
    /// The failure is only read at the end of a cycle. The worker raises at both
    /// ends so the button can go busy, and reporting on the opening raise would
    /// put the previous cycle's failure back on screen the instant somebody
    /// pressed the button to try again.
    /// </para>
    /// </summary>
    /// <inheritdoc cref="OnTaskSyncChanged"/>
    private void OnSessionSyncChanged() => _ = InvokeAsync(() =>
    {
        if (_sessionSync is { IsSyncing: false, LastError: { } failure })
        {
            ReportDeviceOutcome(failure, failed: true);
        }

        StateHasChanged();
    });

    private void OnTaskSyncChanged() => _ = InvokeAsync(() =>
    {
        if (_taskSync is { IsSyncing: false, LastError: { } failure })
        {
            ReportDeviceOutcome(failure, failed: true);
        }

        StateHasChanged();
    });

    /// <summary>One sentence for where the sync traffic goes and why there,
    /// so "No such host is known" has its explanation next to the fix.</summary>
    private string SyncServiceStatusLine
    {
        get
        {
            if (_syncServiceEndpoint is null) return string.Empty;

            var resolved = _syncServiceEndpoint.Resolve();
            return resolved.Source switch
            {
                SyncServiceAddressSource.Settings => $"Talking to {resolved.Address} - the URL entered here.",
                SyncServiceAddressSource.EnvironmentVariable => $"Talking to {resolved.Address} - from {SyncServiceEndpoint.EnvironmentVariable}.",
                SyncServiceAddressSource.ServiceDiscovery => "Started from the Aspire AppHost: talking to this run's own sync service.",
                _ => $"No sync service is configured. Enter its URL above, or set {SyncServiceEndpoint.EnvironmentVariable} before starting the app."
            };
        }
    }

    private async Task ApplySyncServiceUrlAsync()
    {
        if (_syncService is null) return;

        // Enter arrives twice - once as the key and once as the change the
        // browser commits behind it - so an unchanged draft is a no-op rather
        // than a second save and a second status call. A refused value is the
        // exception: it stays in the field with its message, so the second
        // arrival repeats the same refusal instead of clearing it.
        var stored = _syncService.Current.ServiceUrl ?? string.Empty;
        if (_syncServiceMessage is null && string.Equals(_draftSyncServiceUrl, stored, StringComparison.Ordinal)) return;

        var error = _syncService.SetServiceUrl(_draftSyncServiceUrl);
        _syncServiceFailed = error is not null;
        _syncServiceMessage = error;
        if (error is not null) return;

        _draftSyncServiceUrl = _syncService.Current.ServiceUrl ?? string.Empty;

        // The next client the factory hands out already points at the new
        // address - but the one this page resolved when it opened does not, its
        // HttpClient was configured then. So ask for a fresh one (typed clients
        // are transient) before asking the card above to check again, which is
        // how a person finds out they typed it right.
        _devicePairing = Services.GetService<DevicePairingClient>();
        _devicesMessage = null;
        await RefreshDeviceStatusAsync();
    }

    private async Task OnSyncServiceKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ApplySyncServiceUrlAsync();
        else if (e.Key == "Escape")
        {
            _draftSyncServiceUrl = _syncService?.Current.ServiceUrl ?? string.Empty;
            _syncServiceMessage = null;
            _syncServiceFailed = false;
        }
    }

    /// <summary>Who the service says this device is, which is where the count of
    /// paired devices comes from. An ordinary failure is still not reported: the
    /// card has the stored identity to show, and an unreachable service saying so
    /// twice on one screen is noise.
    /// <para>
    /// One failure is not ordinary. A 401 carrying
    /// <see cref="SyncErrorCodes.DeviceCredentialInvalid"/> is the service saying
    /// it has no record of this device, and that is the whole state the panel
    /// needs in order to offer a way back. Any other failure leaves the verdict
    /// where it was rather than clearing it, because it is not an answer to the
    /// same question.
    /// </para>
    /// <para>
    /// And when the failure carried no answer at all, the panel goes and asks.
    /// See <see cref="AskWhetherTheCredentialStillWorksAsync"/> for why that is
    /// a question rather than a retry - and for the one case in which the answer
    /// is then used: a service that has just minted a token for this credential
    /// has said the device is still in, so the count it refused a moment ago is
    /// asked for once more, with that token. Without this, the first load after
    /// the service restarted said "Paired as" and nothing about the other devices
    /// until the tab was opened again.
    /// </para>
    /// </summary>
    private async Task RefreshDeviceStatusAsync()
    {
        if (_devicePairing is null || StoredDevice is null)
        {
            _deviceStatus = null;
            return;
        }

        try
        {
            if (RecordDeviceStatus(await _devicePairing.GetStatusAsync())) return;

            if (!await AskWhetherTheCredentialStillWorksAsync()) return;

            // Once, and only here: the token endpoint has just answered that the
            // credential is good, and the provider is holding the token it was
            // answered with, so this call goes out with it rather than minting
            // another. Whatever it says is taken as final - a second bare 401
            // is not asked about again.
            _ = RecordDeviceStatus(await _devicePairing.GetStatusAsync());
        }
        catch (Exception)
        {
            _deviceStatus = null;
        }
    }

    /// <summary>Takes a status answer onto the card. <c>true</c> when it was an
    /// answer - a status, or the service saying the device is gone - and
    /// <c>false</c> when it said nothing that settles the question.</summary>
    private bool RecordDeviceStatus(Result<DeviceStatusResponse> result)
    {
        _deviceStatus = result.IsSuccess ? result.Value : null;

        if (result.IsSuccess)
        {
            _deviceStatusRejected = false;
            return true;
        }

        if (string.Equals(result.Error.Code, SyncErrorCodes.DeviceCredentialInvalid, StringComparison.Ordinal))
        {
            _deviceStatusRejected = true;
            return true;
        }

        return false;
    }

    /// <summary>
    /// The status call failed without saying why, and this device holds a
    /// credential. Asking the token endpoint for a token is the one way to find
    /// out whether that credential still means anything, because it is the only
    /// endpoint whose 401 is unambiguous - it is anonymous, so the credential in
    /// the body is the only thing it can be refusing.
    /// <para>
    /// This is a question, not a retry: the status call that failed is not sent
    /// again with the token it was refused for. Nothing is hammered either - the
    /// failed request has already dropped that token, so this is one call, and a
    /// service that is merely down answers it with nothing and leaves the device
    /// paired. What the caller does with a <c>true</c> is the one bounded
    /// exception: the count that the refused call was for is asked for again,
    /// once, because the service has just said the credential is good and there
    /// is now a token it will accept.
    /// </para>
    /// <para>
    /// Costs nothing when all is well, because a status call that succeeded
    /// never gets here.
    /// </para>
    /// </summary>
    /// <returns><c>true</c> when the service issued a token for this credential;
    /// <c>false</c> when it refused, was unreachable, or could not be asked.</returns>
    private async Task<bool> AskWhetherTheCredentialStillWorksAsync()
    {
        if (_deviceTokens is null || StoredDevice is null) return false;

        // The verdict is the point; the token itself is of no interest here -
        // the provider keeps it for the call that follows.
        return await _deviceTokens.GetAccessTokenAsync() is not null;
    }

    /// <summary>
    /// Forgets the credential this machine holds. The service keeps its own
    /// record - this head simply stops claiming to be that device - so the way
    /// back is registering or redeeming a code, which the panel now offers
    /// because <see cref="StoredDevice"/> has gone.
    /// <para>
    /// Clearing the store raises its <c>Changed</c> event, which is what drops
    /// the cached token and any standing rejection verdict with it.
    /// </para>
    /// </summary>
    private void ForgetDevice()
    {
        _forgettingDevice = false;

        if (_deviceCredentials is null)
        {
            ReportDeviceOutcome("Cloud sync is not configured in this build.", failed: true);
            return;
        }

        _deviceCredentials.Clear();

        // Everything on the panel described the credential that has just gone.
        _deviceStatus = null;
        _deviceStatusRejected = false;
        _issuedCode = null;
        _pairingCodeCountdown?.Dispose();
        _pairingCodeCountdown = null;

        ReportDeviceOutcome(
            "This device has been forgotten. Register it again, or pair it with a device that is already in.",
            failed: false);
    }

    /// <summary>The verdict moved, and it usually moved on a background thread.</summary>
    private void OnCredentialRejectedChanged() => _ = InvokeAsync(StateHasChanged);

    private void ReportDeviceOutcome(string message, bool failed)
    {
        _devicesMessage = message;
        _devicesFailed = failed;
    }

    private void StartPairingCodeCountdown()
    {
        _pairingCodeCountdown?.Dispose();
        _pairingCodeCountdown = new System.Threading.Timer(
            _ => _ = InvokeAsync(StateHasChanged),
            state: null,
            dueTime: TimeSpan.FromSeconds(15),
            period: TimeSpan.FromSeconds(15));
    }

    /// <summary>
    /// Lets go of everything that outlives a render.
    /// <para>
    /// Neither the worker nor the token provider is disposed here - both are
    /// singletons, and the worker goes on syncing after this page closes, which
    /// is the whole point of it. What is let go of is the subscriptions: a screen
    /// still on a singleton's event would be kept alive by it and would call
    /// <c>StateHasChanged</c> on a renderer that is gone.
    /// </para>
    /// </summary>
    public void Dispose()
    {
        _pairingCodeCountdown?.Dispose();

        if (_taskSync is not null) _taskSync.Changed -= OnTaskSyncChanged;
        if (_sessionSync is not null) _sessionSync.Changed -= OnSessionSyncChanged;
        if (_backup is not null) _backup.Changed -= OnBackupChanged;
        if (_deviceTokens is not null) _deviceTokens.CredentialRejectedChanged -= OnCredentialRejectedChanged;
        DevbookFolders.Changed -= OnDevbookFoldersChanged;
    }

    private void OnDevbookFoldersChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>Asks again, so a <c>gh auth login</c> in another window is noticed
    /// without restarting the app. The connection probe is what forgets the CLI's
    /// previous answer, so it is re-asked first.</summary>
    private async Task RefreshCliAccountsAsync()
    {
        await CheckConnectionAsync();
        await LoadCliAccountsAsync();
    }
}
