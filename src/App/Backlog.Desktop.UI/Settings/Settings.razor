    /// while none is. One at a time: the form sits on the card, and a card shows
    /// one repository.</summary>
    private string? _renamingAlias;
    private string _renameDraft = string.Empty;
    private string? _renameError;

    /// <summary>What the last rename did — the new name, and how many entries
    /// and inbox items followed — and which repository it was, so the sentence
    /// shows on that card alone.</summary>
    private string? _renameNote;
    private string? _renameNoteAlias;
    private string _draftStorageRepository = string.Empty;
    private string? _storageRepositoryError;
    private string? _backupScheduleError;
    private readonly Dictionary<string, string> _draftWorkingHours = new(StringComparer.Ordinal);
    private string? _workingHoursError;
    private GitHubConnection? _connection;
    private string? _featureMessage;
    private string _draftAzureFoundryEndpoint = string.Empty;
    private string _draftAzureFoundryDeployment = string.Empty;
    private string _draftAzureFoundryApiVersion = AzureFoundrySettingsStore.DefaultApiVersion;
    private string _draftAzureFoundryApiKey = string.Empty;
    private string? _azureFoundryMessage;
    private string _draftGitHubUsageEndpoint = string.Empty;
    private string? _gitHubUsageMessage;

    // One draft per Claude account per field, keyed by the account's id. The
    // dictionaries are refilled from the store after every apply, so a card that
    // was just saved shows what was saved rather than what was typed.
    private readonly Dictionary<string, string> _draftClaudeNames = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _draftClaudeEndpoints = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _draftClaudeActors = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _draftClaudeWorkspaces = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string?> _claudeAccountMessages = new(StringComparer.Ordinal);
    private string? _activeClaudeAccountId;

    /// <summary>Typed, never loaded. A stored key is not read back into its field -
