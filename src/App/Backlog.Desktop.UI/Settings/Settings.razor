    private IReadOnlyList<GhCliAccount> _cliAccounts = [];
    private SettingsPage _activePage = SettingsPage.Features;
    private string? _activeRepositoryAlias;

    private enum SettingsPage
    {
        Features,
        Ai,
        Storage,
        Accounts,
        Repositories,
        Devices,
    }

    // The strip speaks in ids; the page still thinks in the enum.
    private static string PageId(SettingsPage page) => page.ToString().ToLowerInvariant();

    private string ActivePageId => PageId(_activePage);

    private void ShowSettingsPageById(string id)
    {
        if (Enum.TryParse<SettingsPage>(id, ignoreCase: true, out var page)) ShowSettingsPage(page);
    }

    private GitHubRepositoryRef? ActiveRepository => FindActiveRepository();

    private bool AdditionalRepositoriesEnabled => Features.IsEnabled(TasksFeatures.AdditionalRepositories);

    private bool AiAssistantEnabled => Features.IsEnabled(AppFeatures.AiAssistant);

    private bool UsageMetricsEnabled => Features.IsEnabled(AppFeatures.UsageMetrics);

    private string RepositoryInputLabel => "Repositories";

    private int RepositoryInputRows => Math.Max(4, GitHub.Repositories.Count + 1);

    private string RepositoryInputPlaceholder => "JSdotNet/Backlog\ndocs = JSdotNet/Backlog-docs";

    private IReadOnlyList<GitHubRepositoryRef> VisibleRepositories => GitHub.Repositories;

    private void ShowSettingsPage(SettingsPage page)
    {
        if (IsSettingsPageAvailable(page))
        {
            _activePage = page;
        }
    }

    private bool IsSettingsPageAvailable(SettingsPage page) => page switch
    {
        SettingsPage.Features or SettingsPage.Storage or SettingsPage.Repositories => true,
        SettingsPage.Ai => AiAssistantEnabled || UsageMetricsEnabled,

        // An account is only ever used to authenticate a GitHub call, and the two
        // features that make one are the integration itself and the organization
        // usage reports. With neither on there is nothing for the panel to say, so
        // it is not offered rather than offered empty.
        SettingsPage.Accounts => Features.IsEnabled(TasksFeatures.GitHubIntegration) || UsageMetricsEnabled,
        SettingsPage.Devices => SyncEnabled,
        _ => false
    };

    private static bool IsUsageMetricsFeature(AppFeatureDefinition feature) =>
        string.Equals(feature.Key, AppFeatures.UsageMetrics, StringComparison.OrdinalIgnoreCase);

    private void SetFeatureEnabled(AppFeatureDefinition feature, bool enabled)
    {
        var error = Features.SetEnabled(feature.Key, enabled);
        _featureMessage = error ?? (feature.AlwaysEnabled
            ? $"{feature.Name} is always available."
            : $"{feature.Name} is now {(enabled ? "enabled" : "disabled")}.");
        EnsureActiveSettingsPage();
        _draftRepos = RepositorySettingsText();
        EnsureActiveRepositoryPage();
    }


    private void ApplyAzureFoundryConnection()
    {
        var error = AzureFoundry.SetConnection(
            _draftAzureFoundryEndpoint,
            _draftAzureFoundryDeployment,
            null,
            _draftAzureFoundryApiVersion);
        _azureFoundryMessage = error ?? "Azure Foundry settings updated.";
        SyncAzureFoundryDrafts();
    }

    private void ApplyAzureFoundryApiKey()
    {
        if (string.IsNullOrWhiteSpace(_draftAzureFoundryApiKey)) return;

        var error = AzureFoundry.SetApiKey(_draftAzureFoundryApiKey);
        _azureFoundryMessage = error ?? "Azure Foundry API key stored.";
        _draftAzureFoundryApiKey = string.Empty;
        SyncAzureFoundryDrafts();
    }

    private void ClearAzureFoundryApiKey()
    {
        var error = AzureFoundry.ClearApiKey();
        _azureFoundryMessage = error ?? "Azure Foundry API key forgotten.";
        _draftAzureFoundryApiKey = string.Empty;
        SyncAzureFoundryDrafts();
    }

    private void OnAzureFoundryKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") ApplyAzureFoundryConnection();
        else if (e.Key == "Escape") SyncAzureFoundryDrafts();
    }

    private void OnAzureFoundryApiKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") ApplyAzureFoundryApiKey();
        else if (e.Key == "Escape") _draftAzureFoundryApiKey = string.Empty;
    }

    private void SyncAzureFoundryDrafts()
    {
        _draftAzureFoundryEndpoint = AzureFoundry.Current.Endpoint ?? string.Empty;
        _draftAzureFoundryDeployment = AzureFoundry.Current.Deployment ?? string.Empty;
        _draftAzureFoundryApiVersion = AzureFoundry.Current.ApiVersion;
    }

    /// <summary>The account whose subpage is open - the chosen one while it still
    /// exists, otherwise the first. The store never leaves the list empty, so there
    /// is always a first.</summary>
    private ClaudeAccount ActiveClaudeAccount =>
        Claude.Current.Account(_activeClaudeAccountId) ?? Claude.Current.Accounts[0];

    private void ShowClaudeAccountPage(string id) => _activeClaudeAccountId = id;

    private string ClaudeAccountsSummary() => Claude.Current.Accounts.Count switch
    {
        1 => "One Claude organization. Add another below if you also belong to a second one.",
        var count => $"{count} Claude organizations. The dashboard adds their spend up."
    };

    private static string Draft(Dictionary<string, string> drafts, ClaudeAccount account) =>
        drafts.GetValueOrDefault(account.Id) ?? string.Empty;

    private void AddClaudeAccount()
    {
        var error = Claude.AddAccount();
        var added = Claude.Current.Accounts[^1];

        _activeClaudeAccountId = added.Id;
        _claudeAccountMessages[added.Id] = error;
        SyncUsageEndpointDrafts();
    }

    private void RemoveClaudeAccount(ClaudeAccount account)
    {
        var error = Claude.RemoveAccount(account.Id);

        _claudeAccountMessages.Remove(account.Id);
        _draftClaudeApiKeys.Remove(account.Id);
        if (ClaudeAccount.IsSameId(_activeClaudeAccountId, account.Id)) _activeClaudeAccountId = null;

        if (error is not null) _claudeAccountMessages[ActiveClaudeAccount.Id] = error;
        SyncUsageEndpointDrafts();
    }

    private void ApplyClaudeUsageSettings(ClaudeAccount account)
    {
        var id = account.Id;
        var errors = new[]
        {
            Claude.SetDisplayName(id, Draft(_draftClaudeNames, account)),
            Claude.SetApiEndpoint(id, Draft(_draftClaudeEndpoints, account)),
            Claude.SetActor(id, Draft(_draftClaudeActors, account)),
            Claude.SetWorkspaceId(id, Draft(_draftClaudeWorkspaces, account))
        };

        var message = string.Join(" ", errors.Where(error => !string.IsNullOrWhiteSpace(error)));
        _claudeAccountMessages[id] = string.IsNullOrWhiteSpace(message) ? "Claude usage API settings updated." : message;

        SyncUsageEndpointDrafts();
    }

    private void OnClaudeUsageKeyDown(KeyboardEventArgs e, ClaudeAccount account)
    {
        if (e.Key == "Enter") ApplyClaudeUsageSettings(account);
        else if (e.Key == "Escape") SyncUsageEndpointDrafts();
    }

    private void ApplyGitHubUsageSettings()
    {
        var error = GitHub.Settings.SetApiEndpoint(_draftGitHubUsageEndpoint);

        _gitHubUsageMessage = string.IsNullOrWhiteSpace(error) ? "GitHub usage API settings updated." : error;

        SyncUsageEndpointDrafts();
    }

    private void OnGitHubUsageKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") ApplyGitHubUsageSettings();
        else if (e.Key == "Escape") SyncUsageEndpointDrafts();
    }

    private void SyncUsageEndpointDrafts()
    {
        foreach (var account in Claude.Current.Accounts)
        {
            _draftClaudeNames[account.Id] = account.DisplayName ?? string.Empty;
            _draftClaudeEndpoints[account.Id] = account.ApiEndpoint;
            _draftClaudeActors[account.Id] = account.Actor ?? string.Empty;
            _draftClaudeWorkspaces[account.Id] = account.WorkspaceId ?? string.Empty;
        }

        _draftGitHubUsageEndpoint = GitHub.Settings.Current.ApiEndpoint;
