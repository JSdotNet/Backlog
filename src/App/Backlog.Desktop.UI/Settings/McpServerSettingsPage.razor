@*
    One page of the Settings screen: this machine's own MCP server (local ADR
    0012) - whether it holds its port, the address a client registers, the port
    itself, why nothing is listening when nothing is, the agents that can reach it
    each by a grant of its own (local ADR 0052 §3), and the latest tool calls the
    audit log holds (local ADR 0052, Phase 0).

    The Agents card took the Bearer token card's place. The shared token is retired
    (local ADR 0052, Phase 1): a registration made from here names a grant, and the
    first start after the upgrade made three for what the app installs itself.

    Offered whatever any feature says. The server is always on while the app runs,
    and the person who needs this page most is the one whose client was just
    refused a connection - on a machine where nothing else may be switched on yet.

    The facts come from the host, through IMcpEndpointSource. The desktop head
    composes it over its own listener. A host that composes none - the browser
    harness - serves the endpoint on its own origin behind no token, and Aspire
    owns its port, so there the page draws that address and nothing to edit.

    The namespace is the screen's rather than the folder's, and this folder has
    no _Imports.razor, for the reason the note at the top of Settings.razor gives.
*@
@namespace Backlog.Desktop.UI.Shell
@inherits SettingsPageBase
@using Backlog.Desktop.UI.Extensions
@using Backlog.Desktop.UI.Mcp
@using Backlog.Infrastructure.Mcp
@using Backlog.Modules.DevPc.Abstractions
@using Backlog.SharedKernel.Mcp
@using Backlog.UI.Components.Data
@using Backlog.UI.Components.Selects
@inject IServiceProvider Services
@inject NavigationManager Navigation
@implements IDisposable

<SettingsHeadline>@Headline</SettingsHeadline>

<div class="setting-columns">
    <SettingsCard Title="@EndpointCardTitle"
                  Id="mcp-server-endpoint-title"
                  Description="Where Claude Code and every other MCP client on this machine reach Backlog's tools."
                  TestId="mcp-server-endpoint-card">
        <Alert BaseClass="setting__status"
               CssClass="@StateTone"
               Role="status"
               Id="mcp-server-state"
               TestId="mcp-server-state"
               Message="@StateLabel" />

        @* The worker's own sentence, verbatim: for a port somebody else holds it
           already says what to do, including changing every registration. *@
        @if (_source?.Unavailable is { } why)
        {
            <p class="setting__note" data-testid="mcp-server-error">@why</p>
        }

        <p class="setting__label" id="mcp-server-address-label">Address</p>
        <div class="setting__body">
            <code data-testid="mcp-server-address" aria-labelledby="mcp-server-address-label">@Address</code>
            <CopyButton Text="@Address.ToString()"
                        Label="Copy the address"
                        TestId="mcp-server-address-copy" />
        </div>

        @if (_source is not null)
        {
            @* A Retry only once a bind has failed: while the listener runs there is
               nothing to retry, and while it starts the attempt is already under
               way. The worker queues the bind off this thread and the outcome comes
               back through Changed. *@
            @if (State == ListenerState.Failed)
            {
                <div class="setting__actions">
                    <AppButton TestId="mcp-server-retry" OnClick="Retry">
                        Retry
                    </AppButton>
                </div>
            }

            @* Saved as you go: a valid port is stored on change or Enter, and the
               listener rebinds to it on its own. A refused one says why beside the
               field and leaves the stored port alone. *@
            <TextField Bare="true"
                       LabelCssClass="setting__label"
                       InputCssClass="@SettingsScreenContext.SettingInputClass(_portError)"
                       Label="Port"
                       Id="mcp-server-port"
                       Type="number"
                       data-testid="mcp-server-port-input"
                       inputmode="numeric"
                       autocomplete="off"
                       aria-describedby="mcp-server-port-status"
                       Value="@_draftPort"
                       ValueChanged="value => _draftPort = value"
                       @onchange="ApplyPort"
                       @onkeydown="OnPortKeyDown" />
            @* A refusal wears the error tone; the store's other sentence - the port
               moved but could not be saved for next time - is news about a port
               that did move, so it is a plain status like the hint it replaces. *@
            <Alert BaseClass="setting__status"
                   CssClass="@(_portError is not null ? "setting__status--error" : null)"
                   Role="status"
                   Id="mcp-server-port-status"
                   TestId="mcp-server-port-status"
                   Message="@(_portError ?? _portNote ?? PortHint)" />
        }
        else
        {
            <p class="setting__note" data-testid="mcp-server-host-note">
                This host serves the endpoint on its own address, and its port is the host's.
            </p>
        }
    </SettingsCard>

    @* The agents waiting for the person (local ADR 0052 §5): one row each, with Trim scopes,
       Decline and Allow with Hello. Drawn only while one waits, so the page says nothing
       about requests while there are none; the headline counts them either way. *@
    @if (_waiting.Count > 0)
    {
        <SettingsCard Title="@McpAgentRequests.WaitingCardTitle"
                      Id="mcp-server-waiting-title"
                      Description="@McpAgentRequests.WaitingNote"
                      CssClass="settings-card--pending"
                      TestId="mcp-server-waiting-card">
            <div class="agent-list" role="list" aria-label="@McpAgentRequests.WaitingCardTitle" data-testid="mcp-server-waiting">
                @foreach (var request in _waiting)
                {
                        <AgentAccessRequest @key="request.Id"
                                            Name="@request.Name"
                                            RequestId="@request.Id"
                                            Meta="@McpAgentRequests.Meta(request, _clock.GetUtcNow())"
                                            Asked="@McpAgentRequests.Options(request)"
                                            Selected="@SelectionOf(request)"
                                            Highlighted="@McpAgents.Highlighted"
                                            Trimmable="true"
                                            Trimming="@(_trimming == request.Id)"
                                            Busy="@(_answering == request.Id)"
                                            Message="@(_requestMessage?.RequestId == request.Id ? _requestMessage.Text : null)"
                                            MessageIsError="@(_requestMessage?.RequestId == request.Id && _requestMessage.IsError)"
                                            EditorId="@($"mcp-request-editor-{request.Id}")"
                                            TestId="mcp-server-request"
                                            OnTrim="() => _trimming = _trimming == request.Id ? null : request.Id"
                                            OnChanged="change => FlipRequestScope(request, change)"
                                            OnDecline="() => DeclineRequestAsync(request)"
                                            OnAllow="() => AllowRequestAsync(request)" />
                }
            </div>
        </SettingsCard>
    }

    @* The agents that can reach Backlog, each by a grant of its own (local ADR 0052 §3),
       in the Bearer token card's old place. Grants are made, changed and revoked here and
       nowhere else: nothing in Dev PC or the Tools pane reads or writes one. A host that
       composes no grant store - the browser harness, which asks for no token - says so
       and offers nothing to add. *@
    <SettingsCard Title="@AgentsCardTitle"
                  Id="mcp-server-agents-title"
                  Description="Each agent reaches Backlog with a grant of its own: the scopes it may use, and a Revoke that cuts off that agent alone."
                  TestId="mcp-server-agents-card"
                  Action="@AgentsAction">
        @if (_grants is null)
        {
            <p class="setting__note" data-testid="mcp-server-agents-note">This host asks for no token, so it keeps no agents.</p>
        }
        else
        {
            @if (_agentsError is not null)
            {
                <Alert BaseClass="setting__status"
                       CssClass="setting__status--error"
                       Role="status"
                       TestId="mcp-server-agents-error"
                       Message="@_agentsError" />
            }

            @if (_adding == AddStep.Details)
            {
                @* Step 1 of 2. Create agent is the act that makes the grant; the switches
                   here only shape it, so nothing is stored until then. *@
                <article class="repo-card" id="mcp-agent-add" data-testid="mcp-server-agent-add" aria-labelledby="mcp-agent-add-title">
                    <header class="repo-card__header">
                        <h3 class="repo-card__title" id="mcp-agent-add-title">Add agent</h3>
                    </header>
                    <TextField Bare="true"
                               LabelCssClass="setting__label"
                               InputCssClass="@SettingsScreenContext.SettingInputClass(_newError)"
                               Label="Name"
                               Id="mcp-agent-name"
                               data-testid="mcp-agent-name-input"
                               autocomplete="off"
                               spellcheck="false"
                               aria-describedby="mcp-agent-name-status"
                               Placeholder="Copilot CLI · Backlog"
                               Value="@_newName"
                               ValueChanged="value => _newName = value"
                               @onkeydown="OnNewNameKeyDown" />
                    <Alert BaseClass="setting__status"
                           CssClass="@(_newError is not null ? "setting__status--error" : null)"
                           Role="status"
                           Id="mcp-agent-name-status"
                           TestId="mcp-agent-name-status"
                           Message="@(_newError ?? NameHint)" />
                    <SelectField Form="true"
                                 Label="Role"
                                 Id="mcp-agent-role"
                                 TestId="mcp-agent-role-select"
                                 LabelCssClass="setting__label"
                                 SelectCssClass="setting__input"
                                 CurrentValue="@_newRole"
                                 Options="@RoleOptions"
                                 HelpText="A role fills in the switches below. Changing a switch turns the role into Custom."
                                 OnChanged="ApplyRole" />
                    <AgentScopeSwitches Options="@McpAgents.Scopes"
                                        Selected="@_newScopes"
                                        IdPrefix="mcp-agent-new"
                                        AriaLabel="Scopes of the new agent"
                                        TestId="mcp-agent-new-scopes"
                                        OnChanged="ChangeNewScope" />
                    <div class="setting__actions">
                        <AppButton Variant="ButtonVariant.Primary" TestId="mcp-agent-create" OnClick="CreateAgentAsync">
                            Create agent
                        </AppButton>
                    </div>
                </article>
            }
            else if (_adding == AddStep.Register && _created is { } created)
            {
                @* Step 2 of 2: what the new agent's configuration takes. It names the grant
                   and never a secret, so it is safe on screen. *@
                <AgentRegistration Name="@created.Name"
                                   Snippet="@ClaudeCodeRegistration(created)"
                                   ClaudeCode="@ClaudeCodeRegistration(created)"
                                   Copilot="@CopilotRegistration(created)"
                                   Footnote="@RegistrationFootnote"
                                   TestId="mcp-server-agent-registration"
                                   OnDone="CloseAdd" />
            }

            @if (_agents.Count == 0)
            {
                <p class="setting__note" data-testid="mcp-server-agents-none">
                    No agent yet. A registration reaches Backlog only with a grant: add one for it.
                </p>
            }
            else
            {
                <ul class="agent-list" aria-label="@AgentsCardTitle" data-testid="mcp-server-agents">
                    @* A grant another agent made sits indented under its granter, saying who
                       granted it and when it expires, with Revoke alone: its scopes are its
                       granter's to set, and trimming the granter trims it (local ADR 0052 §5). *@
                    @foreach (var listed in McpAgents.Listed(_agents))
                    {
                        var grant = listed.Grant;
                        <AgentGrantRow @key="grant.Id"
                                       Name="@grant.Name"
                                       GrantId="@grant.Id"
                                       Meta="@AgentMeta(listed)"
                                       Scopes="@McpAgents.Ordered(grant.Scopes)"
                                       Highlighted="@McpAgents.Highlighted"
                                       CanEditScopes="@(!listed.Delegated)"
                                       CssClass="@(listed.Delegated ? "agent-row--delegated" : null)"
                                       Expanded="@(!listed.Delegated && _editing == grant.Id)"
                                       EditorId="@($"mcp-agent-editor-{grant.Id}")"
                                       TestId="@(listed.Delegated ? "mcp-server-agent-delegated" : "mcp-server-agent")"
                                       OnEditScopes="() => ToggleEditing(grant)"
                                       OnRevoke="() => Revoke(grant)">
                            <AgentScopeSwitches Options="@McpAgents.Scopes"
                                                Selected="@grant.Scopes"
                                                IdPrefix="@($"mcp-agent-{grant.Id}")"
                                                AriaLabel="@($"Scopes of {grant.Name}")"
                                                TestId="mcp-server-agent-scopes"
                                                OnChanged="change => SetScopeAsync(grant, change)" />
                        </AgentGrantRow>
                    }
                </ul>
            }
        }
    </SettingsCard>

    @* The audit log, newest first. Drawn in every host: the harness writes the same
       records the app does. The table scrolls sideways inside its own frame, so six
       columns never take the page with them. *@
    <SettingsCard Title="@ActivityCardTitle"
                  Id="mcp-server-activity-title"
                  Description="@ActivityDescription"
                  TestId="mcp-server-activity-card">
        @if (_activityError is not null)
        {
            <Alert BaseClass="setting__status"
                   CssClass="setting__status--error"
                   Role="status"
                   TestId="mcp-server-activity-error"
                   Message="@_activityError" />
        }
        <DataTable TItem="McpAuditRecord"
                   Items="@_activity"
                   Columns="@ActivityColumns"
                   AriaLabel="@ActivityCardTitle"
                   RowNoun="call"
                   EmptyMessage="No tool call yet."
                   EmptyDescription="Each call a client makes is listed here, newest first, and kept for 30 days."
                   TestId="mcp-server-activity">
            <Row Context="call">
                <td class="data-table__mono" data-testid="mcp-server-activity-time">@When(call.At)</td>
                <td data-testid="mcp-server-activity-caller">@call.Caller</td>
                <td class="data-table__mono" data-testid="mcp-server-activity-tool">@call.Tool</td>
                <td class="data-table__mono" data-testid="mcp-server-activity-target">@(call.TargetId ?? "—")</td>
                <td data-testid="mcp-server-activity-outcome">
                    <Badge Kind="tone" Slug="@OutcomeTone(call.Outcome)">@OutcomeLabel(call.Outcome)</Badge>
                </td>
                <td class="data-table__mono" data-testid="mcp-server-activity-correlation">@call.CorrelationId</td>
            </Row>
        </DataTable>
    </SettingsCard>
</div>

@code {
    /// <summary>The card with the listener's state, its address and its port -
    /// one of the page's <c>SettingsSection.CardTitles</c>.</summary>
    public const string EndpointCardTitle = "MCP endpoint";

    /// <summary>The card with the agents and their grants - the second of the page's
    /// <c>SettingsSection.CardTitles</c>.</summary>
    public const string AgentsCardTitle = "Agents";

    /// <summary>The card with the latest tool calls - the last of the page's
    /// <c>SettingsSection.CardTitles</c>.</summary>
    public const string ActivityCardTitle = "Activity";

    private static readonly string ActivityDescription =
        $"The latest {McpAudit.Shown} tool calls, newest first: who made each one, what it was about and how it ended.";

    private static readonly IReadOnlyList<DataTableColumn> ActivityColumns =
    [
        new("Time"),
        new("Caller"),
        new("Tool"),
        new("Target"),
        new("Outcome"),
        new("Correlation id"),
    ];

    /// <summary>The audit log, or null in a host that composes none.</summary>
    private IMcpAuditLog? _audit;

    /// <summary>The latest records, newest first, as last read.</summary>
    private IReadOnlyList<McpAuditRecord> _activity = [];

    /// <summary>Why the log could not be read, or null.</summary>
    private string? _activityError;

    /// <summary>Bumped per read, so a slow read that lands after a newer one is
    /// dropped rather than drawn over it.</summary>
    private int _activityVersion;

    /// <summary>1 while a write has landed that no read has caught up with yet.</summary>
    private int _activityStale;

    private bool _disposed;

    /// <summary>Where the browser harness serves the endpoint, under its own
    /// origin: the path both hosts share, without its leading slash so it is
    /// resolved under the page's base rather than the server root.</summary>
    private static readonly string HostRelativeEndpoint = BacklogMcpServerRegistration.EndpointPath.TrimStart('/');

    /// <summary>The listener as the page tells it. Starting is the moment between
    /// a bind being asked for and its outcome: no error, not bound yet.</summary>
    private enum ListenerState
    {
        Listening,
        Starting,
        Failed
    }

    /// <summary>The host's MCP server, or null in a host that composes none.</summary>
    private IMcpEndpointSource? _source;

    /// <summary>What the port field holds; the stored port until somebody types.</summary>
    private string _draftPort = string.Empty;

    /// <summary>The stored port as the field last took it, to tell a draft
    /// somebody typed from one the page filled in.</summary>
    private string _shownPort = string.Empty;

    /// <summary>Why the last port typed was refused, or null. The field wears
    /// the error state only while this is set.</summary>
    private string? _portError;

    /// <summary>What the store said about a port it did take - that it moved but
    /// could not be saved for next time - or null.</summary>
    private string? _portNote;

    /// <summary>What the port's status line says when there is nothing else to say.</summary>
    private const string PortHint = "Every registration names this port, so moving it means changing it in each of them too.";

    private string StateLabel => State switch
    {
        ListenerState.Listening => "Listening",
        ListenerState.Starting => "Starting",
        _ => "Not listening",
    };

    private string? StateTone => State switch
    {
        ListenerState.Listening => "setting__status--ok",
        ListenerState.Starting => null,
        _ => "setting__status--error",
    };

    private ListenerState State => _source switch
    {
        null => ListenerState.Listening,
        { IsListening: true } => ListenerState.Listening,
        { Unavailable: not null } => ListenerState.Failed,
        _ => ListenerState.Starting,
    };

    /// <summary>Where a client reaches the server: the bound address while the
    /// listener holds its port, the configured one while it does not - a
    /// registration is written from that whether or not anything is listening -
    /// and the page's own origin in a host with no listener of its own. Both
    /// desktop forms come from <c>BacklogMcpServerRegistration.EndpointUri</c>,
    /// the helper a registration is written with.</summary>
    private Uri Address => _source is null
        ? new Uri(new Uri(Navigation.BaseUri), HostRelativeEndpoint)
        : _source.Endpoint ?? BacklogMcpServerRegistration.EndpointUri(_source.Port);

    /// <summary>The sentence the frame shows over this page: how many agents can reach
    /// Backlog while the listener holds its port, and the listener's state and port while it
    /// does not - then no agent can, and the port is the news.</summary>
    private string Headline => _source is null
        ? "The MCP server answers on this app's own address."
        : State switch
        {
            ListenerState.Listening when _grants is not null && _agentsError is null => McpAgentRequests.Headline(_agents.Count, _waiting.Count),
            ListenerState.Listening => $"The MCP server is listening on port {_source.Port}.",
            ListenerState.Starting => $"The MCP server is starting on port {_source.Port}.",
            _ => $"The MCP server is not listening on port {_source.Port}.",
        };

    protected override async Task OnInitializedAsync()
    {
        _audit = Services.GetService<IMcpAuditLog>();
        if (_audit is not null) _audit.Changed += OnAuditChanged;

        StartSource();
        StartGrants();

        await LoadActivityAsync();
    }

    private void StartSource()
    {
        _source = Services.GetService<IMcpEndpointSource>();
        if (_source is null) return;

        _draftPort = _shownPort = PortText(_source.Port);

        // The listener binds, fails and rebinds on its own, off this thread, and
        // the port may be changed from another window: the page follows both.
        _source.Changed += OnSourceChanged;
    }

    /// <summary>Stores the typed port, or says why not. Committing the same
    /// value twice - Enter, then the change the browser raises on blur - stores
    /// nothing the second time.</summary>
    private void ApplyPort()
    {
        if (_source is null) return;

        _portNote = null;

        if (!int.TryParse(_draftPort.Trim(), System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var port))
        {
            _portError = "Enter a port number.";
            return;
        }

        var said = _source.SetPort(port);

        // The store answers in one sentence for two outcomes. A port it holds
        // afterwards was taken, and the sentence only says it will not survive a
        // restart; any other answer is a refusal and the stored port is unchanged.
        if (said is null || _source.Port == port)
        {
            _portError = null;
            _portNote = said;
            _draftPort = _shownPort = PortText(_source.Port);
        }
        else
        {
            _portError = said;
        }
    }

    private void OnPortKeyDown(KeyboardEventArgs e)
    {
        if (_source is null) return;

        if (e.Key == "Enter") ApplyPort();
        else if (e.Key == "Escape")
        {
            _draftPort = _shownPort = PortText(_source.Port);
            _portError = null;
            _portNote = null;
        }
    }

    /// <summary>Asks the worker to bind the configured port again. Returns at
    /// once: the bind is queued off this thread.</summary>
    private void Retry() => _source?.Retry();

    /// <summary>The grants, or null in a host that composes none - the browser harness.</summary>
    private IMcpGrantStore? _grants;

    /// <summary>Where "last used" is measured from.</summary>
    private TimeProvider _clock = TimeProvider.System;

    /// <summary>The grants not revoked, in the order they were made, as last read.</summary>
    private IReadOnlyList<McpGrant> _agents = [];

    /// <summary>Why the grants could not be read or changed, or null.</summary>
    private string? _agentsError;

    /// <summary>The grant whose switches are open under its row, or null. One at a time.</summary>
    private string? _editing;

    /// <summary>Where Add agent stands.</summary>
    private enum AddStep
    {
        Closed,
        Details,
        Register
    }

    private AddStep _adding;

    /// <summary>What the Add agent form holds until Create agent.</summary>
    private string _newName = string.Empty;

    private string _newRole = McpAgents.Roles[0].Name;

    private List<string> _newScopes = [];

    /// <summary>Why the name typed was refused, or null.</summary>
    private string? _newError;

    /// <summary>The grant the form just made, while its registration is on screen.</summary>
    private McpGrant? _created;

    /// <summary>What the name's status line says when there is nothing else to say.</summary>
    private const string NameHint = "What this agent is listed as here and named as in the activity log.";

    /// <summary>What the registration step says under its buttons: where the helper it
    /// names lives.</summary>
    public const string RegistrationFootnote =
        "The helper path is the one in a Backlog checkout. In another repository, point it at your copy of backlog-mcp-headers.mjs.";

    /// <summary>The sentence a failed read or write of the grants leaves on the card.</summary>
    public const string AgentsUnreadable = "The agents could not be read or changed. Check mcp-grants.json in the app's data folder.";

    private static readonly IReadOnlyList<SelectorOption> RoleOptions =
        [.. McpAgents.Roles.Select(role => new SelectorOption(role.Name, role.Name))];

    /// <summary>Whether this is a Debug build, whose broker answers on a pipe of its own, so a
    /// registration written here must ask the helper for it.</summary>
    private static readonly bool DebugBroker =
        !string.Equals(Backlog.Infrastructure.FileSystem.WorkspaceSettingsStore.DefaultAppDataFolderName, "Backlog", StringComparison.Ordinal);

    /// <summary>The headline while the listener holds its port and this host keeps grants: how
    /// many agents can reach Backlog, which is the list the Agents card draws.</summary>
    public static string AgentsHeadline(int count) => count switch
    {
        0 => "No agent can reach Backlog yet.",
        1 => "1 agent can reach Backlog.",
        _ => $"{count.ToString(System.Globalization.CultureInfo.InvariantCulture)} agents can reach Backlog.",
    };

    /// <summary>Add agent while the form is closed, Close while it is open: the one action of
    /// the card, in its header's corner. Nothing in a host that keeps no grants.</summary>
    private RenderFragment? AgentsAction => _grants is null
        ? null
        : @<AppButton TestId="mcp-agent-add-toggle"
                      aria-expanded="@(_adding != AddStep.Closed ? "true" : "false")"
                      aria-controls="@(_adding == AddStep.Details ? "mcp-agent-add" : null)"
                      OnClick="ToggleAdd">
               @(_adding == AddStep.Closed ? "Add agent" : "Close")
           </AppButton>;

    private void StartGrants()
    {
        _grants = Services.GetService<IMcpGrantStore>();
        if (_grants is null) return;

        _clock = Services.GetService<TimeProvider>() ?? TimeProvider.System;

        // A grant changes from here, and from the broker's own writes - a reseal, and later
        // an agent that registers itself: the card follows both.
        _grants.Changed += OnGrantsChanged;

        // The requests waiting for the person (local ADR 0052 §5), made over the pipe or by
        // request_access off this thread: the waiting card follows them.
        _desk = Services.GetService<McpAccessDesk>();
        if (_desk is not null) _desk.Changed += OnGrantsChanged;

        LoadAgents();
    }

    /// <summary>The access desk, or null in a host that keeps no grants.</summary>
    private McpAccessDesk? _desk;

    /// <summary>The requests waiting for the person, oldest first, as last read.</summary>
    private IReadOnlyList<McpAccessRequest> _waiting = [];

    /// <summary>The scopes switched on per waiting request, until it is answered.</summary>
    private readonly Dictionary<string, List<string>> _requestScopes = new(StringComparer.Ordinal);

    /// <summary>The request whose switches Trim scopes has open, or null.</summary>
    private string? _trimming;

    /// <summary>The request an answer is being made to, while Windows Hello asks.</summary>
    private string? _answering;

    /// <summary>The last answer's sentence, under the request it was about.</summary>
    private RequestMessage? _requestMessage;

    private sealed record RequestMessage(string RequestId, string Text, bool IsError);

    private IReadOnlyList<string> SelectionOf(McpAccessRequest request)
    {
        if (!_requestScopes.TryGetValue(request.Id, out var on))
        {
            on = [.. McpAgentRequests.Initial(request)];
            _requestScopes[request.Id] = on;
        }

        return on;
    }

    private void FlipRequestScope(McpAccessRequest request, AgentScopeChange change)
    {
        var on = SelectionOf(request);
        _requestScopes[request.Id] = change.On
            ? [.. McpAgents.Ordered([.. on, change.Scope])]
            : [.. on.Where(scope => scope != change.Scope)];
    }

    private async Task AllowRequestAsync(McpAccessRequest request)
    {
        if (_desk is null || _answering is not null) return;

        _answering = request.Id;
        try
        {
            var outcome = await _desk.AllowAsync(request.Id, SelectionOf(request));
            _requestMessage = outcome.Refused ? new RequestMessage(request.Id, outcome.Message, true) : null;
            if (!outcome.Refused && _trimming == request.Id) _trimming = null;
        }
        finally
        {
            _answering = null;
            LoadAgents();
        }
    }

    private async Task DeclineRequestAsync(McpAccessRequest request)
    {
        if (_desk is null || _answering is not null) return;

        _answering = request.Id;
        try
        {
            var outcome = await _desk.DeclineAsync(request.Id);
            _requestMessage = outcome.Refused ? new RequestMessage(request.Id, outcome.Message, true) : null;
        }
        finally
        {
            _answering = null;
            LoadAgents();
        }
    }

    private void LoadAgents()
    {
        if (_grants is null) return;

        try
        {
            _waiting = _desk?.Waiting() ?? [];
            foreach (var gone in _requestScopes.Keys.Where(id => _waiting.All(request => request.Id != id)).ToList()) _requestScopes.Remove(gone);
            if (_trimming is not null && _waiting.All(request => request.Id != _trimming)) _trimming = null;

            _agents = McpAgentRequests.Agents(_grants.List(), _waiting);
            _agentsError = null;
            if (_editing is not null && _agents.All(grant => grant.Id != _editing)) _editing = null;
        }
#pragma warning disable CA1031 // The card says the grants could not be read; the rest of the page still works.
        catch (Exception)
#pragma warning restore CA1031
        {
            _agentsError = AgentsUnreadable;
        }
    }

    /// <summary>Runs one write to the grants, saying so on the card when it throws. The store
    /// raises Changed on success, which reloads the list.</summary>
    private T? Write<T>(Func<IMcpGrantStore, T?> write) where T : class
    {
        if (_grants is null) return null;

        try
        {
            var written = write(_grants);
            _agentsError = null;
            LoadAgents();
            return written;
        }
#pragma warning disable CA1031 // A file the person must mend; the card says so and keeps what it drew.
        catch (Exception)
#pragma warning restore CA1031
        {
            _agentsError = AgentsUnreadable;
            return null;
        }
    }

    private string AgentMeta(McpAgentListed listed)
    {
        var grant = listed.Grant;
        DateTimeOffset? used = LastUsed.TryGetValue(grant.Id, out var at) ? at : null;

        if (!grant.IsDelegated) return McpAgents.Meta(grant, used, _clock.GetUtcNow());

        var granter = listed.Granter?.Name ?? _grants?.Find(grant.GrantedBy!)?.Name ?? grant.GrantedBy!;
        return McpAgents.DelegatedMeta(grant, granter, used, _clock.GetUtcNow());
    }

    /// <summary>
    /// Windows Hello before <c>agents:grant</c> is switched on (local ADR 0052 §5 and §6): true
    /// when <paramref name="scopes"/> hold none that asks for it, or the person confirmed it.
    /// Otherwise the card says why, and nothing is written.
    /// </summary>
    private async Task<bool> ConfirmGranterAsync(string name, IEnumerable<string> scopes)
    {
        if (!scopes.Any(scope => McpAgents.NeedsHello.Contains(scope, StringComparer.Ordinal))) return true;

        var consent = Services.GetService<IUserConsent>();
        var outcome = consent is null
            ? UserConsentOutcome.NotAvailable
            : await consent.VerifyAsync(McpAgents.GranterConsent(name));

        if (outcome == UserConsentOutcome.Verified) return true;

        _agentsError = outcome == UserConsentOutcome.NotAvailable ? McpAgents.GranterHelloUnavailable : McpAgents.GranterNotConfirmed;
        return false;
    }

    /// <summary>When each agent last made a call, from the records the Activity card already
    /// holds.</summary>
    private IReadOnlyDictionary<string, DateTimeOffset> LastUsed => McpAgents.LastUsed(_agents, _activity);

    private void ToggleEditing(McpGrant grant) => _editing = _editing == grant.Id ? null : grant.Id;

    /// <summary>Stores one switch at once: the grant takes its new scopes and a new version,
    /// so the agent's next request fetches a token that carries them. Switching agents:grant on
    /// asks for Windows Hello first.</summary>
    private async Task SetScopeAsync(McpGrant grant, AgentScopeChange change)
    {
        if (change.On && !await ConfirmGranterAsync(grant.Name, [change.Scope])) return;

        var current = _agents.FirstOrDefault(agent => agent.Id == grant.Id)?.Scopes ?? grant.Scopes;
        var scopes = change.On
            ? McpAgents.Writable([.. current, change.Scope])
            : McpAgents.Writable(current.Where(scope => scope != change.Scope));

        Write(store => store.SetScopes(grant.Id, scopes));
    }

    private void Revoke(McpGrant grant)
    {
        Write(store => store.Revoke(grant.Id));
        if (_created?.Id == grant.Id) CloseAdd();
    }

    private void ToggleAdd()
    {
        if (_adding == AddStep.Closed)
        {
            _newName = string.Empty;
            _newError = null;
            ApplyRole(McpAgents.Roles[0].Name);
            _created = null;
            _adding = AddStep.Details;
        }
        else
        {
            CloseAdd();
        }
    }

    private void CloseAdd()
    {
        _adding = AddStep.Closed;
        _created = null;
    }

    /// <summary>A role fills the switches with its preset; Custom keeps them as they are.</summary>
    private void ApplyRole(string? role)
    {
        _newRole = role ?? McpAgents.Custom;
        if (McpAgents.PresetOf(_newRole) is { } preset) _newScopes = [.. preset];
    }

    /// <summary>A switch flipped by hand makes the scopes the person's own, so the role reads
    /// Custom from then on.</summary>
    private void ChangeNewScope(AgentScopeChange change)
    {
        _newScopes = change.On
            ? [.. McpAgents.Ordered([.. _newScopes, change.Scope])]
            : [.. _newScopes.Where(scope => scope != change.Scope)];
        _newRole = McpAgents.RoleOf(_newScopes);
    }

    private async Task OnNewNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CreateAgentAsync();
    }

    /// <summary>Makes the grant, then shows what to register. A blank name, or one an agent
    /// already has, is refused beside the field: two rows of one name could not be told apart,
    /// in this list or in the activity log.</summary>
    private async Task CreateAgentAsync()
    {
        var name = _newName.Trim();

        if (name.Length == 0)
        {
            _newError = "Give the agent a name.";
            return;
        }

        if (_agents.Any(agent => string.Equals(agent.Name, name, StringComparison.OrdinalIgnoreCase)))
        {
            _newError = $"An agent is already called {name}.";
            return;
        }

        _newError = null;

        var scopes = McpAgents.Writable(_newScopes);
        if (!await ConfirmGranterAsync(name, scopes)) return;

        if (Write(store => store.Create(name, scopes, McpAgents.CreatedInSettings)) is not { } created) return;

        _created = created;
        _adding = AddStep.Register;
    }

    private string ClaudeCodeRegistration(McpGrant grant) => McpAgents.ClaudeCode(Address, grant.Id, DebugBroker);

    private string CopilotRegistration(McpGrant grant) => McpAgents.Copilot(Address, grant.Id, DebugBroker);

    /// <summary>Raised on whichever thread wrote the grants, so it marshals.</summary>
    private void OnGrantsChanged() => _ = InvokeAsync(() =>
    {
        if (_disposed) return;

        LoadAgents();
        StateHasChanged();
    });

    private static string PortText(int port) => port.ToString(System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>Arrives on whichever thread bound, failed or stored the port, so
    /// it marshals. A port moved elsewhere replaces the field's draft only while
    /// the draft is the port the field last showed: what somebody is halfway
    /// through typing, or a refusal they have still to act on, is theirs.</summary>
    private void OnSourceChanged() => _ = InvokeAsync(() =>
    {
        if (_source is not null && _portError is null && _draftPort == _shownPort) _draftPort = PortText(_source.Port);
        _shownPort = _source is null ? string.Empty : PortText(_source.Port);
        StateHasChanged();
    });

    /// <summary>Reads the latest records. A read that fails says so on the card and
    /// keeps the rows it had.</summary>
    private async Task LoadActivityAsync()
    {
        if (_audit is null) return;

        var version = ++_activityVersion;

        try
        {
            var records = await _audit.LatestAsync(McpAudit.Shown);
            if (version != _activityVersion || _disposed) return;

            _activity = records;
            _activityError = null;
        }
#pragma warning disable CA1031 // The card says the log could not be read; the rest of the page still works.
        catch (Exception)
#pragma warning restore CA1031
        {
            if (version != _activityVersion || _disposed) return;

            _activityError = "The activity log could not be read.";
        }
    }

    /// <summary>Raised on whichever thread wrote the record - the MCP request's - so it
    /// marshals. A burst of calls costs one read, not one per call: a write that
    /// arrives while a refresh is queued or running only marks it to read once more.</summary>
    private void OnAuditChanged()
    {
        if (Interlocked.Exchange(ref _activityStale, 1) == 1) return;

        _ = InvokeAsync(async () =>
        {
            while (!_disposed && Interlocked.Exchange(ref _activityStale, 0) == 1)
            {
                await LoadActivityAsync();
                StateHasChanged();
            }
        });
    }

    /// <summary>The local date and time, to the second, in one fixed form.</summary>
    private static string When(DateTimeOffset at) =>
        at.ToLocalTime().ToString("d MMM HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture);

    private static string OutcomeLabel(McpCallOutcome outcome) => outcome switch
    {
        McpCallOutcome.Succeeded => "Succeeded",
        McpCallOutcome.Refused => "Refused",
        _ => "Failed",
    };

    private static string OutcomeTone(McpCallOutcome outcome) => outcome switch
    {
        McpCallOutcome.Succeeded => "settled",
        McpCallOutcome.Refused => "alert",
        _ => "fault",
    };

    public void Dispose()
    {
        _disposed = true;
        if (_source is not null) _source.Changed -= OnSourceChanged;
        if (_audit is not null) _audit.Changed -= OnAuditChanged;
        if (_grants is not null) _grants.Changed -= OnGrantsChanged;
        if (_desk is not null) _desk.Changed -= OnGrantsChanged;
    }
}
