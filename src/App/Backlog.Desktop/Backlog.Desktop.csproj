<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Backlog.Desktop</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <ApplicationTitle>Backlog</ApplicationTitle>
    <ApplicationId>com.jsdotnet.backlog.desktop</ApplicationId>
    <ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)' == ''">1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <!--
    Release + Windows switches to a packaged MSIX build for sideloading from
    GitHub Releases. WindowsAppSDK 1.7 accepts only None/MSIX/Sparse here — the
    older docs' "Package" value is rejected. Debug stays unpackaged
    (WindowsPackageType=None above) so the Aspire desktop resource and the
    WebView2 CDP attach used by Playwright keep working. The signing certificate
    thumbprint/password are supplied on the command line / by CI — never
    hard-coded here.
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(Configuration)' == 'Release'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The tool service switches over DevToolKind and DevToolProvider without a
         catch-all arm, because the catch-all was the bug it was written to fix:
         the routing it replaced defaulted an unrecognised key to "MCP server" and
         ran it against an entry that was not one. The abstractions project that
         declares those enums sets the same pair, and the switches here are only
         protected if this project agrees.

         CS8509 (a named member no arm covers) is an error: adding a kind or a
                provider without handling it here fails the build.
         CS8524 (the (DevToolKind)4 an int cast can produce, which no exhaustive
                switch can name) is off: it can only arise from a cast of a value
                the catalog format has no way to express. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
    <NoWarn>$(NoWarn);CS8524</NoWarn>
  </PropertyGroup>

  <!--
    Works around WindowsAppSDK issue #3337: the RID must be set through an
    override property. .NET 10 requires portable RIDs (win-x64), NOT win10-x64.
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
    <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- Color is the icon background wherever the platform composites the
         foreground itself rather than using appicon.svg: color-background
         (#121214) from .design/color-scheme.md, matching that file's rect. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#121214" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#121214" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Tasks\Backlog.Modules.Tasks\Backlog.Modules.Tasks.csproj" />
    <!-- Composition is a host's job: picking the storage adapter and calling
         AddRoadmapModule() means seeing both sides of the Roadmap module, which only
         an executable head does. -->
    <ProjectReference Include="..\..\Modules\Roadmap\Backlog.Modules.Roadmap\Backlog.Modules.Roadmap.csproj" />
    <!-- The Dashboard module implementation, for AddDashboardModule(). The host is
         the only thing that sees it: the parts ask through the abstractions project. -->
    <ProjectReference Include="..\..\Modules\Dashboard\Backlog.Modules.Dashboard\Backlog.Modules.Dashboard.csproj" />
    <!-- Dev PC Management's published surface. DevToolService implements its
         IDevToolService port against the Copilot and dotnet CLIs, which is a
         host's job; the port and the catalog format it reads come from here, not
         from the UI project that happens to render the answer. -->
    <ProjectReference Include="..\..\Modules\DevPc\Backlog.Modules.DevPc.Abstractions\Backlog.Modules.DevPc.Abstractions.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Backlog.Infrastructure.AzureFoundry\Backlog.Infrastructure.AzureFoundry.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Backlog.Infrastructure.Claude\Backlog.Infrastructure.Claude.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Backlog.Infrastructure.Copilot\Backlog.Infrastructure.Copilot.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Backlog.Infrastructure.FileSystem\Backlog.Infrastructure.FileSystem.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Backlog.Infrastructure.Sqlite\Backlog.Infrastructure.Sqlite.csproj" />
    <ProjectReference Include="..\..\Aspire\Backlog.Aspire.ServiceDefaults\Backlog.Aspire.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Backlog.Desktop.UI\Backlog.Desktop.UI.csproj" />
  </ItemGroup>

</Project>
