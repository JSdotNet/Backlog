<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    TEST HARNESS — not deployed. See src/Harness/README.md.
    A storybook for Backlog.UI.Components: every shared component rendered on its
    own, with no module, infrastructure or app project in the graph. That missing
    reference is the point — it proves the component library carries no domain,
    and it lets a human or Playwright review the components without starting the
    application. Publishing flags come from src/Harness/Directory.Build.props.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.UI.Storybook</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Aspire\Backlog.Aspire.ServiceDefaults\Backlog.Aspire.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\Core\Backlog.UI.Components\Backlog.UI.Components.csproj" />
  </ItemGroup>

  <!--
    The design guidelines, embedded rather than read off disk.

    Every page here links the `.design` chapters that govern it and renders them
    inline, so the rule a reviewer is checking against is on the same screen as
    the component. Embedding is what makes that work wherever the host runs: a
    relative path out of the project would resolve differently under `dotnet run`,
    under Aspire and from the published output, and the first thing to break would
    be the one thing this block exists to guarantee — that the rule shown is the
    rule in the repository.

    A LogicalName per file, so the reader asks for `design/color-scheme.md` rather
    than for a namespace-mangled resource id.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\.design\*.md" LogicalName="design/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
