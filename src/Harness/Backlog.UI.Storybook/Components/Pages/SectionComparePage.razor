@page "/compare"

<PageTitle>Section comparison — Backlog UI Storybook</PageTitle>

<StoryPage Title="Section comparison"
           Summary="Three components and one question: which change to look at, which file, and what moved in it. The comparison is aligned by heading and never by line — it reads both versions as markdown and reports what happened to each section and each block, which is a different thing from a text diff and is deliberately named so."
           Guidelines="@Rules">

    <Story Name="Which change, and how much of it"
           Description="Two kinds of thing in one list: computed ranges at the top, individual commits under the divider. It is a listbox with a roving tabindex, so the whole pane is one tab stop, and the caption names the commit group in the accessibility tree as well as for the eye.

“Uncommitted — 0 files” is selectable rather than disabled: the count is the answer to the question that was asked."
           Code="@PickerCode">
        <div class="sb-narrow" data-testid="compare-picker">
            <ChangeScopePicker Scopes="CompareFixtures.Scopes"
                               Commits="CompareFixtures.Commits"
                               @bind-SelectedId="_pickerOnlyScope"
                               TestId="story-picker" />
        </div>
    </Story>

    <Story Name="Nothing uncommitted"
           Description="The empty range selected, and both downstream panes saying so with the library's own `EmptyState` in its action-free form. The picker does not grey the row out, and the panes do not go blank."
           Code="@EmptyCode">
        <div class="sb-columns" data-testid="compare-empty">
            <ChangeScopePicker Scopes="CompareFixtures.Scopes"
                               Commits="CompareFixtures.Commits"
                               SelectedId="@CompareFixtures.UncommittedScopeId"
                               TestId="story-empty-picker" />

            <ChangedFileList Files="@([])"
                             EmptyTitle="Nothing uncommitted"
                             EmptyDescription="Every change in this scope is already committed."
                             TestId="story-empty-files" />

            <MarkdownCompareView Section="null"
                                 FileName="No file"
                                 BeforeLabel="Last commit"
                                 AfterLabel="Working tree"
                                 EmptyTitle="Nothing uncommitted"
                                 EmptyDescription="There is nothing in this scope to compare."
                                 MaxHeight="16rem"
                                 TestId="story-empty-compare" />
        </div>
    </Story>

    <Story Name="Aligned by heading, not by line"
           Description="One chapter with all four states in it: a paragraph edited, a section that went, a section that arrived, and — most of the document — blocks that did not move. The folds are opened here so every state is visible at once.

Each state is carried four ways: the gutter glyph, the written label, the surface tint, and what the label makes a screen reader say. The label is real DOM text rather than an `aria-label`, so it cannot drift out of sync with the tint. Unchanged blocks say nothing extra and wear no chrome."
           Code="@CompareCode">
        <SourceContent>
            <div class="sb-stack">
                <CodeView Source="@CompareFixtures.Deploy.Before" Language="markdown"
                          Title="Last commit" CssClass="sb-raw__code" TestId="compare-states-before" />
                <CodeView Source="@CompareFixtures.Deploy.After" Language="markdown"
                          Title="Working tree" CssClass="sb-raw__code" TestId="compare-states-after" />
            </div>
        </SourceContent>
        <ChildContent>
        <div data-testid="compare-states">
            <MarkdownCompareView Section="CompareFixtures.Deploy.Comparison"
                                 FileName="@CompareFixtures.Deploy.File.Name"
                                 Path="@CompareFixtures.Deploy.File.Path"
                                 BeforeLabel="Last commit"
                                 AfterLabel="Working tree"
                                 UnchangedExpanded="true"
                                 MaxHeight="32rem"
                                 TestId="story-compare" />
        </div>
        </ChildContent>
    </Story>

    <Story Name="A heading that was renamed"
           Description="`## Setup` became `## Getting started` and nothing underneath it moved: one changed row, and below it only what really moved.

A heading whose position among its siblings and whose body still line up is read as a changed heading, and the body is aligned block by block underneath it — otherwise every untouched paragraph would be reported twice, once removed and once added. Both texts are shown, Was above Now."
           Code="@RenameCode">
        <div data-testid="compare-rename">
            <MarkdownCompareView Section="CompareFixtures.Session.Comparison"
                                 FileName="@CompareFixtures.Session.File.Name"
                                 Path="@CompareFixtures.Session.File.Path"
                                 BeforeLabel="Last commit"
                                 AfterLabel="Working tree"
                                 MaxHeight="24rem"
                                 TestId="story-rename" />
        </div>
    </Story>

    <Story Name="What is not shown"
           Description="Unchanged runs are collapsed by default, behind a fold labelled with what it hides; a section nobody touched is behind another, labelled with its own heading.

The threshold is on the hidden count rather than the run length, so a fold never replaces one paragraph with one line of chrome, and one block of context is kept beside each neighbour."
           Code="@CollapseCode">
        <div data-testid="compare-collapse">
            <MarkdownCompareView Section="CompareFixtures.Checklist.Comparison"
                                 FileName="@CompareFixtures.Checklist.File.Name"
                                 Path="@CompareFixtures.Checklist.File.Path"
                                 BeforeLabel="f209acf"
                                 AfterLabel="Working tree"
                                 MaxHeight="28rem"
                                 TestId="story-collapse" />
        </div>
    </Story>

    <Story Name="The whole surface"
           Description="The three components composed the way a host builds them: pick a change, pick a file, read what moved. Everything is `Fill`, so the column heights come from the layout.

The picker and the file list are deliberately the same widget — same roles, same roving tabindex, same tick slot, same selected, hover and focus treatment. The glyph column shows its whole vocabulary here: a chapter edited, added, deleted. There is no Renamed, because this feature detects renames of headings and not of paths.

The comparison pane's scroll region is named “{file}, {before} to {after}”, so a keyboard user who lands in it hears which two versions they are reading."
           Code="@SurfaceCode">
        <div class="sb-tall" data-testid="compare-surface">
            <div class="sb-compare-surface">
                <ChangeScopePicker Scopes="CompareFixtures.Scopes"
                                   Commits="CompareFixtures.Commits"
                                   SelectedId="@_scopeId"
                                   SelectedIdChanged="OnScopeChanged"
                                   TestId="surface-picker" />

                <ChangedFileList Files="@Files"
                                 @bind-SelectedPath="_filePath"
                                 TestId="surface-files" />

                @if (Selected is { } selected)
                {
                    <MarkdownCompareView Section="selected.Comparison"
                                         FileName="@selected.File.Name"
                                         Path="@selected.File.Path"
                                         BeforeLabel="@BeforeLabel"
                                         AfterLabel="Working tree"
                                         Fill="true"
                                         TestId="surface-compare" />
                }
                else
                {
                    <MarkdownCompareView Section="null"
                                         FileName="No file"
                                         Fill="true"
                                         TestId="surface-compare" />
                }
            </div>
        </div>
    </Story>

</StoryPage>

@code {
    private static readonly DesignGuideline[] Rules =
    [
        new("content-editing.md#round-trip-fidelity", "Why a comparison is made by heading and not by line."),
        new("color-scheme.md#semantic-soft-surface-tokens", "The tones added, removed and changed are drawn in."),
        new("typography-and-layout.md#density", "How two versions of one section are laid out side by side.")
    ];

    /// <summary>The first story's picker holds its own selection so clicking
    /// through it does not move the composed surface further down the page —
    /// two stories sharing one selection would make the second one change while
    /// the reader is looking at the first.</summary>
    private string? _pickerOnlyScope = CompareFixtures.CommittedScopeId;

    private string? _scopeId = CompareFixtures.LastCommitScopeId;

    private string? _filePath = CompareFixtures.LastCommit[0].File.Path;

    private IReadOnlyList<ChangedFile> Files =>
        [.. CompareFixtures.For(_scopeId).Select(fixture => fixture.File)];

    private CompareFixtures.Fixture? Selected =>
        CompareFixtures.For(_scopeId).FirstOrDefault(fixture => fixture.File.Path == _filePath);

    /// <summary>What the left-hand version is called depends on which range is
    /// selected, which is the host's job and not the component's: the view is
    /// handed two labels and never guesses at them.</summary>
    private string BeforeLabel => _scopeId switch
    {
        CompareFixtures.LastCommitScopeId => "Last commit",
        CompareFixtures.UncommittedScopeId => "Working tree",
        _ => "Committed"
    };

    /// <summary>Changing the range invalidates the file selection: the path that
    /// was chosen may not be in the new list, and a stale selection would leave
    /// the comparison pane showing a file the list beside it no longer offers.</summary>
    private void OnScopeChanged(string? scopeId)
    {
        _scopeId = scopeId;
        _filePath = CompareFixtures.For(scopeId).FirstOrDefault()?.File.Path;
    }

    private const string PickerCode = """
        <ChangeScopePicker Scopes="Scopes"
                           Commits="Commits"
                           @bind-SelectedId="_scopeId" />
        """;

    private const string EmptyCode = """
        <ChangedFileList Files="@([])"
                         EmptyTitle="Nothing uncommitted"
                         EmptyDescription="Every change in this scope is already committed." />
        """;

    private const string CompareCode = """
        <MarkdownCompareView Section="MarkdownCompare.Compare(before, after)"
                             FileName="deploy-foundry.md"
                             BeforeLabel="Last commit"
                             AfterLabel="Working tree"
                             MaxHeight="32rem" />
        """;

    private const string RenameCode = """
        @* Same body, two headings. One changed row, not a wholesale swap. *@
        <MarkdownCompareView Section="MarkdownCompare.Compare(before, after)"
                             FileName="session-configuration.md" />
        """;

    private const string CollapseCode = """
        @* MinimumHiddenBlocks is the threshold on what a fold would hide,
           not on how long the run is. *@
        <MarkdownCompareView Section="comparison"
                             FileName="release-checklist.md"
                             MinimumHiddenBlocks="2" />
        """;

    private const string SurfaceCode = """
        <ChangeScopePicker Scopes="Scopes" Commits="Commits" SelectedIdChanged="OnScopeChanged" />
        <ChangedFileList Files="Files" @bind-SelectedPath="_filePath" />
        <MarkdownCompareView Section="Selected.Comparison"
                             FileName="@Selected.File.Name"
                             BeforeLabel="Last commit"
                             AfterLabel="Working tree"
                             Fill="true" />
        """;
}
