@page "/task-list/in-progress"
@inject IJSRuntime JS

<PageTitle>In progress — Backlog UI Storybook</PageTitle>

<StoryPage Title="In progress"
           Summary="`InProgressBoard`: every task in progress as a card — its status, plan, repository, sub-items, start, due date and effort — with the sessions and pull requests linked to it beside it, in sections. Needs you first, then Moving, and last the live sessions and open pull requests no task links, each with `Link to a task…`. Each linked item carries `Unlink`. The section rules are `InProgressSections`'; the toggles, the links and the focus are the host's."
           Guidelines="@Rules">

    <Story Name="Needs you first"
           Description="With `Needs you first` on, a task whose linked session has gone quiet, or whose linked pull request has a failing check or requested changes, is under **Needs you**; the rest are under **Moving**. Each section keeps the host's order. Off, the tasks are one **In progress** section in the host's order. `Include finished today` adds the tasks done today in a section of their own. The summary counts what is drawn. `Link to a task…` and `Unlink` work here: this page plays the host."
           Code="@BoardCode">
        <InProgressBoard Tasks="@_tasks"
                         Loose="@_loose"
                         NeedsYouFirst="_needsYouFirst"
                         NeedsYouFirstChanged="value => _needsYouFirst = value"
                         IncludeFinishedToday="_includeFinished"
                         IncludeFinishedTodayChanged="value => _includeFinished = value"
                         OnOpenTask="OpenTask"
                         OnOpenSession="OpenSession"
                         OnOpenPullRequest="OpenPullRequest"
                         OnLink="ChooseTask"
                         OnUnlink="Unlink"
                         TestId="in-progress-board-sample" />
        <WorkLinkPicker Open="_linking is not null"
                        OpenChanged="open => { if (!open) _linking = null; }"
                        Title="Link to a task"
                        Options="@IntegrationFixtures.LinkTaskOptions"
                        OnChosen="Link" />
        <p class="sb-state" data-testid="in-progress-last-press">@(_last ?? "Nothing pressed yet.")</p>
        <p class="sb-state" data-testid="in-progress-focus">Focus sent to: @(_focused ?? "(nothing yet)")</p>
    </Story>

    <Story Name="Linking, unlinking and where the focus goes"
           Description="`Link to a task…` on a loose item and `Unlink` beside a linked one are the host's to carry out — the story above plays the host. A link moves the item under the chosen task, and the host puts the focus on that task's card: each card is a focus target named by `InProgressBoard.TaskCardId(id)`, because the control that opened the picker is gone and the focus would otherwise drop to the page. Unlinking a session that is still live, or a pull request still open, puts it back under **Not linked to a task**; a finished session or a merged pull request simply leaves. With no card to take the focus — a task the view does not show — the host focuses `InProgressBoard.TitleId`."
           Code="@LinkCode">
        <p class="sb-state">Try it in the story above: link the loose session to the first task, then unlink it.</p>
    </Story>

    <Story Name="One feature off"
           Description="`ShowSessions` and `ShowPullRequests` follow the host's Sessions and Pull requests features. With one off, its column is not drawn on any card and its count leaves the summary — rather than a column that says `None yet` for a list that is switched off. The switches below play the host."
           Code="@FeatureCode">
        <div class="sb-row">
            <label>
                <input type="checkbox" checked="@_showSessions" @onchange="e => _showSessions = e.Value is true" data-testid="in-progress-show-sessions" />
                Sessions
            </label>
            <label>
                <input type="checkbox" checked="@_showPullRequests" @onchange="e => _showPullRequests = e.Value is true" data-testid="in-progress-show-pull-requests" />
                Pull requests
            </label>
        </div>
        <InProgressBoard Tasks="@IntegrationFixtures.InProgressTasks"
                         ShowSessions="_showSessions"
                         ShowPullRequests="_showPullRequests"
                         TestId="in-progress-board-features" />
    </Story>

    <Story Name="The repository identity edge"
           Description="The edge is the host's, through each task's `Colour`: the desktop app passes the repository's hue while its colours are showing and null while they are hidden. The card never decides. The switch below plays the host."
           Code="@EdgeCode">
        <label class="sb-row">
            <input type="checkbox" checked="@_colours" @onchange="e => _colours = e.Value is true" data-testid="in-progress-colours" />
            Repository colours
        </label>
        <InProgressBoard Tasks="@(_colours ? IntegrationFixtures.InProgressTasks : WithoutColours)"
                         TestId="in-progress-board-edge" />
    </Story>

    <Story Name="Nothing in progress"
           Description="With no task in progress and nothing loose, the view says so and what will show there."
           Code="@EmptyCode">
        <InProgressBoard TestId="in-progress-board-empty" />
    </Story>
</StoryPage>

@code {
    private static readonly DesignGuideline[] Rules =
    [
        new("interaction-guidelines.md#task-rows", "What a task states and what goes quiet — the card states the row's facts."),
        new("color-scheme.md#the-identity-edge", "The 4px repository edge, and that it is never the only thing naming the repository."),
        new("color-scheme.md#integration-roles", "The tone each session and pull request state is drawn in."),
        new("typography-and-layout.md#metadata-lines", "How the start, due date, sub-items and effort are set under a title.")
    ];

    private bool _needsYouFirst = true;
    private bool _includeFinished;
    private bool _colours = true;
    private bool _showSessions = true;
    private bool _showPullRequests;
    private string? _last;
    private string? _focused;
    private string? _focusAfterRender;
    private InProgressLoose? _linking;

    /// <summary>The page's own copy, so a link and an unlink move cards the way the
    /// desktop app's do.</summary>
    private readonly List<InProgressTask> _tasks = [.. IntegrationFixtures.InProgressTasks];

    private readonly List<InProgressLoose> _loose = [.. IntegrationFixtures.InProgressLoose];

    private void OpenTask(InProgressTask task) => _last = $"Opened task {task.Id}.";

    private void OpenSession(WorkSession session) => _last = $"Opened session {session.Id}.";

    private void OpenPullRequest(WorkPullRequest pull) => _last = $"Opened {pull.Key}.";

    private void ChooseTask(InProgressLoose loose) => _linking = loose;

    private void Link(WorkLinkOption option)
    {
        var loose = _linking;
        _linking = null;
        if (loose is null) return;

        var index = _tasks.FindIndex(task => task.Id == option.Id);
        _loose.Remove(loose);
        if (index >= 0)
        {
            var task = _tasks[index];
            _tasks[index] = task with
            {
                Sessions = loose.Session is { } session ? [.. task.Sessions, session] : task.Sessions,
                PullRequests = loose.PullRequest is { } pull ? [.. task.PullRequests, pull] : task.PullRequests
            };
        }

        _last = $"Linked {loose.Key} to {option.Id}.";
        _focusAfterRender = index >= 0 ? InProgressBoard.TaskCardId(option.Id) : InProgressBoard.TitleId;
    }

    private void Unlink(InProgressUnlink unlink)
    {
        var index = _tasks.FindIndex(task => task.Id == unlink.Task.Id);
        if (index < 0) return;

        var task = _tasks[index];
        _tasks[index] = task with
        {
            Sessions = [.. task.Sessions.Where(session => session != unlink.Session)],
            PullRequests = [.. task.PullRequests.Where(pull => pull != unlink.PullRequest)]
        };

        // Still live, it is loose again; finished or merged, it simply leaves.
        if (unlink.Session is { State: not IntegrationSessionState.Finished } session)
        {
            _loose.Add(new InProgressLoose(Session: session, Repository: task.Repository, Colour: task.Colour));
        }

        if (unlink.PullRequest is { State: IntegrationArtifactState.Open or IntegrationArtifactState.Draft } pull)
        {
            _loose.Add(new InProgressLoose(PullRequest: pull, Repository: task.Repository, Colour: task.Colour));
        }

        _last = $"Unlinked {unlink.Session?.Id ?? unlink.PullRequest?.Key} from {task.Id}.";
        _focusAfterRender = InProgressBoard.TaskCardId(task.Id);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusAfterRender is not { } id) return;
        _focusAfterRender = null;
        _focused = id;

        try
        {
            await JS.InvokeVoidAsync("backlogFocus", id);
        }
        catch (JSDisconnectedException)
        {
            return;
        }

        StateHasChanged();
    }

    private static readonly IReadOnlyList<InProgressTask> WithoutColours =
        [.. IntegrationFixtures.InProgressTasks.Select(task => task with { Colour = null })];

    private const string BoardCode = """
        <InProgressBoard Tasks="@tasks"
                         Loose="@loose"
                         NeedsYouFirst="_needsYouFirst"
                         NeedsYouFirstChanged="value => _needsYouFirst = value"
                         IncludeFinishedToday="_includeFinished"
                         IncludeFinishedTodayChanged="value => _includeFinished = value"
                         OnOpenTask="OpenTask"
                         OnOpenSession="OpenSession"
                         OnOpenPullRequest="OpenPullRequest"
                         OnLink="ChooseTask"
                         OnUnlink="UnlinkAsync" />
        """;

    private const string LinkCode = """
        private async Task LinkAsync(WorkLinkOption option)
        {
            if (await LinkWorkAsync(_linking, option) is null)
            {
                _focusAfterRender = tasks.Any(task => task.Id == option.Id)
                    ? InProgressBoard.TaskCardId(option.Id)
                    : InProgressBoard.TitleId;
            }
        }

        protected override async Task OnAfterRenderAsync(bool firstRender)
        {
            if (_focusAfterRender is not { } id) return;
            _focusAfterRender = null;
            await JS.InvokeVoidAsync("backlogFocus", id);
        }
        """;

    private const string FeatureCode = """
        <InProgressBoard Tasks="@tasks"
                         ShowSessions="sessionsOn"
                         ShowPullRequests="pullRequestsOn" />
        """;

    private const string EdgeCode = """
        <InProgressBoard Tasks="@tasks.Select(task => task with { Colour = coloursShowing ? task.Colour : null })" />
        """;

    private const string EmptyCode = """
        <InProgressBoard Tasks="@([])" />
        """;
}
