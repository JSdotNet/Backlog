    private const string CssBody = """
        /* Bare: the host frames the code, names it and scrolls it, so the block gives up its own box entirely. */
        .code-view--bare {
            margin: 0;
            padding: 0;
            border: none;
            background: none;
            max-height: none;
            overflow: visible;
        }

        .file-view__body {
            padding: var(--spacing-sm) var(--spacing-md) var(--spacing-md);
            overflow: auto;
