@page "/file-view"

<PageTitle>File view — Backlog UI Storybook</PageTitle>

<StoryPage Title="File view"
           Summary="FileView shows one file: what it is in the header, what it says in the body, and what you can do to it — copy it, edit it, compare it — beside the name in that same header. The body scrolls on its own so the header never leaves the screen. What the body is read as comes from the file's own name: markdown for prose, coloured and numbered source for everything the highlighter has a grammar for. A markdown file is read whole — each chapter's status where its heading is, each diagram where its fence is, a copy button per chapter, and remarks in the margin — so a host never has to parse the same text a second time to draw those around the outside."
           Guidelines="@Rules">

    <Story Name="The file's name decides how it is read"
           Description="Same component, same parameters, three files. A name the highlighter knows is shown as source: coloured, numbered, and never run through the markdown parser — a `#` in a shell script is a comment, and reading it as a heading is how a file view loses the file. A name it does not know is shown as markdown, which is also what a file of plain prose wants. Nothing here had to be told which was which."
           Code="@KindsCode">
        <div class="sb-stack" data-testid="file-view-kinds">
            <FileView Name="MarkdownPreview.cs"
                      Path="src\Core\Backlog.UI.Components\Markdown\MarkdownPreview.cs"
                      SizeInBytes="1204"
                      Body="@CSharpBody"
                      MaxHeight="14rem"
                      TestId="file-view-csharp" />

            <FileView Name="appsettings.json"
                      Path="src\harness\Backlog.UI.Storybook\appsettings.json"
                      SizeInBytes="286"
                      Body="@JsonBody"
                      MaxHeight="14rem"
                      TestId="file-view-json" />

            <FileView Name="README.md"
                      Path="src\harness\README.md"
                      SizeInBytes="412"
                      Body="@ShortBody"
                      MaxHeight="14rem"
                      TestId="file-view-markdown" />
        </div>
    </Story>

    <Story Name="One scroll region either way"
           Description="A code file keeps the promise the markdown one makes: the header stays put, the body scrolls under it, and there is exactly one thing to tab into. CodeView is given Bare here — without it the block would bring its own frame, its own height cap and its own focusable overflow, and the reader would find two scrollbars and two tab stops where they can see one pane. Long lines wrap, as they do everywhere else in the library, so nothing hides off the right edge of a pane this narrow."
           Code="@BareCode">
        <div class="sb-narrow" data-testid="file-view-code-scroll">
            <FileView Name="components.css"
                      Path="src\Core\Backlog.UI.Components\wwwroot\components.css"
                      Kind="Stylesheet"
                      SizeInBytes="61440"
                      Body="@CssBody"
                      MaxHeight="14rem"
                      TestId="file-view-css" />
        </div>
    </Story>

    <Story Name="When the name cannot say it"
           Description="Language is the override, for the files whose name carries no grammar. A Dockerfile has no extension and a build script's `.txt` says nothing about what is in it — naming the language shows it as code anyway. It works the other way too: `Language=&quot;markdown&quot;` asks for prose back from a file whose extension would have made it code. A language with no grammar here still renders as code in one colour; losing the colour is not a reason to lose the line numbers and reflow the file as prose."
           Code="@LanguageCode">
        <div class="sb-columns" data-testid="file-view-language-override">
            <FileView Name="Dockerfile"
                      Language="bash"
                      SizeInBytes="188"
                      Body="@DockerfileBody"
                      MaxHeight="12rem"
                      TestId="file-view-dockerfile" />

            <FileView Name="lifecycle.mmd"
                      SizeInBytes="240"
                      Body="@MermaidBody"
                      MaxHeight="12rem"
                      TestId="file-view-mermaid" />
        </div>
    </Story>

    <Story Name="A file with more content than fits"
           Description="Fill takes the whole height the host gives it — here a 32rem example area — and scrolls the body under a header that stays put. How tall a file gets is the layout's business, so a pane or a column decides it rather than the component carrying a number. The track is always reserved, so the text does not jump sideways the moment a file grows past the fold. Tab into the body and the arrow keys scroll it: a scroll container is a control whether or not it looks like one, so it takes focus and shows it."
           Code="@LongCode">
        <div class="sb-tall" data-testid="file-view-long">
            <FileView Name="context-loading.instructions.md"
                      Path=".github\instructions\context-loading.instructions.md"
                      Source="GitHub Copilot"
                      Kind="Path-specific instructions"
                      SizeInBytes="5837"
                      Body="@LongBody"
                      Fill="true"
                      TestId="file-view-instructions" />
        </div>
    </Story>

    <Story Name="A file that fits"
           Description="Same component, short file. The body only scrolls when there is something to scroll to, so a small file gets no track and no empty space under it."
           Code="@ShortCode"
           Source="@ShortBody"
           SourceLabel="The file on disk">
        <div data-testid="file-view-short">
            <FileView Name="README.md"
                      Path="src\harness\README.md"
                      Kind="Markdown"
                      SizeInBytes="412"
                      Body="@ShortBody"
                      TestId="file-view-readme" />
        </div>
    </Story>

    <Story Name="Only what is known"
           Description="Every part of the header except the name is optional, and an absent fact is left out rather than filled in. A file with no recorded source, kind or size shows a name and nothing else on that line.">
        <div data-testid="file-view-sparse">
            <FileView Name="scratch.md" Body="@ShortBody" MaxHeight="10rem" />
        </div>
    </Story>

    <Story Name="A path longer than the header"
           Description="The path gives up room first: the name beside it already says which file this is, and the whole path stays in the DOM, so a screen reader reads what the ellipsis hides. Narrow the window and the header stacks instead."
           Code="@LongPathCode">
        <div class="sb-narrow" data-testid="file-view-long-path">
            <FileView Name="0002-backlog-module-owns-the-entry-text-language.md"
                      Path=".arc42\adr\0002-backlog-module-owns-the-entry-text-language.md"
                      Source="Repository"
                      Kind="Architecture decision record"
                      SizeInBytes="2048"
                      Body="@ShortBody"
                      MaxHeight="12rem" />
        </div>
    </Story>

    <Story Name="Checklists are state, not controls"
           Description="Neither shape FileView renders itself writes back to disk, so it passes MarkdownView no toggle handler and the checkboxes render as state. Tab goes from the body straight past them — a checkbox that silently does nothing is worse than no checkbox. That is a claim about the two built-in shapes and not about the component: a host that needs a writable body brings one, which is the story below."
           Source="@ChecklistBody"
           SourceLabel="The file on disk">
        <div data-testid="file-view-checklist">
            <FileView Name="release-checklist.md"
                      Path="docs\release-checklist.md"
                      Kind="Markdown"
                      SizeInBytes="196"
                      Body="@ChecklistBody"
                      MaxHeight="12rem" />
        </div>
    </Story>

    <Story Name="A knowledge chapter, whole"
           Description="Every capability at once, on the file that prompted them: a `.domain` chapter. `RenderKnowledgeMetadata` and `KnowledgeFolder` draw each chapter's `meta` fence as the record it is; `AllowChapterCopy` puts a copy button on every heading; the mermaid fence renders where it was written; `Comments` sit in the margin and fall back to inline when the pane narrows.

`CanEdit` with `@@bind-Editing` swaps the body for the one `EditBodyContent` supplies, and `@@bind-Comparing` with `CompareBaselines` swaps it for two versions aligned by heading. One at a time, and the pane keeps the same header and the same single scroll region through all three."
           Code="@ChapterCode">
        <div class="sb-tall" data-testid="file-view-knowledge">
            <FileView Name="Domain: Backlog Management"
                      Kind="Domain model narrative"
                      Path=".domain/backlog/domain.md"
                      Body="@_domain"
                      Fill="true"
                      TestId="file-view-domain"
                      AllowCopy="true"
                      AllowChapterCopy="true"
                      RenderKnowledgeMetadata="true"
                      KnowledgeFolder="KnowledgeFolder.Domain"
                      OnKnowledgeStatusChanged="OnStatusChanged"
                      Comments="@_remarks"
                      OnAddComment="AddRemark"
                      OnResolveComment="ResolveRemark"
                      OnEditComment="EditRemark"
                      CanEdit="true"
                      @bind-Editing="_editing"
                      @bind-Comparing="_comparing"
                      @bind-CompareBaselineId="_baseline"
                      CompareBaselines="@Baselines">
                <EditBodyContent>
                    <MarkdownEditor Value="@_domain"
                                    ValueChanged="value => _domain = value"
                                    AriaLabel="Chapter source"
                                    Rows="16"
                                    TestId="file-view-domain-editor" />
                </EditBodyContent>
            </FileView>
        </div>
    </Story>

    <Story Name="Compared against two versions of itself"
           Description="`MarkdownCompareView` is handed the result `Bare`, so it gives up its own card, header and scroll region — this pane already has all three.

What a baseline *is* stays the host's: this page holds two strings, and the domain panel holds one and asks git for the other. A baseline with nothing to offer says so — press Compare, then pick “Never committed”."
           Code="@CompareCode">
        <div class="sb-tall" data-testid="file-view-compare">
            <FileView Name="context-map.md"
                      Kind="Domain context map"
                      Path=".domain/context-map.md"
                      Body="@ContextMapAfter"
                      Fill="true"
                      TestId="file-view-compare-example"
                      Comparing="true"
                      CompareBaselines="@CompareExamples"
                      @bind-CompareBaselineId="_exampleBaseline" />
        </div>
    </Story>

    <Story Name="A body the host brings itself"
           Description="`BodyContent` hands the body in, so a host that needs a writable one keeps everything that comes with writing while the frame, the identity, the path and the one scroll region stay here. Type in it and watch the size in the header move: what the file now says is the host's to report.

Tab through this one and then the story above it. A supplied body gives up the region's `tabindex`, because the editor inside is a tab stop already; the built-in shapes keep it, because they render nothing focusable."
           Code="@HostedBodyCode">
        <div class="sb-tall" data-testid="file-view-hosted-body">
            <FileView Name="05-building-block-view.md"
                      Path=".arc42\05-building-block-view.md"
                      Source="Repository"
                      Kind="arc42 chapter"
                      SizeInBytes="@ChapterSize"
                      Fill="true"
                      TestId="file-view-hosted">
                <BodyContent>
                    <MarkdownEditor Value="@_chapter"
                                    ValueChanged="value => _chapter = value"
                                    AriaLabel="Chapter source"
                                    Rows="12"
                                    TestId="file-view-hosted-editor" />
                </BodyContent>
            </FileView>
        </div>
    </Story>
    <Story Name="What the file says it is for"
           Description="`ShowFrontmatter` reads the YAML block a markdown file may open with and draws it as its own strip under the header: the description as prose, `applyTo` as one badge per glob, `tools` as badges of their own. The body is then given the text *without* the block — left in, those same four lines come back underneath as the divider and run-together paragraph the markdown parser makes of them, which is the noise this replaces.

Every other key the block states is a row too — the key as its label, its words beside it, in the order the file wrote them. That is the rule the strip keeps: it never hides what it does not show, so `mode` on the prompt below is a row rather than a line quietly taken out of the file with the rest of the block.

Its own strip and not another row in the header: the header identifies the file, and this is the file describing itself. A host that renders its own body names `FrontmatterSource` instead, so the strip is drawn from the file's text while the buffer that host writes back stays whole. A file with no frontmatter, or one nobody asked about, renders exactly as it did before any of this — no strip, and no empty row where it would have been."
           Code="@FrontmatterCode">
        <div class="sb-stack" data-testid="file-view-frontmatter">
            <FileView Name="ui-components.instructions.md"
                      Source="GitHub Copilot"
                      Kind="Path-specific instructions"
                      Path=".github\instructions\ui-components.instructions.md"
                      Body="@InstructionFile"
                      ShowFrontmatter="true"
                      MaxHeight="12rem"
                      TestId="file-view-instructions" />

            <FileView Name="explain-flow.prompt.md"
                      Source="GitHub Copilot"
                      Kind="Prompt file"
                      Path=".github\prompts\explain-flow.prompt.md"
                      Body="@PromptFile"
                      ShowFrontmatter="true"
                      MaxHeight="12rem"
                      TestId="file-view-prompt" />
        </div>
    </Story>

</StoryPage>

@code {
    private static readonly DesignGuideline[] Rules =
    [
        new("content-editing.md#raw-markdown-escape-hatch", "When a file is shown as source rather than as a rendering."),
        new("color-scheme.md#syntax-highlighting-tokens", "The colours a file read as code is drawn with."),
        new("design-principles.md#low-chrome-content-first", "How much of a file view may be header and actions."),
        new("typography-and-layout.md#layout-grid-and-breakpoints", "The measure a file's contents are read at.")
    ];

    // The one piece of state on this page: the hosted-body story is only worth
    // looking at if it can actually be typed in.
    private string _chapter = ChapterSource;

    // The knowledge story's state. Editing and comparing are the component's
    // modes; the rest is what a host owns — the text, the remarks, and which
    // version is being compared against.
    private string _domain = DomainChapter;
    private bool _editing;
    private bool _comparing;
    private string _baseline = "opened";
    private string _exampleBaseline = "commit";
    private int _nextRemark = 3;

    private IReadOnlyList<MarkdownComment> _remarks =
    [
        new("r1", 2, "Is \"triaged\" the word we settled on, or is it still \"refined\"?", "Reviewer", "yesterday"),
        new("r2", 6, "This invariant is the one the writer enforces — worth naming it here.", "You", "2 hours ago", Resolved: true)
    ];

    /// <summary>Two versions to compare the chapter against. "As opened" is the
    /// text this page loaded with, which is what "what have I changed" means on a
    /// surface that auto-saves; the committed one is a fixture, because a
    /// storybook has no repository behind it.</summary>
    private IReadOnlyList<FileCompareBaseline> Baselines =>
    [
        new("opened", "As opened", DomainChapter),
        new("committed", "Last commit", CommittedDomainChapter)
    ];

    private IReadOnlyList<FileCompareBaseline> CompareExamples =>
    [
        new("commit", "Last commit", ContextMapBefore),
        new("empty", "Never committed", null, "This chapter has not been committed yet, so there is no earlier version of it to compare with.")
    ];

    /// <summary>A status change reports the block it came from and the chapter
    /// title, which is what lets a host find the file's own heading again. Written
    /// into the text here so the story keeps telling the truth about itself.</summary>
    private void OnStatusChanged(KnowledgeStatusChange change) =>
        _domain = _domain.Replace($"status: {StatusOf(change.Heading)}", $"status: {change.Status}", StringComparison.Ordinal);

    /// <summary>What the fence under a heading currently says, so the replacement
    /// above rewrites that chapter's line and not the first one in the file.</summary>
    private string StatusOf(string? heading)
    {
        var lines = _domain.Replace("\r\n", "\n").Split('\n');
        var start = Array.FindIndex(lines, line => heading is not null && line.TrimStart('#', ' ') == heading);
        if (start < 0) return "draft";

        var status = lines.Skip(start + 1).Take(4).FirstOrDefault(line => line.TrimStart().StartsWith("status:", StringComparison.Ordinal));
        return status?.Split(':', 2)[1].Trim() ?? "draft";
    }

    private void AddRemark(int blockIndex) =>
        _remarks = [.. _remarks, new MarkdownComment($"r{_nextRemark++}", blockIndex, "A new remark. Edit it to say what it is.", "You", "just now")];

    private void ResolveRemark(string id) =>
        _remarks = [.. _remarks.Select(remark => remark.Id == id ? remark with { Resolved = !remark.Resolved } : remark)];

    private void EditRemark(MarkdownComment edited) =>
        _remarks = [.. _remarks.Select(remark => remark.Id == edited.Id ? edited : remark)];

    // Read off the text rather than written down, so the header keeps telling the
    // truth while the story is being edited. A host that owns the body owns
    // saying what the file is now.
    private long ChapterSize => System.Text.Encoding.UTF8.GetByteCount(_chapter);

    private const string CSharpBody = """
        namespace Backlog.UI.Components.Markdown;

        /// <summary>The parser the read view and the file view share.</summary>
        public static class MarkdownPreview
        {
            // A `#` here is a comment, and a `*` is a dereference nobody wrote.
            // Both are why a source file is never handed to the markdown parser.
            public static IReadOnlyList<MdBlock> ParseDocument(string? body)
            {
                if (string.IsNullOrEmpty(body)) return [];

                var lines = body.Replace("\r\n", "\n").Split('\n');

                return Read(lines, headingsAreHeadings: true);
            }
        }
        """;

