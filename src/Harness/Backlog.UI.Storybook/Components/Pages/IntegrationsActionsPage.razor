@page "/integrations/actions"

<PageTitle>Integration actions — Backlog UI Storybook</PageTitle>

<StoryPage Title="Actions"
           Summary="The six acts the product performs on an external tool, each an `IntegrationActionSpec` — an id, a label, a provider, a prominence and a readiness. A surface adds an act by adding a record to a list, never by writing markup. Which acts wear a provider mark, and why, is the rule linked above."
           Guidelines="@Rules">

    <Story Name="The six acts"
           Description="All six at `IntegrationDensity.Toolbar`, which is where they all fit. Each is an `IntegrationActionSpec`: an id, a label, a provider, a prominence and a readiness, and nothing else.

Press any of them and the line underneath reports which spec arrived. These are the same specs every other page in this section renders."
           Code="@SixCode">
        <div class="sb-stack" data-testid="actions-six">
            <IntegrationActionBar Actions="@IntegrationFixtures.ActsWithCopy"
                                  Density="IntegrationDensity.Toolbar"
                                  VisibleLimit="7"
                                  AriaLabel="Integrations"
                                  OnInvoke="Record"
                                  TestId="actions-six-bar"
                                  ActionTestIdPrefix="actions-six" />
            <p class="sb-state" data-testid="actions-six-echo">@_echo</p>
        </div>
    </Story>

    <Story Name="Copy is the one that is not an IntegrationAction"
           Description="A spec with `CopyText` set is rendered by `CopyButton` instead, so the clipboard interop, the status line and the three-second clear come from the component that already has them.

Two consequences follow, and both are visible below. A copy never collapses into the overflow menu, because a `MenuItem` has no interop and would claim to copy without copying; and a copy stays enabled when the cluster around it is not, because the clipboard is local."
           Code="@CopyCode">
        <div class="sb-stack" data-testid="actions-copy">
            <div class="sb-stack">
                <p class="sb-label">Ready — a copy beside an act</p>
                <IntegrationActionBar Actions="@CopyAndCreate"
                                      Density="IntegrationDensity.Toolbar"
                                      AriaLabel="Integrations"
                                      OnInvoke="Record"
                                      TestId="actions-copy-bar"
                                      ActionTestIdPrefix="actions-copy" />
            </div>
            <div class="sb-stack">
                <p class="sb-label">Cluster not ready — the copy is untouched</p>
                <IntegrationActionBar Actions="@CopyAndCreate"
                                      Density="IntegrationDensity.Toolbar"
                                      Readiness="@IntegrationFixtures.TokenExpired"
                                      AriaLabel="Integrations"
                                      OnInvoke="Record"
                                      OnRemedy="RecordRemedy"
                                      TestId="actions-copy-blocked-bar"
                                      ActionTestIdPrefix="actions-copy-blocked" />
                <p class="sb-state">
                    The copy renders as button[data-testid="actions-copy-blocked-copy-prompt"] and is enabled.
                    The act beside it is disabled with the cluster's reason.
                </p>
            </div>
        </div>
    </Story>

    <Story Name="Marks are drawn, not fetched"
           Description="`ProviderMark` draws four hand-authored paths in a sixteen-unit viewBox, filled with `currentColor`. Nothing is fetched, so a mark renders in a WebView with no egress, and one path serves every context: the same GitHub mark is live ink on an open issue and dimmed on a closed one.

Marks are filled and state icons are stroked — see the rule linked above for why that separation is load-bearing."
           Code="@MarksCode">
        <div class="sb-stack" data-testid="actions-marks">
            @foreach (var size in MarkSizes)
            {
                <div class="sb-stack">
                    <p class="sb-label">@size px</p>
                    <div class="sb-row">
                        @foreach (var provider in Providers)
                        {
                            <ProviderMark Provider="@provider"
                                          Size="@size"
                                          Title="@ProviderTitles[provider]"
                                          TestId="@($"actions-mark-{provider.ToString().ToLowerInvariant()}-{size}")" />
                        }
                        <ProviderMark Provider="IntegrationProvider.None"
                                      Size="@size"
                                      TestId="@($"actions-mark-none-{size}")" />
                        <span class="sb-state">None draws nothing — no element, no gap.</span>
                    </div>
                </div>
            }

            <div class="sb-stack">
                <p class="sb-label">One path, three inherited inks</p>
                @foreach (var ink in Inks)
                {
                    <div class="sb-row" style="@($"color: {ink.Token};")">
                        @foreach (var provider in Providers)
                        {
                            <ProviderMark Provider="@provider" Size="20" Title="@ProviderTitles[provider]" />
                        }
                        <span class="sb-state">@ink.Name</span>
                    </div>
                }
            </div>

            <div class="sb-stack">
                <p class="sb-label">Filled marks beside stroked states, for contrast</p>
                <div class="sb-row">
                    <ProviderMark Provider="IntegrationProvider.GitHub" Size="20" Title="GitHub" />
                    <IntegrationStateChip Artifact="IntegrationArtifactState.Open"
                                          Kind="IntegrationLinkKind.Issue"
                                          TestId="actions-marks-chip-open" />
                    <IntegrationStateChip Artifact="IntegrationArtifactState.Merged"
                                          Kind="IntegrationLinkKind.PullRequest"
                                          TestId="actions-marks-chip-merged" />
                    <IntegrationStateChip Session="IntegrationSessionState.Running"
                                          TestId="actions-marks-chip-running" />
                </div>
            </div>
        </div>
    </Story>

    <Story Name="The mark means it left the application"
           Description="Five acts, all about AI, and only two carry a `Provider`. Ask AI, Resolve comments with AI and Rewrite part with AI are features of this application, so they name no vendor; Send to Claude in Desktop and Send to Copilot in Desktop hand a section to an agent session elsewhere, so the mark is what says where it went.

The rule that decides which is which is linked above; what a page does with it is set `Provider` or leave it null."
           Code="@BoundaryCode">
        <div class="sb-stack" data-testid="actions-boundary">
            <div class="sb-stack">
                <p class="sb-label">Inside, then outside — the marks fall on the second half and nowhere else</p>
                <IntegrationActionBar Actions="@IntegrationFixtures.InAppAiAndHandOffs"
                                      Density="IntegrationDensity.Toolbar"
                                      VisibleLimit="5"
                                      AriaLabel="Integrations"
                                      OnInvoke="Record"
                                      TestId="actions-boundary-bar"
                                      ActionTestIdPrefix="actions-boundary" />
                <p class="sb-state">
                    Three acts that render no svg at all, then two that do. Nothing about the first three names a vendor,
                    on the button or on the card they produce.
                </p>
            </div>
            <div class="sb-stack">
                <p class="sb-label">Compact — the labels are gone and the mark is the only difference left</p>
                <IntegrationActionBar Actions="@IntegrationFixtures.HandOffs"
                                      Density="IntegrationDensity.Compact"
                                      VisibleLimit="2"
                                      AriaLabel="Hand-offs"
                                      OnInvoke="Record"
                                      TestId="actions-boundary-compact"
                                      ActionTestIdPrefix="actions-boundary-compact" />
            </div>
            <div class="sb-stack">
                <p class="sb-label">What a hand-off comes back as — the other half of the same crossing</p>
                <IntegrationLink Link="@IntegrationFixtures.DesktopClaudeSession"
                                 OnOpen="Open"
                                 TestId="actions-boundary-claude-session" />
                <IntegrationLink Link="@IntegrationFixtures.DesktopCopilotSession"
                                 OnOpen="Open"
                                 TestId="actions-boundary-copilot-session" />
                <p class="sb-state">
                    Marked for the reason the act was: a reader has to know which session, in which tool, to go back to.
                    References carries their states and what happens when there are eleven of them.
                </p>
            </div>
            <p class="sb-state" data-testid="actions-boundary-echo">@_echo</p>
        </div>
    </Story>

    <Story Name="Ask AI is Primary, which is what makes it everywhere"
           Description="`IntegrationActionProminence.Primary` pins an act visible at every density. Ask AI is Primary, so a surface that mounts a bar has it, without each surface deciding.

Menu density is the case worth watching: the budget is zero, so every Standard act is behind the trigger, and what still renders outside it is the Primary act and the copy."
           Code="@PrimaryCode">
        <div class="sb-stack" data-testid="actions-primary">
            @foreach (var density in Densities)
            {
                <div class="sb-stack">
                    <p class="sb-label">@density — budget @Budgets[density]</p>
                    <IntegrationActionBar Actions="@IntegrationFixtures.ActsWithCopy"
                                          Density="@density"
                                          AriaLabel="Integrations"
                                          OnInvoke="Record"
                                          TestId="@($"actions-primary-{density.ToString().ToLowerInvariant()}")"
                                          OverflowTestId="@($"actions-primary-{density.ToString().ToLowerInvariant()}-overflow")"
                                          MenuTestId="@($"actions-primary-{density.ToString().ToLowerInvariant()}-menu")"
                                          ActionTestIdPrefix="@($"actions-primary-{density.ToString().ToLowerInvariant()}")" />
                    <p class="sb-state">@PinnedNote(density)</p>
                </div>
            }
        </div>
    </Story>

    <Story Name="An act that is running stays where it was"
           Description="Collapse is recomputed on every render, so a running act is exempt from the budget — otherwise a spinner could be pushed into a closed menu while the reader watched.

The bar below is at Compact density, whose budget is two, with a third act running. Press Start the hand-off to watch it: the same list, the same budget, one state change, and a row that grows by one."
           Code="@RunningCode">
        <div class="sb-stack" data-testid="actions-running">
            <IntegrationActionBar Actions="@_compactActs"
                                  Density="IntegrationDensity.Compact"
                                  AriaLabel="Integrations"
                                  OnInvoke="Record"
                                  TestId="actions-running-bar"
                                  OverflowTestId="actions-running-overflow"
                                  MenuTestId="actions-running-menu"
                                  ActionTestIdPrefix="actions-running" />
            <div class="sb-row">
                <AppButton Variant="ButtonVariant.Ghost"
                           Size="ButtonSize.Small"
                           TestId="actions-running-start"
                           OnClick="StartHandOff">Start the hand-off</AppButton>
                <AppButton Variant="ButtonVariant.Ghost"
                           Size="ButtonSize.Small"
                           TestId="actions-running-stop"
                           OnClick="StopHandOff">Finish it</AppButton>
            </div>
            <p class="sb-state" data-testid="actions-running-state">@RunningNote</p>
        </div>
    </Story>

    <Story Name="Logging a hand-off — not yet"
           Description="Nothing in this family raises the domain's Usage Event. `IntegrationActionSpec.Id` is the hook when it is built — it is already the stable identifier a host would log against — and the acts that would produce one are listed below with those ids.

The addition is a callback on the bar rather than a change to any component here."
           Code="@LoggingCode">
        <dl class="sb-grid" data-testid="actions-logging">
            @foreach (var act in Loggable)
            {
                <div class="sb-stack">
                    <dt class="sb-label">@act.Label</dt>
                    <dd class="sb-stack">
                        <CodeView Source="@($"Id = \"{act.Id}\"")" Language="csharp" AllowCopy="false" CssClass="sb-raw__code"
                                  TestId="@($"actions-logging-{act.Id}")" />
                        <p class="sb-state">The join a Usage Event would carry as its subject.</p>
                    </dd>
                </div>
            }
        </dl>
    </Story>

</StoryPage>

@code {
    private static readonly DesignGuideline[] Rules =
    [
        new("color-scheme.md#integration-roles", "Which acts wear a provider mark, and in what tone."),
        new("typography-and-layout.md#iconography", "What a provider mark may be, and how big."),
        new("design-principles.md#ai-first-surfaces", "Why asking AI is a primary act."),
        new("interaction-guidelines.md#feedback-and-toasts", "What an act reports when it finishes.")
    ];

    private sealed record Ink(string Name, string Token);

    private static readonly IReadOnlyList<int> MarkSizes = [16, 20, 24];

    private static readonly IReadOnlyList<IntegrationProvider> Providers =
    [
        IntegrationProvider.GitHub,
        IntegrationProvider.Copilot,
        IntegrationProvider.Claude,
        IntegrationProvider.VsCode
    ];

    /// <summary>The provider's own name, spelled the way the provider spells it —
    /// it becomes the mark's accessible name, and an abbreviation here would be an
    /// abbreviation read aloud.</summary>
    private static readonly IReadOnlyDictionary<IntegrationProvider, string> ProviderTitles =
        new Dictionary<IntegrationProvider, string>
        {
            [IntegrationProvider.GitHub] = "GitHub",
            [IntegrationProvider.Copilot] = "GitHub Copilot",
            [IntegrationProvider.Claude] = "Claude",
            [IntegrationProvider.VsCode] = "VS Code"
        };

    /// <summary>Three inks a mark actually inherits in this product: the ordinary
    /// one, the live one a current state uses, and the one an unavailable act
    /// carries.</summary>
    private static readonly IReadOnlyList<Ink> Inks =
    [
        new("Ordinary text ink", "var(--color-text-primary)"),
        new("A live state", "var(--color-primary-light)"),
        new("An unavailable act", "var(--color-text-disabled)")
    ];

    private static readonly IReadOnlyList<IntegrationDensity> Densities =
    [
        IntegrationDensity.Toolbar,
        IntegrationDensity.Inline,
        IntegrationDensity.Compact,
        IntegrationDensity.Menu
    ];

    /// <summary>The density budgets, restated here rather than read out of the
    /// library: the mapper that holds them is internal, so the storybook says the
    /// numbers out loud and the bars beside them are the proof.</summary>
    private static readonly IReadOnlyDictionary<IntegrationDensity, int> Budgets =
        new Dictionary<IntegrationDensity, int>
        {
            [IntegrationDensity.Toolbar] = 4,
            [IntegrationDensity.Inline] = 3,
            [IntegrationDensity.Compact] = 2,
            [IntegrationDensity.Menu] = 0
        };

    private static readonly IReadOnlyList<IntegrationActionSpec> CopyAndCreate =
    [
        IntegrationFixtures.CopyPrompt,
        IntegrationFixtures.CreateIssue
    ];

    /// <summary>The acts that would raise a Usage Event the day one exists, and
    /// they are exactly the ones that leave: the prompt going to the clipboard,
    /// the prompt going to a local agent, and a section going to a session in
    /// another repository. Not one in-app AI act is on the list, which is the
    /// mark rule arriving from a second direction — what is worth auditing is a
    /// crossing.</summary>
    private static readonly IReadOnlyList<IntegrationActionSpec> Loggable =
    [
        IntegrationFixtures.CopyPrompt,
        IntegrationFixtures.RunInCopilot,
        IntegrationFixtures.SendToClaude,
        IntegrationFixtures.SendToCopilot
    ];

    private IReadOnlyList<IntegrationActionSpec> _compactActs = IntegrationFixtures.ActsWithOneRunning;

    private string _echo = "Nothing pressed yet.";

    private void Record(IntegrationActionSpec spec) =>
        _echo = $"OnInvoke raised for {spec.Id} — {spec.Label}.";

    private void Open(IntegrationLinkRef link) =>
        _echo = $"OnOpen raised for {link.Id} — the session a hand-off started, not an act.";

    private void RecordRemedy(IntegrationReadiness readiness) =>
        _echo = $"OnRemedy raised: {readiness.Availability}, {readiness.Subject ?? "no subject"}.";

    private void StartHandOff() =>
        _compactActs = IntegrationFixtures.ActsWithOneRunning;

    private void StopHandOff() =>
        _compactActs =
        [
            .. IntegrationFixtures.ActsWithOneRunning.Select(spec =>
                spec.State is IntegrationActionState.Running
                    ? spec with { State = IntegrationActionState.Idle }
                    : spec)
        ];

    private bool AnyRunning =>
        _compactActs.Any(spec => spec.State is IntegrationActionState.Running);

    private string RunningNote => AnyRunning
        ? "Three acts visible against a budget of two: the Primary, the one the budget paid for, and the one in flight."
        : "Nothing is running, so the budget applies unchanged and the third act is behind the trigger.";

    /// <summary>What is outside the trigger at this density and why. Menu is the
    /// one worth spelling out, because zero budget and two visible acts looks like
    /// a contradiction until the two pinning rules are named.</summary>
    private static string PinnedNote(IntegrationDensity density) => density switch
    {
        IntegrationDensity.Menu =>
            "Budget zero, and two acts still outside the trigger: Ask AI because Primary is pinned unconditionally, "
            + "the copy because a MenuItem has no clipboard interop to carry.",
        IntegrationDensity.Compact =>
            "Icon only. Ask AI is still first, and every button keeps its label on the accessible name.",
        _ => "Ask AI is pinned and costs one of the budget. The rest fill what is left, in order."
    };

    // --- Code samples ------------------------------------------------------

    private const string SixCode = """
        @* A surface adds an integration by adding a record, not by adding markup. *@
        <IntegrationActionBar Actions="@acts" Density="IntegrationDensity.Toolbar" OnInvoke="Invoke" />

        private static readonly IReadOnlyList<IntegrationActionSpec> Acts =
        [
            new("ask-ai", "Ask AI",
                Prominence: IntegrationProminence.Primary),
            new("create-issue", "Create GitHub issue", IntegrationProvider.GitHub,
                ConfirmLabel: "Create the issue"),
            new("open-vscode", "Open in VS Code", IntegrationProvider.VsCode),
            new("run-copilot", "Run in Copilot CLI", IntegrationProvider.Copilot),
            new("resolve-comments", "Resolve comments with AI"),
            new("rewrite", "Rewrite part with AI")
        ];
        """;

    private const string CopyCode = """
        @* CopyText set is the whole switch. The bar renders it with CopyButton,
           which already owns the interop, the status line and the three-second
           clear — and which stays enabled when the cluster around it does not,
           because the clipboard is local. *@
        new IntegrationActionSpec("copy-prompt", "Copy prompt", CopyText: prompt)
        """;

    private const string MarksCode = """
        @* Hand-authored, filled with currentColor, sized in pixels rather than in
           ems so the mark scales with the row instead of with the font. *@
        <ProviderMark Provider="IntegrationProvider.Copilot" Size="20" Title="GitHub Copilot" />

        @* No Title: aria-hidden and focusable="false", because a mark beside a
           text label would otherwise be read out twice. *@
        <ProviderMark Provider="IntegrationProvider.GitHub" />
        """;

    private const string PrimaryCode = """
        @* Everywhere is a property of the rule, not of the component. Primary is
           pinned at every density, so a surface that mounts a bar has Ask AI. *@
        new IntegrationActionSpec("ask-ai", "Ask AI",
            Prominence: IntegrationProminence.Primary)
        """;

    private const string BoundaryCode = """
        @* One field apart, and the field is the whole rule. The product's own AI
           names no provider, because nothing crossed out. *@
        new IntegrationActionSpec("ask-ai", "Ask AI", Prominence: IntegrationProminence.Primary)
        new IntegrationActionSpec("resolve-comments", "Resolve comments with AI")
        new IntegrationActionSpec("rewrite", "Rewrite part with AI")

        @* The hand-offs name theirs, because which tool it went to is the point. *@
        new IntegrationActionSpec("send-claude", "Send to Claude in Desktop",
            IntegrationProvider.Claude, ConfirmLabel: "Send it")
        new IntegrationActionSpec("send-copilot", "Send to Copilot in Desktop",
            IntegrationProvider.Copilot, ConfirmLabel: "Send it")

        @* And what comes back wears the same mark: an act that left and a
           reference to track are two halves of one crossing. *@
        IntegrationLinkRef.Session("session-7e12", "session 7e12",
            IntegrationProvider.Claude, IntegrationSessionState.Running, repository: desktop)
        """;

    private const string RunningCode = """
        @* One state change, no other parameter touched. The act is held visible
           past the budget for as long as it is in flight. *@
        _acts = [.. _acts.Select(spec => spec.Id == "run-copilot"
            ? spec with { State = IntegrationActionState.Running }
            : spec)];
        """;

    private const string LoggingCode = """
        @* Not built. The shape when it is: one callback on the bar, carrying the
           spec whose Id is already the stable join. *@
        // [Parameter] public EventCallback<IntegrationActionSpec> OnActed { get; set; }
        //
        // usage_event: { subject: spec.Id, action: "copy" | "handoff", timestamp: … }
        """;
}
