@page "/integrations/density"

<PageTitle>Density and overflow — Backlog UI Storybook</PageTitle>

<StoryPage Title="Density and overflow"
           Summary="The same act set as a header toolbar, an inline row, an icon-only cluster and a set of menu items. `IntegrationDensity` is the one parameter that changes; nothing about an action does. The budget each density carries, and what escapes it, is the rule linked above."
           Guidelines="@Rules">

    <Story Name="Four densities, one action set"
           Description="One `IntegrationActionSpec` list, four values of `IntegrationDensity`. A surface picks a density as a fact about the space it has.

Density selects a button shape, a size and a visible budget together, as one enum rather than three parameters. Read the four rows below as one transformation: nothing is added, renamed or reordered between them."
           Code="@DensitiesCode">
        <div class="sb-stack" data-testid="density-four">
            @foreach (var density in Densities)
            {
                <div class="sb-stack">
                    <p class="sb-label">@density</p>
                    <IntegrationActionBar Actions="@IntegrationFixtures.Acts"
                                          Density="@density"
                                          AriaLabel="Integrations"
                                          OnInvoke="Record"
                                          TestId="@($"density-four-{Slug(density)}")"
                                          OverflowTestId="@($"density-four-{Slug(density)}-overflow")"
                                          MenuTestId="@($"density-four-{Slug(density)}-menu")"
                                          ActionTestIdPrefix="@($"density-four-{Slug(density)}")" />
                </div>
            }
            <p class="sb-state" data-testid="density-four-echo">@_echo</p>
        </div>
    </Story>

    <Story Name="The budget, and what is pinned"
           Description="Each density carries a visible budget — four, three, two, none — and the rest collapse behind a trigger. Two things sit outside it: a `Primary` act is pinned and still counts, so Ask AI displaces a Standard act rather than adding one; a copy is pinned and does not count.

An act marked `Overflow` goes the other way and is removed unconditionally. The numbers and the reasoning behind them are in the rule linked above."
           Code="@BudgetCode">
        <div class="sb-stack" data-testid="density-budget">
            <IntegrationActionBar Actions="@BudgetActs"
                                  Density="IntegrationDensity.Toolbar"
                                  AriaLabel="Integrations"
                                  OnInvoke="Record"
                                  TestId="density-budget-bar"
                                  OverflowTestId="density-budget-overflow"
                                  MenuTestId="density-budget-menu"
                                  ActionTestIdPrefix="density-budget" />

            <table class="sb-table">
                <thead>
                    <tr>
                        <th scope="col">Act</th>
                        <th scope="col">Prominence</th>
                        <th scope="col">Where it landed, and why</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var act in BudgetActs)
                    {
                        <tr data-testid="@($"density-budget-row-{act.Id}")">
                            <th scope="row">@act.Label</th>
                            <td>@(act.IsCopy ? "Copy" : act.Prominence.ToString())</td>
                            <td>@Placement(act)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Story>

    <Story Name="One item never gets a menu"
           Description="When the rule would put exactly one act into overflow, it stays visible and no trigger is rendered.

The two bars below are five acts and six at the same density. At five the spill is one, so it is pulled back; at six the spill is two and the trigger appears. An explicit `Overflow` prominence is never pulled back — the third bar is one such act, with a menu of exactly one item."
           Code="@SingleCode">
        <div class="sb-stack" data-testid="density-single">
            <div class="sb-stack">
                <p class="sb-label">Five acts — the spill of one is pulled back, and no trigger renders</p>
                <IntegrationActionBar Actions="@IntegrationFixtures.FiveActs"
                                      Density="IntegrationDensity.Toolbar"
                                      AriaLabel="Integrations"
                                      OnInvoke="Record"
                                      TestId="density-single-five"
                                      OverflowTestId="density-single-five-overflow"
                                      ActionTestIdPrefix="density-single-five" />
            </div>
            <div class="sb-stack">
                <p class="sb-label">Six acts — the spill of two gets one</p>
                <IntegrationActionBar Actions="@IntegrationFixtures.Acts"
                                      Density="IntegrationDensity.Toolbar"
                                      AriaLabel="Integrations"
                                      OnInvoke="Record"
                                      TestId="density-single-six"
                                      OverflowTestId="density-single-six-overflow"
                                      MenuTestId="density-single-six-menu"
                                      ActionTestIdPrefix="density-single-six" />
            </div>
            <div class="sb-stack">
                <p class="sb-label">One act, marked Overflow by the host — it stays in the menu</p>
                <IntegrationActionBar Actions="@AskedForTheMenu"
                                      Density="IntegrationDensity.Toolbar"
                                      AriaLabel="Integrations"
                                      OnInvoke="Record"
                                      TestId="density-single-asked"
                                      OverflowTestId="density-single-asked-overflow"
                                      MenuTestId="density-single-asked-menu"
                                      ActionTestIdPrefix="density-single-asked" />
            </div>
        </div>
    </Story>

    <Story Name="An unavailable action is not a hidden one"
           Description="Readiness has no effect on placement. An unavailable act occupies the slot it would have occupied, disabled, carrying its reason.

The two bars below are the same six specs with GitHub disconnected and VS Code missing in the second: same acts visible, same act behind the trigger, same order. A cluster readiness behaves the same way one level up, and disables the trigger with everything else."
           Code="@UnavailableCode">
        <div class="sb-stack" data-testid="density-unavailable">
            <div class="sb-stack">
                <p class="sb-label">Everything connected</p>
                <IntegrationActionBar Actions="@IntegrationFixtures.Acts"
                                      Density="IntegrationDensity.Toolbar"
                                      AriaLabel="Integrations"
                                      OnInvoke="Record"
                                      TestId="density-unavailable-ready"
                                      OverflowTestId="density-unavailable-ready-overflow"
                                      ActionTestIdPrefix="density-unavailable-ready" />
            </div>
            <div class="sb-stack">
                <p class="sb-label">GitHub not connected, VS Code not installed — identical layout</p>
                <IntegrationActionBar Actions="@IntegrationFixtures.ActsWithGitHubDown"
                                      Density="IntegrationDensity.Toolbar"
                                      AriaLabel="Integrations"
                                      OnInvoke="Record"
                                      OnRemedy="RecordRemedy"
                                      TestId="density-unavailable-down"
                                      OverflowTestId="density-unavailable-down-overflow"
                                      ActionTestIdPrefix="density-unavailable-down" />
            </div>
            <div class="sb-stack">
                <p class="sb-label">The whole cluster unavailable — every act disabled, none moved</p>
                <IntegrationActionBar Actions="@IntegrationFixtures.Acts"
                                      Density="IntegrationDensity.Toolbar"
                                      Readiness="@IntegrationFixtures.TokenExpired"
                                      AriaLabel="Integrations"
                                      OnInvoke="Record"
                                      OnRemedy="RecordRemedy"
                                      TestId="density-unavailable-cluster"
                                      OverflowTestId="density-unavailable-cluster-overflow"
                                      ActionTestIdPrefix="density-unavailable-cluster" />
            </div>
        </div>
    </Story>

    <Story Name="In the menu, the reason joins the label"
           Description="`MenuItem` is a flat record with an id, a label and an icon, so an unavailable act's reason is folded into its label — the act's words, an em dash, and the sentence it would otherwise have carried in a described-by. The item is disabled, and `MenuList` skips it with the arrow keys.

Open the trigger below: the bar is six acts at Inline density, so three are behind it."
           Code="@MenuReasonCode">
        <div class="sb-stack" data-testid="density-menu-reason">
            <IntegrationActionBar Actions="@MenuReasonActs"
                                  Density="IntegrationDensity.Inline"
                                  AriaLabel="Integrations"
                                  OnInvoke="Record"
                                  OnRemedy="RecordRemedy"
                                  TestId="density-menu-reason-bar"
                                  OverflowTestId="density-menu-reason-overflow"
                                  MenuTestId="density-menu-reason-menu"
                                  ActionTestIdPrefix="density-menu-reason" />
            <p class="sb-state">
                The disabled row reads "Rewrite part with AI — Copilot is not connected." One row, one line, no described-by.
            </p>
            <p class="sb-state" data-testid="density-menu-reason-echo">@_echo</p>
        </div>
    </Story>

    <Story Name="Compact keeps its labels where a screen reader can find them"
           Description="Icon-only means visually icon-only: every button still carries an accessible name, and `title` falls back to it when nothing more specific is given.

The compact button is padded to the minimum target size the accessibility rule sets, and the row is spaced to keep two of them from being mis-activated — so a compact cluster is the same touch target with less ink in it. The names below are read out of the same specs the buttons were built from."
           Code="@CompactCode">
        <div class="sb-stack" data-testid="density-compact">
            <IntegrationActionBar Actions="@IntegrationFixtures.Acts"
                                  Density="IntegrationDensity.Compact"
                                  AriaLabel="Integrations"
                                  OnInvoke="Record"
                                  TestId="density-compact-bar"
                                  OverflowTestId="density-compact-overflow"
                                  MenuTestId="density-compact-menu"
                                  ActionTestIdPrefix="density-compact" />
            <dl class="sb-grid">
                @foreach (var act in IntegrationFixtures.Acts)
                {
                    <div class="sb-stack">
                        <dt class="sb-label">@act.Id</dt>
                        <dd class="sb-state">aria-label and title: @act.Label</dd>
                    </div>
                }
            </dl>
        </div>
    </Story>

    <Story Name="On a list row, in a header, in a context menu"
           Description="The four densities in the hosts they were shaped for, because a density chosen in isolation always looks fine and only fails against real neighbours.

The compact row sits beside a status badge, a priority badge and a tag chip — the row a backlog list renders. The last surface is Menu density, which only makes sense in a host that already has a menu: the bar contributes a trigger and the pinned acts, and the surface owns everything else."
           Code="@SurfacesCode">
        <div class="sb-stack" data-testid="density-surfaces">
            <div class="sb-surface sb-stack">
                <p class="sb-label">A backlog list row — Compact</p>
                <div class="sb-row" data-testid="density-surface-row">
                    <span>Absorb the improvised GitHub badges</span>
                    <StatusBadge Status="in-progress" TestId="density-surface-row-status" />
                    <PriorityBadge Priority="high" TestId="density-surface-row-priority" />
                    <TagChip Text="ui" TestId="density-surface-row-tag" />
                    <IntegrationActionBar Actions="@IntegrationFixtures.Acts"
                                          Density="IntegrationDensity.Compact"
                                          AriaLabel="Integrations"
                                          OnInvoke="Record"
                                          TestId="density-surface-row-bar"
                                          OverflowTestId="density-surface-row-overflow"
                                          MenuTestId="density-surface-row-menu"
                                          ActionTestIdPrefix="density-surface-row" />
                </div>
            </div>

            <div class="sb-surface sb-stack">
                <p class="sb-label">A section header — Toolbar</p>
                <SectionHeader Title="Integrations"
                               Description="Everything this entry has done outside the product."
                               TestId="density-surface-header">
                    <Actions>
                        <IntegrationActionBar Actions="@IntegrationFixtures.Acts"
                                              Density="IntegrationDensity.Toolbar"
                                              AriaLabel="Integrations"
                                              OnInvoke="Record"
                                              TestId="density-surface-header-bar"
                                              OverflowTestId="density-surface-header-overflow"
                                              MenuTestId="density-surface-header-menu"
                                              ActionTestIdPrefix="density-surface-header" />
                    </Actions>
                </SectionHeader>
            </div>

            <div class="sb-surface sb-stack">
                <p class="sb-label">A knowledge chapter footer — Inline</p>
                <p>Chapters carry their own references, and the acts that produce them sit under the prose.</p>
                <IntegrationActionBar Actions="@IntegrationFixtures.Acts"
                                      Density="IntegrationDensity.Inline"
                                      AriaLabel="Integrations"
                                      OnInvoke="Record"
                                      TestId="density-surface-footer-bar"
                                      OverflowTestId="density-surface-footer-overflow"
                                      MenuTestId="density-surface-footer-menu"
                                      ActionTestIdPrefix="density-surface-footer" />
            </div>

            <div class="sb-surface sb-stack sb-narrow">
                <p class="sb-label">A roadmap bar's own menu — Menu</p>
                <div class="sb-row" data-testid="density-surface-bar">
                    <span>Q3 — Integrations family</span>
                    <IntegrationActionBar Actions="@IntegrationFixtures.ActsWithCopy"
                                          Density="IntegrationDensity.Menu"
                                          AriaLabel="Integrations"
                                          OnInvoke="Record"
                                          TestId="density-surface-menu-bar"
                                          OverflowTestId="density-surface-menu-overflow"
                                          MenuTestId="density-surface-menu-menu"
                                          ActionTestIdPrefix="density-surface-menu" />
                </div>
            </div>
        </div>
    </Story>

</StoryPage>

@code {
    private static readonly DesignGuideline[] Rules =
    [
        new("interaction-guidelines.md#action-density-and-overflow", "The budget that decides how many acts a surface shows."),
        new("typography-and-layout.md#density", "How tight a toolbar, a row and a cluster may be."),
        new("typography-and-layout.md#iconography", "When a label may be dropped and only the glyph remain."),
        new("accessibility.md#target-sizes-and-text", "The floor an icon-only control cannot go under.")
    ];

    private static readonly IReadOnlyList<IntegrationDensity> Densities =
    [
        IntegrationDensity.Toolbar,
        IntegrationDensity.Inline,
        IntegrationDensity.Compact,
        IntegrationDensity.Menu
    ];

    /// <summary>The seven the budget story reasons about: six acts, a copy, and
    /// one the host explicitly sent to the menu.</summary>
    private static readonly IReadOnlyList<IntegrationActionSpec> BudgetActs =
    [
        IntegrationFixtures.AskAi,
        IntegrationFixtures.CopyPrompt,
        IntegrationFixtures.CreateIssue,
        IntegrationFixtures.OpenInVsCode,
        IntegrationFixtures.RunInCopilot,
        IntegrationFixtures.ResolveComments,
        IntegrationFixtures.UnlinkIssue
    ];

    /// <summary>One act, and it asked for the menu. Without the explicit
    /// prominence the collapse rule would pull it straight back out.</summary>
    private static readonly IReadOnlyList<IntegrationActionSpec> AskedForTheMenu =
    [
        IntegrationFixtures.AskAi,
        IntegrationFixtures.UnlinkIssue
    ];

    /// <summary>Six acts with the last two unavailable, so the menu behind the
    /// trigger holds one row of each kind.</summary>
    private static readonly IReadOnlyList<IntegrationActionSpec> MenuReasonActs =
    [
        IntegrationFixtures.AskAi,
        IntegrationFixtures.CreateIssue,
        IntegrationFixtures.OpenInVsCode,
        IntegrationFixtures.RunInCopilot,
        IntegrationFixtures.ResolveComments,
        IntegrationFixtures.RewritePart with
        {
            Readiness = IntegrationReadiness.NotAuthorized("Copilot")
        }
    ];

    private string _echo = "Nothing pressed yet.";

    private void Record(IntegrationActionSpec spec) =>
        _echo = $"OnInvoke raised for {spec.Id} — {spec.Label}.";

    private void RecordRemedy(IntegrationReadiness readiness) =>
        _echo = $"OnRemedy raised: {readiness.Availability}, {readiness.Subject ?? "no subject"}.";

    private static string Slug(IntegrationDensity density) => density.ToString().ToLowerInvariant();

    /// <summary>What the rule did with one act at Toolbar density, said in the
    /// rule's own terms. Written from the prominence rather than from where the
    /// act happens to appear, so the table states the reason and the bar above it
    /// states the result.</summary>
    private static string Placement(IntegrationActionSpec act) => act switch
    {
        { IsCopy: true } => "Pinned, and costs nothing. CopyButton owns interop a MenuItem cannot carry.",
        { Prominence: IntegrationProminence.Primary } => "Pinned, and costs one. This is what makes Ask AI reachable everywhere.",
        { Prominence: IntegrationProminence.Overflow } => "Removed unconditionally, and never promoted back out. The host asked.",
        _ => "Standard: fills what budget is left, in the order given, and spills to the menu after that."
    };

    // --- Code samples ------------------------------------------------------

    private const string DensitiesCode = """
        @* One list, four surfaces. Density is a fact about the room, not about
           what the acts mean. *@
        <IntegrationActionBar Actions="@acts" Density="IntegrationDensity.Toolbar" />
        <IntegrationActionBar Actions="@acts" Density="IntegrationDensity.Inline" />
        <IntegrationActionBar Actions="@acts" Density="IntegrationDensity.Compact" />
        <IntegrationActionBar Actions="@acts" Density="IntegrationDensity.Menu" />
        """;

    private const string BudgetCode = """
        @* VisibleLimit overrides the density's own budget. It exists for a header
           that genuinely has the room and for this storybook — nearly every
           surface should take the density's number. *@
        <IntegrationActionBar Actions="@acts" Density="IntegrationDensity.Toolbar" VisibleLimit="7" />
        """;

    private const string SingleCode = """
        @* A menu holding one item costs a click and buys nothing, so a spill of
           exactly one is pulled back. An act the host marked Overflow is not a
           spill and stays where it asked to be. *@
        new IntegrationActionSpec("unlink", "Unlink the GitHub issue",
            IntegrationProvider.GitHub,
            Prominence: IntegrationProminence.Overflow,
            Destructive: true)
        """;

    private const string UnavailableCode = """
        @* Readiness never moves an act. It disables it in place, with its reason. *@
        spec with { Readiness = IntegrationReadiness.NotAuthorized("GitHub") }

        @* One cluster readiness overrides every act's own: nothing can be
           individually ready when the thing they all go through is not. *@
        <IntegrationActionBar Actions="@acts" Readiness="@cluster" OnRemedy="Reconnect" />
        """;

    private const string MenuReasonCode = """
        @* What the bar projects for an unavailable act. MenuItem is not widened
           for this — it is used by TreeView, NavList and every context menu in
           the product, and a field one caller sets is how a shared record turns
           into a union. *@
        new MenuItem(spec.Id, $"{spec.Label} — {reason}", Disabled: true);
        """;

    private const string CompactCode = """
        @* Visually icon-only. The label is still the accessible name, and title
           falls back to it — IconButton's convention, copied rather than
           re-decided. *@
        <IntegrationActionBar Actions="@acts" Density="IntegrationDensity.Compact" />
        """;

    private const string SurfacesCode = """
        @* A density chosen in isolation always looks fine. These are the four
           against the neighbours they will actually have. *@
        <div class="entry-row">
            <StatusBadge Status="in-progress" />
            <PriorityBadge Priority="high" />
            <TagChip Text="ui" />
            <IntegrationActionBar Actions="@acts" Density="IntegrationDensity.Compact" />
        </div>
        """;
}
