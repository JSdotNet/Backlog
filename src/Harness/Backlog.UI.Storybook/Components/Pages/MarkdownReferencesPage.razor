@page "/markdown/references"

<PageTitle>References in markdown — Backlog UI Storybook</PageTitle>

<StoryPage Title="References"
           Summary="A subpage of Markdown: what a reference is, and the two places one appears. A reference is an address — a path, optionally a heading in it — and being an address is what makes it followable. `DevbookReference` parses one and `DevbookReferenceLink` draws it, as a link, a button or inert text depending on what the host can actually do with it. It turns up in the prose of a body, where the author wrote a path in a sentence, and in a metadata record, under `related`, `depends-on` or `implements`. This page is both. Which record fields hold references is the Devbook chapter; what a status word means is its State subpage."
           Guidelines="@Rules">

    <Story Name="A reference is an address: a path, and optionally a heading"
           Description="Two forms, and one character tells them apart: a bare path addresses a whole file, and a path followed by `#` and a heading slug addresses one chapter of it. The split is on the first hash, so a heading whose own slug carries a second one still resolves to a single chapter; a trailing hash addresses no chapter.

`Folder` falls out of the path — always its first segment. `Label` is the short display form and `Raw` is what was authored, and `Raw` stays on the `title` either way. Everything below is this record, drawn in one of the two places one is written.

The entries here are shown as `related` lines because that is the terser form to read, but nothing about the parse is about metadata: the same string in a sentence parses to the same reference."
           Code="@ParseCode">
        <dl class="sb-grid sb-grid--addresses" data-testid="devbook-references-parsed">
            @foreach (var sample in Samples)
            {
                <div class="sb-stack" data-testid="@($"devbook-references-parsed-{sample.Slug}")">
                    <dt class="sb-label">@sample.Name</dt>
                    <dd class="sb-stack">
                        <CodeView Source="@sample.Block" Language="markdown" AllowCopy="false" CssClass="sb-raw__code"
                                  TestId="@($"devbook-references-parsed-{sample.Slug}-source")" />
                        <p class="sb-state">@Describe(sample.Raw)</p>
                        <p>@sample.Note</p>
                    </dd>
                </div>
            }
        </dl>
    </Story>

    <Story Name="Three shapes, and the host decides which"
           Description="`DevbookReferenceLink` renders what the host can do with a reference: an `Href` makes an anchor, an `OnActivate` callback makes a button, neither makes a `code` element carrying the address and making no offer.

An anchor can be middle-clicked, copied, opened in a new window and read out as a link; a button cannot. When both are given the anchor wins and the callback is ignored.

One component for both places a reference appears, which is the point of it being one: whether the address was written in a sentence or under `related`, what the reader gets is this."
           Code="@ShapesCode">
        <div class="sb-stack">
            <div class="sb-stack">
                <p class="sb-label">The entry every cell below was read from</p>
                <CodeView Source="@ChapterBlock" Language="markdown" AllowCopy="false" CssClass="sb-raw__code" TestId="devbook-references-shapes-source" />
            </div>
            <dl class="sb-grid sb-grid--addresses" data-testid="devbook-references-shapes">
                <div class="sb-stack">
                    <dt class="sb-label">Neither — inert text</dt>
                    <dd class="sb-stack">
                        <div><DevbookReferenceLink Reference="@ChapterReference" TestId="devbook-references-chip" /></div>
                        <p class="sb-state">code.devbook-ref--inert — no tab stop, no affordance.</p>
                    </dd>
                </div>
                <div class="sb-stack">
                    <dt class="sb-label">Href — an anchor</dt>
                    <dd class="sb-stack">
                        <div>
                            <DevbookReferenceLink Reference="@ChapterReference"
                                                    Href="@TargetHref"
                                                    TestId="devbook-references-link" />
                        </div>
                        <p class="sb-state">a.devbook-ref--link — copyable, openable in a new window.</p>
                    </dd>
                </div>
                <div class="sb-stack">
                    <dt class="sb-label">OnNavigate — a button</dt>
                    <dd class="sb-stack">
                        <div>
                            <DevbookReferenceLink Reference="@ChapterReference"
                                                    OnNavigate="Follow"
                                                    TestId="devbook-references-button" />
                        </div>
                        <p class="sb-state">button.devbook-ref--action — the host routes it, in-process.</p>
                    </dd>
                </div>
                <div class="sb-stack">
                    <dt class="sb-label">ShowFullPath false</dt>
                    <dd class="sb-stack">
                        <div>
                            <DevbookReferenceLink Reference="@ChapterReference"
                                                    ShowFullPath="false"
                                                    TestId="devbook-references-short" />
                        </div>
                        <p class="sb-state">Label instead of Raw, with Raw still on the title.</p>
                    </dd>
                </div>
            </dl>
            <div class="sb-stack" data-testid="devbook-references-live">
                <p class="sb-label">One handler on the block — click any reference in it</p>
                <CodeView Source="@RoadmapBlock" Language="markdown" AllowCopy="false" CssClass="sb-raw__code" TestId="devbook-references-live-source" />
                <MetadataBadge Metadata="@RoadmapMetadata"
                               Folder="DevbookFolder.Backlog"
                               OnNavigate="Follow"
                               AriaLabel="Backlog item metadata"
                               TestId="devbook-references-live-badge" />
                <p class="sb-state" data-testid="devbook-references-followed">@FollowedSummary</p>
            </div>
        </div>
    </Story>

    <Story Name="Held by something else: a chip"
           Description="A third place a reference turns up, outside the folders altogether: something else holds it — a task pointing at the chapter it is about. `DevbookReferenceChip` draws that, and it is a chip rather than a link because the holder chose the reference and can drop it again, so it carries two acts and two facts a link has no room for.

The label is the heading's words or the page's title, which only a host that read the devbook can supply; with none it falls back to the reference's own short `Label`, and the raw reference is the tooltip either way. The status is `DevbookStatusPill`, judged against the folder the reference itself names. Broken — a heading that is gone, a page that is not there, a path in no devbook folder — is a dashed edge, a mark whose accessible name is the reason, and the reason again in the tooltip: never colour alone.

`OnOpen` makes the label a button and `OnRemove` adds the remove control; without either the chip only reads. A host withholds `OnOpen` from a reference to no page, because there is nowhere for it to go."
           Code="@ChipCode">
        <div class="sb-stack" data-testid="devbook-references-chips">
            <div class="sb-row" role="list" aria-label="Devbook references">
                <DevbookReferenceChip role="listitem"
                                      Reference=".devbook/domain/tasks/domain.md#task"
                                      Title="Task"
                                      Status="active"
                                      OnOpen="FollowChip"
                                      OnRemove="RemoveChip"
                                      TestId="devbook-references-chip-chapter" />
                <DevbookReferenceChip role="listitem"
                                      Reference=".devbook/domain/tasks/domain.md"
                                      Title="Tasks domain"
                                      OnOpen="FollowChip"
                                      OnRemove="RemoveChip"
                                      TestId="devbook-references-chip-page" />
                <DevbookReferenceChip role="listitem"
                                      Reference=".devbook/domain/tasks/domain.md#renamed"
                                      Broken="true"
                                      Problem="No heading with this anchor on the page any more."
                                      OnOpen="FollowChip"
                                      OnRemove="RemoveChip"
                                      TestId="devbook-references-chip-broken" />
                <DevbookReferenceChip role="listitem"
                                      Reference="docs/handbook.md"
                                      Broken="true"
                                      Problem="Not in a devbook folder of this repository."
                                      OnRemove="RemoveChip"
                                      TestId="devbook-references-chip-outside" />
                <DevbookReferenceChip role="listitem"
                                      Reference=".devbook/arc42/09-decisions.md"
                                      Title="Architecture decisions"
                                      TestId="devbook-references-chip-read-only" />
            </div>
            <p class="sb-state" data-testid="devbook-references-chip-acted">@ChipSummary</p>
        </div>
    </Story>

    <Story Name="Scenario parts: an acceptance checklist"
           Description="When the references something holds point at parts of a scenario page — a part itself, a whole page, or a requirement whose `Proved by:` lines name parts — a task lists those parts under its chips as its acceptance checklist: `ScenarioPartChecklist`. One row per part: the four-state dot the Devbook pane draws — `ScenarioStateDot`, shown alone in the first row —  the part, the page it belongs to, and when it last ran, under a count of how many pass.

“Proved” is shown only when every part passed on the page as it stands. A part that passed before the page was edited is stale, not passed, so a renamed step takes “Proved” away until the spec is re-derived and run. It is a signal and nothing more: the task's status stays where a person put it.

The second sample is the same list on a delivery run, under the verify stage that ran the parts: a run is evidence, not an item, so it never says proved."
           Code="@AcceptanceCode">
        <div class="sb-row" data-testid="references-scenario-dots">
            <ScenarioStateDot State="passed" TestId="references-dot-passed" />
            <ScenarioStateDot State="failed" TestId="references-dot-failed" />
            <ScenarioStateDot State="stale" TestId="references-dot-stale" />
            <ScenarioStateDot State="never-run" TestId="references-dot-never-run" />
        </div>
        <div class="sb-side-panel">
            <ScenarioPartChecklist Parts="@AcceptanceParts" Heading="Acceptance" ShowProved="true" TestId="panel-acceptance" />
        </div>
        <div class="sb-side-panel">
            <ScenarioPartChecklist Parts="@ProvedParts" Heading="Acceptance" ShowProved="true" TestId="panel-acceptance-proved" />
        </div>
        <div class="sb-side-panel">
            <ScenarioPartChecklist Parts="@EvidenceParts" Heading="Verify: scenario evidence" TestId="panel-run-evidence" />
        </div>
    </Story>

    <Story Name="In prose: a path written in a sentence"
           Description="The first of the two places. An author writing a knowledge chapter mentions another one the way they would anywhere — a code span holding a path, or an ordinary markdown link — and what comes out is the same reference the record fields carry, drawn by the same component.

`DevbookInlineTargets.For` is the mechanism: a hook handed to the inline renderer, which offers it every code span and every link before drawing one itself. It lives outside `MarkdownView` because that view is not the only thing rendering a chapter — the arc42 fallback and the design sections render their own block trees straight through `MarkdownRender`, and while they passed no hook their links were browser anchors on repository paths.

The two inlines are read differently, on purpose. A **code span** is read in rooted form only: a span is a command or a type name far more often than it is a path, and `domain.md` resolved against the chapter around it would put a destination on the most quotable file name in the repository. A **link** is read against the document, because the author wrote the syntax of a thing to be followed — so `backlog/features.md#feature-roadmap-planning` resolves the way every other markdown viewer would resolve it.

What it declines divides in two. A target naming a scheme was never this to place, so an `https` link stays the anchor `MarkdownRender` already writes. A relative one that reaches no chapter — an image, a typo, a path that climbs out of the repository — keeps its words and loses its destination, wearing the same inert class as a scheme the renderer will not navigate to."
           Code="@ProseCode"
           Source="@ProseSample">
        <div class="sb-stack" data-testid="markdown-references-prose">
            <MarkdownStory Source="@ProseSample"
                           DevbookDocumentPath="@ProsePath"
                           DevbookFolder="DevbookFolder.Domain"
                           DevbookHrefFor="@ResolveDomainOnly"
                           OnDevbookNavigate="FollowInProse"
                           TestId="markdown-references-prose-body" />
            <p class="sb-state" data-testid="markdown-references-prose-followed">@ProseFollowedSummary</p>
        </div>
    </Story>

    <Story Name="In a record: the whole block, as links"
           Description="The second place, and the one the convention is written for: the entries under `related`, `depends-on` and `implements` are addresses rather than labels, which is what makes a record something to navigate by rather than something to read.

`DevbookHrefFor` maps a reference to a route; the host owns that mapping because only it knows what it serves. Returning null leaves that one reference inert while its siblings stay links, which is the ordinary case for a block pointing at one chapter the host can show and one it cannot.

The block below names one target twice under two fields, which is why the line under it counts fewer references than there are links: `References` is the whole block's addresses in field order, de-duplicated on the form they were authored in."
           Code="@HrefCode">
        <div class="sb-stack" data-testid="devbook-references-hrefs">
            <p class="sb-label">The block, as written in .domain</p>
            <CodeView Source="@DuplicateBlock" Language="markdown" AllowCopy="false" CssClass="sb-raw__code" TestId="devbook-references-hrefs-source" />
            <MetadataView Metadata="@DuplicateMetadata"
                               Vocabulary="@DevbookStatus.Vocabulary(DevbookFolder.Domain)"
                               HrefFor="@ResolveHref"
                               TestId="devbook-references-hrefs-view" />
            <p class="sb-state" data-testid="devbook-references-dedupe-state">@DuplicateSummary</p>
            <p id="devbook-reference-target" class="sb-state" data-testid="devbook-references-target">
                Every link above lands here. A host returns its own route instead.
            </p>
        </div>
    </Story>

    <Story Name="Both places, in one document"
           Description="A real body has references in its prose and references in its records, and one call covers both: `MarkdownView` takes the resolver and the callback once and they reach every metadata block and every inline in the body. Nothing walks the blocks itself.

Which of the two signals is set decides how much is live. `RenderDevbookMetadata` makes a `meta` fence a record; `DevbookDocumentPath` says which document this is, and a relative link in the prose has nothing to resolve against without it. Either one on its own is a host saying the prose here is convention-written prose, so either turns the inline hook on — but only the path makes the relative spellings work, which is the form the folders are actually authored in.

The resolver answers only for `.domain`, so the mixed case is visible throughout: the file-level block's `.arc42` reference and the `.arc42` span in the prose stay inert, while every `.domain` target — in a record or in a sentence — becomes a link."
           Code="@MarkdownCode"
           Source="@BacklogSample">
        <MarkdownStory Source="@BacklogSample"
                       RenderDevbookMetadata="true"
                       DevbookFolder="DevbookFolder.Backlog"
                       DevbookDocumentPath=".backlog/domain-backlog.md"
                       DevbookHrefFor="@ResolveDomainOnly"
                       TestId="devbook-references-document" />
    </Story>

</StoryPage>

@code {
    private static readonly IReadOnlyList<ScenarioChecklistPart> AcceptanceParts =
    [
        new("Statuses are set up", "passed", "Set up and fill the backlog", "Ran 7 Oct 2026 08:30", ".devbook/domain/work/set-up-and-fill-the-backlog.md#statuses-are-set-up"),
        new("An item is moved", "failed", "Set up and fill the backlog", "Ran 7 Oct 2026 08:30", ".devbook/domain/work/set-up-and-fill-the-backlog.md#an-item-is-moved"),
        new("Columns follow the status order", "stale", "Board journeys", "Ran 2 Oct 2026 17:05", ".devbook/domain/work/board-journeys.md#columns-follow-the-status-order"),
        new("A new item lands in Backlog", "never-run", "Board journeys", null, ".devbook/domain/work/board-journeys.md#a-new-item-lands-in-backlog")
    ];

    private static readonly IReadOnlyList<ScenarioChecklistPart> ProvedParts =
    [
        new("Statuses are set up", "passed", "Set up and fill the backlog", "Ran 7 Oct 2026 08:30", ".devbook/domain/work/set-up-and-fill-the-backlog.md#statuses-are-set-up"),
        new("An item is moved", "passed", "Set up and fill the backlog", "Ran 7 Oct 2026 08:30", ".devbook/domain/work/set-up-and-fill-the-backlog.md#an-item-is-moved")
    ];

    private static readonly IReadOnlyList<ScenarioChecklistPart> EvidenceParts =
    [
        new("statuses-are-set-up", "passed", "set-up-and-fill-the-backlog", "Ran 7 Oct 2026 08:30", "set-up-and-fill-the-backlog.md#statuses-are-set-up"),
        new("an-item-is-moved", "not-run", "set-up-and-fill-the-backlog", "Ran 7 Oct 2026 08:30", "set-up-and-fill-the-backlog.md#an-item-is-moved")
    ];

    private const string AcceptanceCode = """
        @* The host folds the signature into the state: a part that passed on a
           page edited since arrives as stale. *@
        <ScenarioPartChecklist Parts="@ChecklistParts(acceptance)"
                               Heading="Acceptance"
                               ShowProved="true"
                               OnOpen="@AcceptanceOpener(row)"
                               TestId="entry-acceptance" />
        """;

    private static readonly DesignGuideline[] Rules =
    [
        new("content-editing.md#structured-metadata-sigils", "How an address is written, and what may follow it."),
        new("color-scheme.md#badge-and-chip-tones", "The tone a reference wears for each thing it points at."),
        new("accessibility.md#keyboard-navigation", "What a reference has to be followable with.")
    ];

    /// <summary>One address, and the `related` entry it would have been written
    /// as. The name is what the cell is called; the address itself belongs in the
    /// source under it rather than in a label, where it was long enough to set the
    /// width of its column and spill over the cell beside it.</summary>
    private sealed record ReferenceSample(string Name, string Raw, string Slug, string Note)
    {
        public string Block => $"related: [\"{Raw}\"]";
    }

    private DevbookReference? _followed;

    private DevbookReference? _followedInProse;

    /// <summary>Where the prose sample is pretending to be. A link in a body is
    /// resolved against the document holding it, so this is not decoration: without
    /// it every relative spelling in the sample below stays the words the author
    /// wrote.</summary>
    private const string ProsePath = ".devbook/domain/context-map.md";

    /// <summary>One paragraph of each kind the hook has an answer for: a rooted
    /// code span, a relative link, a link that already opens with a folder, a span
    /// that is plainly not a path, a scheme, and a relative target that reaches no
    /// chapter.</summary>
    private const string ProseSample = """
        The `.devbook/domain/tasks/domain.md` chapter owns the entry aggregate, and
        [the roadmap feature](backlog/features.md#feature-roadmap-planning) is
        planned against it. The convention itself is written down in
        [the crosscutting concepts](.devbook/arc42/08-crosscutting-concepts.md#storage-and-sync).

        A `Guid` is not a path and neither is `MarkdownPreview.ParseInlines`, so both
        stay code spans. An [ordinary web link](https://learn.microsoft.com/aspnet/core/blazor)
        stays an ordinary web link, and [a picture](assets/diagram.png) reaches no
        chapter — its words stay, its destination does not.
        """;

    /// <summary>The one entry the shapes story renders four ways.</summary>
    private const string ChapterBlock = "related: [\".devbook/arc42/08-crosscutting-concepts.md#storage-and-sync\"]";

    /// <summary>Read out of the block above rather than parsed from a second copy
    /// of the same string, so the source shown beside the four shapes is the source
    /// they were actually built from.</summary>
    private static readonly DevbookReference ChapterReference = MetadataReader.Parse(ChapterBlock).Related[0];

    /// <summary>Where the anchor shape points, for the shapes story.</summary>
    private const string TargetHref = "#devbook-reference-target";

    private const string RoadmapBlock = """
        status: in-progress
        implements: [.devbook/domain/tasks/features.md#feature-roadmap-planning]
        related: [.devbook/domain/environment/features.md#feature-environment-aware-work-context]
        """;

    private static readonly MetadataRecord RoadmapMetadata = MetadataReader.Parse(RoadmapBlock);

    /// <summary>A block naming one target under two different fields, so the
    /// links on screen and the de-duplicated References list can be counted
    /// against each other.</summary>
    private const string DuplicateBlock = """
        status: draft
        related: [.devbook/domain/tasks/domain.md#task]
        depends-on: [.devbook/domain/tasks/domain.md#task, .devbook/tech/shared.md#markdown]
        """;

    private static readonly MetadataRecord DuplicateMetadata = MetadataReader.Parse(DuplicateBlock);

    /// <summary>The top of this repository's own .backlog/domain-backlog.md.</summary>
    private const string BacklogSample = """
        # Tasks Work

        ```meta
        status: draft
        related: [".devbook/arc42/09-architecture-decisions.md"]
        ```

        ## Add roadmap planning to the backlog

        ```meta
        status: draft
        implements: [.devbook/domain/tasks/features.md#feature-roadmap-planning]
        related: [.devbook/domain/environment/features.md#feature-environment-aware-work-context]
        ```

        A roadmap view over selected backlog entries, organised by planning horizon
        while the entries stay the source of truth for status and priority. The
        feature is specified in `.devbook/domain/tasks/features.md`, and the decision it
        rests on is `.devbook/arc42/09-architecture-decisions.md` — the same two addresses
        the records above carry, written the way an author writes them in a
        sentence.
        """;

    private static readonly IReadOnlyList<ReferenceSample> Samples =
    [
        new("A chapter of a file", ".devbook/arc42/08-crosscutting-concepts.md#storage-and-sync", "chapter",
            "The common form: a file, and one addressable heading inside it."),

        new("A whole file", ".devbook/tech/technology-graph.md", "file",
            "No hash, so the whole file is the target and Label falls back to its name."),

        new("Several segments deep", ".devbook/domain/tasks/domain.md#task", "nested",
            "The folder is still the first segment of the path, never the last, however deep it goes."),

        new("A trailing hash", ".devbook/design/color-scheme.md#", "trailing",
            "Nothing after the hash, so it reads as the file it plainly points at rather than as a chapter that is missing."),

        new("Outside the folders", "docs/handbook.md", "outside",
            "Addressable, but in no knowledge folder — Folder comes back Unknown and everything else still works.")
    ];

    private string ProseFollowedSummary => _followedInProse is null
        ? "Nothing followed yet. Click a path in the paragraph above."
        : $"Followed out of the prose: {_followedInProse.Raw} · path {_followedInProse.Path} "
        + $"· chapter {_followedInProse.Slug ?? "(none — a file)"} · folder {_followedInProse.Folder}";

    private string FollowedSummary => _followed is null
        ? "Nothing followed yet. Click a reference above."
        : $"Raw {_followed.Raw} · path {_followed.Path} · chapter {_followed.Slug ?? "(none — a file)"} "
        + $"· folder {_followed.Folder} · IsChapter {_followed.IsChapter}";

    private static string DuplicateSummary =>
        $"related {DuplicateMetadata.Related.Count} + depends-on {DuplicateMetadata.DependsOn.Count} "
        + $"= {DuplicateMetadata.References.Count} distinct references: "
        + string.Join(", ", DuplicateMetadata.References.Select(reference => reference.Raw));

    /// <summary>Takes a reference apart, in the order the record declares it.</summary>
    private static string Describe(string raw)
    {
        var reference = DevbookReference.Parse(raw);
        if (reference is null) return "Not addressable — Parse returns null.";

        return $"path {reference.Path} · chapter {reference.Slug ?? "(none)"} · folder {reference.Folder} "
            + $"· file {reference.FileName} · label {reference.Label} · IsChapter {reference.IsChapter}";
    }

    private string? _chipAct;

    private string ChipSummary => _chipAct ?? "Nothing pressed yet. Open or remove a chip above.";

    private void FollowChip(string reference) => _chipAct = $"Open {reference}";

    private void RemoveChip(string reference) => _chipAct = $"Remove {reference}";

    private const string ChipCode = """
        <DevbookReferenceChip Reference=".devbook/domain/tasks/domain.md#task"
                              Title="Task"
                              Status="active"
                              OnOpen="Open"
                              OnRemove="Remove" />

        @* Broken: the reason is the mark's name and the tooltip's tail. *@
        <DevbookReferenceChip Reference=".devbook/domain/tasks/domain.md#renamed"
                              Broken="true"
                              Problem="No heading with this anchor on the page any more."
                              OnOpen="Open"
                              OnRemove="Remove" />

        @* Nowhere to go: no OnOpen, so the label is text. *@
        <DevbookReferenceChip Reference="docs/handbook.md"
                              Broken="true"
                              Problem="Not in a devbook folder of this repository."
                              OnRemove="Remove" />
        """;

    private void Follow(DevbookReference reference) => _followed = reference;

    /// <summary>The same callback, on the prose story, kept separate so the two
    /// state lines do not answer for each other.</summary>
    private void FollowInProse(DevbookReference reference) => _followedInProse = reference;

    /// <summary>The storybook has no route for a repository path, so every
    /// reference resolves to one line on this page. A host returns its own.</summary>
    private static string? ResolveHref(DevbookReference reference) => TargetHref;

    /// <summary>Answers for one folder only, so the mixed case is visible: the
    /// references it declines stay inert beside the ones it resolved.</summary>
    private static string? ResolveDomainOnly(DevbookReference reference) =>
        reference.Folder is DevbookFolder.Domain ? TargetHref : null;

    private const string ParseCode = """
        @* Null for anything that addresses nothing; TryParse is the same call
           for a caller that keeps the entries it could not read. *@
        var reference = DevbookReference.Parse(".devbook/tech/shared.md#markdown");

        reference.Path;      // .devbook/tech/shared.md
        reference.Slug;      // markdown
        reference.Folder;    // DevbookFolder.Tech
        reference.FileName;  // shared.md
        reference.Label;     // markdown        — Raw stays whole for the title
        reference.IsChapter; // true            — IsFile is its opposite
        """;

    private const string ShapesCode = """
        @* Neither: inert text. Nobody can follow it, so it does not offer. *@
        <DevbookReferenceLink Reference="@reference" />

        @* An href: an anchor, so it can be copied and opened in a new window. *@
        <DevbookReferenceLink Reference="@reference" Href="@Route(reference)" />

        @* A callback: a button, because the host routes it in-process. *@
        <DevbookReferenceLink Reference="@reference" OnNavigate="Follow" />

        @* Wired once on the block instead: every reference in it forwards to
           this. Both MetadataBadge and MetadataView take the parameter. *@
        <MetadataBadge Metadata="@metadata"
                       Folder="DevbookFolder.Backlog"
                       OnNavigate="Follow" />

        @code {
            @* The whole reference, already taken apart — the folder is usually
               what decides which surface should open. *@
            private void Follow(DevbookReference reference) =>
                Navigation.NavigateTo($"/devbook/{reference.Path}#{reference.Slug}");
        }
        """;

    private const string HrefCode = """
        <MetadataView Metadata="@metadata" Vocabulary="@DevbookStatus.Vocabulary(folder)" HrefFor="@Route" />

        @code {
            @* The host owns the mapping from repository path to route. Null
               leaves that one reference inert while its siblings stay links,
               which is what a block pointing partly outside your reach needs. *@
            private string? Route(DevbookReference reference) =>
                _served.Contains(reference.Path)
                    ? $"/devbook/{reference.Path}#{reference.Slug}"
                    : null;
        }

        @* Every address the block carries, in field order, de-duplicated on the
           authored form. One edge per target, for a caller building a graph. *@
        foreach (var reference in metadata.References)
        {
            graph.Connect(current, reference.Path, reference.Slug);
        }
        """;

    private const string ProseCode = """
        @* The document's own path is what a relative link resolves against, so a
           view that cannot say where it is leaves those links as words. *@
        <MarkdownView Blocks="@blocks"
                      DevbookDocumentPath="@path"
                      DevbookHrefFor="@Route"
                      OnDevbookNavigate="Follow" />

        @* Inside: what the view hands the inline renderer. A hook, offered every
           code span and every link before the renderer draws one itself — and
           null when neither knowledge signal was given, which is what keeps a
           path in an entry's body a path being quoted. *@
        private MarkdownRender.MarkdownInlineTarget? InlineTarget =>
            RenderDevbookMetadata || !string.IsNullOrWhiteSpace(DevbookDocumentPath)
                ? DevbookInlineTargets.For(DevbookDocumentPath, DevbookHrefFor, OnDevbookNavigate)
                : null;

        @* A surface that renders its own block tree passes the same hook rather
           than writing the rule again — the arc42 fallback and the design
           sections both do. *@
        @MarkdownRender.Inlines(parts, DevbookInlineTargets.For(path, Route, Follow))
        """;

    private const string MarkdownCode = """
        @* One call for both places. The resolver and the callback reach every
           metadata block and every inline in the body; the path is what the
           relative links in the prose resolve against. *@
        <MarkdownView Blocks="@blocks"
                      RenderDevbookMetadata="true"
                      DevbookFolder="@DevbookFolders.FromPath(path)"
                      DevbookDocumentPath="@path"
                      DevbookHrefFor="@Route"
                      OnDevbookNavigate="Follow" />
        """;
}
