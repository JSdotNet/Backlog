@page "/lobes-atlas"

<PageTitle>Lobes atlas — Backlog UI Storybook</PageTitle>

<StoryPage Title="Lobes atlas"
           Summary="The atlas renderer's lobes drawing: each scope a brain, each mark in one region of it — dense Frontal and Temporal, loose Parietal, Occipital and Cerebellum clouds, ringed hubs in the stem, and a faint dust tracing the outline. GraphAtlas hosts it by naming backlogLobesAtlas.render; the list beside it stays the control."
           Guidelines="@Rules">
    @*
        Sample data, not anyone's Brain: a Brain of a few hundred notes, two
        devbooks of different sizes and one alias the notes name that no devbook
        here holds. Every mark is generated from its index, so the picture is the
        same on every load and a screenshot of it is worth comparing.
    *@

    <Story Name="All"
           Description="Every scope at once: the Brain centred and scaled down, each devbook a smaller brain seated round it and sized by how much it holds, the ghost devbook a dashed outline with only the chapters the notes name. Bundles run teal into gold from the Brain's repository hubs to the chapters the notes link, dashed where the link cannot be followed. Drag to rotate, scroll to zoom; nearer marks draw larger and brighter."
           Code="@AllCode">
        <GraphAtlas Title="Brain + 3 devbooks"
                    Data="AllModel"
                    Nodes="IndexFor(AllModel)"
                    JsFunction="@LobesAtlasModel.JsFunction"
                    AriaLabel="Lobes atlas, every scope"
                    IndexLabel="Every mark"
                    CssClass="sb-atlas" />
    </Story>

    <Story Name="Brain"
           Description="The Brain alone at full size, by region: its accent, color-band-2, with the cool tones round it. Each region is named with its count; the stem's hubs and the repository hubs in Occipital carry their names, and the hub of an alias not registered here wears a dashed ring."
           Code="@ScopeCode">
        <GraphAtlas Title="Brain · 6 regions"
                    Data="BrainModel"
                    Nodes="IndexFor(BrainModel)"
                    JsFunction="@LobesAtlasModel.JsFunction"
                    AriaLabel="Lobes atlas, the Brain"
                    IndexLabel="Brain marks"
                    CssClass="sb-atlas" />
    </Story>

    <Story Name="A devbook"
           Description="One devbook at full size, in gold, one region per folder and its roots as hubs in the stem. A Brain hub floats beside it with the bundles the Brain's notes send in, and says how many notes link here."
           Code="@ScopeCode">
        <GraphAtlas Title="backlog devbook · 6 folders"
                    Data="DevbookModel"
                    Nodes="IndexFor(DevbookModel)"
                    JsFunction="@LobesAtlasModel.JsFunction"
                    AriaLabel="Lobes atlas, the backlog devbook"
                    IndexLabel="backlog chapters"
                    CssClass="sb-atlas" />
    </Story>

    <Story Name="A ghost scope"
           Description="An alias the notes link to that no devbook on this machine holds: the outline, and only the chapters the notes name, each a hollow dashed ring in the link's own words. The bundles from the Brain hub are dashed, because none of them can be followed here."
           Code="@ScopeCode">
        <GraphAtlas Title="devbook-stack · not registered"
                    Data="GhostModel"
                    Nodes="IndexFor(GhostModel)"
                    JsFunction="@LobesAtlasModel.JsFunction"
                    AriaLabel="Lobes atlas, the devbook-stack ghost devbook"
                    IndexLabel="devbook-stack chapters"
                    CssClass="sb-atlas" />
    </Story>

    <Story Name="Hidden regions"
           Description="The same devbook with tech and ai hidden: a hidden region is not drawn, its name leaves the map and its marks leave the list. A hidden scope in All is left out the same way."
           Code="@HiddenCode">
        <GraphAtlas Title="backlog devbook · tech and ai hidden"
                    Data="HiddenModel"
                    Nodes="IndexFor(HiddenModel)"
                    JsFunction="@LobesAtlasModel.JsFunction"
                    AriaLabel="Lobes atlas, backlog with two regions hidden"
                    IndexLabel="backlog chapters shown"
                    CssClass="sb-atlas" />
    </Story>
</StoryPage>

@code {
    private const string BrainKey = "brain";
    private const string BacklogKey = "repo:backlog";
    private const string HomelabKey = "repo:homelab";
    private const string StackKey = "ghost:devbook-stack";

    private const string AllCode = """
        <GraphAtlas Title="Brain + 3 devbooks"
                    Data="@(model with { Layout = LobesAtlasModel.AllLayout })"
                    Nodes="indexNodes"
                    JsFunction="@LobesAtlasModel.JsFunction"
                    AriaLabel="Lobes atlas, every scope" />
        """;

    private const string ScopeCode = """
        @* The same marks; the layout names the one scope drawn at full size. *@
        <GraphAtlas Data="@(model with { Layout = "repo:backlog" })"
                    Nodes="indexNodes"
                    JsFunction="@LobesAtlasModel.JsFunction" />
        """;

    private const string HiddenCode = """
        <GraphAtlas Data="@(model with
                    {
                        Layout = "repo:backlog",
                        HiddenLobes = [new("repo:backlog", "parietal"), new("repo:backlog", "cerebellum")]
                    })"
                    Nodes="indexNodes"
                    JsFunction="@LobesAtlasModel.JsFunction" />
        """;

    private static readonly DesignGuideline[] Rules =
    [
        new("component-libraries.md#diagram-and-graph-strategy", "Why the lobes are drawn by the first-party canvas renderer and not a graph engine."),
        new("color-scheme.md#the-brains-accent", "Why Brain marks are teal and devbook marks gold."),
        new("accessibility.md#keyboard-navigation", "Why the list beside the canvas is the control and the canvas is not.")
    ];

    private static readonly LobesAtlasModel Sample = BuildSample();

    private static readonly LobesAtlasModel AllModel = Sample;

    private static readonly LobesAtlasModel BrainModel = Sample with { Layout = BrainKey };

    private static readonly LobesAtlasModel DevbookModel = Sample with { Layout = BacklogKey };

    private static readonly LobesAtlasModel GhostModel = Sample with { Layout = StackKey };

    private static readonly LobesAtlasModel HiddenModel = Sample with
    {
        Layout = BacklogKey,
        HiddenLobes = [new(BacklogKey, LobesAtlasMark.Parietal), new(BacklogKey, LobesAtlasMark.Cerebellum)]
    };

    /// <summary>The marks a model draws, as the index beside it lists them.</summary>
    private static IReadOnlyList<GraphAtlasNode> IndexFor(LobesAtlasModel model)
    {
        var all = model.Layout == LobesAtlasModel.AllLayout;
        var hiddenScopes = model.HiddenScopes.ToHashSet();
        var hiddenLobes = model.HiddenLobes.ToHashSet();
        var scopes = model.Scopes.ToDictionary(scope => scope.Key);

        return
        [
            .. model.Marks
                .Where(mark => all
                    ? !hiddenScopes.Contains(mark.Scope)
                    : mark.Scope == model.Layout && !hiddenLobes.Contains(new LobesAtlasRegionKey(mark.Scope, mark.Lobe)))
                .Select(mark => new GraphAtlasNode(
                    mark.Id,
                    mark.Label,
                    mark.Kind switch { LobesAtlasMark.Hub => "Hub", LobesAtlasMark.GhostItem => "Ghost chapter", _ => scopes[mark.Scope].Kind == LobesAtlasScope.Brain ? "Note" : "Chapter" },
                    mark.Kind == LobesAtlasMark.GhostItem || mark.Dashed ? "not on this machine" : string.Empty,
                    mark.Kind == LobesAtlasMark.GhostItem || mark.Dashed ? "archived" : scopes[mark.Scope].Kind == LobesAtlasScope.Brain ? "brain" : "active",
                    $"{scopes[mark.Scope].Label} · {scopes[mark.Scope].Regions?.FirstOrDefault(region => region.Lobe == mark.Lobe)?.Label ?? "Archive"}"))
        ];
    }

    private static LobesAtlasModel BuildSample()
    {
        var marks = new List<LobesAtlasMark>();
        var links = new List<LobesAtlasLink>();

        List<string> Fill(string scope, string lobe, string noun, int count)
        {
            var ids = new List<string>();
            for (var i = 1; i <= count; i++)
            {
                var id = $"{scope}|{lobe}/{i}";
                marks.Add(new LobesAtlasMark(id, $"{noun} {i}", scope, lobe));
                ids.Add(id);
            }

            // A few links inside the region, and one out of it in three, so the
            // scope has its own web without it becoming a hairball.
            for (var i = 0; i + 3 < ids.Count; i += 3) links.Add(new LobesAtlasLink(ids[i], ids[i + 3]));
            return ids;
        }

        string Hub(string scope, string lobe, string label, bool dashed = false)
        {
            var id = $"{scope}|hub:{label}";
            marks.Add(new LobesAtlasMark(id, label, scope, lobe, LobesAtlasMark.Hub, dashed));
            return id;
        }

        void Wire(string hub, IReadOnlyList<string> targets, int every)
        {
            for (var i = 0; i < targets.Count; i += every) links.Add(new LobesAtlasLink(hub, targets[i]));
        }

        // ----- The Brain -----
        var projects = Fill(BrainKey, LobesAtlasMark.Frontal, "Project", 48);
        var resources = Fill(BrainKey, LobesAtlasMark.Parietal, "Resource", 120);
        var people = Fill(BrainKey, LobesAtlasMark.Temporal, "Person", 24);
        var journal = Fill(BrainKey, LobesAtlasMark.Cerebellum, "Journal", 70);
        Fill(BrainKey, LobesAtlasMark.Dust, "Archived", 30);
        var conventions = Hub(BrainKey, LobesAtlasMark.Stem, "CONVENTIONS.md");
        var routing = Hub(BrainKey, LobesAtlasMark.Stem, "Projects");
        Wire(conventions, resources, 9);
        Wire(routing, projects, 4);
        for (var i = 0; i < 12; i++) links.Add(new LobesAtlasLink(projects[i * 3], people[i * 2]));
        for (var i = 0; i < 8; i++) links.Add(new LobesAtlasLink(journal[i * 7], projects[i * 5]));

        var backlogHub = Hub(BrainKey, LobesAtlasMark.Occipital, "backlog");
        var homelabHub = Hub(BrainKey, LobesAtlasMark.Occipital, "homelab");
        var stackHub = Hub(BrainKey, LobesAtlasMark.Occipital, "devbook-stack", dashed: true);

        // ----- The backlog devbook -----
        var arc42 = Fill(BacklogKey, LobesAtlasMark.Frontal, "arc42 chapter", 70);
        var tech = Fill(BacklogKey, LobesAtlasMark.Parietal, "Technology", 90);
        var domain = Fill(BacklogKey, LobesAtlasMark.Temporal, "Domain chapter", 50);
        Fill(BacklogKey, LobesAtlasMark.Occipital, "Design chapter", 30);
        Fill(BacklogKey, LobesAtlasMark.Cerebellum, "AI chapter", 12);
        var readme = Hub(BacklogKey, LobesAtlasMark.Stem, "README");
        var order = Hub(BacklogKey, LobesAtlasMark.Stem, "reading order");
        Wire(readme, arc42, 6);
        Wire(order, domain, 6);
        Wire(backlogHub, arc42, 5);
        Wire(backlogHub, tech, 15);

        // ----- The homelab devbook -----
        var homelabArc42 = Fill(HomelabKey, LobesAtlasMark.Frontal, "arc42 chapter", 20);
        var homelabTech = Fill(HomelabKey, LobesAtlasMark.Parietal, "Technology", 30);
        Fill(HomelabKey, LobesAtlasMark.Temporal, "Domain chapter", 12);
        Fill(HomelabKey, LobesAtlasMark.Cerebellum, "AI chapter", 4);
        Hub(HomelabKey, LobesAtlasMark.Stem, "README");
        Wire(homelabHub, homelabArc42, 4);
        for (var i = 0; i < 5; i++) links.Add(new LobesAtlasLink(tech[i * 11], homelabTech[i * 5]));

        // ----- The ghost devbook: only what the notes name, dashed -----
        string[] named = ["arc42/decisions.md#0003", "tech/radar.md", "ai/agents.md"];
        string[] lobes = [LobesAtlasMark.Frontal, LobesAtlasMark.Parietal, LobesAtlasMark.Cerebellum];
        for (var i = 0; i < named.Length; i++)
        {
            var id = $"{StackKey}|ghost:{named[i]}";
            marks.Add(new LobesAtlasMark(id, named[i], StackKey, lobes[i], LobesAtlasMark.GhostItem));
            links.Add(new LobesAtlasLink(stackHub, id, LobesAtlasLink.Bundle, Dashed: true));
        }

        // A hub's links into another scope are bundles.
        var bundled = links
            .Select(link => link.Source.StartsWith(BrainKey + "|hub:", StringComparison.Ordinal) && !link.Target.StartsWith(BrainKey, StringComparison.Ordinal)
                ? link with { Kind = LobesAtlasLink.Bundle }
                : link)
            .ToList();

        LobesAtlasRegion[] Regions(string scope, params (string Lobe, string Label)[] names) =>
        [
            .. names
                .Select(name => new LobesAtlasRegion(name.Lobe, name.Label, marks.Count(mark => mark.Scope == scope && mark.Lobe == name.Lobe)))
                .Where(region => region.Count > 0)
        ];

        (string, string)[] brainNames =
        [
            (LobesAtlasMark.Frontal, "Frontal"), (LobesAtlasMark.Parietal, "Parietal"), (LobesAtlasMark.Temporal, "Temporal"),
            (LobesAtlasMark.Occipital, "Occipital"), (LobesAtlasMark.Cerebellum, "Cerebellum"), (LobesAtlasMark.Stem, "Brain stem")
        ];
        (string, string)[] folderNames =
        [
            (LobesAtlasMark.Frontal, "arc42"), (LobesAtlasMark.Parietal, "tech"), (LobesAtlasMark.Temporal, "domain"),
            (LobesAtlasMark.Occipital, "design"), (LobesAtlasMark.Cerebellum, "ai"), (LobesAtlasMark.Stem, "Index")
        ];

        int Items(string scope) => marks.Count(mark => mark.Scope == scope && mark.Kind != LobesAtlasMark.Hub);

        LobesAtlasScope[] scopes =
        [
            new(BrainKey, "Brain", LobesAtlasScope.Brain, Items(BrainKey), Regions(BrainKey, brainNames)),
            new(BacklogKey, "backlog", LobesAtlasScope.Devbook, Items(BacklogKey), Regions(BacklogKey, folderNames), "Brain · 41 notes link here"),
            new(HomelabKey, "homelab", LobesAtlasScope.Devbook, Items(HomelabKey), Regions(HomelabKey, folderNames), "Brain · 12 notes link here"),
            new(StackKey, "devbook-stack", LobesAtlasScope.Ghost, null, Regions(StackKey, folderNames), "Brain · 3 notes link here")
        ];

        return new LobesAtlasModel(LobesAtlasModel.AllLayout, scopes, marks, bundled, [], [], EmptyMessage: "No scope to draw.");
    }
}
