@page "/productivity"

<PageTitle>Productivity over time — Backlog UI Storybook</PageTitle>

<StoryPage Title="Productivity over time"
           Summary="A score, what it is made of, and the four ways this palette can compare it across repositories over time."
           Guidelines="@Rules">

    <Story Name="The controls, and what they drive"
           Code="@ControlsCode"
           Description="Window, granularity and subject, built from the library's existing `ButtonGroup`, `ToggleButton` and `NavList` rather than from anything new.

Everything below reacts to these three: change the subject and the trellis highlight, the spotlight and the score all follow.">
        <div class="sb-stack">
            <div class="sb-row">
                <span class="sb-label">Window</span>
                <div class="sb-control-scroll">
                    <ButtonGroup AriaLabel="Score window">
                        @foreach (var window in ProductivityFixtures.Windows)
                        {
                            @* PressedChanged, not the pressed state itself: the strip is
                               one-of-many, so the page owns the selection and the button
                               only announces the press. *@
                            <ToggleButton Pressed="_weeks == window.Weeks"
                                          PressedChanged="_ => _weeks = window.Weeks"
                                          TestId="@($"window-{window.Weeks}")">
                                @window.Label
                            </ToggleButton>
                        }
                    </ButtonGroup>
                </div>
            </div>

            <div class="sb-row">
                <span class="sb-label">Subject</span>
                <div class="sb-control-scroll">
                    <ButtonGroup AriaLabel="Repository under review">
                        @foreach (var name in ProductivityFixtures.Names)
                        {
                            <ToggleButton Pressed="_subject == name"
                                          PressedChanged="_ => _subject = name"
                                          TestId="@($"subject-{name}")">
                                @name
                            </ToggleButton>
                        }
                    </ButtonGroup>
                </div>
            </div>

            <p class="sb-state" data-testid="controls-state">
                Subject: @_subject · window: @_weeks weeks · @Windowed.Count repositories reporting ·
                score @MetricFormat.Score(MetricScoring.Score(ProductivityFixtures.ScoreInputsFor(_subject)))
            </p>
        </div>
    </Story>

    <Story Name="MetricScore"
           Description="The score, its band, and what it is made of. Each input is passed with its weight and its contribution, so the number arrives as an argument rather than as a claim a reader has to take on faith."
           Code="@ScoreCode">
        <MetricScore Label="@($"Productivity score — {_subject}")"
                     Components="ProductivityFixtures.ScoreInputsFor(_subject)"
                     Bands="ProductivityFixtures.Bands"
                     Delta="ProductivityFixtures.ScoreDeltaFor(_subject)"
                     Footnote="Weighted, normalised, and reproducible: the same inputs give the same score on any machine."
                     TestId="score-composed" />
    </Story>

    <Story Name="MetricScore in its other states"
           Description="A score with no visible composition says so, in the calm info surface rather than as a warning — a service that did not return its inputs is a legitimate case.

Bands take a ramp step and a name, never a red-amber-green light."
           Code="@ScoreStatesCode">
        <div class="sb-stack">
            <MetricScore Label="Arrived without its inputs"
                         Value="68.4m"
                         Bands="ProductivityFixtures.Bands"
                         TestId="score-opaque" />

            <div class="sb-grid">
                @foreach (var sample in BandSamples)
                {
                    <MetricScore Label="@($"Scoring {sample}")"
                                 Value="sample"
                                 Bands="ProductivityFixtures.Bands"
                                 TestId="@($"score-band-{sample}")" />
                }
            </div>

            <MetricScore Label="Productivity score"
                         Status="MetricStatusKind.Unavailable"
                         StatusMessage="No repository is selected. Pick one to score it."
                         TestId="score-unavailable" />
        </div>
    </Story>

    <Story Name="MetricTrellis — small multiples"
           Description="One panel per repository, every panel on the same scale. The first thing to reach for when comparing series across repositories; there is no multi-series line chart in the library."
           Code="@TrellisCode">
        <div class="sb-stack">
            <MetricTrellis Series="Windowed"
                           Label="@($"Score by repository, last {_weeks} weeks")"
                           SharedMax="MetricScoring.MaxScore"
                           FormatValue="MetricFormat.Score"
                           Highlight="@_subject"
                           TestId="trellis-score" />

            <p class="sb-state">
                SharedMax is pinned to 100 above, because a score is out of 100 whatever
                window it is read over. Below it is left to the data, which is what to do
                for an unbounded measure like tokens — note how the shapes change and
                nothing else does:
            </p>

            <MetricTrellis Series="Windowed"
                           Label="Same data, scale taken from the data"
                           FormatValue="MetricFormat.Score"
                           TestId="trellis-auto" />
        </div>
    </Story>

    <Story Name="MetricHeatmap — repositories against periods"
           Description="The chart that scales when a trellis stops fitting: twenty repositories over twenty-six weeks is five hundred cells here, or twenty unreadably narrow panels there. Each cell is one of four ramp steps, so a shade is a bucket rather than a reading."
           Code="@HeatmapCode">
        <MetricHeatmap Series="Windowed"
                       Label="@($"Score by repository and week, last {_weeks} weeks")"
                       SharedMax="MetricScoring.MaxScore"
                       FormatValue="MetricFormat.Score"
                       TestId="heatmap-score" />
    </Story>

    <Story Name="MetricHeatmap — a cell that carries more than its shade"
           Description="One grid, one shade, and a second measure the shade has no room for. CellDetail adds a sentence to a cell, keyed on the row name and the column label the grid already matches on.

It reaches the title and the visually-hidden text both, for the reason the figure itself reaches both: a shade is one of four buckets, so anything a reader is meant to take off a cell has to be readable rather than only hoverable. A grid whose extra measure lived in a tooltip alone would be a grid a screen reader could not read."
           Code="@HeatmapDetailCode">
        <MetricHeatmap Series="Windowed"
                       Label="@($"Score by repository and week, last {_weeks} weeks — with the week's hours beside each score")"
                       SharedMax="MetricScoring.MaxScore"
                       FormatValue="MetricFormat.Score"
                       CellDetail="@HoursInCell"
                       TestId="heatmap-detail" />
    </Story>

    <Story Name="MetricHeatmap — figures in the cells, and a column for the row"
           Description="The dense case is a ramp and nothing else: twenty-six columns of small marks, where a printed figure would be too small to read and would still take the space. This is the other case — few enough columns, and readings that are small whole numbers — where the shade answers which cells and the digit answers how many, with no pointer.

RowTotal adds a column after the grid. The figure in it is always the caller's: a grid cannot know whether its rows are summable, and peaks are not. Here the total counts something the row cannot be added into at all, which is why the column is headed."
           Code="@HeatmapTotalCode">
        <MetricHeatmap Series="Windowed"
                       Label="@($"Score by repository and week, last {_weeks} weeks — with each week's figure and a column for the repository")"
                       SharedMax="MetricScoring.MaxScore"
                       FormatValue="MetricFormat.Score"
                       ShowValues="true"
                       RowTotals="@BestWeekTotals"
                       TestId="heatmap-totals" />
    </Story>

    <Story Name="MetricHeatmap — a second channel that is not a second ramp"
           Description="CellMarked answers whether a cell is in or out, where the shade answers how much of it there was — working hours on a day-and-hour grid, a release window, a period under maintenance. It is drawn as an edge rather than a fill, because a second fill would read as a second reading and this palette has one saturated hue to spend.

It will not draw without MarkedLabel, and the pairing is the point: the label goes into the cell's title and its hidden text, so the distinction reaches a screen reader too. A mark a sighted reader can act on and nobody else can hear is a distinction the grid makes and then refuses to say."
           Code="@HeatmapMarkedCode">
        <MetricHeatmap Series="Windowed"
                       Label="@($"Score by repository and week, last {_weeks} weeks — the last four weeks outlined")"
                       SharedMax="MetricScoring.MaxScore"
                       FormatValue="MetricFormat.Score"
                       CellMarked="@RecentWeek"
                       MarkedLabel="in the current quarter"
                       TestId="heatmap-marked" />
    </Story>

    <Story Name="MetricSpotlight — one series against the pack"
           Description="Every repository on one plot, the subject in the brand hue and the rest muted. It answers whether the subject sits above or below the pack.

The muted lines are not anonymous: each wears a stroke pattern that its legend swatch repeats, so a row in the legend points at a line. That is a second channel rather than a second colour, so the one-hue rule below is untouched."
           Code="@SpotlightCode">
        <MetricSpotlight Series="Windowed"
                         Selected="@_subject"
                         Label="@($"Score over the last {_weeks} weeks — {_subject} against the rest")"
                         NameHeading="Repository"
                         SharedMax="MetricScoring.MaxScore"
                         FormatValue="MetricFormat.Score"
                         TestId="spotlight-score" />
    </Story>

    <Story Name="MetricSpotlight with no subject — the estate"
           Description="Leave `Selected` unset and nothing is the subject: no brand hue, no heavy stroke, just the shape of the whole estate. This is the reading the patterns were added for — with every line the same grey it was a picture you could look at and not read.

Patterns run to five and then repeat, so the sixth repository draws like the first. Past five lines the answer is a trellis, and it stays the answer whenever someone needs an actual figure off a line between its endpoints: a pattern names a line, it does not label one.

Below, the same data with `DistinguishSeries` off — which is what this chart used to be."
           Code="@SpotlightEstateCode">
        <div class="sb-stack">
            <MetricSpotlight Series="Windowed"
                             Label="@($"Score across the estate, last {_weeks} weeks")"
                             NameHeading="Repository"
                             SharedMax="MetricScoring.MaxScore"
                             FormatValue="MetricFormat.Score"
                             TestId="spotlight-estate" />

            <MetricSpotlight Series="Windowed"
                             DistinguishSeries="false"
                             Label="The same weeks with distinction off — the legend still names them, and still points at nothing"
                             NameHeading="Repository"
                             SharedMax="MetricScoring.MaxScore"
                             FormatValue="MetricFormat.Score"
                             Height="8rem"
                             TestId="spotlight-undistinguished" />
        </div>
    </Story>

    <Story Name="MetricStackedArea — where the time went"
           Description="What share of each bucket a project took. The chart normalises, so the caller passes raw hours and the arithmetic cannot drift out of step with the picture.

Bands are named in place rather than only in a legend, which is what tells two bands sharing a shade apart."
           Code="@StackedCode">
        <MetricStackedArea Series="ProductivityFixtures.TimeByRepository"
                           Label="Share of logged time by repository"
                           NameHeading="Repository"
                           FormatTotal="ProductivityFixtures.Hours"
                           TestId="stacked-time" />
    </Story>

    <Story Name="What a hundred-percent chart cannot tell you"
           Description="Its one lie, and the reason `ShowTotals` is on by default: a hundred percent of a 38-hour week and of a 6-hour week are the same height, so composition alone cannot say whether the work grew or collapsed.

Turn the totals off — as below — and the two charts are indistinguishable."
           Code="@StackedTotalsCode">
        <div class="sb-stack">
            <MetricStackedArea Series="ProductivityFixtures.TimeByRepository"
                               Label="The same weeks with the totals hidden — no way to tell a full week from a quiet one"
                               NameHeading="Repository"
                               ShowTotals="false"
                               Height="8rem"
                               TestId="stacked-no-totals" />

            <MetricBars Points="HoursPerWeek"
                        Label="Hours logged per week — the figure the chart above cannot carry"
                        BucketHeading="Week"
                        ValueHeading="Hours"
                        FormatValue="ProductivityFixtures.Hours"
                        Height="6rem"
                        TestId="stacked-volume" />
        </div>
    </Story>

    <Story Name="MetricStackedArea with one project as the subject"
           Description="Selecting a band mutes the others to the track shade and leaves the stack in place. It does not reorder: a stack whose bands move between renders is not the same chart."
           Code="@StackedSelectedCode">
        <MetricStackedArea Series="ProductivityFixtures.TimeByRepository"
                           Selected="@_subject"
                           Label="@($"Share of logged time — {_subject} against the rest")"
                           NameHeading="Repository"
                           FormatTotal="ProductivityFixtures.Hours"
                           TestId="stacked-selected" />
    </Story>

    <Story Name="Which of these to use"
           Description="All four are in the library because they answer different questions. The wrong one is not merely less pretty — it cannot express the thing being asked.">
        <div class="sb-table-scroll">
            <table class="sb-table">
                <thead>
                    <tr>
                        <th scope="col">Component</th>
                        <th scope="col">Answers</th>
                        <th scope="col">Stops working when</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Guidance)
                    {
                        <tr>
                            <td><code>@row.Component</code></td>
                            <td>@row.Answers</td>
                            <td>@row.Breaks</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Story>

    <Story Name="The estate as one line"
           Code="@EstateCode"
           Description="The mean score across whichever repositories reported that week — not a sum, because a score is already normalised. Worth having as the one figure a weekly summary can carry, and worth distrusting: a mean hides the repository that fell off a cliff.">
        <MetricGrid Label="Estate score">
            <MetricTile Label="Estate score, this week"
                        Value="@MetricFormat.Score(ProductivityFixtures.EstateScore[^1].Value)"
                        Unit="@($"/ {MetricFormat.Score(MetricScoring.MaxScore)}")"
                        Emphasis="true"
                        Footnote="Mean across the repositories that reported."
                        TestId="estate-tile">
                <Trend>
                    <MetricSparkline Points="ProductivityFixtures.EstateScore"
                                     Max="MetricScoring.MaxScore"
                                     Description="Estate score over twelve weeks, flat within a few points." />
                </Trend>
            </MetricTile>
        </MetricGrid>

        <MetricBars Points="ProductivityFixtures.EstateScore"
                    Label="Estate score per week"
                    BucketHeading="Week"
                    ValueHeading="Score"
                    FormatValue="MetricFormat.Score"
                    HighlightLast="true"
                    TestId="estate-bars" />
    </Story>

</StoryPage>

@code {
    private static readonly DesignGuideline[] Rules =
    [
        new("color-scheme.md#chart-roles", "The one hue these comparisons are allowed to vary."),
        new("typography-and-layout.md#layout-grid-and-breakpoints", "How small multiples are laid out as the pane narrows."),
        new("accessibility.md#contrast", "The ratio a heatmap cell and a stacked band have to clear.")
    ];

    private int _weeks = 12;
    private string _subject = ProductivityFixtures.Subject;

    private IReadOnlyList<MetricSeries> Windowed =>
        ProductivityFixtures.Window(ProductivityFixtures.ByRepository, _weeks);

    /// <summary>
    /// A second measure for the cell the shade has no room for. Derived from the score
    /// rather than invented separately, so the story shows a cell saying two things
    /// about one week rather than two unrelated numbers that happen to share a cell.
    /// </summary>
    /// <summary>
    /// The last four bucket labels, so the mark falls on a contiguous band at the right
    /// of the grid — the shape a working-day or release-window mark actually takes, rather
    /// than a scatter that would demonstrate the parameter without demonstrating the idea.
    /// </summary>
    private Func<string, string, bool> RecentWeek => (_, week) =>
        Windowed.FirstOrDefault() is { Points.Count: > 0 } first
        && first.Points.Skip(Math.Max(0, first.Points.Count - 4)).Any(point => point.Label == week);

    /// <summary>
    /// A row figure the row cannot be added into: the best week a repository had, which is
    /// a maximum and not a sum. Deliberately that rather than an average, because it shows
    /// the column doing the thing the component refuses to do for a caller — decide what a
    /// row of readings adds up to.
    /// </summary>
    private IReadOnlyList<MetricTotal> BestWeekTotals =>
    [
        new("Best", repository => Of(repository) is { } found
            ? MetricFormat.Score(found.Points.Max(point => point.Value))
            : null),
        new("Worst", repository => Of(repository) is { } found
            ? MetricFormat.Score(found.Points.Min(point => point.Value))
            : null)
    ];

    private MetricSeries? Of(string repository) =>
        Windowed.FirstOrDefault(series => series.Name == repository) is { Points.Count: > 0 } found
            ? found
            : null;

    private Func<string, string, string?> HoursInCell => (repository, week) =>
        Windowed
            .FirstOrDefault(series => series.Name == repository)?
            .Points.FirstOrDefault(point => point.Label == week) is { } point
            ? $"{point.Value / 4m:0.#} hours that week"
            : null;

    /// <summary>One score in each band, to show all four shades at once.</summary>
    private static readonly decimal[] BandSamples = [22m, 48m, 66m, 88m];

    private sealed record Advice(string Component, string Answers, string Breaks);

    private static readonly IReadOnlyList<Advice> Guidance =
    [
        new("MetricTrellis",
            "How did each repository move? Read any one of them off its own panel.",
            "Past roughly a dozen repositories the panels are too narrow to read. Go to a heatmap."),
        new("MetricHeatmap",
            "Which repository dipped, and in which week? Scales to dozens of rows and dozens of columns.",
            "You need the actual figure at a glance — a shade is one of four buckets, not a reading."),
        new("MetricSpotlight",
            "Is this repository above or below the pack? A pattern and its legend swatch say which line is which.",
            "You need a figure off a line that is not the subject, somewhere between its endpoints — the legend prints the latest reading and nothing in between. Go to a trellis."),
        new("MetricSparkline in a MetricTile",
            "Which way is this one number going? Context beside a figure already printed.",
            "There is more than one series, or the reader needs to take a figure off it."),
        new("A multi-series line chart",
            "Nothing — it is not available here.",
            "Immediately — it is not in the library. Use a trellis, a heatmap, or a spotlight."),
        new("MetricStackedArea",
            "What share of my time went where, week by week? Always adds to 100%.",
            "You need to know whether the work grew or shrank — a full week and a quiet one are the same height. Read the bucket totals, or a column chart beside it."),
        new("A slope or dumbbell chart",
            "Who improved most between two dates? Not built — noted as the obvious next one.",
            "Two points per repository is all it shows; anything in between is invisible.")
    ];

    /// <summary>The timesheet collapsed to one figure per week — the volume a
    /// hundred-percent chart throws away.</summary>
    private static readonly IReadOnlyList<MetricPoint> HoursPerWeek =
    [
        .. ProductivityFixtures.Buckets.Select((week, index) => new MetricPoint(
            week,
            ProductivityFixtures.TimeByRepository.Sum(series => series.Points[index].Value)))
    ];

    private const string StackedCode = """
        @* Raw hours in, shares out: the chart normalises, so the percentages cannot
           drift out of step with the numbers behind them. *@
        <MetricStackedArea Series="timeByRepository"
                           Label="Share of logged time by repository"
                           NameHeading="Repository"
                           FormatTotal="hours => $"{hours:0.#}h"" />
        """;

    private const string StackedTotalsCode = """
        @* ShowTotals is on by default and this is why: without it, a 38-hour week and
           a 6-hour week draw identically. *@
        <MetricStackedArea Series="timeByRepository" ShowTotals="false" Height="8rem" />
        """;

    private const string StackedSelectedCode = """
        @* Mutes the others and leaves the stack order alone. *@
        <MetricStackedArea Series="timeByRepository"
                           Selected="backlog-ide"
                           NameHeading="Repository" />
        """;

    private const string ScoreCode = """
        @* The inputs are the component. A bare number is a claim nobody can check. *@
        <MetricScore Label="Productivity score — backlog-ide"
                     Components="@(new MetricScoreComponent[]
                     {
                         new("Pull requests merged", 14m, Max: 18m, Weight: 3m),
                         new("Issues closed", 21m, Max: 30m, Weight: 2m),
                         new("Review turnaround under a day", 17m, Max: 22m, Weight: 2m),
                         new("Builds green on first run", 38m, Max: 52m, Weight: 1m)
                     })"
                     Bands="@(new MetricBand[]
                     {
                         new("Struggling", 0m), new("Finding its feet", 40m),
                         new("Steady", 60m), new("Strong", 78m)
                     })"
                     Delta="scoreDelta" />
        """;

    private const string ScoreStatesCode = """
        @* Value without Components: a score from a service that did not return its
           working. Legitimate, and the component says so on screen. *@
        <MetricScore Label="Arrived without its inputs" Value="68.4m" Bands="bands" />
        """;

    private const string TrellisCode = """
        @* SharedMax pinned to 100 because a score is out of 100 whatever window it
           is read over. Leave it null for an unbounded measure and the largest
           reading sets the scale for every panel. *@
        <MetricTrellis Series="byRepository"
                       Label="Score by repository, last 12 weeks"
                       SharedMax="MetricScoring.MaxScore"
                       Highlight="backlog-ide" />
        """;

    private const string HeatmapCode = """
        <MetricHeatmap Series="byRepository"
                       Label="Score by repository and week"
                       SharedMax="MetricScoring.MaxScore" />
        """;

    private const string HeatmapDetailCode = """
        <MetricHeatmap Series="byRepository"
                       Label="Score by repository and week"
                       SharedMax="MetricScoring.MaxScore"
                       CellDetail="@((repository, week) => Hours(repository, week) is { } hours
                           ? $"{hours:0.#} hours that week"
                           : null)" />
        """;

    private const string HeatmapMarkedCode = """
        <MetricHeatmap Series="byRepository"
                       Label="Score by repository and week"
                       SharedMax="MetricScoring.MaxScore"
                       CellMarked="@((repository, week) => IsCurrentQuarter(week))"
                       MarkedLabel="in the current quarter" />
        """;

    private const string HeatmapTotalCode = """
        <MetricHeatmap Series="byRepository"
                       Label="Score by repository and week"
                       SharedMax="MetricScoring.MaxScore"
                       ShowValues="true"
                       RowTotals="@(new MetricTotal[]
                       {
                           new("Best", repository => Best(repository)),
                           new("Worst", repository => Worst(repository))
                       })" />
        """;

    private const string SpotlightCode = """
        <MetricSpotlight Series="byRepository"
                         Selected="backlog-ide"
                         Label="Score over the last 12 weeks — backlog-ide against the rest"
                         NameHeading="Repository"
                         SharedMax="MetricScoring.MaxScore"
                         FormatValue="MetricFormat.Score" />
        """;

    private const string SpotlightEstateCode = """
        @* No Selected: nothing is the subject, and every line is told apart by its
           own stroke pattern instead. *@
        <MetricSpotlight Series="byRepository"
                         Label="Score across the estate, last 12 weeks"
                         NameHeading="Repository"
                         SharedMax="MetricScoring.MaxScore"
                         FormatValue="MetricFormat.Score" />

        @* What it was before: one unbroken stroke on every context line. *@
        <MetricSpotlight Series="byRepository"
                         DistinguishSeries="false"
                         Label="The same weeks with distinction off"
                         NameHeading="Repository"
                         SharedMax="MetricScoring.MaxScore"
                         FormatValue="MetricFormat.Score"
                         Height="8rem" />
        """;

    private const string ControlsCode = """
        @* PressedChanged, not the pressed state itself: the strip is one-of-many, so the
           page owns the selection and the button only announces the press. *@
        <ButtonGroup AriaLabel="Score window">
            @foreach (var window in ProductivityFixtures.Windows)
            {
                <ToggleButton Pressed="_weeks == window.Weeks"
                              PressedChanged="_ => _weeks = window.Weeks">
                    @window.Label
                </ToggleButton>
            }
        </ButtonGroup>
        """;

    private const string EstateCode = """
        <MetricGrid Label="Estate score">
            <MetricTile Label="Estate score, this week"
                        Value="@MetricFormat.Score(score)"
                        Unit="@($"/ {MetricFormat.Score(MetricScoring.MaxScore)}")"
                        Emphasis="true"
                        Footnote="Mean across the repositories that reported.">
                <Trend>
                    <MetricSparkline Points="@weekly"
                                     Max="MetricScoring.MaxScore"
                                     Description="Estate score over twelve weeks." />
                </Trend>
            </MetricTile>
        </MetricGrid>
        """;
}
