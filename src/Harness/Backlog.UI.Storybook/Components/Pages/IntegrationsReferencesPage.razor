@page "/integrations/references"

<PageTitle>Integration references — Backlog UI Storybook</PageTitle>

<StoryPage Title="References"
           Summary="A reference to something that lives outside the product: a pull request, an issue, a Copilot or Claude session — every one of them marked, because everything on this page is by definition outside. What state it is in, whether that state disagrees with what the product believes, when the state was last read, and what happens when there are none, one, or eleven of them across four repositories.">

    <Story Name="A reference renders what the host can do with it"
           Description="Given a URL it is an anchor; given a callback it is a button; given neither it is inert text. This is KnowledgeReferenceLink's tri-state, copied rather than re-derived, and the argument is the same one recorded there: an anchor can be middle-clicked, copied and opened in a new window, a button cannot, and a reference nobody can follow should not invite a click or take a tab stop to refuse one.

It matters more here than it did there, because sessions genuinely differ. A pull request has a URL. A Copilot CLI session is a local process — the launcher starts one with no addressable id, so there is nothing to put in an href — and it arrives as a callback and renders as a button. Inventing a fourth renderer for that case is precisely the drift this family is against, so it does not get one.

A URL wins over a callback when both are given. A link already navigates, and two ways to reach one place is one too many; the callback is what a host falls back to when there is no place to link to."
           Code="@ShapesCode">
        <div class="sb-stack" data-testid="references-shapes">
            <dl class="sb-grid sb-grid--addresses">
                <div class="sb-stack">
                    <dt class="sb-label">Url — an anchor</dt>
                    <dd class="sb-stack">
                        <IntegrationLink Link="@IntegrationFixtures.PullRequest"
                                         ShowRepository="true"
                                         TestId="references-shape-anchor" />
                        <p class="sb-state">a.integration-link--link, target="_blank" rel="noopener".</p>
                    </dd>
                </div>
                <div class="sb-stack">
                    <dt class="sb-label">OnOpen only — a button</dt>
                    <dd class="sb-stack">
                        <IntegrationLink Link="@WithoutUrl"
                                         OnOpen="Open"
                                         ShowRepository="true"
                                         TestId="references-shape-button" />
                        <p class="sb-state">button.integration-link--action — the host routes it, in process.</p>
                    </dd>
                </div>
                <div class="sb-stack">
                    <dt class="sb-label">Neither — inert text</dt>
                    <dd class="sb-stack">
                        <IntegrationLink Link="@WithoutUrl"
                                         ShowRepository="true"
                                         TestId="references-shape-inert" />
                        <p class="sb-state">span.integration-link--inert — no tab stop, no offer.</p>
                    </dd>
                </div>
                <div class="sb-stack">
                    <dt class="sb-label">A real Copilot CLI session — no URL to give</dt>
                    <dd class="sb-stack">
                        <IntegrationLink Link="@IntegrationFixtures.CopilotSession"
                                         OnOpen="Open"
                                         TestId="references-shape-session" />
                        <p class="sb-state">The button shape, and not by choice: a local process has no address.</p>
                    </dd>
                </div>
            </dl>
            <p class="sb-state" data-testid="references-open-echo">@_openEcho</p>
        </div>
    </Story>

    <Story Name="Five artifact states, and the glyph changes with the kind"
           Description="Open, Draft, Merged, Closed, Not checked. Merged is kept apart from Closed because for a pull request they mean opposite things — the same distinction the product's own GitHub vocabulary already draws — and Not checked is a real state rather than a null, because we have not looked and it is closed are different facts and a reader is entitled to know which they are seeing.

The icon is chosen from the kind as well as the state: an open issue is a circle with a dot, an open pull request is two branches meeting. At Compact density where the label is gone, that difference is the only thing separating them.

Which is why the icon-only form is not merely the labelled one with the text removed. The label moves to the title and into a visually hidden span inside the chip, so the accessible name is unchanged and a screen reader still hears Open rather than a class name. Colour is never a sole carrier here either: every chip is icon plus text plus colour, and the compact form keeps two of the three where they can still be read.

The chip is a component rather than a convention because that is what makes the triple unmissable. It takes an enum, so the slug, the icon and the label cannot be mismatched — which is exactly the failure mode of the hand-rolled badge classes it replaces, where the class and the word were two separate decisions."
           Code="@ArtifactCode">
        <div class="sb-stack" data-testid="references-artifact-states">
            <table class="sb-table">
                <thead>
                    <tr>
                        <th scope="col">State</th>
                        <th scope="col">Issue</th>
                        <th scope="col">Pull request</th>
                        <th scope="col">Icon only</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var state in ArtifactStates)
                    {
                        <tr>
                            <th scope="row">@state</th>
                            <td>
                                <IntegrationStateChip Artifact="@state"
                                                      Kind="IntegrationLinkKind.Issue"
                                                      TestId="@($"references-artifact-issue-{state.ToString().ToLowerInvariant()}")" />
                            </td>
                            <td>
                                <IntegrationStateChip Artifact="@state"
                                                      Kind="IntegrationLinkKind.PullRequest"
                                                      TestId="@($"references-artifact-pr-{state.ToString().ToLowerInvariant()}")" />
                            </td>
                            <td>
                                <IntegrationStateChip Artifact="@state"
                                                      Kind="IntegrationLinkKind.PullRequest"
                                                      IconOnly="true"
                                                      TestId="@($"references-artifact-compact-{state.ToString().ToLowerInvariant()}")"
                                                      LabelTestId="@($"references-artifact-compact-{state.ToString().ToLowerInvariant()}-label")" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="sb-state">
                The icon-only column still carries its word: the chip's title reads the label and the
                state sentence together, and the label itself goes into an sr-only span, so the
                accessible name is the same one the labelled chip has.
            </p>
        </div>
    </Story>

    <Story Name="Seven session states, and why Waiting is not Stalled"
           Description="Both look like nothing happening. One is correct — the session asked a question and is waiting for an answer — and the other is the thing the monitoring rules raise an alert on. Collapsing them into one idle would make the alert unexplainable: the reader would see the badge that fired the notification sitting on a session that is behaving perfectly.

Stalled is one of only two filled chips in this family. The fill rule is worth stating once because it is the whole reason the colour survives review: a chip is filled when the product acts on it. A stalled session raises a monitoring signal and a failed one wants a retry; every other state is information, and information is outlined so that a row carrying four of them is readable.

Nothing here decides that a session is stalled. A threshold is a policy and a policy needs a clock, and this library has neither — no timer, no clock, no elapsed time anywhere in it. The host computes it and passes the member in, which is recorded on the enum member itself so that nobody adds a timer here later. The same reasoning is why a succeeded action's status line does not clear itself and why nothing polls for freshness."
           Code="@SessionCode">
        <div class="sb-stack" data-testid="references-session-states">
            @foreach (var state in SessionStates)
            {
                <div class="sb-row">
                    <IntegrationStateChip Session="@state"
                                          TestId="@($"references-session-{state.ToString().ToLowerInvariant()}")" />
                    <span class="sb-state">@SessionNotes[state]</span>
                </div>
            }
        </div>
    </Story>

    <Story Name="Two providers, two marks, one shape"
           Description="Claude and GitHub Copilot sessions are the same record with a different Provider. That is the requirement stated as an API: if they were two components they would drift, and the point of this page is that they cannot.

Where one of these comes from is worth saying, because it is the other half of a rule stated on Actions. A session is what a hand-off turns into: somebody pressed Send to Claude in Desktop, a section left this application, and what came back is this row — a thing running somewhere else that has to be found again. The act was marked and the reference is marked, and both for the same reason. The in-app AI acts have no counterpart here at all, which is the cleanest proof the rule is about crossing rather than about AI: Rewrite part with AI produces a card in the document and nothing on this page.

The mark is doing real work here rather than decorating. Below Toolbar density the title goes and the state chip shrinks, so on a list row the provider mark is the only thing separating a Claude session from a Copilot one — which is why the marks are the providers' own rather than three interchangeable circles.

The second row is the same two references in different states, which is the other half of the claim: one record shape, two providers, seven states, and no combination that needs a component of its own."
           Code="@ProvidersCode">
        <div class="sb-stack" data-testid="references-providers">
            <div class="sb-stack">
                <p class="sb-label">The same state, two providers</p>
                <IntegrationLink Link="@IntegrationFixtures.CopilotSession"
                                 OnOpen="Open"
                                 TestId="references-provider-copilot" />
                <IntegrationLink Link="@IntegrationFixtures.ClaudeSession"
                                 OnOpen="Open"
                                 TestId="references-provider-claude" />
            </div>
            <div class="sb-stack">
                <p class="sb-label">Different states, still one shape</p>
                <IntegrationLink Link="@WaitingCopilotSession"
                                 OnOpen="Open"
                                 TestId="references-provider-copilot-waiting" />
                <IntegrationLink Link="@FinishedClaudeSession"
                                 OnOpen="Open"
                                 TestId="references-provider-claude-finished" />
            </div>
            <div class="sb-stack">
                <p class="sb-label">Compact — the title is gone and the mark is the difference</p>
                <IntegrationLink Link="@IntegrationFixtures.CopilotSession"
                                 OnOpen="Open"
                                 Density="IntegrationDensity.Compact"
                                 TestId="references-provider-copilot-compact" />
                <IntegrationLink Link="@IntegrationFixtures.ClaudeSession"
                                 OnOpen="Open"
                                 Density="IntegrationDensity.Compact"
                                 TestId="references-provider-claude-compact" />
            </div>
        </div>
    </Story>

    <Story Name="Drift is a second chip, not a different colour on the first"
           Description="This entry is done but the issue is still open is not a state of the issue. The issue is open, and that is correct; what is wrong is the pair. Painting the artifact chip a warning colour would say the issue is in a bad state, which is false, and would leave nowhere to show what the issue's actual state is.

So drift renders as a second chip beside the first, with its own icon and its own short label — Still open, Already closed, Missing. Three labels rather than one, because the reader's next move differs in each case and three synonyms would make them look interchangeable.

The row with no drift is the control. Nothing renders for None — no empty element, no reserved space — so the appearance and disappearance of the second chip is the whole visible difference between a reference that agrees with local truth and one that does not."
           Code="@DriftCode">
        <div class="sb-stack" data-testid="references-drift">
            @foreach (var drift in Drifts)
            {
                <div class="sb-stack">
                    <p class="sb-label">@drift</p>
                    <IntegrationLink Link="@DriftedIssueWith(drift)"
                                     ShowRepository="true"
                                     TestId="@($"references-drift-{drift.ToString().ToLowerInvariant()}")"
                                     StateTestId="@($"references-drift-{drift.ToString().ToLowerInvariant()}-state")"
                                     DriftTestId="@($"references-drift-{drift.ToString().ToLowerInvariant()}-chip")" />
                </div>
            }
        </div>
    </Story>

    <Story Name="Zero, one, many"
           Description="Zero is the case worth building for, because an entry that has never been projected is the common one, and an empty region that renders nothing tells the reader the feature does not exist. IntegrationLinkList renders the existing EmptyState with the create action in its slot, so nothing is linked and here is how to link something are the same block.

One is the case that has no heading, because a heading over the only group is a heading over nothing — the next story is that rule on its own. Many is where grouping earns itself.

The empty state's action is an ordinary IntegrationActionBar in the slot rather than a second kind of button, so an unavailable GitHub reads exactly the same there as it does on a full panel: the act is present, disabled, and carrying its reason. A host that dropped the button when there was nothing to show would produce the one thing this family is against — a reader who concludes the product cannot create issues at all."
           Code="@ZeroOneManyCode">
        <div class="sb-stack" data-testid="references-counts">
            <div class="sb-stack">
                <p class="sb-label">Zero</p>
                <IntegrationLinkList Links="@NoLinks"
                                     OnOpen="Open"
                                     TestId="references-count-zero"
                                     EmptyTestId="references-count-zero-empty">
                    <EmptyActions>
                        <IntegrationActionBar Actions="@CreateOnly"
                                              Density="IntegrationDensity.Inline"
                                              AriaLabel="Link this entry"
                                              OnInvoke="Invoke"
                                              ActionTestIdPrefix="references-count-zero-action" />
                    </EmptyActions>
                </IntegrationLinkList>
            </div>
            <div class="sb-stack">
                <p class="sb-label">One</p>
                <IntegrationLinkList Links="@IntegrationFixtures.OneLink"
                                     OnOpen="Open"
                                     TestId="references-count-one" />
            </div>
            <div class="sb-stack">
                <p class="sb-label">Eleven, across four repositories and one that is in none</p>
                <IntegrationLinkList Links="@IntegrationFixtures.ManyLinks"
                                     OnOpen="Open"
                                     TestId="references-count-many"
                                     GroupTestIdPrefix="references-count-many-group" />
            </div>
        </div>
    </Story>

    <Story Name="A repository heading only when there is more than one repository"
           Description="An entry can project into several repositories, so grouping is necessary; a heading over the only group is a heading over nothing. The rule is that plain.

Links with no repository sort last under their own heading rather than being dropped, on the same principle MarkdownView uses for orphaned comments: a stray is better than a loss. A session started from a scratch folder belongs to no repository and is still a session somebody is running.

The three lists below are the same rule from three sides. Grouping off is the flat list a host asks for when its surface already says which repository it is about; grouping on with four repositories is the heading doing its job; grouping on with one repository is the heading suppressed, which is the same parameter producing no headings because there is nothing for them to distinguish."
           Code="@GroupingCode">
        <div class="sb-stack" data-testid="references-grouping">
            <div class="sb-stack">
                <p class="sb-label">Four repositories, grouped</p>
                <IntegrationLinkList Links="@IntegrationFixtures.ManyLinks"
                                     GroupByRepository="true"
                                     OnOpen="Open"
                                     TestId="references-grouped"
                                     GroupTestIdPrefix="references-grouped-group" />
            </div>
            <div class="sb-stack">
                <p class="sb-label">The same eleven, ungrouped</p>
                <IntegrationLinkList Links="@IntegrationFixtures.ManyLinks"
                                     GroupByRepository="false"
                                     OnOpen="Open"
                                     TestId="references-ungrouped" />
            </div>
            <div class="sb-stack">
                <p class="sb-label">One repository, grouping on — the heading is suppressed</p>
                <IntegrationLinkList Links="@IntegrationFixtures.OneRepository"
                                     GroupByRepository="true"
                                     OnOpen="Open"
                                     TestId="references-single-repository"
                                     GroupTestIdPrefix="references-single-repository-group" />
            </div>
        </div>
    </Story>

    <Story Name="As of, and a button that asks"
           Description="State is read on demand and never polled. The backlog features give the reason in one line — reading GitHub state is a deliberate act rather than a background poll, because the backlog has to open instantly and offline — and the consequence for this component is that a state without a time on it is a claim it cannot support. So the freshness line is not decoration; it is the disclaimer that makes the chips honest.

Refresh is an explicit button for the same reason. There is no auto-refresh interval to configure because there is no interval, and there is no clock in the library to run one against — AsOf arrives already formatted, because what four minutes ago is, and in what language, belongs to the host.

Without a delegate there is no button at all, only the line. That is the never-read case at the bottom: a surface that cannot re-read should not offer to."
           Code="@FreshnessCode">
        <div class="sb-stack" data-testid="references-freshness">
            <div class="sb-stack">
                <p class="sb-label">Read, with a way to read again</p>
                <IntegrationFreshness Reading="@_reading"
                                      OnRefresh="Reread"
                                      TestId="references-freshness-read"
                                      TextTestId="references-freshness-read-text"
                                      RefreshTestId="references-freshness-read-button" />
            </div>
            <div class="sb-stack">
                <p class="sb-label">A read in flight</p>
                <IntegrationFreshness Reading="@IntegrationFixtures.Reading"
                                      OnRefresh="Reread"
                                      TestId="references-freshness-inflight" />
            </div>
            <div class="sb-stack">
                <p class="sb-label">Never read, and nothing to read it with</p>
                <IntegrationFreshness Reading="@IntegrationReading.Never"
                                      TestId="references-freshness-never" />
            </div>
            <div class="sb-stack">
                <p class="sb-label">On a list, where it usually lives</p>
                <IntegrationLinkList Links="@IntegrationFixtures.OneRepository"
                                     Reading="@_reading"
                                     OnRefresh="Reread"
                                     OnOpen="Open"
                                     TestId="references-freshness-list"
                                     FreshnessTestId="references-freshness-list-line" />
            </div>
        </div>
    </Story>

    <Story Name="A read that failed is still a status"
           Description="When a refresh cannot reach GitHub the line says so and stays a status region. It does not escalate, it does not clear the chips, and it does not open anything. The chips keep their last-known values and the line keeps its old timestamp alongside the failure, because we could not check does not make what we knew untrue.

That is the same rule the availability page states for offline, applied to the one case where it is tempting to break it. A failed read looks like an error and is not one: nothing the reader did failed, nothing is in an inconsistent state, and the product is still showing the truth as of the last time it could see it.

Blanking the chips would be the alternative, and it is worse in the specific way this family cares about — it would replace known information with nothing, and the reader would have no way to tell a pull request that was closed from one the product simply could not look at."
           Code="@FailedReadCode">
        <div class="sb-stack" data-testid="references-failed-read">
            <IntegrationLinkList Links="@IntegrationFixtures.OneRepository"
                                 Reading="@IntegrationFixtures.ReadFailed"
                                 OnRefresh="Reread"
                                 OnOpen="Open"
                                 TestId="references-failed-list"
                                 FreshnessTestId="references-failed-line" />
            <p class="sb-state">
                role="status", not role="alert" — and every chip above still shows what the last successful read found.
            </p>
        </div>
    </Story>

    <Story Name="A cue for leaving the app — not yet"
           Description="Every anchor here carries target blank and rel noopener, so following one leaves the product, and nothing visible says so before the click. An external-destination cue — a trailing glyph, and the destination host on the accessible name — is not built.

It belongs on IntegrationLink and only there, since that is the only component in the family that emits an anchor: a chip has no destination, a session button stays in process, and a freshness line goes nowhere. Putting the cue anywhere else would be putting it where it cannot be true.

The anchor below is the same pull request from the first story on this page, which is where the cue would land. Nothing is drawn for it here on purpose — a story that mocked up the missing glyph would look like the feature exists."
           Code="@ExternalCode">
        <div class="sb-stack" data-testid="references-external">
            <IntegrationLink Link="@IntegrationFixtures.PullRequest"
                             ShowRepository="true"
                             TestId="references-external-anchor" />
            <p class="sb-state">
                a[target="_blank"][rel="noopener"] — correct today, and silent about where it goes.
            </p>
        </div>
    </Story>

</StoryPage>

@code {
    private static readonly IReadOnlyList<IntegrationArtifactState> ArtifactStates =
    [
        IntegrationArtifactState.Open,
        IntegrationArtifactState.Draft,
        IntegrationArtifactState.Merged,
        IntegrationArtifactState.Closed,
        IntegrationArtifactState.Unknown
    ];

    /// <summary>Waiting and Stalled adjacent, because they are the pair that earns
    /// the whole vocabulary and reading them apart is the point.</summary>
    private static readonly IReadOnlyList<IntegrationSessionState> SessionStates =
    [
        IntegrationSessionState.Unknown,
        IntegrationSessionState.Starting,
        IntegrationSessionState.Running,
        IntegrationSessionState.Waiting,
        IntegrationSessionState.Stalled,
        IntegrationSessionState.Finished,
        IntegrationSessionState.Failed
    ];

    private static readonly IReadOnlyDictionary<IntegrationSessionState, string> SessionNotes =
        new Dictionary<IntegrationSessionState, string>
        {
            [IntegrationSessionState.Unknown] = "Nobody has looked. A state, not a null.",
            [IntegrationSessionState.Starting] = "Launched, not reporting yet.",
            [IntegrationSessionState.Running] = "Working now. The arcs are static under reduced motion.",
            [IntegrationSessionState.Waiting] = "Waiting on an answer from you. Correct behaviour.",
            [IntegrationSessionState.Stalled] = "Running, but nothing has moved. Filled, because monitoring acts on it.",
            [IntegrationSessionState.Finished] = "Ended with work delivered.",
            [IntegrationSessionState.Failed] = "Ended without delivering. Filled, because it wants a retry."
        };

    private static readonly IReadOnlyList<IntegrationDrift> Drifts =
    [
        IntegrationDrift.None,
        IntegrationDrift.LocalAhead,
        IntegrationDrift.RemoteAhead,
        IntegrationDrift.Detached
    ];

    /// <summary>The pull request with its URL taken away — the same record, so the
    /// three shapes above are provably one reference rendered three ways.</summary>
    private static readonly IntegrationLinkRef WithoutUrl =
        IntegrationFixtures.PullRequest with { Url = null };

    private static readonly IntegrationLinkRef WaitingCopilotSession =
        IntegrationFixtures.CopilotSession with { SessionState = IntegrationSessionState.Waiting };

    private static readonly IntegrationLinkRef FinishedClaudeSession =
        IntegrationFixtures.ClaudeSession with { SessionState = IntegrationSessionState.Finished };

    private static readonly IReadOnlyList<IntegrationLinkRef> NoLinks = [];

    private static readonly IReadOnlyList<IntegrationActionSpec> CreateOnly =
    [
        IntegrationFixtures.CreateIssue
    ];

    private IntegrationReading _reading = IntegrationFixtures.ReadRecently;

    private string _openEcho = "Nothing opened yet.";

    /// <summary>One issue, four drifts. Built from a single record so the row is
    /// four readings of one reference rather than four references that happen to
    /// look alike.</summary>
    private static IntegrationLinkRef DriftedIssueWith(IntegrationDrift drift) =>
        IntegrationFixtures.DriftedIssue with
        {
            Drift = drift,
            DriftNote = drift switch
            {
                IntegrationDrift.LocalAhead => "This entry was marked done on 12 August; the issue is still open.",
                IntegrationDrift.RemoteAhead => "The issue was closed on 15 August; this entry is not done.",
                IntegrationDrift.Detached => "The projection points at an issue that is no longer there.",
                _ => null
            }
        };

    private void Open(IntegrationLinkRef link) =>
        _openEcho = $"OnOpen raised for {link.Id} — {link.Label}, a {link.Kind} on {link.Provider}.";

    private void Invoke(IntegrationActionSpec spec) =>
        _openEcho = $"OnInvoke raised for {spec.Id} from the empty state.";

    /// <summary>A deliberate read: in flight, then a new reading. Nothing here
    /// polls, and nothing in the library could — it holds no clock.</summary>
    private async Task Reread()
    {
        _reading = _reading with { InFlight = true, FailureReason = null };
        StateHasChanged();

        await Task.Delay(700);

        _reading = new IntegrationReading("just now");
    }

    // --- Code samples ------------------------------------------------------

    private const string ShapesCode = """
        @* Url wins over OnOpen: a link already navigates. Neither is inert text
           rather than a button that would refuse the click it invited. *@
        <IntegrationLink Link="@pullRequest" />                    @* a *@
        <IntegrationLink Link="@session" OnOpen="Open" />          @* button *@
        <IntegrationLink Link="@session" />                        @* span *@
        """;

    private const string ArtifactCode = """
        @* An enum, so the slug, the icon and the label cannot be mismatched.
           Kind selects the glyph where a state has two of them. *@
        <IntegrationStateChip Artifact="IntegrationArtifactState.Open"
                              Kind="IntegrationLinkKind.PullRequest" />

        @* Compact: visually icon-only, with the label on the title and in a
           visually hidden span, so the accessible name is unchanged. *@
        <IntegrationStateChip Artifact="IntegrationArtifactState.Merged" IconOnly="true" />
        """;

    private const string SessionCode = """
        @* Stalled is computed by the host. This library has no timer and no
           clock, so nothing here can advance a session into it. *@
        var state = LastMovement(session) < Threshold
            ? IntegrationSessionState.Running
            : IntegrationSessionState.Stalled;

        <IntegrationStateChip Session="@state" />
        """;

    private const string ProvidersCode = """
        @* One factory, one record, one component. The provider is a parameter,
           which is what stops a Claude session and a Copilot session drifting. *@
        IntegrationLinkRef.Session("session-4a1c", "session 4a1c",
            IntegrationProvider.Copilot, IntegrationSessionState.Running);

        IntegrationLinkRef.Session("session-9f30", "session 9f30",
            IntegrationProvider.Claude, IntegrationSessionState.Running);
        """;

    private const string DriftCode = """
        @* A second chip beside the artifact's own. The artifact's state is still
           correct and still shown; what is wrong is the pair. *@
        IntegrationLinkRef.Issue("issue-128", "#128", IntegrationArtifactState.Open,
            drift: IntegrationDrift.LocalAhead,
            driftNote: "This entry was marked done on 12 August; the issue is still open.");
        """;

    private const string ZeroOneManyCode = """
        @* Zero is the common case, so it gets the EmptyState and the way out —
           nothing linked and here is how to link something, in one block. *@
        <IntegrationLinkList Links="@links" OnOpen="Open">
            <EmptyActions>
                <IntegrationActionBar Actions="@createOnly" Density="IntegrationDensity.Inline" />
            </EmptyActions>
        </IntegrationLinkList>
        """;

    private const string GroupingCode = """
        @* Grouping is on by default and produces no headings until there is more
           than one repository to distinguish. References with no repository sort
           last under their own heading rather than being dropped. *@
        <IntegrationLinkList Links="@links" GroupByRepository="true" />
        """;

    private const string FreshnessCode = """
        @* AsOf arrives already formatted: what "4 minutes ago" is, and in what
           language, belongs to the host. Without OnRefresh there is no button. *@
        <IntegrationFreshness Reading="@(new IntegrationReading("4 minutes ago"))" OnRefresh="Reread" />

        <IntegrationFreshness Reading="@IntegrationReading.Never" />
        """;

    private const string FailedReadCode = """
        @* The failure sits beside the timestamp of the last read that worked.
           The chips are untouched: we could not check does not make what we knew
           untrue. *@
        new IntegrationReading("4 minutes ago", FailureReason: "Could not reach github.com.")
        """;

    private const string ExternalCode = """
        @* What is emitted today. The external-destination cue that would go here
           is not built, and IntegrationLink is the only component that could
           carry one — it is the only one that emits an anchor. *@
        <a class="integration-link integration-link--link" target="_blank" rel="noopener" href="…">
        """;
}
