@page "/integrations"

<PageTitle>Availability and lifecycle — Backlog UI Storybook</PageTitle>

<StoryPage Title="Availability and lifecycle"
           Summary="The substrate under every integration affordance. An act on an external tool is never a bare button: it is a readiness — whether the product can do the thing at all, and if not why — and a lifecycle running from idle to succeeded or failed. Both live on this page because both are the reason the same six acts can look the same on a backlog entry, a knowledge chapter and a roadmap bar. The acts themselves are on Actions; the artifacts they produce are on References.">

    <Alert Message="@AbsorbsNotice" Role="note" CssClass="sb-callout" />

    <Alert Message="@MarkRule" Role="note" CssClass="sb-callout" />

    <Story Name="Nothing here takes a bare Disabled"
           Description="Every other button in this library takes a bool Disabled, and that is why an unavailable integration looks different on every surface that has one: a greyed button says nothing about why, so each host invents its own tooltip, or its own hidden branch, or nothing at all. IntegrationAction has no Disabled parameter. The only way to make one inert is to hand it an IntegrationReadiness, and that record cannot be constructed without a cause.

The rejected alternative was a Disabled plus an optional DisabledReason — which is the same shape with a nicer name, because optional means a host can skip it and every host eventually will. Making the reason the only route is what turns consistency from a habit into a compile-time fact.

The two cells below are the same unavailable act drawn both ways. On the left is what the library allows anywhere else; on the right is the only thing this family can produce. Under each is what a reader gets: nothing, and a sentence that reaches the pointer through title and assistive technology through aria-describedby, because neither route alone reaches everybody."
           Code="@NoDisabledCode">
        <div class="sb-columns" data-testid="integrations-no-disabled">
            <div class="sb-stack">
                <p class="sb-label">AppButton, Disabled — what every other button allows</p>
                <div>
                    <AppButton Disabled="true" TestId="integrations-bare-disabled">Create GitHub issue</AppButton>
                </div>
                <p class="sb-state">No title, no described-by, no reason. A reader is told the product will not, never why.</p>
            </div>
            <div class="sb-stack">
                <p class="sb-label">IntegrationAction, NotAuthorized — the only inert form there is</p>
                <div>
                    <IntegrationAction Action="@NotConnected"
                                       ButtonTestId="integrations-readiness-disabled"
                                       ReasonTestId="integrations-readiness-reason" />
                </div>
                <p class="sb-state">title="GitHub is not connected." and the same sentence on aria-describedby.</p>
            </div>
        </div>
    </Story>

    <Story Name="Four ways to be unavailable, one primitive"
           Description="Not authorized, not installed, offline, and turned off in settings are four unrelated causes with four different remedies, and the temptation is four components. They are one, because from the reader's side they are the same sentence in the same place: this cannot happen right now, here is why, here is what to do about it. Splitting them would put the sentence in four positions and four voices.

The sentences below were not written into these rows. Each row was handed a cause and a subject, and the sentence is derived from the pair — which is what stops an optional reason from going missing the way an optional DisabledReason could. A host that has a better sentence for its surface can still pass one; the point is that it never has to.

Offline is the one with no remedy, and that is deliberate rather than an omission. There is no button a reader can press that puts a network back, and offering one would be the product pretending it can do something it cannot."
           Code="@UnavailableCode">
        <div class="sb-stack" data-testid="integrations-unavailable">
            <IntegrationUnavailable Readiness="@IntegrationFixtures.GitHubNotConnected"
                                    OnRemedy="Remedy"
                                    TestId="integrations-unavailable-auth"
                                    RemedyTestId="integrations-unavailable-auth-remedy" />
            <IntegrationUnavailable Readiness="@IntegrationFixtures.VsCodeNotInstalled"
                                    OnRemedy="Remedy"
                                    TestId="integrations-unavailable-install"
                                    RemedyTestId="integrations-unavailable-install-remedy" />
            <IntegrationUnavailable Readiness="@IntegrationFixtures.Offline"
                                    OnRemedy="Remedy"
                                    TestId="integrations-unavailable-offline" />
            <IntegrationUnavailable Readiness="@IntegrationFixtures.GitHubTurnedOff"
                                    OnRemedy="Remedy"
                                    TestId="integrations-unavailable-off"
                                    RemedyTestId="integrations-unavailable-off-remedy" />
            <p class="sb-state" data-testid="integrations-remedy-echo">@_remedyEcho</p>
        </div>
    </Story>

    <Story Name="Offline is a status, not an alert"
           Description="The alert role interrupts. It is right for a save that failed and wrong for a network that is not there, and the design principles are explicit that offline must be a calm, persistent status rather than an error modal. All four unavailable causes are standing conditions rather than events, so IntegrationUnavailable is a status region in every one of them and never escalates.

The one place in this family that does escalate is an act that was invoked and failed, which is the story below — because that one is an event, and it happened because the reader pressed something. Toast already draws that line between Error and Warning on one side and everything else on the other, so this follows it rather than inventing a second rule.

The freshness line takes the same side. A read that could not reach GitHub is the same class of thing as being offline, so it stays a status too, and that is the References page's ninth story."
           Code="@RolesCode">
        <div class="sb-columns" data-testid="integrations-roles">
            <div class="sb-stack">
                <p class="sb-label">A standing condition</p>
                <IntegrationUnavailable Readiness="@IntegrationFixtures.Offline"
                                        TestId="integrations-roles-offline" />
                <p class="sb-state">p.integration-unavailable, role="status" — announced when a reader gets to it.</p>
            </div>
            <div class="sb-stack">
                <p class="sb-label">An event the reader caused</p>
                <IntegrationAction Action="@FailedHandOff"
                                   OnRetry="Noop"
                                   ButtonTestId="integrations-roles-failed"
                                   StatusTestId="integrations-roles-failed-status"
                                   RetryTestId="integrations-roles-failed-retry" />
                <p class="sb-state">span.integration-action__status, role="alert" — announced immediately.</p>
            </div>
        </div>
    </Story>

    <Story Name="Idle, confirming, running, succeeded, failed"
           Description="Five states of one act, and the reason they are one component rather than a host's five branches. Running is AppButton.Busy unchanged — it already embeds the spinner, sets aria-busy, and disables the button without removing it from the tab order, so focus survives the round trip. Building a second loading button here would have been a second thing to get wrong in a family whose entire point is not having two of anything.

The host owns the state and hands it in; the component advances nothing on its own. That is the same discipline MarkdownView keeps with comments, and for the same reason: the truth is upstream, and a component that guessed at it would eventually disagree with the thing that knows.

One thing worth watching across the row is what does not move. The button is present in all five, including the last two: the state glyph lives on the status line beside it rather than replacing the control, so a reader who has just pressed something finds the pointer target exactly where they left it, whether it worked or not."
           Code="@LifecycleCode">
        <dl class="sb-grid" data-testid="integrations-lifecycle">
            @foreach (var step in Lifecycle)
            {
                <div class="sb-stack">
                    <dt class="sb-label">@step.Name</dt>
                    <dd class="sb-stack">
                        <IntegrationAction Action="@step.Spec"
                                           OnCancel="Noop"
                                           OnRetry="Noop"
                                           ButtonTestId="@($"integrations-lifecycle-{step.Slug}")"
                                           StatusTestId="@($"integrations-lifecycle-{step.Slug}-status")"
                                           CancelTestId="@($"integrations-lifecycle-{step.Slug}-cancel")"
                                           RetryTestId="@($"integrations-lifecycle-{step.Slug}-retry")" />
                        <p class="sb-state">@step.Emitted</p>
                    </dd>
                </div>
            }
        </dl>
    </Story>

    <Story Name="Succeeding leaves something behind"
           Description="CopyButton clears its confirmation after three seconds, and that is right for a copy: the act is finished the moment the clipboard returns and there is nothing further to do. An outward act is not like that. Creating an issue produces an issue, and a line that says done and then vanishes takes the link to it with it.

So the status line here does not auto-clear, and SuccessContent lets the host put the consequence into it. Clearing is the host's, driven by the state it already owns — this component holds no timer, and the one place in the family that would need one, the stalled session, is computed by the host for the same reason.

The default line is built from the label, so a host that has nothing to add still gets a sentence rather than a bare check. What it cannot get is a line that disappears with the link in it."
           Code="@SuccessCode">
        <div class="sb-stack" data-testid="integrations-success">
            <div class="sb-stack">
                <p class="sb-label">SuccessContent — the consequence, in the line</p>
                <IntegrationAction Action="@SucceededCreate"
                                   ButtonTestId="integrations-success-rich"
                                   StatusTestId="integrations-success-rich-status">
                    <SuccessContent>
                        Issue
                        <a href="https://github.com/jsdotnet/backlog/issues/128"
                           target="_blank"
                           rel="noopener"
                           data-testid="integrations-success-link">#128</a>
                        created.
                    </SuccessContent>
                </IntegrationAction>
            </div>
            <div class="sb-stack">
                <p class="sb-label">Nothing added — the default line from the label</p>
                <IntegrationAction Action="@SucceededPlain"
                                   ButtonTestId="integrations-success-plain"
                                   StatusTestId="integrations-success-plain-status" />
            </div>
        </div>
    </Story>

    <Story Name="Retry is part of failing"
           Description="A failed act with no way to try again is a dead end, and the reader's only recourse is to reload something and hope. Failure therefore renders in an alert region — following Toast's existing rule that Error and Warning are alerts and everything else is a status — plus a Retry that raises its own callback rather than re-raising invoke, so a host can distinguish a first attempt from a second in whatever it logs.

Retry is a third callback and not a second invoke for a practical reason as much as a logging one. A host that retried through OnInvoke would have to keep its own count to know whether to back off, and every host would keep it differently.

Press it: the line below reports which callback arrived, and the act is left in Failed rather than being advanced, because advancing it is the host's job and this page is the host."
           Code="@RetryCode">
        <div class="sb-stack" data-testid="integrations-retry">
            <IntegrationAction Action="@FailedHandOff"
                               OnInvoke="RecordInvoke"
                               OnRetry="RecordRetry"
                               ButtonTestId="integrations-retry-action"
                               StatusTestId="integrations-retry-status"
                               RetryTestId="integrations-retry-button" />
            <p class="sb-state" data-testid="integrations-retry-echo">@_retryEcho</p>
        </div>
    </Story>

    <Story Name="Confirming is a button, not a dialog"
           Description="Pressing an act that reaches outside the product should not fire on the first click, so Confirming is a state in the lifecycle: the button becomes Create the issue with a Cancel beside it, in place, and the second press is the one that acts.

A confirm dialog that previews what would be sent — the issue title and body before they leave — is not yet built. It is the right home for the preview, and ConfirmDialog already routes Escape and backdrop dismissal through Cancel so it would inherit that for free. The inline confirm is the floor, not the ceiling.

The act below is live and this page is its host: it advances on press because the handler under it advances it, and Cancel puts it back to Idle. Nothing in the component moves on its own, which is the whole claim — pressing Confirm here reaches a handler in this file that decides what happens next."
           Code="@ConfirmCode">
        <div class="sb-stack" data-testid="integrations-confirm">
            <IntegrationAction Action="@_confirmable"
                               OnInvoke="AdvanceConfirmable"
                               OnCancel="CancelConfirmable"
                               OnRetry="AdvanceConfirmable"
                               ButtonTestId="integrations-confirm-action"
                               ConfirmTestId="integrations-confirm-action"
                               CancelTestId="integrations-confirm-cancel"
                               StatusTestId="integrations-confirm-status"
                               RetryTestId="integrations-confirm-retry" />
            <p class="sb-state" data-testid="integrations-confirm-state">
                State is @(_confirmable.State). @ConfirmHint
            </p>
            <div class="sb-row">
                <AppButton Variant="ButtonVariant.Ghost"
                           Size="ButtonSize.Small"
                           TestId="integrations-confirm-reset"
                           OnClick="ResetConfirmable">Back to Idle</AppButton>
                <AppButton Variant="ButtonVariant.Ghost"
                           Size="ButtonSize.Small"
                           TestId="integrations-confirm-fail"
                           OnClick="FailConfirmable">Make the next press fail</AppButton>
            </div>
        </div>
    </Story>

    <Story Name="What a surface actually mounts"
           Description="IntegrationsPanel is thin on purpose: it owns the order of the four parts and one precedence rule, and nothing else. The order is header and freshness, then the acts, then the references, then whatever the surface adds — acts before references because an act is what a reader came to do and a reference is what already happened.

The rule is that when the whole cluster is unavailable the actions are replaced by the reason but the links stay. A pull request read last Tuesday is still open today, and blanking it because a token expired would tell the reader something false. The fourth panel below is that case: identical references, no acts, one sentence and one way out.

The first three are the same panel on three pretend surfaces at three densities, which is the consistency claim made visible — a reader who learns where the acts are on a backlog entry does not have to learn it again on a knowledge chapter. Refresh is wired to this page, so pressing Check now on any of them moves that panel's reading."
           Code="@PanelCode">
        <div class="sb-stack" data-testid="integrations-panels">
            <div class="sb-surface sb-stack">
                <p class="sb-label">A backlog entry detail pane — Toolbar</p>
                <IntegrationsPanel Title="Integrations"
                                   Actions="@IntegrationFixtures.Acts"
                                   Links="@IntegrationFixtures.OneRepository"
                                   Reading="@_entryReading"
                                   OnInvoke="RecordInvoke"
                                   OnOpen="RecordOpen"
                                   OnRefresh="RefreshEntry"
                                   TestId="integrations-panel-entry"
                                   HeaderTestId="integrations-panel-entry-header"
                                   ActionsTestId="integrations-panel-entry-actions"
                                   LinksTestId="integrations-panel-entry-links" />
            </div>

            <div class="sb-surface sb-stack">
                <p class="sb-label">A knowledge chapter footer — Inline</p>
                <IntegrationsPanel Title="Linked work"
                                   Actions="@IntegrationFixtures.Acts"
                                   Links="@IntegrationFixtures.OneLink"
                                   Reading="@IntegrationFixtures.ReadRecently"
                                   Density="IntegrationDensity.Inline"
                                   OnInvoke="RecordInvoke"
                                   OnOpen="RecordOpen"
                                   TestId="integrations-panel-chapter" />
            </div>

            <div class="sb-surface sb-stack sb-narrow">
                <p class="sb-label">A roadmap bar's popover — Compact</p>
                <IntegrationsPanel Title="Integrations"
                                   Actions="@IntegrationFixtures.Acts"
                                   Links="@IntegrationFixtures.OneLink"
                                   Reading="@IntegrationFixtures.ReadRecently"
                                   Density="IntegrationDensity.Compact"
                                   OnInvoke="RecordInvoke"
                                   OnOpen="RecordOpen"
                                   TestId="integrations-panel-roadmap" />
            </div>

            <div class="sb-surface sb-stack">
                <p class="sb-label">The same entry, with the token expired — acts replaced, references kept</p>
                <IntegrationsPanel Title="Integrations"
                                   Actions="@IntegrationFixtures.Acts"
                                   Links="@IntegrationFixtures.OneRepository"
                                   Reading="@IntegrationFixtures.ReadRecently"
                                   Readiness="@IntegrationFixtures.TokenExpired"
                                   OnInvoke="RecordInvoke"
                                   OnRemedy="Remedy"
                                   OnOpen="RecordOpen"
                                   TestId="integrations-panel-expired"
                                   ActionsTestId="integrations-panel-expired-actions"
                                   LinksTestId="integrations-panel-expired-links" />
            </div>

            <p class="sb-state" data-testid="integrations-panel-echo">@_panelEcho</p>
        </div>
    </Story>

</StoryPage>

@code {
    /// <summary>What this family is for, stated once at the top of the section
    /// rather than in a story — it is the reason the whole chapter exists and not
    /// a property of any one component on it.</summary>
    private const string AbsorbsNotice =
        "This family exists to absorb improvisation that is already in the product. BacklogPane.razor "
        + "hand-rolls .badge--gh-{state} anchors, a GitHubStateClass helper that lowercases an enum, two "
        + "IconButtons whose busy state is a literal ellipsis character, and a span.entry-doc__cli-mark "
        + "reading gh where a Copilot mark belongs; DomainKnowledgePanel.razor hard-codes badge--gh-open. "
        + "Every one of those has a component on these five pages. Migrating them is a deliberate "
        + "follow-up rather than part of this change, so the library and its storybook can be reviewed "
        + "on their own and the migration validated on its own.";

    /// <summary>The second organising rule of the section, and the one a reader
    /// is most likely to get backwards: which affordances wear a vendor mark. It
    /// sits beside the first because it governs every page here — the acts on
    /// Actions, the sessions on References, the cards on AI — rather than any one
    /// component.</summary>
    private const string MarkRule =
        "A vendor mark is a passport stamp: it appears exactly when work crosses out of this "
        + "application, and never otherwise. Ask AI, Resolve comments with AI and Rewrite part with AI "
        + "are this product's own features — nothing leaves, so they carry no Claude mark, no Copilot "
        + "mark and no vendor name, and what they write is attributed to \"AI\", full stop. Sending a "
        + "prompt or a section to a Claude or a GitHub Copilot session to be implemented in a related "
        + "repository does leave, and so does the session that comes back and has to be tracked; both "
        + "are provider-specific and both are marked. So the mark is not decoration and it is not a "
        + "logo budget: it is the reader's only cue that something went somewhere. The two hand-offs "
        + "and the unmarked AI acts are drawn side by side on Actions; the unmarked proposal card and "
        + "the marked one it came back beside are on AI; the sessions a hand-off produces are on "
        + "References.";

    /// <summary>One cell of the lifecycle row: the state, the spec that produces
    /// it, and what the component emits for it.</summary>
    private sealed record Step(string Name, string Slug, IntegrationActionSpec Spec, string Emitted);

    private static readonly IntegrationActionSpec NotConnected =
        IntegrationFixtures.CreateIssue with { Readiness = IntegrationFixtures.GitHubNotConnected };

    private static readonly IntegrationActionSpec FailedHandOff =
        IntegrationFixtures.RunInCopilot with
        {
            State = IntegrationActionState.Failed,
            StatusMessage = "Copilot CLI exited before it started. Nothing was sent."
        };

    private static readonly IntegrationActionSpec SucceededCreate =
        IntegrationFixtures.CreateIssue with { State = IntegrationActionState.Succeeded };

    private static readonly IntegrationActionSpec SucceededPlain =
        IntegrationFixtures.OpenInVsCode with { State = IntegrationActionState.Succeeded };

    /// <summary>The five states of one act. One spec, read five ways, so the row
    /// cannot end up showing five different acts that happen to look related.</summary>
    private static readonly IReadOnlyList<Step> Lifecycle =
    [
        new("Idle", "idle", IntegrationFixtures.CreateIssue,
            "The label and the provider mark. Nothing else is emitted."),

        new("Confirming", "confirming",
            IntegrationFixtures.CreateIssue with { State = IntegrationActionState.Confirming },
            "The label becomes ConfirmLabel and a ghost Cancel appears beside it."),

        new("Running", "running",
            IntegrationFixtures.CreateIssue with { State = IntegrationActionState.Running },
            "AppButton.Busy: aria-busy=\"true\", the embedded Spinner, still in the tab order."),

        new("Succeeded", "succeeded", SucceededCreate,
            "A status line, role=\"status\", no timer. The button stays where it was."),

        new("Failed", "failed",
            IntegrationFixtures.CreateIssue with
            {
                State = IntegrationActionState.Failed,
                StatusMessage = "GitHub refused the request. Nothing was created."
            },
            "An alert line, role=\"alert\", plus Retry on its own callback.")
    ];

    // --- Live state --------------------------------------------------------

    private IntegrationActionSpec _confirmable =
        IntegrationFixtures.CreateIssue with { Id = "confirm-demo" };

    private bool _nextPressFails;

    private IntegrationReading _entryReading = IntegrationFixtures.ReadRecently;

    private string _remedyEcho = "No remedy pressed yet.";

    private string _retryEcho = "Nothing pressed yet.";

    private string _panelEcho = "Nothing pressed yet.";

    /// <summary>The host's whole side of the lifecycle: one press advances one
    /// step. A real host would await something between Confirming and Running;
    /// the shape of the state machine is identical either way.</summary>
    private void AdvanceConfirmable() =>
        _confirmable = _confirmable.State switch
        {
            IntegrationActionState.Idle => _confirmable with { State = IntegrationActionState.Confirming },
            IntegrationActionState.Confirming => _confirmable with { State = IntegrationActionState.Running },
            IntegrationActionState.Running when _nextPressFails => _confirmable with
            {
                State = IntegrationActionState.Failed,
                StatusMessage = "GitHub refused the request. Nothing was created."
            },
            IntegrationActionState.Running => _confirmable with
            {
                State = IntegrationActionState.Succeeded,
                StatusMessage = "Issue #128 created."
            },
            _ => _confirmable with { State = IntegrationActionState.Idle, StatusMessage = null }
        };

    private void CancelConfirmable() =>
        _confirmable = _confirmable with { State = IntegrationActionState.Idle, StatusMessage = null };

    private void ResetConfirmable()
    {
        _nextPressFails = false;
        _confirmable = _confirmable with { State = IntegrationActionState.Idle, StatusMessage = null };
    }

    private void FailConfirmable() => _nextPressFails = true;

    /// <summary>What the next press will do, said out loud — the state machine is
    /// the story, and a reader should not have to guess where they are in it.</summary>
    private string ConfirmHint => _confirmable.State switch
    {
        IntegrationActionState.Idle => "Pressing it asks rather than acts.",
        IntegrationActionState.Confirming => "This press is the one that would reach GitHub. Cancel returns to Idle.",
        IntegrationActionState.Running => "Press again to land it — this page is standing in for the network.",
        IntegrationActionState.Succeeded => "The line stays until the host clears it. Press to start over.",
        _ => "Retry raises its own callback, not invoke. Press to start over."
    };

    private void Remedy(IntegrationReadiness readiness) =>
        _remedyEcho = $"OnRemedy raised with Availability = {readiness.Availability}, Subject = {readiness.Subject ?? "none"}.";

    private void RecordInvoke(IntegrationActionSpec spec)
    {
        _retryEcho = $"OnInvoke raised for {spec.Id}.";
        _panelEcho = $"OnInvoke raised for {spec.Id}.";
    }

    private void RecordRetry(IntegrationActionSpec spec) =>
        _retryEcho = $"OnRetry raised for {spec.Id} — a second attempt, distinguishable from the first.";

    private void RecordOpen(IntegrationLinkRef link) =>
        _panelEcho = $"OnOpen raised for {link.Id}.";

    /// <summary>A read, as a host performs one: in flight, then a new reading.
    /// Nothing polls, here or in the library — this only happens because the
    /// button was pressed.</summary>
    private async Task RefreshEntry()
    {
        _entryReading = _entryReading with { InFlight = true, FailureReason = null };
        StateHasChanged();

        await Task.Delay(700);

        _entryReading = new IntegrationReading("just now");
    }

    private void Noop()
    {
        // The stories above are about what is rendered, not about what a press
        // does. A delegate is still needed: Retry and Cancel only render where
        // there is something behind them, so a story about the failed state with
        // no handler would be a story missing the button it is about.
    }

    // --- Code samples ------------------------------------------------------

    private const string NoDisabledCode = """
        @* There is no Disabled parameter to pass. An act is inert only by way of
           a readiness, and a readiness cannot be built without a cause. *@
        <IntegrationAction Action="@(spec with { Readiness = IntegrationReadiness.NotAuthorized("GitHub") })" />
        """;

    private const string UnavailableCode = """
        @* Four causes, one component. The sentence and the remedy label are
           derived from the cause and the subject, so a host that passes only
           those two still gets a sentence rather than a bare disabled control. *@
        <IntegrationUnavailable Readiness="@IntegrationReadiness.NotAuthorized("GitHub")" OnRemedy="Connect" />
        <IntegrationUnavailable Readiness="@IntegrationReadiness.NotInstalled("VS Code")" OnRemedy="Explain" />
        <IntegrationUnavailable Readiness="@IntegrationReadiness.Offline()" />
        <IntegrationUnavailable Readiness="@IntegrationReadiness.FeatureOff("The GitHub integration")" OnRemedy="OpenSettings" />
        """;

    private const string RolesCode = """
        @* A standing condition is a status. An event the reader caused is an
           alert. The split follows Toast rather than inventing a second rule. *@
        <IntegrationUnavailable Readiness="@IntegrationReadiness.Offline()" />   @* role="status" *@

        <IntegrationAction Action="@(spec with { State = IntegrationActionState.Failed })"
                           OnRetry="Retry" />                                    @* role="alert" *@
        """;

    private const string LifecycleCode = """
        @* The host owns the state and hands it in. Nothing here advances it. *@
        <IntegrationAction Action="@_createIssue"
                           OnInvoke="Advance"
                           OnCancel="BackToIdle"
                           OnRetry="TryAgain" />

        private void Advance() => _createIssue = _createIssue.State switch
        {
            IntegrationActionState.Idle       => _createIssue with { State = IntegrationActionState.Confirming },
            IntegrationActionState.Confirming => _createIssue with { State = IntegrationActionState.Running },
            _                                 => _createIssue
        };
        """;

    private const string SuccessCode = """
        @* The consequence goes in the line, and the line does not clear itself.
           Clearing is the host's, driven by the state it already owns. *@
        <IntegrationAction Action="@(spec with { State = IntegrationActionState.Succeeded })">
            <SuccessContent>
                Issue <a href="@issueUrl" target="_blank" rel="noopener">#128</a> created.
            </SuccessContent>
        </IntegrationAction>
        """;

    private const string RetryCode = """
        @* Retry is its own callback so a host can tell a second attempt from a
           first without keeping a count of its own. *@
        <IntegrationAction Action="@_handOff"
                           OnInvoke="@(spec => Log(spec, attempt: 1))"
                           OnRetry="@(spec => Log(spec, attempt: _attempts + 1))" />
        """;

    private const string ConfirmCode = """
        @* ConfirmLabel is what makes the first press ask instead of act. The
           preview dialog that would show the issue body before it is sent is not
           built yet; this inline confirm is the floor. *@
        new IntegrationActionSpec("create-issue", "Create GitHub issue",
            IntegrationProvider.GitHub,
            ConfirmLabel: "Create the issue")
        """;

    private const string PanelCode = """
        @* Header and freshness, then acts, then references, then the surface's
           own children. When Readiness is not Available the acts are replaced by
           the reason and the references stay exactly as they were. *@
        <IntegrationsPanel Actions="@acts"
                           Links="@links"
                           Reading="@reading"
                           Readiness="@cluster"
                           OnInvoke="Invoke"
                           OnOpen="Open"
                           OnRefresh="Reread" />
        """;
}
