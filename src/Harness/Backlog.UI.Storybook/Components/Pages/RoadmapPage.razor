    /// <summary>What a host does with a drawn link: decide, then hand it back. This
    /// page accepts every one; the app asks the plan, which refuses a cycle.</summary>
    private void AddHandOverLink(RoadmapLink link)
    {
        _handOverLinks = [.. _handOverLinks.Append(link).Distinct()];
        _lastLink = $"{link.ToId} now waits for {link.FromId}";
    }

