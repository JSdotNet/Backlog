        new RoadmapBar("release@web#2", "web::planned", "Release", feb28, apr10),
        new RoadmapBar("release@backlog#3", "backlog::planned", "Release", apr11, apr30),

        // Dropping the handle proposes a link; the host decides and hands it back
        void AddLink(RoadmapLink link) => links = [.. links, link];
