    private const string StepsCode = """
        <RoadmapTimeline Groups="@groups"
                         Bars="@bars"
                         Window="@window" />

        new RoadmapBar("import", "planned", "Imported plans", start, end,
            Steps:
            [
                new("parse", "Parse the plan entry", 3, RoadmapStepTone.Done, "Done"),
                new("layout", "Lay the plan out", 2, RoadmapStepTone.Done, "Done", "After Parse the plan entry"),
                new("timeline", "Draw steps", 5, RoadmapStepTone.InProgress, "In progress", "After Lay the plan out"),
                new("docs", "Update the devbook", null, RoadmapStepTone.Ready, "Ready"),   // unestimated
