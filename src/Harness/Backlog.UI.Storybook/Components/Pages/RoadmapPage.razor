@page "/roadmap"

<PageTitle>Roadmap — Backlog UI Storybook</PageTitle>

<StoryPage Title="Roadmap"
           Summary="`RoadmapTimeline` and `RoadmapTimelineBar`: a plan drawn against time. Quarters across the top, a two-level column of swimlanes down the left, and bars, milestones and dependency arrows placed by their dates. The component is handed the structure, draws it in the order it was handed, and reports what the reader did to it — it does not know what a group or a row means. What a bar, a milestone and an arrow mean to a reader is the rule linked above. `RoadmapPlanShelf`, at the end, lists work that has no place on the chart yet."
           Guidelines="@Rules">

    <Story Name="A plan across a year"
           Description="Six bands, rows inside each, and bars placed by start and end date: the whole component in one picture. The axis is ruled in quarters, the left column stays put while the track scrolls sideways.

Nothing here is a category the library invented — TARGETS, OPERATIONS and PRODUCT are strings this page made up. The colours are this page's too: the library ships no hues of its own, so a caller passes them in."
           Code="@TimelineCode">
        <RoadmapTimeline Groups="@Plan"
                         Bars="@_bars"
                         Milestones="@Milestones"
                         Links="@Links"
                         Today="@Today"
                         Title="2026"
                         Description="One plan over several projects at once."
                         HeadingLevel="3"
                         SelectedId="@_selectedId"
                         OnBarSelected="Select"
                         OnBarChanged="Apply"
                         TestId="roadmap" />
        <p class="sb-state" data-testid="roadmap-selected">Selected: @(_selectedId ?? "(none)")</p>
        <p class="sb-state" data-testid="roadmap-last-change">Last change: @(_lastChange ?? "(none)")</p>
    </Story>

    <Story Name="Moving a bar, and moving it without a mouse"
           Description="Drag a bar sideways to move it in time, up or down to change row, or by an edge to move one date. Every gesture snaps to the week, and the bar mid-drag is already at the position the drop will commit — the preview and the result are the same value.

The keyboard does the same: Tab to a bar, Space to pick it up, arrows to move it a week or a row, Shift or Alt with an arrow to pull an end. Space drops, Escape puts it back, and each step is announced through a live region."
           Code="@EditCode">
        <RoadmapTimeline Groups="@EditablePlan"
                         Bars="@_editable"
                         Links="@EditableLinks"
                         Title="Try it"
                         HeadingLevel="3"
                         Window="@EditWindow"
                         OnBarChanged="ApplyEditable"
                         ShowFilters="false"
                         TestId="editable" />
        <div class="sb-row">
            <AppButton Variant="ButtonVariant.Ghost" OnClick="ResetEditable">Put it all back</AppButton>
        </div>
        <p class="sb-state" data-testid="editable-state">
            @string.Join(" · ", _editable.Select(bar => $"{bar.Title}: {bar.Start:d MMM} – {bar.End:d MMM} on {bar.RowId}"))
        </p>
    </Story>

    <Story Name="Dependencies, and what happens when one end is missing"
           Description="`Dependencies` are pairs of bar ids; the badge on a bar counts how many arrows point at it. Both are resolved from where the two ends are drawn right now, including a bar part-way through a drag, so an arrow is never stale. Move the second bar and watch the arrow follow.

An arrow takes an elbow when there is room and doubles back through the gutter when there is not — the second shape is what a plan that contradicts itself looks like. A dependency with one end missing draws nothing."
           Code="@LinkCode">
        <RoadmapTimeline Groups="@DependencyPlan"
                         Bars="@_dependent"
                         Milestones="@DependencyMilestones"
                         Links="@DependencyLinks"
                         Title="What waits on what"
                         HeadingLevel="3"
                         Window="@EditWindow"
                         ShowFilters="false"
                         OnBarChanged="ApplyDependent"
                         TestId="links" />
    </Story>

    <Story Name="Filtering, without the library knowing what it is filtering on"
           Description="A bar carries `Facets` — names and values the caller chose — and the filter bar is built from whichever names the bars mention. A caller filing work by customer and contract gets two controls called Customer and Contract from this same component.

Two behaviours worth watching: the choices never narrow as you filter, and a bar with no value for a facet is not hidden by that facet."
           Code="@FilterCode">
        <RoadmapTimeline Groups="@FilterPlan"
                         Bars="@FilterBars"
                         Links="@FilterLinks"
                         Title="Everything in flight"
                         Description="Filter it down, then clear it."
                         HeadingLevel="3"
                         Window="@EditWindow"
                         TestId="filtered" />
    </Story>

    <Story Name="Milestones are not one-day bars"
           Description="A milestone has no duration, so it has no edge to pull, is drawn as a glyph rather than a span, and can be the far end of a dependency without being draggable. It goes on a row of its own.

The three kinds are told apart by shape as well as colour, and each carries its full description — what it is, which band and row, and its date — as text for a screen reader, with the visible label hidden from assistive tech so the date is not read twice. Dropping a bar onto a milestones row is refused rather than ignored."
           Code="@MilestoneCode">
        <RoadmapTimeline Groups="@MilestonePlan"
                         Bars="@MilestoneBars"
                         Milestones="@AllMarkers"
                         Title="Fixed dates"
                         HeadingLevel="3"
                         Window="@EditWindow"
                         ShowFilters="false"
                         TestId="milestones" />
    </Story>

    <Story Name="One bar, on its own"
           Description="`RoadmapTimelineBar` outside the chart. It takes a bar, the geometry that turns a date into a position, and nothing else: not which row it is on, how many rows there are, or what a dependency is. The count on its badge is handed to it.

Every gesture arrives as a `Preview` — a proposed placement the bar draws itself at, rather than a second ghostly copy — which is what keeps a dependency arrow attached to a bar being dragged. The last of the four is `Locked`: no edge grips, and it refuses to be picked up."
           Code="@BarCode">
        <div class="sb-stack">
            <div class="sb-bar-track">
                <RoadmapTimelineBar Bar="@Solo"
                                    Geometry="@SoloGeometry"
                                    ContextLabel="Product, Jamie"
                                    DependencyCount="2"
                                    TestId="solo" />
            </div>
            <div class="sb-bar-track">
                <RoadmapTimelineBar Bar="@Solo"
                                    Geometry="@SoloGeometry"
                                    ContextLabel="Product, Jamie"
                                    Selected="true"
                                    TestId="solo-selected" />
            </div>
            <div class="sb-bar-track">
                <RoadmapTimelineBar Bar="@Solo"
                                    Geometry="@SoloGeometry"
                                    ContextLabel="Product, Jamie"
                                    Grabbed="true"
                                    Preview="@SoloPreview"
                                    TestId="solo-grabbed" />
            </div>
            <div class="sb-bar-track">
                <RoadmapTimelineBar Bar="@SoloLocked"
                                    Geometry="@SoloGeometry"
                                    ContextLabel="Product, Jamie"
                                    TestId="solo-locked" />
            </div>
        </div>
    </Story>

    <Story Name="An item with its steps"
           Description="A bar handed `Steps` offers a disclosure at its leading edge and carries a progress fill: done effort over total estimated effort, with the count of unestimated steps beside it rather than folded in. Expanded, it opens one row per step in the order it was handed — here a chain of three, then two more — each step's width its share of the estimated effort inside the bar's window.

A step is a proportion, not a date: a step drawn across March is not scheduled for March, and its accessible name says it is a share. The unestimated step takes a fixed minimum width, dashed, with a `?` marker and an accessible name that says so. Colours are the status badge's; the status is also written into every step's name. Tab to the disclosure and press Enter or Space — the change is announced."
           Code="@StepsCode">
        <RoadmapTimeline Groups="@StepsPlan"
                         Bars="@StepsBars"
                         Title="Import plan"
                         HeadingLevel="3"
                         Window="@EditWindow"
                         ShowFilters="false"
                         TestId="steps" />
    </Story>

    <Story Name="A plan across repositories, without its tasks"
           Description="How the app draws a plan filed in two repositories: one bar in each repository's band, each that repository's part of the plan, with a progress fill read from the tasks filed there. `ShowSteps` off keeps the bars from opening into a row per task — the roadmap reads plans, and the tasks stay in the task list. The parts share one window, because they are one stored plan: moving either moves both, and the arrow runs within each repository."
           Code="@PartsCode">
        <RoadmapTimeline Groups="@PartsPlan"
                         Bars="@PartsBars"
                         Links="@PartsLinks"
                         Title="Devbook conventions"
                         HeadingLevel="3"
                         Window="@EditWindow"
                         ShowFilters="false"
                         ShowSteps="false"
                         TestId="parts" />
    </Story>

    <Story Name="A plan handed over between repositories, and drawing what waits"
           Description="How the app draws a plan whose tasks hand over from one repository to another: backlog's part first, then web's part that waits on it, then backlog again. Each segment is one repository's share of one phase, the window shared out by effort, and the arrows between them are the task dependencies that cross a repository — a wait inside one repository stays that segment's own business.

With `OnLinkCreated` set, every bar offers a dot past its end. Drag it onto another bar or a date and that one waits for it; the chart proposes the link and the host decides whether it stands, so the arrow appears when this page hands it back. Escape abandons the gesture."
           Code="@HandOverCode">
        <RoadmapTimeline Groups="@HandOverPlan"
                         Bars="@HandOverBars"
                         Milestones="@HandOverMilestones"
                         Links="@_handOverLinks"
                         Title="Release across repositories"
                         HeadingLevel="3"
                         Window="@EditWindow"
                         ShowFilters="false"
                         ShowSteps="false"
                         OnLinkCreated="AddHandOverLink"
                         TestId="hand-over" />
        <p class="sb-state" data-testid="hand-over-last-link">Last link: @(_lastLink ?? "(none)")</p>
    </Story>

    <Story Name="A plan nobody has written"
           Description="No groups, or groups with no rows, renders the empty state rather than an axis over nothing. The sentence is the caller's, because why the plan is empty is only knowable where the plan came from."
           Code="@EmptyCode">
        <RoadmapTimeline Groups="@(Array.Empty<RoadmapGroup>())"
                         Title="Next year"
                         HeadingLevel="3"
                         EmptyMessage="Nothing planned for next year yet. Add a band and put a row in it."
                         TestId="empty" />
    </Story>

    <Story Name="Plans waiting for a place"
           Description="`RoadmapPlanShelf` lists work that exists and has no place on the timeline yet — in the app, plans whose tasks were imported before anyone put them on the roadmap. Each row says how much work it holds and how big it is, with the unestimated tasks counted apart rather than folded into the total, and carries one action. The shelf reports which row was pressed and plans nothing itself; press one here and it leaves the list, the way a planned row does in the app.

Every action is a real button named for its plan, and the shelf is a region named by its heading. When a row goes, focus moves to that heading, one Tab from the next row. With nothing left to offer the shelf renders nothing, so what was planned has to be announced by the host, from outside it."
           Code="@ShelfCode">
        <RoadmapPlanShelf Plans="@_shelf"
                          OnPlan="PlanFromShelf"
                          HeadingId="shelf-story-title"
                          TestId="shelf" />
        <div class="sb-row">
            <AppButton Variant="ButtonVariant.Ghost" OnClick="ResetShelf">Put them back</AppButton>
        </div>
        <p class="sb-state" data-testid="shelf-last-planned">Last planned: @(_lastPlanned ?? "(none)")</p>
    </Story>

</StoryPage>

@code {
    private static readonly DesignGuideline[] Rules =
    [
        new("interaction-guidelines.md#timelines-and-roadmaps", "What a bar, a milestone and a dependency arrow mean."),
        new("interaction-guidelines.md#drag-and-drop-reordering", "How a bar is moved, and what a drop commits."),
        new("interaction-guidelines.md#keyboard-accessible-reordering", "The keys that move a bar without a pointer."),
        new("color-scheme.md#chart-roles", "The hues a lane and a bar are allowed to use."),
        new("color-scheme.md#badge-and-chip-tones", "The status colours a step inside a bar wears."),
        new("typography-and-layout.md#density", "Row heights, lane labels and how tight an axis may be.")
    ];

    private static readonly DateOnly Today = new(2026, 5, 20);

    private static DateOnly On(int month, int day) => new(2026, month, day);

    private string? _selectedId;

    private static readonly RoadmapShelfPlan[] ShelfPlans =
    [
        new("devbook-conventions", ["budgetbeheer", "spec-manager"], 23, 125, 0,
            [new("budgetbeheer", 14, 78, 0), new("spec-manager", 9, 47, 0)]),
        new("devbook-openspec-parity", ["devbook"], 9, 44, 0),
        new("release-q4", ["backlog", "web"], 6, 21, 2,
            [new("backlog", 4, 13, 1), new("web", 2, 8, 1)]),
        new("unplanned-plans-shelf", ["backlog"], 1, 3, 0)
    ];

    private IReadOnlyList<RoadmapShelfPlan> _shelf = ShelfPlans;
    private string? _lastPlanned;

    private void PlanFromShelf(RoadmapShelfPlan plan)
    {
        _lastPlanned = "+" + plan.Tag;
        _shelf = [.. _shelf.Where(row => row.Tag != plan.Tag)];
    }

    private void ResetShelf()
    {
        _shelf = ShelfPlans;
        _lastPlanned = null;
    }
    private string? _lastChange;

    private void Select(string id) => _selectedId = id;

    private void Apply(RoadmapChange change) =>
        Bind(ref _bars, change, out _lastChange);

    private void ApplyEditable(RoadmapChange change) =>
        Bind(ref _editable, change, out _);

    private void ApplyDependent(RoadmapChange change) =>
        Bind(ref _dependent, change, out _);

    /// <summary>What a host does with a change: replace the bar it names, and
    /// nothing else. The component proposed it; applying it is this page's,
    /// which is why the chart only moves once this has run.</summary>
    private static void Bind(ref RoadmapBar[] bars, RoadmapChange change, out string? said)
    {
        bars = [.. bars.Select(bar => bar.Id == change.BarId ? change.ApplyTo(bar) : bar)];
        said = $"{change.Kind} — {change.BarId} to {change.Start:d MMM} – {change.End:d MMM}";
    }

    // --- The full plan -----------------------------------------------------

    private static IReadOnlyList<RoadmapGroup> Plan =>
    [
        new("targets", "Targets", [new("milestones", "Milestones", RoadmapRowKind.Milestones)], "#F2C14E"),
        new("operations", "Operations", [new("jamie", "Jamie"), new("alex", "Alex")], "#5FA8D3"),
