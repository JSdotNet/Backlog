@page "/menus"

<PageTitle>Menus — Backlog UI Storybook</PageTitle>

<StoryPage Title="Menus"
           Summary="A tree, a flat menu, the same menu at a pointer position, and the navigation list this storybook's own sidebar is built from."
           Guidelines="@Rules">

    <Story Name="TreeView"
           Description="Expansion and selection live in the page, not the tree — the component asks two predicates and raises one event, so a host keeps whatever state model it already has.

No open-in-VS-Code button here: a tree of rows is a tree of rows, and this one has nowhere on disk to open. The button belongs to something that knows it is a folder, which is the Folder view chapter."
           Code="@TreeCode">
        <TreeView Nodes="Nodes"
                  HeadingLabel="Chapters"
                  HeadingTestId="tree-heading"
                  ShowOpenButton="false"
                  IsNodeSelected="node => node.Id == _selectedId"
                  IsNodeExpanded="node => _expanded.Contains(node.Id)"
                  OnNodeSelected="OnNodeSelected" />
        <p class="sb-state" data-testid="tree-state">
            Selected: @(_selectedId ?? "(none)") &nbsp;|&nbsp; Expanded: [@string.Join(", ", _expanded)]
        </p>
    </Story>

    <Story Name="OpenFolderButton"
           Description="“Open this in VS Code”, as a control of its own — one button used in two headers, because `TreeView` puts it beside its heading and `FolderView` puts it in its own.

The icon is `aria-hidden` and the accessible name says which folder. The SVG is drawn here rather than fetched, so it renders in a WebView with no egress. `Busy` keeps it in place and the same size."
           Code="@OpenButtonCode">
        <div class="sb-row" data-testid="open-folder-states">
            <OpenFolderButton Label="Open .arc42 in VS Code"
                              OnClick="OnOpenFolder"
                              TestId="open-folder-idle" />
            <OpenFolderButton Label="Opening .design in VS Code" Busy="true" TestId="open-folder-busy" />
            <OpenFolderButton Label="Open .tech in VS Code" Disabled="true" TestId="open-folder-disabled" />
        </div>
    </Story>

    <Story Name="MenuList"
           Description="One tab stop: arrows walk it, Enter and Space activate, disabled rows and separators are skipped."
           Code="@MenuCode">
        <MenuList Items="MenuItems"
                  AriaLabel="Entry actions"
                  TestId="menu"
                  OnItemSelected="OnMenuItemSelected" />
    </Story>

    <Story Name="ContextMenu"
           Description="The same MenuList placed at a pointer position. Right-click the surface below; Escape or a click outside closes it."
           Code="@ContextCode">
        <div class="sb-surface"
             data-testid="context-surface"
             @oncontextmenu="OpenContextMenu"
             @oncontextmenu:preventDefault="true">
            Right-click anywhere in this box.
        </div>
        <ContextMenu Open="_contextOpen"
                     OpenChanged="v => _contextOpen = v"
                     X="_contextX"
                     Y="_contextY"
                     Items="MenuItems"
                     AriaLabel="Entry actions"
                     TestId="context-menu"
                     OnItemSelected="OnContextItemSelected" />
    </Story>

    <Story Name="NavList"
           Description="Router-aware links. Match=true means the link is only active on an exact route, which is what the root entry needs."
           Code="@NavCode">
        <NavList Items="NavItems" AriaLabel="Storybook pages" TestId="nav-demo" />
    </Story>

    <Story Name="Last thing selected"
           Description="Every menu on this page writes here, so it is visible that the callbacks fire.">
        <p class="sb-state" data-testid="menu-last-action">@(_lastAction ?? "(nothing yet)")</p>
    </Story>

    @*
        The pager is here rather than with the buttons because stepping through a
        sequence is navigation, and because the counter is the part that matters:
        two arrows on their own say there is more without saying how much more.
    *@
    <Story Name="Record pager"
           Description="Previous and next over a sequence, with the position in it. The ends disable rather than wrap, so reaching the last record tells you it is the last. A total of zero renders nothing — a counter reporting on a sequence that does not exist is worse than no counter."
           Code="@PagerCode">
        <div class="sb-stack">
            <RecordPager Index="0" Total="7" AriaLabel="Chapters" TestId="pager-first" />
            <RecordPager Index="3" Total="7" AriaLabel="Chapters" TestId="pager-middle"
                         Hints="@PagerHints" />
            <RecordPager Index="6" Total="7" AriaLabel="Chapters" TestId="pager-last" />
            <RecordPager Index="0" Total="0" AriaLabel="Nothing" TestId="pager-empty" />
        </div>
    </Story>

</StoryPage>

@code {
    // The hints belong to whatever binds the keys, not to the pager: the same
    // control reached by arrows on one surface and by brackets on another would
    // be lying to one of them if the keys were baked in.
    private static readonly IReadOnlyList<RecordPagerHint> PagerHints =
    [
        new("↑ ↓", "move"),
        new("Esc", "close")
    ];

    private const string PagerCode = """
        <RecordPager Index="3"
                     Total="7"
                     AriaLabel="Chapters"
                     Hints="@PagerHints"
                     OnPrevious="() => Step(-1)"
                     OnNext="() => Step(1)" />
        """;

    private static readonly DesignGuideline[] Rules =
    [
        new("accessibility.md#keyboard-navigation", "What a tree and a menu have to be walkable with."),
        new("interaction-guidelines.md#focus-and-selection", "What the selected row looks like, and what keeps it."),
        new("typography-and-layout.md#density", "Row heights and indent steps in a navigation pane.")
    ];

    private static readonly IReadOnlyList<TreeNode> Nodes =
    [
        new("arc42", "Architecture", TreeNodeKind.Folder, true, null,
        [
            TreeNode.Leaf("arc42-1", "Introduction and goals"),
            TreeNode.Leaf("arc42-5", "Building block view"),
            new("arc42-8", "Cross-cutting concepts", TreeNodeKind.Folder, true, null,
            [
                TreeNode.Leaf("arc42-8-ui", "UI components"),
                TreeNode.Leaf("arc42-8-sync", "Sync")
            ])
        ]),
        new("design", "Design", TreeNodeKind.Folder, true, null,
        [
            TreeNode.Leaf("design-colors", "Color scheme"),
            TreeNode.Leaf("design-tokens", "Design tokens"),
            TreeNode.Leaf("design-motion", "Motion", available: false, message: "Not written yet")
        ]),
        new("empty", string.Empty, TreeNodeKind.Message, true, "No technology chapters have been generated.")
    ];

    private static readonly IReadOnlyList<MenuItem> MenuItems =
    [
        new("open", "Open", "↗"),
        new("rename", "Rename", "✎"),
        MenuItem.Divider("sep-1"),
        new("duplicate", "Duplicate", "⧉"),
        new("archive", "Archive", "📦", Disabled: true),
        MenuItem.Divider("sep-2"),
        new("delete", "Delete", "🗑", Destructive: true)
    ];

    private static readonly IReadOnlyList<NavItem> NavItems =
    [
        new("/", "Introduction", Match: true),
        new("/buttons", "Buttons"),
        new("/menus", "Menus")
    ];

    private readonly HashSet<string> _expanded = ["arc42"];
    private string? _selectedId;
    private string? _lastAction;
    private bool _contextOpen;
    private double _contextX;
    private double _contextY;

    // A row with children is a disclosure; a leaf is a selection. One click
    // handler covers both because the tree reports the node, not the intent.
    private void OnNodeSelected(TreeNode node)
    {
        if (node.HasChildren && !_expanded.Add(node.Id))
        {
            _expanded.Remove(node.Id);
        }

        _selectedId = node.Id;
        _lastAction = $"Tree: {node.Label}";
    }

    private void OpenContextMenu(MouseEventArgs e)
    {
        _contextX = e.ClientX;
        _contextY = e.ClientY;
        _contextOpen = true;
    }

    private void OnOpenFolder() => _lastAction = "Open folder: .arc42";

    private void OnMenuItemSelected(MenuItem item) => _lastAction = $"Menu: {item.Label}";

    private void OnContextItemSelected(MenuItem item) => _lastAction = $"Context: {item.Label}";

    private const string TreeCode = """
        <TreeView Nodes="Nodes"
                  IsNodeSelected="node => node.Id == _selectedId"
                  IsNodeExpanded="node => _expanded.Contains(node.Id)"
                  OnNodeSelected="OnNodeSelected" />
        """;

    private const string OpenButtonCode = """
        <OpenFolderButton Label="Open .arc42 in VS Code" OnClick="OpenAsync" />

        @* The same control, reached through the two components that host it. *@
        <FolderView Name=".arc42" Entries="@entries" OnOpenFolder="OpenAsync" />
        <TreeView Nodes="@nodes" RootFolder="@root" OnOpenFolder="OpenAsync" />
        """;

    private const string MenuCode = """
        <MenuList Items="MenuItems" AriaLabel="Entry actions" OnItemSelected="OnSelected" />
        """;

    private const string ContextCode = """
        <div @oncontextmenu="OpenContextMenu" @oncontextmenu:preventDefault="true">...</div>
        <ContextMenu Open="_open" OpenChanged="v => _open = v" X="_x" Y="_y" Items="MenuItems" />
        """;

    private const string NavCode = """
        <NavList Items="NavItems" AriaLabel="Storybook pages" />
        """;
}
