@page "/sprint-planning"

<PageTitle>Sprint planning — Backlog UI Storybook</PageTitle>

<StoryPage Title="Sprint planning"
           Summary="SprintAddPicker, SprintItemNoteDialog and SprintTaskPanel, with the row menu SprintBoard carries while its sprint takes writes: adding a task or a whole plan to the open sprint, taking it out, marking it as goal, and its one-line note and open question — from the sprint view and from a task's side panel. Every value is handed in and every act a callback; nothing here changes a task."
           Guidelines="@Rules">

    <Story Name="A row menu on the open sprint"
           Description="While the sprint shown is the open one, every row carries a Sprint actions button. Its menu marks the task as goal or takes the mark off, adds or edits the note, marks or clears the open question, and takes the task out: Remove from sprint for a task added directly, Unlink +plan for one a linked plan brought in. A closed sprint carries no menu."
           Code="@RowMenuCode">
        <div class="sb-menu-wide">
            <SprintBoard Model="@Board"
                         RowMenu="@MenuFor"
                         OnRowMenu="@((SprintRowMenuChoice choice) => _said = $"{choice.Item.Label}: {choice.Row.Title}")"
                         TestId="sprint-planning-board">
                <Actions>
                    <AppButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" TestId="sprint-planning-add" OnClick="() => _picking = true">Add to sprint…</AppButton>
                </Actions>
            </SprintBoard>
            <p class="sb-state" data-testid="sprint-planning-said">@(_said ?? "Open a row's menu, or Add to sprint….")</p>
        </div>
    </Story>

    <Story Name="Add to sprint"
           Description="The picker over the series' repositories: plans first, because linking one brings in every task filed under it, later ones too; then the tasks. Narrow it to one repository or search. What the sprint already holds is listed but not offered again. Choosing keeps the dialog open, with a line saying what the last choice did."
           Code="@PickerCode">
        <div class="sb-menu-wide">
            <AppButton Variant="ButtonVariant.Secondary" TestId="sprint-planning-open-picker" OnClick="() => _picking = true">Add to sprint…</AppButton>
            <SprintAddPicker Open="_picking"
                             OpenChanged="value => _picking = value"
                             SprintName="Sprint 42"
                             Repositories="@Repositories"
                             Choices="@Choices"
                             Status="@_added"
                             OnChosen="@((SprintAddChoice choice) => _added = choice.Kind == SprintAddKind.Plan ? $"Linked {choice.Label}." : $"Added “{choice.Label}”.")"
                             TestId="sprint-planning-picker" />
        </div>
    </Story>

    <Story Name="A note and an open question"
           Description="One line kept in the sprint, not on the task, and whether it is an open question — an open question reads its note as the question on the row. Blank clears the note. A refusal stays in the dialog in the module's words."
           Code="@NoteCode">
        <div class="sb-menu-wide">
            <AppButton Variant="ButtonVariant.Secondary" TestId="sprint-planning-open-note" OnClick="() => _noting = true">Edit note…</AppButton>
            <SprintItemNoteDialog Open="_noting"
                                  OpenChanged="value => _noting = value"
                                  TaskTitle="Categorieën"
                                  SprintName="Sprint 42"
                                  Current="@(new SprintItemNote("Import?", true))"
                                  OnSave="@((SprintItemNote note) => { _noting = false; _said = $"Note: {note.Note ?? "none"}, open question: {note.OpenQuestion}"; })"
                                  TestId="sprint-planning-note" />
        </div>
    </Story>

    <Story Name="A task's Sprint section"
           Description="In a task's side panel, beside Sessions and pull requests: how the task stands in the open sprint of its series, and the acts that change that. A task a linked plan brought in offers Add (to keep it when the plan goes) and Unlink; one outside the sprint offers Add and adding its plan; marks and notes only on a member."
           Code="@PanelCode">
        <div class="sb-menu-wide sb-stack">
            <SprintTaskPanel Model="@Added" OnEditNote="@(() => _said = EditNoteSaid)" TestId="sprint-planning-panel-added" />
            <SprintTaskPanel Model="@ThroughPlan" TestId="sprint-planning-panel-plan" />
            <SprintTaskPanel Model="@Outside" TestId="sprint-planning-panel-outside" />
            <SprintTaskPanel Model="@NoSprint" TestId="sprint-planning-panel-none" />
        </div>
    </Story>
</StoryPage>

@code {
    private static readonly DesignGuideline[] Rules =
    [
        new("interaction-guidelines.md#error-states", "Where a refused write says so: in the dialog or above the board, in the module's words."),
        new("color-scheme.md#badge-and-chip-tones", "The tones the Goal badge and the open question wear in the side panel.")
    ];

    private const string EditNoteSaid = "Edit note";

    private string? _said;
    private string? _added;
    private bool _picking;
    private bool _noting;

    private static readonly IReadOnlyList<string> Repositories = ["Fincent", "devbook-marketplace"];

    private static SprintBoardRow Row(string id, string title, SprintRowState state, string plan, bool goal = false, string? note = null, bool question = false) =>
        new(id, title, state, plan, "Fincent", goal, false, [], [], note, question);

    private static readonly SprintBoardRow[] Rows =
    [
        Row("1", "Opdrachtbrief", SprintRowState.Done, "rekeningen", goal: true),
        Row("2", "Categorieën", SprintRowState.InProgress, "rekeningen", goal: true, note: "Import?", question: true),
        Row("3", "Grootboek uitwerken", SprintRowState.NotStarted, "")
    ];

    private static readonly SprintBoardModel Board = new(
        "Fincent team", "Sprint 42", "Mon 5 Oct – Sun 18 Oct", Repositories, true, false,
        "Rekeningen specs shipped", new SprintBoardCounts(1, 1, 0, 0), "+rekeningen", false,
        SprintBoardCounts.Of(Rows), "Day 7 of 10 · 3 working days left", [0, 1, 1], 10,
        "Goal: 1 open with 3 working days left.", ["rekeningen"], Rows);

    private static IReadOnlyList<MenuItem> MenuFor(SprintBoardRow row) =>
    [
        row.IsGoal ? new("ungoal", "Unmark goal") : new("goal", "Mark as goal"),
        new("note", string.IsNullOrWhiteSpace(row.Note) ? "Add a note…" : "Edit note…"),
        row.OpenQuestion ? new("unquestion", "Clear open question") : new("question", "Mark as open question"),
        MenuItem.Divider("remove-divider"),
        string.IsNullOrEmpty(row.Plan) ? new("remove", "Remove from sprint", Destructive: true) : new("unlink", $"Unlink +{row.Plan}", Destructive: true)
    ];

    private static readonly IReadOnlyList<SprintAddChoice> Choices =
    [
        new(SprintAddKind.Plan, "rekeningen", "+rekeningen", "6 tasks", ["Fincent"], InSprint: true),
        new(SprintAddKind.Plan, "verplaatsen-specs", "+verplaatsen-specs", "4 tasks", ["devbook-marketplace"]),
        new(SprintAddKind.Task, "1", "Opdrachtbrief", "Fincent · +rekeningen", ["Fincent"], InSprint: true),
        new(SprintAddKind.Task, "20", "Dashboard brief polish", "Fincent", ["Fincent"]),
        new(SprintAddKind.Task, "21", "Openspec", "devbook-marketplace · +verplaatsen-specs", ["devbook-marketplace"]),
        new(SprintAddKind.Task, "22", "Old migration notes", "Fincent · finished", ["Fincent"])
    ];

    private static readonly SprintTaskPanelModel Added = new("Fincent team", "Sprint 42", "Mon 5 Oct – Sun 18 Oct", SprintMembership.Added, true, "Import?", true, null, false);
    private static readonly SprintTaskPanelModel ThroughPlan = new("Fincent team", "Sprint 42", "Mon 5 Oct – Sun 18 Oct", SprintMembership.ThroughPlan, false, null, false, "rekeningen", true);
    private static readonly SprintTaskPanelModel Outside = new("Fincent team", "Sprint 42", "Mon 5 Oct – Sun 18 Oct", SprintMembership.Outside, false, null, false, "verplaatsen-specs", false);
    private static readonly SprintTaskPanelModel NoSprint = new("Fincent team", null, null, SprintMembership.Outside, false, null, false, null, false);

    private const string RowMenuCode = """
        <SprintBoard Model="@sprint" RowMenu="@MenuFor" OnRowMenu="OnRowMenuAsync">
            <Actions><AppButton OnClick="OpenPicker">Add to sprint…</AppButton></Actions>
        </SprintBoard>
        """;

    private const string PickerCode = """
        <SprintAddPicker Open="@picking" OpenChanged="v => picking = v" SprintName="Sprint 42"
                         Repositories="@series.Repositories" Choices="@choices"
                         Status="@status" Error="@error" Busy="@writing" OnChosen="AddAsync" />
        """;

    private const string NoteCode = """
        <SprintItemNoteDialog Open="@noting" OpenChanged="v => noting = v" TaskTitle="Categorieën"
                              SprintName="Sprint 42" Current="@(new SprintItemNote(note, question))"
                              Error="@error" Busy="@writing" OnSave="SaveNoteAsync" />
        """;

    private const string PanelCode = """
        <SprintTaskPanel Model="@panel" Busy="@writing" Error="@error"
                         OnAdd="AddAsync" OnRemove="RemoveAsync" OnLinkPlan="LinkAsync" OnUnlinkPlan="UnlinkAsync"
                         OnGoalChanged="MarkGoalAsync" OnEditNote="OpenNote" />
        """;
}
