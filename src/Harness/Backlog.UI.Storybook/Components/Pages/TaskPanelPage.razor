    /// <summary>What this story's panel hands to the clipboard: the task as a
    /// reader would paste it, which is the title and the text under it.</summary>
    private const string SlotsCopyValue =
        "Ship the panel behind the backlog list\n\nThe panel says where things go and nothing at all about what they are.";

    private const string SlotsCode = """
        <TaskPanel Title="@task.Title" Done="@task.Done" OnToggle="Toggle" OnRename="Rename"
                   Tags="@task.TagList" OnTagRemoved="RemoveTag">
            @* On the heading line, where the list row shows the same fact. A word
               would have been the Status parameter instead; this product's status
               is a picker, so it is the slot. *@
            <StatusContent>
                <StatusSelector CurrentValue="@task.Status" Options="@Statuses"
                                Label="Change status" OnChanged="ChangeStatus" />
            </StatusContent>

            @* With the tags, because they answer the same question: what kind of
               thing is this, and where is it filed. *@
            <Filing>
                <SelectField CurrentValue="@task.Kind" Options="@Kinds" Label="Change type"
                             CssClass="badge badge--type" OnChanged="ChangeKind" />
                <Badge Kind="source"><code>@task.Path</code></Badge>
            </Filing>

            <Details><TaskActionPane>...</TaskActionPane></Details>

            <Body><MarkdownEditor Value="@task.Body" ValueChanged="ChangeBody" /></Body>

            @* Last, so nothing that acts on the whole task stands between the
               reader and the part of it they came to write. A stack, so a control
               and the thing it revealed can both live here. *@
            <Footer>
                <ToggleButton Pressed="@_sourceOpen" PressedChanged="open => _sourceOpen = open">
                    Source
                </ToggleButton>
                @if (_sourceOpen)
                {
                    <CodeView Source="@task.Raw" Language="markdown" />
                }

                <div class="actions">
                    <IconButton AriaLabel="Close this task" OnClick="Close">×</IconButton>
                    <IconButton AriaLabel="Delete this task" OnClick="Delete">🗑</IconButton>
                </div>
            </Footer>
        </TaskPanel>
        """;

    private const string FocusCode = """
        @* The list hands the keyboard over on Tab off the open row; the panel
           hands it back on Shift+Tab off its first control. Neither side names an
           element in the other. *@
        <TaskListView Tasks="@tasks"
                      SelectedId="@selectedId"
                      OnSelectedTabForward="MoveFocusToPanelAsync" />

        <TaskPanel @ref="_panel"
                   Title="@task.Title"
                   OnToggle="Toggle"
                   OnRename="Rename"
                   OnTabBackward="MoveFocusToListAsync" />

        @code {
            private TaskListView? _list;
            private TaskPanel? _panel;

            // Which control this lands on is the panel's business: the circle when
            // there is one, the title when there is not.
            private Task MoveFocusToPanelAsync() => _panel?.FocusFirstAsync() ?? Task.CompletedTask;

            private Task MoveFocusToListAsync() => _list?.FocusSelectedAsync() ?? Task.CompletedTask;

            // A task created a moment ago has no title, and the front of the panel
            // is the circle that finishes it. This is the way to the one field it
            // cannot be saved without.
            private Task OpenNewTaskAsync() => _panel?.EditTitleAsync() ?? Task.CompletedTask;
        }
        """;

    private const string BareCode = """
        @* No tags, no details, no body, and nobody listening — a heading, and that
           is all it is. *@
        <TaskPanel Title="@task.Title" />
        """;
