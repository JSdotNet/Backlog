@page "/overlays"

<PageTitle>Overlays — Backlog UI Storybook</PageTitle>

<StoryPage Title="Overlays"
           Summary="The things that sit over the screen: a modal you put content in, a confirm dialog that asks one question, a popover of a few occasional controls, and a detail sheet."
           Guidelines="@Rules">

    <Story Name="Modal"
           Description="Opened from a button and closed by the backdrop, Escape, the close button, or a footer action. Focus moves into the dialog, Tab cycles inside it rather than walking out into the page behind, and it comes back to the opening control when the dialog closes."
           Code="@ModalCode">
        <div class="sb-row">
            <AppButton Variant="ButtonVariant.Primary" OnClick="OpenModal" TestId="open-modal">
                Open the modal
            </AppButton>
            <AppButton Variant="ButtonVariant.Secondary" OnClick="() => _noBackdropOpen = true">
                Open one that ignores the backdrop
            </AppButton>
        </div>
        <p class="sb-state" data-testid="modal-state">Last modal result: @(_modalResult ?? "(nothing yet)")</p>

        <Modal Open="_modalOpen"
               OpenChanged="v => _modalOpen = v"
               Title="Rename entry"
               TestId="demo-modal"
               OnClosed="OnModalClosed">
            <ChildContent>
                <div class="sb-stack">
                    <TextField Label="Title"
                               Value="@_title"
                               ValueChanged="v => _title = v"
                               HelpText="Renaming is instant in the product; this dialog exists to show the overlay." />
                </div>
            </ChildContent>
            <Footer>
                <AppButton Variant="ButtonVariant.Ghost" OnClick="CancelModal">Cancel</AppButton>
                <AppButton Variant="ButtonVariant.Primary" OnClick="SaveModal" TestId="modal-save">Save</AppButton>
            </Footer>
        </Modal>

        <Modal Open="_noBackdropOpen"
               OpenChanged="v => _noBackdropOpen = v"
               Title="Backdrop clicks do nothing here"
               CloseOnBackdropClick="false">
            <ChildContent>
                <p>Use Escape or the close button. A dialog that must not be dismissed by accident sets CloseOnBackdropClick to false.</p>
                <p>Click the backdrop first, then press Escape: the click leaves the dialog open and puts the focus back inside it, so the keyboard way out still works.</p>
            </ChildContent>
        </Modal>
    </Story>

    <Story Name="Modal as a host's own dialog"
           Description="Element, BaseClass and the part class hooks let a host keep its existing dialog markup and still get the focus move, the Escape handling and the open/close wiring. Header replaces the default title bar; UseBodyWrapper turns off the body element for a dialog whose styling lays out its children directly."
           Code="@SectionModalCode">
        <div class="sb-row">
            <AppButton Variant="ButtonVariant.Secondary" OnClick="() => _sectionOpen = true" TestId="open-section-modal">
                Open the section dialog
            </AppButton>
        </div>

        <Modal Open="_sectionOpen"
               OpenChanged="v => _sectionOpen = v"
               Element="section"
               BaseClass="sb-dialog"
               BackdropCssClass="sb-backdrop"
               BackdropRole="presentation"
               BackdropTestId="section-modal-backdrop"
               FooterCssClass="sb-dialog__actions"
               UseBodyWrapper="false"
               CloseOnBackdropClick="false"
               TestId="section-modal"
               aria-labelledby="section-modal-title">
            <Header>
                <header class="sb-dialog__header">
                    <div>
                        <p class="sb-dialog__eyebrow">Application updates</p>
                        <h2 id="section-modal-title">Update Backlog</h2>
                    </div>
                    <IconButton AriaLabel="Close the section dialog" OnClick="() => _sectionOpen = false">x</IconButton>
                </header>
            </Header>
            <ChildContent>
                <p class="sb-dialog__description">No body wrapper: this paragraph is a direct child of the dialog, which is what the host's stylesheet expects.</p>
            </ChildContent>
            <Footer>
                <AppButton Variant="ButtonVariant.Ghost" OnClick="() => _sectionOpen = false">Close</AppButton>
            </Footer>
        </Modal>
    </Story>

    <Story Name="ConfirmDialog"
           Description="One question, two answers, and the outcome recorded below so it is visible which callback ran.

Confirm stays open with its button busy until the host's OnConfirm has finished, and closes after: Archive here takes a second and a half, the way a real archive writes a file. While it runs, a second press, Cancel, Escape and the backdrop all do nothing, and the header's ✕ is disabled through Modal's `CloseDisabled`, because the act can no longer be taken back. If OnConfirm fails, the dialog stays open with Confirm usable again."
           Code="@ConfirmCode">
        <div class="sb-row">
            <AppButton Variant="ButtonVariant.Secondary" OnClick="() => _confirmOpen = true" TestId="open-confirm">
                Archive entry
            </AppButton>
            <AppButton Variant="ButtonVariant.Danger" OnClick="() => _destructiveOpen = true" TestId="open-destructive">
                Delete entry
            </AppButton>
        </div>
        <p class="sb-state" data-testid="confirm-state">Last answer: @(_confirmResult ?? "(nothing yet)")</p>

        <ConfirmDialog Open="_confirmOpen"
                       OpenChanged="v => _confirmOpen = v"
                       Title="Archive entry"
                       Message="The entry moves out of the active list. You can bring it back later."
                       ConfirmText="Archive"
                       TestId="confirm-dialog"
                       ConfirmTestId="confirm-dialog-confirm"
                       CancelTestId="confirm-dialog-cancel"
                       OnConfirm="ConfirmArchive"
                       OnCancel="CancelArchive" />

        <ConfirmDialog Open="_destructiveOpen"
                       OpenChanged="v => _destructiveOpen = v"
                       Title="Delete entry"
                       Message="This cannot be undone."
                       ConfirmText="Delete"
                       Destructive="true"
                       TestId="destructive-dialog"
                       ConfirmTestId="destructive-dialog-confirm"
                       CancelTestId="destructive-dialog-cancel"
                       OnConfirm="ConfirmDelete"
                       OnCancel="CancelDelete" />
    </Story>

    <Story Name="PopoverButton"
           Description="A small panel of the host's own controls under a button, for settings somebody flips now and then and would rather not see all day. A disclosure rather than a menu: the trigger carries `aria-expanded` and `aria-controls`, and the panel is a `role=group` holding switches and buttons, not menu items. It is drawn straight after the trigger, so Tab walks into it.

Escape closes it and puts the focus back on the trigger; so does a click anywhere outside, and a second press of the trigger. Flipping a control inside leaves it open. The desktop header puts its Colors and Show archived switches in one."
           Code="@PopoverCode">
        <div class="sb-row">
            <PopoverButton AriaLabel="Display options" TestId="story-popover">
                <Trigger><EllipsisIcon /></Trigger>
                <ChildContent>
                    <Toggle Label="Colors" TestId="story-popover-colours" Checked="_popoverColours" CheckedChanged="v => _popoverColours = v" />
                    <Toggle Label="Show archived" TestId="story-popover-archived" Checked="_popoverArchived" CheckedChanged="v => _popoverArchived = v" />
                </ChildContent>
            </PopoverButton>
        </div>
        <p class="sb-state" data-testid="popover-state">Colors: @(_popoverColours ? "on" : "off") &nbsp;|&nbsp; Show archived: @(_popoverArchived ? "on" : "off")</p>
    </Story>

    <Story Name="PopoverButton closed by the host"
           Description="A row inside the panel that takes the reader somewhere else closes it, the way a link that leaves the page closes it by leaving. The host holds a reference to the popover and calls `CloseAsync` from the row's own handler; the focus goes where the host puts it, not back to the trigger. A switch flipped beside it still leaves the panel open. The Tasks pane's session queue closes this way when a row jumps to its entry or plan. A host whose panel loses the control that held the focus, with nothing left in it to take it, calls `FocusAsync` instead: the focus goes to the trigger and the panel stays open, as the session queue does after its last Cancel."
           Code="@PopoverCloseCode">
        <div class="sb-row">
            <PopoverButton @ref="_jumpPopover" AriaLabel="Recent places" TestId="story-popover-jump">
                <Trigger><ListIcon /></Trigger>
                <ChildContent>
                    <AppButton Variant="ButtonVariant.Ghost" TestId="story-popover-jump-inbox" OnClick="@(() => JumpAsync("Inbox"))">Inbox</AppButton>
                    <AppButton Variant="ButtonVariant.Ghost" TestId="story-popover-jump-roadmap" OnClick="@(() => JumpAsync("Roadmap"))">Roadmap</AppButton>
                </ChildContent>
            </PopoverButton>
        </div>
        <p class="sb-state" data-testid="popover-jump-state">Went to: @(_popoverJumpedTo ?? "nowhere yet")</p>
    </Story>

    @*
        The sheet is the third thing here and the one that is not a takeover. A
        modal stops the page to ask something; a sheet sits beside a surface and
        says more about what was just picked on it, and the reader is expected to
        keep working the surface underneath.

        It is still a dialog, though — and it keeps Tab inside itself, cycling
        rather than walking out into the surface behind it. Modal above does the
        same, out of the same helpers; what differs is when the two let go, since
        a sheet stays in the tree while a dialog removes itself. Give either one
        `RestoreFocusToId` and focus returns to the control that opened it even if
        that control was re-rendered while the overlay was up.
    *@
    <Story Name="Detail sheet"
           Description="Slides in from the right over whatever it is describing. Closed by the backdrop, Escape or the close button; focus moves in on open and returns to the opener on close. Always in the tree, `inert` while closed, so it can animate out."
           Code="@SheetCode">
        <div class="sb-row">
            <AppButton Variant="ButtonVariant.Primary" OnClick="OpenSheet" TestId="open-sheet" id="open-sheet-button">
                Open the sheet
            </AppButton>
        </div>

        <DetailSheet Open="_sheetOpen"
                     OpenChanged="value => _sheetOpen = value"
                     Kicker="Pantry"
                     Title="Butter"
                     Lede="A staple three preparations lean on."
                     RestoreFocusToId="open-sheet-button"
                     TestId="story-detail-sheet">
            <ChildContent>
                <p>The body scrolls and the header does not, so the name of the thing being read about never scrolls away from what is being read.</p>
                <p>Anything can go in here. This one holds prose; the devbook atlas puts a chapter's facts and the links in and out of it in the same space.</p>
            </ChildContent>
            <Footer>
                <RecordPager Index="1" Total="5" AriaLabel="Ingredients" TestId="story-sheet-pager" />
            </Footer>
        </DetailSheet>
    </Story>

    @*
        The same sheet while work it started is still running. Dismissible=false
        is the hook for that: the close button disables, and Escape and the
        backdrop do nothing, until the work ends and the result can be read where
        it was asked for. The phone's update window holds itself open this way
        while an install is in flight.
    *@
    <Story Name="Detail sheet held open while busy"
           Description="`Dismissible` set to false while its work runs: the close button is disabled and Escape and the backdrop are inert. Finish the work and all three close it again."
           Code="@BusySheetCode">
        <div class="sb-row">
            <AppButton Variant="ButtonVariant.Primary" OnClick="OpenBusySheet" TestId="open-busy-sheet" id="open-busy-sheet-button">
                Open the sheet
            </AppButton>
        </div>

        <DetailSheet Open="_busySheetOpen"
                     OpenChanged="value => _busySheetOpen = value"
                     Kicker="Application updates"
                     Title="Update Backlog"
                     Dismissible="@(!_busySheetWorking)"
                     RestoreFocusToId="open-busy-sheet-button"
                     TestId="story-busy-sheet">
            <div class="sb-row">
                <AppButton Variant="ButtonVariant.Primary" Disabled="_busySheetWorking" OnClick="() => _busySheetWorking = true" TestId="busy-sheet-start">
                    @(_busySheetWorking ? "Installing..." : "Start the work")
                </AppButton>
                <AppButton Variant="ButtonVariant.Secondary" Disabled="!_busySheetWorking" OnClick="() => _busySheetWorking = false" TestId="busy-sheet-finish">
                    Finish it
                </AppButton>
            </div>
        </DetailSheet>
    </Story>

</StoryPage>

@code {
    private bool _popoverColours;
    private bool _popoverArchived;

    private const string PopoverCode = """
        <PopoverButton AriaLabel="Display options">
            <Trigger><EllipsisIcon /></Trigger>
            <ChildContent>
                <Toggle Label="Colors" @bind-Checked="_colours" />
                <Toggle Label="Show archived" @bind-Checked="_archived" />
            </ChildContent>
        </PopoverButton>
        """;

    private PopoverButton? _jumpPopover;
    private string? _popoverJumpedTo;

    private async Task JumpAsync(string place)
    {
        _popoverJumpedTo = place;
        if (_jumpPopover is not null) await _jumpPopover.CloseAsync();
    }

    private const string PopoverCloseCode = """
        <PopoverButton @ref="_places" AriaLabel="Recent places">
            <Trigger><ListIcon /></Trigger>
            <ChildContent>
                <AppButton Variant="ButtonVariant.Ghost" OnClick="@(() => GoAsync("Inbox"))">Inbox</AppButton>
            </ChildContent>
        </PopoverButton>

        @code {
            private PopoverButton? _places;

            private async Task GoAsync(string place)
            {
                Navigate(place);
                if (_places is not null) await _places.CloseAsync();
            }

            // The panel's last row went away under the focus: the trigger takes it.
            private async Task AfterLastRowRemovedAsync()
            {
                if (_places is not null) await _places.FocusAsync();
            }
        }
        """;

    private bool _sheetOpen;

    private void OpenSheet() => _sheetOpen = true;

    private bool _busySheetOpen;
    private bool _busySheetWorking;

    private void OpenBusySheet() => _busySheetOpen = true;

    private const string BusySheetCode = """
        <DetailSheet Open="_open"
                     OpenChanged="value => _open = value"
                     Title="Update Backlog"
                     Dismissible="@(!_working)">
            ...
        </DetailSheet>
        """;

    private const string SheetCode = """
        <DetailSheet Open="_sheetOpen"
                     OpenChanged="value => _sheetOpen = value"
                     Kicker="Pantry"
                     Title="Butter"
                     Lede="A staple three preparations lean on."
                     RestoreFocusToId="open-sheet-button">
            <ChildContent>...</ChildContent>
            <Footer>
                <RecordPager Index="1" Total="5" AriaLabel="Ingredients" />
            </Footer>
        </DetailSheet>
        """;

    private static readonly DesignGuideline[] Rules =
    [
        new("interaction-guidelines.md#focus-and-selection", "Where focus goes when a dialog opens and closes."),
        new("interaction-guidelines.md#motion-and-reduced-motion", "How a dialog may appear, and what it does under reduced motion."),
        new("typography-and-layout.md#z-index-scale", "What is allowed to sit above what."),
        new("accessibility.md#keyboard-navigation", "Escape, the focus trap, and the return path."),
        new("interaction-guidelines.md#busy-actions", "Why a confirmed act keeps its dialog open, busy, until it has finished.")
    ];

    private bool _modalOpen;
    private bool _noBackdropOpen;
    private bool _sectionOpen;
    private bool _confirmOpen;
    private bool _destructiveOpen;
    private string _title = "Storybook for Backlog.UI.Components";
    private string? _modalResult;
    private string? _confirmResult;

    private void OpenModal()
    {
        _modalResult = null;
        _modalOpen = true;
    }

    private void SaveModal()
    {
        _modalOpen = false;
        _modalResult = $"saved \"{_title}\"";
    }

    private void CancelModal()
    {
        _modalOpen = false;
        _modalResult = "cancelled";
    }

    // Fires for every close route the modal owns — backdrop, Escape, close
    // button — but not for the footer actions, which set their own result first.
    private void OnModalClosed() => _modalResult ??= "closed";

    private async Task ConfirmArchive()
    {
        await Task.Delay(TimeSpan.FromSeconds(1.5));
        _confirmResult = "archive confirmed";
    }

    private void CancelArchive() => _confirmResult = "archive cancelled";

    private void ConfirmDelete() => _confirmResult = "delete confirmed";

    private void CancelDelete() => _confirmResult = "delete cancelled";

    private const string ModalCode = """
        <Modal Open="_open" OpenChanged="v => _open = v" Title="Rename entry">
            <ChildContent><TextField Label="Title" @bind-Value="_title" /></ChildContent>
            <Footer><AppButton Variant="ButtonVariant.Primary" OnClick="Save">Save</AppButton></Footer>
        </Modal>
        """;

    private const string SectionModalCode = """
        <Modal Open="_open" OpenChanged="v => _open = v"
               Element="section" BaseClass="app-update-dialog"
               BackdropCssClass="app-update-backdrop" UseBodyWrapper="false"
               aria-labelledby="app-update-title">
            <Header>
                <header class="app-update-dialog__header">
                    <p class="app-update-dialog__eyebrow">Application updates</p>
                    <h2 id="app-update-title">Update Backlog</h2>
                </header>
            </Header>
            <ChildContent><p class="app-update-dialog__description">...</p></ChildContent>
        </Modal>
        """;

    private const string ConfirmCode = """
        <ConfirmDialog Open="_open" OpenChanged="v => _open = v"
                       Title="Delete entry" Message="This cannot be undone."
                       ConfirmText="Delete" Destructive="true"
                       OnConfirm="Delete" OnCancel="Keep" />
        """;
}
