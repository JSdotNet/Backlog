@page "/layout"

<PageTitle>Layout — Backlog UI Storybook</PageTitle>

<StoryPage Title="Layout"
           Summary="The containers: tabs, cards, section headers, a disclosure, and a two-pane split with a separator that answers to both the pointer and the keyboard — and the scrollbar all of them wear once their content outgrows them.">

    <Story Name="Tabs and TabPanel"
           Description="Panels register themselves with the strip, so the tab order comes from the markup. Arrow keys, Home and End move between tabs; the strip is one tab stop."
           Code="@TabsCode">
        <Tabs ActiveId="@_activeTab"
              ActiveIdChanged="id => _activeTab = id"
              AriaLabel="Entry views"
              TestId="demo-tabs">
            <TabPanel Id="read" Title="Read">
                <p>The read view of an entry. This is where MarkdownView lives.</p>
            </TabPanel>
            <TabPanel Id="edit" Title="Edit">
                <TextArea Label="Body" Value="@_body" ValueChanged="v => _body = v" Rows="4" AutoGrow="false" />
            </TabPanel>
            <TabPanel Id="history" Title="History">
                <p>Nothing to show in a storybook, but the panel is real.</p>
            </TabPanel>
            <TabPanel Id="locked" Title="Locked" Disabled="true">
                <p>Never reachable — a disabled tab is skipped by the arrows too.</p>
            </TabPanel>
        </Tabs>
        <p class="sb-state" data-testid="tabs-state">Active tab: @_activeTab</p>
    </Story>

    <Story Name="Tabs wearing a host's own classes"
           Description="Every class hook replaces ours instead of adding to it, so a host that already ships a pill strip keeps its own names. Bare drops the wrappers as well, for a host whose layout already places the strip and the panels; the arrow keys still work."
           Code="@PillTabsCode">
        <Tabs Bare="true"
              ListElement="nav"
              ListCssClass="sb-pill-strip"
              ListTestId="pill-tabs-list"
              TabCssClass="sb-pill"
              ActiveTabCssClass="sb-pill sb-pill--active"
              AriaLabel="Repository pages"
              ActiveId="@_activePill"
              ActiveIdChanged="id => _activePill = id">
            <TabPanel Id="backlog"
                      Element="section"
                      BaseClass="sb-surface"
                      TabTestId="pill-tab"
                      TestId="pill-panel-backlog">
                <TitleContent>
                    <span>JSdotNet/Backlog</span>
                    <span class="sb-pill__count">12</span>
                </TitleContent>
                <ChildContent>
                    <p>The tab label is a fragment here, so it can carry a count beside the name.</p>
                </ChildContent>
            </TabPanel>
            <TabPanel Id="docs"
                      Element="section"
                      BaseClass="sb-surface"
                      TabTestId="pill-tab"
                      TestId="pill-panel-docs">
                <TitleContent>
                    <span>JSdotNet/Backlog-docs</span>
                    <span class="sb-pill__count">3</span>
                </TitleContent>
                <ChildContent>
                    <p>The panel is a section rather than a div, because the host's stylesheet says so.</p>
                </ChildContent>
            </TabPanel>
        </Tabs>
        <p class="sb-state" data-testid="pill-tabs-state">Active subpage: @_activePill</p>
    </Story>

    <Story Name="Card"
           Description="A titled surface with an optional action area, and a compact variant for dense lists."
           Code="@CardCode">
        <div class="sb-grid">
            <Card Title="Entry" TestId="card-default">
                <Actions>
                    <IconButton AriaLabel="Entry actions" Title="Entry actions">⋯</IconButton>
                </Actions>
                <ChildContent>
                    <p>A card holds one thing. The actions slot is where the buttons for that thing go.</p>
                    <div class="sb-row">
                        <StatusBadge Status="ready" />
                        <PriorityBadge Priority="high" />
                    </div>
                </ChildContent>
            </Card>
            <Card Title="Compact" Compact="true" TestId="card-compact">
                <p>Same card, less padding.</p>
            </Card>
            <Card AriaLabel="Untitled card">
                <p>No title — the card is labelled for assistive technology instead.</p>
            </Card>
        </div>
    </Story>

    <Story Name="SectionHeader"
           Description="A heading with its own level, so a page can nest sections without breaking the document outline."
           Code="@SectionCode">
        <div class="sb-stack">
            <SectionHeader Title="Backlog" Level="2" Description="Everything captured, newest first.">
                <Actions>
                    <AppButton Variant="ButtonVariant.Primary" Size="ButtonSize.Small">New</AppButton>
                </Actions>
            </SectionHeader>
            <SectionHeader Title="Archived" Level="3" Description="Kept, but out of the way." />
        </div>
    </Story>

    <Story Name="FoldControl"
           Description="ChildContent is the region that folds, and the trigger shows and hides it. It used to be the label instead, so this example rendered a Toggle and a TextField inside the <button> and clicking folded nothing — the control looked misaligned because form controls were being laid out inside a trigger, and looked dead because there was no region."
           Code="@FoldCode">
        <div class="sb-stack">
            <FoldControl Expanded="_foldOpen"
                         ExpandedChanged="v => _foldOpen = v"
                         Label="Advanced settings"
                         TestId="fold-demo">
                <div class="sb-stack">
                    <Toggle Checked="true" Label="Keep entries local" Disabled="true" />
                    <TextField Label="Sync interval (minutes)" Type="number" Value="15" Readonly="true" />
                </div>
            </FoldControl>
            <FoldControl Expanded="false" Label="Disabled disclosure" Disabled="true">
                <p>Never reachable.</p>
            </FoldControl>
            <p class="sb-state" data-testid="fold-state">Expanded: @_foldOpen</p>
        </div>
    </Story>

    <Story Name="FoldControl over a region the host owns"
           Description="With no ChildContent only the trigger is emitted, and Controls points at an element the page renders itself — which is how a card folds a body it already lays out."
           Code="@FoldHostCode">
        <div class="sb-stack">
            <FoldControl Expanded="_hostFoldOpen"
                         ExpandedChanged="v => _hostFoldOpen = v"
                         Label="Acceptance criteria"
                         Controls="fold-host-region"
                         TestId="fold-host" />
            <div id="fold-host-region" class="sb-surface" hidden="@(!_hostFoldOpen)">
                <p>Rendered and hidden by the page, not by the control.</p>
            </div>
        </div>
    </Story>

    <Story Name="SplitPane"
           Description="Drag the separator, or focus it and use Left/Right, PageUp/PageDown, Home/End. Every drag in this product owes the keyboard an equivalent, and this is that equivalent."
           Code="@SplitCode">
        <SplitPane FixedWidthRem="_startWidth"
                   FixedWidthRemChanged="v => _startWidth = v"
                   MinRem="12"
                   MaxRem="48"
                   AriaLabel="Storybook pane width"
                   CssClass="sb-pane"
                   TestId="demo-split"
                   SeparatorTestId="demo-split-separator">
            <Start>
                <div class="sb-surface">
                    <p class="sb-label">Start pane</p>
                    <p>Its width is the page's state, committed once the drag settles.</p>
                </div>
            </Start>
            <End>
                <div class="sb-surface">
                    <p class="sb-label">End pane</p>
                    <p>Takes whatever is left.</p>
                </div>
            </End>
        </SplitPane>
        <p class="sb-state" data-testid="split-state">Start width: @_startWidth.ToString("0.##") rem</p>
    </Story>

    <Story Name="SplitPane, anchored to the end"
           Description="The other shape: a panel of a settled width beside content that takes every pixel the panel does not need. Anchor decides which pane the bound width belongs to, and it moves the grid template and the resizer&#39;s `data-pane-anchor` hint together — one decision, because a grid whose fixed column is last while the attribute still says “start” is a drag that runs backwards.

Left and Right still describe the separator rather than the number, so here Left is the arrow that makes the panel wider. That is not a special case: it is the same gesture as before, and the number under it goes up instead of down because the pane it measures is fixed to the other edge. Home and End are about the value&#39;s ends rather than the screen&#39;s, so they mean the same thing in both anchors."
           Code="@SplitEndCode">
        <SplitPane Anchor="SplitPaneAnchor.End"
                   FixedWidthRem="_endWidth"
                   FixedWidthRemChanged="v => _endWidth = v"
                   MinRem="12"
                   MaxRem="48"
                   AriaLabel="Storybook panel width"
                   CssClass="sb-pane"
                   TestId="demo-split-end"
                   SeparatorTestId="demo-split-end-separator">
            <Start>
                <div class="sb-surface">
                    <p class="sb-label">Start pane</p>
                    <p>Takes whatever is left, and gets wider as the window does.</p>
                </div>
            </Start>
            <End>
                <div class="sb-surface">
                    <p class="sb-label">End pane</p>
                    <p>Fixed. One thing is shown here, and one thing does not need more room in a bigger window.</p>
                </div>
            </End>
        </SplitPane>
        <p class="sb-state" data-testid="split-end-state">End width: @_endWidth.ToString("0.##") rem</p>
    </Story>

    <Story Name="Scrollbar"
           Description="Not a component but the chrome every overflowing region wears, and nothing opts into it. The thumb is --color-border and lifts to --color-border-strong on hover; track and corner stay transparent so a scrolling panel gains no second edge. Firefox reads scrollbar-width and scrollbar-color, Chromium and WebView2 the ::-webkit-scrollbar pseudo-elements. A region whose content must not jump sideways as the bar appears adds scrollbar-gutter: stable. Both boxes below take tab focus, because a region a mouse can scroll a keyboard has to be able to reach."
           Code="@ScrollCode">
        <div class="sb-columns">
            <div class="sb-stack">
                <p class="sb-label">Vertical</p>
                <div class="sb-scroll" tabindex="0" role="region" aria-label="Vertical scroll example" data-testid="scroll-vertical">
                    <p>An entry list is the usual reason a panel scrolls: the backlog is longer than the pane holding it, and the bar is the only chrome that says so.</p>
                    <p>The thumb sits inside a transparent border, so it reads as a floating pill rather than a channel cut into the surface.</p>
                    <p>Hover it and it brightens one step up the border ramp.</p>
                </div>
            </div>
            <div class="sb-stack">
                <p class="sb-label">Both axes</p>
                <div class="sb-scroll" tabindex="0" role="region" aria-label="Two-axis scroll example" data-testid="scroll-both">
                    <div class="sb-scroll__wide">
                        <p>A code block or a wide table overflows in both directions at once, which is the only time the corner between the two bars is visible.</p>
                        <p>It is transparent too, so the corner shows the surface underneath instead of a grey square.</p>
                        <p>This paragraph is wider than the box on purpose.</p>
                    </div>
                </div>
            </div>
        </div>
    </Story>

</StoryPage>

@code {
    private string _activeTab = "read";
    private string _activePill = "backlog";
    private string _body = "The editor and the read view are two tabs over the same text.";
    private bool _foldOpen = true;
    private bool _hostFoldOpen;
    private double _startWidth = 20;

    /// <summary>Held apart from the start-anchored story's width so the two
    /// separators cannot move each other — they are two layouts on one page, not one
    /// layout twice.</summary>
    private double _endWidth = 20;

    private const string TabsCode = """
        <Tabs ActiveId="@_activeTab" ActiveIdChanged="id => _activeTab = id" AriaLabel="Entry views">
            <TabPanel Id="read" Title="Read">...</TabPanel>
            <TabPanel Id="edit" Title="Edit">...</TabPanel>
        </Tabs>
        """;

    private const string PillTabsCode = """
        <Tabs Bare="true" ListElement="nav"
              ListCssClass="settings-tabs" TabCssClass="settings-tab"
              ActiveTabCssClass="settings-tab settings-tab--active"
              ActiveId="@_active" ActiveIdChanged="id => _active = id">
            <TabPanel Id="backlog" Element="section" BaseClass="setting" TabTestId="pill-tab">
                <TitleContent><span>JSdotNet/Backlog</span></TitleContent>
                <ChildContent>...</ChildContent>
            </TabPanel>
        </Tabs>
        """;

    private const string CardCode = """
        <Card Title="Entry">
            <Actions><IconButton AriaLabel="Entry actions">⋯</IconButton></Actions>
            <ChildContent>...</ChildContent>
        </Card>
        """;

    private const string SectionCode = """
        <SectionHeader Title="Backlog" Level="2" Description="Everything captured, newest first." />
        """;

    private const string FoldCode = """
        <FoldControl Expanded="_open" ExpandedChanged="v => _open = v" Label="Advanced settings">
            @* ChildContent is the region that folds, not the trigger's label. *@
            <Toggle Checked="_local" CheckedChanged="v => _local = v" Label="Keep entries local" />
        </FoldControl>
        """;

    private const string FoldHostCode = """
        <FoldControl Expanded="_open" ExpandedChanged="v => _open = v"
                     Label="Acceptance criteria" Controls="criteria" />
        <div id="criteria" hidden="@(!_open)">...</div>
        """;

    private const string ScrollCode = """
        @* Nothing to opt into — components.css dresses every scrolling region. *@
        <div class="entry-list" tabindex="0" role="region" aria-label="Entries">...</div>

        /* app.css, where the content must not shift as the bar appears */
        .entry-list { overflow: auto; scrollbar-gutter: stable; }
        """;

    private const string SplitCode = """
        <SplitPane FixedWidthRem="_startWidth" FixedWidthRemChanged="v => _startWidth = v"
                   MinRem="12" MaxRem="48" AriaLabel="Storybook pane width">
            <Start>...</Start>
            <End>...</End>
        </SplitPane>
        """;

    private const string SplitEndCode = """
        @* The bound width is whichever pane Anchor names, so this is the end one. *@
        <SplitPane Anchor="SplitPaneAnchor.End"
                   FixedWidthRem="_width" FixedWidthRemChanged="v => _width = v"
                   MinRem="12" MaxRem="48">
            <Start>...takes what is left...</Start>
            <End>...fixed...</End>
        </SplitPane>
        """;
}
