@page "/task-list"

<PageTitle>Task list — Backlog UI Storybook</PageTitle>

<StoryPage Title="Task list"
           Summary="The controls a list of things-to-do is made of: `TaskItem` — a row with a circle, a title that renames in place, a copy button and, where a host is listening for one, a bin — and `TaskListView`, which adds the reordering and the Completed section. The pane a row opens into is Task side panel, next door; the fields a date, a time or a repeat is set with are on Inputs, along with `TaskAction`. Components only: nothing here decides what a task is, when a reminder fires, or what My Day means tomorrow."
           Guidelines="@Rules">

    <Story Name="A task, as a row"
           Description="`Task` is the record, `OnToggle` completes it, and `AllowCopy` is on by default. The circle is a real checkbox to anything listening; the copy button acts on the task's text and stops the click before the row sees it. It reads behind the state — after the metadata, after the pencil and after whatever the host puts in `RowActions` — because everything ahead of it says what the task is, and copying is the one act that takes the task away with you. The bin stays last.

Everything the row knows about itself rides on one metadata line, and absent facts are left out rather than filled in. What that line puts first is the rule linked above."
           Code="@RowCode">
        <div class="sb-menu-wide" data-testid="task-list-rows">
            <TaskListView Tasks="@Sample"
                          OnToggle="Toggle"
                          OnSelected="Select"
                          OnRename="Rename"
                          SelectedId="@_selectedId"
                          AriaLabel="Sample tasks"
                          TestId="task" />
        </div>
        <p class="sb-state" data-testid="task-list-selected">Selected: @(_selectedId ?? "(none)")</p>
    </Story>

    <Story Name="Renaming in place"
           Description="The pencil turns the title into a field where the title was, so the row does not change height. Enter commits, Escape abandons, clicking away commits.

The draft is held in the row and reported through `OnRename` only when it settles — an empty title and an unchanged one are both left unraised, because neither is a rename."
           Code="@RenameCode">
        <div class="sb-menu-wide" data-testid="task-list-rename">
            <TaskListView Tasks="@_renamable" OnToggle="_ => { }" OnRename="RenameOne" AriaLabel="Renamable tasks" TestId="rename" />
        </div>
        <p class="sb-state" data-testid="task-list-renamed">@(_lastRename ?? "nothing renamed yet")</p>
    </Story>

    <Story Name="Renaming with no pencil to press first"
           Description="`DirectRename` makes the title a field from the start, for a surface whose subject is this one row. A list keeps its pencil.

It settles on the same terms: Enter commits, clicking away commits, Escape puts the title back. The rows below are also reorderable, which is the part worth trying — a draggable element swallows the pointer inside its own inputs, so the field turns the drag off while the caret is in it."
           Code="@DirectRenameCode">
        <div class="sb-menu-wide" data-testid="task-list-direct">
            <TaskListView Tasks="@_directRenamable"
                          OnRename="RenameDirect"
                          DirectRename="true"
                          Reorderable="true"
                          OnReorder="ReorderDirect"
                          AriaLabel="Directly renamable tasks"
                          TestId="direct" />
        </div>
        <p class="sb-state" data-testid="task-list-direct-state">@(_lastDirect ?? "nothing renamed or moved yet")</p>
    </Story>

    <Story Name="Quick edit, straight down the list"
           Description="`QuickEdit` makes Tab commit this row and open the field on the row below it; Shift+Tab walks back up. `OnEditMove` is where the list reports which way it went.

The field arrives with the caret in it and the title selected, so the first keystroke replaces the old title — the same way the pencil opens it."
           Code="@QuickEditCode">
        <div class="sb-menu-wide" data-testid="task-list-quick-edit">
            <TaskListView Tasks="@_quick"
                          QuickEdit="true"
                          OnRename="RenameQuick"
                          OnAdd="AddQuick"
                          AddLabel="Add a task"
                          AriaLabel="Quick edit tasks"
                          TestId="quick" />
        </div>
        <p class="sb-state" data-testid="task-list-quick-edit-renames">@(_quickSettled.Count == 0 ? "nothing settled yet" : string.Join(" → ", _quickSettled))</p>
    </Story>

    <Story Name="Deleting a row"
           Description="`OnDelete` puts a bin on the end of every row, and the delegate is what puts it there: a list that passes none grows none, which is how the desktop pane's entry list — where an entry is deleted from the footer of the open one — stays bin-free. The id goes out and the host decides what deleting means — nothing is applied here, exactly as with a rename or a reorder.

No confirmation. Whether a delete needs one is the host's answer and not a row's, and in this product the entry-level bin asks for nothing either.

The half worth trying with the keyboard is where the focus goes, because the element holding it is the one that disappears. Tab to a bin and press it: from the middle of the list the ring lands on the row that slid up into the gap, from the bottom row it lands on the row above, and from the last row left it lands in the add row. Each delete is also announced through the list's live region — a row that has gone is invisible to a screen reader otherwise."
           Code="@DeleteCode">
        <div class="sb-menu-wide" data-testid="task-list-delete">
            <TaskListView Tasks="@_deletable"
                          QuickEdit="true"
                          OnRename="RenameDeletable"
                          OnAdd="AddDeletable"
                          AddLabel="Add a task"
                          OnDelete="Delete"
                          AriaLabel="Deletable tasks"
                          TestId="delete" />
        </div>
        <p class="sb-state" data-testid="task-list-deleted">@(_lastDeleted ?? "nothing deleted yet")</p>
    </Story>

    <Story Name="The host's own row above Completed"
           Description="`AfterOpenRows` is the host's slot in the list: under the open rows, above the Completed section. Unfilled it renders nothing at all.

Tick a row and watch the slot stay put while the section grows beneath it. A slot rather than an `AddLabel` parameter, because what a host adds and what it calls it is not a list this library can finish."
           Code="@SlotCode">
        <div class="sb-menu-wide" data-testid="task-list-slot">
            <TaskListView Tasks="@_slotted"
                          OnToggle="ToggleSlotted"
                          AriaLabel="With a host's own row"
                          TestId="slot">
                <AfterOpenRows>
                    <AppButton BaseClass="btn btn--ghost"
                               Size="ButtonSize.Small"
                               TestId="slot-add"
                               OnClick="AddSlotted">
                        + New task
                    </AppButton>
                </AfterOpenRows>
            </TaskListView>
        </div>
    </Story>

    <Story Name="Tags, dates, reminders and repeats"
           Description="Each fact on the metadata line carries a glyph, and the glyph is decoration on top of the words: a screen reader hears “Reminder 09:00”, never “alarm clock emoji”. Tags render as chips rather than as more of that line.

Which facts come forward, which stay quiet, and what happens to the line on a finished row are the rules linked above. The fields that set these values are on Inputs."
           Code="@TagCode">
        <div class="sb-menu-wide" data-testid="task-list-facts">
            <TaskListView Tasks="@Facts" OnToggle="_ => { }" AriaLabel="Tasks with facts" TestId="facts" />
        </div>
    </Story>

    <Story Name="Done moves to Completed"
           Description="`TaskListView` owns the Completed section: a finished row leaves the list and joins it, behind a count that folds. Folded by default.

Tick a row above and watch the count go up; open the section and untick one to send it back. A completed row cannot be dragged."
           Code="@CompletedCode">
        <div class="sb-menu-wide" data-testid="task-list-completed">
            <TaskListView Tasks="@_completable"
                          OnToggle="ToggleCompletable"
                          Reorderable="true"
                          OnReorder="ReorderCompletable"
                          AriaLabel="With a completed section"
                          TestId="done" />
        </div>
    </Story>

    <Story Name="The row on its own"
           Description="`TaskItem` without a list around it, for a host that has its own. It renders an `li`, so it wants a list element as its parent; the list it usually gets is `TaskListView`, which adds the reordering and nothing else.

`Selected` is the host's to set — which row is open is a fact about the pane beside the list, not about the row."
           Code="@ItemCode">
        <ul class="task-list sb-menu-wide" data-testid="task-list-single">
            <TaskItem Task="@Single"
                      OnToggle="_ => { }"

                      OnSelected="_ => { }"
                      TestId="single" />
            <TaskItem Task="@SingleSelected" Selected="true" OnToggle="_ => { }" TestId="single-selected" />
        </ul>
    </Story>

    <Story Name="Done, important, in my day, and where it has got to"
           Description="Three flags on the record — `Done`, `Important` and `InMyDay` — and one word, `Status`. `Important` has no control on the row today: the row carries the flag and whatever sets it is the host's.

`Status` is a badge beside the title rather than another glyph on the metadata line below it, and that placement is the decision worth stating. The line under a title says when the task happens and how far through it is; a status says what the task currently *is*, which is what the title is doing — so it reads on the title's line, drawn by the same `StatusBadge` that `TaskPanel` puts beside its heading. A reader who opens a row into a panel then finds the same fact in the same shape in the same place, rather than having to look for it again.

Already formatted, like `Due` and `Reminder`: what a status is called, and in what language, is the host's. Absent leaves the badge off entirely, because not every list has a lifecycle — a checklist of sub-items has none at all, and a row drawing an empty badge would claim a state nobody set.

A finished task stays readable rather than hidden; how it is set is the rule linked above."
           Code="@StatesCode">
        <div class="sb-menu-wide" data-testid="task-list-states">
            <TaskListView Tasks="@States" OnToggle="_ => { }" AriaLabel="Task states" TestId="state" />
        </div>
    </Story>

    <Story Name="Reordering, by pointer and by key"
           Description="`Reorderable` turns the grip on, and `OnReorder` reports one `TaskMove` when the move settles: what moved, and onto what. Applying it is the host's, because only the host knows whether the new order is saved anywhere — `TaskMove.ApplyTo` is offered for a host with no opinion.

While a row is in flight the list shows the order the drop would produce. The keys that do the same thing without a pointer, and what the drop indicator has to be, are the rules linked above."
           Code="@ReorderCode">
        <div class="sb-menu-wide" data-testid="task-list-reorder">
            <TaskListView Tasks="@_ordered"
                          Reorderable="true"
                          OnToggle="ToggleOrdered"
                          OnReorder="Reorder"
                          AriaLabel="Reorderable tasks"
                          TestId="reorder" />
        </div>
        <p class="sb-state" data-testid="task-list-order">@string.Join(" → ", _ordered.Select(t => t.Title))</p>
    </Story>

    <Story Name="The host's own controls on a row"
           Description="`RowActions` is a slot at the end of the row, after the copy button, and it is handed the task it is about. Clicks stop at the slot, the same way they stop at the pencil.

Unset, a row renders exactly the markup it rendered before the slot existed."
           Code="@RowActionCode">
        <div class="sb-menu-wide" data-testid="task-list-row-actions">
            <TaskListView Tasks="@Sample"
                          OnToggle="_ => { }"
                          AllowCopy="false"
                          AriaLabel="Tasks with host actions"
                          TestId="row-actions"
                          RowActions="@(task => HostActions(task))" />
        </div>
        <p class="sb-state" data-testid="task-list-row-action-state">@(_lastAction ?? "Nothing pressed yet.")</p>
    </Story>

    <Story Name="What a row copies, decided by the host"
           Description="`RowCopyValue` is asked per row, and answering `null` leaves that row copying what it always copied — its title, and its body under it when it has one.

It exists for the row that was projected from a document the task itself does not carry. A backlog entry is the case: its row deliberately has no `Body`, because a body would give every row in the column a disclosure, so a copy left to the default would hand over a bare title instead of the brief somebody came to paste. The pane holding the markdown is the only thing that can answer, which is the same bargain `RowCssClass` makes."
           Code="@RowCopyValueCode">
        <div class="sb-menu-wide" data-testid="task-list-row-copy-value">
            <TaskListView Tasks="@Sample"
                          OnToggle="_ => { }"
                          RowCopyValue="@SampleCopyText"
                          AriaLabel="Tasks with host-supplied copy text"
                          TestId="row-copy-value" />
        </div>
        <p class="sb-state" data-testid="task-list-row-copy-value-note">The last row answers null, so it copies its own title.</p>
    </Story>

    <Story Name="Nothing to toggle, nothing to copy"
           Description="A row with no `OnToggle` renders its circle as state rather than as a control — the same rule `MarkdownView` follows for a checklist. `AllowCopy=&quot;false&quot;` is how a host with nowhere to paste turns the copy button off.">
        <div class="sb-menu-wide" data-testid="task-list-readonly">
            <TaskListView Tasks="@ReadOnlySample" AriaLabel="Read-only tasks" TestId="readonly" />
        </div>
    </Story>

    <Story Name="An empty list"
           Description="`EmptyMessage` is the caller's: what to say when there is nothing here depends on why there is nothing here.">
        <div class="sb-columns" data-testid="task-list-empty">
            <div class="sb-menu-wide">
                <TaskListView Tasks="@(Array.Empty<TaskRow>())" AriaLabel="Empty" />
            </div>
            <div class="sb-menu-wide">
                <TaskListView Tasks="@(Array.Empty<TaskRow>())"
                              EmptyMessage="Nothing due today. Add something, or go and do something else."
                              AriaLabel="Empty with a message" />
            </div>
        </div>
    </Story>

    <Story Name="What is deliberately not here"
           Description="The list of things a component would have had to guess, and which the product should decide first. Each of them is a parameter or a callback today rather than behaviour.">
        <dl class="sb-grid" data-testid="task-list-open-questions">
            @foreach (var question in OpenQuestions)
            {
                <div class="sb-stack">
                    <dt class="sb-label">@question.Name</dt>
                    <dd><p>@question.Detail</p></dd>
                </div>
            }
        </dl>
    </Story>

</StoryPage>

@code {
    private static readonly DesignGuideline[] Rules =
    [
        new("interaction-guidelines.md#task-rows", "What a row states, in what order, and what goes quiet when."),
        new("interaction-guidelines.md#drag-and-drop-reordering", "The grip, the drop indicator and what may be dragged."),
        new("interaction-guidelines.md#keyboard-accessible-reordering", "The keys that move a row without a pointer."),
        new("interaction-guidelines.md#auto-save-no-save-buttons", "Why a rename and a tick commit without asking."),
        new("content-editing.md#backlog-entry-structure", "The file a row is read out of and written back to."),
        new("typography-and-layout.md#metadata-lines", "How dates, repeats and tags are set beside a title.")
    ];

    private sealed record OpenQuestion(string Name, string Detail);

    private string? _selectedId;

    private IReadOnlyList<TaskRow> _sample =
    [
        new("owners", "Code owners", Group: "Tasks"),
        new("heerlen", "Heerlen features", Group: "Tasks", StepsDone: 0, StepCount: 7),
        new("martijn", "Afstemmen met Martijn", Group: "Tasks", Due: "Today", StepsDone: 0, StepCount: 7, Important: true),
        new("docs", "docs/src/content/docs", Group: "Tasks", Due: "Today", InMyDay: true),
        new("spec", "Spec manager", Group: "Tasks", Due: "Today", StepsDone: 0, StepCount: 1),
        new("deploy", "Deploy SpecManager", Group: "Tasks", Due: "Today", Reminder: "09:00")
    ];

    private IReadOnlyList<TaskRow> Sample => _sample;

    private string? _lastRename;

    private IReadOnlyList<TaskRow> _renamable =
    [
        new("r1", "Click the pencil to rename me", Group: "Tasks"),
        new("r2", "Escape puts this one back", Group: "Tasks")
    ];

    private string? _lastDirect;

    private IReadOnlyList<TaskRow> _directRenamable =
    [
        new("x1", "Type in me — there is no pencil", Group: "Steps"),
        new("x2", "Alt+Down moves me, from inside the field", Group: "Steps"),
        new("x3", "Drag me by the grip, not by the row", Group: "Steps", Due: "Friday")
    ];

    private string? _lastDeleted;

    /// <summary>Ids that say nothing about a position, on purpose: the focus rule
    /// resolves where the ring goes after the host has applied the delete, so a list
    /// whose ids are stable and one whose ids are positions — the desktop pane's
    /// steps — both land on the row the reader can see slide up.</summary>
    private IReadOnlyList<TaskRow> _deletable =
    [
        new("k1", "Delete me and the ring lands below", Group: "Tasks"),
        new("k2", "Delete this one and it lands here", Group: "Tasks"),
        new("k3", "Delete the bottom one and it goes up", Group: "Tasks")
    ];

    private int _deletableAdded;

    private int _slotCounter = 1;

    private IReadOnlyList<TaskRow> _slotted =
    [
        new("s1", "Tick me and the section below grows"),
        new("s2", "The button stays where it is"),
        new("s3", "Already finished", Done: true)
    ];
    private IReadOnlyList<TaskRow> _quick =
    [
        new("q1", "Pencil me, then press Tab", Group: "Tasks"),
        new("q2", "Tab lands here next", Group: "Tasks"),
        new("q3", "Shift+Tab goes back up", Group: "Tasks"),
        new("q4", "Tab off the end into the add row", Group: "Tasks"),
        new("q5", "Finished, so not in the chain", Done: true, Group: "Tasks")
    ];

    /// <summary>Ids for the tasks the add row produces. A counter is enough here:
    /// what a real host mints them from is its own business, and that is the point
    /// of the list only ever handing over a title.</summary>
    private int _quickAdded;

    /// <summary>Every rename and every add, in the order they settled, which is
    /// what makes the chain visible: one Tab down the list should read as one
    /// rename per row, a row tabbed through without a change should leave no trace
    /// at all, and the adds should arrive on the end in the order they were typed.
    /// The two are in one line rather than two because the order they happened in
    /// is the thing worth reading.</summary>
    private readonly List<string> _quickSettled = [];

    private IReadOnlyList<TaskRow> _completable =
    [
        new("d1", "Tick me and I move down", Group: "Tasks"),
        new("d2", "So do I", Group: "Tasks", Due: "Today"),
        new("d3", "Already finished", Done: true, Group: "Tasks"),
        new("d4", "Finished last week", Done: true, Group: "Tasks")
    ];

    private static readonly IReadOnlyList<TaskRow> Facts =
    [
        new("f1", "A due date, which is a deadline", Group: "Tasks", Due: "Friday, 21 August"),
        new("f2", "A reminder, which is an alarm", Group: "Tasks", Reminder: "09:00"),
        new("f3", "Both, which are not the same fact", Group: "Tasks", Due: "Friday", Reminder: "09:00"),
        new("f4", "Recurring, which is a shape", Group: "Tasks", Repeats: true) { RepeatLabel = "Every weekday" },
        new("f5", "Tagged", Group: "Tasks", Tags: ["ui", "storybook"]),
        new("f6", "Everything at once", Group: "Tasks", Due: "Friday", Reminder: "09:00", Repeats: true, InMyDay: true, StepsDone: 2, StepCount: 5, Note: true, Tags: ["ui"]) { RepeatLabel = "Weekly" },
        new("f7", "Finished, so nothing competes", Done: true, Group: "Tasks", Due: "Yesterday", Reminder: "08:00", Tags: ["ui"])
    ];

    private static readonly TaskRow Single =
        new("single", "One row, no list around it", Group: "Tasks", Due: "Today");

    private static readonly TaskRow SingleSelected =
        new("single-selected", "The same row, open in a pane", Group: "Tasks", Important: true);

    private static readonly IReadOnlyList<TaskRow> States =
    [
        new("plain", "An ordinary task", Group: "Tasks"),
        new("done", "One that is finished", Done: true, Group: "Tasks"),
        new("important", "One that matters", Important: true, Group: "Tasks"),
        new("both", "Finished, and it mattered", Done: true, Important: true, Group: "Tasks"),
        new("today", "Picked for today", InMyDay: true, Group: "Tasks", Due: "Tomorrow"),
        new("status", "One that says where it has got to", Group: "Tasks", Status: "in progress"),
        new("everything", "Everything at once", Important: true, InMyDay: true, Group: "Tasks", Due: "Friday", Reminder: "09:00", Repeats: true, StepsDone: 2, StepCount: 5, Status: "ready")
    ];

    private static readonly IReadOnlyList<TaskRow> ReadOnlySample =
    [
        new("r1", "Shown, not offered", Group: "Archive"),
        new("r2", "Already finished", Done: true, Group: "Archive")
    ];

    private IReadOnlyList<TaskRow> _ordered =
    [
        new("a", "First", Group: "Tasks"),
        new("b", "Second", Group: "Tasks"),
        new("c", "Third", Group: "Tasks"),
        new("d", "Fourth", Group: "Tasks")
    ];

    private static readonly IReadOnlyList<OpenQuestion> OpenQuestions =
    [
        new("What a reminder does",
            "The row says one is set and offers to clear it. Whether it fires, where, and what happens when the app is not running is not a component's decision."),

        new("When My Day expires",
            "It is a decision the reader made this morning, so it has to expire — but on what clock, and in whose timezone, is the product's answer and not this one's."),

        new("What a due date is said in",
            "Value takes a formatted string. What tomorrow is called, and in what language, belongs to the host — a component that formatted dates would be a component with a culture in it."),

        new("Where the order is kept",
            "TaskListView reports the move and applies nothing. A component that reordered the list it was handed would be one whose result the host has to undo before saving what it actually keeps."),

        new("What a step is",
            "Add step is a row on the side panel and nothing else anywhere. Whether a step is a task, has its own steps, or is only a line of text is the model's question.")
    ];

    private void Select(string id) => _selectedId = id;

    private void Toggle(string id) =>
        _sample = [.. _sample.Select(t => t.Id == id ? t with { Done = !t.Done } : t)];


    private void ToggleOrdered(string id) =>
        _ordered = [.. _ordered.Select(t => t.Id == id ? t with { Done = !t.Done } : t)];

    /// <summary>The host applying the move, which is the arrangement the
    /// component is built for. ApplyTo is the library's offer for a host with no
    /// opinion of its own.</summary>
    private void Reorder(TaskMove move) => _ordered = move.ApplyTo(_ordered, t => t.Id);

    private const string RowCode = """
        <TaskListView Tasks="@tasks"
                      OnToggle="Toggle"
                      OnSelected="Select"
                      SelectedId="@_selectedId" />
        """;

    /// <summary>The host applies the rename, which is the arrangement every one
    /// of these components is built for: the component reports what the reader
    /// did and stores nothing.</summary>
    private void Rename(TaskRename rename)
    {
        _sample = [.. _sample.Select(t => t.Id == rename.Id ? t with { Title = rename.Title } : t)];
        _lastRename = $"renamed {rename.Id} to “{rename.Title}”";
    }

    private void RenameOne(TaskRename rename)
    {
        _renamable = [.. _renamable.Select(t => t.Id == rename.Id ? t with { Title = rename.Title } : t)];
        _lastRename = $"renamed {rename.Id} to “{rename.Title}”";
    }

    private void RenameDirect(TaskRename rename)
    {
        _directRenamable = [.. _directRenamable.Select(t => t.Id == rename.Id ? t with { Title = rename.Title } : t)];
        _lastDirect = $"renamed {rename.Id} to “{rename.Title}”";
    }

    private void ReorderDirect(TaskMove move)
    {
        _directRenamable = move.ApplyTo(_directRenamable, t => t.Id);
        _lastDirect = $"moved {move.Id} onto {move.TargetId}";
    }

    private void ToggleSlotted(string id) =>
        _slotted = [.. _slotted.Select(t => t.Id == id ? t with { Done = !t.Done } : t)];

    private void AddSlotted() =>
        _slotted = [.. _slotted, new TaskRow($"s{++_slotCounter + 3}", "One more, added from the slot")];

    private void RenameQuick(TaskRename rename)
    {
        _quick = [.. _quick.Select(t => t.Id == rename.Id ? t with { Title = rename.Title } : t)];
        _quickSettled.Add($"renamed {rename.Id} to “{rename.Title}”");
    }

    /// <summary>A title, and the host does the rest. The list never held a row for
    /// this task and never will: it handed over a string and forgot about it.</summary>
    private void AddQuick(string title)
    {
        var id = $"q{100 + ++_quickAdded}";
        _quick = [.. _quick, new TaskRow(id, title, Group: "Tasks")];
        _quickSettled.Add($"added {id} as “{title}”");
    }

    /// <summary>The host applying the delete, which is the arrangement the component
    /// is built for: the list said which row and stored nothing, and the row is gone
    /// from here rather than from the list's own state.</summary>
    private void Delete(string id)
    {
        _lastDeleted = $"deleted {id}";
        _deletable = [.. _deletable.Where(t => t.Id != id)];
    }

    private void RenameDeletable(TaskRename rename) =>
        _deletable = [.. _deletable.Select(t => t.Id == rename.Id ? t with { Title = rename.Title } : t)];

    /// <summary>Here so the story has something to delete again, and so the add row
    /// exists at all — it is where the focus goes when the last row is deleted.</summary>
    private void AddDeletable(string title) =>
        _deletable = [.. _deletable, new TaskRow($"k{100 + ++_deletableAdded}", title, Group: "Tasks")];

    private void ToggleCompletable(string id) =>
        _completable = [.. _completable.Select(t => t.Id == id ? t with { Done = !t.Done } : t)];

    private void ReorderCompletable(TaskMove move) =>
        _completable = move.ApplyTo(_completable, t => t.Id);

    private const string RenameCode = """
        <TaskListView Tasks="@tasks" OnRename="Rename" />

        @code {
            // Reported once, when it settles — not once per keystroke.
            private void Rename(TaskRename rename) =>
                _tasks = [.. _tasks.Select(t => t.Id == rename.Id ? t with { Title = rename.Title } : t)];
        }
        """;

    private const string DirectRenameCode = """
        @* The title is a field from the start. Same commit rules as the pencil's. *@
        <TaskListView Tasks="@tasks" OnRename="Rename" DirectRename="true"
                      Reorderable="true" OnReorder="Reorder" />

        @* Which is why TaskItem turns the row's own draggable off while a field is
           open, makes the grip draggable in its own right, and hears Alt+Arrow
           inside the field. All three, or reordering quietly goes away. *@
        """;

    private const string SlotCode = """
        <TaskListView Tasks="@tasks" OnToggle="Toggle">
            <AfterOpenRows>
                <AppButton OnClick="Add">+ New task</AppButton>
            </AfterOpenRows>
        </TaskListView>
        """;

    private const string QuickEditCode = """
        @* Tab commits a rename and opens the next row's field; Shift+Tab goes back
           up. OnAdd is what puts the add row on the end of the list and so what
           makes Tab off the last row land somewhere — leave OnAdd off and there is
           no add row and the chain stops at the bottom. *@
        <TaskListView Tasks="@tasks"
                      QuickEdit="true"
                      OnRename="Rename"
                      OnAdd="Add"
                      AddLabel="Add a task" />

        @code {
            // Still one rename per row when it settles. Tab is only what settles
            // it — and what opens the next one.
            private void Rename(TaskRename rename) =>
                _tasks = [.. _tasks.Select(t => t.Id == rename.Id ? t with { Title = rename.Title } : t)];

            // A title, nothing else. The field it was typed into was never a row in
            // _tasks, so a title nobody finished leaves nothing here to clean up —
            // and an empty field is Tab's way out of the list, not an add.
            private void Add(string title) =>
                _tasks = [.. _tasks, new TaskRow(NewId(), title)];
        }
        """;

    private const string DeleteCode = """
        @* The delegate is the control: no OnDelete, no bin. What is left after it —
           the announcement, and putting the focus on the row that slid up — is the
           list's, because a row cannot see the rows around it. *@
        <TaskListView Tasks="@tasks" OnDelete="Delete" />

        @code {
            // The host applies it. Whether the row is gone for good, archived, or
            // recoverable is a question a component has no business answering.
            private void Delete(string id) =>
                _tasks = [.. _tasks.Where(t => t.Id != id)];
        }
        """;

    private const string TagCode = """
        new TaskRow("id", "Everything at once",
            Group: "Tasks", Due: "Friday", Reminder: "09:00",
            Repeats: true, Tags: ["ui", "storybook"])
        { RepeatLabel = "Weekly" }
        """;

    private const string CompletedCode = """
        @* On by default. GroupCompleted="false" leaves done rows where they are. *@
        <TaskListView Tasks="@tasks" OnToggle="Toggle" />
        """;

    private const string ItemCode = """
        @* It renders an li, so it wants a list element around it. *@
        <ul class="task-list">
            <TaskItem Task="@row" OnToggle="Toggle" OnSelected="Open" />
        </ul>
        """;

    private const string StatesCode = """
        new TaskRow("id", "Everything at once",
            Important: true, InMyDay: true, Status: "ready",
            Due: "Friday", Reminder: "09:00", StepsDone: 2, StepCount: 5)
        """;

    private const string ReorderCode = """
        <TaskListView Tasks="@tasks" Reorderable="true" OnReorder="Reorder" />

        @code {
            // The host applies it: only the host knows where the order is kept.
            private void Reorder(TaskMove move) => _tasks = move.ApplyTo(_tasks, t => t.Id);
        }
        """;

    private string? _lastAction;

    /// <summary>What a host puts in the row's action slot. IconButton, because these
    /// are the library's own controls being handed back into it — the slot is about
    /// where they go, not about the host bringing its own buttons.</summary>
    private RenderFragment HostActions(TaskRow task) =>
        @<text>
            <IconButton BaseClass="btn btn--icon"
                        AriaLabel="@($"Push {task.Title}")"
                        TestId="@($"row-actions-{task.Id}-push")"
                        OnClick='() => Record("Pushed", task)'>↑</IconButton>

            <IconButton BaseClass="btn btn--icon"
                        AriaLabel="@($"Hand {task.Title} to a tool")"
                        TestId="@($"row-actions-{task.Id}-tool")"
                        OnClick='() => Record("Handed over", task)'>gh</IconButton>
        </text>;
    private void Record(string what, TaskRow task) => _lastAction = $"{what}: {task.Title}.";

    /// <summary>This story's host answer: every row but the last hands over a
    /// written-up version of itself, and the last answers null, so one story shows
    /// both halves of the hook.</summary>
    private string? SampleCopyText(TaskRow task) =>
        ReferenceEquals(task, Sample[^1]) ? null : $"{task.Title}\n\nWritten up in full, the way the host holds it.";

    private const string RowCopyValueCode = """
        <TaskListView Tasks="@tasks"
                      RowCopyValue="@(task => Markdown(task.Id))" />
        """;

    private const string RowActionCode = """
        <TaskListView Tasks="@tasks" RowActions="@(task => Actions(task))" />

        @code {
            private RenderFragment Actions(TaskRow task) =>
                @<IconButton AriaLabel="@($"Push {task.Title}")" OnClick="() => Push(task)">↑</IconButton>;
        }
        """;
}
