@page "/goals-view"

<PageTitle>Goals view — Backlog UI Storybook</PageTitle>

<StoryPage Title="Goals view"
           Summary="GoalsBoard and its parts — GoalCard, GoalProgressBar, WorkItemSearch, StandUpPanel, ImpedimentRow, ImpedimentRaiseDialog, GoalCreateDialog and TwoWeekStartDialog: the desktop Goals view, with the iteration switch, the goals and what no goal holds, and the stand-up beside them. Every value is handed in and every act is a callback, so the goals below are stubs with no module behind them."
           Guidelines="@Rules">

    <Story Name="At risk"
           Description="The design's own state: a Week stand-up on Monday 19 October, reading 12–16 Oct and 19–23 Oct. The Goals heading carries its count, as Finished, Planned and Impediments do. The first goal is open and At risk, with its plan, tasks and pull requests in three columns and the attach search under them; type pay to see its matches under their kind labels. The other goals are folded rows, each ending in a chevron that points down; press anywhere on a row — its title, its bar, its line or the space between — to open that goal, and the open one folds. A press on the open goal's head folds it; nothing in its body does.

No goal lists the work in progress no goal holds, each saying how it stands — a task's status dot, a pull request's status line — and each with Attach…, which attaches to the open goal; fold every goal and it opens the shared goal picker to ask which. Each row's grip carries it onto a goal instead. Beside the goals the stand-up lists Finished, Planned with each item's effort in points and the points tag, and Impediments with a state picker that offers only the moves an impediment may make, and each one's note with Add note or Edit note. Copy puts the four blocks on the clipboard as plain text. Narrower than 900 px, the stand-up falls under the goals."
           Code="@BoardCode">
        <div class="sb-board">
            <GoalsBoard Model="@Board"
                        TestId="goals-view-board"
                        IterationChanged="@(length => _said = $"Read by {GoalsText.Iteration(length)}")"
                        OnNewGoal="@(() => _dialogOpen = true)"
                        OnRefresh="@(() => _said = "Refresh")"
                        OnAttach="@(request => _said = $"Attach {request.Subject.Key} to {request.GoalId}")"
                        OnPickGoal="@(subject => _picking = subject)"
                        OnMoveImpediment="@(request => _said = $"Move {request.ImpedimentId} to {GoalsText.State(request.State)}")"
                        OnEditImpedimentNote="@(request => _said = request.Note is null ? $"Clear the note on {request.ImpedimentId}" : $"Note on {request.ImpedimentId}: {request.Note}")" />
            <p class="sb-state" data-testid="goals-view-said">@(_said ?? "Switch the iteration, attach an item or move an impediment.")</p>
            <GoalPicker Open="@(_picking is not null)"
                        OpenChanged="@(open => { if (!open) _picking = null; })"
                        Subject="@_picking"
                        Goals="PickerGoals"
                        TestId="goals-view-picker"
                        OnAttach="@(id => { _said = $"Attach {_picking?.Key} to {PickerGoals.First(goal => goal.Id == id).Title}"; _picking = null; })"
                        OnCreate="@(draft => { _said = $"Set {draft.Title} and attach {_picking?.Key} to it"; _picking = null; })" />
        </div>
    </Story>

    <Story Name="On track"
           Description="An On track goal, folded and open: the chevron at the row's end points down folded and up open. It has nothing done in the last window and no landing date, so its line carries neither +n nor lands ~."
           Code="@OnTrackCode">
        <div class="sb-stack">
            <GoalCard Goal="@Search" TestId="goals-view-on-track" />
            <GoalCard Goal="@Search" Expanded="true" TestId="goals-view-on-track-open" />
        </div>
    </Story>

    <Story Name="Without a due date"
           Description="A goal set without a due date is due at the end of the iteration: its line names the last day of the next window — Friday 23 October here — and says it is the iteration's end, and the forecast reads At risk when it lands after that day. The day is read afresh on every reading and never stored, so the open goal's Due date field is empty; typing a date there gives the goal one of its own."
           Code="@DatelessCode">
        <div class="sb-stack">
            <GoalCard Goal="@Dateless" TestId="goals-view-dateless" />
            <GoalCard Goal="@Dateless" Expanded="true" OnEdit="@(request => _datelessSaid = DatelessSaid(request))" TestId="goals-view-dateless-open" />
            <p class="sb-state" data-testid="goals-view-dateless-said">@(_datelessSaid ?? "Type a due date, then leave the field.")</p>
        </div>
    </Story>

    <Story Name="Editing a goal"
           Description="With a host listening, the open goal leads with its title, outcome and due date as fields, edited in place: there is no Save button, and a field is handed back once it changes — leave it, press Enter, or pick a date. Escape abandons what was typed in a field. Clear the title and leave the field to see the module's refusal on it, and the field show what the goal still says. Empty the due date and leave the field to clear it: the goal is then due at the end of the iteration. A date the field cannot read is put back when you leave it. Delete goal… sits beside the fields."
           Code="@EditCode">
        <div class="sb-stack">
            <GoalCard Goal="@_edited"
                      Expanded="true"
                      OnEdit="EditSample"
                      OnDelete="@(() => _editSaid = "Delete goal… pressed: the board asks first")"
                      EditError="@_editError"
                      TestId="goals-view-edit" />
            <p class="sb-state" data-testid="goals-view-edit-said">@(_editSaid ?? "Change a field, then leave it.")</p>
        </div>
    </Story>

    <Story Name="Deleting a goal"
           Description="Delete goal… on the open goal asks first, in a destructive confirm that says what the goal held stays as it is. Delete goal deletes it and folds it; Cancel changes nothing. Here the goals are stubs, so a deleted one leaves the board until the page is read again."
           Code="@DeleteCode">
        <div class="sb-board">
            <GoalsBoard Model="@_deleteBoard"
                        TestId="goals-view-delete-board"
                        OnEditGoal="@(request => _deleteSaid = $"Edit {request.GoalId}")"
                        OnDeleteGoal="DeleteSample"
                        OnDetach="@(request => _deleteSaid = $"Detach {request.Subject.Key} from {request.GoalId}")" />
            <p class="sb-state" data-testid="goals-view-delete-said">@(_deleteSaid ?? "Press Delete goal… on the open goal.")</p>
        </div>
    </Story>

    <Story Name="Detaching work"
           Description="With a host listening, every Plan, Tasks and Pull requests row the goal holds itself ends in an icon-only Detach, named for the item and the goal; a merged pull request's pill carries one too. #1358 has none: the goal holds it only through Recurring invoices, so detaching that task is what lets it go. Detaching changes nothing on the item, so it does not ask."
           Code="@DetachCode">
        <div class="sb-stack">
            <GoalCard Goal="@_detached"
                      Expanded="true"
                      OnDetach="DetachSample"
                      TestId="goals-view-detach" />
            <p class="sb-state" data-testid="goals-view-detach-said">@(_detachSaid ?? "Press a row's Detach.")</p>
        </div>
    </Story>

    <Story Name="Attaching a pull request by its number"
           Description="The attach search reads a pull request as well as a title: #1477 or 1477, owner/name#1477, or the pull request's GitHub address. A bare number is read in each repository the host hands in — the one in scope when the scope holds one — so here #1477 offers it in both JSdotNet/Backlog and JSdotNet/Marketplace, titled with its repository, ahead of any title match. No candidate needs to hold it: a merged pull request, or one the reader did not list, attaches by identity, and its status line then says what GitHub knows. Type #1357 and the candidate that holds it is listed once, with its own title."
           Code="@QuickAddCode">
        <div class="sb-stack">
            <GoalCard Goal="@Search"
                      Expanded="true"
                      Candidates="@Board.Candidates"
                      Repositories="QuickAddRepositories"
                      OnAttach="@(subject => _quickAddSaid = $"Attach {subject.Key} to {Search.Title}")"
                      TestId="goals-view-quick-add" />
            <p class="sb-state" data-testid="goals-view-quick-add-said">@(_quickAddSaid ?? "Type #1477, JSdotNet/Backlog#1477 or a pull request's address.")</p>
        </div>
    </Story>

    <Story Name="Finding a plan by its tag and adding a new task"
           Description="The app writes a plan tag as +slug, so that is what a person types: the attach search tries the query as typed and with one leading + or # dropped, so +payment-provider lists the plan titled payment-provider, and a title that holds the sigil still matches as typed.

With a host listening on OnQuickAdd, a query that is not blank ends the list with New task “‹query›”, even when nothing matches — type Bank export. Picking it hands the trimmed title back; the host creates the task, To do and with no plan tag, and attaches it to the goal. Here the host is stubbed: the task joins the goal's Tasks, the query clears and the focus goes back to the search box. A refusal would leave the typed text."
           Code="@NewTaskCode">
        <div class="sb-stack">
            <GoalCard Goal="@_quickAdded"
                      Expanded="true"
                      Candidates="@Board.Candidates"
                      OnAttach="@(subject => _newTaskSaid = $"Attach {subject.Key} to {_quickAdded.Title}")"
                      OnQuickAdd="QuickAddSample"
                      TestId="goals-view-new-task" />
            <p class="sb-state" data-testid="goals-view-new-task-said">@(_newTaskSaid ?? "Type +payment-provider, or a title no candidate holds.")</p>
        </div>
    </Story>

    <Story Name="Reordering the goals"
           Description="With a host listening on OnMoveGoal, each goal leads its row with a grip and carries Move up and Move down before its chevron; neither opens nor folds the goal. Drag a goal by its grip onto another and it takes that goal's place — the board shows where it would land while it is held, and Escape puts it back. With the keyboard, Move up and Move down move it one place and keep the focus on the button; the first goal's Move up and the last goal's Move down are disabled. The new order is drawn at once and said in a live region, Moved ‹goal› to position n of m; the host stores it and reads the view again, which puts the stored order back after a refusal. The drag is the library's one pointer reorder, the task list's, because a native drag is aborted in the desktop head's WebView2."
           Code="@ReorderCode">
        <div class="sb-board">
            <GoalsBoard Model="@_orderBoard"
                        TestId="goals-view-reorder-board"
                        OnMoveGoal="MoveSample" />
            <p class="sb-state" data-testid="goals-view-reorder-said">@(_orderSaid ?? "Drag a goal by its grip, or press Move up or Move down.")</p>
        </div>
    </Story>

    <Story Name="Searching No goal"
           Description="A search beside the No goal heading filters its rows as it is typed, by the attach search's rule: a title holding the query, a pull request number starting with it, a leading + or # tolerated, case ignored. Type pay, #1357 or VAT; type something nothing holds to see No matches, and clear the box to see every row again. Attach… on a filtered row attaches that row's work. The query is the board's own and never reaches the host."
           Code="@NoGoalSearchCode">
        <div class="sb-board">
            <GoalsBoard Model="@NoGoalBoard"
                        TestId="goals-view-no-goal-board"
                        OnAttach="@(request => _noGoalSaid = $"Attach {request.Subject.Key} to {request.GoalId}")" />
            <p class="sb-state" data-testid="goals-view-no-goal-said">@(_noGoalSaid ?? "Type in the No goal search.")</p>
        </div>
    </Story>

    <Story Name="Dragging work onto a goal"
           Description="Each No goal row says how its work stands, drawn as the open goal's columns draw it: a task's status dot, in progress or blocked, with the words after its title for a screen reader; a pull request's status line, its gh pill carrying the number, then the checks and approvals marks and your review. One the read could not answer for draws unknown, with no marks.

With a host listening on OnAttach and at least one goal, each row leads with a grip. Press it and move: the row is set back, and the goal under the pointer — open or folded, anywhere on its card — is outlined as the drop target. Release over it and the row's work is attached to that goal, the path Attach… takes, and said in the live region, Attached ‹title› to ‹goal›. Release anywhere else, or press Escape, and nothing is attached. Attach… stays the keyboard's way in. The drag is the library's one pointer reorder, because a native drag is aborted in the desktop head's WebView2."
           Code="@DropAttachCode">
        <div class="sb-board">
            <GoalsBoard Model="@_dropBoard"
                        TestId="goals-view-drop-board"
                        OnAttach="DropAttachSample" />
            <p class="sb-state" data-testid="goals-view-drop-said">@(_dropSaid ?? "Drag a No goal row by its grip onto a goal.")</p>
        </div>
    </Story>

    <Story Name="Empty"
           Description="No goals, and nothing in progress outside one: the goals column is an empty state with New goal as its action, and the stand-up beside it still says what was finished and planned."
           Code="@EmptyCode">
        <div class="sb-board">
            <GoalsBoard Model="@Empty" TestId="goals-view-empty-board" EmptyTestId="goals-view-empty-state" OnNewGoal="@(() => _dialogOpen = true)" />
        </div>
    </Story>

    <Story Name="Progress bar"
           Description="A goal's items as one stacked bar — done, in progress, blocked, and not started as the track — at the folded and the open size."
           Code="@BarCode">
        <div class="sb-stack">
            <GoalProgressBar Counts="@Paid.Counts" TestId="goals-view-bar" />
            <GoalProgressBar Counts="@Paid.Counts" Large="true" TestId="goals-view-bar-large" />
        </div>
    </Story>

    <Story Name="Stand-up"
           Description="The aside on its own: Finished with only what the goals count, Planned with each item's effort in points at the row's end — Payment terms on quotes carries none, so it shows none — a pull request's status line, and the points tag titled in words, and Impediments followed by how many the last window resolved."
           Code="@StandUpCode">
        <div class="sb-menu">
            <StandUpPanel StandUp="@Board.StandUp" Iteration="GoalsIteration.Week" TestId="goals-view-stand-up" />
        </div>
    </Story>

    @foreach (var impediment in StateSamples)
    {
        <Story Name="@($"Impediment {GoalsText.State(impediment.State)}")"
               Description="@StateDescription(impediment.State)"
               Code="@ImpedimentCode(impediment)">
            <div class="sb-menu">
                <ImpedimentRow Impediment="@impediment"
                               OnMove="@(state => _said = $"Move to {GoalsText.State(state)}")"
                               TestId="@($"goals-view-impediment-{ImpedimentRow.Slug(impediment.State)}")" />
            </div>
        </Story>
    }

    <Story Name="Impediment with a note"
           Description="The note the phone's impediment page writes, under the meta line and wrapped as written. Edit note opens it in place as a text box: leave the box or press Ctrl+Enter to keep it, Escape to abandon it; there is no Save button, and a blank note clears it. The focus goes back to the button once the box closes. A row with no host listening shows the note as text, with no button."
           Code="@NoteCode">
        <div class="sb-menu">
            <ImpedimentRow Impediment="@_noted"
                           OnEditNote="EditSampleNote"
                           TestId="goals-view-impediment-note" />
            <p class="sb-state" data-testid="goals-view-note-said">@(_noteSaid ?? "Edit the note, then leave the box.")</p>
        </div>
    </Story>

    <Story Name="Impediment ready to resolve"
           Description="Everything the impediment holds back is settled — the task Done, the pull request merged — so a Ready to resolve badge in the settled tone sits beside the state picker. It is a reading, never a state: the picker still holds Being handled, and resolving stays the person's. The goal it held back still reads At risk until it is resolved."
           Code="@ReadyCode">
        <div class="sb-menu">
            <ImpedimentRow Impediment="@Ready" TestId="goals-view-impediment-ready" />
        </div>
    </Story>

    <Story Name="Impediment holding back a pull request and a plan"
           Description="An impediment holds back tasks, pull requests and plans, listed under it in the order they were linked, each under its kind label. Its line names the goal of the first item linked — here the goal that counts #1341. Nothing here is settled yet, so there is no Ready to resolve badge."
           Code="@HoldsBackCode">
        <div class="sb-menu">
            <ImpedimentRow Impediment="@Holding" TestId="goals-view-impediment-holding" />
        </div>
    </Story>

    <Story Name="Linking what an impediment holds back"
           Description="With a host listening, Link… opens the work search under the row, limited to tasks, pull requests and plans: type pay, #1477 or +payment-provider. A pick links the item and the search stays open for the next; what the row already holds is not offered again, and Link… or Escape closes the search. Each item carries an icon-only Unlink named for it; unlinking changes nothing on the work, so it does not ask. Here the host is stubbed: the row takes the item, or lets it go, at once."
           Code="@LinkCode">
        <div class="sb-menu">
            <ImpedimentRow Impediment="@_linked"
                           Candidates="@Board.Candidates"
                           Repositories="QuickAddRepositories"
                           OnLink="LinkSample"
                           OnUnlink="UnlinkSample"
                           TestId="goals-view-impediment-link" />
            <p class="sb-state" data-testid="goals-view-link-said">@(_linkSaid ?? "Press Link… and pick a task, pull request or plan.")</p>
        </div>
    </Story>

    <Story Name="Work search"
           Description="The search a goal's attach and an impediment's Link… share, on its own: a box, and while the query is not blank the matches under their kind labels, a pull request named by its number leading the list in each repository handed in. Kinds limits what it offers — here tasks, pull requests and plans. A pick hands the item back, clears the query and puts the focus back in the box. GoalCard draws it in its own classes; everywhere else it wears work-item-search."
           Code="@WorkSearchCode">
        <div class="sb-menu">
            <WorkItemSearch Candidates="@Board.Candidates"
                            Repositories="QuickAddRepositories"
                            Kinds="WorkItemSearch.ImpedimentKinds"
                            Label="Link a task, pull request or plan"
                            OnPick="@(item => _searchSaid = $"Picked {item.Subject.Key}")"
                            TestId="goals-view-work-search" />
            <p class="sb-state" data-testid="goals-view-work-search-said">@(_searchSaid ?? "Type pay or #1477.")</p>
        </div>
    </Story>

    <Story Name="Raising an impediment"
           Description="Raise impediment in the stand-up's Impediments heading opens a dialog like New goal: a title, an optional note, and optionally the first work it holds back, picked in the work search and listed under it with a Remove each. Raise hands it back and the host raises it New, dated today, through the module, closing the dialog, or keeps it open with the module's refusal. Leave the title blank and press Raise to see it refused on the field."
           Code="@RaiseCode">
        <div class="sb-menu">
            <StandUpPanel StandUp="@(Board.StandUp with { Impediments = _raised })"
                          Iteration="GoalsIteration.Week"
                          OnRaiseImpediment="@(() => _raiseOpen = true)"
                          TestId="goals-view-raise-stand-up" />
            <ImpedimentRaiseDialog Open="_raiseOpen"
                                   OpenChanged="open => _raiseOpen = open"
                                   Candidates="@Board.Candidates"
                                   Repositories="QuickAddRepositories"
                                   OnRaise="RaiseSample"
                                   TestId="goals-view-raise-dialog" />
        </div>
    </Story>

    <Story Name="Two-week start"
           Description="The first time a person chooses 2 weeks there is no day two-week iterations count from yet, so the host asks for it before it reads by 2 weeks, offering the Monday of the current week — Monday 19 October here. Read by 2 weeks keeps the day and switches; Cancel leaves the iteration as it was. Clear the field and press Read by 2 weeks to see the refusal. Once a start is kept, 2 weeks switches at once."
           Code="@StartCode">
        <AppButton OnClick="@(() => _startOpen = true)" TestId="goals-view-two-weeks">2 weeks</AppButton>
        <TwoWeekStartDialog Open="_startOpen"
                            OpenChanged="open => _startOpen = open"
                            Offered="@Oct(19)"
                            TestId="goals-view-start-dialog"
                            OnSave="@(start => { _startOpen = false; _startSaid = $"Two-week iterations count from {start:ddd d MMM}"; })" />
        <p class="sb-state" data-testid="goals-view-start-said">@(_startSaid ?? "Press 2 weeks.")</p>
    </Story>

    <Story Name="New goal"
           Description="New goal opens a dialog over a title, a one-line outcome and an optional due date. Save hands the draft back trimmed; the host creates the goal through the module and closes the dialog, or keeps it open with the module's refusal under the fields. Leave the due date empty and the goal is due at the end of the iteration; leave the title empty to see the refusal."
           Code="@DialogCode">
        <AppButton OnClick="@(() => _dialogOpen = true)" TestId="goals-view-new-goal">New goal</AppButton>
        <GoalCreateDialog Open="_dialogOpen"
                          OpenChanged="open => _dialogOpen = open"
                          Error="@_dialogError"
                          TestId="goals-view-dialog"
                          OnSave="SaveDraft" />
    </Story>
</StoryPage>

@code {
    private static readonly DesignGuideline[] Rules =
    [
        new("color-scheme.md#goal-forecast-badges", "Why At risk and On track differ by edge as well as hue."),
        new("color-scheme.md#impediment-state-tones", "Which tone each impediment state takes, and why New carries a dot."),
        new("color-scheme.md#badge-and-chip-tones", "Why Ready to resolve wears the settled tone, beside the state rather than in its place."),
        new("color-scheme.md#pull-request-status-marks", "The glyph and ink of each checks and approvals mark on a goal's pull requests."),
        new("accessibility.md#iconography-accessibility", "Why the bar, the dots and the glyphs say their figures in words."),
        new("interaction-guidelines.md#auto-save-no-save-buttons", "Why the open goal's fields have no Save button, and how a refused edit is put back."),
        new("interaction-guidelines.md#keyboard-accessible-reordering", "Why every goal can be moved without a pointer, and what a move says."),
        new("interaction-guidelines.md#drop-indicators", "Why the goal a No goal row would land on is outlined while it is carried."),
        new("accessibility.md#screen-reader--announcements", "Why a drop on a goal is said in the board's live region."),
        new("typography-and-layout.md#iconography", "The glyphs the view draws, and the size they are drawn at.")
    ];

    private string? _said;
    private GoalSubject? _picking;

    /// <summary>The board's goals as the picker offers them.</summary>
    private static readonly IReadOnlyList<GoalOption> PickerGoals =
    [
        new(new Guid("6f1c0a52-0000-4000-8000-000000000001"), "Customers get paid faster", 9, 15, Oct(30)),
        new(new Guid("6f1c0a52-0000-4000-8000-000000000002"), "Devbook search ships", 5, 6, Oct(23)),
        new(new Guid("6f1c0a52-0000-4000-8000-000000000003"), "Phone capture in daily use", 3, 10, new DateOnly(2026, 11, 30))
    ];

    private static readonly Guid T1 = new("7a2d0b63-0000-4000-8000-000000000001");
    private static readonly Guid T2 = new("7a2d0b63-0000-4000-8000-000000000002");
    private static readonly Guid T3 = new("7a2d0b63-0000-4000-8000-000000000003");
    private static readonly Guid T4 = new("7a2d0b63-0000-4000-8000-000000000004");
    private static readonly Guid Terms = new("7a2d0b63-0000-4000-8000-000000000005");
    private static readonly Guid Vat = new("7a2d0b63-0000-4000-8000-000000000006");
    private static readonly Guid Widget = new("7a2d0b63-0000-4000-8000-000000000007");

    private static GoalSubject Pr(int number) => GoalSubject.ForPullRequest("JSdotNet/Backlog", number);
    private string? _noteSaid;
    private bool _dialogOpen;
    private bool _startOpen;
    private string? _startSaid;

    private StandUpImpediment _noted = new(
        "s-noted", "Bank sample files missing", StandUpImpedimentState.Escalated,
        [StandUpImpedimentState.BeingHandled, StandUpImpedimentState.Resolved], "Account manager", 3, Oct(20), "Customers get paid faster",
        "Account manager promised the CAMT.053 samples by Tuesday.\nAsk for a failed-payment file too.");

    /// <summary>The host's part, stubbed: keep the note handed back and say what was saved.</summary>
    private void EditSampleNote(string? note)
    {
        _noted = _noted with { Note = note };
        _noteSaid = note is null ? "Note cleared" : $"Saved: {note}";
    }
    private string? _dialogError;

    private string? _datelessSaid;

    /// <summary>What the dateless goal's edit handed back, said in words.</summary>
    private static string DatelessSaid(GoalEditRequest request) =>
        request.DueDate is { } due ? $"Saved: due {due:d MMM}" : "Saved: due at the end of the iteration";

    private GoalCardModel _edited = Paid;
    private string? _editError;
    private string? _editSaid;

    /// <summary>The host's part, stubbed on the module's own rules: refuse what the module
    /// refuses, keep the rest.</summary>
    private void EditSample(GoalEditRequest request)
    {
        _editError = request.Title.Length == 0 ? "A goal needs a title."
            : request.Outcome?.Contains('\n') == true ? "A goal's outcome is one line."
            : null;
        if (_editError is not null) return;

        // Without a date the goal is due at the end of the next window, as a reading derives it.
        _edited = _edited with
        {
            Title = request.Title,
            Outcome = request.Outcome,
            DueDate = request.DueDate ?? Board.Next.Last,
            DueIsIterationEnd = request.DueDate is null
        };
        _editSaid = $"Saved: {request.Title} · {request.Outcome ?? "no outcome"} · {GoalsText.Due(_edited.DueDate, _edited.DueIsIterationEnd)}";
    }

    private GoalsBoardModel _deleteBoard = Board;
    private string? _deleteSaid;

    private void DeleteSample(string goalId)
    {
        var goal = _deleteBoard.Goals.First(g => g.Id == goalId);
        _deleteBoard = _deleteBoard with { Goals = [.. _deleteBoard.Goals.Where(g => g.Id != goalId)] };
        _deleteSaid = $"Deleted {goal.Title}";
    }

    private GoalCardModel _detached = Paid;
    private string? _detachSaid;

    private void DetachSample(GoalSubject subject)
    {
        var index = Enumerable.Range(0, _detached.PullRequests.Count).FirstOrDefault(i => _detached.PullRequestSubject(i) == subject, -1);
        _detached = _detached with
        {
            Plans = [.. _detached.Plans.Where(plan => plan.Subject != subject)],
            Tasks = [.. _detached.Tasks.Where(task => task.Subject != subject)],
            PullRequests = [.. _detached.PullRequests.Where((_, i) => i != index)],
