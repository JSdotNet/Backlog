    private void DropAttachSample(GoalAttachRequest request)
    {
        var item = _dropBoard.NoGoal.First(row => row.Subject == request.Subject);
        var goals = _dropBoard.Goals.Select(goal => goal.Id != request.GoalId ? goal : goal with
        {
            Tasks = item.Status is { } status
                ? [.. goal.Tasks, new GoalTaskModel(item.Subject.Key, item.Title, status, item.Subject)]
                : goal.Tasks,
            PullRequests = item.PullRequest is { } pull ? [.. goal.PullRequests, pull] : goal.PullRequests,
            PullRequestSubjects = item.PullRequest is not null
                ? [.. goal.PullRequestSubjects ?? goal.PullRequests.Select(_ => (GoalSubject?)null), item.Subject]
                : goal.PullRequestSubjects
        }).ToList();

        _dropBoard = _dropBoard with { Goals = goals, NoGoal = [.. _dropBoard.NoGoal.Where(row => row.Subject != request.Subject)] };
        _dropSaid = $"Attached {item.Title} to {goals.First(goal => goal.Id == request.GoalId).Title}";
    }

