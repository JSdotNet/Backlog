@page "/notification-card"

<PageTitle>Notification card — Backlog UI Storybook</PageTitle>

<StoryPage Title="Notification card"
           Summary="NotificationCard: one alert or question from the notification centre, read in Markdown and answered in place — the control each question shape gets, Acknowledge on an alert, and how a settled card says what happened."
           Guidelines="@Rules">

    <Story Name="Single choice"
           Description="One button per set answer. The question's own style decides each button's look — primary, destructive, or plain — and pressing one is the answer; there is no second step. A Mermaid fence in the body draws through DiagramView like it does in every other read view."
           Code="@SingleCode"
           Source="@SingleChoice.BodyMarkdown">
        <NotificationCard Model="@SingleChoice" TestId="notification-card-single" OnAnswer="@Answered" />
    </Story>

    <Story Name="With an origin"
           Description="Where it came from, above the title: the system as a badge and the place beside it — a product and item, a repository and session. Who asked and how sit under the title, the way asked as an outlined pill, and Open in the system at the foot when the origin carries a link. A card without an origin keeps its source beside the time instead."
           Code="@OriginCode">
        <NotificationCard Model="@WithOrigin" TestId="notification-card-origin-sample" OnAnswer="@Answered" />
    </Story>

    <Story Name="Multiple choice"
           Description="A checkbox per set answer and one Answer button. The legend says how many to pick, and Answer stays disabled until the picks fit the question's minimum and maximum."
           Code="@MultipleCode"
           Source="@MultipleChoice.BodyMarkdown">
        <NotificationCard Model="@MultipleChoice" TestId="notification-card-multiple" OnAnswer="@Answered" />
    </Story>

    <Story Name="Open answer"
           Description="A plain-text box and Send. The text is kept as written — no Markdown in an answer — and the box stops at the question's length limit. Sending an empty box asks for an answer instead of sending nothing."
           Code="@OpenCode">
        <NotificationCard Model="@OpenAnswer" TestId="notification-card-open-sample" OnAnswer="@Answered" />
    </Story>

    <Story Name="Choices with an open answer"
           Description="The set answers as buttons, and the box with Send under them for an answer in the person's own words."
           Code="@ChoicesWithOpenCode">
        <NotificationCard Model="@ChoicesWithOpen" TestId="notification-card-choices-open" OnAnswer="@Answered" />
    </Story>

    <Story Name="Eight choices and a note"
           Description="The most a question offers: eight set answers, an open answer in place of them, and an optional note beside whichever answer the person gives — the shape a spec-manager question takes. From seven choices up the buttons lay out as an even grid that wraps, and a long label breaks inside its button. The note box, Add a note (optional), sits under the answers; what is in it goes with the button pressed or the text sent."
           Code="@EightWithNoteCode">
        <NotificationCard Model="@EightWithNote" TestId="notification-card-eight-note" OnAnswer="@Answered" />
    </Story>

    <Story Name="Alert"
           Description="An alert informs, and nothing waits on it: Acknowledge is the only control. An info alert carries no severity badge; warning and critical do."
           Code="@AlertCode">
        <NotificationCard Model="@Alert" TestId="notification-card-alert" OnAcknowledge="@Acknowledged" />
    </Story>

    <Story Name="A refused answer"
           Description="The host hands back why the owner refused the answer — already answered, closed, not a choice the question offers — and the controls stay, so the person can answer again."
           Code="@RefusedCode">
        <NotificationCard Model="@SingleChoice" TestId="notification-card-refused" ErrorMessage="The question is already answered." />
    </Story>

    <Story Name="Answered"
           Description="A settled card draws no controls. Answered says which answer won and the device it came from, in the words the host formats."
           Code="@AnsweredCode">
        <NotificationCard Model="@AnsweredQuestion" TestId="notification-card-answered" />
    </Story>

    <Story Name="Closed"
           Description="Closed says why: the publisher closed it, or the thing it was about ended."
           Code="@ClosedCode">
        <NotificationCard Model="@ClosedQuestion" TestId="notification-card-closed" />
    </Story>

    @if (_last is not null)
    {
        <p class="sb-label" data-testid="notification-card-last-reply">Last reply: @_last</p>
    }
</StoryPage>

