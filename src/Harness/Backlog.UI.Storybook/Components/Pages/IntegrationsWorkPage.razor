@page "/integrations/work"

<PageTitle>Work cards — Backlog UI Storybook</PageTitle>

<StoryPage Title="Work cards"
           Summary="A session or a pull request as a card beside the task it worked on: the session's title, its state and one line of what it last did; the pull request's number and title, draft or open, the reviewers' verdict, the checks and the diff size. `WorkLinks` sets them in two columns that say `None yet` when empty, with `Unlink` beside each card while the host listens and no column for a feature that is off, `WorkLinksPanel` is the same columns as a section of a task's side panel, and `WorkLinkPicker` is the dialog behind linking one to a task."
           Guidelines="@Rules">

    <Story Name="A session card in each state"
           Description="`WorkSessionCard` takes a `WorkSession`: the host's id, a title, an `IntegrationSessionState` and a detail line the host has already written. Quiet and waiting are the two that ask for the person, so they wear the primary edge and a filled state; quiet is worded `Quiet 30 min`, the threshold after which the host stops calling a session running. With `OnOpen` the card is a button; without it, inert."
           Code="@SessionCode">
        <div class="sb-stack" data-testid="work-session-states">
            <WorkSessionCard Session="@IntegrationFixtures.QuietSession" OnOpen="OpenSession" TestId="work-session-quiet" />
            <WorkSessionCard Session="@IntegrationFixtures.RunningSession" OnOpen="OpenSession" TestId="work-session-running" />
            <WorkSessionCard Session="@IntegrationFixtures.FinishedSession" OnOpen="OpenSession" TestId="work-session-finished" />
            <WorkSessionCard Session="@IntegrationFixtures.LooseSession" TestId="work-session-inert" />
        </div>
        <p class="sb-state" data-testid="work-cards-opened">Opened: @(_opened ?? "(none)")</p>
    </Story>

    <Story Name="A pull request card"
           Description="`WorkPullRequestCard` takes a `WorkPullRequest`. A failing check or requested changes is what asks for the person, so that card wears the error edge and says why in the error ink; approved and passing are in the success ink. `ChecksText` carries a count when the host has one — `Checks running 4/7` — and the card words the state itself when it does not. The diff size is drawn only when the host read one."
           Code="@PullRequestCode">
        <div class="sb-stack" data-testid="work-pull-request-states">
            <WorkPullRequestCard PullRequest="@IntegrationFixtures.DraftPullRequest" OnOpen="OpenPullRequest" TestId="work-pull-request-draft" />
            <WorkPullRequestCard PullRequest="@IntegrationFixtures.ChangesRequestedPullRequest" OnOpen="OpenPullRequest" TestId="work-pull-request-changes" />
            <WorkPullRequestCard PullRequest="@IntegrationFixtures.ApprovedPullRequest" OnOpen="OpenPullRequest" TestId="work-pull-request-approved" />
        </div>
    </Story>

    <Story Name="A pull request card with its status line"
           Description="Where the host read the counts it sets `WorkPullRequest.Status`, a `PullRequestStatusModel`, and the card draws the pull request's status line among its facts: checks as `passed/total` and approvals as `received/required`, without the `#n` pill because the card leads with the number. The checks mark says what the checks words would, so those words are left out beside it; the reviewers' verdict stays. A required total is a verdict only where the base branch's rules were read — the last card's were not, so its approvals stand alone. A merged pull request draws no line: it already says `Merged`."
           Code="@PullRequestStatusCode">
        <div class="sb-stack" data-testid="work-pull-request-status-states">
            <WorkPullRequestCard PullRequest="@IntegrationFixtures.DraftPullRequestWithStatus" OnOpen="OpenPullRequest" TestId="work-pull-request-status-draft" />
            <WorkPullRequestCard PullRequest="@IntegrationFixtures.ChangesRequestedPullRequestWithStatus" OnOpen="OpenPullRequest" TestId="work-pull-request-status-changes" />
            <WorkPullRequestCard PullRequest="@IntegrationFixtures.ApprovedPullRequestWithStatus" OnOpen="OpenPullRequest" TestId="work-pull-request-status-approved" />
            <WorkPullRequestCard PullRequest="@IntegrationFixtures.UnreadRulesPullRequestWithStatus" OnOpen="OpenPullRequest" TestId="work-pull-request-status-unread" />
        </div>
        <WorkLinksPanel PullRequests="@([IntegrationFixtures.DraftPullRequestWithStatus, IntegrationFixtures.ApprovedPullRequestWithStatus])"
                        ShowSessions="false"
                        OnOpenPullRequest="OpenPullRequest"
                        TestId="work-links-panel-status" />
    </Story>

    <Story Name="Two columns, None yet when empty"
           Description="`WorkLinks` sets a task's sessions and pull requests side by side, each under a small heading, and wraps them under each other where the host is narrow. A column with nothing in it says `None yet`, so an empty column reads as looked at rather than forgotten. With `OnUnlinkSession` or `OnUnlinkPullRequest` set, each card gets a quiet `Unlink` beside it, a button of its own because the card is already the button that opens the item; its name says which item it takes off. `ShowSessions` or `ShowPullRequests` off leaves that column out altogether, as the host does while that feature is off."
           Code="@LinksCode">
        <div class="sb-stack" data-testid="work-links-samples">
            <WorkLinks Sessions="@([IntegrationFixtures.QuietSession])"
                       PullRequests="@([IntegrationFixtures.DraftPullRequest])"
                       OnOpenSession="OpenSession"
                       OnOpenPullRequest="OpenPullRequest"
                       OnUnlinkSession="UnlinkSession"
                       OnUnlinkPullRequest="UnlinkPullRequest"
                       TestId="work-links-both" />
            <WorkLinks Sessions="@([IntegrationFixtures.RunningSession])" TestId="work-links-sessions-only" />
            <WorkLinks Sessions="@([IntegrationFixtures.RunningSession])" ShowPullRequests="false" TestId="work-links-pull-requests-off" />
        </div>
    </Story>

    <Story Name="Each pull request with its goal"
           Description="A host that sets goals cascades a `GoalControlSlot`, and `WorkLinks` draws it beside each pull request whose key reads as `owner/name#number`, for that pull request, before its `Unlink`: the goal a pull request counts toward is set where the pull request is read. A key of another shape draws no control rather than a wrong one, and without a slot the cards are the ones above. Press a card's goal and the picker opens on that pull request."
           Code="@GoalLinksCode">
        <CascadingValue Value="WorkGoals.Slot">
            <WorkLinks Sessions="@([IntegrationFixtures.QuietSession])"
                       PullRequests="@([IntegrationFixtures.DraftPullRequest, IntegrationFixtures.ApprovedPullRequest])"
                       OnOpenPullRequest="OpenPullRequest"
                       OnUnlinkPullRequest="UnlinkPullRequest"
                       TestId="work-links-goals" />
        </CascadingValue>
        <GoalPicker Open="WorkGoals.Picking"
                    OpenChanged="value => WorkGoals.Picking = value"
                    Subject="WorkGoals.Subject"
                    Goals="@GoalFixtures.Open"
                    CurrentGoal="WorkGoals.Current"
                    OnAttach="WorkGoals.Attach"
                    OnCreate="WorkGoals.Create"
                    TestId="work-goal-picker" />
    </Story>

    <Story Name="A section of a task's side panel"
           Description="`WorkLinksPanel` is the same columns stacked, under a `Sessions and pull requests` heading with `Link a session or pull request…` at the end of its line where there is room, and `Unlink` beside each card; an empty column says `None yet` on its heading's line. With one feature off the heading and the link action name only the kind left — `Pull requests`, `Link a pull request…` — and the other column is not drawn. Each control is drawn only while the host listens for it. The button opens the host's `WorkLinkPicker`, shown here with the tasks a loose session could be linked to."
           Code="@PanelCode">
        <div class="sb-board-column" data-testid="work-links-panel-sample">
            <WorkLinksPanel Sessions="@([IntegrationFixtures.QuietSession])"
                            PullRequests="@([IntegrationFixtures.DraftPullRequest])"
                            OnOpenSession="OpenSession"
                            OnOpenPullRequest="OpenPullRequest"
                            OnUnlinkSession="UnlinkSession"
                            OnUnlinkPullRequest="UnlinkPullRequest"
                            OnLink="() => _picking = true" />
        </div>
        <div class="sb-board-column" data-testid="work-links-panel-one-feature">
            <WorkLinksPanel PullRequests="@([IntegrationFixtures.ApprovedPullRequest])"
                            ShowSessions="false"
                            OnOpenPullRequest="OpenPullRequest"
                            OnUnlinkPullRequest="UnlinkPullRequest"
                            OnLink="() => _picking = true" />
        </div>
        <p class="sb-state" data-testid="work-links-panel-opened">Last: @(_opened ?? "(none)")</p>
        <WorkLinkPicker Open="_picking"
                        OpenChanged="open => _picking = open"
                        Title="Link to a task"
                        Description="Choose the task the session is working on."
                        Options="@IntegrationFixtures.LinkTaskOptions"
                        OnChosen="Link" />
    </Story>

    <Story Name="Linking a pull request by number or link"
           Description="With `ReferenceLabel` set and `OnReference` listened to, `WorkLinkPicker` draws a field and a `Link` button under its list: a pull request typed by number or pasted as its link, whatever its state — open, merged or closed — so work that merged before its task was linked can still be linked. Enter or `Link` hands the text to the host, which reads it and links it, then closes the dialog; a refusal is the host's sentence under the field, with the text kept. This sample refuses anything that is not a number or a GitHub pull request link."
           Code="@ReferenceCode">
        <AppButton OnClick="() => { _referenceError = null; _pickingReference = true; }" TestId="work-link-reference-open">Link a session or pull request…</AppButton>
        <p class="sb-state" data-testid="work-link-reference-last">Last: @(_referenceLinked ?? "(none)")</p>
        <WorkLinkPicker Open="_pickingReference"
                        OpenChanged="open => _pickingReference = open"
                        Title="Link a session or pull request"
                        Description="Running sessions and your open pull requests that no task links yet."
                        Options="@IntegrationFixtures.LinkTaskOptions"
                        OnChosen="option => _referenceLinked = option.Label"
                        ReferenceLabel="Or a pull request by number or link"
                        ReferencePlaceholder="1214 or https://github.com/owner/name/pull/1214"
                        ReferenceHelp="Open, merged or closed, from a repository registered in Settings."
                        ReferenceError="@_referenceError"
                        OnReference="LinkReference"
                        TestId="work-link-reference-picker" />
    </Story>
</StoryPage>

@code {
    private static readonly DesignGuideline[] Rules =
    [
        new("color-scheme.md#integration-roles", "The tone each session and pull request state is drawn in."),
        new("color-scheme.md#pull-request-status-marks", "The ink and glyph of each checks and approvals mark on a pull request card."),
        new("typography-and-layout.md#metadata-lines", "How a card's state, checks and size sit on one line under its title."),
        new("accessibility.md#iconography-accessibility", "Why a state is always said in words beside its colour.")
    ];

    private string? _opened;
    private bool _picking;

    private void OpenSession(WorkSession session) => _opened = $"session {session.Id}";

    private void OpenPullRequest(WorkPullRequest pull) => _opened = pull.Key;

    private void UnlinkSession(WorkSession session) => _opened = $"unlinked session {session.Id}";

    private void UnlinkPullRequest(WorkPullRequest pull) => _opened = $"unlinked {pull.Key}";

    private void Link(WorkLinkOption option) => _opened = $"Linked to {option.Label}";

    private bool _pickingReference;
    private string? _referenceError;
    private string? _referenceLinked;

    private void LinkReference(string reference)
    {
        var digits = reference.TrimStart('#');
        var link = reference.Split("/pull/", 2);
        var number = int.TryParse(digits, out var bare) ? bare
            : link.Length == 2 && int.TryParse(link[1].Split('/', '?', '#')[0], out var linked) ? linked
            : 0;

        if (number <= 0)
        {
            _referenceError = "Type a pull request's number, or paste its link.";
            return;
        }

        _referenceError = null;
        _referenceLinked = $"#{number}";
        _pickingReference = false;
    }

    private const string ReferenceCode = """
        <WorkLinkPicker Open="_picking"
                        OpenChanged="open => _picking = open"
                        Title="Link a session or pull request"
                        Options="@loose"
                        OnChosen="LinkAsync"
                        ReferenceLabel="Or a pull request by number or link"
                        ReferencePlaceholder="1214 or https://github.com/owner/name/pull/1214"
                        ReferenceHelp="Open, merged or closed, from a repository registered in Settings."
                        ReferenceError="@referenceError"
                        ReferenceBusy="linking"
                        OnReference="LinkReferenceAsync" />
        """;

    private const string SessionCode = """
        <WorkSessionCard Session="@(new WorkSession("4a1c9e02", "Extract TaskCard",
                             IntegrationSessionState.Stalled, "Last activity 42 min ago · 9 prompts"))"
                         OnOpen="OpenSession" />
        """;

    private const string PullRequestStatusCode = """
        <WorkPullRequestCard PullRequest="@(new WorkPullRequest("JSdotNet/Backlog#1019", 1019,
                                 "Extract TaskCard component", IntegrationArtifactState.Draft,
                                 Checks: IntegrationCheckState.Pending)
                             {
                                 Status = new PullRequestStatusModel(1019, "draft",
                                     new PullRequestChecks(Passed: 4, Failed: 0, Pending: 3),
                                     new PullRequestApprovals(Received: 1, Required: 2))
                             })"
                             OnOpen="OpenPullRequest" />
        """;

    private const string PullRequestCode = """
        <WorkPullRequestCard PullRequest="@(new WorkPullRequest("JSdotNet/Backlog#1018", 1018,
                                 "Filter Tasks by plan", IntegrationArtifactState.Open,
                                 IntegrationReviewState.ChangesRequested, IntegrationCheckState.Failing,
                                 "1 check failing", Additions: 156, Deletions: 22))"
                             OnOpen="OpenPullRequest" />
        """;

    // --- Pull requests with their goals --------------------------------------

    private GoalStoryHost? _workGoals;

    /// <summary>The goal slot the page cascades, as a host would, over the sample goals.</summary>
    private GoalStoryHost WorkGoals => _workGoals ??= new(this, new Dictionary<GoalSubject, GoalOption>
    {
        [GoalSubject.ForPullRequest("JSdotNet/Backlog", 1019)] = GoalFixtures.Launch
    });

    private const string GoalLinksCode = """
        @* The host cascades its goal control once; each pull request card draws it. *@
        <CascadingValue Value="@goalSlot">
            <WorkLinks Sessions="@task.Sessions" PullRequests="@task.PullRequests"
                       OnUnlinkPullRequest="UnlinkAsync" />
        </CascadingValue>
        """;

    private const string LinksCode = """
        <WorkLinks Sessions="@task.Sessions"
                   PullRequests="@task.PullRequests"
                   OnOpenSession="OpenSession"
                   OnOpenPullRequest="OpenPullRequest"
                   OnUnlinkSession="UnlinkSessionAsync"
                   OnUnlinkPullRequest="UnlinkPullRequestAsync"
                   ShowPullRequests="pullRequestsOn" />
        """;

    private const string PanelCode = """
        <WorkLinksPanel Sessions="@sessions"
                        PullRequests="@pulls"
                        OnOpenSession="OpenSession"
                        OnOpenPullRequest="OpenPullRequest"
                        OnUnlinkSession="UnlinkSessionAsync"
                        OnUnlinkPullRequest="UnlinkPullRequestAsync"
                        OnLink="() => _picking = true" />

        <WorkLinkPicker Open="_picking"
                        OpenChanged="open => _picking = open"
                        Title="Link to a task"
                        Options="@tasks"
                        OnChosen="LinkAsync" />
        """;
}
