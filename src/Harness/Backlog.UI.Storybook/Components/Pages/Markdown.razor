        """;

    private const string FootnotesViewCode = """
        <MarkdownFootnotesView Footnotes="@notes" />
        """;

    private const string LinkViewCode = """
        @* The same call every read view makes. MarkdownStory is the storybook's frame
           around it, so a page does not repeat the parse in each story. *@
        <MarkdownView Blocks="@MarkdownPreview.ParseDocument(source)" />
        """;

    private const string UnknownViewCode = """
        <MarkdownView Blocks="@MarkdownPreview.ParseDocument(source)" />
        """;

    private const string InlineViewCode = """
        @* Parsed as a document, so a line of prose with one inline in it is a paragraph
           holding that inline rather than the inline on its own. *@
        @foreach (var inline in InlineKinds)
        {
            <MarkdownView Blocks="@MarkdownPreview.ParseDocument(inline.Source)" />
        }
        """;
}
