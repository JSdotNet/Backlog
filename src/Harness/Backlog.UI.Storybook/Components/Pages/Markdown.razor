@page "/markdown"

<PageTitle>Markdown — Backlog UI Storybook</PageTitle>

<StoryPage Title="Markdown"
           Summary="MarkdownPreview parses the source into blocks, MarkdownView renders them. The base content items only: what each block and each inline is, what makes one, and what element it becomes. Every story shows the rendering beside the source that produced it. A document as a surface — copy, comments, a way into the editor — is the Markdown document chapter under Combined usage; writing markdown is Rich text editing and Entry edit."
           Guidelines="@Rules">

    <Story Name="Everything the read view renders"
           Description="One source, every block kind in it. Pass `Blocks` and nothing else and this is what a body renders as. Everything below takes one piece of it apart."
           Code="@ReadCode"
           Source="@EverythingSample">
        <MarkdownStory Source="@EverythingSample" TestId="markdown-everything" />
    </Story>

    <Story Name="Blocks the parser produces"
           Description="MarkdownPreview does not hand back a string of HTML. It hands back a list of records — a small closed set, one per kind of thing the read view knows how to draw — and MarkdownView switches over that list. Two things follow from it, and both are the reason the parse is worth looking at directly. The renderer can never emit markup the parser did not describe, because it has nothing to emit it from; and a line that renders as prose when you expected something else is a parse you can inspect rather than a stylesheet you have to guess at.

The set is closed and small on purpose. It covers the markdown people actually write here, and anything outside it falls through as a paragraph rather than erroring or disappearing. Below is each record, what in the source makes one, and what MarkdownView turns it into.">
        <dl class="sb-grid" data-testid="markdown-block-kinds">
            @foreach (var block in BlockKinds)
            {
                <div class="sb-stack">
                    <dt class="sb-label">@block.Record</dt>
                    <dd class="sb-stack">
                        <p>@block.Made</p>
                        <CodeView Source="@block.Source" Language="markdown" AllowCopy="false" CssClass="sb-raw__code" />
                        <p class="sb-state">@block.Renders</p>
                    </dd>
                </div>
            }
        </dl>
    </Story>

    <Story Name="The same source, as the parser saw it"
           Description="The first story's blocks, in order. This is the view to reach for when a line came out as prose and you want to know why: a block that reads MdParagraph where you expected MdList is a source problem, and one that reads right but looks wrong is a stylesheet problem. Knowing which of the two you have is most of the work.">
        <ol class="sb-stack" data-testid="markdown-blocks">
            @foreach (var block in EverythingBlocks)
            {
                <li><code>@block.GetType().Name</code></li>
            }
        </ol>
    </Story>

    <Story Name="Headings"
           Description="Six levels, each rendered as a `p.md-heading.md-heading--N` carrying `role=&quot;heading&quot;` and `aria-level`. Not an `h1`–`h6`, on purpose: an entry's body is content inside a page that already has an outline of its own, and real heading elements would splice the body's structure into the host's. The level still reaches a screen reader, so heading navigation works."
           Code="@HeadingCode"
           Source="@HeadingSample">
        <MarkdownStory Source="@HeadingSample" TestId="markdown-headings" />
    </Story>

    <Story Name="Inline styling"
           Description="What the parser finds inside a line, and what each one is wrapped in. Emphasis, strong and strikethrough get the plain elements, because that is what they mean; a code span and a #tag get classes, because they are this product's own vocabulary. MdText is the rest — the run between two matches, emitted as content and nothing more."
           Code="@InlineCode"
           Source="@InlineSample">
        <MarkdownStory Source="@InlineSample" TestId="markdown-inlines" />
    </Story>

    <Story Name="Every inline, one at a time"
           Description="The same set as a reference, each on its own so the styling can be compared without a sentence around it.">
        <dl class="sb-grid" data-testid="markdown-inline-kinds">
            @foreach (var inline in InlineKinds)
            {
                <div class="sb-stack">
                    <dt class="sb-label">@inline.Record</dt>
                    <dd class="sb-stack">
                        <CodeView Source="@inline.Source" Language="markdown" AllowCopy="false" CssClass="sb-raw__code" />
                        <div><MarkdownView Blocks="@MarkdownPreview.ParseDocument(inline.Source)" /></div>
                        <p class="sb-state">@inline.Renders</p>
                    </dd>
                </div>
            }
        </dl>
    </Story>

    <Story Name="Lists, including nested ones"
           Description="Bulleted, ordered, and checklists — all three are one MdList, and what separates them is the item. A checklist item carries `Done`; a plain bullet's is null, which is what lets the two sit in the same list and keep their own markers. A checklist item that is not being listened to renders its state as an `img` with a label rather than as a control, so Tab walks past it instead of stopping on a checkbox that would do nothing.

Indentation also continues: a line with no marker of its own, written further in than the item above it, is that item wrapped rather than a new block, and the two lines are read as one so markup may open on the first and close on the second. A line that starts where the marker starts still ends the list.

Indentation nests. An indented run belongs to the item above it, as deep as it is written, and a nested list may be a different kind from its parent — numbers under a bullet are normal. A tab counts as four columns. Nesting does not disturb the checklist indices: the parser numbers task lines in the order they were written, which is the order the rewriter walks them in, so a nested checkbox still writes back to its own line."
           Code="@ListCode"
           Source="@ListSample">
        <MarkdownStory Source="@ListSample" TestId="markdown-lists" />
    </Story>

    <Story Name="Tables"
           Description="A header, a row of dashes, and rows. The dashes are what make it a table — a sentence with a pipe in it is still a sentence. Colons on the delimiter set the column: `:---` left, `:---:` centre, `---:` right. Outer pipes are optional, and a short row is padded rather than dropped.

The table is wrapped in `div.md-table-scroll`, and the wrapper — not the table — is the labelled, focusable scroll region, so a keyboard can reach the overflow while the table stays a table to a screen reader."
           Code="@TableCode"
           Source="@TableSample">
        <MarkdownStory Source="@TableSample" TestId="markdown-tables" />
    </Story>

    <Story Name="Footnotes"
           Description="A `[^label]` in the prose and a `[^label]: …` on its own line anywhere in the body. Definitions are collected before anything is parsed, so it does not matter whether one is written above or below the reference that uses it — people put them at the bottom, and the reference still resolves.

Numbering follows the order marks are first met, not the order definitions were written. The same label referenced twice is one note with one number, and a reference with no definition behind it stays the text that was typed. A `[^1]:` inside a code fence is a sample, the same blindness the parser has to a `- [ ]` in one.

Each mark is a real anchor into the note, and each note carries a link back."
           Code="@FootnoteCode"
           Source="@FootnoteSample">
        <MarkdownStory Source="@FootnoteSample" TestId="markdown-footnotes" />
    </Story>

    <Story Name="Quotes over more than one line"
           Description="Consecutive `>` lines are one quote; a blank line separates two."
           Code="@QuoteCode"
           Source="@QuoteSample">
        <MarkdownStory Source="@QuoteSample" TestId="markdown-quotes" />
    </Story>

    <Story Name="Images"
           Description="`![alt](url)` is an image, and the `!` matters — without it the parser read the same text as a link with a stray bang in front of it. The URL goes through the same scheme allow-list a link does, and for a stronger reason: an `src` fetches on its own, with no click to consent to it, so a `javascript:` or `data:` URL shows its alt text instead of being loaded. The alt text is also what PlainText reports, because it is the whole of what the image says to something that cannot see it."
           Code="@ImageCode"
           Source="@ImageSample">
        <MarkdownStory Source="@ImageSample" TestId="markdown-images" />
    </Story>

    <Story Name="Links we will not follow"
           Description="A link is only rendered as one when its scheme is http, https, mailto, or a relative path. Anything else — `javascript:`, `data:` — keeps its text and loses its href, styled `md-link--inert` so it is visibly not a link. Escaping keeps typed markup out of the document; an href is the second door, because these bodies render in a WebView and can arrive from a repository file nobody here wrote. So the scheme is an allow-list: anything unrecognised is text."
           Source="@LinkSample">
        <MarkdownStory Source="@LinkSample" TestId="markdown-links" />
    </Story>

    <Story Name="Anything it does not know is still readable"
           Description="The parser is partial on purpose, and this is what that buys. Setext headings, reference-style links, raw HTML, definition lists, a quote inside a list item — none of them are handled, and every one comes back with its text intact. The failure mode of a body being written one character at a time is prose that looks slightly wrong, never a line that vanishes and never an exception."
           Source="@UnknownSample">
        <MarkdownStory Source="@UnknownSample" TestId="markdown-unknown" />
    </Story>

</StoryPage>

@code {
    private static readonly DesignGuideline[] Rules =
    [
        new("content-editing.md#supported-constructs", "Which markdown constructs the product renders, and which it leaves as text."),
        new("typography-and-layout.md#heading-defaults", "The heading ramp a body's own levels are set in."),
        new("typography-and-layout.md#type-scale", "The sizes and line heights prose is read at."),
        new("accessibility.md#screen-reader--announcements", "What a body's structure has to expose to a screen reader."),
        new("color-scheme.md#syntax-highlighting-tokens", "The colours a fenced block inside a body is drawn with.")
    ];

    /// <summary>One row of the block reference: the record, what in the source
    /// produces it, and what MarkdownView turns it into.</summary>
    private sealed record BlockKind(string Record, string Made, string Source, string Renders);

    private sealed record InlineKind(string Record, string Source, string Renders);

    // ParseDocument, not Parse. This chapter is about markdown, and in markdown a
    // `##` is a heading — reading these as entries would fold every sample from
    // its first `##` down into a sub-item the view draws nothing for. That
    // reading is real and it is the product's, but it belongs on Entry edit.
    private const string EverythingSample = """
        # A heading

        A paragraph with **bold**, *emphasis*, ~~strikethrough~~, `inline code`,
        a #tag and a [link](https://learn.microsoft.com/aspnet/core/blazor).

        ## A second-level heading

        - A bullet
          - Nested under it
        - [x] A finished task
        - [ ] An unfinished one

        1. First ordered item
        2. Second ordered item

        > A quote, which may run
        > over more than one line.

        | Column | Meaning |
        | ------ | ------- |
        | Tables | are read as tables |

        ```csharp
        var blocks = MarkdownPreview.ParseDocument(source);
        ```

        ---

        The last paragraph, with a footnote[^end].

        [^end]: Notes are collected at the bottom.
        """;

    private const string HeadingSample = """
        # Level one
        ## Level two
        ### Level three
        #### Level four
        ##### Level five
        ###### Level six
        """;

    private const string InlineSample = """
        A paragraph with **bold**, *emphasis*, ~~strikethrough~~, `inline code`,
        a #tag and a [link](https://learn.microsoft.com/aspnet/core/blazor).
        """;

    private const string ListSample = """
        - A bullet
        - Another, with a #tag
          - Nested one level
            - And another
          1. Numbers under a bullet are fine
        - [x] A finished task
        - A plain bullet in the same list
        - [ ] An unfinished task
          - [ ] Nested, and still numbered by its line
        - A bullet whose sentence runs on past one line,
            wrapped in under itself rather than starting a second bullet

        1. First
        2. Second
        """;

    private const string TableSample = """
        | Component | Chapter    | Lines |
        | :-------- | :--------: | ----: |
        | CodeView  | Code       |   207 |
        | FileView  | File view  |   198 |
        | Markdown  | Markdown   |  1024 |

        Outer pipes are optional:

        Name | Status
        ---- | ------
        One  | Open
        """;

    private const string FootnoteSample = """
        The parser is deliberately partial[^partial], and the read view is the
        only thing that renders it[^single].

        A label used twice[^partial] is still one note.

        A mark with no definition[^missing] stays the text that was typed.

        [^partial]: It covers what people write here and degrades the rest to prose.
        [^single]: MarkdownView, switching over the block records.
        """;

    private const string QuoteSample = """
        > A quotation long enough that it has to wrap,
        > written across two source lines the way people write them.

        > A second quote, separated by a blank line.
        """;

    private const string ImageSample = """
        A relative URL, which resolves against the page — the realistic case, an
        entry pointing at a file beside it:

        ![Three boxes joined by arrows](sample-image.svg)

        A URL we will not fetch shows what the author meant by it instead:

        ![A diagram that would have been loaded](javascript:steal())
        """;

    private const string LinkSample = """
        A [normal link](https://learn.microsoft.com/aspnet/core/blazor), a
        [relative one](notes/entry.md), and one whose URL has brackets of its own
        — [the C article](https://en.wikipedia.org/wiki/C_(programming_language)).

        A [script URL](javascript:doEvil) and a [data URL](data:text/html,hi) do not.
        """;

    private const string UnknownSample = """
        A setext heading
        ================

        A [reference link][ref] finds no target, so it stays as typed.

        <div>Raw HTML is escaped, not run.</div>

        Term
        : A definition list is not one of the shapes here.

        - A list item
          > with a quote under it, which is not folded in

        An *unclosed emphasis, and a line still being typ
        """;

    /// <summary>Every block record, in the order the parser is written to find
    /// them. Kept as data rather than as prose so the reference cannot quietly
    /// grow out of step with the set.</summary>
    private static readonly IReadOnlyList<BlockKind> BlockKinds =
    [
        new("MdHeading",
            "One to six `#` and a space. Carries the level and its inlines.",
            "# A heading",
            "p.md-heading.md-heading--1, role=heading, aria-level=1"),

        new("MdParagraph",
            "Any run of lines that matched nothing else. Consecutive lines are joined into one, so a body wrapped at 80 columns reads as prose rather than as a stack of short lines.",
            "A paragraph, wrapped\nacross two source lines.",
            "p.md-p"),

        new("MdList",
            "A run of `-`, `*` or `1.` lines. Ordered is a property of the list; whether an item is a task belongs to the item, so the two can be mixed. An indented run becomes the item's Children.",
            "- A bullet\n  - Nested under it\n- [x] A finished task",
            "ul.md-list or ol.md-list, with li per item"),

        new("MdQuote",
            "A run of `> ` lines. Consecutive lines are one quote; a blank line starts the next.",
            "> A quote that runs\n> over two lines.",
            "blockquote.md-quote"),

        new("MdCode",
            "A triple-backtick fence, with whatever the opening fence named as the language. Nothing inside is parsed, which is why a `- [ ]` in a fence is a code sample and never a task.",
            "```csharp\nvar x = 1;\n```",
            "pre.md-code — or DiagramView, when the language is one it draws"),

        new("MdTable",
            "A row of pipes with a row of dashes under it. The dashes are the test: without them a sentence containing a pipe would become a table.",
            "| Name | Status |\n| ---- | -----: |\n| One  | Open   |",
            "div.md-table-scroll wrapping table.md-table"),

        new("MdFootnotes",
            "Appended once, when at least one `[^label]` reference found a `[^label]: …` definition. Never produced for a body without them.",
            "A claim[^1].\n\n[^1]: The evidence.",
            "aside.md-footnotes with an ol of notes"),

        new("MdDivider",
            "A line that is exactly `---`, `***` or `___`.",
            "---",
            "hr.md-divider"),

        new("MdSubItem",
            "Only from Parse, never from ParseDocument: a `##` or `###` heading and everything under it, folded into one record. MarkdownView renders nothing for it — the host lays each one out as its own card. See the Entry edit chapter.",
            "## A sub-item\n\nIts notes.",
            "nothing here, by design")
    ];

    private static readonly IReadOnlyList<InlineKind> InlineKinds =
    [
        new("MdText", "just words", "the run itself, escaped and nothing more"),
        new("MdStrong", "**bold**", "strong"),
        new("MdEm", "*emphasis*", "em"),
        new("MdStrike", "~~struck out~~", "s"),
        new("MdCodeSpan", "`inline code`", "code.md-inline-code"),
        new("MdTag", "#tag", "span.tag-chip — the same chip the Badges chapter shows"),
        new("MdLink", "[a link](https://example.com)", "a.md-link, target=_blank, rel=noopener noreferrer"),
        // A URL that resolves: this row renders live, and a placeholder would
        // 404 and show the reader a broken image instead of an image.
        new("MdImage", "![alt text](sample-image.svg)", "img.md-image, loading=lazy — or its alt text, when the URL is one we will not fetch"),
        new("MdFootnoteRef", "a claim[^1]", "sup.md-fnref anchored to the note — only when the label is defined")
    ];

    private static readonly IReadOnlyList<MdBlock> EverythingBlocks = MarkdownPreview.ParseDocument(EverythingSample);

    private const string ReadCode = """
        @* No OnTaskItemToggled: this is the read view, so checkboxes are state. *@
        <MarkdownView Blocks="@MarkdownPreview.ParseDocument(body)" />
        """;

    private const string HeadingCode = """
        <p class="md-heading md-heading--2" role="heading" aria-level="2">Level two</p>
        """;

    private const string InlineCode = """
        A paragraph with **bold**, *emphasis*, ~~strikethrough~~, `inline code`,
        a #tag and a [link](https://example.com).
        """;

    private const string ListCode = """
        - A bullet
          - Nested one level
        - [x] A finished task
        - [ ] An unfinished one
        """;

    private const string TableCode = """
        | Component | Chapter   | Lines |
        | :-------- | :-------: | ----: |
        | CodeView  | Code      |   207 |
        """;

    private const string FootnoteCode = """
        A claim[^1], and another[^2].

        [^1]: The evidence.
        [^2]: More of it.
        """;

    private const string QuoteCode = """
        > A quotation long enough that it has to wrap,
        > written across two source lines.
        """;

    private const string ImageCode = """
        ![Alt text, which is what a screen reader gets](diagram.png)
        """;
}
