@page "/markdown"
@implements IDisposable

<PageTitle>Markdown — Backlog UI Storybook</PageTitle>

<StoryPage Title="Markdown"
           Summary="MarkdownPreview parses the source, MarkdownView renders it. Editing and reading are the same text seen two ways.">

    <Story Name="Edit and read"
           Description="Source on the left, read view on the right. There is no save button on purpose: the product auto-saves, so the indicator under the editor goes Saving then Saved as you type — it renders nothing at all while idle. Ticking a checkbox writes back into the source and saves at once, with no debounce, because a toggle is a discrete change and there is nothing more to wait for. Try ticking one while the source has a code fence in it: the `- [ ]` inside the fence is a code sample, not a task, and MarkdownPreview.ToggleTask skips it the same way the parser did."
           Code="@EditCode">
        <div class="sb-columns">
            <div class="sb-stack">
                <p class="sb-label">Source</p>
                <TextArea Value="@_source"
                          ValueChanged="OnSourceChangedAsync"
                          AriaLabel="Markdown source"
                          Rows="18"
                          AutoGrow="false"
                          TestId="markdown-source" />
                <SaveIndicator State="_saveState" TestId="markdown-save-indicator" />
            </div>
            <div class="sb-stack">
                <p class="sb-label">Read view</p>
                <div data-testid="markdown-preview">
                    <MarkdownView Blocks="_blocks" OnTaskItemToggled="ToggleTask" />
                </div>
            </div>
        </div>
    </Story>

    <Story Name="Read-only view"
           Description="The same component with fixed content and no toggle handler — how a body renders when it is not being edited. The checkboxes here are state, not controls: no delegate means no button, so Tab walks past them instead of stopping on something that would do nothing."
           Code="@ReadOnlyCode">
        <div data-testid="markdown-readonly">
            <MarkdownView Blocks="FixedBlocks" />
        </div>
    </Story>

    <Story Name="Tasks and bullets in one list"
           Description="A list may mix the two. Only the checklist items drop their marker — a plain bullet between them keeps its own, or it reads as a stray line of prose."
           Code="@MixedCode">
        <div data-testid="markdown-mixed">
            <MarkdownView Blocks="MixedBlocks" />
        </div>
    </Story>

    <Story Name="Links we will not follow"
           Description="A link is only rendered as one when its scheme is http, https, mailto, or a relative path. Anything else — `javascript:`, `data:` — stays as the text the author typed, because the read view is a webview and an href is the one place typed text could still become behaviour.">
        <div data-testid="markdown-links">
            <MarkdownView Blocks="LinkBlocks" />
        </div>
    </Story>

    <Story Name="Blocks the parser produces"
           Description="What MarkdownPreview made of the source in the first story — useful when a line renders as prose and you want to know why.">
        <ul class="sb-stack" data-testid="markdown-blocks">
            @foreach (var block in _blocks)
            {
                <li><code>@block.GetType().Name</code></li>
            }
        </ul>
    </Story>

    <Story Name="Sub-items are not rendered here"
           Description="A `##` heading starts a sub-item, and the read view leaves those to the host to lay out as its own card. Only the prose above the first `##` appears — which is why nothing else on this page uses one.">
        <div class="sb-columns">
            <div>
                <p class="sb-label">Source</p>
                <pre class="sb-story__code"><code>@SubItemSample</code></pre>
            </div>
            <div>
                <p class="sb-label">Read view</p>
                <div data-testid="markdown-subitems">
                    <MarkdownView Blocks="SubItemBlocks" />
                </div>
            </div>
        </div>
    </Story>

</StoryPage>

@code {
    private const string InitialSource = """
        # Storybook entry

        A paragraph with **bold**, *emphasis*, `inline code`, a #tag and a
        [link to the read view](https://learn.microsoft.com/aspnet/core/blazor).

        # Checklist

        - [x] Move the shared components into Backlog.UI.Components
        - [x] Keep the markdown parser next to the view that renders it
        - [ ] Give every component a story
        - [ ] Drive the storybook from Playwright

        # Notes

        - Plain bullets still work
        - So do #tags in a list

        1. First ordered item
        2. Second ordered item

        > Everything auto-saves. There is no save button anywhere in the product.

        ```csharp
        var blocks = MarkdownPreview.Parse(source);
        ```

        ---

        Anything the parser does not recognise falls through as readable prose.
        """;

    private const string FixedSample = """
        # Read-only body

        This one never changes, so it shows the read view without an editor next to it.

        - [x] Done item
        - [ ] Open item

        > A quote, and a #tag.
        """;

    private const string MixedSample = """
        - [x] A task
        - A plain bullet in the same list
        - [ ] Another task
        """;

    private const string LinkSample = """
        A [normal link](https://learn.microsoft.com/aspnet/core/blazor), a
        [relative one](notes/entry.md), and one whose URL has brackets of its own
        — [the C article](https://en.wikipedia.org/wiki/C_(programming_language)).

        A [script URL](javascript:doEvil) and a [data URL](data:text/html,hi) do not.
        """;

    // A `##` heading is a sub-item: the parser folds everything under it into an
    // MdSubItem, and MarkdownView deliberately does not render those because the
    // host lays each one out as its own card. Nothing on this page uses `##`, or
    // half the sample would vanish from the read view.
    private const string SubItemSample = """
        # Visible

        This paragraph renders.

        ## A sub-item

        Everything from the `##` down belongs to the sub-item, so the read view
        leaves it to the host.
        """;

    private string _source = InitialSource;
    private SaveState _saveState = SaveState.Idle;
    private CancellationTokenSource? _saveDelay;

    // Parsed once per change rather than once per read: the page re-renders on
    // every keystroke, and all but the first of these never change at all.
    private IReadOnlyList<MdBlock> _blocks = MarkdownPreview.Parse(InitialSource);
    private static readonly IReadOnlyList<MdBlock> FixedBlocks = MarkdownPreview.Parse(FixedSample);
    private static readonly IReadOnlyList<MdBlock> MixedBlocks = MarkdownPreview.Parse(MixedSample);
    private static readonly IReadOnlyList<MdBlock> LinkBlocks = MarkdownPreview.Parse(LinkSample);
    private static readonly IReadOnlyList<MdBlock> SubItemBlocks = MarkdownPreview.Parse(SubItemSample);

    private async Task OnSourceChangedAsync(string value)
    {
        _source = value;
        _blocks = MarkdownPreview.Parse(_source);
        await MarkSavingAsync();
    }

    /// <summary>The read view reports which task was clicked; the source stays
    /// the truth, so the click is a text rewrite. MarkdownPreview.ToggleTask
    /// does the counting, because only the code that assigned the index knows
    /// which lines it skipped.</summary>
    private void ToggleTask(int taskIndex)
    {
        _source = MarkdownPreview.ToggleTask(_source, taskIndex);
        _blocks = MarkdownPreview.Parse(_source);
        MarkSaved();
    }

    /// <summary>A toggle is a discrete change, not a stream of keystrokes: there
    /// is nothing to wait for, so it lands as Saved immediately and cancels any
    /// typing debounce still in flight.</summary>
    private void MarkSaved()
    {
        _saveDelay?.Cancel();
        _saveState = SaveState.Saved;
    }

    /// <summary>Stands in for the real auto-save: Saving while the keystrokes are
    /// still arriving, Saved once they stop.</summary>
    private async Task MarkSavingAsync()
    {
        _saveDelay?.Cancel();
        _saveDelay?.Dispose();
        _saveDelay = new CancellationTokenSource();
        var token = _saveDelay.Token;

        _saveState = SaveState.Saving;
        StateHasChanged();

        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(600), token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        _saveState = SaveState.Saved;
        StateHasChanged();
    }

    public void Dispose()
    {
        _saveDelay?.Cancel();
        _saveDelay?.Dispose();
    }

    private const string EditCode = """
        <TextArea Value="@_source" ValueChanged="OnSourceChangedAsync" AriaLabel="Markdown source" Rows="18" />
        <SaveIndicator State="_saveState" />

        <MarkdownView Blocks="_blocks" OnTaskItemToggled="ToggleTask" />

        @code {
            private void ToggleTask(int taskIndex)
            {
                // Never count the checkboxes yourself: the index came from the
                // parser, and only the parser knows which lines it skipped.
                _source = MarkdownPreview.ToggleTask(_source, taskIndex);
                _blocks = MarkdownPreview.Parse(_source);
                MarkSaved();   // discrete change — no debounce
            }
        }
        """;

    private const string ReadOnlyCode = """
        @* No OnTaskItemToggled: the checkboxes render as state, not buttons. *@
        <MarkdownView Blocks="@MarkdownPreview.Parse(body)" />
        """;

    private const string MixedCode = """
        - [x] A task
        - A plain bullet in the same list
        - [ ] Another task
        """;
}
