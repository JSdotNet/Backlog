@page "/integrations/ai"

<PageTitle>AI in the document — Backlog UI Storybook</PageTitle>

<StoryPage Title="AI in the document"
           Summary="Rewriting a passage and resolving a comment, attached to the comment model that already exists: the records, the anchors and the callbacks. Every AI affordance here is this product's own and carries no vendor mark; the acts that hand a section out to a Claude or Copilot session are on Actions. What attribution owes a reader is the rule linked above."
           Guidelines="@Rules">

    <Story Name="The AI in this document is this product's own"
           Description="Ask AI, Resolve comments with AI and Rewrite part with AI all run inside the application, so none of the three carries a `Provider` and everything they write is attributed to AI and nothing further.

What that rules out — and why — is the attribution rule linked above."
           Code="@OwnAiCode">
        <div class="sb-stack" data-testid="ai-boundary">
            <div class="sb-columns">
                <div class="sb-stack">
                    <p class="sb-label">Written here — no mark, and the article is named Suggested by AI</p>
                    <AiProposalCard Proposal="@IntegrationFixtures.RewriteProposal"
                                    TestId="ai-boundary-in-app"
                                    AttributionTestId="ai-boundary-in-app-attribution" />
                </div>
                <div class="sb-stack">
                    <p class="sb-label">Come back from a forwarded session — marked, named, with its model and session</p>
                    <AiProposalCard Proposal="@IntegrationFixtures.ForwardedProposal"
                                    TestId="ai-boundary-forwarded"
                                    AttributionTestId="ai-boundary-forwarded-attribution" />
                </div>
            </div>
            <div class="sb-stack">
                <p class="sb-label">The three acts that produce the left-hand card. Not one of them draws an svg.</p>
                <IntegrationActionBar Actions="@IntegrationFixtures.InAppAi"
                                      Density="IntegrationDensity.Toolbar"
                                      VisibleLimit="3"
                                      AriaLabel="AI"
                                      TestId="ai-boundary-bar"
                                      ActionTestIdPrefix="ai-boundary" />
                <p class="sb-state">
                    The marked pair that belongs beside them — Send to Claude in Desktop and Send to Copilot in
                    Desktop — is on Actions, drawn against these three for exactly this comparison.
                </p>
            </div>
        </div>
    </Story>

    <Story Name="A rewrite is anchored to a block, because a comment is"
           Description="`MarkdownProposal` anchors by block index, the same way `MarkdownComment` does: a character range survives nothing, because inserting a word above it moves every offset below.

The visible consequence is that “rewrite part with AI” means rewrite this paragraph. Nothing new was built to hold it — `MarkdownView` already wraps every block in a row with a `data-block` index whenever it is annotated."
           Code="@AnchorCode">
        <div class="sb-stack" data-testid="ai-anchor">
            <MarkdownView Blocks="@IntegrationFixtures.DocumentBlocks"
                          Comments="@_comments"
                          Proposals="@_proposals"
                          OnAddComment="AddComment"
                          OnResolveComment="ResolveComment"
                          OnRewriteBlock="Rewrite"
                          OnAcceptProposal="Accept"
                          OnRejectProposal="Reject" />
            <p class="sb-state" data-testid="ai-anchor-echo">@_echo</p>
            <AppButton Variant="ButtonVariant.Ghost"
                       Size="ButtonSize.Small"
                       TestId="ai-anchor-reset"
                       OnClick="ResetDocument">Put the document back</AppButton>
        </div>
    </Story>

    <Story Name="Never applied in place"
           Description="`Original` and `Body` render as Now and Suggested, and rejecting leaves the document byte-identical. `MarkdownView` does not apply an accepted text either: it raises `OnAcceptProposal`, and the host re-parses and hands back new blocks — the same discipline `OnEditComment` keeps.

Accept is `Primary` and Reject is `Ghost`."
           Code="@ReviewCode">
        <div class="sb-stack" data-testid="ai-review">
            <AiProposalCard Proposal="@_standalone"
                            OnAccept="RecordAccept"
                            OnReject="RecordReject"
                            TestId="ai-review-card"
                            AttributionTestId="ai-review-attribution"
                            OriginalTestId="ai-review-original"
                            BodyTestId="ai-review-body"
                            AcceptTestId="ai-review-accept"
                            RejectTestId="ai-review-reject" />
            <p class="sb-state" data-testid="ai-review-echo">@_reviewEcho</p>
            <AppButton Variant="ButtonVariant.Ghost"
                       Size="ButtonSize.Small"
                       TestId="ai-review-reset"
                       OnClick="ResetStandalone">Ask again</AppButton>
        </div>
    </Story>

    <Story Name="Accepting does not erase who wrote it"
           Description="An accepted proposal keeps its attribution — who wrote it, when, and where it came from — and moves to `Accepted` rather than disappearing. What goes is the pair of buttons, because there is nothing left to decide.

The host's side is one mapping and needs no knowledge of this library: provider to `ai_tool`, and the rest of the record it already stores."
           Code="@StatesCode">
        <div class="sb-stack" data-testid="ai-states">
            @foreach (var state in ProposalStates)
            {
                <div class="sb-stack">
                    <p class="sb-label">@state</p>
                    <AiProposalCard Proposal="@(IntegrationFixtures.RewriteProposal with { State = state })"
                                    TestId="@($"ai-state-{state.ToString().ToLowerInvariant()}")"
                                    AttributionTestId="@($"ai-state-{state.ToString().ToLowerInvariant()}-attribution")" />
                </div>
            }
        </div>
    </Story>

    <Story Name="Resolving a comment with AI is two acts, not one"
           Description="`OnResolveCommentWithAi` starts the work and `OnAcceptProposal` accepts the text; the existing Resolve button keeps its exact meaning, and a host that wants both calls resolve second. One act, one callback.

A resolution proposal renders inside the comment's own list item, under the comment body, rather than against the block."
           Code="@ResolveCode">
        <div class="sb-stack" data-testid="ai-resolve">
            <MarkdownView Blocks="@IntegrationFixtures.DocumentBlocks"
                          Comments="@_threadComments"
                          Proposals="@_threadProposals"
                          OnResolveComment="ResolveThreadComment"
                          OnResolveCommentWithAi="ResolveThreadWithAi"
                          OnAcceptProposal="AcceptThread"
                          OnRejectProposal="RejectThread" />
            <p class="sb-state" data-testid="ai-resolve-echo">@_resolveEcho</p>
        </div>
    </Story>

    <Story Name="Attribution is visible and it is announced"
           Description="The card carries both carriers: a tinted edge and the provider mark for the eye, and an accessible name reading “Suggested by AI” on the containing article for everything else.

The tint is a mix of the one brand hue against the card surface rather than a new colour. Why both carriers are required is the rule linked above."
           Code="@AttributionCode">
        <div class="sb-columns" data-testid="ai-attribution">
            <div class="sb-stack">
                <p class="sb-label">A proposal — article, aria-label, tint, time. No mark: nothing left the app.</p>
                <AiProposalCard Proposal="@IntegrationFixtures.RewriteProposal"
                                OnAccept="RecordAccept"
                                OnReject="RecordReject"
                                TestId="ai-attribution-card"
                                AttributionTestId="ai-attribution-line" />
            </div>
            <div class="sb-stack">
                <p class="sb-label">An ordinary remark on the same block</p>
                <MarkdownView Blocks="@OneBlock"
                              Comments="@HumanComment"
                              OnResolveComment="Noop" />
            </div>
        </div>
    </Story>

    <Story Name="Offline, the affordance says so and the document still works"
           Description="An AI act offline takes `IntegrationReadiness.Offline()` like any other unavailable act: the button stays, disabled, with a calm sentence and no remedy.

Below the bar is the same document with commenting and resolving wired and working, because editing, commenting, resolving and reading are untouched by it. The per-block affordances carry no readiness of their own — `MarkdownView`'s AI parameters are callbacks, and a host that cannot serve one does not pass it."
           Code="@OfflineCode">
        <div class="sb-stack" data-testid="ai-offline">
            <IntegrationActionBar Actions="@IntegrationFixtures.InAppAi"
                                  Density="IntegrationDensity.Inline"
                                  Readiness="@IntegrationFixtures.Offline"
                                  AriaLabel="AI"
                                  VisibleLimit="3"
                                  TestId="ai-offline-bar"
                                  ActionTestIdPrefix="ai-offline" />
            <MarkdownView Blocks="@IntegrationFixtures.DocumentBlocks"
                          Comments="@_offlineComments"
                          OnAddComment="AddOfflineComment"
                          OnResolveComment="ResolveOfflineComment" />
            <p class="sb-state" data-testid="ai-offline-echo">@_offlineEcho</p>
        </div>
    </Story>

    <Story Name="A proposal whose block went away"
           Description="A proposal pointing past the end of the document joins the orphan region comments already use, and the orphan computation covers both rather than gaining a second one beside it.

Below, one comment and one proposal both point at a block index the document does not have."
           Code="@OrphanCode">
        <div class="sb-stack" data-testid="ai-orphan">
            <MarkdownView Blocks="@IntegrationFixtures.DocumentBlocks"
                          Comments="@OrphanedComments"
                          Proposals="@OrphanedProposals"
                          OnResolveComment="Noop"
                          OnAcceptProposal="RecordAccept"
                          OnRejectProposal="RecordReject" />
        </div>
    </Story>

</StoryPage>

@code {
    private static readonly DesignGuideline[] Rules =
    [
        new("design-principles.md#ai-first-surfaces", "Where AI may appear in a document, and how it is attributed."),
        new("content-editing.md#ai-proposals-in-a-document", "Why nothing is applied in place, and what accepting keeps."),
        new("interaction-guidelines.md#feedback-and-toasts", "What a proposal reports while it is being made."),
        new("accessibility.md#screen-reader--announcements", "How attribution is announced rather than only shown.")
    ];

    private static readonly IReadOnlyList<AiProposalState> ProposalStates =
    [
        AiProposalState.Proposed,
        AiProposalState.Accepted,
        AiProposalState.Rejected
    ];

    private static readonly IReadOnlyList<MdBlock> OneBlock =
        [.. IntegrationFixtures.DocumentBlocks.Skip(2).Take(1)];

    private static readonly IReadOnlyList<MarkdownComment> HumanComment =
    [
        new("comment-human", 0, "Agreed — this is the paragraph the rewrite is about.", "Jos", "16 Aug, 09:38")
    ];

    /// <summary>A comment and a proposal that both point past the end of the
    /// document. One region holds both, so a reader learns once that anything
    /// down there has lost its anchor.</summary>
    private static readonly IReadOnlyList<MarkdownComment> OrphanedComments =
    [
        new("comment-orphan", 41, "Does this still hold after the split?", "Jos", "16 Aug, 10:01")
    ];

    private static readonly IReadOnlyList<AiProposal> OrphanedProposals =
    [
        IntegrationFixtures.OrphanedProposal
    ];

    // --- Live state --------------------------------------------------------

    private IReadOnlyList<MarkdownComment> _comments = IntegrationFixtures.Comments;

    private IReadOnlyList<AiProposal> _proposals = [IntegrationFixtures.RewriteProposal];

    private IReadOnlyList<MarkdownComment> _threadComments = IntegrationFixtures.Comments;

    private IReadOnlyList<AiProposal> _threadProposals = [];

    private IReadOnlyList<MarkdownComment> _offlineComments = IntegrationFixtures.Comments;

    private AiProposal _standalone = IntegrationFixtures.RewriteProposal;

    private int _next;

    private string _echo = "Nothing pressed yet.";

    private string _reviewEcho = "Nothing answered yet.";

    private string _resolveEcho = "Nothing pressed yet.";

    private string _offlineEcho = "The document is untouched by any of it.";

    /// <summary>What a host does with OnRewriteBlock: run the tool, and hand back
    /// a proposal anchored to the block it was asked about. This one skips the
    /// tool and keeps the anchor, which is the part the component cares about.
    /// <para>No provider, because this is the in-app rewrite: the default on
    /// <c>AiProposal</c> is <c>None</c>, so a host that says nothing gets an
    /// unmarked card rather than a branded one it never asked for.</para></summary>
    private void Rewrite(int blockIndex)
    {
        var proposal = new AiProposal(
            $"proposal-live-{_next++}",
            AiProposalKind.Rewrite,
            "A tighter version of this block, written by a model and applied by nobody yet.",
            Timestamp: "just now",
            Original: "The block as it stands.",
            BlockIndex: blockIndex);

        _proposals = [.. _proposals, proposal];
        _echo = $"OnRewriteBlock raised with block index {blockIndex}. The host produced {proposal.Id}.";
    }

    private void AddComment(int blockIndex)
    {
        _comments = [.. _comments, new MarkdownComment($"comment-live-{_next++}", blockIndex, "A new remark.", "You", "just now")];
        _echo = $"OnAddComment raised with block index {blockIndex}.";
    }

    private void ResolveComment(string id)
    {
        _comments = [.. _comments.Select(comment => comment.Id == id ? comment with { Resolved = true } : comment)];
        _echo = $"OnResolveComment raised for {id}.";
    }

    /// <summary>Accept is where the host applies the text. This page does not
    /// re-parse the document — the point of the story is that the component did
    /// not either, and that the decision arrived here as a callback.</summary>
    private void Accept(AiProposal proposal)
    {
        _proposals = [.. _proposals.Select(open => open.Id == proposal.Id ? open with { State = AiProposalState.Accepted } : open)];
        _echo = $"OnAcceptProposal raised for {proposal.Id}. The host would re-parse and hand back new blocks.";
    }

    private void Reject(AiProposal proposal)
    {
        _proposals = [.. _proposals.Select(open => open.Id == proposal.Id ? open with { State = AiProposalState.Rejected } : open)];
        _echo = $"OnRejectProposal raised for {proposal.Id}. The document is byte-identical.";
    }

    private void ResetDocument()
    {
        _comments = IntegrationFixtures.Comments;
        _proposals = [IntegrationFixtures.RewriteProposal];
        _echo = "Back to where it started.";
    }

    private void RecordAccept(AiProposal proposal)
    {
        _standalone = _standalone.Id == proposal.Id ? _standalone with { State = AiProposalState.Accepted } : _standalone;
        _reviewEcho = $"OnAccept raised with Id = {proposal.Id}, Kind = {proposal.Kind}, "
            + $"Provider = {proposal.Provider}, Model = {proposal.Model ?? "none"}, "
            + $"SessionId = {proposal.SessionId ?? "none"}.";
    }

    private void RecordReject(AiProposal proposal)
    {
        _standalone = _standalone.Id == proposal.Id ? _standalone with { State = AiProposalState.Rejected } : _standalone;
        _reviewEcho = $"OnReject raised with Id = {proposal.Id}. Nothing was written; the document is byte-identical.";
    }

    private void ResetStandalone()
    {
        _standalone = IntegrationFixtures.RewriteProposal;
        _reviewEcho = "Nothing answered yet.";
    }

    /// <summary>The AI act on a comment. It produces a proposal and nothing else —
    /// resolving is still the other button, and still the host's to call.</summary>
    private void ResolveThreadWithAi(string commentId)
    {
        var proposal = IntegrationFixtures.CommentProposal with
        {
            Id = $"proposal-thread-{_next++}",
            CommentId = commentId,
            Timestamp = "just now",
            State = AiProposalState.Proposed
        };

        _threadProposals = [.. _threadProposals, proposal];
        _resolveEcho = $"OnResolveCommentWithAi raised for {commentId}. The comment is still open.";
    }

    private void ResolveThreadComment(string id)
    {
        _threadComments = [.. _threadComments.Select(comment => comment.Id == id ? comment with { Resolved = true } : comment)];
        _resolveEcho = $"OnResolveComment raised for {id}. That is the second act, and the host chose to make it.";
    }

    private void AcceptThread(AiProposal proposal)
    {
        _threadProposals = [.. _threadProposals.Select(open => open.Id == proposal.Id ? open with { State = AiProposalState.Accepted } : open)];
        _resolveEcho = $"OnAcceptProposal raised for {proposal.Id}. The comment it belongs to is still open — accepting text is not resolving a remark.";
    }

    private void RejectThread(AiProposal proposal) =>
        _threadProposals = [.. _threadProposals.Select(open => open.Id == proposal.Id ? open with { State = AiProposalState.Rejected } : open)];

    private void AddOfflineComment(int blockIndex)
    {
        _offlineComments = [.. _offlineComments, new MarkdownComment($"comment-offline-{_next++}", blockIndex, "Written with no network.", "You", "just now")];
        _offlineEcho = $"Commented on block {blockIndex} while every AI act was unavailable.";
    }

    private void ResolveOfflineComment(string id)
    {
        _offlineComments = [.. _offlineComments.Select(comment => comment.Id == id ? comment with { Resolved = true } : comment)];
        _offlineEcho = $"Resolved {id} while every AI act was unavailable.";
    }

    private void Noop()
    {
        // A delegate with nothing behind it, because the affordance it turns on is
        // what the story is about. Two of these stories are about what is drawn
        // rather than about what a press does.
    }

    // --- Code samples ------------------------------------------------------

    private const string AnchorCode = """
        @* Five parameters and no more. Annotated widens to include proposals, so
           a view that asks for none of this renders exactly what it renders
           today. *@
        <MarkdownView Blocks="@blocks"
                      Comments="@comments"
                      Proposals="@proposals"
                      OnRewriteBlock="Rewrite"
                      OnResolveCommentWithAi="ResolveWithAi"
                      OnAcceptProposal="Accept"
                      OnRejectProposal="Reject" />
        """;

    private const string OwnAiCode = """
        @* Written here. Provider defaults to None, so the card draws no mark and
           names the writer "AI". A host has to say a vendor out loud to get one. *@
        new AiProposal("proposal-1", AiProposalKind.Rewrite, suggested,
            Timestamp: "16 Aug, 09:41", Original: current, BlockIndex: 2)

        @* Come back from a session this product forwarded the section to. That
           one left, so it carries the tool that wrote it, its model, and the
           session the References page tracks. *@
        new AiProposal("proposal-2", AiProposalKind.Rewrite, suggested,
            IntegrationProvider.Claude, "claude-opus-5", "session-7e12",
            "16 Aug, 10:14", Original: current, BlockIndex: 2)
        """;

    private const string ReviewCode = """
        @* Original and Body are Now and Suggested. Nothing is applied here:
           accepting raises the record and the host re-parses. No provider named,
           because this one was written in the app. *@
        new AiProposal("proposal-1", AiProposalKind.Rewrite, suggested,
            Timestamp: "16 Aug, 09:41", Original: current, BlockIndex: 2)
        """;

    private const string StatesCode = """
        @* Answered, and still attributed. The buttons go; the provenance does
           not. *@
        proposal with { State = AiProposalState.Accepted }
        """;

    private const string ResolveCode = """
        @* Two acts. Starting the work and accepting the text are separate from
           resolving the remark, and the host calls the third one only if it
           wants to. *@
        private void ResolveWithAi(string commentId) => Ask(commentId);      @* act one *@
        private void Accept(AiProposal proposal)     => Apply(proposal);     @* act two *@
        private void Resolve(string commentId)       => Close(commentId);    @* the host's own *@
        """;

    private const string AttributionCode = """
        @* Both halves, because neither reaches everybody on its own — and the
           name is the product's own AI, not a vendor's. *@
        <article class="ai-proposal ai-proposal--none" aria-label="Suggested by AI">
        """;

    private const string OfflineCode = """
        @* The act says why; the document says nothing about it. *@
        <IntegrationActionBar Actions="@aiActs" Readiness="@IntegrationReadiness.Offline()" />

        @* No AI callbacks handed in, so no per-block AI buttons — absent rather
           than present and lying. Comments and resolution are untouched. *@
        <MarkdownView Blocks="@blocks" Comments="@comments" OnAddComment="Add" OnResolveComment="Resolve" />
        """;

    private const string OrphanCode = """
        @* One orphan region for both. A stray is better than a loss, and a second
           region for proposals would have had to explain itself all over again. *@
        proposal with { BlockIndex = 42 }   @* the document has four blocks *@
        """;
}
