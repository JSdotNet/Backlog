@page "/settings-menu"

<PageTitle>Settings menu — Backlog UI Storybook</PageTitle>

<StoryPage Title="Settings menu"
           Summary="SettingsMenuGroup: one group of the settings menu — a small uppercase label and the pages under it, each a link to the page's own address, the page on screen marked current."
           Guidelines="@Rules">

    <Story Name="Three groups"
           Description="The settings menu is three of these in a nav: Workspace, AI, Product areas. Every item is a link to a page's own address, so choosing one navigates and Back returns to the page before - here the address is this page's, with the page id in its query, so choosing one moves the current mark without leaving the story.

The current page is marked twice: aria-current=&quot;page&quot; for a screen reader, and the raised surface in primary text, semibold, for everyone else - never by colour alone."
           Code="@GroupsCode">
        <nav class="sb-menu" aria-label="Settings pages" data-testid="settings-menu-groups">
            @foreach (var group in Groups)
            {
                <SettingsMenuGroup Label="@group.Label"
                                   Items="@([.. group.Pages.Select(page => new SettingsMenuItem(page.Id, page.Label, $"settings-menu?page={page.Id}", page.Id == CurrentId))])" />
            }
        </nav>
        <p class="sb-state" data-testid="settings-menu-state">Current: @CurrentId</p>
    </Story>
</StoryPage>

@code {
    [SupplyParameterFromQuery(Name = "page")]
    public string? Page { get; set; }

    private string CurrentId => string.IsNullOrWhiteSpace(Page) ? "features" : Page;

    private static readonly (string Label, (string Id, string Label)[] Pages)[] Groups =
    [
        ("Workspace", [("features", "Features"), ("storage", "Storage & backup"), ("repositories", "Repositories"), ("accounts", "GitHub accounts")]),
        ("AI", [("ai", "AI providers"), ("claude-code", "Claude Code"), ("model-prices", "Model prices")]),
        ("Product areas", [("dashboard", "Dashboard"), ("working-week", "Working week"), ("inbox", "Inbox"), ("connectors", "Connectors"), ("devices", "Devices")])
    ];

    private static readonly DesignGuideline[] Rules =
    [
        new("settings-pages.md#menu-groups", "Which of the three groups a page goes in, and why every item is a link."),
        new("settings-pages.md#badges-and-the-off-state", "What a menu badge may say, and how a page whose feature is off stays in the menu."),
        new("settings-pages.md#phone-width", "Why the menu and the page take turns below 50.25rem, measured on the frame rather than the window."),
        new("accessibility.md#keyboard-navigation", "Why the menu is links in the tab order rather than a widget of its own."),
        new("accessibility.md#target-sizes-and-text", "How large a menu item is under a pointer, and why the current page is not told apart by colour alone.")
    ];

    private const string GroupsCode = """
        <nav aria-label="Settings pages">
            <SettingsMenuGroup Label="Workspace"
                               Items="@([new("features", "Features", "settings/features", Current: true),
                                         new("storage", "Storage & backup", "settings/storage")])" />
            <SettingsMenuGroup Label="AI" Items="@aiPages" />
        </nav>
        """;
}
