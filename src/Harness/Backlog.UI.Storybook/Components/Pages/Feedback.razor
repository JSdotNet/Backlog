@page "/feedback"
@implements IDisposable
@inject IToastChannel Toasts

<PageTitle>Feedback — Backlog UI Storybook</PageTitle>

<StoryPage Title="Feedback"
           Summary="What the UI says when something is loading, missing, saving, or worth announcing."
           Guidelines="@Rules">

    <Story Name="Alert"
           Description="Renders nothing at all when there is no message, so a host can bind it straight to a nullable error without guarding."
           Code="@AlertCode">
        <div class="sb-stack">
            <Alert Message="The folder could not be opened." TestId="alert-error" />
            <Alert Message="Sync finished with warnings." Role="status" TestId="alert-status" />
            <Alert Message="@_alertMessage" TestId="alert-toggled" />
            <div class="sb-row">
                <AppButton Variant="ButtonVariant.Secondary" OnClick="ToggleAlert">
                    @(_alertMessage is null ? "Raise an alert" : "Clear the alert")
                </AppButton>
            </div>
        </div>
    </Story>

    <Story Name="EmptyState"
           Description="With an action when there is something to do about it, without one when there is not."
           Code="@EmptyCode">
        <div class="sb-stack">
            <EmptyState Title="No entries yet"
                        Description="Everything you capture will show up here."
                        TestId="empty-with-action">
                <Icon><span aria-hidden="true">📝</span></Icon>
                <Action>
                    <AppButton Variant="ButtonVariant.Primary" OnClick="() => _created++">New entry</AppButton>
                </Action>
            </EmptyState>
            <p class="sb-state" data-testid="empty-created">Created: @_created</p>

            <EmptyState Title="Nothing matches this filter"
                        Description="Clear the search to see everything again."
                        TestId="empty-no-action" />
        </div>
    </Story>

    <Story Name="EmptyState wearing a host's own classes"
           Description="Each class is a parameter with the default as its value, so a host can replace it or pass null to get the bare element. A null ActionCssClass drops the action wrapper, and DescriptionContent covers the case where the description is more than text."
           Code="@EmptyClassCode">
        <div class="sb-stack">
            <EmptyState BaseClass="knowledge-empty"
                        Title="No arc42 folder here yet."
                        TitleCssClass="knowledge-empty__title"
                        DescriptionCssClass="@(null)"
                        TestId="empty-host-classes"
                        role="status">
                <DescriptionContent>
                    Point storage at a repository root that contains <code>.arc42</code> to browse architecture chapters.
                </DescriptionContent>
            </EmptyState>

            <EmptyState BaseClass="knowledge-empty"
                        Title="No instruction source is configured."
                        TitleCssClass="@(null)"
                        ActionCssClass="@(null)"
                        TestId="empty-bare-action"
                        role="status">
                <Action>
                    <a href="/">Open storage settings</a>
                </Action>
            </EmptyState>
        </div>
    </Story>

    <Story Name="Spinner"
           Description="Three sizes; the label is what a screen reader hears."
           Code="@SpinnerCode">
        <div class="sb-row">
            <Spinner Size="SpinnerSize.Small" Label="Loading small" />
            <Spinner Size="SpinnerSize.Medium" Label="Loading medium" />
            <Spinner Size="SpinnerSize.Large" Label="Loading large" />
        </div>
    </Story>

    <Story Name="Skeleton"
           Description="Three shapes, and the way they are meant to be used: laid out on the grid of the rows they stand in for. A spinner says work is happening; a skeleton says what is about to arrive and where, which is why lists, cards and tables get one instead. The bars are aria-hidden — the surface waiting for them says once, in a live region, what is being waited for. Under reduced motion the pulse stops altogether rather than degrading to a slower one."
           Code="@SkeletonCode">
        <div class="sb-stack">
            <div class="sb-row">
                <span class="sb-label">Text</span>
                <Skeleton Width="12rem" />
            </div>
            <div class="sb-row">
                <span class="sb-label">Heading</span>
                <Skeleton Shape="SkeletonShape.Heading" Width="9rem" />
            </div>
            <div class="sb-row">
                <span class="sb-label">Block</span>
                <Skeleton Shape="SkeletonShape.Block" Width="6rem" />
            </div>

            @* The point of the component, rather than a third size of bar: three
               rows of a table that has not answered yet, on the grid its real
               rows will use, with a ragged right edge so it reads as names. *@
            <div style="display: grid; gap: 0.5rem; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--border-radius-sm)">
                @foreach (var row in SkeletonRows)
                {
                    <div style="display: grid; grid-template-columns: 1.4fr 0.6fr 0.6fr 5rem; gap: 0.75rem; align-items: center">
                        <div style="display: grid; gap: 0.25rem">
                            <Skeleton Width="@row" />
                            <Skeleton Width="50%" />
                        </div>
                        <Skeleton Width="3rem" />
                        <Skeleton Width="3rem" />
                        <Skeleton Shape="SkeletonShape.Block" />
                    </div>
                }
            </div>
        </div>
    </Story>

    <Story Name="SaveIndicator"
           Description="All four states, plus a run through the sequence the product actually produces: Idle, Saving, Saved."
           Code="@SaveCode">
        <div class="sb-stack">
            @foreach (var state in SaveStates)
            {
                <div class="sb-row">
                    <span class="sb-label">@state</span>
                    <SaveIndicator State="state" />
                </div>
            }
            <div class="sb-row">
                <AppButton Variant="ButtonVariant.Primary" OnClick="RunSaveAsync">Run a save</AppButton>
                <SaveIndicator State="_saveState" TestId="save-indicator-live" />
            </div>
        </div>
    </Story>

    <Story Name="Toast and ToastHost"
           Description="One live region for the whole page; toasts come and go inside it. Each one dismisses itself after its duration, and can be dismissed sooner."
           Code="@ToastCode">
        <div class="sb-row">
            @foreach (var severity in Severities)
            {
                <AppButton Variant="ButtonVariant.Secondary" OnClick="() => Raise(severity)">
                    @severity.ToString()
                </AppButton>
            }
        </div>

        <ToastHost TestId="toast-host">
            @foreach (var toast in _toasts)
            {
                <Toast @key="toast.Id"
                       Title="@toast.Severity.ToString()"
                       Message="@toast.Message"
                       Severity="toast.Severity"
                       DurationMilliseconds="6000"
                       TestId="@($"toast-{toast.Severity}".ToLowerInvariant())"
                       OnDismissed="() => Dismiss(toast.Id)" />
            }
        </ToastHost>
    </Story>

    <Story Name="ToastTray"
           Description="The same two components, wired to the channel the application publishes on rather than to a list the page holds. A screen calls Publish and never learns where the message is drawn; this tray is the only thing that draws one.

                        Raise four in a row to see the rule the channel enforces: .design/interaction-guidelines.md#feedback-and-toasts allows three at once and queues the rest, so the fourth appears only once one of the three has gone — by its own timer or by its dismiss button."
           Code="@TrayCode">
        <div class="sb-row">
            @foreach (var severity in Severities)
            {
                <AppButton Variant="ButtonVariant.Secondary" OnClick="() => Publish(severity)">
                    Publish @severity.ToString()
                </AppButton>
            }
        </div>

        <p class="sb-state" data-testid="tray-visible">Showing: @Toasts.Visible.Count of @ToastChannel.MaxVisible</p>

        <ToastTray TestId="toast-tray" />
    </Story>

</StoryPage>

@code {
    private static readonly DesignGuideline[] Rules =
    [
        new("interaction-guidelines.md#feedback-and-toasts", "When something is a toast, an alert, or neither."),
        new("interaction-guidelines.md#save-state-indicator-vocabulary", "The words the save state is allowed to say."),
        new("interaction-guidelines.md#empty-loading-and-error-states", "What an empty, loading or failed surface shows."),
        new("accessibility.md#reduced-motion", "What the pulse and the spin do when motion is unwelcome."),
        new("accessibility.md#save-state-announcements", "What a save announces, and how often."),
        new("color-scheme.md#semantic-soft-surface-tokens", "The tone each severity is drawn in.")
    ];

    /// <summary>Name-bar widths for the placeholder table. Deliberately uneven:
    /// bars of one length read as a loading graphic, a ragged edge reads as
    /// content.</summary>
    private static readonly string[] SkeletonRows = ["62%", "78%", "45%"];

    private static readonly SaveState[] SaveStates =
        [SaveState.Idle, SaveState.Saving, SaveState.Saved, SaveState.Failed];

    private static readonly ToastSeverity[] Severities =
        [ToastSeverity.Info, ToastSeverity.Success, ToastSeverity.Warning, ToastSeverity.Error];

    private sealed record DemoToast(int Id, ToastSeverity Severity, string Message);

    private readonly List<DemoToast> _toasts = [];
    private int _nextToastId;
    private int _created;
    private string? _alertMessage;
    private SaveState _saveState = SaveState.Idle;
    private CancellationTokenSource? _saveRun;

    private void ToggleAlert() =>
        _alertMessage = _alertMessage is null ? "Something went wrong, and this line says what." : null;

    private void Raise(ToastSeverity severity)
    {
        _toasts.Add(new DemoToast(_nextToastId++, severity, $"A {severity} notification, raised from the storybook."));
    }

    private void Dismiss(int id) => _toasts.RemoveAll(toast => toast.Id == id);

    protected override void OnInitialized() => Toasts.Changed += OnToastsChanged;

    // The tray redraws itself; this is only for the count line beside it, which is
    // the page's own text rather than the component's.
    private void OnToastsChanged() => _ = InvokeAsync(StateHasChanged);

    private void Publish(ToastSeverity severity)
    {
        var message = $"A {severity} notification, published from the storybook.";

        Toasts.Publish(severity switch
        {
            ToastSeverity.Error => ToastMessage.Error(message),
            ToastSeverity.Warning => ToastMessage.Warning(message),
            _ => ToastMessage.Info(message)
        });
    }

    private async Task RunSaveAsync()
    {
        _saveRun?.Cancel();
        _saveRun?.Dispose();
        _saveRun = new CancellationTokenSource();
        var token = _saveRun.Token;

        _saveState = SaveState.Idle;
        StateHasChanged();

        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(300), token);
            _saveState = SaveState.Saving;
            StateHasChanged();

            await Task.Delay(TimeSpan.FromMilliseconds(1200), token);
            _saveState = SaveState.Saved;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
        }
    }

    public void Dispose()
    {
        Toasts.Changed -= OnToastsChanged;
        _saveRun?.Cancel();
        _saveRun?.Dispose();
    }

    private const string AlertCode = """
        <Alert Message="@_error" />
        """;

    private const string EmptyCode = """
        <EmptyState Title="No entries yet" Description="Everything you capture will show up here.">
            <Action><AppButton Variant="ButtonVariant.Primary">New entry</AppButton></Action>
        </EmptyState>
        """;

    private const string EmptyClassCode = """
        <EmptyState BaseClass="knowledge-empty"
                    Title="No arc42 folder here yet."
                    TitleCssClass="knowledge-empty__title"
                    DescriptionCssClass="@(null)"
                    role="status">
            <DescriptionContent>
                Point storage at a repository root that contains <code>.arc42</code>.
            </DescriptionContent>
        </EmptyState>
        """;

    private const string SpinnerCode = """
        <Spinner Size="SpinnerSize.Small" Label="Loading" />
        """;

    private const string SkeletonCode = """
        @* The tools pane's placeholder: the table the rows are coming into, with
           bars in its cells rather than a second layout that looks like it. *@
        <div class="tools-panel__skeleton" aria-hidden="true">
            <DataTable TItem="string" Columns="Columns" Items="Names" CssClass="tools-inventory">
                <Row Context="name">
                    <td class="tools-inventory__tool">
                        <Skeleton Width="@name" />
                        <Skeleton Width="55%" />
                    </td>
                    <td><Skeleton Width="3rem" /></td>
                    <td><Skeleton Width="3rem" /></td>
                    <td><Skeleton Shape="SkeletonShape.Block" Width="5rem" /></td>
                </Row>
            </DataTable>
        </div>
        """;

    private const string SaveCode = """
        <SaveIndicator State="_saveState" />
        """;

    private const string ToastCode = """
        <ToastHost>
            <Toast Message="@toast.Message" Severity="toast.Severity" OnDismissed="() => Dismiss(toast.Id)" />
        </ToastHost>
        """;

    private const string TrayCode = """
        @inject IToastChannel Toasts

        <ToastTray />

        @code {
            private void Report(string message) => Toasts.Publish(ToastMessage.Error(message));
        }
        """;
}
