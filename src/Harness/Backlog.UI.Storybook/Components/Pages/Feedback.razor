@page "/feedback"
@implements IDisposable
@inject IToastChannel Toasts

<PageTitle>Feedback — Backlog UI Storybook</PageTitle>

<StoryPage Title="Feedback"
           Summary="What the UI says when something is loading, missing, saving, or worth announcing."
           Guidelines="@Rules">

    <Story Name="Alert"
           Description="Renders nothing at all when there is no message, so a host can bind it straight to a nullable error without guarding."
           Code="@AlertCode">
        <div class="sb-stack">
            <Alert Message="The folder could not be opened." TestId="alert-error" />
            <Alert Message="Sync finished with warnings." Role="status" TestId="alert-status" />
            <Alert Message="@_alertMessage" TestId="alert-toggled" />
            <div class="sb-row">
                <AppButton Variant="ButtonVariant.Secondary" OnClick="ToggleAlert">
                    @(_alertMessage is null ? "Raise an alert" : "Clear the alert")
                </AppButton>
            </div>
        </div>
    </Story>

    <Story Name="Alert beside the thing it is about"
           Description="Inline draws the alert as a span instead of a paragraph, for the message that belongs next to what produced it rather than under it — a refused value beside its own text, or a failed action beside the button that failed. A block element in a row of controls breaks the row, which is what makes this a parameter rather than a note telling hosts to write their own span. Where the message sits and how it is announced stay separate: Role still answers the second question on its own."
           Code="@AlertInlineCode">
        <div class="sb-stack">
            <div class="sb-row">
                <AppButton Variant="ButtonVariant.Secondary">Set state</AppButton>
                <Alert Message="Blocked is not reachable from Done." Role="status" TestId="alert-inline" Inline />
            </div>
            <p>
                Due <code>2026-13-01</code>
                <Alert Message="That is not a month." Role="status" TestId="alert-inline-in-text" Inline />
            </p>
        </div>
    </Story>

    <Story Name="Alert carrying something after the message"
           Description="ChildContent renders inside the same line as the message, after it. What it is for is the fact a message is about — the issue a report became, and a way to open it. Beside the component instead, as a second paragraph, that way back is either announced separately from the sentence that says it exists or not announced at all, because the element is the live region rather than the block around it.

                        It qualifies a message and does not replace one: an alert with content and no message still renders nothing at all, so a host can keep binding a nullable message straight to it. No space is written between the two — the gap is the host's, which is what keeps every call site made before this parameter rendering the text it always did."
           Code="@AlertContentCode">
        <div class="sb-stack">
            <Alert Message="Created" Role="status" TestId="alert-with-content">
                &nbsp;<a href="https://github.com/JSdotNet/Backlog/issues/101"
                         target="_blank"
                         rel="noopener"
                         aria-label="Open issue JSdotNet/Backlog#101 on GitHub">JSdotNet/Backlog#101</a>
            </Alert>
        </div>
    </Story>

    <Story Name="EmptyState"
           Description="With an action when there is something to do about it, without one when there is not."
           Code="@EmptyCode">
        <div class="sb-stack">
            <EmptyState Title="No entries yet"
                        Description="Everything you capture will show up here."
                        TestId="empty-with-action">
                <Icon><span aria-hidden="true">📝</span></Icon>
                <Action>
                    <AppButton Variant="ButtonVariant.Primary" OnClick="() => _created++">New entry</AppButton>
                </Action>
            </EmptyState>
            <p class="sb-state" data-testid="empty-created">Created: @_created</p>

            <EmptyState Title="Nothing matches this filter"
                        Description="Clear the search to see everything again."
                        TestId="empty-no-action" />
        </div>
    </Story>

    <Story Name="EmptyState wearing a host's own classes"
           Description="Each class is a parameter with the default as its value, so a host can replace it or pass null to get the bare element. A null ActionCssClass drops the action wrapper, and DescriptionContent covers the case where the description is more than text."
           Code="@EmptyClassCode">
        <div class="sb-stack">
            <EmptyState BaseClass="devbook-empty"
                        Title="No arc42 folder here yet."
                        TitleCssClass="devbook-empty__title"
                        DescriptionCssClass="@(null)"
                        TestId="empty-host-classes"
                        role="status">
                <DescriptionContent>
                    Point storage at a repository root that contains <code>.arc42</code> to browse architecture chapters.
                </DescriptionContent>
            </EmptyState>

            <EmptyState BaseClass="devbook-empty"
                        Title="No instruction source is configured."
                        TitleCssClass="@(null)"
                        ActionCssClass="@(null)"
                        TestId="empty-bare-action"
                        role="status">
                <Action>
                    <a href="/">Open storage settings</a>
                </Action>
            </EmptyState>
        </div>
    </Story>

    <Story Name="SetupSteps"
           Description="A numbered checklist that ticks itself off. The host derives each step's Done from its own state - a field filled, a check passed - and the list draws it; nothing in it is clickable, because the thing to do is in the field beside it. An optional step is drawn as such and never reads as unfinished. Toggle the sample's fields to watch the ticks follow them."
           Code="@SetupStepsCode">
        <div class="sb-stack">
            <SetupSteps AriaLabel="Setting up the account" TestId="setup-steps-sample" Steps="@SampleSteps" />
            <div class="sb-row">
                <AppButton Variant="ButtonVariant.None" OnClick="() => _keyPasted = !_keyPasted">@(_keyPasted ? "Forget the key" : "Paste a key")</AppButton>
                <AppButton Variant="ButtonVariant.None" OnClick="() => _actorNamed = !_actorNamed">@(_actorNamed ? "Clear the account" : "Name the account")</AppButton>
                <AppButton Variant="ButtonVariant.None" OnClick="() => _tested = !_tested" Disabled="@(!_keyPasted)">@(_tested ? "Reset the test" : "Test")</AppButton>
            </div>
        </div>
    </Story>

    <Story Name="FlowSteps"
           Description="A process someone else is running, drawn as a flow: one node per step in order, joined by connectors, wrapping into rows in a narrow column. Five tones — pending, active, done, blocked, skipped — each drawn on the node's edge and mark, with its own glyph, and said in words on the status line, so colour is never the only carrier. The current step carries aria-current and the whole flow is an ordered list. Notes under a step say who worked in it and on what — the Sessions pane puts a delivery run's owner session and each delegated agent there, with the model it ran on."
           Code="@FlowStepsCode">
        <FlowSteps AriaLabel="Stages of the run" TestId="flow-steps-sample" Steps="@SampleFlow" />
    </Story>

    <Story Name="Spinner"
           Description="Three sizes; the label is what a screen reader hears."
           Code="@SpinnerCode">
        <div class="sb-row">
            <Spinner Size="SpinnerSize.Small" Label="Loading small" />
            <Spinner Size="SpinnerSize.Medium" Label="Loading medium" />
            <Spinner Size="SpinnerSize.Large" Label="Loading large" />
        </div>
    </Story>

    <Story Name="Skeleton"
           Description="Three shapes, meant to be laid out on the grid of the rows they stand in for: a spinner says work is happening; a skeleton says what is about to arrive and where, which is why lists, cards and tables get one instead. The bars are aria-hidden — the surface waiting for them says once, in a live region, what is being waited for. Under reduced motion the pulse stops altogether rather than degrading to a slower one.

Bars inside a table's own cells — the tools pane's placeholder — are the Data table page's subject (data-table), so that sample is drawn there rather than here."
           Code="@SkeletonCode">
        <div class="sb-stack">
            <div class="sb-row">
                <span class="sb-label">Text</span>
                <Skeleton Width="12rem" />
            </div>
            <div class="sb-row">
                <span class="sb-label">Heading</span>
                <Skeleton Shape="SkeletonShape.Heading" Width="9rem" />
            </div>
            <div class="sb-row">
                <span class="sb-label">Block</span>
                <Skeleton Shape="SkeletonShape.Block" Width="6rem" />
            </div>
        </div>
    </Story>

    <Story Name="SaveIndicator"
           Description="All four states, plus a run through the sequence the product actually produces — Saving while the change is in flight, Saved once it has landed — driven by the same `DebouncedSave` a host binds an indicator to."
           Code="@SaveCode">
        <div class="sb-stack">
            @foreach (var state in SaveStates)
            {
                <div class="sb-row">
                    <span class="sb-label">@state</span>
                    <SaveIndicator State="state" />
                </div>
            }
            <div class="sb-row">
                <AppButton Variant="ButtonVariant.Primary" OnClick="RunSave">Run a save</AppButton>
                <SaveIndicator State="_save.State" TestId="save-indicator-live" />
            </div>
        </div>
    </Story>

    <Story Name="InfoHint"
           Description="An explanation behind a mark rather than on the face: the bubble shows on hover and on focus, a press pins it for a touch screen, and Escape closes it until the pointer or focus leaves. The trigger is a real button with an accessible name and aria-describedby pointing at the bubble, so a screen reader hears the text without it being visible — which is why nothing here uses a title attribute, which never opens from the keyboard. The bubble is on the raised surface every popover takes and wraps at 44ch."
           Code="@InfoHintCode">
        <div class="sb-stack">
            <div class="sb-row">
                <span class="sb-label" style="font-family: var(--font-family-heading); font-weight: 700;">Score</span>
                <InfoHint AriaLabel="About Score"
                          Text="Two scores, each weighted and normalised to 100: volume is what you shipped against your own record, quality is how much of it was reviewed promptly, merged clean, synced without a conflict and kept small."
                          TriggerTestId="info-hint-demo" />
            </div>
        </div>
    </Story>

    <Story Name="Toast and ToastHost"
           Description="One live region for the whole page; toasts come and go inside it. Each one dismisses itself after its duration, and can be dismissed sooner."
           Code="@ToastCode">
        <div class="sb-row">
            @foreach (var severity in Severities)
            {
                <AppButton Variant="ButtonVariant.Secondary" OnClick="() => Raise(severity)">
                    @severity.ToString()
                </AppButton>
            }
        </div>

        <ToastHost TestId="toast-host">
            @foreach (var toast in _toasts)
            {
                <Toast @key="toast.Id"
                       Title="@toast.Severity.ToString()"
                       Message="@toast.Message"
                       Severity="toast.Severity"
                       DurationMilliseconds="6000"
                       TestId="@($"toast-{toast.Severity}".ToLowerInvariant())"
                       OnDismissed="() => Dismiss(toast.Id)" />
            }
        </ToastHost>
    </Story>

    <Story Name="ToastTray"
           Description="The same two components, wired to the channel the application publishes on rather than to a list the page holds. A screen calls Publish and never learns where the message is drawn; this tray is the only thing that draws one.

                        Raise four in a row to see the rule the channel enforces: .devbook/design/interaction-guidelines.md#feedback-and-toasts allows three at once and queues the rest, so the fourth appears only once one of the three has gone — by its own timer or by its dismiss button."
           Code="@TrayCode">
        <div class="sb-row">
            @foreach (var severity in Severities)
            {
                <AppButton Variant="ButtonVariant.Secondary" OnClick="() => Publish(severity)">
                    Publish @severity.ToString()
                </AppButton>
            }
        </div>

        <p class="sb-state" data-testid="tray-visible">Showing: @Toasts.Visible.Count of @ToastChannel.MaxVisible</p>

        <ToastTray TestId="toast-tray" />
    </Story>

</StoryPage>

@code {
    private static readonly DesignGuideline[] Rules =
    [
        new("interaction-guidelines.md#feedback-and-toasts", "When something is a toast, an alert, or neither."),
        new("interaction-guidelines.md#save-state-indicator-vocabulary", "The words the save state is allowed to say."),
        new("interaction-guidelines.md#empty-loading-and-error-states", "What an empty, loading or failed surface shows."),
        new("accessibility.md#reduced-motion", "What the pulse and the spin do when motion is unwelcome."),
        new("accessibility.md#save-state-announcements", "What a save announces, and how often."),
        new("color-scheme.md#semantic-soft-surface-tokens", "The tone each severity is drawn in."),
        new("accessibility.md#iconography-accessibility", "Why a tick glyph never carries done on its own.")
    ];

    private bool _keyPasted;
    private bool _actorNamed;
    private bool _tested;

    private SetupStep[] SampleSteps =>
    [
        new("Create an Admin API key and paste it below", _keyPasted,
            "Only an organization admin can create one.",
            "https://console.anthropic.com/settings/admin-keys", "Open the Console's Admin keys page"),
        new("Enter the email your Claude Code use is attributed to", _actorNamed,
            "The report is organization-wide; this is what narrows it to you."),
        new("Narrow it to one workspace", false, Optional: true),
        new("Test this account", _tested && _keyPasted)
    ];

    private const string SetupStepsCode = """
        <SetupSteps AriaLabel="Setting up the account" Steps="@Steps" />

        private SetupStep[] Steps =>
        [
            new("Create an Admin API key and paste it below", account.IsConfigured,
                "Only an organization admin can create one.",
                "https://console.anthropic.com/settings/admin-keys", "Open the Console's Admin keys page"),
            new("Enter the email your Claude Code use is attributed to", account.Actor is not null),
            new("Narrow it to one workspace", account.WorkspaceId is not null, Optional: true),
            new("Test this account", lastCheck?.Passed == true)
        ];
        """;

    private static readonly FlowStep[] SampleFlow =
    [
        new("Update Base", FlowStepTone.Done, "Done", "4s", [new("main session", "claude-opus-5-5")]),
        new("Scope Discovery", FlowStepTone.Done, "Done", "6m 12s",
            [new("main session", "claude-opus-5-5"), new("Explore", "claude-opus-5-5")]),
        new("Implementation", FlowStepTone.Done, "Done", "48m 3s · done ×2",
            [new("main session", "claude-opus-5-5"), new("csharp-coding:coding", "sonnet · ×3")]),
        new("Build & Test", FlowStepTone.Active, "In progress", Notes: [new("general-purpose", "sonnet · ×2 · 1 failed")]),
        new("Validation", FlowStepTone.Blocked, "Blocked", Notes: [new("qa:qa", "declared")]),
        new("Personal Validation", FlowStepTone.Pending, "Pending"),
        new("Verification", FlowStepTone.Skipped, "Skipped"),
        new("Summary", FlowStepTone.Pending, "Pending")
    ];

    private const string FlowStepsCode = """
        <FlowSteps AriaLabel="Stages of the run" Steps="@Steps" />

        private FlowStep[] Steps =>
        [
            new("Scope Discovery", FlowStepTone.Done, "Done", "6m 12s",
                [new("main session", "claude-opus-5-5"), new("Explore", "claude-opus-5-5")]),
            new("Build & Test", FlowStepTone.Active, "In progress",
                Notes: [new("general-purpose", "sonnet · ×2 · 1 failed")]),
            new("Summary", FlowStepTone.Pending, "Pending")
        ];
        """;

    private static readonly SaveState[] SaveStates =
        [SaveState.Idle, SaveState.Saving, SaveState.Saved, SaveState.Failed];

    private static readonly ToastSeverity[] Severities =
        [ToastSeverity.Info, ToastSeverity.Success, ToastSeverity.Warning, ToastSeverity.Error];

    private sealed record DemoToast(int Id, ToastSeverity Severity, string Message);

    private readonly List<DemoToast> _toasts = [];
    private int _nextToastId;
    private int _created;
    private string? _alertMessage;

    /// <summary>The save behind the live indicator. Saving for as long as the
    /// delay runs, then Saved — the save itself has nothing to write, so the
    /// delay is the whole of what a reader watches.</summary>
    private readonly DebouncedSave _save = new(TimeSpan.FromMilliseconds(1200), () => Task.CompletedTask);

    protected override void OnInitialized()
    {
        _save.StateChanged += () => InvokeAsync(StateHasChanged);
        Toasts.Changed += OnToastsChanged;
    }

    private void ToggleAlert() =>
        _alertMessage = _alertMessage is null ? "Something went wrong, and this line says what." : null;

    private void Raise(ToastSeverity severity)
    {
        _toasts.Add(new DemoToast(_nextToastId++, severity, $"A {severity} notification, raised from the storybook."));
    }

    private void Dismiss(int id) => _toasts.RemoveAll(toast => toast.Id == id);

    // The tray redraws itself; this is only for the count line beside it, which is
    // the page's own text rather than the component's.
    private void OnToastsChanged() => _ = InvokeAsync(StateHasChanged);

    private void Publish(ToastSeverity severity)
    {
        var message = $"A {severity} notification, published from the storybook.";

        Toasts.Publish(severity switch
        {
            ToastSeverity.Error => ToastMessage.Error(message),
            ToastSeverity.Warning => ToastMessage.Warning(message),
            _ => ToastMessage.Info(message)
        });
    }

    private void RunSave() => _save.Touch();

    public void Dispose()
    {
        Toasts.Changed -= OnToastsChanged;
        _save.Dispose();
    }

    private const string AlertCode = """
        <Alert Message="@_error" />
        """;

    private const string AlertInlineCode = """
        <Alert Message="@_refusal" Role="status" Inline />
        """;

    private const string AlertContentCode = """
        <Alert Message="@_status" Role="status">
            @if (_issue is { } issue)
            {
                &nbsp;<a href="@issue.Url" target="_blank" rel="noopener"
                         aria-label="@($"Open issue {issue.RepoFullName}{issue.Label} on GitHub")">@($"{issue.RepoFullName}{issue.Label}")</a>
            }
        </Alert>
        """;

    private const string EmptyCode = """
        <EmptyState Title="No entries yet" Description="Everything you capture will show up here.">
            <Action><AppButton Variant="ButtonVariant.Primary">New entry</AppButton></Action>
        </EmptyState>
        """;

    private const string EmptyClassCode = """
        <EmptyState BaseClass="devbook-empty"
                    Title="No arc42 folder here yet."
                    TitleCssClass="devbook-empty__title"
                    DescriptionCssClass="@(null)"
                    role="status">
            <DescriptionContent>
                Point storage at a repository root that contains <code>.arc42</code>.
            </DescriptionContent>
        </EmptyState>
        """;

    private const string SpinnerCode = """
        <Spinner Size="SpinnerSize.Small" Label="Loading" />
        """;

    private const string SkeletonCode = """
        @* Where the rows are coming, on the grid they will use — never a second
           layout that only looks like it. The surface, not the bars, says what
           is being waited for. *@
        <div aria-hidden="true">
            <Skeleton Shape="SkeletonShape.Heading" Width="9rem" />
            <Skeleton Width="62%" />
            <Skeleton Width="78%" />
            <Skeleton Shape="SkeletonShape.Block" Width="5rem" />
        </div>
        """;

    private const string SaveCode = """
        <SaveIndicator State="_save.State" />

        @code {
            // Touch() on every edit; SaveNowAsync() for a discrete change.
            private readonly DebouncedSave _save = new(TimeSpan.FromMilliseconds(600), SaveAsync);

            protected override void OnInitialized() =>
                _save.StateChanged += () => InvokeAsync(StateHasChanged);

            public void Dispose() => _save.Dispose();
        }
        """;

    private const string InfoHintCode = """
        <h3>Score</h3>
        <InfoHint AriaLabel="About Score" Text="Two scores, each weighted and normalised to 100: ..." />
        """;

    private const string ToastCode = """
        <ToastHost>
            <Toast Message="@toast.Message" Severity="toast.Severity" OnDismissed="() => Dismiss(toast.Id)" />
        </ToastHost>
        """;

    private const string TrayCode = """
        @inject IToastChannel Toasts

        <ToastTray />

        @code {
            private void Report(string message) => Toasts.Publish(ToastMessage.Error(message));
        }
        """;
}
