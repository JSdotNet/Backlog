@page "/badges"

<PageTitle>Badges — Backlog UI Storybook</PageTitle>

<StoryPage Title="Badges"
           Summary="A badge is a class plus the value it holds. StatusBadge and PriorityBadge are the same component with the slug already worked out.">

    <Story Name="Badge kinds"
           Description="Kind picks the family of styling; Slug picks the value inside it. Anything unslugifiable falls back, so a badge never renders a dangling modifier."
           Code="@BadgeCode">
        <div class="sb-stack">
            @foreach (var kind in Kinds)
            {
                <div class="sb-row">
                    <span class="sb-label">@kind</span>
                    @foreach (var slug in Slugs)
                    {
                        <Badge Kind="@kind" Slug="@slug" Title="@($"{kind}: {slug}")">@slug</Badge>
                    }
                </div>
            }
        </div>
    </Story>

    <Story Name="StatusBadge"
           Description="The status vocabulary is the caller's, not the library's — the badge only slugifies whatever string arrives."
           Code="@StatusCode">
        <div class="sb-row">
            @foreach (var status in StatusValues)
            {
                <StatusBadge Status="@status" TestId="@($"status-{status}")" />
            }
            <StatusBadge Status="" Text="Unknown status" Title="Falls back to the draft slug" />
        </div>
    </Story>

    <Story Name="FeatureStatusBadge"
           Description="How finished a feature is, for the settings switch and for the entry point in the app that leads to it. A released feature renders nothing at all rather than a badge saying so, which is what lets a caller drop this into a header button without an @@if around it."
           Code="@FeatureStatusCode">
        <div class="sb-stack">
            <div class="sb-row">
                @foreach (var status in FeatureStatusValues)
                {
                    <FeatureStatusBadge Status="@status" TestId="@($"feature-{status}")" />
                }
            </div>
            <div class="sb-row">
                <span class="sb-label">In a button</span>
                <AppButton Variant="ButtonVariant.Secondary">
                    Inbox
                    <FeatureStatusBadge Status="dev" Title="In development — not usable yet." />
                </AppButton>
                <AppButton Variant="ButtonVariant.Secondary">
                    AI usage metrics
                    <FeatureStatusBadge Status="beta" Title="Ready to try, but not tested yet." />
                </AppButton>
                <AppButton Variant="ButtonVariant.Secondary">
                    Backlog
                    <FeatureStatusBadge Status="" />
                </AppButton>
            </div>
        </div>
    </Story>

    <Story Name="PriorityBadge"
           Description="Same shape, priority family."
           Code="@PriorityCode">
        <div class="sb-row">
            @foreach (var priority in PriorityValues)
            {
                <PriorityBadge Priority="@priority" TestId="@($"priority-{priority}")" />
            }
            <PriorityBadge Priority="" Text="Unset" />
        </div>
    </Story>

    <Story Name="TagChip"
           Description="Removable chips actually remove: the list below is the page's state and shrinks as you dismiss them."
           Code="@TagCode">
        <div class="sb-stack">
            <div>
                <p class="sb-label">Plain</p>
                <div class="sb-row">
                    @foreach (var tag in FixedTags)
                    {
                        <TagChip Text="@tag" />
                    }
                </div>
            </div>
            <div>
                <p class="sb-label">Removable</p>
                <div class="sb-row" data-testid="removable-tags">
                    @foreach (var tag in _tags)
                    {
                        <TagChip Text="@tag" Removable="true" OnRemove="RemoveTag" TestId="@($"tag-{tag}")" />
                    }
                    <TagChip Text="locked" Removable="true" Disabled="true" />
                </div>
                <p class="sb-state" data-testid="tags-value">[@string.Join(", ", _tags)]</p>
                <div class="sb-row" style="margin-top: 0.5rem">
                    <AppButton Variant="ButtonVariant.Ghost" OnClick="ResetTags">Put them back</AppButton>
                </div>
            </div>
        </div>
    </Story>

    <Story Name="MetadataBadge"
           Description="A status and the things it relates to, in one labelled group."
           Code="@MetadataCode">
        <div class="sb-stack">
            <MetadataBadge Status="ready" Related="@(new[] { "arc42-5", "design-tokens" })" AriaLabel="Entry metadata" />
            <MetadataBadge Status="blocked" Related="@(new[] { "sync" })" AriaLabel="Blocked entry metadata" />
            <MetadataBadge Status="draft" AriaLabel="Draft entry metadata" />
        </div>
    </Story>

</StoryPage>

@code {
    private static readonly string[] Kinds = ["status", "priority", "type"];
    private static readonly string[] Slugs = ["draft", "ready", "active", "blocked", "done"];
    private static readonly string[] StatusValues = ["draft", "ready", "active", "blocked", "done"];
    private static readonly string[] PriorityValues = ["highest", "high", "medium", "low", "lowest"];
    private static readonly string[] FeatureStatusValues = ["dev", "beta"];
    private static readonly string[] FixedTags = ["ui", "markdown", "aspire"];

    private List<string> _tags = ["ui", "markdown", "sync", "aspire", "docs"];

    private void RemoveTag(string tag) => _tags.Remove(tag);

    private void ResetTags() => _tags = ["ui", "markdown", "sync", "aspire", "docs"];

    private const string BadgeCode = """
        <Badge Kind="status" Slug="ready">Ready</Badge>
        """;

    private const string StatusCode = """
        <StatusBadge Status="@entry.Status" />
        """;

    private const string FeatureStatusCode = """
        <FeatureStatusBadge Status="dev" Title="In development — not usable yet." />
        """;

    private const string PriorityCode = """
        <PriorityBadge Priority="@entry.Priority" />
        """;

    private const string TagCode = """
        <TagChip Text="@tag" Removable="true" OnRemove="RemoveTag" />
        """;

    private const string MetadataCode = """
        <MetadataBadge Status="ready" Related="@relatedIds" AriaLabel="Entry metadata" />
        """;
}
