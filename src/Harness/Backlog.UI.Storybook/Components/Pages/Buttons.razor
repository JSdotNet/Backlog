@page "/buttons"

<PageTitle>Buttons — Backlog UI Storybook</PageTitle>

<StoryPage Title="Buttons"
           Summary="One button component with four variants and two sizes, plus the three shapes built on the same conventions."
           Guidelines="@Rules">

    <Story Name="Variants and sizes"
           Description="Variant and size are modifiers on the same button, so any combination is valid. There are two sizes, Small and Default, and Default emits no size modifier."
           Code="@VariantCode">
        <div class="sb-stack">
            @foreach (var size in Sizes)
            {
                <div class="sb-row">
                    <span class="sb-label">@size</span>
                    @foreach (var variant in Variants)
                    {
                        <AppButton Variant="variant" Size="size" OnClick="Count">@variant.ToString()</AppButton>
                    }
                </div>
            }
        </div>
        <p class="sb-state" data-testid="click-count">Clicks: @_clicks</p>
    </Story>

    <Story Name="Unmodified"
           Description="ButtonVariant.None and ButtonSize.Default emit no modifier at all — the escape hatch for a host that already dresses plain `.btn` itself and would be restyled by a modifier it never asked for."
           Code="@NoneCode">
        <div class="sb-row">
            <AppButton Variant="ButtonVariant.None" OnClick="Count">Plain btn</AppButton>
            <AppButton Variant="ButtonVariant.None" Size="ButtonSize.Small" OnClick="Count">Plain btn, small</AppButton>
            <AppButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Default" OnClick="Count">Secondary, default size</AppButton>
        </div>
    </Story>

    <Story Name="Disabled and busy"
           Description="Busy disables the button and swaps the label for a spinner, so a slow action cannot be fired twice."
           Code="@BusyCode">
        <div class="sb-row">
            <AppButton Variant="ButtonVariant.Primary" Disabled="true">Disabled</AppButton>
            <AppButton Variant="ButtonVariant.Primary" Busy="true" BusyLabel="Saving">Save</AppButton>
            <AppButton Variant="ButtonVariant.Primary" Busy="_busy" OnClick="RunBusyAsync">
                @(_busy ? "Working" : "Run for two seconds")
            </AppButton>
        </div>
    </Story>

    <Story Name="With an icon"
           Description="Icon is a fragment rendered before the label, so it can be any glyph or inline SVG."
           Code="@IconCode">
        <div class="sb-row">
            <AppButton Variant="ButtonVariant.Primary" OnClick="Count">
                <Icon><span aria-hidden="true">+</span></Icon>
                <ChildContent>New entry</ChildContent>
            </AppButton>
            <AppButton Variant="ButtonVariant.Danger" OnClick="Count">
                <Icon><span aria-hidden="true">🗑</span></Icon>
                <ChildContent>Delete</ChildContent>
            </AppButton>
        </div>
    </Story>

    <Story Name="DeleteButton"
           Description="The one destructive button, for every surface that deletes something — a milestone in a roadmap dialog, an entry from its footer. Label replaces the default word, ShowIcon drops the glyph, and Size and Disabled are AppButton's.

The glyph is drawn inline rather than fetched, like CopyButton's, because the shipping heads are offline-capable WebViews.

Lead is placement, not styling. A footer is a flex row that pushes its children to the end; a button marked as the lead takes the free space instead, so delete sits at the far end of the row from the button that confirms rather than beside it — a mis-aimed click there is the one click that cannot be taken back."
           Code="@DeleteButtonCode">
        <div class="sb-row">
            <DeleteButton OnClick="Count" TestId="delete-default" />
            <DeleteButton Label="Delete milestone" OnClick="Count" />
            <DeleteButton Size="ButtonSize.Small" OnClick="Count" />
            <DeleteButton ShowIcon="false" OnClick="Count" />
            <DeleteButton Disabled="true" />
        </div>

        @* The placement, shown where it matters: the same footer the roadmap
           dialogs and the entry panel use. *@
        <footer class="modal__footer sb-delete-footer">
            <DeleteButton Lead="true" OnClick="Count" TestId="delete-lead" />
            <AppButton Variant="ButtonVariant.Ghost" OnClick="Count">Cancel</AppButton>
            <AppButton Variant="ButtonVariant.Primary" OnClick="Count">Save</AppButton>
        </footer>

        <p class="sb-state">Clicks: @_clicks</p>
    </Story>

    <Story Name="IconButton"
           Description="A button with no label needs an aria-label, so AppButton's icon-only cousin requires one."
           Code="@IconButtonCode">
        <div class="sb-row">
            <IconButton AriaLabel="Add entry" Title="Add entry" OnClick="Count">+</IconButton>
            <IconButton AriaLabel="Edit entry" Title="Edit entry" OnClick="Count">✎</IconButton>
            <IconButton AriaLabel="Delete entry" Title="Delete entry" OnClick="Count">🗑</IconButton>
            <IconButton AriaLabel="Unavailable action" Disabled="true">⨯</IconButton>
        </div>
        <p class="sb-state">Clicks: @_clicks</p>
    </Story>

    <Story Name="IconButton with real tool icons"
           Description="The icons an entry actually offers: open in an editor, hand the entry to an assistant, copy it, or run it through the gh CLI. Every glyph is inline SVG using currentColor, so it inherits the button's colour and its states, and nothing is fetched at runtime — the shipping heads are offline-capable."
           Code="@ToolIconCode">
        <div class="sb-row">
            @foreach (var tool in Tools)
            {
                <IconButton AriaLabel="@tool.Label"
                            Title="@tool.Label"
                            TestId="@($"tool-{tool.Key}")"
                            OnClick="() => Invoke(tool)">
                    @ToolIcon(tool.Key)
                </IconButton>
            }
        </div>
        <div class="sb-row">
            @foreach (var tool in Tools)
            {
                <AppButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" OnClick="() => Invoke(tool)">
                    <Icon>@ToolIcon(tool.Key)</Icon>
                    <ChildContent>@tool.Label</ChildContent>
                </AppButton>
            }
        </div>
        <p class="sb-state" data-testid="tool-invoked">@(_invoked is null ? "Nothing invoked yet." : $"Invoked: {_invoked}")</p>
    </Story>

    <Story Name="ButtonGroup"
           Description="Related actions in one labelled group."
           Code="@GroupCode">
        <ButtonGroup AriaLabel="Entry actions">
            <AppButton Variant="ButtonVariant.Primary" OnClick="Count">Save</AppButton>
            <AppButton Variant="ButtonVariant.Secondary" OnClick="Count">Duplicate</AppButton>
            <AppButton Variant="ButtonVariant.Ghost" OnClick="Count">Cancel</AppButton>
        </ButtonGroup>
    </Story>

    <Story Name="ToggleButton"
           Description="Two-way bound to page state — the pressed state below is the page's, not the button's."
           Code="@ToggleCode">
        <div class="sb-row">
            <ToggleButton @bind-Pressed="_showDone" AriaLabel="Show completed entries">Show completed</ToggleButton>
            <ToggleButton @bind-Pressed="_compact" AriaLabel="Compact rows">Compact rows</ToggleButton>
            <ToggleButton Pressed="true" Disabled="true" AriaLabel="Locked filter">Locked on</ToggleButton>
        </div>
        <p class="sb-state" data-testid="toggle-state">
            Show completed: @_showDone &nbsp;|&nbsp; Compact rows: @_compact
        </p>
    </Story>

    <Story Name="Wearing the host's classes"
           Description="BaseClass replaces `btn` and every modifier built on it, so an application that already ships chips, pills or toolbar toggles can adopt the component without inheriting a padding, a weight and a transition it never asked for. ToggleButton names the pressed state separately, because a host that has chips almost never calls it `--pressed`."
           Code="@BaseClassCode">
        <div class="sb-row">
            <AppButton BaseClass="sb-chip" Variant="ButtonVariant.None" OnClick="Count">Plain host chip</AppButton>
            <ToggleButton BaseClass="sb-chip"
                          PressedCssClass="sb-chip--on"
                          Pressed="_scoped"
                          PressedChanged="v => _scoped = v"
                          TestId="host-toggle">Scoped</ToggleButton>
            <IconButton BaseClass="sb-chip" AriaLabel="Dismiss" OnClick="Count">x</IconButton>
        </div>
        <p class="sb-state" data-testid="host-toggle-value">Pressed = @_scoped</p>
    </Story>

    <Story Name="Inside something clickable"
           Description="StopPropagation keeps the click off the region around the button. It has to be a parameter, because the onclick:stopPropagation directive attribute only works on an element — writing it on a component is a compile error, so without this a button inside a click-to-edit card could not be one of these."
           Code="@StopPropagationCode">
        <div class="sb-stack">
            <div class="sb-clickable" @onclick="() => _regionClicks++">
                Clicking this card counts a region click.
                <AppButton Variant="ButtonVariant.Secondary" StopPropagation="true" OnClick="Count">Does not</AppButton>
                <AppButton Variant="ButtonVariant.Secondary" OnClick="Count">Does</AppButton>
            </div>
        </div>
        <p class="sb-state" data-testid="region-clicks">Region clicks: @_regionClicks — button clicks: @_clicks</p>
    </Story>

    <Story Name="CopyButton"
           Description="Put something on the clipboard, and say whether it worked. Those are one component rather than two, because the second half is the part that keeps being dropped: the clipboard belongs to the browser and the browser is allowed to refuse — a WebView without permission, a page over plain http — and a button that reported nothing would leave a reader believing they had copied something they had not, which is how you lose whatever was on the clipboard before.

The confirmation is a role=&quot;status&quot; line beside the button rather than a change to its label, so the button goes on saying what it does, and it clears itself after a few seconds. It is used by the code block, the read view, the document bar, the file header, the integration bar, a task row and the task panel — eight call sites, since a markdown chapter has one of its own as well as the document around it, that would otherwise each have grown their own.

The glyph confirms it too: press the first one and the two sheets fade down into a check for as long as the sentence stands, then fade back. That is not a second copy of the message — a task row and the task panel hide the status line and keep only its announcement, so there the check is the whole confirmation a sighted reader gets, which is also why confirming promotes the glyph's colour rather than leaving a state indicator drawn in the disabled tone. Only a success is animated; a refusal keeps the sentence that says what to do instead, because motion here means &quot;that worked&quot;. Under prefers-reduced-motion the check still fades in — only the growing is dropped.

The second sample puts words on the button instead. There is no glyph to swap, so it keeps them — but the wrapper still carries data-copied, which is the hook for a host that wants to dress its own confirmation."
           Code="@CopyButtonCode">
        <div class="sb-row">
            <CopyButton Text="Copied from the storybook." Label="Copy the sample text" TestId="copy-sample" />
            <CopyButton Text="Words instead of a glyph." Label="Copy with a label">Copy</CopyButton>
        </div>
    </Story>

</StoryPage>

@code {
    private static readonly DesignGuideline[] Rules =
    [
        new("color-scheme.md#semantic-soft-surface-tokens", "Which variant may carry which tone."),
        new("accessibility.md#target-sizes-and-text", "How small a button is allowed to get."),
        new("accessibility.md#focus-visibility", "What a focused control has to show."),
        new("typography-and-layout.md#iconography", "When a button is an icon, and what the icon may be."),
        new("design-principles.md#keyboard-first", "Why every act needs a key as well as a click."),
        new("interaction-guidelines.md#motion-and-reduced-motion", "How long a confirmation flash lasts, what it may animate, and what it does instead when motion is unwelcome.")
    ];

    private const string CopyButtonCode = """
        <CopyButton Text="@source" Label="Copy the release notes" />
        """;

    private static readonly ButtonVariant[] Variants =
        [ButtonVariant.Primary, ButtonVariant.Secondary, ButtonVariant.Ghost, ButtonVariant.Danger];

    private static readonly ButtonSize[] Sizes = Enum.GetValues<ButtonSize>();

    private sealed record Tool(string Key, string Label);

    private static readonly IReadOnlyList<Tool> Tools =
    [
        new("vscode", "Open in VS Code"),
        new("claude", "Ask Claude"),
        new("copilot", "Ask GitHub Copilot"),
        new("clipboard", "Copy to clipboard"),
        new("gh", "Run with GitHub CLI")
    ];

    private string? _invoked;
    private bool _scoped = true;
    private int _regionClicks;

    private void Invoke(Tool tool)
    {
        _invoked = tool.Label;
        _clicks++;
    }

    /// <summary>
    /// Each mark is drawn from primitives rather than copied from a brand asset:
    /// a storybook is the wrong place to vendor five companies' trademarked SVGs,
    /// and stroke="currentColor" is what makes them inherit the button's hover,
    /// focus and disabled colours instead of fighting them.
    /// </summary>
    private static RenderFragment ToolIcon(string key) => key switch
    {
        // Angled brackets around a caret: an editor.
        "vscode" => @<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor"
                          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                         <path d="M5.5 4.5 2 8l3.5 3.5" />
                         <path d="m10.5 2.5 3 1.4v8.2l-3 1.4-5-4.5z" />
                     </svg>,

        // Radiating spokes: the Claude burst.
        "claude" => @<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor"
                          stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false">
                         <path d="M8 2v3.2M8 10.8V14M2 8h3.2M10.8 8H14" />
                         <path d="m3.8 3.8 2.3 2.3M9.9 9.9l2.3 2.3M12.2 3.8 9.9 6.1M6.1 9.9l-2.3 2.3" />
                     </svg>,

        // Goggles: the Copilot face.
        "copilot" => @<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor"
                           stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false">
                          <path d="M2.4 9.2c0-2 1.3-3.4 2.9-3.4 1.1 0 1.9.6 2.7.6s1.6-.6 2.7-.6c1.6 0 2.9 1.4 2.9 3.4 0 2.3-2.3 3.6-5.6 3.6S2.4 11.5 2.4 9.2Z" />
                          <path d="M4.6 5.8C5 4.2 6 3.2 8 3.2s3 1 3.4 2.6" />
                          <path d="M6.2 9.4v.9M9.8 9.4v.9" />
                      </svg>,

        // Two offset sheets.
        "clipboard" => @<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor"
                             stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                            <rect x="5.75" y="5.75" width="7.5" height="7.5" rx="1.5" />
                            <path d="M10.25 5.75V4.25a1.5 1.5 0 0 0-1.5-1.5h-4.5a1.5 1.5 0 0 0-1.5 1.5v4.5a1.5 1.5 0 0 0 1.5 1.5h1.5" />
                        </svg>,

        // A terminal prompt: gh is the command line.
        "gh" => @<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor"
                      stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                     <rect x="1.75" y="2.75" width="12.5" height="10.5" rx="2" />
                     <path d="m4.75 6.5 2 1.75-2 1.75M8.75 10.25h3" />
                 </svg>,

        _ => @<span aria-hidden="true">?</span>
    };

    private int _clicks;
    private bool _busy;
    private bool _showDone = true;
    private bool _compact;

    private void Count() => _clicks++;

    private async Task RunBusyAsync()
    {
        _busy = true;
        await Task.Delay(TimeSpan.FromSeconds(2));
        _busy = false;
        _clicks++;
    }

    private const string VariantCode = """
        <AppButton Variant="ButtonVariant.Primary" Size="ButtonSize.Small" OnClick="Save">Save</AppButton>
        """;

    private const string NoneCode = """
        <AppButton Variant="ButtonVariant.None" Size="ButtonSize.Default">Plain btn</AppButton>
        """;

    private const string ToolIconCode = """
        <IconButton AriaLabel="Open in VS Code" Title="Open in VS Code" OnClick="OpenInEditor">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor"
                 stroke-width="1.6" aria-hidden="true" focusable="false">...</svg>
        </IconButton>
        """;

    private const string BusyCode = """
        <AppButton Variant="ButtonVariant.Primary" Busy="@_saving" BusyLabel="Saving">Save</AppButton>
        """;

    private const string IconCode = """
        <AppButton Variant="ButtonVariant.Primary">
            <Icon><span aria-hidden="true">+</span></Icon>
            <ChildContent>New entry</ChildContent>
        </AppButton>
        """;

    private const string IconButtonCode = """
        <IconButton AriaLabel="Delete entry" Title="Delete entry" OnClick="Delete">🗑</IconButton>
        """;

    private const string DeleteButtonCode = """
        <footer class="modal__footer">
            <DeleteButton Lead="true" OnClick="DeleteAsync" TestId="roadmap-editor-delete" />
            <AppButton Variant="ButtonVariant.Ghost" OnClick="CancelAsync">Cancel</AppButton>
            <AppButton Variant="ButtonVariant.Primary" OnClick="SaveAsync">Save</AppButton>
        </footer>
        """;

    private const string GroupCode = """
        <ButtonGroup AriaLabel="Entry actions">
            <AppButton Variant="ButtonVariant.Primary">Save</AppButton>
            <AppButton Variant="ButtonVariant.Ghost">Cancel</AppButton>
        </ButtonGroup>
        """;

    private const string ToggleCode = """
        <ToggleButton @bind-Pressed="_showDone" AriaLabel="Show completed entries">Show completed</ToggleButton>
        """;

    private const string BaseClassCode = """
        <AppButton BaseClass="chip" Variant="ButtonVariant.None">Plain host chip</AppButton>
        <ToggleButton BaseClass="chip" PressedCssClass="chip--active"
                      Pressed="_scoped" PressedChanged="v => _scoped = v">Scoped</ToggleButton>
        """;

    private const string StopPropagationCode = """
        <div @onclick="BeginEdit">
            <AppButton StopPropagation="true" OnClick="Delete">Delete</AppButton>
        </div>
        """;
}
