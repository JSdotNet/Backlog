@page "/inputs"

<PageTitle>Inputs — Backlog UI Storybook</PageTitle>

<StoryPage Title="Inputs"
           Summary="Text, long text, search, the two switches, and the fields a date, a time or a repeat is set with. Every one of them is two-way bound to the state shown underneath it. Reordering is not here: the handle that moves a row is part of the row, so it is in the Task list chapter with the component that draws it."
           Guidelines="@Rules">

    <Story Name="TextField"
           Description="Label, help text and error message are all optional; when an error is set it replaces the help text and is announced. `Type` takes text, number, url and email here — the date and time types have a story of their own below."
           Code="@TextFieldCode">
        <div class="sb-grid">
            <div>
                <TextField Label="Title"
                           @bind-Value="_title"
                           Placeholder="What is this about?"
                           TestId="input-title" />
                <p class="sb-state" data-testid="input-title-value">@Show(_title)</p>
            </div>
            <div>
                <TextField Label="Repository URL"
                           Type="url"
                           Value="@_url"
                           ValueChanged="v => _url = v"
                           HelpText="Used only to build links; nothing is fetched."
                           TestId="input-url" />
                <p class="sb-state" data-testid="input-url-value">@Show(_url)</p>
            </div>
            <div>
                <TextField Label="Estimate (hours)"
                           Type="number"
                           Value="@_estimate"
                           ValueChanged="v => _estimate = v"
                           TestId="input-estimate" />
                <p class="sb-state" data-testid="input-estimate-value">@Show(_estimate)</p>
            </div>
            <div>
                <TextField Label="Alias"
                           Value="@_alias"
                           ValueChanged="v => _alias = v"
                           ErrorMessage="@AliasError"
                           HelpText="Lowercase letters and hyphens."
                           TestId="input-alias" />
                <p class="sb-state">Type a capital letter to see the error state.</p>
            </div>
            <div>
                <TextField Label="Disabled" Value="Cannot be edited" Disabled="true" />
                <TextField Label="Readonly" Value="Can be copied, not changed" Readonly="true" />
            </div>
        </div>
    </Story>

    <Story Name="A marker inside the field"
           Description="Suffix puts something at the input's trailing edge, and the field makes room for it rather than letting it overlap: type past the width and the value scrolls behind nothing. The marker takes no clicks either — a click on it lands in the field. It carries its own accessible name, because a badge is where a fact like 'folder found' lives once the line under the field stops saying it. A field given no suffix renders exactly as the ones above; the box only appears when there is something to put in it."
           Code="@SuffixCode">
        <div class="sb-columns">
            <div>
                <p class="sb-label">Bare, host classes, found</p>
                <TextField Bare="true"
                           LabelCssClass="sb-label"
                           InputCssClass="sb-host-input"
                           Label="Domain folder"
                           Value="@_domainFolder"
                           ValueChanged="v => _domainFolder = v"
                           data-testid="input-suffix-found">
                    <Suffix>
                        <span class="sb-marker sb-marker--found" role="img" aria-label="Folder found.">&#x2713;</span>
                    </Suffix>
                </TextField>
            </div>
            <div>
                <p class="sb-label">Bare, host classes, missing</p>
                <TextField Bare="true"
                           LabelCssClass="sb-label"
                           InputCssClass="sb-host-input"
                           Label="Design folder"
                           Value="@_designFolder"
                           ValueChanged="v => _designFolder = v"
                           data-testid="input-suffix-missing">
                    <Suffix>
                        <span class="sb-marker sb-marker--missing" role="img" aria-label="Folder not found.">&#x2715;</span>
                    </Suffix>
                </TextField>
            </div>
            <div>
                <TextField Label="Estimate"
                           Value="@_estimate"
                           ValueChanged="v => _estimate = v"
                           HelpText="A suffix is not only a state: a unit reads the same way."
                           TestId="input-suffix-unit">
                    <Suffix>
                        <span class="sb-state">hrs</span>
                    </Suffix>
                </TextField>
            </div>
        </div>
    </Story>

    <Story Name="TextArea"
           Description="AutoGrow is on by default: the box follows the text instead of introducing an inner scrollbar. The fixed one shows the difference."
           Code="@TextAreaCode">
        <div class="sb-columns">
            <div>
                <p class="sb-label">AutoGrow = true (default)</p>
                <TextArea Label="Notes"
                          @bind-Value="_notes"
                          Placeholder="Type several lines and watch it grow"
                          TestId="input-notes" />
            </div>
            <div>
                <p class="sb-label">AutoGrow = false, Rows = 3</p>
                <TextArea Label="Notes"
                          Value="@_notes"
                          ValueChanged="v => _notes = v"
                          AutoGrow="false"
                          Rows="3"
                          HelpText="Same value, fixed height."
                          TestId="input-notes-fixed" />
            </div>
        </div>
        <TextArea Label="With an error"
                  Value="@_notes"
                  ValueChanged="v => _notes = v"
                  ErrorMessage="A body is required." />
        <p class="sb-state" data-testid="input-notes-value">@_notes.Length characters</p>
    </Story>

    <Story Name="SearchBox"
           Description="The bound value lags the keystrokes by the debounce, which is the whole point: a filter runs once, when typing stops."
           Code="@SearchCode">
        <div class="sb-stack">
            <SearchBox Value="@_query"
                       ValueChanged="v => _query = v"
                       Placeholder="Search entries"
                       DebounceMilliseconds="300"
                       TestId="input-search" />
            <p class="sb-state" data-testid="input-search-value">Debounced value = @Show(_query)</p>
            <SearchBox Value="" Placeholder="Disabled" Disabled="true" />
        </div>
    </Story>

    <Story Name="Toggle"
           Description="role=switch, so it is announced as on or off rather than as a checkbox."
           Code="@ToggleCode">
        <div class="sb-stack">
            <Toggle Checked="_syncEnabled"
                    CheckedChanged="v => _syncEnabled = v"
                    Label="Sync with the cloud"
                    Description="Entries are kept locally either way."
                    TestId="input-sync" />
            <Toggle Checked="_showArchived"
                    CheckedChanged="v => _showArchived = v"
                    Label="Show archived entries"
                    TestId="input-archived" />
            <Toggle Checked="true" Label="Locked on" Disabled="true" />
            <p class="sb-state" data-testid="input-toggle-value">
                Sync: @_syncEnabled &nbsp;|&nbsp; Archived: @_showArchived
            </p>
        </div>
    </Story>

    <Story Name="Toggle as a feature-flag row"
           Description="NativeCheckbox renders a real checkbox inside a label, so the whole row is clickable and the control has form semantics. The class hooks let a host name every part, and the flag-row look ships with the library."
           Code="@FlagToggleCode">
        <div class="feature-flags" role="list" aria-label="Feature flags">
            <Toggle NativeCheckbox="true"
                    BaseClass="feature-flag"
                    TextCssClass="feature-flag__content"
                    LabelCssClass="feature-flag__title"
                    DescriptionCssClass="feature-flag__description"
                    Label="GitHub integration"
                    Description="Push entries to issues and read their state back."
                    Checked="_githubFlag"
                    CheckedChanged="v => _githubFlag = v"
                    TestId="flag-github"
                    role="listitem" />
            <Toggle NativeCheckbox="true"
                    BaseClass="feature-flag"
                    CssClass="feature-flag--locked"
                    TextCssClass="feature-flag__content"
                    LabelCssClass="feature-flag__title"
                    DescriptionCssClass="feature-flag__description"
                    Label="Backlog"
                    Description="The one thing this app is for."
                    Checked="true"
                    Disabled="true"
                    TestId="flag-backlog"
                    role="listitem">
                <TextContent>
                    <span class="feature-flag__status">Always available</span>
                </TextContent>
            </Toggle>
        </div>
        <p class="sb-state" data-testid="input-flag-value">GitHub integration: @_githubFlag</p>
    </Story>

    <Story Name="Checkbox"
           Description="The 'all' box is indeterminate whenever some — but not all — of the children are checked, which is state the browser cannot derive on its own."
           Code="@CheckboxCode">
        <div class="sb-stack">
            <Checkbox Checked="AllChecked"
                      CheckedChanged="SetAll"
                      Indeterminate="SomeChecked"
                      Label="All areas"
                      TestId="check-all" />
            @foreach (var area in Areas)
            {
                <Checkbox Checked="_checked.Contains(area)"
                          CheckedChanged="v => SetArea(area, v)"
                          Label="@area"
                          TestId="@($"check-{area.ToLowerInvariant()}")" />
            }
            <Checkbox Checked="false" Label="Disabled" Disabled="true" />
            <p class="sb-state" data-testid="input-checkbox-value">[@string.Join(", ", _checked)]</p>
        </div>

        <p class="sb-label" style="margin-top: 1rem">With trailing content</p>
        <Checkbox Checked="_folderEnabled"
                  CheckedChanged="v => _folderEnabled = v"
                  Label="Architecture"
                  TestId="check-trailing">
            <code>.arc42</code>
        </Checkbox>
    </Story>

    <Story Name="A date, a time and a repeat"
           Description="The three fields a scheduled thing is set with. `Type=&quot;date&quot;` takes and returns `yyyy-MM-dd`, `Type=&quot;time&quot;` takes `HH:mm`, and `Type=&quot;datetime-local&quot;` takes `yyyy-MM-ddTHH:mm` — the native wire formats, invariant. What each is called on screen is the browser's, from the locale.

Bind `@@onchange` rather than `ValueChanged` for any of them: a half-typed date raises input events that read as empty, and a host for which empty means &quot;clear it&quot; would clear the field mid-keystroke. A date commits when it is a date.

A repeat is a SelectField over the repeat tokens themselves, so what the picker offers and what the metadata line can hold cannot drift apart."
           Code="@ScheduleFieldCode">
        <div class="sb-grid">
            <div>
                <TextField Label="Due date" Type="date" Value="@_due" ValueChanged="v => _due = v" TestId="schedule-due" />
                <p class="sb-state" data-testid="schedule-due-value">@Show(_due)</p>
            </div>
            <div>
                <TextField Label="Reminder time" Type="time" Value="@_remindTime" ValueChanged="v => _remindTime = v" TestId="schedule-time" />
                <p class="sb-state" data-testid="schedule-time-value">@Show(_remindTime)</p>
            </div>
            <div>
                <TextField Label="Remind me at" Type="datetime-local" Value="@_remindAt" ValueChanged="v => _remindAt = v" TestId="schedule-remind" />
                <p class="sb-state" data-testid="schedule-remind-value">@Show(_remindAt)</p>
            </div>
            <div>
                <SelectField Label="Repeat"
                             CurrentValue="@_repeat"
                             Options="@RepeatOptions"
                             IncludeEmptyOption="true"
                             EmptyLabel="Never"
                             OnChanged="v => _repeat = v ?? string.Empty"
                             TestId="schedule-repeat" />
                <p class="sb-state" data-testid="schedule-repeat-value">@Show(_repeat)</p>
            </div>
        </div>
    </Story>

    <Story Name="TaskAction — set it, see it, clear it"
           Description="The control that puts one of those values on something: an icon, a label, the value once it is set, and an ✕ to take it off. One component for all of them, because a row that is set says what it is set to and a row that is not says what it would do — that difference is the whole state model, which is why &quot;Remind me&quot; and &quot;Reminder · Monday 09:00&quot; are one control and not two.

`Togglable` is for a value with nothing to pick: My Day is on or off, so pressing it again is how it comes off and there is no ✕. For the others, `OnSet` opens whichever field above this story fits, and `OnClear` unsets it. `Disabled` is for an act the host cannot perform yet."
           Code="@ActionCode">
        <div class="sb-menu-wide sb-surface" data-testid="task-actions">
            <TaskAction Icon="+" Label="Add step" TestId="action-step" OnSet="() => { }" />

            <TaskAction Icon="☀"
                        Label="@(_inMyDay ? "Added to My Day" : "Add to My Day")"
                        Set="@_inMyDay"
                        Togglable="true"
                        OnSet="() => _inMyDay = !_inMyDay"
                        TestId="action-myday" />

            <TaskAction Icon="⏰"
                        Label="Remind me"
                        Value="Monday · 09:00"
                        Set="@_reminded"
                        OnSet="() => _reminded = true"
                        OnClear="() => _reminded = false"
                        TestId="action-remind" />

            <TaskAction Icon="🗓"
                        Label="Due date"
                        Value="Friday, 21 August"
                        Set="@_dueSet"
                        OnSet="() => _dueSet = true"
                        OnClear="() => _dueSet = false"
                        TestId="action-due" />

            <TaskAction Icon="🔁"
                        Label="Repeat"
                        Value="Weekly"
                        Set="@_repeats"
                        OnSet="() => _repeats = true"
                        OnClear="() => _repeats = false"
                        TestId="action-repeat" />

            <TaskAction Icon="📎" Label="Add file" Disabled="true" TestId="action-file" />
        </div>
    </Story>

    <Story Name="Fields without their wrapper"
           Description="Bare emits the label, the control and the messages as siblings, for a form whose own layout already places them — the same escape hatch Tabs offers. The part classes come with it: a host that has its own field styling replaces `field__label` and `field__input` rather than styling against ours as well as its own. A textarea's grow wrapper carries the border, so a host whose box is already bordered clears GrowCssClass instead of doubling it up."
           Code="@BareCode">
        <div class="sb-columns">
            <div>
                <p class="sb-label">Default</p>
                <TextField Label="Folder" Value="@_folder" ValueChanged="v => _folder = v" TestId="input-wrapped" />
            </div>
            <div>
                <p class="sb-label">Bare, wearing host classes</p>
                <TextField Bare="true"
                           LabelCssClass="sb-label"
                           InputCssClass="sb-host-input"
                           Label="Folder"
                           Value="@_folder"
                           ValueChanged="v => _folder = v"
                           data-testid="input-bare" />
            </div>
        </div>
        <p class="sb-state" data-testid="input-bare-value">Folder = @_folder</p>

        <p class="sb-label" style="margin-top: 1rem">Bare textarea, host border, no grow wrapper</p>
        <TextArea Bare="true"
                  AutoGrow="false"
                  GrowCssClass=""
                  LabelCssClass="sb-label"
                  InputCssClass="sb-host-input"
                  Label="Repositories"
                  Rows="3"
                  Value="@_repos"
                  ValueChanged="v => _repos = v"
                  data-testid="input-bare-textarea" />
    </Story>

</StoryPage>

@code {
    private static readonly DesignGuideline[] Rules =
    [
        new("interaction-guidelines.md#save-timing-and-debounce", "How long a field waits before it saves, and which edits commit at once."),
        new("content-editing.md#scheduling-and-dependency-tokens", "The date, time and repeat grammar these fields read and write."),
        new("accessibility.md#keyboard-navigation", "What every control has to be reachable and operable with."),
        new("typography-and-layout.md#density", "Control heights, label pairing and how tight a form is allowed to be.")
    ];

    private static readonly IReadOnlyList<SelectorOption> RepeatOptions =
    [
        new("daily", "Every day"),
        new("weekdays", "Every weekday"),
        new("weekly", "Every week"),
        new("monthly", "Every month"),
        new("yearly", "Every year")
    ];

    private static readonly string[] Areas = ["Product", "Platform", "Design"];

    private string _title = "Storybook for Backlog.UI.Components";
    private string _url = "https://github.com/JSdotNet/Backlog";
    private string _estimate = "3";
    private string _due = "2026-08-31";
    private string _remindAt = "2026-08-31T09:00";
    private string _remindTime = "09:00";
    private string _repeat = "weekly";
    private bool _inMyDay = true;
    private bool _reminded = true;
    private bool _dueSet;
    private bool _repeats;
    private string _alias = "backlog";
    private string _notes = "The read view and the editor show the same text.\nAdd a line to see AutoGrow work.";
    private string _query = string.Empty;
    private string _folder = @"C:\Repos\Backlog";

    // Long enough to overflow the box, which is the case the trailing padding is
    // there for: the end of the path has to disappear at the edge of the input
    // rather than under the marker.
    private string _domainFolder = @"C:\Repos\Backlog\knowledge\.domain";
    private string _designFolder = ".design";

    private string _repos = "JSdotNet/Backlog\nJSdotNet/Infra";
    private bool _folderEnabled = true;
    private bool _syncEnabled = true;
    private bool _showArchived;
    private bool _githubFlag = true;
    private readonly HashSet<string> _checked = ["Product"];

    private string? AliasError => _alias.Any(char.IsUpper) ? "Use lowercase letters only." : null;

    private bool AllChecked => _checked.Count == Areas.Length;

    private bool SomeChecked => _checked.Count > 0 && _checked.Count < Areas.Length;

    private void SetAll(bool value)
    {
        _checked.Clear();
        if (!value) return;

        foreach (var area in Areas)
        {
            _checked.Add(area);
        }
    }

    private void SetArea(string area, bool value)
    {
        if (value)
        {
            _checked.Add(area);
        }
        else
        {
            _checked.Remove(area);
        }
    }

    private static string Show(string? value) => string.IsNullOrEmpty(value) ? "(empty)" : value;

    private const string TextFieldCode = """
        <TextField Label="Title" @bind-Value="_title" Placeholder="What is this about?" />
        """;

    private const string SuffixCode = """
        <TextField Bare="true" InputCssClass="setting__input"
                   Label="Domain folder" @bind-Value="_domainFolder">
            <Suffix>
                <span class="knowledge-folder__marker knowledge-folder__marker--found"
                      role="img" aria-label="Folder found.">✓</span>
            </Suffix>
        </TextField>
        """;

    private const string TextAreaCode = """
        <TextArea Label="Notes" @bind-Value="_notes" />
        """;

    private const string SearchCode = """
        <SearchBox Value="@_query" ValueChanged="v => _query = v" DebounceMilliseconds="300" />
        """;

    private const string ToggleCode = """
        <Toggle Checked="_syncEnabled" CheckedChanged="v => _syncEnabled = v" Label="Sync with the cloud" />
        """;

    private const string FlagToggleCode = """
        <Toggle NativeCheckbox="true"
                BaseClass="feature-flag"
                TextCssClass="feature-flag__content"
                LabelCssClass="feature-flag__title"
                DescriptionCssClass="feature-flag__description"
                Label="GitHub integration"
                Description="Push entries to issues and read their state back."
                Checked="_githubFlag"
                CheckedChanged="v => _githubFlag = v" />
        """;

    private const string CheckboxCode = """
        <Checkbox Checked="AllChecked" CheckedChanged="SetAll" Indeterminate="SomeChecked" Label="All areas" />
        <Checkbox Checked="_enabled" CheckedChanged="v => _enabled = v" Label="Architecture">
            <code>.arc42</code>
        </Checkbox>
        """;

    private const string ScheduleFieldCode = """
        <TextField Label="Due date" Type="date"
                   Value="@_due" @onchange="OnDuePicked" />

        <TextField Label="Remind me at" Type="datetime-local"
                   Value="@_remindAt" @onchange="OnReminderPicked" />

        <SelectField Label="Repeat"
                     CurrentValue="@_repeat"
                     Options="@RepeatOptions"
                     IncludeEmptyOption="true"
                     EmptyLabel="Never"
                     OnChanged="OnRepeatPicked" />
        """;

    private const string ActionCode = """
        <TaskAction Icon="🗓"
                    Label="Due date"
                    Value="@FormatDate(row.DueOn)"
                    Set="@(row.DueOn is not null)"
                    OnSet="() => OpenPicker(Picker.Due)"
                    OnClear="() => ClearDueAsync(row)" />

        <TaskAction Icon="☀" Label="Add to My Day" Togglable="true"
                    Set="@row.InMyDay" OnSet="() => ToggleMyDayAsync(row)" />
        """;

    private const string BareCode = """
        <TextField Bare="true"
                   LabelCssClass="setting__label"
                   InputCssClass="setting__input"
                   Label="Folder" Value="@_folder" ValueChanged="v => _folder = v" />

        <TextArea Bare="true" AutoGrow="false" GrowCssClass=""
                  LabelCssClass="setting__label" InputCssClass="setting__input"
                  Label="Repositories" Rows="3" Value="@_repos" ValueChanged="v => _repos = v" />
        """;
}
