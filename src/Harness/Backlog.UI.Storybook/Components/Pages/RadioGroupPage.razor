@page "/radio-group"

<PageTitle>Radio group — Backlog UI Storybook</PageTitle>

<StoryPage Title="Radio group"
           Summary="One choice out of several, as one stop in the tab order. Its own page rather than a story on Inputs because the keyboard convention is the subject: Tab reaches the group once, and the arrow keys move the choice and the focus together."
           Guidelines="@Rules">

    <Story Name="RadioGroup"
           Description="Tab lands on the checked choice. ArrowRight and ArrowDown take the next one, ArrowLeft and ArrowUp the previous one, wrapping at the ends; Home and End jump to them. Every move checks the choice it lands on and raises ValueChanged."
           Code="@RadioGroupCode">
        <div class="sb-columns">
            <div>
                <RadioGroup TValue="string"
                            Options="@Choices"
                            @bind-Value="_choice"
                            OptionLabel="@Label"
                            OptionTestId="@(choice => $"radio-group-{choice}")"
                            AriaLabel="What to do with the duplicate"
                            TestId="radio-group-duplicate" />
            </div>
            <div>
                <p class="sb-label">What the host holds</p>
                <p class="sb-state" data-testid="radio-group-state">@_choice</p>
            </div>
        </div>
    </Story>

    <Story Name="Nothing checked yet"
           Description="With no choice made the group is still one stop: the first choice the keyboard can reach takes it, and the first arrow checks a choice."
           Code="@EmptyCode">
        <RadioGroup TValue="string"
                    Options="@Choices"
                    @bind-Value="_unset"
                    OptionLabel="@Label"
                    AriaLabel="What to do with the duplicate"
                    TestId="radio-group-unset" />
    </Story>

    <Story Name="A choice that cannot be taken, and a disabled group"
           Description="OptionDisabled draws a choice the arrows step over. Disabled turns the whole group off, as a host does while what it decides is being applied."
           Code="@DisabledCode">
        <div class="sb-columns">
            <div>
                <RadioGroup TValue="string"
                            Options="@Choices"
                            @bind-Value="_partial"
                            OptionLabel="@Label"
                            OptionDisabled="@(choice => choice == "archive")"
                            AriaLabel="What to do with the duplicate"
                            TestId="radio-group-partial" />
            </div>
            <div>
                <RadioGroup TValue="string"
                            Options="@Choices"
                            Value="@("merge")"
                            OptionLabel="@Label"
                            Disabled="true"
                            AriaLabel="What to do with the duplicate"
                            TestId="radio-group-disabled" />
            </div>
        </div>
    </Story>

    <Story Name="Another button variant"
           Description="OptionVariantClass picks the button variant every choice wears; the library keeps the rest of the button. OptionCssClass and CheckedOptionCssClass then replace what follows it with the host's own classes."
           Code="@VariantCode">
        <RadioGroup TValue="string"
                    Options="@Choices"
                    @bind-Value="_variant"
                    OptionLabel="@Label"
                    OptionVariantClass="btn--secondary"
                    AriaLabel="What to do with the duplicate"
                    TestId="radio-group-variant" />
    </Story>

</StoryPage>

@code {
    private static readonly string[] Choices = ["merge", "archive", "keep-both"];

    private string? _choice = "merge";
    private string? _unset;
    private string? _partial = "merge";
    private string? _variant = "archive";

    private static readonly DesignGuideline[] Rules =
    [
        new("accessibility.md#keyboard-navigation", "What a control has to be reachable and operable with from the keyboard alone."),
        new("accessibility.md#focus-visibility", "What the ring on the focused choice has to look like.")
    ];

    private static string Label(string choice) => choice switch
    {
        "merge" => "Keep the other, attach this one",
        "archive" => "Archive the capture",
        _ => "Keep both",
    };

    private const string RadioGroupCode = """
        <RadioGroup TValue="string"
                    Options="@Choices"
                    @bind-Value="_choice"
                    OptionLabel="@Label"
                    OptionTestId="@(choice => $"radio-group-{choice}")"
                    AriaLabel="What to do with the duplicate"
                    TestId="radio-group-duplicate" />
        """;

    private const string EmptyCode = """
        <RadioGroup TValue="string" Options="@Choices" @bind-Value="_unset" OptionLabel="@Label"
                    AriaLabel="What to do with the duplicate" />
        """;

    private const string DisabledCode = """
        <RadioGroup TValue="string" Options="@Choices" @bind-Value="_partial" OptionLabel="@Label"
                    OptionDisabled="@(choice => choice == "archive")"
                    AriaLabel="What to do with the duplicate" />

        <RadioGroup TValue="string" Options="@Choices" Value="@("merge")" OptionLabel="@Label"
                    Disabled="true"
                    AriaLabel="What to do with the duplicate" />
        """;

    private const string VariantCode = """
        <RadioGroup TValue="string"
                    Options="@Choices"
                    @bind-Value="_variant"
                    OptionLabel="@Label"
                    OptionVariantClass="btn--secondary"
                    AriaLabel="What to do with the duplicate"
                    TestId="radio-group-variant" />
        """;
}
