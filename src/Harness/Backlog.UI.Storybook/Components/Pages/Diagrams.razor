@page "/diagrams"

<PageTitle>Diagrams — Backlog UI Storybook</PageTitle>

<StoryPage Title="Diagrams"
           Summary="DiagramView renders mermaid in the browser, offers an Archify artifact as a second renderer where the host has one, and shows the source for everything else. GraphView hands arbitrary node/edge data to a JS renderer."
           Guidelines="@Rules">

    <Story Name="Flow diagram with decisions"
           Description="A process with branches, which is what most entries draw. Rendered by backlogDiagrams.render, which loads mermaid on first use and runs it on theme 'base' with themeVariables read from the live tokens, so the diagram takes the stylesheet's colours. The source stays available under the diagram."
           Code="@FlowCode"
           Source="@FlowWithDecisions"
           SourceLanguage="mermaid"
           SourceLabel="entry-lifecycle.mmd">
        <DiagramView Title="Entry lifecycle" Language="mermaid" Source="@FlowWithDecisions" />
    </Story>

    <Story Name="Mermaid sequence diagram"
           Code="@SequenceCode"
           Description="Same component, different mermaid dialect — the language attribute is all that decides whether it renders."
           Source="@Sequence"
           SourceLanguage="mermaid"
           SourceLabel="auto-save.mmd">
        <DiagramView Title="Auto-save" Language="mermaid" Source="@Sequence" />
    </Story>

    <Story Name="With an Archify artifact"
           Description="Nothing on the call changes. The host registers an IDiagramArtifactSource and DiagramView asks it, per source, whether a picture exists; here the storybook's fixture answers for this one fence with a committed artifact, matched on the normalized source the same way the app matches a chapter's.

The switch in the header appears only when an artifact exists. The artifact shows by default, the reader can switch to Mermaid and back, and Full screen is offered for the artifact only — a drawn mermaid diagram is an SVG in the page and has nothing to go full screen with."
           Code="@ArtifactCode"
           Source="@StorybookDiagramArtifacts.ComponentMap"
           SourceLanguage="mermaid"
           SourceLabel="slice-flow.mmd">
        <DiagramView Title="Slice flow" Language="mermaid" Source="@StorybookDiagramArtifacts.ComponentMap" />
    </Story>

    <Story Name="Artifact out of date"
           Description="The same fence with one label edited. The fixture still knows an artifact for this diagram, but it was authored from the earlier text, so the lookup by hash misses: the reader sees the mermaid — the rendering that is current — and a notice saying why the picture is not on screen.

Render artifact is what the app would press to re-run the generator over the specification beside the chapter and put the artifact back. The storybook serves a committed file and cannot run it, so the fixture reports that instead."
           Code="@OutOfDateCode"
           Source="@StorybookDiagramArtifacts.ComponentMapEdited"
           SourceLanguage="mermaid"
           SourceLabel="slice-flow.mmd (edited)">
        <DiagramView Title="Slice flow" Language="mermaid" Source="@StorybookDiagramArtifacts.ComponentMapEdited" />
    </Story>

    <Story Name="A language that cannot be rendered"
           Code="@PlantUmlCode"
           Description="CanRender is false for plantuml, so the component shows the source instead of pretending it failed. Nothing is lost and nothing is loaded.">
        <DiagramView Title="Component overview" Language="plantuml" Source="@PlantUml" />
    </Story>

    <Story Name="Broken mermaid source"
           Code="@BrokenCode"
           Description="Mermaid rejects the source, and the fallback says so while keeping the text readable — a half-typed diagram in an entry must not blank the page.">
        <DiagramView Title="Broken on purpose" Language="mermaid" Source="@BrokenMermaid" />
    </Story>

    <Story Name="GraphView"
           Description="A generic node/edge object through the default backlogDiagrams.renderGraph. The data is a plain anonymous object, so the component never learns the caller's model."
           Code="@GraphCode">
        <GraphView Title="Component library"
                   Description="What the storybook references, and what it deliberately does not."
                   BadgeText="demo"
                   Data="GraphData" />
    </Story>

</StoryPage>

@code {
    private static readonly DesignGuideline[] Rules =
    [
        new("component-libraries.md#diagram-and-graph-strategy", "Which renderer draws which kind of picture."),
        new("component-libraries.md#archify-artifacts", "What a diagram with an artifact carries, and why the fence stays the answer when the artifact is stale."),
        new("color-scheme.md#chart-roles", "The hues a node, an edge and a lane may use."),
        new("interaction-guidelines.md#motion-and-reduced-motion", "Whether a layout may animate as it settles.")
    ];

    // Decision diamonds, a loop back and a terminal state: the shapes a flow
    // diagram has that a dependency graph does not.
    private const string FlowWithDecisions = """
        flowchart LR
            Start([Captured]) --> Triage{Ready to work?}
            Triage -- no --> Refine[Refine]
            Refine --> Triage
            Triage -- yes --> Active[In progress]
            Active --> Review{Review passes?}
            Review -- no --> Active
            Review -- yes --> Done([Done])
            Active -.blocked.-> Blocked[Blocked]
            Blocked --> Active
        """;

    private const string Sequence = """
        sequenceDiagram
            participant U as User
            participant E as Editor
            participant S as Store
            U->>E: types
            E->>S: save (debounced)
            S-->>E: saved
            E-->>U: SaveIndicator shows Saved
        """;

    private const string PlantUml = """
        @startuml
        package "Backlog.UI.Components" {
          [Buttons]
          [Inputs]
          [Markdown]
        }
        @enduml
        """;

    // Deliberately invalid: "flowchart" with no direction and an unclosed node.
    private const string BrokenMermaid = """
        flowchart
            A[Unclosed --> B]]]
            -->
        """;

    private static readonly object GraphData = new
    {
        nodes = new object[]
        {
            new { id = "storybook", label = "Backlog.UI.Storybook" },
            new { id = "components", label = "Backlog.UI.Components" },
            new { id = "servicedefaults", label = "Backlog.Aspire.ServiceDefaults" },
            new { id = "modules", label = "Backlog.Modules.* (not referenced)" }
        },
        edges = new object[]
        {
            new { source = "storybook", target = "components" },
            new { source = "storybook", target = "servicedefaults" }
        }
    };

    private const string FlowCode = """
        <DiagramView Title="Entry lifecycle" Language="mermaid" Source="@source" />

        flowchart LR
            Start([Captured]) --> Triage{Ready to work?}
            Triage -- yes --> Active[In progress]
        """;

    private const string GraphCode = """
        <GraphView Title="Component library" Data="new { nodes = ..., edges = ... }" />
        """;

    private const string SequenceCode = """
        <DiagramView Title="Auto-save" Language="mermaid" Source="@source" ShowSource="false" />
        """;

    // The two artifact stories share their sources with the fixture rather than
    // declaring copies: DiagramView finds an artifact by the hash of the source,
    // so a page-side copy that drifted by a character would silently turn the
    // first story into the second.
    private const string ArtifactCode = """
        @* Program.cs — the host answers IDiagramArtifactSource; the call is unchanged. *@
        builder.Services.AddSingleton<IDiagramArtifactSource, StorybookDiagramArtifacts>();

        <DiagramView Title="Slice flow" Language="mermaid" Source="@source" />
        """;

    private const string OutOfDateCode = """
        @* The same call. The source is the fence after an edit, so the artifact
           the source knows no longer matches it. *@
        <DiagramView Title="Slice flow" Language="mermaid" Source="@editedSource" />
        """;

    private const string PlantUmlCode = """
        @* No ShowSource="false": CanRender is false for plantuml, so the source is
           all there is to show and the component falls back to it on its own. *@
        <DiagramView Title="Component overview" Language="plantuml" Source="@source" />
        """;

    private const string BrokenCode = """
        <DiagramView Title="Broken on purpose" Language="mermaid" Source="@source" />
        """;
}
