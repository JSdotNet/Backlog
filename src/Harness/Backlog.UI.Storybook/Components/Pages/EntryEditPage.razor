@page "/entry-edit"
@implements IDisposable

<PageTitle>Entry edit — Backlog UI Storybook</PageTitle>

<StoryPage Title="Entry edit"
           Summary="The same markdown as the Markdown chapter, being written rather than read. Everything here is what this product does on top of markdown: an entry auto-saves instead of being saved, a checkbox in the read view writes back into the source, and a `##` heading is a sub-item rather than a heading. Read the Markdown chapter first — that one is about what the blocks look like, this one is about what happens to them."
           Guidelines="@Rules">

    <Story Name="Edit and read"
           Description="Source on the left, read view on the right, one text seen twice. There is no save button on purpose: the product auto-saves, so the indicator under the editor goes Saving then Saved as you type, and renders nothing at all while idle."
           Code="@EditCode">
        <div class="sb-columns">
            <div class="sb-stack">
                <p class="sb-label">Source</p>
                <TextArea Value="@_source"
                          ValueChanged="OnSourceChanged"
                          AriaLabel="Markdown source"
                          Rows="18"
                          AutoGrow="false"
                          TestId="markdown-source" />
                <SaveIndicator State="_save.State" TestId="markdown-save-indicator" />
            </div>
            <div class="sb-stack">
                <p class="sb-label">Read view</p>
                <div data-testid="markdown-preview">
                    <MarkdownView Blocks="_blocks" OnTaskItemToggled="ToggleTask" />
                </div>
            </div>
        </div>
    </Story>

    <Story Name="A checkbox writes back to the source"
           Description="`OnTaskItemToggled` is what turns the read view's checkboxes from state into controls. Tick one and watch the `- [ ]` in the source become `- [x]`: the source is the truth, so a click is a text rewrite. It saves at once with no debounce, because a toggle is a discrete change.

Try ticking a box while the source has a code fence containing one: the `- [ ]` inside the fence never got an index, and `MarkdownPreview.ToggleTask` skips it the same way. Use the index the parser reported rather than counting the checkboxes yourself."
           Code="@ToggleCode">
        <div class="sb-stack" data-testid="entry-edit-toggle">
            <p class="sb-label">Live count from the source above</p>
            <p class="sb-state" data-testid="entry-edit-task-count">@DoneCount of @TaskCount done</p>
        </div>
    </Story>

    <Story Name="A second-level heading is a sub-item"
           Description="This is the one place the parser stops being a markdown parser. Parse reads a body as an entry: a `##` heading and everything under it is folded into an MdSubItem, and the read view renders nothing for those, because the host lays each one out as its own card beside the entry. Only the prose above the first `##` appears here.

That is why the Markdown chapter uses no `##` anywhere — half of each sample would vanish. It is also why FileView calls ParseDocument instead: in a file a `##` is a section heading that people actually wrote, and reading it as an entry swallows most of the file."
           Code="@SubItemCode">
        <div class="sb-columns">
            <div class="sb-stack">
                <p class="sb-label">Source</p>
                <CodeView Source="@SubItemSample" Language="markdown" AllowCopy="false" CssClass="sb-raw__code" />
            </div>
            <div class="sb-stack">
                <p class="sb-label">Parse — as an entry</p>
                <div data-testid="entry-edit-subitems">
                    <MarkdownView Blocks="SubItemBlocks" />
                </div>
                <p class="sb-label">ParseDocument — as a file</p>
                <div data-testid="entry-edit-document">
                    <MarkdownView Blocks="DocumentBlocks" />
                </div>
            </div>
        </div>
    </Story>

    <Story Name="What each reading produced"
           Description="The same source, the two readings side by side. As an entry the `##` and everything under it collapses into one MdSubItem the view skips; as a document it stays an MdHeading with its paragraphs after it.">
        <div class="sb-columns">
            <div class="sb-stack">
                <p class="sb-label">Parse</p>
                <ul class="sb-stack" data-testid="entry-edit-entry-blocks">
                    @foreach (var block in SubItemBlocks)
                    {
                        <li><code>@block.GetType().Name</code></li>
                    }
                </ul>
            </div>
            <div class="sb-stack">
                <p class="sb-label">ParseDocument</p>
                <ul class="sb-stack" data-testid="entry-edit-document-blocks">
                    @foreach (var block in DocumentBlocks)
                    {
                        <li><code>@block.GetType().Name</code></li>
                    }
                </ul>
            </div>
        </div>
    </Story>

</StoryPage>

@code {
    private static readonly DesignGuideline[] Rules =
    [
        new("content-editing.md#editing-model", "What editing canonical markdown in place means."),
        new("content-editing.md#round-trip-fidelity", "What a write has to preserve exactly."),
        new("content-editing.md#task-structure", "What a heading, a task line and a sub-item are in the file."),
        new("interaction-guidelines.md#auto-save-no-save-buttons", "When an edit commits, and what says so.")
    ];

    private const string InitialSource = """
        # Storybook entry

        A paragraph with **bold**, *emphasis*, `inline code`, a #tag and a
        [link to the read view](https://learn.microsoft.com/aspnet/core/blazor).

        # Checklist

        - [x] Move the shared components into Backlog.UI.Components
        - [x] Keep the markdown parser next to the view that renders it
        - [ ] Give every component a story
        - [ ] Drive the storybook from Playwright

        # Notes

        - Plain bullets still work
        - So do #tags in a list

        1. First ordered item
        2. Second ordered item

        > Everything auto-saves. There is no save button anywhere in the product.

        ```markdown
        - [ ] This one is a code sample, and never gets an index.
        ```

        ---

        Anything the parser does not recognise falls through as readable prose.
        """;

    // A `##` heading is a sub-item: the parser folds everything under it into an
    // MdSubItem, and MarkdownView deliberately does not render those because the
    // host lays each one out as its own card.
    private const string SubItemSample = """
        # Visible

        This paragraph renders.

        ## A sub-item

        Everything from the `##` down belongs to the sub-item, so the read view
        leaves it to the host.
        """;

    private string _source = InitialSource;

    /// <summary>Stands in for the real auto-save: Saving while the keystrokes are
    /// still arriving, Saved once they have stopped for 600ms. The save itself
    /// writes nowhere — this page is the host, and this host has no store.</summary>
    private readonly DebouncedSave _save = new(TimeSpan.FromMilliseconds(600), () => Task.CompletedTask);

    // Parsed once per change rather than once per read: the page re-renders on
    // every keystroke, and the fixed samples never change at all.
    private IReadOnlyList<MdBlock> _blocks = MarkdownPreview.Parse(InitialSource);
    private static readonly IReadOnlyList<MdBlock> SubItemBlocks = MarkdownPreview.Parse(SubItemSample);
    private static readonly IReadOnlyList<MdBlock> DocumentBlocks = MarkdownPreview.ParseDocument(SubItemSample);

    /// <summary>Counted off the parsed blocks rather than the raw text, so the
    /// number agrees with what the read view rendered — the fenced `- [ ]` is not
    /// one of these either.</summary>
    private IEnumerable<MdListItem> Tasks => _blocks
        .OfType<MdList>()
        .SelectMany(list => list.Items)
        .Where(item => item.Done is not null);

    private int TaskCount => Tasks.Count();

    private int DoneCount => Tasks.Count(item => item.Done is true);

    /// <summary>The indicator re-renders on the save's own transitions — the one
    /// after the delay arrives outside any event handler.</summary>
    protected override void OnInitialized() =>
        _save.StateChanged += () => InvokeAsync(StateHasChanged);

    private void OnSourceChanged(string value)
    {
        _source = value;
        _blocks = MarkdownPreview.Parse(_source);
        _save.Touch();
    }

    /// <summary>The read view reports which task was clicked; the source stays
    /// the truth, so the click is a text rewrite. MarkdownPreview.ToggleTask
    /// does the counting, because only the code that assigned the index knows
    /// which lines it skipped.
    ///
    /// <para>A toggle is a discrete change, not a stream of keystrokes: there is
    /// nothing to wait for, so it saves at once and drops any typing debounce
    /// still in flight.</para></summary>
    private Task ToggleTask(int taskIndex)
    {
        _source = MarkdownPreview.ToggleTask(_source, taskIndex);
        _blocks = MarkdownPreview.Parse(_source);
        return _save.SaveNowAsync();
    }

    public void Dispose() => _save.Dispose();

    private const string EditCode = """
        <TextArea Value="@_source" ValueChanged="OnSourceChanged" AriaLabel="Markdown source" Rows="18" />
        <SaveIndicator State="_save.State" />

        <MarkdownView Blocks="_blocks" OnTaskItemToggled="ToggleTask" />

        @code {
            // Saving while the keystrokes are still arriving, Saved 600ms after
            // they stop. The library owns the timing; the host owns the save.
            private readonly DebouncedSave _save = new(TimeSpan.FromMilliseconds(600), SaveAsync);

            protected override void OnInitialized() =>
                _save.StateChanged += () => InvokeAsync(StateHasChanged);

            private void OnSourceChanged(string value)
            {
                _source = value;
                _blocks = MarkdownPreview.Parse(_source);
                _save.Touch();
            }

            public void Dispose() => _save.Dispose();
        }
        """;

    private const string ToggleCode = """
        @code {
            private Task ToggleTask(int taskIndex)
            {
                // Never count the checkboxes yourself: the index came from the
                // parser, and only the parser knows which lines it skipped.
                _source = MarkdownPreview.ToggleTask(_source, taskIndex);
                _blocks = MarkdownPreview.Parse(_source);
                return _save.SaveNowAsync();   // discrete change — no debounce
            }
        }
        """;

    private const string SubItemCode = """
        @* An entry: `##` is a sub-item the host lays out, so the view skips it. *@
        <MarkdownView Blocks="@MarkdownPreview.Parse(body)" />

        @* A file: `##` is a heading, and everything under it stays put. *@
        <MarkdownView Blocks="@MarkdownPreview.ParseDocument(body)" />
        """;
}
