@page "/diagrams/c4"

<PageTitle>C4 from Structurizr DSL — Backlog UI Storybook</PageTitle>

<StoryPage Title="C4 from Structurizr DSL"
           Summary="One workspace, authored once in c4hero, explored here. The source below is Structurizr DSL; every picture is produced from it at render time by C4DslReader, C4LayoutEngine and C4SvgWriter — this product's own renderer, not mermaid — and C4Explorer adds the layer c4hero calls Explore — a Views panel over the four levels, drilling in by clicking a box, a breadcrumb, search, the Highlighter, pan and zoom, a minimap and a presentation mode."
           Guidelines="@Rules">

    <Story Name="The explorer"
           Description="Everything on one surface, because exploring is one activity. Start on the landscape and work down: **click a system** to open its container view, **click a container** to open its components. Only the cards that lead somewhere invite the click — the rest keep the pan cursor, because an offer is a promise. Each card is a `g.node` whose id ends in the element's alias, so a click resolves by identifier and never by matching the label text.

Every pointer gesture has a control beside it, which `.devbook/design/accessibility.md` requires and which here is not a concession: clicking a box is discoverable and invisible to a keyboard, so the same moves are the Views panel, the **Drill into** row under the diagram, and the zoom buttons. Unplug the mouse and only the dragging is gone.

The breadcrumb and Back answer different questions on purpose. The breadcrumb is derived from the open view's own scope — *where am I* — and Back walks the history — *how did I get here*. One is not a worse version of the other."
           Code="@ExplorerUsage"
           SourceLabel="workspace.dsl"
           Source="@Workspace"
           SourceLanguage="text">
        <div class="sb-c4-stage">
            <C4Explorer Workspace="@Parsed" Problems="@Parsed.Problems" TestId="sb-c4-explorer" />
        </div>
    </Story>

    <Story Name="The diagram on its own"
           Description="`C4DiagramView` without the explorer around it: the picture, and nothing that navigates it. Hand it the `C4Diagram` that `C4LayoutEngine.Build` lays out from a workspace and a view, an `Id` for the svg and an `AriaLabel`. Everything is drawn by this product — the card, the glyph, the dashed frame, the curved edges — so it takes the stylesheet's tokens rather than writing colours inline, and a level is told apart by weight and glyph rather than by a hue of its own.

Every card is a `g.node` whose id is `<svg id>-<alias>`, which is exactly what the explorer's viewer reads for click-to-drill, dimming and the search ring — so a diagram drawn on its own and one inside the explorer share one DOM contract."
           Code="@DiagramUsage"
           SourceLabel="emitted svg"
           Source="@Emitted"
           SourceLanguage="html">
        <div class="sb-c4-figure">
            <C4DiagramView Diagram="@ContainerDiagram" Id="sb-c4-standalone" AriaLabel="Container Diagram" TestId="sb-c4-diagram" />
        </div>
    </Story>

    <Story Name="The zoom bar, three moments"
           Description="`C4ZoomBar` as the design's Navigation board draws it. **On Context:** step 1 ringed, step 2 already names the system, steps 3 and 4 grey until something is picked. **Desktop selected** on the container view: step 3 now names Desktop App and can be pressed, step 4 still waits for a component. **On Code:** every step behind the reader names its element and works.

A ringed step is where you are, a plain one jumps, and a grey one is a promise that selecting an element fills it in. Step 4 opens only for a component whose building block names its code folders; one with none names the component and stays grey."
           Code="@ZoomBarUsage">
        <div class="sb-c4-zoom-moments">
            <p class="sb-c4-zoom-moments__label">On Context</p>
            <C4ZoomBar State="@OnContext" TestId="sb-c4-zoom-bar-context" />

            <p class="sb-c4-zoom-moments__label">Desktop selected</p>
            <C4ZoomBar State="@DesktopSelected" TestId="sb-c4-zoom-bar-selected" />

            <p class="sb-c4-zoom-moments__label">On Code</p>
            <C4ZoomBar State="@OnCode" TestId="sb-c4-zoom-bar-code" />
        </div>
    </Story>

    <Story Name="The zoom tab"
           Description="`C4ZoomExplorer`, the tab the `c4-zoom` switch offers beside the C4 tab: the same workspace walked **one level at a time**, where the explorer above lists views one by one. It opens on the System context view, and the first time it opens it names the ways to move.

**Select** a card with a click or by tabbing onto it; the zoom bar fills in the element the next level is about. **Zoom in** with a double-click, the card's *Zoom in* chip, or Enter on the focused card. **Zoom out** with an earlier step on the bar, or Backspace — and the element you came out of stays selected. Enter and Backspace are listened for on the diagram's own frame, never on the page, so a key typed anywhere else is never a move.

The chip is the one thing the zoom tab asks of the shared renderer, and it is an option: `C4SvgWriter` draws it only for the cards named in `C4SvgOptions.ZoomInAliases`, which the C4 tab never passes.

Here the Devbook component has code folders, so it carries a chip on the Desktop App components view and step 4 opens its **Code level** — the story below. Shell and Fetch Workers have none: no chip, and step 4 stays grey."
           Code="@ZoomUsage">
        <div class="sb-c4-stage sb-c4-stage--zoom">
            <C4ZoomExplorer Workspace="@Parsed" Problems="@Parsed.Problems" Code="@SampleCode" RecordsFor="@SampleRecords" CrossCuttingDebt="@SampleCrossCuttingDebt" TestId="sb-c4-zoom-explorer" />
        </div>
    </Story>

    <Story Name="The Code level"
           Description="`C4CodeView`, level 4 of the zoom tab: one component's types **drawn from its C# source when it is opened**, never authored (local ADR 0043 §3). Each class box carries its stereotype — the kind with its modifiers and its base list — its name, and its members, the **Public** ones or **All** of them, in UML's marks: + public, # protected, ~ internal, - private. A box lists up to eight members; past eight it lists seven and says how many more there are.

Every use is an arrow, laid out by `C4LayoutEngine` as a relationship is a level up: solid where a type names another, dashed where it inherits it. Pick a box and the panel beside it names the files it is declared in, offers **Open in editor** where the host can open one, and lists the decision records linked to the component — each opens its chapter. Backspace on the picture zooms back out to the components view."
           Code="@CodeUsage">
        <div class="sb-c4-stage sb-c4-stage--zoom">
            <C4CodeView Level="@SampleCodeLevel"
                        OpenInEditor="OpenInEditorAsync"
                        OpenRecord="OpenRecordAsync"
                        TestId="sb-c4-code" />
            <p class="sb-state" data-testid="sb-c4-code-state">@(_codeAction ?? "nothing opened yet")</p>
        </div>
    </Story>

    <Story Name="A dynamic view, step by step"
           Description="`C4DynamicSteps`, the panel the zoom tab sets beside a dynamic view: **Step 2 of 3**, Previous / Play / Next, and every step in order — from → to, what it does, and the technology read from the model relationship between the same two elements, since a dynamic step carries none of its own. Open **Dynamic** under *Also* in the zoom tab above to play it: each arrow carries its number in a badge, and the current step's arrow, badge and row are drawn in the primary colour while the rest stay grey.

Previous is disabled on the first step and Next on the last. Play walks forward and stops on the last step; with reduced motion asked for, it moves one step per press and says so. The badges and the current step are options of `C4SvgWriter` (`NumberSteps`, `CurrentStep`) that the C4 tab never passes."
           Code="@DynamicUsage">
        <C4DynamicSteps Steps="@DynamicSteps" Current="1" TestId="sb-c4-dynamic-steps" />
    </Story>

    <Story Name="The element inspector"
           Description="`C4ElementInspector`, the panel the zoom tab sets beside the picture for the element selected on it — the design's Containers screen: its **kind**, **name**, **technology** and **description**, and *Open its 3 components* when a deeper view exists. Below that, what the knowledge folders say about it, which the host hands in per element through `RecordsFor` because the library has no idea what a chapter is: the arc42 chapters that document a view showing it, the **decisions** that name it with a *proposed* chip on one still proposed, and the **debt** with its severity and rung on the debt ladder. Each opens its record in the Chapters tab.

An element nothing names says so in each section; with no host behind it at all the three sections are left out rather than claiming it has none."
           Code="@InspectorUsage">
        <div class="sb-c4-zoom-moments">
            <p class="sb-c4-zoom-moments__label">Desktop App selected</p>
            <C4ElementInspector Element="@DesktopApp" ZoomLabel="Open its 3 components" Records="@DesktopRecords" TestId="sb-c4-element-inspector" />

            <p class="sb-c4-zoom-moments__label">An element nothing names</p>
            <C4ElementInspector Element="@LocalTaskStore" Records="@C4ElementRecords.None" TestId="sb-c4-element-inspector-none" />
        </div>
    </Story>

    <Story Name="The record overlays"
           Description="The **Overlay** switch in the zoom tab's head: None, Decisions or Debt, one choice, kept as the reader zooms. **Decisions** puts an *n ADR* chip on each card that decision records name; **Debt** puts an *n TDR* chip on each card that open debt names — debt not yet `resolved` — and draws that card on the `color-error` surface. The counts come from the same `RecordsFor` the inspector reads, so a card and its inspector never disagree.

Under the picture, a line counts the overlay's records that name no element on the view but one nested below it — the ones a reader finds by zooming in. With Debt on, the **cross-cutting tray**, `C4CrossCuttingDebt`, lists the open debt that names no element at all, which has no card to sit on; each opens its record. The chips are an option of `C4SvgWriter` (`C4SvgOptions.RecordChips`) that the C4 tab never passes. Pick an overlay in the zoom tab above to see it live; below, the Desktop App components view as Debt draws it."
           Code="@OverlayUsage">
        <div class="sb-c4-zoom-moments">
            <p class="sb-c4-zoom-moments__label">Debt on the Desktop App components view</p>
            <div class="sb-c4-stage">
                <C4DiagramView Diagram="@ComponentsDiagram" Id="sb-c4-overlay" AriaLabel="Components with the Debt overlay" Options="@DebtOverlayOptions" TestId="sb-c4-overlay-diagram" />
            </div>

            <p class="sb-c4-zoom-moments__label">The cross-cutting tray</p>
            <C4CrossCuttingDebt Records="@SampleCrossCuttingDebt" TestId="sb-c4-cross-cutting" />
        </div>
    </Story>

    <Story Name="A deployment view"
           Description="On a deployment view the zoom tab puts the scope's environments behind **one tab list**, and draws every other environment as a **dashed door** naming what runs there; opening the door is the same move as its tab. Open *Deployment* under Also in the zoom tab above to walk it: Local machine and Staging.

A deployment node is drawn as the frame round what it runs, and on the zoom tab the frame is **selectable**: `C4SvgWriter` writes it as a `g.node` for the frames named in `C4SvgOptions.SelectableBoundaryAliases`, which the C4 tab never sets. Selecting one opens the element inspector below — the same panel every element opens — headed with its kind, technology and description, and listing the container instances it runs, each with *Show in containers*, which opens the container view with that container selected."
           Code="@DeploymentUsage">
        <div class="sb-c4-zoom-moments">
            <p class="sb-c4-zoom-moments__label">The door from Local machine</p>
            <C4DeploymentDoors Doors="@StagingDoor" TestId="sb-c4-deployment-doors" />

            <p class="sb-c4-zoom-moments__label">MSIX package selected</p>
            <C4ElementInspector Element="@MsixPackageNode" Deployment="@MsixPackage" TestId="sb-c4-deployment-inspector" />
        </div>
    </Story>

    <Story Name="Inside running text"
           Description="`Inline` makes the host a span, for a diagram drawn inside a paragraph — where a chapter's `![…](c4:<view key>)` embed was written. A div there is invalid, and an HTML parser closes the paragraph on it. The span is a block the width of the text and as tall as the picture's aspect ratio makes it, where the default host fills its frame for the explorer to pan and zoom."
           Code="@InlineUsage">
        <p>
            The containers, as the chapter embeds them:
            <C4DiagramView Diagram="@ContainerDiagram" Id="sb-c4-inline" AriaLabel="Container Diagram" Inline="true" TestId="sb-c4-inline" />
        </p>
    </Story>

    <Story Name="What a level means"
           Description="`include *` does not mean every element in the model — it means the default set for that kind of view, which is what keeps a container view of one system from being a drawing of all of them. All people and top-level systems for a landscape; the scope plus its direct neighbours for a context; the scope's own containers plus the neighbours of those, with other systems left closed, for a container view.

Drilling is offered only where a view exists to drill to. c4hero picks a level and frames it; this reader cannot invent a view the workspace never declared, so a system with no container view gets no drill affordance — an offer is a promise."
           Code="@LevelsCode"
           Language="csharp">
        <DataTable TItem="LevelRow"
                   Columns="@LevelColumns"
                   Items="@LevelRows"
                   AriaLabel="What each level draws"
                   RowNoun="level"
                   TestId="sb-c4-levels">
            <Row>
                <td>@context.Level</td>
                <td>@context.Mermaid</td>
                <td>@context.Draws</td>
            </Row>
        </DataTable>
    </Story>

    <Story Name="The Highlighter's four facets"
           Description="Tag, technology, team and status — and only the ones **the open view actually draws**, so no chip is a dead option that dims the whole diagram. The values below are the container view's; drill into a component and they change, because the picture did.

A facet with nothing in it is absent rather than an empty dropdown, so a view that names no owner gets no Team facet at all.

Team and status come from an element's `properties` block, which is where c4hero keeps what Structurizr has no field for. Several spellings are accepted for each (`owner`, `team`, `Owner`) because there is no standard key and asking for one would silently find nothing.

Across facets it is AND and within a facet it is OR, which is what lets it answer a real question: the containers owned by either of two teams that are also .NET. Non-matching elements are dimmed rather than hidden — the shape of the diagram stays readable, and the match reads as an emphasis instead of a different picture."
           Code="@FacetsCode"
           Language="csharp">
        <DataTable TItem="C4FacetSummary"
                   Columns="@FacetColumns"
                   Items="@FacetRows"
                   AriaLabel="Facets found in this workspace"
                   RowNoun="facet"
                   TestId="sb-c4-facets">
            <Row>
                <td>@context.Facet</td>
                <td>@context.Values</td>
            </Row>
        </DataTable>
    </Story>

    <Story Name="What could not be read"
           Description="The reader never guesses. This workspace opens with an `!include` directive, which pulls in content it has no way to honour, and names an element that does not exist — so both are reported with the line they were on, and the rest of the file is still read.

That behaviour is the whole safeguard. This reader is a second implementation of a dialect whose first implementation is c4hero's own TypeScript parser, in another repository, where no test here can compare the two. The failure that matters is not a workspace that will not open; it is one that opens, draws a confident picture, and silently leaves out whatever could not be parsed. In the app this list appears under the diagram."
           Code="@Unreadable"
           Language="text"
           SourceLabel="partly-readable.dsl">
        <CodeView Source="@Unreadable" Language="text" Title="partly-readable.dsl" ShowLineNumbers="true" />

        <DataTable TItem="C4Problem"
                   Columns="@ProblemColumns"
                   Items="@C4DslReader.Read(Unreadable).Problems"
                   AriaLabel="What the reader could not read"
                   RowNoun="problem"
                   TestId="c4-problems">
            <Row>
                <td>@context.Line</td>
                <td><code>@context.Construct</code></td>
                <td>@context.Message</td>
            </Row>
        </DataTable>
    </Story>
</StoryPage>

@code {
    private static readonly DataTableColumn[] ProblemColumns = [new("Line"), new("Construct"), new("Message")];

    private static readonly DataTableColumn[] LevelColumns = [new("Level"), new("Mermaid"), new("Draws")];

    private static readonly DataTableColumn[] FacetColumns = [new("Facet"), new("Values in this workspace")];

    private static readonly DesignGuideline[] Rules =
    [
        new("component-libraries.md#c4-workspaces", "How a C4 view is expected to behave inside a devbook section — its own tab, both directions of the reference drawn, and saying what it could not read."),
        new("component-libraries.md#diagram-and-graph-strategy", "Which renderer draws which kind of picture, and why a C4 view is the one case this product draws itself."),
        new("accessibility.md#target-sizes-and-text", "Why every pointer gesture here has a control beside it. A box in an SVG is not a focusable target, so clicking to drill in cannot be the only way to drill in."),
        new("color-scheme.md#chart-roles", "One saturated hue, by rule — which is why a C4 level is told apart by weight and glyph here rather than by a hue of its own.")
    ];

    private const string DiagramUsage = """
        <C4DiagramView Diagram="@C4LayoutEngine.Build(workspace, view)"
                       Id="@svgId"
                       AriaLabel="@C4Exploration.Label(workspace, view)" />
        """;

    private const string InlineUsage = """
        <p>
            <C4DiagramView Diagram="@C4LayoutEngine.Build(workspace, view)"
                           Id="@svgId"
                           AriaLabel="@caption"
                           Inline="true" />
        </p>
        """;

    /// <summary>
    /// Parsed once and held, unlike the earlier version of this page which re-read
    /// the DSL on every access. The explorer is handed the workspace as a parameter
    /// and compares it to decide whether to re-derive its views, so a fresh record
    /// per render would have reset the reader's position on every keystroke.
    /// </summary>
    private static readonly C4Workspace Parsed = C4DslReader.Read(Workspace);

    /// <summary>
    /// Laid out once, lazily.
    /// <para>
    /// Lazy as well as declared after <c>Parsed</c>, because it reads it. Static
    /// fields initialise in declaration order, and the first version of this sat above
    /// <c>Parsed</c> and threw a <c>NullReferenceException</c> out of the type
    /// initialiser on the very first request. The order is now right and the laziness
    /// means reordering these lines cannot bring that back.
    /// </para>
    /// </summary>
    private static readonly Lazy<C4Diagram> LazyContainerDiagram = new(() =>
    {
        var view = Parsed.View("containers-backlog");

        // The sample declares it, so its absence would mean the DSL above was edited
        // and this story quietly lost its subject. Better to say so than to draw the
        // empty-view placeholder and look like the renderer failed.
        ArgumentNullException.ThrowIfNull(view, "The storybook workspace no longer declares 'containers-backlog'.");

        return C4LayoutEngine.Build(Parsed, view);
    });

    private static C4Diagram ContainerDiagram => LazyContainerDiagram.Value;

    private static readonly Lazy<string> LazyEmitted =
        new(() => C4SvgWriter.Write(ContainerDiagram, "sb-c4-standalone", "Container Diagram"));

    private static string Emitted => LazyEmitted.Value;

    private const string ExplorerUsage = """
        <C4Explorer Workspace="@workspace"
                    Problems="@problems"
                    ViewKey="@_viewKey"
                    ViewKeyChanged="key => _viewKey = key"
                    ViewFooter="@ViewReferences" />
        """;

    private const string ZoomUsage = """
        <C4ZoomExplorer Workspace="@workspace"
                        Problems="@problems"
                        HintDismissed="@preferences.C4ZoomHintDismissed"
                        OnHintDismissed="preferences.DismissC4ZoomHint" />
        """;

    private const string DynamicUsage = """
        <C4DynamicSteps Steps="@C4DynamicPlayback.Steps(workspace, view)"
                        Current="@stepIndex"
                        Playing="@playing"
                        ReducedMotion="@reducedMotion"
                        OnPrevious="Previous"
                        OnNext="Next"
                        OnPlay="Play"
                        OnPick="Pick" />
        """;

    /// <summary>The sample's dynamic view, as the zoom tab's steps panel lists it.</summary>
    private static IReadOnlyList<C4PlaybackStep> DynamicSteps =>
        C4DynamicPlayback.Steps(Parsed, Parsed.View("capture-to-issue")!);

    private const string InspectorUsage = """
        <C4ZoomExplorer Workspace="@workspace"
                        RecordsFor="@(elementId => C4ElementInspection.For(c4, workspaceEntry, chapters, elementId))"
                        OnOpenRecord="OpenInChapters" />
        """;

    private static readonly C4Element DesktopApp = Parsed.Element("backlog.desktop")!;
    private static readonly C4Element LocalTaskStore = Parsed.Element("backlog.store")!;
    private static readonly C4Element MsixPackageNode = Parsed.Element("pc.msix")!;

    /// <summary>What a host might say about Desktop App: a sample, not this
    /// repository's own records.</summary>
    private static readonly C4ElementRecords DesktopRecords = new(
        [
            new C4InspectorChapter(".devbook/arc42/03-context-and-scope.md", "03", "Context and scope › Access channels"),
            new C4InspectorChapter(".devbook/arc42/05-building-block-view.md", "05", "Building block view")
        ],
        [
            new C4InspectorRecord(".devbook/arc42/adr/0001-desktop-channel.md", "0001", "Desktop channel uses .NET MAUI Blazor Hybrid", C4InspectorRecordKind.Decision),
            new C4InspectorRecord(".devbook/arc42/adr/0030-stored-credentials.md", "0030", "Stored credentials go through the OS envelope", C4InspectorRecordKind.Decision, Proposed: true)
        ],
        [
            new C4InspectorRecord(".devbook/arc42/tdr/0001-branch-snapshots.md", "0001", "Artifacts are invisible on a branch snapshot", C4InspectorRecordKind.Debt, Severity: "Medium", Lifecycle: "identified")
        ]);

    private const string OverlayUsage = """
        <C4ZoomExplorer Workspace="@workspace"
                        RecordsFor="@(elementId => C4ElementInspection.For(c4, workspaceEntry, chapters, elementId))"
                        CrossCuttingDebt="@C4ElementInspection.CrossCuttingDebt(c4, chapters)"
                        OnOpenRecord="OpenInChapters" />
        """;

    /// <summary>What a host might say about each element of the sample: Desktop App
    /// as the inspector story shows it, one open debt on the Devbook component and a
    /// decision on Shell. A sample, not this repository's own records.</summary>
    private static C4ElementRecords SampleRecords(string elementId) => elementId switch
    {
        "backlog.desktop" => DesktopRecords,
        DevbookComponent => new C4ElementRecords([], [],
        [
            new C4InspectorRecord(".devbook/arc42/tdr/0001-branch-snapshots.md", "0001", "Artifacts are invisible on a branch snapshot", C4InspectorRecordKind.Debt, Severity: "Medium", Lifecycle: "identified")
        ]),
        "backlog.desktop.shell" => new C4ElementRecords([],
        [
            new C4InspectorRecord(".devbook/arc42/adr/0022-one-main-view.md", "0022", "The shell shows one main view", C4InspectorRecordKind.Decision)
        ], []),
        _ => C4ElementRecords.None
    };

    /// <summary>Open debt that names no element, as the Debt overlay's tray lists it.</summary>
    private static readonly IReadOnlyList<C4InspectorRecord> SampleCrossCuttingDebt =
    [
        new C4InspectorRecord(".devbook/arc42/tdr/0002-conventions.md", "0002", "Coding and testing conventions have no checked-in home", C4InspectorRecordKind.Debt, Severity: "Medium", Lifecycle: "identified"),
        new C4InspectorRecord(".devbook/arc42/tdr/0003-zero-warning.md", "0003", "The devbook check is not a zero-warning signal", C4InspectorRecordKind.Debt, Severity: "Low", Lifecycle: "planned")
    ];

    private static readonly Lazy<C4Diagram> LazyComponentsDiagram =
        new(() => C4LayoutEngine.Build(Parsed, Parsed.View("components-desktop")!));

    private static C4Diagram ComponentsDiagram => LazyComponentsDiagram.Value;

    /// <summary>The Desktop App components view as the Debt overlay draws it.</summary>
    private static readonly C4SvgOptions DebtOverlayOptions = new()
    {
        RecordChips = new Dictionary<string, C4CardRecords> { [C4MermaidWriter.AliasOf(DevbookComponent)] = new(0, 1) }
    };

    private const string DeploymentUsage = """
        <C4DeploymentDoors Doors="@doors" OnOpen="OpenEnvironment" />
        <C4ElementInspector Element="@workspace.Element(selectedElementId)!"
                            Deployment="@C4ZoomDeployment.Details(workspace, selectedElementId)"
                            OnOpenContainer="OpenContainer" />
        """;

    /// <summary>The doors the Local machine view draws: Staging.</summary>
    private static readonly IReadOnlyList<C4DeploymentEnvironment> StagingDoor =
        [.. C4ZoomDeployment.Environments(Parsed, Parsed.View("deployment-local")!).Where(environment => !environment.Current)];

    /// <summary>The inspector of the MSIX package node.</summary>
    private static readonly C4DeploymentNodeDetails MsixPackage = C4ZoomDeployment.Details(Parsed, "pc.msix")!;

    private const string ZoomBarUsage = """
        <C4ZoomBar State="@C4ZoomNavigation.Bar(workspace, view, selectedElementId)"
                   OnStep="OpenStep"
                   OnAlso="OpenAlso" />
        """;

    /// <summary>The design's first moment: the context view, nothing selected.</summary>
    private static C4ZoomBarState OnContext =>
        C4ZoomNavigation.Bar(Parsed, Parsed.View("context-backlog")!, null);

    /// <summary>The second: the container view with Desktop App selected.</summary>
    private static C4ZoomBarState DesktopSelected =>
        C4ZoomNavigation.Bar(Parsed, Parsed.View("containers-backlog")!, "backlog.desktop");

    /// <summary>The third: on the Code level of the Devbook component, the one
    /// component of the sample with code folders.</summary>
    private static C4ZoomBarState OnCode =>
        C4ZoomNavigation.Bar(Parsed, Parsed.View("components-desktop")!, DevbookComponent, HasCode, codeOpen: true);

    private const string DevbookComponent = "backlog.desktop.devbook";

    private static bool HasCode(string elementId) => string.Equals(elementId, DevbookComponent, StringComparison.OrdinalIgnoreCase);

    /// <summary>What the zoom tab is handed for the sample: the Devbook component's code
    /// is the level below, and nothing else has any.</summary>
    private C4ZoomCode SampleCode => _sampleCode ??= new C4ZoomCode(HasCode, (_, _) => Task.FromResult(SampleCodeLevel))
    {
        OpenInEditor = OpenInEditorAsync,
        OpenRecord = OpenRecordAsync
    };

    private C4ZoomCode? _sampleCode;
    private string? _codeAction;

    private Task<string?> OpenInEditorAsync(string path)
    {
        _codeAction = $"open in editor: {path}";
        StateHasChanged();
        return Task.FromResult<string?>(null);
    }

    private Task OpenRecordAsync(C4CodeRecord record)
    {
        _codeAction = $"open record: {record.Path}";
        StateHasChanged();
        return Task.CompletedTask;
    }

    private const string CodeUsage = """
        <C4ZoomExplorer Workspace="@workspace" Code="@code" />

        // A component has code when its building block names folders; the level
        // is read from the source each time it is opened.
        var code = new C4ZoomCode(
            elementId => catalog.CodeOf(elementId).Count > 0,
            (elementId, token) => reader.LoadAsync(catalog, elementId, token))
        {
            OpenInEditor = path => OpenAsync(path),
            OpenRecord = record => OpenChapterAsync(record.Path)
        };
        """;

    /// <summary>The design's Code screen: the build path of the Devbook component.</summary>
    private static readonly C4CodeLevel SampleCodeLevel = new(
        "Devbook",
