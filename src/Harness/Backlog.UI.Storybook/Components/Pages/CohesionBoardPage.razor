    private static CohesionEdge E(string from, string to, string? label, double labelX, double labelY, CohesionEdgeKind kind, bool dashed, params (double X, double Y)[] points) =>
        new(from, to, kind, dashed, label, [.. points.Select(point => new CohesionPoint(point.X, point.Y))], new CohesionPoint(labelX, labelY));

