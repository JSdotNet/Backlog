@page "/devbook/cohesion"

<PageTitle>Cohesion board — Backlog UI Storybook</PageTitle>

<StoryPage Title="Cohesion board"
           Summary="CohesionBoard: the board the AI section's Cohesion tab draws — how the usages form a whole. The stages are lanes with the pull-request marker between Verify and Integrate, the layers bands beneath; every usage is a box styled by its rung, with a clock when a schedule runs it, and the hand-offs between them are arrows. Four ways to read it, a panel saying what feeds a picked usage, and the platforms the usages are built on. The graph is handed in laid out; the samples below are a cut of the `.devbook/ai/` record placed by hand on the Cohesion layout's grid."
           Guidelines="@Rules">

    <Story Name="Hand-offs"
           Description="The board at rest: every hand-off between usages, solid when the work is handed on, dashed when a candidate would hand it on, red for the loop from production that is still open. Support links stay hidden until a usage is picked.

The boxes are real buttons named by usage, rung, schedule and place — Scheduled merge review reads as trial, scheduled, Integrate."
           Code="@HandOffsCode">
        <CohesionBoard Graph="@Graph" View="CohesionView.HandOffs" OnOpenUsage="_ => { }" TestId="cohesion-hand-offs" />
    </Story>

    <Story Name="Forward"
           Description="Only the hand-offs that move the work to a later stage are lit, with their labels, and each usage they join is numbered by its stage. A hand-off within one stage — the agreed spec becoming import plans — is neither forward nor back, so it dims."
           Code="@ForwardCode">
        <CohesionBoard Graph="@Graph" View="CohesionView.Forward" OnOpenUsage="_ => { }" TestId="cohesion-forward" />
    </Story>

    <Story Name="What feeds back"
           Description="The hand-offs that come back: to an earlier stage — the alerts that would enter Decide, the security review that would open issues — or out of a layer, as the upkeep schedule's pull requests do when they land at the Personal Validation gate."
           Code="@FeedsBackCode">
        <CohesionBoard Graph="@Graph" View="CohesionView.FeedsBack" OnOpenUsage="_ => { }" TestId="cohesion-feeds-back" />
    </Story>

    <Story Name="Everything"
           Description="Every hand-off plus the support links, dotted: here the worktree every session runs in, under the code gate."
           Code="@EverythingCode">
        <CohesionBoard Graph="@Graph" View="CohesionView.Everything" OnOpenUsage="_ => { }" TestId="cohesion-everything" />
    </Story>

    <Story Name="A usage picked"
           Description="SelectedId handed in: the usage and its neighbours stay lit, its links carry their labels — a support link included — and the panel lists what feeds it, what it hands on to and what it is built on, with its chapter one click away. Picking it again, or Clear, puts the board back at rest."
           Code="@PickedCode">
        <CohesionBoard Graph="@Graph" SelectedId="gate" OnOpenUsage="_ => { }" TestId="cohesion-picked" />
    </Story>

    <Story Name="A platform picked"
           Description="SelectedPlatformId handed in: the usages built on the platform are lit and the panel names them. The number on each platform is how many usages depend on it."
           Code="@PlatformCode">
        <CohesionBoard Graph="@Graph" SelectedPlatformId="schedule" TestId="cohesion-platform" />
    </Story>
</StoryPage>

@code {
    private static readonly DesignGuideline[] Rules =
    [
        new("color-scheme.md#badge-and-chip-tones", "What each rung's colour on a usage's box means."),
        new("interaction-guidelines.md#focus-and-selection", "What a picked usage and the links it lights look like."),
        new("accessibility.md#contrast", "Why a dimmed box keeps its words at full contrast and only its surface goes quiet.")
    ];

    private const double W = 196;
    private const double H = 66;

    private static double Col(int column) => 40 + 226 * column;

    private static CohesionNode N(string id, string name, string status, int stage, string where, double y, bool scheduled, params string[] platforms) =>
