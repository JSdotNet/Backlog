@page "/integrations/connectors"

<PageTitle>Connectors — Backlog UI Storybook</PageTitle>

<StoryPage Title="Connectors"
           Summary="ConnectorCard: one outside tool that tasks can follow, as the settings screen lists it — its mark and name, who is signed in, and what has been connected through it. Every value is handed in and every act is a callback, so the tools below are stubs with no application behind them."
           Guidelines="@Rules">

    <Story Name="Signed in, with targets"
           Description="The usual card. The switch pauses a target without losing its tasks, Remove forgets it, and the field adds another. The host checks what was typed: a blank name or one already connected comes back as `AddError` under the field, and the draft stays as typed so it can be fixed rather than retyped.

Try it — the stub keeps what you add, switch and remove for as long as the page is open."
           Code="@SignedInCode">
        <ConnectorCard Name="Tracker"
                       Icon="◆"
                       ColorToken="color-primary"
                       SignsIn="true"
                       AccountName="Sam Reviewer"
                       OnSignOut="EchoSignOut"
                       Targets="@_targets"
                       OnTargetEnabledChanged="SetEnabled"
                       OnRemoveTarget="Remove"
                       AddDraft="@_draft"
                       AddDraftChanged="value => _draft = value"
                       AddError="@_addError"
                       OnAddTarget="Add"
                       TestId="connectors-signed-in" />
        <p class="sb-state" data-testid="connectors-echo">@_echo</p>
    </Story>

    <Story Name="Signed out"
           Description="A tool that signs in and has nobody signed in. Sign in is busy while the host waits on the sign-in — a browser window, in the real app — and cannot be pressed twice. The stub signs in after a moment."
           Code="@SignedOutCode">
        <ConnectorCard Name="Tracker"
                       Icon="◆"
                       ColorToken="color-primary"
                       SignsIn="true"
                       AccountName="@_account"
                       SigningIn="@_signingIn"
                       OnSignIn="SignInAsync"
                       OnSignOut="() => _account = null"
                       Targets="@NoTargets"
                       TestId="connectors-signed-out" />
    </Story>

    <Story Name="A sign-in that did not work"
           Description="The host's own sentence for what went wrong, under the head as an alert: it happened because somebody pressed something."
           Code="@FailedCode">
        <ConnectorCard Name="Tracker"
                       Icon="◆"
                       ColorToken="color-primary"
                       SignsIn="true"
                       SignInError="The sign-in window was closed before it finished."
                       Targets="@NoTargets"
                       TestId="connectors-sign-in-failed" />
    </Story>

    <Story Name="A tool with no sign-in"
           Description="A connector that reaches its source without a person — a token the host already holds — has no account line and no button. Only its targets are drawn."
           Code="@NoSignInCode">
        <ConnectorCard Name="Issues"
                       Icon="●"
                       ColorToken="color-info"
                       Targets="@IssueTargets"
                       TestId="connectors-no-sign-in" />
    </Story>

    <Story Name="No tool registered"
           Description="The settings page draws one card per registered connector. With none, it says so with an `EmptyState` rather than leaving the page blank."
           Code="@EmptyCode">
        <EmptyState Title="No connectors"
                    Description="Nothing in this version can bring in tasks from another tool yet."
                    TestId="connectors-none" />
    </Story>
</StoryPage>

@code {
    private static readonly DesignGuideline[] Rules =
    [
        new("color-scheme.md#integration-roles", "The quiet ink the account line and the last sync are drawn in."),
        new("interaction-guidelines.md#error-states", "What a refused add and a failed sign-in show, and where."),
        new("interaction-guidelines.md#empty-states", "What a page with no tool and a tool with no target say instead.")
    ];

    private static readonly IReadOnlyList<ConnectorTargetRow> NoTargets = [];

    private static readonly IReadOnlyList<ConnectorTargetRow> IssueTargets =
    [
        new("acme/website", Enabled: true, LastSynced: "5 Oct, 09:12")
    ];

    private List<ConnectorTargetRow> _targets =
    [
        new("planning", Enabled: true, LastSynced: "5 Oct, 09:12"),
        new("platform", Enabled: false, LastSynced: "2 Oct, 16:40"),
        new("research", Enabled: true)
    ];

    private string? _draft;
    private string? _addError;
    private string? _echo;

    private string? _account;
    private bool _signingIn;

    private void EchoSignOut() => _echo = "Sign out pressed — the host forgets the account.";

    private void SetEnabled(ConnectorTargetRow row) =>
        _targets = [.. _targets.Select(target => target.Name == row.Name ? row : target)];

    private void Remove(ConnectorTargetRow row) =>
        _targets = [.. _targets.Where(target => target.Name != row.Name)];

    private void Add()
    {
        var name = _draft?.Trim() ?? string.Empty;

        if (name.Length == 0)
        {
            _addError = "Type what to connect first.";
            return;
        }

        if (_targets.Any(target => string.Equals(target.Name, name, StringComparison.OrdinalIgnoreCase)))
        {
            _addError = $"{name} is already connected.";
            return;
        }

        _targets = [.. _targets, new ConnectorTargetRow(name, Enabled: true)];
        _addError = null;
        _draft = string.Empty;
    }

    private async Task SignInAsync()
    {
        _signingIn = true;
        await Task.Delay(1200);
        _signingIn = false;
        _account = "Sam Reviewer";
    }

    private const string SignedInCode = """
        <ConnectorCard Name="@descriptor.DisplayName"
                       Icon="@descriptor.Icon"
                       ColorToken="@descriptor.ColorToken"
                       SignsIn="true"
                       AccountName="@account?.DisplayName"
                       OnSignOut="SignOutAsync"
                       Targets="@rows"
                       OnTargetEnabledChanged="SetEnabled"
                       OnRemoveTarget="Remove"
                       AddDraft="@draft"
                       AddDraftChanged="value => draft = value"
                       AddError="@addError"
                       OnAddTarget="Add" />
        """;

    private const string SignedOutCode = """
        <ConnectorCard Name="Tracker"
                       Icon="◆"
                       ColorToken="color-primary"
                       SignsIn="true"
                       AccountName="@null"
                       SigningIn="@signingIn"
                       OnSignIn="SignInAsync"
                       Targets="@([])" />
        """;

    private const string FailedCode = """
        <ConnectorCard Name="Tracker"
                       SignsIn="true"
                       SignInError="The sign-in window was closed before it finished."
                       Targets="@([])" />
        """;

    private const string NoSignInCode = """
        <ConnectorCard Name="Issues"
                       Icon="●"
                       ColorToken="color-info"
                       Targets="@rows" />
        """;

    private const string EmptyCode = """
        <EmptyState Title="No connectors"
                    Description="Nothing in this version can bring in tasks from another tool yet." />
        """;
}
