@page "/app-shell"
@page "/app-shell/{Tab}"

<PageTitle>App shell — Backlog UI Storybook</PageTitle>

<StoryPage Title="App shell"
           Summary="The desktop header's navigation — the Inbox, the view switch, the Devbook, then the takeovers — and on the phone, TabBar and SyncStatusLine: the row of destinations along the bottom, and the line in its title bar that says where sync stands."
           Guidelines="@Rules">

    <Story Name="Desktop header navigation"
           Description="The desktop header's nav, left to right: the Inbox toggle, the view switch, the Devbook toggle, then the work in progress and the other takeovers. The view switch is a fused ButtonGroup of ToggleButtons with exactly one pressed — a view is replaced, never closed, so pressing the pressed one changes nothing. The Inbox and the Devbook are standalone toggles, and each takes the whole screen in place of the view: pressing it again returns to the view, which waited underneath. Escape closes the Devbook as it closes the other takeovers, but stays with the Inbox's own keys. The work in progress group is led by Goals, a view that summarises the two lists after it; Sessions and Pull requests are one context's two lists, fused with it. Goals is always offered, whether or not those two lists are. Dashboard and Tools stand loose.

Each view and work-in-progress option leads with a glyph from the library's Icons folder. The glyph is decorative and hidden from assistive technology, so each option's name is still its word.

The sample is live: pick a view, or press the Inbox, the Devbook or a takeover — the line under it says what the shell would show. Board lays the Tasks rows out in columns and Calendar by due date, on a month or a week as the calendar's Month | Week range says."
           Code="@HeaderCode">
        <nav class="sb-header-nav" aria-label="Workspace views" data-testid="sb-header-nav">
            <div class="sb-header-nav__workspace">
                <ToggleButton Pressed="@(_takeover == InboxTakeover)" OnClick="() => ToggleTakeover(InboxTakeover)" TestId="sb-inbox-toggle">Inbox</ToggleButton>
                <ButtonGroup AriaLabel="View" TestId="sb-view-switch">
                    <ToggleButton Pressed="@ViewPressed("Tasks")" OnClick="@(() => ShowView("Tasks"))"><ListIcon />Tasks</ToggleButton>
                    <ToggleButton Pressed="@ViewPressed("Board")" OnClick="@(() => ShowView("Board"))"><Columns3Icon />Board</ToggleButton>
                    <ToggleButton Pressed="@ViewPressed("Calendar")" OnClick="@(() => ShowView("Calendar"))"><CalendarIcon />Calendar</ToggleButton>
                    <ToggleButton Pressed="@ViewPressed("Roadmap")" OnClick="@(() => ShowView("Roadmap"))"><ChartGanttIcon />Roadmap</ToggleButton>
                </ButtonGroup>
                <ToggleButton Pressed="@(_takeover == DevbookTakeover)" OnClick="() => ToggleTakeover(DevbookTakeover)" TestId="sb-devbook-toggle">Devbook</ToggleButton>
            </div>
            @* Goals leads the group though it is a view, not a takeover: it is the
               summary the two lists are behind, so a press shows it as a view. *@
            <ButtonGroup AriaLabel="Work in progress" TestId="sb-work-in-progress">
                <ToggleButton Pressed="@ViewPressed("Goals")" OnClick="@(() => ShowView("Goals"))"><TargetIcon />Goals</ToggleButton>
                <ToggleButton Pressed="@(_takeover == "Sessions")" OnClick="@(() => ToggleTakeover("Sessions"))"><SquareTerminalIcon />Sessions</ToggleButton>
                <ToggleButton Pressed="@(_takeover == "Pull requests")" OnClick="@(() => ToggleTakeover("Pull requests"))"><GitPullRequestIcon />Pull requests</ToggleButton>
            </ButtonGroup>
            <div class="sb-row" role="group" aria-label="Surface">
                @foreach (var takeover in Surfaces)
                {
                    <ToggleButton Pressed="@(_takeover == takeover)" OnClick="() => ToggleTakeover(takeover)">@takeover</ToggleButton>
                }
            </div>
        </nav>
        <p class="sb-state" data-testid="sb-header-state">@HeaderState</p>
    </Story>

    <Story Name="Tab bar"
           Description="One link per destination, each a route of its own, so the Router and the back button already understand it. NavLink decides which tab is lit — the root route is given Match: true, or it would match every path as a prefix.

The tabs below are live: this page answers /app-shell/inbox and /app-shell/notes too, so tapping one moves the lit tab and the address together."
           Code="@TabBarCode">
        <div class="sb-phone">
            <TabBar Items="Tabs" AriaLabel="Sections" TestId="tab-bar" />
        </div>
    </Story>

    <Story Name="Tab bar with glyphs"
           Description="The phone's own bar, as a paired phone that holds a stand-up draws it: Today, Inbox, Stand-up and Notes, each with its glyph above its word — a sun, an inbox tray, a target and a sticky note. Every tab carries one or none does, so no tab reads as the odd one out. The glyph is decorative and hidden from assistive technology, so each tab's name is still its word, and it takes the word's ink, so the lit tab's glyph lights with it. The tab is still at least 48px tall.

These tabs are live too: tapping Stand-up opens /app-shell/standup and lights it."
           Code="@GlyphTabBarCode">
        <div class="sb-phone">
            <TabBar Items="GlyphTabs" AriaLabel="Sections" TestId="tab-bar-glyphs" />
        </div>
    </Story>

    <Story Name="Not paired"
           Description="The device holds no credential, so there is nothing to sync with. The host shows this until a pairing code is redeemed."
           Code="@NotPairedCode">
        <SyncStatusLine Reading="SyncStatusReading.NotPaired" TestId="sync-not-paired" />
    </Story>

    <Story Name="Synced"
           Description="Paired, and the service last answered this long ago. Now is fixed here so the sample reads the same every time; a host leaves it unset and the line reads the clock."
           Code="@SyncedCode">
        <SyncStatusLine Reading="SyncStatusReading.Synced(At.AddMinutes(-3))" Now="At" TestId="sync-synced" />
    </Story>

    <Story Name="Not synced yet"
           Description="Paired, and nothing has come back from the service since. A reading with no time says so rather than inventing one."
           Code="@NotSyncedCode">
        <SyncStatusLine Reading="SyncStatusReading.Synced(null)" Now="At" TestId="sync-never" />
    </Story>

    <Story Name="Offline"
           Description="Paired, and the service cannot be reached. The count is what is queued for when it can."
           Code="@OfflineCode">
        <SyncStatusLine Reading="SyncStatusReading.Offline(2)" Now="At" TestId="sync-offline" />
    </Story>

</StoryPage>

@code {
    /// <summary>The tab this page was opened on, from /app-shell/{Tab}. Unused
    /// beyond making the route resolve: NavLink reads the address itself.</summary>
    [Parameter]
    public string? Tab { get; set; }

    private static readonly DateTimeOffset At = new(2026, 9, 25, 9, 30, 0, TimeSpan.Zero);

    private static readonly IReadOnlyList<NavItem> Tabs =
    [
        new("app-shell", "Today", Match: true),
        new("app-shell/inbox", "Inbox"),
        new("app-shell/notes", "Notes")
    ];

    private static readonly IReadOnlyList<NavItem> GlyphTabs =
    [
        new("app-shell", "Today", Match: true, Icon: @<SunIcon Size="20" />),
        new("app-shell/inbox", "Inbox", Icon: @<InboxIcon Size="20" />),
        new("app-shell/standup", "Stand-up", Icon: @<TargetIcon Size="20" />),
        new("app-shell/notes", "Notes", Icon: @<StickyNoteIcon Size="20" />)
    ];

    private static readonly string[] Surfaces = ["Dashboard", "Tools"];

    /// <summary>The Inbox takes the screen like a takeover, though it sits with the
    /// workspace's controls rather than in a takeover group.</summary>
    private const string InboxTakeover = "Inbox";

    /// <summary>The Devbook takes the screen like a takeover too, and sits after the
    /// view switch rather than in a takeover group.</summary>
    private const string DevbookTakeover = "Devbook";

    private bool ViewPressed(string view) => _takeover is null && _view == view;

    private string _view = "Tasks";
    private string? _takeover;

    /// <summary>A view press is also the way back from a takeover.</summary>
    private void ShowView(string view)
    {
        _takeover = null;
        _view = view;
    }

    private void ToggleTakeover(string takeover) => _takeover = _takeover == takeover ? null : takeover;

    private string HeaderState
    {
        get
        {
            if (_takeover == InboxTakeover) return $"The Inbox has the screen; its option, a view or another takeover returns to {_view}. Escape stays with the Inbox.";
            if (_takeover is not null) return $"{_takeover} has the screen; its option, Escape, a view or another takeover returns to {_view}.";

            return $"{_view} view.";
        }
    }

    private static readonly DesignGuideline[] Rules =
    [
        new("interaction-guidelines.md#shell-header", "The header's four regions, and what the view switch, the Inbox and Devbook toggles and the takeover groups each behave as."),
        new("interaction-guidelines.md#workspace-panes", "Why the Inbox and the Devbook take the whole screen rather than opening beside the view."),
        new("interaction-guidelines.md#group-shape-says-cardinality", "What a fused group and a standalone option say before anything is pressed."),
        new("typography-and-layout.md#iconography", "The glyph each header option leads with: its library, its size, and where its colour comes from."),
        new("accessibility.md#iconography-accessibility", "Why the glyph is hidden and the option's word stays its name."),
        new("accessibility.md#target-sizes-and-text", "How large a tab has to be under a thumb, and why the lit tab is not told apart by colour alone."),
        new("interaction-guidelines.md#offline", "Why offline is a calm, persistent line rather than an error."),
        new("accessibility.md#screen-reader--announcements", "What a status line announces, and that it never interrupts.")
    ];

    private const string TabBarCode = """
        <TabBar Items="Tabs" AriaLabel="Sections" TestId="tab-bar" />

        @code {
            private static readonly IReadOnlyList<NavItem> Tabs =
            [
                new("", "Today", Match: true),
                new("inbox", "Inbox"),
                new("notes", "Notes")
            ];
        }
        """;

    private const string GlyphTabBarCode = """
        <TabBar Items="Tabs" AriaLabel="Sections" TestId="tab-bar" />

        @code {
            private static readonly IReadOnlyList<NavItem> Tabs =
            [
                new("", "Today", Match: true, Icon: @<SunIcon Size="20" />),
                new("inbox", "Inbox", Icon: @<InboxIcon Size="20" />),
                new("standup", "Stand-up", Icon: @<TargetIcon Size="20" />),
                new("notes", "Notes", Icon: @<StickyNoteIcon Size="20" />)
            ];
        }
        """;

    private const string HeaderCode = """
        <nav class="app-header__nav" aria-label="Workspace views">
            <div class="app-header__workspace">
                <ToggleButton Pressed="InboxVisible" OnClick="ToggleInbox">Inbox</ToggleButton>
                <ButtonGroup CssClass="header-group header-group--views" AriaLabel="View">
                    <ToggleButton Pressed="ViewOptionPressed(ShellView.Tasks)" OnClick="() => ShowView(ShellView.Tasks)"><ListIcon />Tasks</ToggleButton>
                    <ToggleButton Pressed="ViewOptionPressed(ShellView.Board)" OnClick="() => ShowView(ShellView.Board)"><Columns3Icon />Board</ToggleButton>
                    <ToggleButton Pressed="ViewOptionPressed(ShellView.Calendar)" OnClick="() => ShowView(ShellView.Calendar)"><CalendarIcon />Calendar</ToggleButton>
                    <ToggleButton Pressed="ViewOptionPressed(ShellView.Roadmap)" OnClick="() => ShowView(ShellView.Roadmap)"><ChartGanttIcon />Roadmap</ToggleButton>
                </ButtonGroup>
                <ToggleButton Pressed="DevbookVisible" OnClick="ToggleDevbook">Devbook</ToggleButton>
            </div>
            <ButtonGroup CssClass="header-group header-group--work" AriaLabel="Work in progress">
                <ToggleButton Pressed="ViewOptionPressed(ShellView.Goals)" Title="Goals" OnClick="() => ShowView(ShellView.Goals)"><TargetIcon />Goals</ToggleButton>
                <ToggleButton Pressed="SessionsVisible" PressedChanged="ToggleSessions"><SquareTerminalIcon />Sessions</ToggleButton>
                <ToggleButton Pressed="PullRequestsVisible" PressedChanged="TogglePullRequests"><GitPullRequestIcon />Pull requests</ToggleButton>
            </ButtonGroup>
            <ButtonGroup CssClass="header-group header-group--loose header-group--surface" AriaLabel="Surface">
                <ToggleButton Pressed="DashboardVisible" PressedChanged="ToggleDashboard">Dashboard</ToggleButton>
                <ToggleButton Pressed="ToolsVisible" PressedChanged="ToggleTools">Tools</ToggleButton>
            </ButtonGroup>
        </nav>
        """;

    private const string NotPairedCode = """
        <SyncStatusLine Reading="SyncStatusReading.NotPaired" />
        """;

    private const string SyncedCode = """
        <SyncStatusLine Reading="SyncStatusReading.Synced(lastSyncedAt)" />
        """;

    private const string NotSyncedCode = """
        <SyncStatusLine Reading="SyncStatusReading.Synced(null)" />
        """;

    private const string OfflineCode = """
        <SyncStatusLine Reading="SyncStatusReading.Offline(waiting: 2)" />
        """;
}
