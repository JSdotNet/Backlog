@page "/app-shell"
@page "/app-shell/{Tab}"

<PageTitle>App shell — Backlog UI Storybook</PageTitle>

<StoryPage Title="App shell"
           Summary="The desktop header's navigation — the view switch with the side panes beside it, then the takeovers — and on the phone, TabBar and SyncStatusLine: the row of destinations along the bottom, and the line in its title bar that says where sync stands."
           Guidelines="@Rules">

    <Story Name="Desktop header navigation"
           Description="The desktop header's nav, left to right: the Inbox toggle, the view switch, the Devbook toggle, then the work in progress and the other takeovers. The view switch is a fused ButtonGroup of ToggleButtons with exactly one pressed — a view is replaced, never closed, so pressing the pressed one changes nothing. The Inbox and the Devbook are standalone toggles that open beside whichever view is showing. Sessions and Pull requests are one context's two lists, fused; Dashboard and Tools stand loose.

The sample is live: pick a view, open a side pane beside it, or press a takeover — the line under it says what the shell would show. Board lays the Tasks rows out in columns; Calendar and In progress join these groups in later steps, one option each."
           Code="@HeaderCode">
        <nav class="sb-header-nav" aria-label="Workspace views" data-testid="sb-header-nav">
            <div class="sb-header-nav__workspace">
                <ToggleButton Pressed="@(_takeover is null && _inbox)" OnClick="() => PressSidePane(ref _inbox)" TestId="sb-inbox-toggle">Inbox</ToggleButton>
                <ButtonGroup AriaLabel="View" TestId="sb-view-switch">
                    @foreach (var view in Views)
                    {
                        <ToggleButton Pressed="@(_takeover is null && _view == view)" OnClick="() => ShowView(view)">@view</ToggleButton>
                    }
                </ButtonGroup>
                <ToggleButton Pressed="@(_takeover is null && _devbook)" OnClick="() => PressSidePane(ref _devbook)" TestId="sb-devbook-toggle">Devbook</ToggleButton>
            </div>
            <ButtonGroup AriaLabel="Work in progress" TestId="sb-work-in-progress">
                @foreach (var takeover in WorkInProgress)
                {
                    <ToggleButton Pressed="@(_takeover == takeover)" OnClick="() => ToggleTakeover(takeover)">@takeover</ToggleButton>
                }
            </ButtonGroup>
            <div class="sb-row" role="group" aria-label="Surface">
                @foreach (var takeover in Surfaces)
                {
                    <ToggleButton Pressed="@(_takeover == takeover)" OnClick="() => ToggleTakeover(takeover)">@takeover</ToggleButton>
                }
            </div>
        </nav>
        <p class="sb-state" data-testid="sb-header-state">@HeaderState</p>
    </Story>

    <Story Name="Tab bar"
           Description="One link per destination, each a route of its own, so the Router and the back button already understand it. NavLink decides which tab is lit — the root route is given Match: true, or it would match every path as a prefix.

The tabs below are live: this page answers /app-shell/note and /app-shell/tasks too, so tapping one moves the lit tab and the address together."
           Code="@TabBarCode">
        <div class="sb-phone">
            <TabBar Items="Tabs" AriaLabel="Sections" TestId="tab-bar" />
        </div>
    </Story>

    <Story Name="Not paired"
           Description="The device holds no credential, so there is nothing to sync with. The host shows this until a pairing code is redeemed."
           Code="@NotPairedCode">
        <SyncStatusLine Reading="SyncStatusReading.NotPaired" TestId="sync-not-paired" />
    </Story>

    <Story Name="Synced"
           Description="Paired, and the service last answered this long ago. Now is fixed here so the sample reads the same every time; a host leaves it unset and the line reads the clock."
           Code="@SyncedCode">
        <SyncStatusLine Reading="SyncStatusReading.Synced(At.AddMinutes(-3))" Now="At" TestId="sync-synced" />
    </Story>

    <Story Name="Not synced yet"
           Description="Paired, and nothing has come back from the service since. A reading with no time says so rather than inventing one."
           Code="@NotSyncedCode">
        <SyncStatusLine Reading="SyncStatusReading.Synced(null)" Now="At" TestId="sync-never" />
    </Story>

    <Story Name="Offline"
           Description="Paired, and the service cannot be reached. The count is what is queued for when it can."
           Code="@OfflineCode">
        <SyncStatusLine Reading="SyncStatusReading.Offline(2)" Now="At" TestId="sync-offline" />
    </Story>

</StoryPage>

@code {
    /// <summary>The tab this page was opened on, from /app-shell/{Tab}. Unused
    /// beyond making the route resolve: NavLink reads the address itself.</summary>
    [Parameter]
    public string? Tab { get; set; }

    private static readonly DateTimeOffset At = new(2026, 9, 25, 9, 30, 0, TimeSpan.Zero);

    private static readonly IReadOnlyList<NavItem> Tabs =
    [
        new("app-shell", "Inbox", Match: true),
        new("app-shell/note", "Note"),
        new("app-shell/tasks", "Tasks")
    ];

    private static readonly string[] Views = ["Tasks", "Board", "Roadmap"];
    private static readonly string[] WorkInProgress = ["Sessions", "Pull requests"];
    private static readonly string[] Surfaces = ["Dashboard", "Tools"];

    private string _view = "Tasks";
    private string? _takeover;
    private bool _inbox;
    private bool _devbook;

    /// <summary>A view press is also the way back from a takeover.</summary>
    private void ShowView(string view)
    {
        _takeover = null;
        _view = view;
    }

    private void ToggleTakeover(string takeover) => _takeover = _takeover == takeover ? null : takeover;

    /// <summary>A side-pane toggle: during a takeover it is a way back, showing the
    /// workspace with that pane open; otherwise it opens or closes the pane.</summary>
    private void PressSidePane(ref bool open)
    {
        if (_takeover is not null)
        {
            _takeover = null;
            open = true;
            return;
        }

        open = !open;
    }

    private string HeaderState
    {
        get
        {
            if (_takeover is not null) return $"{_takeover} has the screen; Escape, a view or a side pane returns to {_view}.";

            var beside = new[] { _inbox ? "Inbox" : null, _devbook ? "Devbook" : null }.OfType<string>().ToArray();
            return beside.Length == 0 ? $"{_view} view." : $"{_view} view, with {string.Join(" and ", beside)} beside it.";
        }
    }

    private static readonly DesignGuideline[] Rules =
    [
        new("interaction-guidelines.md#workspace-panes", "How the side panes open beside the view, and how a narrow window trims them."),
        new("interaction-guidelines.md#group-shape-says-cardinality", "What a fused group and a standalone option say before anything is pressed."),
        new("accessibility.md#target-sizes-and-text", "How large a tab has to be under a thumb, and why the lit tab is not told apart by colour alone."),
        new("interaction-guidelines.md#offline", "Why offline is a calm, persistent line rather than an error."),
        new("accessibility.md#screen-reader--announcements", "What a status line announces, and that it never interrupts.")
    ];

    private const string TabBarCode = """
        <TabBar Items="Tabs" AriaLabel="Sections" TestId="tab-bar" />

        @code {
            private static readonly IReadOnlyList<NavItem> Tabs =
            [
                new("", "Inbox", Match: true),
                new("note", "Note"),
                new("tasks", "Tasks")
            ];
        }
        """;

    private const string HeaderCode = """
        <nav class="app-header__nav" aria-label="Workspace views">
            <div class="app-header__workspace">
                <ToggleButton Pressed="PaneOptionPressed(GlobalPane.Inbox)" OnClick="() => PressPane(GlobalPane.Inbox)">Inbox</ToggleButton>
                <ButtonGroup CssClass="header-group header-group--views" AriaLabel="View">
                    <ToggleButton Pressed="ViewOptionPressed(ShellView.Tasks)" OnClick="() => ShowView(ShellView.Tasks)">Tasks</ToggleButton>
                    <ToggleButton Pressed="ViewOptionPressed(ShellView.Board)" OnClick="() => ShowView(ShellView.Board)">Board</ToggleButton>
                    <ToggleButton Pressed="ViewOptionPressed(ShellView.Roadmap)" OnClick="() => ShowView(ShellView.Roadmap)">Roadmap</ToggleButton>
                </ButtonGroup>
                <ToggleButton Pressed="PaneOptionPressed(GlobalPane.Devbook)" OnClick="() => PressPane(GlobalPane.Devbook)">Devbook</ToggleButton>
            </div>
            <ButtonGroup CssClass="header-group header-group--work" AriaLabel="Work in progress">
                <ToggleButton Pressed="SessionsVisible" PressedChanged="ToggleSessions">Sessions</ToggleButton>
                <ToggleButton Pressed="PullRequestsVisible" PressedChanged="TogglePullRequests">Pull requests</ToggleButton>
            </ButtonGroup>
            <ButtonGroup CssClass="header-group header-group--loose header-group--surface" AriaLabel="Surface">
                <ToggleButton Pressed="DashboardVisible" PressedChanged="ToggleDashboard">Dashboard</ToggleButton>
                <ToggleButton Pressed="ToolsVisible" PressedChanged="ToggleTools">Tools</ToggleButton>
            </ButtonGroup>
        </nav>
        """;

    private const string NotPairedCode = """
        <SyncStatusLine Reading="SyncStatusReading.NotPaired" />
        """;

    private const string SyncedCode = """
        <SyncStatusLine Reading="SyncStatusReading.Synced(lastSyncedAt)" />
        """;

    private const string NotSyncedCode = """
        <SyncStatusLine Reading="SyncStatusReading.Synced(null)" />
        """;

    private const string OfflineCode = """
        <SyncStatusLine Reading="SyncStatusReading.Offline(waiting: 2)" />
        """;
}
