@page "/devbook/brain-pane"

<PageTitle>Brain in the pane — Backlog UI Storybook</PageTitle>

<StoryPage Title="Brain in the pane"
           Summary="The library parts the Devbook pane draws while it shows the person's Brain instead of a repository devbook (local ADR 0027 §4): the Brain badge after the pane's title, the Brain | repository switch, the warning for OneDrive's conflict copies, and the first-use prompt. The pane itself lives in the Devbook module and is not rendered here; every value below is handed in."
           Guidelines="@Rules">

    <Story Name="Brain badge"
           Description="Badge with Kind set to brain and the word Brain as its content, placed after the pane's title while the pane shows the Brain. The kind adds the badge--brain class; a pane reading a repository renders no badge."
           Code="@BadgeCode">
        <Badge Kind="brain" TestId="brain-pane-badge">Brain</Badge>
    </Story>

    <Story Name="Brain | repository switch"
           Description="With the Brain and a repository both in the header's scope, the pane offers a switch beside its title: a radio-mode ButtonGroup of two ToggleButtons, one tab stop, the arrows moving and choosing. It opens on the anchor's side; pressing the other side changes what the pane reads and nothing in the header — the scope and the task filter stay as they were. The host holds the choice and forgets it when the scope moves."
           Code="@SwitchCode">
        <ButtonGroup Radio="true" AriaLabel="Which devbook the pane shows" TestId="brain-pane-switch">
            <ToggleButton Pressed="@_showsBrain" PressedChanged="_ => _showsBrain = true">Brain</ToggleButton>
            <ToggleButton Pressed="@(!_showsBrain)" PressedChanged="_ => _showsBrain = false">backlog</ToggleButton>
        </ButtonGroup>
    </Story>

    <Story Name="Conflict copies"
           Description="An Alert with Role set to status, above the pane's body, whose message names each conflict copy beside its original — here plan-LAPTOP.md beside plan.md. The pane passes its own class through BaseClass. With an empty message, Alert renders nothing, so the pane passes none when there is no pair."
           Code="@ConflictCode">
        <Alert Message="@ConflictMessage" Role="status" TestId="brain-pane-conflict" />
    </Story>

    <Story Name="A note's tasks"
           Description="Under a Brain note's links into devbooks, the tasks its tasks field names, each a TaskLinkChip. A task this backlog holds is a gold chip reading its title, and pressing it opens the task. A task id it has not got is a dashed chip reading not in this backlog, never an error: one Brain is read beside more than one backlog."
           Code="@TaskChipsCode">
        <TaskLinkChip Label="Ship the Brain badge" Reference="6f9619ff-8b86-d011-b42d-00c04fc964ff" Resolved="true" OnOpen="_ => { }" TestId="brain-pane-task-known" />
        <TaskLinkChip Label="0c8a1b4e-2f6d-4a37-9c11-5e0b7d3f2a90" Reference="0c8a1b4e-2f6d-4a37-9c11-5e0b7d3f2a90" TestId="brain-pane-task-unknown" />
    </Story>

    <Story Name="Brain notes on a task row"
           Description="BrainNotesBadge, after a task row's other badges in a repository scope or the Brain scope: a teal ◆ n note in the Brain's band painting, counting the owner's Brain notes that name the task. With one note, pressing it opens the note in the Devbook pane, Brain side; with several, it lists them. Its name says only you see this — the notes are read from the owner's own Brain, so another reader of the backlog sees no badge."
           Code="@NotesBadgeCode">
        <BrainNotesBadge Notes="@OneNote" OnOpen="_ => { }" TestId="brain-pane-notes-one" />
        <BrainNotesBadge Notes="@TwoNotes" OnOpen="_ => { }" TestId="brain-pane-notes-two" />
    </Story>

    <Story Name="Show hidden toggle"
           Description="A small icon ToggleButton (an eye, named Show hidden folders), at the end of the Brain menu's heading through TreeView's HeadingTrailing slot; only the Brain's menu carries it. Pressed, every folder CONVENTIONS.md lists under Ignore and every dot-folder gets a tab after the rest, and each area's menu lists its dot-entries. It is off until pressed, and the app keeps the choice per device, never in the folder. Search, the atlas and the Brain database are unchanged by it."
           Code="@ShowHiddenCode">
        <TreeView Nodes="@InboxNotes"
                  HeadingLabel="Inbox"
                  HeadingTestId="brain-pane-show-hidden-heading"
                  ShowOpenButton="false">
            <HeadingTrailing>
                <ToggleButton Pressed="@_showHidden"
                              PressedChanged="pressed => _showHidden = pressed"
                              BaseClass="btn btn--icon btn--toggle"
                              TestId="brain-pane-show-hidden"
                              AriaLabel="Show hidden folders"
                              Title="@(_showHidden ? "Hide the folders the Brain hides" : "Show the folders the Brain hides")"><EyeIcon /></ToggleButton>
            </HeadingTrailing>
        </TreeView>
    </Story>

    <Story Name="A tab marked hidden"
           Description="While Show hidden is on, a hidden folder's tab comes after every other tab: an ignored folder such as _templates reads Templates, a dot-folder such as .obsidian reads Obsidian. Its title carries a Badge of the quiet tone reading hidden, so the mark is a word and not only a shade. In the pane the title also wears the devbook-stack__tab-title--hidden modifier, which the app's stylesheet dims; this storybook does not load that stylesheet."
           Code="@HiddenTabCode">
        <Tabs AriaLabel="Brain areas" ActiveId="@_activeArea" ActiveIdChanged="id => _activeArea = id" TestId="brain-pane-hidden-tabs">
            <TabPanel Id="inbox" Title="Inbox">
                <ChildContent><p>The declared inbox.</p></ChildContent>
            </TabPanel>
            <TabPanel Id="templates" Title="Templates">
                <TitleContent>
                    <span>Templates <Badge Kind="tone" Slug="quiet" TestId="brain-pane-hidden-badge">hidden</Badge></span>
                </TitleContent>
                <ChildContent><p>The _templates folder, listed under Ignore.</p></ChildContent>
            </TabPanel>
        </Tabs>
    </Story>

    <Story Name="First use"
           Description="The pane on a Brain with no folder set. No tabs and no menu: an EmptyState in the status role whose action links to the Brain card on Settings › Storage, the one place the folder is chosen. A folder that is set and missing says what is wrong in an Alert instead, in the Brain source's own words."
           Code="@FirstUseCode">
        <EmptyState Title="Set up your Brain"
                    Description="Your Brain is a folder of your own notes outside every repository. Pick it once in Settings › Storage and its areas show here."
                    TestId="brain-pane-first-use"
                    role="status">
            <Action>
                <AppButton Href="settings/storage#brain-folder" External="false" Variant="ButtonVariant.Primary">Set up your Brain</AppButton>
            </Action>
        </EmptyState>
    </Story>
</StoryPage>

@code {
    private static readonly DesignGuideline[] Rules =
    [
        new("color-scheme.md#the-brains-accent", "The band 2 painting the badge wears, and why the word always goes with it."),
        new("color-scheme.md#badge-and-chip-tones", "Why a task chip that opens something is gold, and an unresolved one dashed and quiet."),
        new("interaction-guidelines.md#group-shape-says-cardinality", "Why a choice of one of two is a radio group and not two independent toggles."),
        new("interaction-guidelines.md#empty-loading-and-error-states", "What the pane says while there is no Brain to read, and where the way forward goes.")
    ];

    private bool _showsBrain = true;

    private bool _showHidden;

    private string _activeArea = "templates";

    private static readonly IReadOnlyList<TreeNode> InboxNotes =
    [
        TreeNode.Leaf("inbox-idea", "Idea"),
        TreeNode.Leaf("inbox-call", "Call notes")
    ];

    private const string ShowHiddenCode = """
        <DevbookMenuTreeView HeadingTrailing="@(BrainMode && _brainShowHidden is not null ? ShowHiddenSwitch : null)" ... />

        <ToggleButton Pressed="@ShowHidden"
                      PressedChanged="SetShowHidden"
                      BaseClass="btn btn--icon btn--toggle"
                      AriaLabel="Show hidden folders"
                      Title="@(ShowHidden ? "Hide the folders the Brain hides" : "Show the folders the Brain hides")"><EyeIcon /></ToggleButton>
        """;

    private const string HiddenTabCode = """
        <TitleContent>
            <span class="devbook-stack__tab-title devbook-stack__tab-title--hidden">
                <DevbookAreaIcon Area="@area.Key" />@area.Label<Badge Kind="tone" Slug="quiet">hidden</Badge>
            </span>
        </TitleContent>
        """;

    private static readonly BrainNoteLink[] OneNote = [new("projects/plan.md", "Plan")];

    private static readonly BrainNoteLink[] TwoNotes = [new("projects/plan.md", "Plan"), new("work/standup.md", "Standup")];

    private const string TaskChipsCode = """
        <TaskLinkChip Label="@title" Reference="@raw" Resolved="true" OnOpen="OpenTaskAsync" />
        <TaskLinkChip Label="@raw" Reference="@raw" />
        """;

    private const string NotesBadgeCode = """
        <BrainNotesBadge Notes="@notes" OnOpen="OnOpenBrainNote" TestId="entry-brain-notes" />
        """;

    private const string ConflictMessage =
        "OneDrive kept two copies: projects/plan.md and projects/plan-LAPTOP.md. Neither file was changed — keep the one you want and delete the other.";

    private const string BadgeCode = """
        <Badge Kind="brain" TestId="devbook-brain-badge">Brain</Badge>
        """;

    private const string SwitchCode = """
        <ButtonGroup Radio="true" AriaLabel="Which devbook the pane shows">
            <ToggleButton Pressed="@showsBrain" PressedChanged="_ => ShowsBrainChanged.InvokeAsync(true)">Brain</ToggleButton>
            <ToggleButton Pressed="@(!showsBrain)" PressedChanged="_ => ShowsBrainChanged.InvokeAsync(false)">@repositoryAlias</ToggleButton>
        </ButtonGroup>
        """;

    private const string ConflictCode = """
        <Alert Message="@conflicts"
               BaseClass="devbook-stack__brain-conflict"
               Role="status" />
        """;

    private const string FirstUseCode = """
        <EmptyState Title="@BrainSetup.SetUpLabel" role="status">
            <DescriptionContent>…</DescriptionContent>
            <Action>
                <AppButton Href="@BrainSetup.SettingsHref" External="false" Variant="ButtonVariant.Primary">
                    @BrainSetup.SetUpLabel
                </AppButton>
            </Action>
        </EmptyState>
        """;
}
