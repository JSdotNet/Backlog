@page "/devbook/domain-context"

<PageTitle>Domain context — Backlog UI Storybook</PageTitle>

<StoryPage Title="Domain context"
           Summary="A subpage of Devbook: the page a bounded context's row opens in the Domain view (local ADR 0040). DomainContextView is one page with no tabs, the same however the reader reached it — the Context map, a related link, a `dependencies.md` link or the menu. It opens on the context's neighbours, its dependency tables drawn by DomainNeighboursView, and its Overview follows below. Overview reads `context.md` and the files beside it: the context's subdomain, deployment and status as badges, its name and lead, the boundary as an Inside and an Outside card, what it holds as tiles, how well it is proved as a Requirements and an Invariants card, how settled it is as one stacked bar, its switches with what each gates, and its pages, each with the question it answers."
           Guidelines="@Rules">

    <Story Name="One page"
           Description="The neighbours come first, then the Overview under a rule. Its header is `context.md`'s own block and the context map's subdomain type, the name and the boundary's lead. The Inside card is the *Inside the boundary:* paragraph; the Outside card reads each *…, which [X] answers* clause as a question with a link to who answers it. Each tile is a kind in its tone and opens its first unit. The proof cards open Requirements and the Always true tab. How settled is one bar. A switch's Gates are the features its `related` names. The badges are information, so they are neutral outlines. Every link here writes what it followed below the page."
           Code="@ContextCode"
           Source="@Context"
           SourceLabel="context.md">
        <DomainContextView ContextName="Tasks" Overview="@Overview" Neighbours="@Neighbours" DocumentPath="@ContextPath"
                           OnNavigate="@(reference => _followed = reference.Raw)"
                           OnOpenAlwaysTrue="@(unit => _followed = $"{unit.Reference} (Always true)")"
                           TestId="story-domain-context-page" />
        <p data-testid="story-domain-context-followed">Followed: @(_followed ?? "nothing yet")</p>
    </Story>

    <Story Name="A context with little written"
           Description="A `context.md` with no prose above its first chapter, no dependency table and no other file: the neighbours and each section say what they lack rather than leaving a gap."
           Code="@ThinCode">
        <DomainContextView ContextName="Monitoring" Overview="@Thin" TestId="story-domain-context-page-thin" />
    </Story>

</StoryPage>

@code {
    private static readonly DesignGuideline[] Rules =
    [
        new("color-scheme.md#domain-view-element-tones", "Why a chapter's flag and setting marks are neutral outlines on the Domain view."),
        new("color-scheme.md#badge-and-chip-tones", "What each status pill's tone means.")
    ];

    private const string ContextPath = ".devbook/domain/tasks/context.md";

    private const string Context = """
        # Tasks

        ```meta
        status: draft
        index: root
        type: context
        deployment: module
        ```

        Tasks maintains a personal backlog of prompts, tasks, ideas, and tests across
        multiple projects and repos. It converts triaged [Inbox Items](../inbox/domain.md#inbox-item)
        into actionable, prioritized Tasks.

        Inside the boundary: a task's status and execution priority, its steps and
        repeats, and its projection to GitHub.

        Outside it: what arrives and how it is triaged, which the
        [Inbox](../inbox/domain.md#inbox-item) answers; when planned work happens and in
        which order, which [Roadmap Planning](../roadmap/domain.md#roadmap-item)
        answers; and the knowledge a task links to, which
        [Devbook](../devbook/domain.md#knowledge-note) answers.

        ## Task backlog

        ```meta
        status: active
        type: feature-flag
        key: backlog
        default: on
        related: [".devbook/domain/tasks/features.md#task-creation"]
        ```

        Create, edit, filter, reorder, and store tasks. It is always enabled.

        ## GitHub integration

        ```meta
        status: draft
        type: feature-flag
        key: github-integration
        default: on
        ```

        Turning it on offers GitHub access in settings. Turned off, the pane hides it.

        ## Week start

        ```meta
        status: proposed
        type: setting
        key: week-start
        scope: user
        ```

        The day the Goals view starts a week on.
        """;

    private const string FeaturesMd = """
        # Features: Tasks

        ## Task creation

        ```meta
        type: feature
        status: draft
        ```

        Create a task in one step.
        """;

    private const string Files = """
        # Domain: Tasks

        ## Task

        ```meta
        type: aggregate
        status: draft
        ```

        A refined, actionable item.

        ### Priority

        ```meta
        type: value-object
        ```

        How urgent a task is.

        ## Ubiquitous Language

        ```meta
        type: ubiquitous-language
        ```

        ### Entry

        ```meta
        type: term
        status: draft
        ```

        One line of the backlog.

        ## Requirement: A task has a title

        ```meta
        type: requirement
        status: active
        tests: unit:dotnet:Backlog.Modules.Tasks.UnitTests.TaskTests
        ```

        The system SHALL refuse a task without a title.

        ## Requirement: A task has a status

        ```meta
        type: requirement
        status: draft
        ```

        The system SHALL give every task a status.

        ## A task is never its own parent

        ```meta
        type: invariant
        status: draft
        tests: unit:dotnet:Backlog.Modules.Tasks.UnitTests.ParentTests
        ```

        No cycle.

        Enforced at: open

        #### Scenario: A titled task

        #### Scenario: An untitled task
        """;

    private static readonly DomainContextOverview Overview =
        DomainContextOverview.Read(Context, ContextPath,
        [
            new(".devbook/domain/tasks/domain.md", Files),
            new(".devbook/domain/tasks/features.md", FeaturesMd)
        ]) with { Subdomain = "core" };

    private string? _followed;

    private static readonly DomainNeighbourhood Neighbours =
        DomainNeighbours.Read(DomainNeighboursPage.Dependencies, ".devbook/domain/tasks/dependencies.md");

    private static readonly DomainContextOverview Thin = DomainContextOverview.Read("# Monitoring\n\n## Signals\n\nNothing yet.", []);

    private const string ContextCode = """
        <DomainContextView ContextName="@context.DisplayName"
                           Overview="@(DomainContextOverview.Read(contextMd, contextPath, otherFilesWithPaths) with { Subdomain = mapKind })"
                           Neighbours="@DomainNeighbours.Read(dependenciesMd, dependenciesPath)"
                           DocumentPath="@contextPath"
                           OnNavigate="Follow"
                           OnOpenAlwaysTrue="OpenAlwaysTrue" />
        """;

    private const string ThinCode = """
        <DomainContextView ContextName="Monitoring" Overview="@DomainContextOverview.Read(contextMd, [])" />
        """;
}
