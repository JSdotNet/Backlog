@using Backlog.UI.Storybook.Components
@using Backlog.Aspire.ServiceDefaults
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Backlog UI Storybook</title>
    @if (DevelopmentWorkspace.Current is not null)
    {
        @* Says which worktree served this tab. Several worktrees run these
           harnesses side by side, and every one of them titles its pages the
           same. The marker is applied by script rather than written into the
           title above because a page setting its own PageTitle replaces that
           title outright. *@
        <script>@((MarkupString)DevelopmentWorkspace.TitleScript)</script>
    }
    <base href="/" />
    <link rel="stylesheet" href="_content/Backlog.UI.Components/components.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="Backlog.UI.Storybook.styles.css" />
    <link rel="icon" href="data:,">
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />

    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Backlog.UI.Components/components.js"></script>
    @* Storybook chrome. Measures the library's tokens for the Foundations page;
       it never touches a component. *@
    <script src="storybook.js"></script>
</body>

</html>
