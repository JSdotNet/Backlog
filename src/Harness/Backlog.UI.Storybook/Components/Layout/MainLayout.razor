@inherits LayoutComponentBase
@using Backlog.Aspire.ServiceDefaults
@using Backlog.UI.Components

@*
    Two columns: the page index on the left, one component group on the right.
    The sidebar uses the library's own NavList and SearchBox, so the storybook
    navigates with the components it is documenting.

    The list of pages lives in StorybookIndex, shared with the introduction.
    Below the narrow breakpoint the sidebar stops being a column and becomes a
    band above the content, because the library also ships to a phone-sized head
    and a fixed 15rem gutter left the examples about a hundred pixels wide.
*@

<div class="sb-shell">
    <aside class="sb-sidebar">
        <div class="sb-brand">
            <span class="sb-brand__name">Backlog UI</span>
            <span class="sb-brand__kind">storybook</span>
        </div>

        <div class="sb-filter">
            <SearchBox Value="@_filter"
                       ValueChanged="v => _filter = v"
                       Placeholder="Filter pages"
                       AriaLabel="Filter storybook pages"
                       DebounceMilliseconds="150"
                       TestId="page-filter" />
        </div>

        @foreach (var group in Matches)
        {
            <div class="sb-nav-group">
                <p class="sb-nav-group__title">@group.Title</p>
                <NavList Items="@StorybookIndex.NavItemsFor(group)" AriaLabel="@group.Title" />
            </div>
        }

        @if (Matches.Count == 0)
        {
            <p class="sb-nav-empty" data-testid="page-filter-empty">No page matches “@_filter”.</p>
        }
    </aside>

    <main class="sb-content">
        @Body

        @* Which build, and — when this is served out of a checkout — which
           worktree. Several worktrees serve identical storybooks side by side,
           and nothing else on the page tells them apart. *@
        <footer class="sb-footer" data-testid="build-footer">
            <span>Version <code>@AppVersion.OfEntryAssembly()</code></span>
            @if (DevelopmentWorkspace.Current is { } workspace)
            {
                <span class="sb-footer__separator" aria-hidden="true">·</span>
                <span>Worktree <code data-testid="build-footer-workspace">@workspace</code></span>
            }
        </footer>
    </main>
</div>

@code {
    private string _filter = string.Empty;

    /// <summary>
    /// Groups that still have something in them. A group whose own title matches
    /// keeps all its pages, so typing "feedback" finds the group as well as the
    /// page — the sidebar is the only index of the library there is.
    /// </summary>
    private IReadOnlyList<StorybookIndex.Group> Matches
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_filter)) return StorybookIndex.Groups;

            var query = _filter.Trim();

            return
            [
                .. StorybookIndex.Groups
                    .Select(group => Contains(group.Title, query)
                        ? group
                        : group with { Pages = [.. group.Pages.Where(page => Matched(page, query))] })
                    .Where(group => group.Pages.Count > 0)
            ];
        }
    }

    private static bool Matched(StorybookIndex.Page page, string query) =>
        Contains(page.Title, query) || Contains(page.Summary, query);

    private static bool Contains(string value, string query) =>
        value.Contains(query, StringComparison.OrdinalIgnoreCase);
}
