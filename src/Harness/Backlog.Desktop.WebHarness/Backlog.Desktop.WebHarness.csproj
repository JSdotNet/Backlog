<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    TEST HARNESS — not deployed. See src/Harness/README.md.
    Blazor Server host of Backlog.Desktop.UI, the same Razor components the MAUI
    Blazor Hybrid desktop head renders in its WebView, so the desktop UI can be
    started by the Aspire AppHost ("desktop-web-harness") and driven by Playwright.
    Publishing flags come from src/Harness/Directory.Build.props.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.Desktop.WebHarness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Backlog\Backlog.Modules.Backlog\Backlog.Modules.Backlog.csproj" />
    <!-- The Dashboard module implementation, for AddDashboardModule(). The host is
         the only thing that sees it: the parts ask through the abstractions project. -->
    <ProjectReference Include="..\..\Modules\Dashboard\Backlog.Modules.Dashboard\Backlog.Modules.Dashboard.csproj" />
    <!-- Dev PC Management's published surface. LocalDevelopmentCopilotToolService
         answers the same ICopilotToolService port from the JSON alone, which is
         this harness's own adapter; the port and the catalog format come from
         here rather than from the UI project that renders the answer. -->
    <ProjectReference Include="..\..\Modules\DevPc\Backlog.Modules.DevPc.Abstractions\Backlog.Modules.DevPc.Abstractions.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Backlog.Infrastructure.AzureFoundry\Backlog.Infrastructure.AzureFoundry.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Backlog.Infrastructure.Claude\Backlog.Infrastructure.Claude.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Backlog.Infrastructure.FileSystem\Backlog.Infrastructure.FileSystem.csproj" />
    <ProjectReference Include="..\..\Aspire\Backlog.Aspire.ServiceDefaults\Backlog.Aspire.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\App\Backlog.Desktop.UI\Backlog.Desktop.UI.csproj" />
  </ItemGroup>

</Project>
