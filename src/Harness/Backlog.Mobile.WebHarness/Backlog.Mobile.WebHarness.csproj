<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    TEST HARNESS — not deployed. See src/Harness/README.md.
    Blazor Server host of Backlog.Mobile.UI at phone width. The Android head needs
    an emulator and cannot run as an Aspire project resource, so this harness lets
    the mobile UI be started by the AppHost ("mobile-web-harness") and driven by
    Playwright. Publishing flags come from src/Harness/Directory.Build.props.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.Mobile.WebHarness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Aspire\Backlog.Aspire.ServiceDefaults\Backlog.Aspire.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\App\Backlog.Mobile.UI\Backlog.Mobile.UI.csproj" />
    <!-- The device half of cloud sync. This harness keeps its credential under
         its own content root, so it and the desktop harness are two devices. -->
    <ProjectReference Include="..\..\Infrastructure\Backlog.Infrastructure.Sync\Backlog.Infrastructure.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Program is the compiler-generated entry point of a top-level file, and
         internal. tests/Backlog.HostComposition.UnitTests starts this harness
         through WebApplicationFactory<Program> to prove the host still composes,
         which is a thing only its own entry point can prove. -->
    <InternalsVisibleTo Include="Backlog.HostComposition.UnitTests" />
  </ItemGroup>

</Project>