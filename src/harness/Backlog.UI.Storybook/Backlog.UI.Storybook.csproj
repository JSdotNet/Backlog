<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    TEST HARNESS — not deployed. See src/harness/README.md.
    A storybook for Backlog.UI.Components: every shared component rendered on its
    own, with no module, infrastructure or app project in the graph. That missing
    reference is the point — it proves the component library carries no domain,
    and it lets a human or Playwright review the components without starting the
    application. Publishing flags come from src/harness/Directory.Build.props.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Backlog.UI.Storybook</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Aspire\Backlog.Aspire.ServiceDefaults\Backlog.Aspire.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\UI\Backlog.UI.Components\Backlog.UI.Components.csproj" />
  </ItemGroup>

</Project>
