<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Backlog_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Backlog_Desktop"
    xmlns:vm="using:Backlog_Desktop.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ MASTER PANE ============ -->
        <Grid Grid.Column="0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Backlog" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                <Button x:Name="NewEntryButton"
                        AutomationProperties.AutomationId="NewEntryButton"
                        AutomationProperties.Name="New entry"
                        Command="{x:Bind ViewModel.NewEntryCommand}"
                        ToolTipService.ToolTip="Create a new backlog entry">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="New" />
                    </StackPanel>
                </Button>
                <Button x:Name="DeleteEntryButton"
                        AutomationProperties.AutomationId="DeleteEntryButton"
                        AutomationProperties.Name="Delete entry"
                        Command="{x:Bind ViewModel.DeleteEntryCommand}"
                        IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                        ToolTipService.ToolTip="Delete the selected entry">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>
            </StackPanel>

            <ComboBox x:Name="StatusFilterComboBox"
                      Grid.Row="1"
                      Header="Filter by status"
                      HorizontalAlignment="Stretch"
                      AutomationProperties.AutomationId="StatusFilterComboBox"
                      AutomationProperties.Name="Filter by status"
                      ItemsSource="{x:Bind ViewModel.StatusFilters}"
                      DisplayMemberPath="Label"
                      SelectedItem="{x:Bind ViewModel.SelectedStatusFilter, Mode=TwoWay}" />

            <ListView x:Name="EntryListView"
                      Grid.Row="2"
                      AutomationProperties.AutomationId="EntryListView"
                      AutomationProperties.Name="Backlog entries"
                      ItemsSource="{x:Bind ViewModel.Entries}"
                      SelectedItem="{x:Bind ViewModel.SelectedEntry, Mode=TwoWay}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="8">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="AutomationProperties.AccessibilityView" Value="Content" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SummaryRowViewModel">
                        <Grid Padding="4" RowSpacing="2"
                              AutomationProperties.Name="{x:Bind Title}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="{x:Bind Title}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind Subtitle}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ============ DETAIL PANE ============ -->
        <Border Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">

            <Grid>
                <TextBlock Text="Select an entry or create a new one."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.HasNoDetail), Mode=OneWay}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{x:Bind local:MainPage.NotNullToVisibility(ViewModel.Detail), Mode=OneWay}">
                    <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left">

                        <TextBox x:Name="EntryTitleTextBox"
                                 Header="Title"
                                 AutomationProperties.AutomationId="EntryTitleTextBox"
                                 AutomationProperties.Name="Entry title"
                                 Text="{x:Bind ViewModel.Detail.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ComboBox x:Name="EntryTypeComboBox"
                                      Header="Type"
                                      MinWidth="160"
                                      AutomationProperties.AutomationId="EntryTypeComboBox"
                                      AutomationProperties.Name="Entry type"
                                      ItemsSource="{x:Bind ViewModel.Detail.Types, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.Detail.SelectedType, Mode=TwoWay}" />
                            <ComboBox x:Name="PriorityComboBox"
                                      Header="Priority"
                                      MinWidth="160"
                                      AutomationProperties.AutomationId="PriorityComboBox"
                                      AutomationProperties.Name="Priority"
                                      ItemsSource="{x:Bind ViewModel.Detail.Priorities, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.Detail.SelectedPriority, Mode=TwoWay}" />
                        </StackPanel>

                        <TextBox x:Name="EntryContentTextBox"
                                 Header="Content (markdown)"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="120"
                                 AutomationProperties.AutomationId="EntryContentTextBox"
                                 AutomationProperties.Name="Entry content"
                                 Text="{x:Bind ViewModel.Detail.ContentMd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBox x:Name="EntryTagsTextBox"
                                 Header="Tags (comma separated)"
                                 AutomationProperties.AutomationId="EntryTagsTextBox"
                                 AutomationProperties.Name="Tags"
                                 Text="{x:Bind ViewModel.Detail.TagsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Button x:Name="SaveEntryButton"
                                AutomationProperties.AutomationId="SaveEntryButton"
                                AutomationProperties.Name="Save entry"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.Detail.SaveCommand, Mode=OneWay}"
                                Content="Save" />

                        <!-- Lifecycle + sub-items only after the entry is persisted -->
                        <StackPanel Spacing="12"
                                    Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.Detail.IsPersisted), Mode=OneWay}">

                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Status:" VerticalAlignment="Center"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="CurrentStatusText"
                                           AutomationProperties.AutomationId="CurrentStatusText"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind ViewModel.Detail.StatusText, Mode=OneWay}" />
                                <TextBlock Text="Progress:" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="ProgressText"
                                           AutomationProperties.AutomationId="ProgressText"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind ViewModel.Detail.ProgressText, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox x:Name="StatusComboBox"
                                          Header="Move status to"
                                          MinWidth="180"
                                          AutomationProperties.AutomationId="StatusComboBox"
                                          AutomationProperties.Name="Move status to"
                                          DisplayMemberPath="Label"
                                          ItemsSource="{x:Bind ViewModel.Detail.AvailableStatusTargets, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.Detail.SelectedStatusTarget, Mode=TwoWay}" />
                                <Button x:Name="ApplyStatusButton"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.AutomationId="ApplyStatusButton"
                                        AutomationProperties.Name="Apply status"
                                        Command="{x:Bind ViewModel.Detail.ApplyStatusCommand, Mode=OneWay}"
                                        Content="Apply" />
                            </StackPanel>

                            <TextBlock Text="Sub-items" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="NewSubItemTextBox"
                                         Width="280"
                                         PlaceholderText="Sub-item title"
                                         AutomationProperties.AutomationId="NewSubItemTextBox"
                                         AutomationProperties.Name="New sub-item title"
                                         Text="{x:Bind ViewModel.Detail.NewSubItemTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button x:Name="AddSubItemButton"
                                        AutomationProperties.AutomationId="AddSubItemButton"
                                        AutomationProperties.Name="Add sub-item"
                                        Command="{x:Bind ViewModel.Detail.AddSubItemCommand, Mode=OneWay}"
                                        Content="Add" />
                            </StackPanel>

                            <ItemsControl x:Name="SubItemList"
                                          AutomationProperties.AutomationId="SubItemList"
                                          ItemsSource="{x:Bind ViewModel.Detail.SubItems, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SubItemViewModel">
                                        <Grid ColumnSpacing="8" Padding="0,4" AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0"
                                                      MinWidth="0"
                                                      IsChecked="{x:Bind IsDone, Mode=OneWay}"
                                                      Click="OnToggleSubItem"
                                                      AutomationProperties.Name="Toggle done" />
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Text="{x:Bind Title, Mode=OneWay}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="2" Click="OnMoveSubItemUp"
                                                    AutomationProperties.Name="Move up"
                                                    ToolTipService.ToolTip="Move up">
                                                <FontIcon Glyph="&#xE70E;" FontSize="12" />
                                            </Button>
                                            <Button Grid.Column="3" Click="OnMoveSubItemDown"
                                                    AutomationProperties.Name="Move down"
                                                    ToolTipService.ToolTip="Move down">
                                                <FontIcon Glyph="&#xE70D;" FontSize="12" />
                                            </Button>
                                            <Button Grid.Column="4" Click="OnRemoveSubItem"
                                                    AutomationProperties.Name="Remove sub-item"
                                                    ToolTipService.ToolTip="Remove">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
