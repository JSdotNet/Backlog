<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The Work context's UI (local ADR 0073 §1): the Tasks pane, its state and the
    adapters that read and write repository-authored entries, under Tasks/; and the
    Roadmap band above the panes, with the mapping from a stored plan onto the shared
    timeline control (.devbook/domain/work/features.md#feature-reading-and-rescheduling-on-a-timeline),
    under Roadmap/. It references the shared control library rather than growing its
    own controls, which is the rule every module UI project follows (local ADR 0067).

    The band's own rules ship here too, in wwwroot/roadmap.css, served at
    _content/Backlog.Modules.Work.UI/roadmap.css; every host that renders the band
    links it after the library's components.css and before the shell's app.css.
  -->
  <PropertyGroup>
    <!--
      Each folder's namespace follows the project's: Tasks/ publishes
      Backlog.Modules.Work.UI.Tasks and Roadmap/ Backlog.Modules.Work.UI.Roadmap. The
      Razor generator emits a component's @using directives *inside* the
      component's namespace and without a global:: prefix, so under a
      Backlog.Modules.* namespace a bare leading "Backlog" can bind to
      Backlog.Modules rather than to the repository root and fail with CS0234 —
      which is why every Razor file here writes its Backlog imports global::.
    -->
    <RootNamespace>Backlog.Modules.Work.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- The entry text round-trip, the draft mapping, the issue shape and the record
         shape the Ask AI source writes a milestone and an item in are contracts
         worth testing directly rather than only through the pane and the band.
         Their tests sit with the components in Backlog.Modules.Work.UnitTests; the
         ones that compose the shell around them stay in Backlog.Desktop.UI.UnitTests. -->
    <InternalsVisibleTo Include="Backlog.Modules.Work.UnitTests" />
    <InternalsVisibleTo Include="Backlog.Desktop.UI.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Backlog.UI.Components\Backlog.UI.Components.csproj" />
    <!-- IAiContentSource, the shell's Ask AI port, and what everything may see. -->
    <ProjectReference Include="..\..\..\Core\Backlog.SharedKernel\Backlog.SharedKernel.csproj" />
    <!-- The module's published surface only: DTOs, the entry text language, the
         planning vocabulary, and the ITaskItems and IRoadmapPlanning ports. The
         aggregates, their repositories and the use-case handlers stay behind that
         line — the host wires them up, the UI does not see them. -->
    <ProjectReference Include="..\Backlog.Modules.Work.Abstractions\Backlog.Modules.Work.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Infrastructure\Backlog.Infrastructure.Copilot\Backlog.Infrastructure.Copilot.csproj" />
    <!-- Which repositories are configured, so the plan can be read one project at a
         time, and the GitHub projections of the Tasks pane. Repositories is the
         supplier of that registry and today the GitHub settings store is where it
         lives; the UI conforms to it and holds no repository state of its own. -->
    <ProjectReference Include="..\..\..\Infrastructure\Backlog.Infrastructure.GitHub\Backlog.Infrastructure.GitHub.csproj" />
  </ItemGroup>

</Project>
