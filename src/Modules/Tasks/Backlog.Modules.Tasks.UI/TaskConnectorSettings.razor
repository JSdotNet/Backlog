@*
    The Connectors page on the settings screen: connect a repository or a product
    to a connector, and set how each one syncs (ADR 0020 §9). The shell draws it
    because the host registered it (AddTaskConnectorSettings), not because the
    shell knows anything about connectors.

    Drawn entirely from the installed connectors' descriptors and the connected
    targets, so a connector added later is offered here with no change to this
    page. A target whose connector this build does not have stays listed under its
    stored id, so it can still be disconnected.

    A connector a person signs in to (ITaskConnectorSignIn) gets a sign-in line
    above the targets, drawn from its descriptor like everything else here. So does
    the field a target is typed into: its label, placeholder and help are the
    chosen connector's, so spec-manager asks for a product's slug rather than an
    owner/repository it would answer with a 404.

    A connector that can list its targets (ITaskConnector.ListTargetChoicesAsync)
    is picked from instead: the name shown, the target stored, one already connected
    not offered again — so a spec-manager product is never typed by its name, which
    its REST interface does not take. One that lists nothing, or cannot list, is
    typed into, and the field says why when the connector said.

    Disconnecting keeps a target's tasks, so the sources that left tasks behind are
    listed under the cards, each with a confirmed "Delete tasks"
    (IDisconnectedLinkedTasks). Nothing is listed in a host without that port.

    The namespace is the project's root rather than a Settings folder's, for the
    reason InboxSettings gives: a ...Tasks.Settings namespace would shadow the
    settings screen's own component.
*@
@namespace Backlog.Desktop.UI.Tasks
@using Backlog.Modules.Tasks.Abstractions.Connectors
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject LinkedTaskSources Sources
@inject IServiceProvider Services
@inject ILogger<TaskConnectorSettings> Log

@* No heading of its own: the shell titles the section "Connectors" already. *@
<p class="setting__body">
    Connect a repository or a product and every open item in it appears on the Tasks list
    as a linked task, kept in step with the source. Its title, status and assignee follow
    the source; your priority, My Day, sub-items and notes stay yours.
</p>

@if (Sources.Descriptors.Count == 0)
{
    <EmptyState Title="No connector is installed"
                Description="This build has no connector to bring tasks in from. Once one is installed, its repositories or products are connected here."
                TestId="task-connectors-empty" />
}
else
{
    @if (Sources.SignIns.Count > 0)
    {
        <div class="task-connectors__sign-ins" data-testid="task-connectors-sign-ins">
            @foreach (var (descriptor, signIn) in Sources.SignIns)
            {
                var state = SignInStateOf(descriptor.Id);
                <ConnectorSignIn @key="descriptor.Id"
                                 ConnectorName="@descriptor.DisplayName"
                                 Icon="@descriptor.Icon"
                                 AccountName="@signIn.Account?.DisplayName"
                                 SigningIn="@state.SigningIn"
                                 Error="@state.Error"
                                 OnSignIn="() => SignInAsync(descriptor.Id, signIn)"
                                 OnSignOut="() => SignOutAsync(descriptor.Id, signIn)"
                                 TestId="@($"task-connector-sign-in-{descriptor.Id}")" />
            }
        </div>
    }

    @if (Targets is null)
    {
        <Alert Message="This host keeps no connected targets, so nothing can be connected here."
               Role="status"
               TestId="task-connectors-unavailable" />
    }
    else
    {
        <div class="task-connectors__connect" data-testid="task-connectors-connect">
            <SelectField Form="true"
                         Label="Connector"
                         Id="task-connector-choice"
                         TestId="task-connector-choice"
                         CurrentValue="@_connectorId"
                         Options="@ConnectorOptions"
                         OnChanged="ChooseConnectorAsync" />
            @if (_choices is null)
            {
                <SelectField Form="true"
                             Label="@TargetLabel"
                             Id="task-connector-target"
                             TestId="task-connector-target"
                             Disabled="true"
                             IncludeEmptyOption="true"
                             EmptyLabel="Loading…"
                             Options="@([])" />
            }
            else if (_choices.Choices.Count > 0)
            {
                <SelectField Form="true"
                             Label="@TargetLabel"
                             Id="task-connector-target"
                             TestId="task-connector-target"
                             CurrentValue="@_target"
                             IncludeEmptyOption="true"
                             EmptyLabel="@(AvailableChoices.Count == 0 ? "Everything here is connected" : "Pick one")"
                             Options="@AvailableChoices"
                             OnChanged="value => _target = value ?? string.Empty" />
                <Alert Message="@_connectError" TestId="task-connector-connect-error" />
            }
            else
            {
                <TextField Label="@TargetLabel"
                           Id="task-connector-target"
                           Placeholder="@SelectedConnector?.TargetPlaceholder"
                           HelpText="@(_choices.CannotList ?? SelectedConnector?.TargetHelp)"
                           Value="@_target"
                           ValueChanged="value => _target = value"
                           ErrorMessage="@_connectError"
                           TestId="task-connector-target" />
            }
            <AppButton Variant="ButtonVariant.Primary"
                       Disabled="@(!CanConnect)"
                       TestId="task-connector-connect"
                       OnClick="ConnectAsync">
                Connect
            </AppButton>
        </div>

        @if (ConnectedTargets.Count == 0)
        {
            <Alert Message="Nothing is connected yet." Role="status" BaseClass="setting__note" TestId="task-connectors-none" />
        }
        else
        {
            <div class="task-connectors__targets" data-testid="task-connectors-targets">
                @foreach (var target in ConnectedTargets)
                {
                    <ConnectedTargetEditor @key="@KeyOf(target)"
                                           Options="@ToOptions(target)"
                                           Syncing="@_syncing.Contains(KeyOf(target))"
                                           SyncMessage="@_syncMessages.GetValueOrDefault(KeyOf(target))"
                                           OnChange="options => Change(target, options)"
                                           OnSyncNow="@(Sync is null ? default(EventCallback<ConnectedTargetOptions>) : EventCallback.Factory.Create<ConnectedTargetOptions>(this, _ => SyncNowAsync(target)))"
                                           OnRemove="_ => RemoveAsync(target)"
                                           TestId="task-connector-target-card" />
                }
            </div>
        }

        @if (_disconnected.Count > 0)
        {
            <h3 class="setting__subtitle">Disconnected sources</h3>
            <p class="setting__body">
                These are no longer connected, but their tasks are still on the list.
            </p>
            <div class="task-connectors__disconnected" data-testid="task-connectors-disconnected">
                @foreach (var source in _disconnected)
                {
                    <Card @key="@KeyOf(source)"
                          Compact="true"
                          AriaLabel="@($"{Sources.NameOf(source.ConnectorId)} {source.Target}")"
                          TestId="task-connector-disconnected">
                        <div class="task-connectors__disconnected-head">
                            <span class="task-connectors__disconnected-connector" data-testid="task-connector-disconnected-connector">@Sources.NameOf(source.ConnectorId)</span>
                            <code data-testid="task-connector-disconnected-target">@source.Target</code>
                            <Badge BaseClass="task-connectors__disconnected-count" Kind="" TestId="task-connector-disconnected-count">@TaskCount(source.TaskCount)</Badge>
                            <AppButton Variant="ButtonVariant.Danger"
                                       Size="ButtonSize.Small"
                                       Busy="@_deletingKeys.Contains(KeyOf(source))"
                                       BusyLabel="Deleting"
                                       TestId="task-connector-disconnected-delete"
                                       OnClick="() => _deleting = source">
                                Delete tasks
                            </AppButton>
                        </div>
                    </Card>
                }
            </div>
        }

        @if (_message is not null)
        {
            <Alert Message="@_message" Role="status" BaseClass="setting__note" TestId="task-connectors-message" />
        }

        @* No OpenChanged binding, for the reason ToolsPane gives: it is raised before
           OnConfirm, and clearing the subject there would clear it before the
           confirm reads it. Cancel, Escape and the backdrop all arrive on OnCancel. *@
        <ConfirmDialog Open="@(_deleting is not null)"
                       Title="Delete these tasks?"
                       Message="@DeleteMessage"
                       ConfirmText="Delete tasks"
                       Destructive="true"
                       TestId="task-connector-delete-dialog"
                       ConfirmTestId="task-connector-delete-confirm"
                       CancelTestId="task-connector-delete-cancel"
                       OnConfirm="ConfirmDeleteAsync"
                       OnCancel="() => _deleting = null" />
    }
}

@code {
    private string _connectorId = string.Empty;
    private string _target = string.Empty;
    private string? _connectError;
    private string? _message;

    /// <summary>The targets a "Sync now" is running for, by <see cref="KeyOf"/>. A
    /// press on another card while one runs goes through: the sync takes one
    /// target at a time and queues the second behind the first.</summary>
    private readonly HashSet<string> _syncing = new(StringComparer.Ordinal);

    /// <summary>How each card's last Sync now went, by <see cref="KeyOf"/>, shown on
    /// that card, so two syncs at once never answer for each other.</summary>
    private readonly Dictionary<string, string> _syncMessages = new(StringComparer.Ordinal);

    /// <summary>A sign-in under way, or the reason the last one failed, per
    /// connector id.</summary>
    private readonly Dictionary<string, SignInState> _signIns = new(StringComparer.Ordinal);

    /// <summary>The page has closed. A sign-in it started may still be running and
    /// is left to finish; this only stops it writing to a page nobody sees.</summary>
    private bool _disposed;

    /// <summary>Where connected targets are kept, or null in a host that keeps none.</summary>
    private IConnectedTargets? Targets => Sources.Targets;

    /// <summary>The sync, for "Sync now", or null in a host that runs none.</summary>
    private ILinkedTaskSync? Sync => Services.GetService<ILinkedTaskSync>();

    /// <summary>What lists and deletes the tasks a disconnected source left behind,
    /// or null in a host that has no such port or keeps no connected targets.</summary>
    private IDisconnectedLinkedTasks? Disconnected => Targets is null ? null : Services.GetService<IDisconnectedLinkedTasks>();

    /// <summary>The sources that left tasks behind, as last listed.</summary>
    private IReadOnlyList<DisconnectedSource> _disconnected = [];

    /// <summary>The source whose "Delete tasks" is being confirmed, or null.</summary>
    private DisconnectedSource? _deleting;

    /// <summary>The sources a confirmed delete is running for, by
    /// <see cref="KeyOf(DisconnectedSource)"/>.</summary>
    private readonly HashSet<string> _deletingKeys = new(StringComparer.Ordinal);

    /// <summary>Counts the list requests, so only the latest one lands, as
    /// <see cref="_choicesRequest"/> does for the choices.</summary>
    private int _disconnectedRequest;

    /// <summary>The connected targets the disconnected sources were last listed
    /// against, so a change that connects or removes none — a sync recording its
    /// progress — does not list them again.</summary>
    private IReadOnlyList<ConnectedTarget> _listedAgainst = [];

    /// <summary>The connector chosen in the connect form, whose descriptor names
    /// the target field.</summary>
    private TaskConnectorDescriptor? SelectedConnector => Sources.Find(_connectorId);

    private string TargetLabel => SelectedConnector?.TargetLabel ?? TaskConnectorDescriptor.DefaultTargetLabel;

    /// <summary>What the chosen connector offers to pick from, or null while it is
    /// being asked.</summary>
    private ConnectorTargetChoices? _choices;

    /// <summary>Ends a choices request when the page closes.</summary>
    private readonly CancellationTokenSource _lifetime = new();

    /// <summary>Counts the choices requests, so only the latest one lands: an older,
    /// slower answer — for a connector since left, or from before a sign-out — is
    /// dropped.</summary>
    private int _choicesRequest;

    /// <summary>
    /// Whether Connect may be pressed: never while the choices load; in the picker
    /// only with one of its choices picked, so a name typed into the fallback
    /// before the picker arrived is never saved; in the typed field once something
    /// is typed.
    /// </summary>
    private bool CanConnect =>
        !string.IsNullOrWhiteSpace(_connectorId)
        && _choices is not null
        && (_choices.Choices.Count > 0
            ? AvailableChoices.Any(choice => string.Equals(choice.Value, _target, StringComparison.Ordinal))
            : !string.IsNullOrWhiteSpace(_target));

    /// <summary>The chosen connector's choices, less the targets of it already
    /// connected — compared the way a target is, without regard to case.</summary>
    private IReadOnlyList<SelectorOption> AvailableChoices =>
        [.. (_choices?.Choices ?? [])
            .Where(choice => Targets?.Get(_connectorId, choice.Target) is null)
            .Select(choice => new SelectorOption(choice.Target, choice.Name))];

    private static string KeyOf(ConnectedTarget target) => $"{target.ConnectorId}/{target.Target}";

    private static string KeyOf(DisconnectedSource source) => $"{source.ConnectorId}/{source.Target}";

    private static string TaskCount(int count) => count == 1 ? "1 task" : $"{count} tasks";

    private IReadOnlyList<SelectorOption> ConnectorOptions =>
        [.. Sources.Descriptors.Select(descriptor => new SelectorOption(descriptor.Id, descriptor.DisplayName))];

    private IReadOnlyList<ConnectedTarget> ConnectedTargets =>
        [.. (Targets?.List() ?? [])
            .OrderBy(target => Sources.NameOf(target.ConnectorId), StringComparer.CurrentCultureIgnoreCase)
            .ThenBy(target => target.Target, StringComparer.OrdinalIgnoreCase)];

    protected override async Task OnInitializedAsync()
    {
        _connectorId = Sources.Descriptors.FirstOrDefault()?.Id ?? string.Empty;
        if (Targets is not null) Targets.Changed += OnExternalChange;
        foreach (var (descriptor, signIn) in Sources.SignIns)
        {
            var connectorId = descriptor.Id;
            Action changed = () => OnAccountChanged(connectorId);
            signIn.AccountChanged += changed;
            _accountHandlers.Add((signIn, changed));
        }

        await LoadChoicesAsync();
        await RefreshDisconnectedAsync();
    }

    /// <summary>What each sign-in's AccountChanged is handled by, kept so Dispose
    /// can take each one off again.</summary>
    private readonly List<(ITaskConnectorSignIn SignIn, Action Handler)> _accountHandlers = [];

    /// <summary>
    /// A sign-in, a sign-out, or a sign-in the source stopped honouring — however
    /// it came about, on this page or after it stopped waiting. The page is drawn
    /// again, and the chosen connector's choices asked for again: a connector may
    /// list its targets only while signed in. Marshalled, because it may be raised
    /// off the renderer's thread.
    /// </summary>
    private void OnAccountChanged(string connectorId) => _ = InvokeAsync(async () =>
    {
        if (_disposed) return;

        StateHasChanged();
        if (string.Equals(connectorId, _connectorId, StringComparison.Ordinal))
        {
            await LoadChoicesAsync();
            StateHasChanged();
        }
    });

    private async Task ChooseConnectorAsync(string? connectorId)
    {
        _connectorId = connectorId ?? string.Empty;
        _target = string.Empty;
        _connectError = null;
        await LoadChoicesAsync();
    }

    /// <summary>
    /// Asks the chosen connector what there is to pick, showing the picker as
    /// loading meanwhile. Only the latest request lands: an answer that arrives
    /// after a newer one was asked for is dropped. A target typed or picked before
    /// is kept only while the answer still offers it — the picker never holds a
    /// value it does not show. Never throws into the page: a connector that fails
    /// is answered as one that could not list (LinkedTaskSources.ListChoicesAsync),
    /// and the page closing ends the request.
    /// </summary>
    private async Task LoadChoicesAsync()
    {
        if (Targets is null || string.IsNullOrEmpty(_connectorId)) return;

        var request = ++_choicesRequest;
        var asked = _connectorId;
        _choices = null;

        ConnectorTargetChoices choices;
        try
        {
            choices = await Sources.ListChoicesAsync(asked, _lifetime.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (_disposed || request != _choicesRequest) return;
        _choices = choices;

        if (choices.Choices.Count > 0
            && !AvailableChoices.Any(choice => string.Equals(choice.Value, _target, StringComparison.Ordinal)))
        {
            _target = string.Empty;
        }
    }

    /// <summary>The store may raise off the renderer's thread — a sync recording
    /// its progress — so the re-render is marshalled rather than called. A target
    /// connected or removed elsewhere moves a source on or off the disconnected
    /// list, so that is asked for again; a change to a target's settings or
    /// progress moves none, and is only drawn. A sign-in's change is
    /// <see cref="OnAccountChanged"/>'s.</summary>
    private void OnExternalChange() => _ = InvokeAsync(async () =>
    {
        if (_disposed) return;

        StateHasChanged();
        if (SamePairs(Targets?.List() ?? [], _listedAgainst)) return;

        await RefreshDisconnectedAsync();
        StateHasChanged();
    });

    /// <summary>Whether two lists hold the same pairs, compared the way a target
    /// is (<see cref="ConnectedTarget.Is"/>), whatever their settings.</summary>
    private static bool SamePairs(IReadOnlyList<ConnectedTarget> left, IReadOnlyList<ConnectedTarget> right) =>
        left.Count == right.Count
        && left.All(target => right.Any(other => other.Is(target.ConnectorId, target.Target)));

    /// <summary>
    /// Asks which sources left tasks behind. Only the latest request lands. Never
    /// throws into the page: a list that fails is logged and shows nothing, which
    /// hides the section rather than offering a delete for a list it could not read.
    /// </summary>
    private async Task RefreshDisconnectedAsync()
    {
        if (_disposed) return;

        var request = ++_disconnectedRequest;
        _listedAgainst = Targets?.List() ?? [];
        if (Disconnected is not { } disconnected)
        {
            _disconnected = [];
            return;
        }

        IReadOnlyList<DisconnectedSource> sources;
        try
        {
            sources = await disconnected.ListAsync(_lifetime.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Listing the disconnected connector sources threw.");
            sources = [];
        }

        if (_disposed || request != _disconnectedRequest) return;
        _disconnected = sources;
    }

    private SignInState SignInStateOf(string connectorId)
    {
        if (!_signIns.TryGetValue(connectorId, out var state))
        {
            state = new SignInState();
            _signIns[connectorId] = state;
        }

        return state;
    }

    private async Task SignInAsync(string connectorId, ITaskConnectorSignIn signIn)
    {
        var state = SignInStateOf(connectorId);
        if (state.SigningIn) return;

        state.SigningIn = true;
        state.Error = null;

        string? error;
        try
        {
            // Not tied to this page's lifetime, on purpose. The browser is still open
            // on the sign-in and will redirect to the connector's loopback listener;
            // cancelling when somebody switches settings sections would send it to a
            // dead port. The connector bounds the wait with its own timeout, and a
            // sign-in that lands after the page closed reaches the next one through
            // AccountChanged.
            error = await signIn.SignInAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Signing in to {Connector} threw.", connectorId);
            error = "Signing in did not finish. Try again.";
        }

        // Nobody is left to tell once the page has closed.
        if (_disposed) return;

        state.SigningIn = false;
        state.Error = error;

        // The choices are asked for again through AccountChanged, which the sign-in
        // raises (OnAccountChanged).
    }

    private async Task SignOutAsync(string connectorId, ITaskConnectorSignIn signIn)
    {
        var state = SignInStateOf(connectorId);
        state.Error = null;

        try
        {
            // Finished even if the page closes meanwhile: a sign-out cut off halfway
            // could leave credentials behind that the person asked to forget.
            await signIn.SignOutAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Signing out of {Connector} threw.", connectorId);
            if (!_disposed) state.Error = "Signing out did not finish. Try again.";
        }
    }

    private ConnectedTargetOptions ToOptions(ConnectedTarget target) =>
        new(
            Sources.NameOf(target.ConnectorId),
            target.Target,
            target.Enabled,
            target.TitleFollowsSource,
            target.PromoteArchivesOriginal,
            (int)Math.Max(1, Math.Round(target.SyncInterval.TotalMinutes)),
            target.SkipUntouchedOlderThan is { } skip ? (int)Math.Round(skip.TotalDays) : null,
            target.CompleteAtSource)
        {
            Icon = Sources.Find(target.ConnectorId)?.Icon,
            CanCompleteAtSource = Sources.CanComplete(target.ConnectorId),
            LastSynced = target.LastSyncedAt?.ToLocalTime().ToString("g", System.Globalization.CultureInfo.CurrentCulture),
            LastSyncError = target.LastSyncError,
            LastSyncFailed = target.LastSyncFailedAt?.ToLocalTime().ToString("g", System.Globalization.CultureInfo.CurrentCulture),
        };

    private async Task ConnectAsync()
    {
        if (Targets is null || !CanConnect) return;

        var target = _target.Trim();
        if (Targets.Get(_connectorId, target) is not null)
        {
            _connectError = $"{target} is already connected.";
            return;
        }

        _connectError = Targets.Save(new ConnectedTarget(_connectorId, target));
        if (_connectError is not null) return;

        // A picked target is named the way the picker showed it.
        var name = _choices?.Choices.FirstOrDefault(choice => string.Equals(choice.Target, target, StringComparison.OrdinalIgnoreCase))?.Name ?? target;
        _message = $"Connected {name}. Its items arrive with the next sync.";
        _target = string.Empty;

        // Connected again, a source is no longer one whose tasks can be deleted here.
        await RefreshDisconnectedAsync();
    }

    private void Change(ConnectedTarget target, ConnectedTargetOptions options)
    {
        _message = Targets?.Update(target.ConnectorId, target.Target, stored => stored with
        {
            Enabled = options.Enabled,
            TitleFollowsSource = options.TitleFollowsSource,
            PromoteArchivesOriginal = options.PromoteArchivesOriginal,
            CompleteAtSource = options.CompleteAtSource,
            SyncInterval = TimeSpan.FromMinutes(options.SyncIntervalMinutes),
            SkipUntouchedOlderThan = options.SkipUntouchedOlderThanDays is { } days ? TimeSpan.FromDays(days) : null,
        });
    }

    private async Task RemoveAsync(ConnectedTarget target)
    {
        var error = Targets?.Remove(target.ConnectorId, target.Target);
        _syncMessages.Remove(KeyOf(target));
        _message = error ?? $"Disconnected {target.Target}. Its tasks stay on the list as they are.";

        // Its tasks are now a disconnected source's, which can be deleted below.
        await RefreshDisconnectedAsync();
    }

    /// <summary>What the confirmation says: what is deleted and from where, what is
    /// not touched, that connecting again does not undo it, that it reaches the
    /// other devices, and how many tasks will be left waiting on a missing
    /// one.</summary>
    private string DeleteMessage
    {
        get
        {
            if (_deleting is not { } source) return string.Empty;

            var message =
                $"This deletes {TaskCount(source.TaskCount)} from {source.Target}. The items at the source stay untouched. "
                + $"Connecting {source.Target} again will not bring these tasks back, and the deletion reaches your other devices.";

            return source.DependentCount switch
            {
                0 => message,
                1 => $"{message} 1 task that waits on these will show as blocked on a missing task.",
                var count => $"{message} {count} tasks that wait on these will show as blocked on a missing task.",
            };
        }
    }

    /// <summary>
    /// Deletes the confirmed source's tasks and says how it went on the page's
    /// status line: how many were deleted, or why none were — a source connected
    /// again since it was listed is refused. Not tied to the page's lifetime, for
    /// the reason a sign-out is not: a delete cut off halfway would leave some of
    /// the source's tasks behind. The list is asked for again either way.
    /// </summary>
    private async Task ConfirmDeleteAsync()
    {
        if (_deleting is not { } source) return;
        _deleting = null;

        var key = KeyOf(source);
        if (Disconnected is not { } disconnected || !_deletingKeys.Add(key)) return;

        string message;
        try
        {
            var result = await disconnected.DeleteAsync(source.ConnectorId, source.Target, CancellationToken.None);
            message = result.IsSuccess ? $"Deleted {TaskCount(result.Value)} from {source.Target}." : result.Error.Message;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Deleting the tasks of {Connector} {Target} threw.", source.ConnectorId, source.Target);
            message = $"Deleting the tasks from {source.Target} did not finish. Try again.";
        }
        finally
        {
            _deletingKeys.Remove(key);
        }

        if (_disposed) return;

        _message = message;
        await RefreshDisconnectedAsync();
    }

    /// <summary>
    /// Syncs the card's own target and says how it went on that card, in the
    /// sync's sentence — never "Synced." over a sync that failed. A second press on
    /// the same card while it runs does nothing; a press on another card runs, after
    /// this one. The outcome never throws; a throw from a host's own implementation
    /// is said as a sync that did not finish.
    /// </summary>
    private async Task SyncNowAsync(ConnectedTarget target)
    {
        var key = KeyOf(target);
        if (Sync is not { } sync || !_syncing.Add(key)) return;

        _syncMessages.Remove(key);
        string message;
        try
        {
            var outcome = await sync.RequestSync(target.ConnectorId, target.Target);
            message = outcome.Message;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Syncing {Connector} {Target} threw.", target.ConnectorId, target.Target);
            message = $"The sync of {target.Target} did not finish. Try again.";
        }
        finally
        {
            _syncing.Remove(key);
        }

        // A card disconnected while it synced keeps no answer, or reconnecting the
        // same target would show the old one.
        if (!_disposed && Targets?.Get(target.ConnectorId, target.Target) is not null) _syncMessages[key] = message;
    }

    public void Dispose()
    {
        if (Targets is not null) Targets.Changed -= OnExternalChange;
        foreach (var (signIn, handler) in _accountHandlers) signIn.AccountChanged -= handler;
        _disposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private sealed class SignInState
    {
        public bool SigningIn { get; set; }

        public string? Error { get; set; }
    }
}
