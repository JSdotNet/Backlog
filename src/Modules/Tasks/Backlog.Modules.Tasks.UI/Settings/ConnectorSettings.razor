@*
    The Connectors page on the settings screen: every outside tool tasks can
    follow (local ADR 0020), whether you are signed in to it, and what you have
    connected through it. The shell draws it because AddConnectorSettings
    registered it, and this page draws each tool only from its descriptor, so a
    new connector shows up here without a line changing.

    The namespace is the project's root rather than the folder's, on the Inbox's
    precedent: a Backlog.Desktop.UI.Tasks.Settings namespace would shadow the
    settings screen's own component for everything under this project.
*@
@namespace Backlog.Desktop.UI.Tasks
@implements IDisposable
@using Backlog.Modules.Tasks.Abstractions.Connectors
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@inject IEnumerable<ITaskConnector> RegisteredConnectors
@* Read off this rather than injected: a host with no linked task sync registers
   neither, and then there are no targets to list and no Sync now to offer. *@
@inject IServiceProvider Services
@inject ILogger<ConnectorSettings> Log

<div class="setting__group" data-testid="connector-settings">
    @if (_connectors.Count == 0)
    {
        <EmptyState Title="No connectors"
                    Description="Nothing in this version can bring in tasks from another tool yet."
                    TestId="connectors-empty" />
    }
    else
    {
        <p class="setting__note">
            Tools whose items can arrive in Tasks as linked tasks. Each one you connect
            syncs on its own; switch it off to pause it without losing its tasks.
        </p>

        @foreach (var connector in _connectors)
        {
            var descriptor = connector.Descriptor;
            var state = StateOf(descriptor.Id);
            var signIn = connector as ITaskConnectorSignIn;

            <ConnectorCard @key="descriptor.Id"
                           Name="@descriptor.DisplayName"
                           Icon="@descriptor.Icon"
                           ColorToken="@descriptor.ColorToken"
                           SignsIn="@(signIn is not null)"
                           AccountName="@signIn?.Account?.DisplayName"
                           SigningIn="@state.SigningIn"
                           SignInError="@state.SignInError"
                           OnSignIn="() => SignInAsync(descriptor.Id, signIn!)"
                           OnSignOut="() => SignOutAsync(descriptor.Id, signIn!)"
                           Targets="@TargetsOf(descriptor.Id)"
                           OnTargetEnabledChanged="row => SetEnabled(descriptor.Id, row)"
                           OnRemoveTarget="row => Remove(descriptor.Id, row)"
                           AddDraft="@state.Draft"
                           AddDraftChanged="value => state.Draft = value"
                           AddError="@state.AddError"
                           OnAddTarget="() => Add(descriptor.Id)"
                           TestId="@($"connector-{descriptor.Id}")" />
        }

        @if (Trigger is not null && Targets is not null)
        {
            <div class="setting__actions">
                <AppButton Busy="@_syncing"
                           BusyLabel="Syncing"
                           Disabled="@(!Targets.List().Any(target => target.Enabled))"
                           TestId="connectors-sync-now"
                           OnClick="SyncNowAsync">Sync now</AppButton>
            </div>
        }

        <Alert Message="@_storeError" TestId="connectors-store-error" />
    }
</div>

@code {
    private readonly Dictionary<string, CardState> _states = new(StringComparer.Ordinal);

    private IReadOnlyList<ITaskConnector> _connectors = [];
    private bool _syncing;

    /// <summary>The page has closed. A sign-in it started may still be running and
    /// is left to finish; this only stops it writing to a page nobody sees.</summary>
    private bool _disposed;

    /// <summary>Why the last switch or removal could not be kept, as the store
    /// words it.</summary>
    private string? _storeError;

    private IConnectedTargets? Targets => Services.GetService<IConnectedTargets>();

    private ILinkedTaskSyncTrigger? Trigger => Services.GetService<ILinkedTaskSyncTrigger>();

    protected override void OnInitialized()
    {
        // In display-name order, so the page reads the same whatever order the host
        // registered them in.
        _connectors = [.. RegisteredConnectors.OrderBy(connector => connector.Descriptor.DisplayName, StringComparer.CurrentCultureIgnoreCase)];

        foreach (var signIn in _connectors.OfType<ITaskConnectorSignIn>())
        {
            signIn.AccountChanged += OnExternalChange;
        }

        if (Targets is { } targets) targets.Changed += OnExternalChange;
    }

    /// <summary>Both events may be raised off the renderer's thread — a sign-in a
    /// source stopped honouring, a sync recording its progress — so the re-render is
    /// marshalled rather than called.</summary>
    private void OnExternalChange() => _ = InvokeAsync(StateHasChanged);

    private CardState StateOf(string connectorId)
    {
        if (!_states.TryGetValue(connectorId, out var state))
        {
            state = new CardState();
            _states[connectorId] = state;
        }

        return state;
    }

    private IReadOnlyList<ConnectorTargetRow>? TargetsOf(string connectorId) =>
        Targets is not { } targets
            ? null
            : [.. targets.List()
                .Where(target => string.Equals(target.ConnectorId, connectorId, StringComparison.Ordinal))
                .Select(target => new ConnectorTargetRow(target.Target, target.Enabled, FormatSynced(target.LastSyncedAt)))];

    private static string? FormatSynced(DateTimeOffset? at) =>
        at?.ToLocalTime().ToString("d MMM, HH:mm", System.Globalization.CultureInfo.CurrentCulture);

    private async Task SignInAsync(string connectorId, ITaskConnectorSignIn signIn)
    {
        var state = StateOf(connectorId);
        if (state.SigningIn) return;

        state.SigningIn = true;
        state.SignInError = null;

        string? error;
        try
        {
            // Not tied to this page's lifetime, on purpose. The browser is still open
            // on the sign-in and will redirect to the connector's loopback listener;
            // cancelling when somebody switches settings sections would send it to a
            // dead port. The connector bounds the wait with its own timeout, and a
            // sign-in that lands after the page closed reaches the next one through
            // AccountChanged.
            error = await signIn.SignInAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Signing in to {Connector} threw.", connectorId);
            error = "Signing in did not finish. Try again.";
        }

        // Nobody is left to tell once the page has closed; the state belongs to a
        // component that will never render again.
        if (_disposed) return;

        state.SigningIn = false;
        state.SignInError = error;
    }

    private async Task SignOutAsync(string connectorId, ITaskConnectorSignIn signIn)
    {
        var state = StateOf(connectorId);
        state.SignInError = null;

        try
        {
            // Finished even if the page closes meanwhile: a sign-out cut off halfway
            // could leave credentials behind that the person asked to forget.
            await signIn.SignOutAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Signing out of {Connector} threw.", connectorId);
            if (!_disposed) state.SignInError = "Signing out did not finish. Try again.";
        }
    }

    private void Add(string connectorId)
    {
        if (Targets is not { } targets) return;

        var state = StateOf(connectorId);
        var name = state.Draft?.Trim() ?? string.Empty;

        if (name.Length == 0)
        {
            state.AddError = "Type what to connect first.";
            return;
        }

        if (targets.Get(connectorId, name) is not null)
        {
            state.AddError = $"{name} is already connected.";
            return;
        }

        state.AddError = targets.Save(new ConnectedTarget(connectorId, name));
        if (state.AddError is null) state.Draft = string.Empty;
    }

    private void SetEnabled(string connectorId, ConnectorTargetRow row) =>
        _storeError = Targets?.Update(connectorId, row.Name, target => target with { Enabled = row.Enabled });

    private void Remove(string connectorId, ConnectorTargetRow row) =>
        _storeError = Targets?.Remove(connectorId, row.Name);

    private async Task SyncNowAsync()
    {
        if (Trigger is not { } trigger || _syncing) return;

        _syncing = true;
        try
        {
            await trigger.RequestSync();
        }
        finally
        {
            _syncing = false;
        }
    }

    public void Dispose()
    {
        foreach (var signIn in _connectors.OfType<ITaskConnectorSignIn>())
        {
            signIn.AccountChanged -= OnExternalChange;
        }

        if (Targets is { } targets) targets.Changed -= OnExternalChange;

        _disposed = true;
    }

    /// <summary>What one card is in the middle of: the add field's text and why it
    /// was refused, and a sign-in under way or the reason it failed.</summary>
    private sealed class CardState
    {
        public string? Draft { get; set; }

        public string? AddError { get; set; }

        public bool SigningIn { get; set; }

        public string? SignInError { get; set; }
    }
}
