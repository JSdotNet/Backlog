@*
    The Repositories page on the settings screen: the repository registry, and one
    card per repository for its clone, colour, account, pull-request labels,
    activity cache and token. The shell draws it because the host registered it
    (AddRepositorySettings), not because the shell knows anything about
    repositories.

    What the page shows is read from the GitHub settings store on every render, and
    the drafts under it are refilled from the store whenever the store changes, so a
    switch to another tab and back - or a registry pulled from a paired device while
    the page is open - shows what is stored rather than what this instance last
    held.

    Two parts of a card are not this module's. The Devbook source and the Devbook
    sections belong to Devbook, which a module UI may not reach, so the shell adds
    them as RepositorySettingsParts and the card renders each one with the
    repository's alias. The inbox half of a rename goes through IInboxRepositoryRename
    for the same reason: an adapter that may see the Inbox answers it.

    The namespace is the project's root rather than a Settings folder's, for the
    reason InboxSettings gives: a ...Tasks.Settings namespace would shadow the
    settings screen's own component.
*@
@namespace Backlog.Desktop.UI.Tasks
@using Microsoft.Extensions.DependencyInjection
@using Backlog.SharedKernel.Results
@implements IDisposable
@inject GitHubIntegration GitHub
@inject IAppFeatureSettings Features
@* How this machine reaches GitHub, shared with the shell's pages that read the
   same answer; registered beside this page by AddRepositorySettings. *@
@inject GitHubConnectionState GitHubState
@inject ILocalGitRepositoryService LocalGit
@* The optional collaborators - the activity caches and the modules a rename
   carries entries across - are read off this rather than injected, so a host that
   composes none of them can still render the page. *@
@inject IServiceProvider Services
@* The blocks other projects add to every repository's card; empty in a host that
   registers none, and then each card holds only this page's own settings. *@
@inject IEnumerable<RepositorySettingsPart> Parts

@* No heading of its own: the shell titles the section "Repositories" already. *@
<p class="setting__body">
    Configure zero or more repositories Backlog can work with. GitHub needs an
    <code>owner/repo</code> connection; local features also
    need the clone directory on this machine.
</p>

@* The box carries its own border through `setting__input`, so the
   library's grow wrapper is emitted without one and auto-grow stays
   off - the rows count is what sizes this field. *@
<TextArea Bare="true"
          AutoGrow="false"
          GrowCssClass=""
          LabelCssClass="setting__label"
          InputCssClass="@($"{SettingInputClass(_repoError)} setting__input--multiline")"
          Label="@RepositoryInputLabel"
          Id="github-repos"
          data-testid="github-repos-input"
          Rows="@RepositoryInputRows"
          spellcheck="false"
          autocomplete="off"
          aria-describedby="github-repos-status"
          Placeholder="@RepositoryInputPlaceholder"
          Value="@_draftRepos"
          ValueChanged="value => _draftRepos = value"
          @onchange="ApplyRepositories" />

<p class="setting__status" id="github-repos-status" data-testid="github-repos-status" role="status">
    @if (_repoReplacedHint is not null)
    {
        @* Said once, on the save that did it, and beside the ordinary
           summary rather than instead of it. Not an error — the save
           went through — but the one edit in this box that reads like a
           rename and is not one deserves a sentence pointing at the
           control that is. *@
        <span data-testid="github-repos-replaced-hint">@_repoReplacedHint </span>
    }
    @if (_repoError is not null)
    {
        <span class="setting__status--error">@_repoError</span>
    }
    else if (GitHub.Settings.RegistryError is { } registryError)
    {
        @* Said on load rather than only when somebody tries to write.
           An unreadable registry composes to an empty list, and the
           empty-list message below would read as "nobody has
           configured one yet" - which is the opposite of the truth and
           invites reconfiguring from scratch over a file that is
           intact and simply unparseable. Naming the file is the
           actionable half: it is the one thing to go and look at. *@
        <span class="setting__status--error">@registryError</span>
        <span>The registry is <code>@GitHub.Settings.RegistryPath</code>. Repositories stay as they are until it can be read.</span>
    }
    else if (!VisibleRepositories.Any())
    {
        <span>Nothing configured - entries show no repository controls until one is.</span>
    }
    else
    {
        <span>
            <code>@VisibleRepositories.First().FullName</code> is configured@(VisibleRepositories.Count > 1 ? $", and {VisibleRepositories.Count - 1} more." : ".")
            @if (AdditionalRepositoriesEnabled)
            {
                <span>Type <code>@("@" + VisibleRepositories.First().Alias)</code> on an entry to assign it to <code>@VisibleRepositories.First().FullName</code>.</span>
            }
            else
            {
                <span>The first configured repository is used for the single-repository backlog experience.</span>
            }
        </span>
    }
</p>

<div class="setting__actions">
    <AppButton Variant="ButtonVariant.None"
               data-testid="add-repository-button"
               OnClick="AddRepositoryDraft">
        Add repository
    </AppButton>
</div>
@if (VisibleRepositories.Any())
{
    @* One subpage per repository, same shared strip as the page tabs
       above - only the classes differ. *@
    <Tabs Bare="true"
          ListCssClass="repo-subpages"
          ListTestId="repo-subpages"
          AriaLabel="Repository pages"
          TabCssClass="repo-subpage"
          ActiveTabCssClass="repo-subpage repo-subpage--active"
          ActiveId="@ActiveRepository?.Alias"
          ActiveIdChanged="ShowRepositoryPage">
        @foreach (var repository in VisibleRepositories)
        {
            var activeRepo = repository;

            <TabPanel @key="activeRepo.Alias"
                      Id="@activeRepo.Alias"
                      TabTestId="repo-subpage-tab"
                      Element="article"
                      BaseClass="repo-card"
                      TestId="github-repo-card"
                      aria-label="@($"{activeRepo.FullName} repository settings")">
                <TitleContent>
                    <span>@activeRepo.FullName</span>
                </TitleContent>
                <ChildContent>
            <header class="repo-card__header">
                <div>
                    <h3 class="repo-card__title">@activeRepo.FullName</h3>
                    <p class="repo-card__meta">
                        Area <code>@("@" + activeRepo.Alias)</code>
                    </p>
                    @if (_renameNoteAlias == activeRepo.Alias && _renameNote is not null)
                    {
                        @* Said once, on the card it concerns, beside the
                           name it now carries: a rename is a result to
                           report, not an error to clear. *@
                        <p class="setting__status" data-testid="repo-rename-note" role="status">@_renameNote</p>
                    }
                </div>

                @* Rename before Remove, in the order somebody reaching
                   for one of them would want to meet them: the one that
                   keeps everything, then the one that keeps nothing. *@
                <div class="repo-card__actions">
                    <AppButton Variant="ButtonVariant.None"
                               data-testid="rename-repository-button"
                               OnClick="() => BeginRename(activeRepo)">
                        Rename
                    </AppButton>
                    <AppButton Variant="ButtonVariant.None"
                               data-testid="remove-repository-button"
                               OnClick="() => RemoveRepository(activeRepo)">
                        Remove repository
                    </AppButton>
                </div>
            </header>

            @if (_renamingAlias == activeRepo.Alias)
            {
                @* A rename is asked for by name rather than read out of
                   the repositories box above, because the box cannot tell
                   a rename from a replacement — and for a line written
                   without an alias of its own, the two are the same edit.
                   Asked for here, the repository keeps its clone directory,
                   colour, account and devbook settings under the new name,
                   and every entry and inbox item filed against the old
                   name follows it. *@
                <div class="repo-card__section" data-testid="repo-rename">
                    <TextField Bare="true"
                               LabelCssClass="setting__label"
                               InputCssClass="@SettingInputClass(_renameError)"
                               Label="@($"New name for {activeRepo.FullName}")"
                               Id="@($"rename-{activeRepo.Alias}")"
                               data-testid="repo-rename-input"
                               spellcheck="false"
                               autocomplete="off"
                               aria-describedby="@($"rename-status-{activeRepo.Alias}")"
                               Placeholder="owner/repo"
                               Value="@_renameDraft"
                               ValueChanged="value => _renameDraft = value"
                               @onkeydown="e => OnRenameKeyDownAsync(e, activeRepo)" />
                    <p class="setting__status" id="@($"rename-status-{activeRepo.Alias}")" data-testid="repo-rename-status" role="status">
                        @if (_renameError is not null)
                        {
                            <span class="setting__status--error">@_renameError</span>
                        }
                        else
                        {
                            <span>The repository keeps its settings under the new name, and every entry and inbox item filed against <code>@activeRepo.FullName</code> follows it.</span>
                        }
                    </p>
                    <div class="setting__actions">
                        <AppButton Variant="ButtonVariant.None"
                                   data-testid="repo-rename-apply"
                                   OnClick="() => ApplyRenameAsync(activeRepo)">
                            Rename repository
                        </AppButton>
                        <AppButton Variant="ButtonVariant.None"
                                   data-testid="repo-rename-cancel"
                                   OnClick="CancelRename">
                            Cancel
                        </AppButton>
                    </div>
                </div>
            }

            @* Which colour this repository wears everywhere it appears —
               the filter above the backlog, its roadmap band, its entries
               and the sessions under them. Here rather than on any one of
               those surfaces, because it is one fact about the repository
               and a surface that chose its own would be a second answer to
               the same question.

               A radiogroup: five hues and a default, exactly one of which
               holds at a time. Reset is a button and not a sixth swatch —
               it is not one more colour to sit among them, it is the
               taking back of a choice. *@
            <div class="repo-card__section" data-testid="repo-colour">
                <h4 class="devbook-folders__title">Colour</h4>
                <p class="setting__note">
                    A quiet marker on this repository's filter, roadmap band and entries. Leave it on default and Backlog picks one that no other repository is using.
                </p>

                <div class="repo-swatches" role="radiogroup" aria-label="@($"Colour for {activeRepo.FullName}")">
                    @for (var option = 1; option <= RepositoryColours.Available; option++)
                    {
                        var colour = option;
                        var chosen = activeRepo.Colour == colour;

                        <AppButton BaseClass="@($"repo-swatch repo-swatch--{colour}")"
                                   Variant="ButtonVariant.None"
                                   CssClass="@(chosen ? "repo-swatch--chosen" : null)"
                                   TestId="@($"repo-colour-{colour}")"
                                   role="radio"
                                   aria-checked="@(chosen ? "true" : "false")"
                                   aria-label="@($"Colour {colour}")"
                                   Title="@($"Colour {colour}")"
                                   OnClick="() => ApplyRepositoryColour(activeRepo, colour)" />
                    }

                    <AppButton Variant="ButtonVariant.Ghost"
                               Size="ButtonSize.Small"
                               TestId="repo-colour-reset"
                               Disabled="@(activeRepo.Colour is null)"
                               OnClick="() => ApplyRepositoryColour(activeRepo, null)">
                        Reset to default
                    </AppButton>
                </div>

                <p class="setting__status" data-testid="repo-colour-status" role="status">
                    @RepositoryColourSummary(activeRepo)
                </p>
            </div>

            @* Which of this machine's accounts calls for this repository go
               out as. Beside the colour and for the same reason: it is one
               fact about the repository rather than about any one surface,
               and it is shared workspace data, so it lives here rather than
               in the textarea's grammar - which is a thing you type, while
               an account is a thing you pick.

               A SelectField and not a radiogroup of buttons. A colour has to
               be seen to be chosen; an account is a name from a list, which
               is the shape the library already draws - and its empty option
               carries the unbound state, so nothing has to be reset. *@
            @if (Features.IsEnabled(TasksFeatures.GitHubIntegration))
            {
                <div class="repo-card__section" data-testid="repo-account">
                    <h4 class="devbook-folders__title">Account</h4>
                    <p class="setting__note">
                        Leave it on the default and calls go out as whichever account this
                        machine is signed in as, which is what Backlog has always done.
                        Accounts are added on the Accounts tab.
                    </p>

                    <SelectField Form="true"
                                 Label="Worked as"
                                 Id="@($"repo-account-{activeRepo.Alias}")"
                                 TestId="repo-account-select"
                                 LabelCssClass="setting__label"
                                 SelectCssClass="setting__input"
                                 CurrentValue="@activeRepo.Account"
                                 Options="@AccountOptions(activeRepo)"
                                 IncludeEmptyOption="true"
                                 EmptyLabel="Default (whichever account this machine is signed in as)"
                                 HelpText="@($"The identity {activeRepo.FullName}'s calls leave as.")"
                                 OnChanged="login => ApplyRepositoryAccount(activeRepo, login)" />

                    <p class="setting__status" data-testid="repo-account-status" role="status">
                        @{ var binding = RepositoryAccountBinding.Of(GitHub.Settings.Current, activeRepo); }
                        @if (binding.IsUnsatisfied)
                        {
                            <span class="setting__status--error">@RepositoryAccountBinding.Problem(binding)</span>
                        }
                        else
                        {
                            <span>@RepositoryAccountBinding.Summary(binding)</span>
                        }
                    </p>
                </div>
            }

            @* Two columns: how this machine reaches the repository,
               and which of its knowledge folders Backlog reads - the
               second one added by the shell as a part, below. *@
            <div class="setting-columns">
                <div>
                    <TextField Bare="true"
                               LabelCssClass="setting__label"
                               InputCssClass="setting__input"
                               Label="Local clone directory"
                               Id="@($"clone-{activeRepo.Alias}")"
                               data-testid="repo-clone-directory-input"
                               spellcheck="false"
                               autocomplete="off"
                               Placeholder="@($"C:\\Repos\\{activeRepo.Name}")"
                               Value="@CloneDirectoryDraft(activeRepo)"
                               ValueChanged="value => _draftCloneDirectories[activeRepo.Alias] = value"
                               @onchange="() => ApplyCloneDirectory(activeRepo.Alias)"
                               @onkeydown="e => OnClonePathKeyDown(e, activeRepo)" />
                    <p class="setting__status" data-testid="repo-clone-status" role="status">
                        @{ var cloneStatus = CloneStatus(activeRepo); }
                        @if (cloneStatus.IsCloned)
                        {
                            <span>Local clone: <code>@cloneStatus.CloneDirectory</code></span>
                        }
                        else
                        {
                            <span>@cloneStatus.Summary</span>
                        }
                    </p>
                    <div class="setting__actions">
                        <AppButton Variant="ButtonVariant.None"
                                   data-testid="repo-clone-button"
                                   Disabled="@(!CanClone(activeRepo))"
                                   OnClick="() => CloneRepositoryAsync(activeRepo)">
                            @CloneButtonText(activeRepo)
                        </AppButton>
                    </div>

                    @* The pull requests pane's label filter. Stored on the
                       repository's registry row, so it travels with the
                       workspace to a paired device; saved when the field is
                       left, the way the clone directory is, and only on
                       change — Enter in a text field raises change, so a
                       keydown handler beside it would save twice. *@
                    <div class="repo-card__section" data-testid="repo-pull-request-labels">
                        <h4 class="devbook-folders__title">Pull requests</h4>
                        <TextField Bare="true"
                                   LabelCssClass="setting__label"
                                   InputCssClass="@SettingInputClass(PullRequestLabelsError(activeRepo))"
                                   Label="Pull request labels"
                                   Id="@($"pull-request-labels-{activeRepo.Alias}")"
                                   data-testid="repo-pull-request-labels-input"
                                   spellcheck="false"
                                   autocomplete="off"
                                   Placeholder="frontend, design"
                                   HelpText="@($"Comma-separated. When set, the pull requests pane lists only {activeRepo.FullName}'s pull requests carrying any of these labels. Pinned pull requests are always listed.")"
                                   ErrorMessage="@PullRequestLabelsError(activeRepo)"
                                   Value="@PullRequestLabelsDraft(activeRepo)"
                                   ValueChanged="value => _draftPullRequestLabels[activeRepo.Alias] = value"
                                   @onchange="() => ApplyPullRequestLabels(activeRepo.Alias)" />
                    </div>

                    @* The dashboard's pull-request detail is kept on
                       this machine because a merged pull request's
                       reviews, churn and size cannot change again.
                       That is only true while the copy matches the
                       repository, so there has to be a way back -
                       and it is per repository, because a rewritten
                       history is one repository's problem and
                       re-reading the others would be a long fetch
                       for nothing. Present only when the app is
                       actually keeping one, the way the Devices
                       panel treats its collaborators. *@
                    @if (_activityCache is not null)
                    {
                        <div class="repo-card__section" data-testid="repo-activity-cache">
                            <h4 class="devbook-folders__title">Dashboard activity</h4>
                            <p class="setting__note">
                                Merged pull requests and closed issues are kept on this machine, with each pull request's review, churn and size detail, so opening the dashboard only walks the pages that changed since and fetches the pull requests it has not seen. Nothing about a merged pull request changes, so the saved copy stays right unless <code>@activeRepo.FullName</code> had its history rewritten.
                            </p>
                            <p class="setting__status" data-testid="repo-activity-cache-status" role="status">
                                @ActivityCacheStatus(activeRepo)
                            </p>
                            <div class="setting__actions">
                                <AppButton Variant="ButtonVariant.None"
                                           data-testid="repo-activity-cache-forget"
                                           OnClick="() => ForgetActivityCache(activeRepo)">
                                    Forget this repository's saved pull requests and issues
                                </AppButton>
                            </div>
                        </div>
                    }

                    @if (Features.IsEnabled(TasksFeatures.GitHubIntegration))
                    {
                        <div class="repo-card__section" data-testid="repo-github-access">
                            <h4 class="devbook-folders__title">GitHub access</h4>
                            <p class="setting__note">
                                Signing in with the GitHub CLI is preferred. This repository token is only used as a fallback for <code>@activeRepo.FullName</code> when <code>gh</code> is not signed in.
                            </p>
                            <p class="setting__status" data-testid="github-connection-status" role="status">
                                @(GitHubState.Connection?.Summary ?? "Checking how this machine can reach GitHub...")
                            </p>
                            <TextField Bare="true"
                                       LabelCssClass="setting__label"
                                       InputCssClass="setting__input"
                                       Label="Personal access token"
                                       Id="@($"github-token-{activeRepo.Alias}")"
                                       data-testid="github-token-input"
                                       Type="password"
                                       spellcheck="false"
                                       autocomplete="off"
                                       Placeholder="@(activeRepo.Token is null ? "ghp_..." : "stored - hidden")"
                                       Value="@RepositoryTokenDraft(activeRepo)"
                                       ValueChanged="value => _draftTokens[activeRepo.Alias] = value"
                                       @onchange="() => ApplyRepositoryTokenAsync(activeRepo)"
                                       @onkeydown="e => OnRepositoryTokenKeyDownAsync(e, activeRepo)" />
                            <div class="setting__actions">
                                <AppButton Variant="ButtonVariant.None"
                                           data-testid="github-recheck-button"
                                           OnClick="GitHubState.RefreshConnectionAsync">
                                    Check the connection
                                </AppButton>
                                <AppButton Variant="ButtonVariant.None"
                                           data-testid="github-clear-token-button"
                                           Disabled="@(activeRepo.Token is null)"
                                           OnClick="() => ClearRepositoryTokenAsync(activeRepo)">
                                    Forget this repository token
                                </AppButton>
                            </div>
                            <p class="setting__note">
                                Tokens are kept in <code>@GitHub.Settings.SettingsPath</code> - deliberately outside the backlog folder, so they are never synced or committed with entries.
                            </p>
                        </div>
                    }
                </div>

                @* The blocks other projects add to the card - the
                   Devbook source and sections, which are the shell's:
                   this page belongs to the Tasks module and may not reach
                   Devbook. Each is a column of its own beside the one
                   above, keyed so a card keeps its parts across a
                   re-render. *@
                @foreach (var part in OrderedParts)
                {
                    <DynamicComponent @key="part.Id"
                                      Type="@part.Component"
                                      Parameters="@PartParameters(activeRepo)" />
                }
            </div>
                </ChildContent>
            </TabPanel>
        }
    </Tabs>
}

@code {
    private string _draftRepos = string.Empty;
    private string? _repoError;

    /// <summary>The sentence pointing at Rename after a save of the repositories
    /// text that both removed a repository and added one — or null when the last
    /// save did no such thing.</summary>
    private string? _repoReplacedHint;

    /// <summary>The alias of the repository whose rename form is open, or null
    /// while none is. One at a time: the form sits on the card, and a card shows
    /// one repository.</summary>
    private string? _renamingAlias;
    private string _renameDraft = string.Empty;
    private string? _renameError;

    /// <summary>What the last rename did — the new name, and how many entries
    /// and inbox items followed — and which repository it was, so the sentence
    /// shows on that card alone.</summary>
    private string? _renameNote;
    private string? _renameNoteAlias;

    private readonly Dictionary<string, string> _draftCloneDirectories = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _draftPullRequestLabels = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _pullRequestLabelsErrors = new(StringComparer.Ordinal);
    private readonly HashSet<string> _cloningRepositories = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _draftTokens = new(StringComparer.Ordinal);
    private string? _activeRepositoryAlias;

    private GitHubRepositoryRef? ActiveRepository => FindActiveRepository();

    private bool AdditionalRepositoriesEnabled => Features.IsEnabled(TasksFeatures.AdditionalRepositories);

    private string RepositoryInputLabel => "Repositories";

    private int RepositoryInputRows => Math.Max(4, GitHub.Repositories.Count + 1);

    private string RepositoryInputPlaceholder => "JSdotNet/Backlog\ndocs = JSdotNet/Backlog-docs";

    private IReadOnlyList<GitHubRepositoryRef> VisibleRepositories => GitHub.Repositories;

    private IEnumerable<RepositorySettingsPart> OrderedParts => Parts.OrderBy(part => part.Order);

    /// <summary>The one parameter every part takes: whose card it is on.</summary>
    private static Dictionary<string, object?> PartParameters(GitHubRepositoryRef repository) =>
        new(StringComparer.Ordinal) { [RepositorySettingsPart.RepositoryAliasParameter] = repository.Alias };

    protected override void OnInitialized()
    {
        _activityCache = Services.GetService<IPullRequestDetailCache>();
        _listingCache = Services.GetService<IActivityListingCache>();

        // The store is what the page shows, not a copy taken when it opened: a
        // registry pulled from a paired device, or a write from anywhere else, has
        // to reach the cards. It may land on a thread that is not this one.
        GitHub.Settings.Changed += OnSettingsChanged;

        // The shell hosts this page through a DynamicComponent with no parameters,
        // so the shell re-rendering after a feature switch does not reach it. What
        // the page draws depends on two features, so it hears the switch itself.
        Features.Changed += OnFeaturesChanged;

        // The connection and gh's logins are held once for every settings page
        // that shows them, so an answer another page asked for lands here too.
        GitHubState.Changed += OnGitHubStateChanged;

        _draftRepos = RepositorySettingsText();
        SyncRepositoryDrafts();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await EnsureGitHubStateAsync();
    }

    public void Dispose()
    {
        GitHub.Settings.Changed -= OnSettingsChanged;
        Features.Changed -= OnFeaturesChanged;
        GitHubState.Changed -= OnGitHubStateChanged;
    }

    /// <summary>
    /// Asking GitHub who we are, and gh which logins it holds, are a network call
    /// and a subprocess, so they happen after the page is on screen rather than
    /// holding it up - and only once per opening of the screen, whichever page asks
    /// first.
    /// </summary>
    private async Task EnsureGitHubStateAsync()
    {
        if (!Features.IsEnabled(TasksFeatures.GitHubIntegration)) return;

        await GitHubState.EnsureConnectionAsync();
        await GitHubState.EnsureCliAccountsAsync();
    }

    /// <summary>Redraws for the feature switched, refreshing what the shell used to
    /// refresh when it drew this page itself. Switching GitHub integration on with
    /// the page open asks for the connection the cards now show.</summary>
    private void OnFeaturesChanged() => _ = InvokeAsync(async () =>
    {
        _draftRepos = RepositorySettingsText();
        EnsureActiveRepositoryPage();
        StateHasChanged();

        await EnsureGitHubStateAsync();
    });

    private void OnGitHubStateChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>Refills the drafts from the store and redraws. The repositories
    /// text is left alone: it is the one field a person types a whole list into,
    /// and the saves that change it refill it themselves.</summary>
    private void OnSettingsChanged() => _ = InvokeAsync(() =>
    {
        SyncRepositoryDrafts();
        StateHasChanged();
    });

    private void ShowRepositoryPage(string alias) => _activeRepositoryAlias = GitHubRepositoryRef.NormalizeAlias(alias);

    /// <summary>
    /// Records the repository's colour, or clears it back to automatic. No save
    /// button, the way every other choice on this screen works.
    /// </summary>
    private void ApplyRepositoryColour(GitHubRepositoryRef repository, int? colour) =>
        _repoError = GitHub.Settings.SetRepositoryColour(repository.Alias, colour);

    /// <summary>What the reader is actually getting, said in words — because the
    /// swatches are the only thing on this screen that carries its meaning in colour,
    /// and a reader who cannot see which one is ringed still has to be able to tell
    /// whether they have chosen or are on the default.</summary>
    private string RepositoryColourSummary(GitHubRepositoryRef repository)
    {
        var effective = GitHub.Settings.Current.Colours().GetValueOrDefault(repository.Alias);

        return repository.Colour is null
            ? $"Default — colour {effective}, chosen from the ones no other repository has claimed."
            : $"Colour {repository.Colour} for {repository.FullName}.";
    }

    /// <summary>The input's classes for a field whose rejection is reported in
    /// the status line beside it rather than by the component.</summary>
    private static string SettingInputClass(string? error) =>
        error is null ? "setting__input" : "setting__input setting__input--error";

    /// <summary>Commits the repository list. Lines that aren't repositories are
    /// reported and skipped rather than throwing away the ones around them —
    /// a half-typed line is an ordinary thing to have in a text box.
    /// <para>
    /// The box cannot rename: rows are continued by id, so a line whose
    /// <c>owner/name</c> changed is a removed repository beside a new one. A save
    /// that did both is the shape a rename typed here would take, so it is the
    /// one save that earns a sentence pointing at the Rename control — after the
    /// fact, because refusing the edit would refuse every genuine swap too.
    /// </para></summary>
    private void ApplyRepositories()
    {
        var (repositories, errors) = GitHubSettings.ParseText(_draftRepos);
        var messages = new List<string>(errors);
        var before = GitHub.Settings.Current.Repositories.Select(r => r.FullName).ToList();

        var saveError = GitHub.Settings.SetRepositories(repositories);
        if (saveError is not null) messages.Add(saveError);
        _repoError = messages.Count > 0 ? string.Join(" ", messages) : null;
        _draftRepos = RepositorySettingsText();
        SyncRepositoryDrafts();

        var after = GitHub.Settings.Current.Repositories.Select(r => r.FullName).ToList();
        var removed = before.Where(id => !after.Contains(id, StringComparer.OrdinalIgnoreCase)).ToList();
        var added = after.Where(id => !before.Contains(id, StringComparer.OrdinalIgnoreCase)).ToList();

        _repoReplacedHint = removed.Count > 0 && added.Count > 0
            ? $"Removed {string.Join(", ", removed)} and added {string.Join(", ", added)}. To rename a repository and keep its settings and entries, use Rename on its card."
            : null;
    }

    private void BeginRename(GitHubRepositoryRef repository)
    {
        _renamingAlias = repository.Alias;
        _renameDraft = repository.FullName;
        _renameError = null;
    }

    private void CancelRename()
    {
        _renamingAlias = null;
        _renameDraft = string.Empty;
        _renameError = null;
    }

    private async Task OnRenameKeyDownAsync(KeyboardEventArgs e, GitHubRepositoryRef repository)
    {
        if (e.Key == "Enter") await ApplyRenameAsync(repository);
        else if (e.Key == "Escape") CancelRename();
    }

    /// <summary>
    /// Applies the rename the form asks for: the store moves its row and records
    /// the move, and the entries and inbox items filed against the old id are
    /// carried across here. The registry's record means the next start would
    /// carry them anyway; doing it now is what lets the card say how many
    /// followed, and what spares the working set a session pointing at a
    /// coordinate the registry no longer lists.
    /// <para>
    /// A refusal from the store is the form's to show and leaves the form open:
    /// a name that is not a coordinate, or is taken, is a thing to correct, not
    /// a thing to have tried. Idempotent against the second commit an Enter key
    /// can raise, because a form that has closed has nothing left to apply.
    /// </para>
    /// </summary>
    private async Task ApplyRenameAsync(GitHubRepositoryRef repository)
    {
        if (_renamingAlias != repository.Alias) return;

        var error = GitHub.Settings.RenameRepository(repository.Alias, _renameDraft, out var rename);
        if (rename is null)
        {
            _renameError = error;
            return;
        }

        _repoError = error;
        _draftRepos = RepositorySettingsText();
        SyncRepositoryDrafts();
        CancelRename();

        // A merge leaves no card under the renamed alias, so the note goes on the
        // repository it was folded into, and the active card follows it there.
        var kept = GitHub.Settings.Current.Find(rename.NewId);
        var merged = kept is not null && kept.Alias != repository.Alias;
        if (merged) _activeRepositoryAlias = kept!.Alias;

        _renameNote = await FollowRenameAsync(rename, merged);
        _renameNoteAlias = kept?.Alias ?? repository.Alias;
    }

    /// <summary>
    /// Re-points the entries and inbox items that named the renamed repository
    /// by its old id, and words what happened for the card.
    /// <para>
    /// The entries are this module's own (<see cref="ITaskItems"/>); the inbox
    /// items are the Inbox's, reached through the port an adapter answers
    /// (<see cref="IInboxRepositoryRename"/>), because this page may not see the
    /// Inbox. Both are optional here — a host that composes the page without them
    /// (the storybook, a unit test) has nothing to carry — so each is resolved
    /// rather than injected. A module that refuses is reported in the same breath
    /// rather than swallowed: the registry has already moved on, and an entry left
    /// behind is exactly the thing somebody would want to know about — though the
    /// next start's pass will try it again.
    /// </para>
    /// </summary>
    private async Task<string> FollowRenameAsync(RepositoryRename rename, bool merged)
    {
        var tasks = Services.GetService<ITaskItems>();
        var inbox = Services.GetService<IInboxRepositoryRename>();

        var entries = tasks is null ? 0 : await CountOrReport(tasks.RenameRepositoryAsync(rename.OldId, rename.NewId), "Entries");
        var items = inbox is null ? 0 : await CountOrReport(inbox.RenameRepositoryAsync(rename.OldId, rename.NewId), "Inbox items");

        return $"{(merged ? "Merged" : "Renamed")} {rename.OldId} {(merged ? "into" : "to")} {rename.NewId}; {Plural(entries, "entry", "entries")} and {Plural(items, "inbox item", "inbox items")} followed it.";

        async Task<int> CountOrReport(Task<Result<int>> rewrite, string what)
        {
            var result = await rewrite;
            if (result.IsSuccess) return result.Value;

            var message = $"{what} could not follow the rename: {result.Error.Message}";
            _repoError = _repoError is null ? message : $"{_repoError} {message}";
            return 0;
        }

        static string Plural(int count, string one, string many) => $"{count} {(count == 1 ? one : many)}";
    }

    private void AddRepositoryDraft()
    {
        var separator = string.IsNullOrWhiteSpace(_draftRepos) ? string.Empty : Environment.NewLine;
        _draftRepos = $"{_draftRepos}{separator}new-repository = owner/repo";
        _repoError = "Replace the placeholder with the repository owner/repo, then leave the field to save it.";
    }

    private string CloneDirectoryDraft(GitHubRepositoryRef repo)
    {
        if (!_draftCloneDirectories.TryGetValue(repo.Alias, out var draft))
        {
            draft = repo.CloneDirectory ?? string.Empty;
            _draftCloneDirectories[repo.Alias] = draft;
        }

        return draft;
    }

    private void RemoveRepository(GitHubRepositoryRef repository)
    {
        _repoError = GitHub.Settings.RemoveRepository(repository.Alias);
        _draftRepos = RepositorySettingsText();
        SyncRepositoryDrafts();
    }

    private void ApplyCloneDirectory(string alias)
    {
        _draftCloneDirectories.TryGetValue(alias, out var value);
        _repoError = GitHub.Settings.SetCloneDirectory(alias, value);
        SyncRepositoryDrafts();
    }

    /// <summary>The label filter as the field shows it: what is being typed, else
    /// the stored labels joined the way they are typed.</summary>
    private string PullRequestLabelsDraft(GitHubRepositoryRef repo)
    {
        if (!_draftPullRequestLabels.TryGetValue(repo.Alias, out var draft))
        {
            draft = string.Join(", ", repo.PullRequestLabels);
            _draftPullRequestLabels[repo.Alias] = draft;
        }

        return draft;
    }

    private string? PullRequestLabelsError(GitHubRepositoryRef repo) =>
        _pullRequestLabelsErrors.TryGetValue(repo.Alias, out var error) ? error : null;

    /// <summary>Saves the label filter as the field was left. The store trims,
    /// de-duplicates and drops empty parts, so the field is redrawn from what it
    /// kept rather than from what was typed.</summary>
    private void ApplyPullRequestLabels(string alias)
    {
        _draftPullRequestLabels.TryGetValue(alias, out var value);
        var labels = (value ?? string.Empty).Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);

        var error = GitHub.Settings.SetPullRequestLabels(alias, labels);
        if (error is null)
        {
            _pullRequestLabelsErrors.Remove(alias);
            _draftPullRequestLabels.Remove(alias);
        }
        else
        {
            _pullRequestLabelsErrors[alias] = error;
        }
    }

    // ---- Dashboard activity detail --------------------------------------

    /// <summary>Resolved rather than injected, for the reason the Devices panel's
    /// collaborators are: it is registered by the two desktop heads and by nothing
    /// that only wants a settings screen, and a settings screen that failed to open
    /// because a dashboard cache was absent would be the worse of the two
    /// answers.</summary>
    private IPullRequestDetailCache? _activityCache;

    /// <summary>The listing beside the detail: which pull requests and issues there
    /// were, kept so the next read walks only what changed. Forgotten with the
    /// detail rather than on its own, because "forget this repository" means both
    /// to the person pressing it and a listing without its detail would only save
    /// the cheaper half of the fetch.</summary>
    private IActivityListingCache? _listingCache;

    /// <summary>Which repositories have been forgotten since this screen opened.
    /// Keyed on the alias, so the message follows the repository rather than
    /// whichever card happens to be open.</summary>
    private readonly HashSet<string> _forgottenActivity = new(StringComparer.Ordinal);

    /// <summary>What the section says. Both halves state the cost plainly, because
    /// the cost is the whole of the decision: the next dashboard read is a slow
    /// one.
    /// <para>
    /// The resting half states the rule rather than the state. Nothing here reads
    /// the cache folder, so "saved detail is reused" would be a claim about disk
    /// that this screen has not checked — and on a first run, before any dashboard
    /// read, it would be false. A sentence describing what the app does with detail
    /// once it has it is true whether or not any has been saved yet, which is the
    /// only version of it worth putting on screen.
    /// </para></summary>
    private string ActivityCacheStatus(GitHubRepositoryRef repository) =>
        _forgottenActivity.Contains(repository.Alias)
            ? $"Forgotten. The next dashboard read walks every page and fetches every pull request's detail in {repository.FullName} again, which takes noticeably longer than usual."
            : $"A merged pull request's detail never changes, so it is saved after it is read and only new pull requests cost a call. Forgetting it means the next dashboard read walks every page and fetches every pull request's detail in {repository.FullName} again.";

    /// <summary>Drops one repository's saved listing and pull-request detail.
    /// Nothing else is touched — the other repositories keep theirs, and this one
    /// keeps its settings.</summary>
    private void ForgetActivityCache(GitHubRepositoryRef repository)
    {
        _activityCache?.ForgetRepository(repository);
        _listingCache?.ForgetRepository(repository);
        _forgottenActivity.Add(repository.Alias);
    }

    private LocalGitRepositoryStatus CloneStatus(GitHubRepositoryRef repository) =>
        LocalGit.GetStatus(repository, CloneDirectoryDraft(repository));

    private bool CanClone(GitHubRepositoryRef repository) =>
        !_cloningRepositories.Contains(repository.Alias) && CloneStatus(repository).CanClone;

    private string CloneButtonText(GitHubRepositoryRef repository)
    {
        if (_cloningRepositories.Contains(repository.Alias)) return "Cloning...";

        var status = CloneStatus(repository);
        return status.IsCloned ? "Already cloned" : "Clone repository";
    }

    private async Task CloneRepositoryAsync(GitHubRepositoryRef repository)
    {
        _cloningRepositories.Add(repository.Alias);
        _repoError = null;

        try
        {
            var result = await LocalGit.CloneAsync(repository, CloneDirectoryDraft(repository));
            if (result.Success && result.CloneDirectory is not null)
            {
                _repoError = GitHub.Settings.SetCloneDirectory(repository.Alias, result.CloneDirectory);
            }
            else
            {
                _repoError = result.Message;
            }

            SyncRepositoryDrafts();
        }
        finally
        {
            _cloningRepositories.Remove(repository.Alias);
        }
    }

    private void OnClonePathKeyDown(KeyboardEventArgs e, GitHubRepositoryRef repo)
    {
        if (e.Key == "Enter") ApplyCloneDirectory(repo.Alias);
        else if (e.Key == "Escape") _draftCloneDirectories[repo.Alias] = repo.CloneDirectory ?? string.Empty;
    }

    private void SyncRepositoryDrafts()
    {
        _pullRequestLabelsErrors.Clear();

        foreach (var repo in GitHub.Repositories)
        {
            _draftCloneDirectories[repo.Alias] = repo.CloneDirectory ?? string.Empty;

            // Reset with the others: an alias can come back naming another
            // repository, and a draft kept from the old one would be saved onto it.
            _draftPullRequestLabels[repo.Alias] = string.Join(", ", repo.PullRequestLabels);
        }

        EnsureActiveRepositoryPage();
    }

    private GitHubRepositoryRef? FindActiveRepository()
    {
        if (!VisibleRepositories.Any()) return null;

        if (!string.IsNullOrWhiteSpace(_activeRepositoryAlias))
        {
            var selected = VisibleRepositories.FirstOrDefault(repo => string.Equals(repo.Alias, _activeRepositoryAlias, StringComparison.Ordinal));
            if (selected is not null) return selected;
        }

        return VisibleRepositories[0];
    }

    private void EnsureActiveRepositoryPage()
    {
        if (!VisibleRepositories.Any())
        {
            _activeRepositoryAlias = null;
            return;
        }

        _activeRepositoryAlias = FindActiveRepository()?.Alias;
    }

    private string RepositorySettingsText() => GitHub.Settings.Current.ToText();

    private string RepositoryTokenDraft(GitHubRepositoryRef repo)
    {
        if (!_draftTokens.TryGetValue(repo.Alias, out var draft))
        {
            draft = string.Empty;
            _draftTokens[repo.Alias] = draft;
        }

        return draft;
    }

    private async Task OnRepositoryTokenKeyDownAsync(KeyboardEventArgs e, GitHubRepositoryRef repo)
    {
        if (e.Key == "Enter") await ApplyRepositoryTokenAsync(repo);
        else if (e.Key == "Escape") _draftTokens[repo.Alias] = string.Empty;
    }

    private async Task ApplyRepositoryTokenAsync(GitHubRepositoryRef repo)
    {
        var draft = RepositoryTokenDraft(repo);
        if (string.IsNullOrWhiteSpace(draft)) return;

        _repoError = GitHub.Settings.SetRepositoryToken(repo.Alias, draft);
        _draftTokens[repo.Alias] = string.Empty;
        SyncRepositoryDrafts();

        // Through the shared holder, so the shell's pages that read the connection
        // - the AI page's usage checklist among them - hear the new answer too.
        await GitHubState.RefreshConnectionAsync();
    }

    private async Task ClearRepositoryTokenAsync(GitHubRepositoryRef repo)
    {
        _repoError = GitHub.Settings.SetRepositoryToken(repo.Alias, null);
        _draftTokens[repo.Alias] = string.Empty;
        SyncRepositoryDrafts();
        await GitHubState.RefreshConnectionAsync();
    }

    // ---- Account binding ------------------------------------------------

    /// <summary>
    /// The accounts a repository can be bound to.
    /// <para>
    /// A binding this machine cannot satisfy is carried as an option of its own,
    /// first, even though there is no account behind it. Without one the select
    /// would fall back to its first entry - the empty one - and read as "Default",
    /// which is the opposite of what the registry says and would hide the very
    /// state the Accounts page exists to report.
    /// </para>
    /// <para>
    /// The reason an account cannot be used goes into the option's own text rather
    /// than into <c>SelectorOption.Hint</c>: a native <c>select</c> draws one string
    /// per option, so a hint on this control would be written and never shown.
    /// </para>
    /// </summary>
    private IReadOnlyList<SelectorOption> AccountOptions(GitHubRepositoryRef repository)
    {
        var options = new List<SelectorOption>();

        if (repository.Account is { } bound && GitHub.Settings.Current.Account(bound) is null)
        {
            options.Add(new SelectorOption(bound, $"{bound} - no account on this machine"));
        }

        options.AddRange(GitHub.Settings.Current.Accounts.Select(account => new SelectorOption(
            account.Login,
            RepositoryAccountBinding.AccountProblem(account, GitHubState.CliAccounts) is null
                ? account.Label
                : $"{account.Label} - no credential on this machine")));

        return options;
    }

    /// <summary>Binds this repository to an account, or clears the binding back to
    /// the default. No save button, the way every other choice on this screen
    /// works.</summary>
    private void ApplyRepositoryAccount(GitHubRepositoryRef repository, string? login) =>
        _repoError = GitHub.Settings.SetRepositoryAccount(
            repository.Alias,
            string.IsNullOrWhiteSpace(login) ? null : login);
}
