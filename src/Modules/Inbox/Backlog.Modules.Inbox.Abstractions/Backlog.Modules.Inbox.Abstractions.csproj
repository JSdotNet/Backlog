<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Inbox module's public surface — everything a host, an adapter or the
    Inbox's own UI is allowed to see (ADR 0005, ADR 0009):
      DataTransferObjects/  what a caller receives instead of the aggregate, and
                            the shapes the module's outward ports are phrased in
      Services/             the facade the pane calls (IInboxItems), the two ports
                            sync talks through (IInboxIntake, IInboxCaptureOutbox)
                            and the two ports an adapter answers for the module
                            (IInboxBacklogTarget, IInboxPlanDrafter)
      Enums, InboxEnumMap   the vocabulary those DTOs and the store are written in
      InboxErrors           the Result codes every handler answers with
    The aggregate, its repository ports, and the use-case handlers stay in the
    implementation project. Nothing here may reference it, or anything else in
    the solution beyond the shared kernel.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.Modules.Inbox.Abstractions</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Backlog.SharedKernel\Backlog.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The token tables are worth testing directly rather than only through
         whatever happens to call them. -->
    <InternalsVisibleTo Include="Backlog.Modules.Inbox.UnitTests" />
  </ItemGroup>

</Project>
