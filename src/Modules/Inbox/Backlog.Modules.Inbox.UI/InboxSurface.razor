@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject InboxDesktopState State
@inject IServiceProvider Services

@*
    The Inbox as a shell surface (local ADR 0043 §1): a takeover, in the main window in
    place of the main view or in a window of its own. Escape is not its way out: it
    belongs to the Inbox's own keys, which use it to leave triage, so the surface is
    registered with EscapeCloses off and the shell marks nothing for Escape to close.

    The Inbox loads the first time it is on screen in a window, rather than when the
    window opens: it ships behind a flag, and a store read for a queue nobody opened is
    a store read wasted. Every later opening runs the resurface sweep again, so a
    deferred item due since the Inbox was last on screen is back before anyone reads
    the queue. Capture is another context's, answered through the window's
    InboxSurfaceWiring.

    `item=<id>` opens it on that item, in the slice it is filed in: an event's Talk note
    opens this way. Each jump applies once, when the items are there; an id the Inbox does
    not hold opens the Inbox as it stood.
*@
<InboxPane OnCapture="@CaptureCallback"
           CaptureRunning="@(_wiring?.CaptureRunning?.Invoke() ?? false)"
           CaptureMessage="@(_wiring?.CaptureMessage?.Invoke())"
           Sources="@_wiring?.Sources"
           OnOpenBrainArea="@BrainAreaCallback" />

@code {
    /// <summary>The query the surface was shown with: <c>item</c>, or nothing.</summary>
    [Parameter]
    public IReadOnlyDictionary<string, string>? Query { get; set; }

    /// <summary>The query last handed in, so a newer jump is noticed, and the item it asks for
    /// while that is still to be opened.</summary>
    private IReadOnlyDictionary<string, string>? _query;
    private Guid? _openPending;

    /// <summary>Closes the surface. The Inbox draws no close of its own: its header
    /// option, or another surface's, is the way back.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private InboxSurfaceWiring? _wiring;

    private global::Backlog.SharedKernel.ISurfaceNavigator? _navigator;

    /// <summary>Whether this instance's opening read is done: until it is, a jump waits, so it
    /// is applied to the items as read now rather than to an older snapshot.</summary>
    private bool _opened;

    /// <summary>Whether this instance's own opening read is out: the changes it raises are
    /// waited out rather than taken as another instance's load landing.</summary>
    private bool _readingHere;

    protected override void OnInitialized()
    {
        _wiring = Services.GetService<InboxSurfaceWiring>();
        _navigator = Services.GetService<global::Backlog.SharedKernel.ISurfaceNavigator>();
        State.Changed += OnStateChanged;
    }

    public void Dispose() => State.Changed -= OnStateChanged;

    // Every jump is a new query instance, so the same id asked again opens it again.
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(Query, _query)) return;

        _query = Query;
        _openPending = Query is not null
            && Query.TryGetValue(InboxSurfaceRegistration.ItemKey, out var text)
            && Guid.TryParse(text, out var id)
                ? id
                : null;
        if (_opened) OpenPending();
    }

    /// <summary>Another instance's first load landed while this one waited on it.</summary>
    private void OnStateChanged()
    {
        if (_openPending is not null && !_opened && !_readingHere && State.Loaded)
        {
            _ = InvokeAsync(() =>
            {
                _opened = true;
                OpenPending();
            });
        }
    }

    /// <summary>Opens the item the last jump asked for, once, on the items as read. An id the
    /// Inbox does not hold is let go: a later read never pulls the reader to it.</summary>
    private void OpenPending()
    {
        if (_openPending is not { } id || !State.Loaded) return;

        _openPending = null;
        State.OpenItem(id);
    }

    /// <summary>The Devbook surface's id and the keys it opens the Brain on (local ADR
    /// 0043 §6) — strings, since the Inbox module references no Devbook project:
    /// <c>DevbookSurfaceQuery</c>'s <c>SurfaceId</c>, <c>Scope</c> with its
    /// <c>Brain</c> value, and <c>Chapter</c>, as the Roadmap writes them for a note.</summary>
    private const string DevbookSurfaceId = "devbook";
    private const string ScopeKey = "scope";
    private const string BrainScopeValue = "brain";
    private const string ChapterKey = "chapter";

    /// <summary>Queue health's Brain count pressed: the Devbook on the Brain side, at
    /// the inbox area's tab — the folder with a trailing slash, which names an area
    /// rather than a note. None where the window has no navigator.</summary>
    private EventCallback<string> BrainAreaCallback =>
        _navigator is { } navigator
            ? EventCallback.Factory.Create<string>(this, folder =>
                navigator.Show(DevbookSurfaceId, new Dictionary<string, string>(StringComparer.Ordinal)
                {
                    [ScopeKey] = BrainScopeValue,
                    [ChapterKey] = folder.TrimEnd('/') + "/",
                }))
            : default;

    /// <summary>The Capture button's press, or none where the window offers no capture.
    /// Raised on this component, so the button draws busy while the run is out and the
    /// run's line once it is back.</summary>
    private EventCallback CaptureCallback =>
        _wiring?.Capture is { } capture ? EventCallback.Factory.Create(this, capture) : default;

    /// <summary>The window states whose first load is out, so a surface that remounts
    /// before it is back does not start a second one beside it.</summary>
    private static readonly System.Runtime.CompilerServices.ConditionalWeakTable<InboxDesktopState, object> FirstLoads = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (State.Loaded)
        {
            _readingHere = true;
            try
            {
                await State.OpenedAsync();
            }
            finally
            {
                _readingHere = false;
            }

            _opened = true;
            OpenPending();
            return;
        }

        // Another instance's first load is out: the jump waits for it (OnStateChanged).
        if (!FirstLoads.TryAdd(State, new object())) return;

        _readingHere = true;
        try
        {
            await State.InitializeAsync();
        }
        finally
        {
            _readingHere = false;
            // A load that failed is tried again on the next opening.
            if (!State.Loaded) FirstLoads.Remove(State);
        }

        _opened = true;
        OpenPending();
    }
}
