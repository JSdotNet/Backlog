@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject InboxDesktopState State
@inject IJSRuntime Js

@*
    The Inbox pane: what has been captured but not yet decided on, read the way
    a To Do app reads — lists down the side, the rows of the open list in the
    middle, the chosen row's detail on the right. The pane has no idea a backlog
    row exists: "Move to backlog" is an act the Inbox's own module performs
    through a port, and the shell hears about it afterwards through the state's
    Routed event. That is what keeps triage a decision the Inbox owns rather
    than a view of someone else's list.

    Lists and groups are the structure, and they are the reader's: a starter set
    is seeded on first start and everything after that is made, renamed, filed
    and deleted from the side menu's own context menu. The fixed "Inbox" row is
    the one list nobody made — what has been captured and not yet filed.

    Kinds are a filter, never a section. A queue of forty is read as forty rows
    newest first, and the chips above them narrow it to the videos, or the
    articles, or both. A kind is a fact about a capture; a list is where it goes.

    Three child components rather than one file, split where the state splits:
    the side menu draws lists and groups and owns the menus that change them;
    the item list draws the slice and the chips; the detail draws one item and
    the acts on it. All three read the one state object the shell registers,
    which is what lets the pane be re-mounted in another slot without
    forgetting what was open — the same bargain TasksDesktopState makes.

    The header offers the two ways something gets into the queue: Add, for a
    thing the reader has in their head right now, and Capture, for the sources
    they have asked to be watched. Add is the pane's own: the dialog's title and
    notes go through the state into the Inbox's module as an item, body and all,
    and nothing outside the Inbox learns of it. Capture is raised to the host
    and nothing more — which sources, and what a run is, belongs to the Capture
    context, and the run's outcome comes back as a sentence so the pane never
    learns that context's types either.

    The sources Capture looks at are configured on this pane too, because a
    switch three screens from its button is a switch nobody finds — but not by
    this pane. It offers a slot and the shell fills it with the Capture
    context's own panel, so the pane draws a region it cannot name, the same
    way it raises a run it cannot describe. The slot is a tab beside the queue
    rather than a strip above it: the sources are set once and read in full,
    and a strip over the rows was too short for either.

    The old pane took its items from the shell, which is why the shell knew what
    an inbox item looked like. This one asks its own module; the four
    parameters it does take are the Capture button's and its sources slot, and
    the shell renders it with those alone.

    Triage is meant to be short, so it runs from the keyboard: j and k move
    through the rows, a archives, d defers, l moves to a list, r routes, t goes
    to the tags, x picks, ? lists them all. Whether a key is a shortcut or a
    letter being typed is decided in components.js at the keydown — a key in a
    field, a dialog, or with a modifier held types — because a preventDefault
    rendered from here arrives one key late. Triage mode swaps the columns for
    one item at full width with "12 of 40" over it; each decision moves on, and
    Escape or "Back to the list" returns to the rows on the item it stopped at.
    The Tasks pane binds no letters, so the one key the two share is Escape,
    which in both leaves the mode the reader is in.
*@

<section @key=@("inbox-pane") class="inbox-pane" id="inbox-pane" aria-labelledby="inbox-pane-title" data-testid="inbox-pane">
    @* The library's section header wearing this pane's own class names, with
       the two actions in its slot. Both are drawn whether or not the queue has
       anything in it: an empty Inbox is exactly where somebody reaches for Add. *@
    <SectionHeader BaseClass="inbox-pane__header"
                   TextCssClass=""
                   EyebrowCssClass="inbox-pane__eyebrow"
                   TitleCssClass="inbox-pane__title"
                   DescriptionCssClass="inbox-pane__subtitle"
                   ActionsCssClass="inbox-pane__header-actions"
                   Eyebrow="Global pane"
                   TitleId="inbox-pane-title"
                   Title="Inbox"
                   Description="Capture, file and triage what arrived before it settles into the backlog.">
        <Actions>
            @* The id is for the dialog to hand focus back to on close; it is
               named rather than captured so it survives the header re-rendering
               while the dialog is up. *@
            <AppButton Variant="ButtonVariant.Secondary"
                       Size="ButtonSize.Small"
                       TestId="inbox-pane-add"
                       id="inbox-pane-add"
                       OnClick="OpenAdd">Add</AppButton>
            @* Busy rather than hidden while a run is in flight, so focus survives
               the round trip and a second press cannot start a second run. *@
            <AppButton Variant="ButtonVariant.Secondary"
                       Size="ButtonSize.Small"
                       TestId="inbox-pane-capture"
                       Busy="@CaptureRunning"
                       BusyLabel="Capturing"
                       OnClick="() => OnCapture.InvokeAsync()">Capture</AppButton>
            @* The keys, where a first-time reader looks for what a pane can do:
               beside its other actions, whether or not the queue has rows. *@
            <AppButton Variant="ButtonVariant.Ghost"
                       Size="ButtonSize.Small"
                       TestId="inbox-pane-shortcuts"
                       id="inbox-pane-shortcuts"
                       Title="Keyboard shortcuts (?)"
                       OnClick="OpenShortcuts">Shortcuts</AppButton>
        </Actions>
    </SectionHeader>

    @* What the last run said, wearing this pane's own class. A status rather
       than an alert: a run that found nothing new is the ordinary result, and
       the line is replaced by the next run rather than stacked. Alert renders
       nothing at all for an empty message, so there is no branch here — and
       the pane is a flex column for that reason, so an absent line leaves no
       gap behind. *@
    <Alert Message="@CaptureMessage"
           BaseClass="inbox-pane__capture-result"
           Role="status"
           TestId="inbox-pane-capture-result" />

    @* The sources slot is a tab beside the queue, so whatever the host puts
       there has the pane's whole body rather than a strip above the rows. The
       library's strip, bare, so the list and the two panels are children of
       this flex column and each panel grows into what the header leaves. With
       nothing in the slot there is nothing to switch to, and no strip. *@
    @if (Sources is null)
    {
        @Queue
    }
    else
    {
        <Tabs Bare="true"
              ActiveId="@(State.SourcesShown ? SourcesTabId : QueueTabId)"
              ActiveIdChanged="id => State.ShowSources(id == SourcesTabId)"
              AriaLabel="Inbox views"
              ListCssClass="tabs__list inbox-pane__tabs"
              ListTestId="inbox-pane-tabs">
            <TabPanel Id="@QueueTabId"
                      Title="Inbox"
                      TabTestId="inbox-pane-tab-queue"
                      BaseClass="inbox-pane__queue">
                @Queue
            </TabPanel>
            <TabPanel Id="@SourcesTabId"
                      Title="Sources"
                      TabTestId="inbox-pane-tab-sources"
                      TestId="inbox-pane-sources"
                      BaseClass="inbox-pane__sources">
                @Sources
            </TabPanel>
        </Tabs>
    }

    @* Every key, in one place a reader can open from the header or with ?. *@
    <Modal Open="@_shortcutsOpen"
           OpenChanged="v => _shortcutsOpen = v"
           Title="Keyboard shortcuts"
           RestoreFocusToId="inbox-pane-shortcuts"
           CssClass="inbox-pane__dialog"
           TestId="inbox-shortcuts-dialog">
        <ChildContent>
            <dl class="inbox-pane__shortcuts" data-testid="inbox-shortcuts-list">
                @foreach (var (keys, action) in Shortcuts)
                {
                    <div class="inbox-pane__shortcut">
                        <dt><kbd class="inbox-pane__key">@keys</kbd></dt>
                        <dd>@action</dd>
                    </div>
                }
            </dl>
            <p class="inbox-pane__shortcuts-note">Keys do nothing while you are typing in a field — a letter there is a letter.</p>
        </ChildContent>
    </Modal>

    @* The Add dialog: a title and, optionally, some notes. The shared Modal
       brings the focus handling and Escape; this pane brings two fields and a
       rule — nothing is filed without a title, because the module refuses an
       item without one, and a dialog that offered to try would be offering an
       error. *@
    <Modal Open="@_addOpen"
           OpenChanged="v => _addOpen = v"
           Title="Add to Inbox"
           RestoreFocusToId="inbox-pane-add"
           TestId="inbox-pane-add-dialog">
        <ChildContent>
            @* A layout wrapper for the two fields, the way the import dialog's
               form is one; the fields themselves are the library's, wrapper and
               all, so the dialog needs no styling of its own. *@
            <div class="inbox-pane__add-form">
                <TextField Label="Title"
                           Value="@_title"
                           ValueChanged="v => _title = v"
                           Id="inbox-pane-add-title"
                           TestId="inbox-pane-add-title"
                           autocomplete="off" />
                @* MarkdownEditor rather than a plain TextArea: the notes land in
                   BodyMd and the detail pane reads them back as markdown, so the
                   box they are written in should offer the same formatting every
                   other body in the product gets — a list is a button, not a
                   convention the reader has to know. Label rather than AriaLabel
                   because this stands in a form beside a labelled title. *@
                <MarkdownEditor Label="Notes"
                                Value="@_notes"
                                ValueChanged="v => _notes = v"
                                Id="inbox-pane-add-notes-input"
                                Rows="4"
                                TestId="inbox-pane-add-notes" />
            </div>
        </ChildContent>
        <Footer>
            <AppButton Variant="ButtonVariant.Ghost" OnClick="CloseAdd" TestId="inbox-pane-add-cancel">Cancel</AppButton>
            <AppButton Variant="ButtonVariant.Primary"
                       Disabled="@string.IsNullOrWhiteSpace(_title)"
                       OnClick="SubmitAddAsync"
                       TestId="inbox-pane-add-submit">Add</AppButton>
        </Footer>
    </Modal>
</section>

@code {
    /// <summary>Raised when Capture is pressed. Which sources, and what a run
    /// is, the pane does not know.</summary>
    [Parameter]
    public EventCallback OnCapture { get; set; }

    /// <summary>True while the host has a run in flight; the button is busy
    /// for as long as this is.</summary>
    [Parameter]
    public bool CaptureRunning { get; set; }

    /// <summary>What the last run said, as a sentence. A string rather than a
    /// result type so the Inbox stays free of the Capture context's types — the
    /// host reads the run and writes the line.</summary>
    [Parameter]
    public string? CaptureMessage { get; set; }

    /// <summary>What configures the sources Capture looks at, rendered as the
    /// pane's Sources tab. A fragment rather than a component so the pane never
    /// names the Capture context — the host decides what goes here, and
    /// nothing when there is nothing to configure.</summary>
    [Parameter]
    public RenderFragment? Sources { get; set; }

    /// <summary>The queue: one item at full width in triage mode, the side
    /// menu, rows and detail otherwise. Drawn straight into the pane when there
    /// are no sources, and as the first tab when there are.</summary>
    private RenderFragment Queue => __builder =>
    {
        if (State.TriageMode)
        {
            @* One item at full width: the side menu and the rows step aside, and
               the same detail the columns show takes the whole body, so every act
               it offers is here too. The pager says where in the rows the reader
               is and which keys drive it. *@
            <div class="inbox-pane__triage" data-testid="inbox-triage">
                <div class="inbox-pane__triage-bar">
                    @if (State.TriagePosition >= 0)
                    {
                        <RecordPager Index="@State.TriagePosition"
                                     Total="@State.VisibleItems.Count"
                                     OnPrevious="() => State.Step(-1)"
                                     OnNext="() => State.Step(1)"
                                     PreviousLabel="Previous item"
                                     NextLabel="Next item"
                                     AriaLabel="@($"Triage position in {State.SliceName}")"
                                     Hints="TriageHints"
                                     CssClass="inbox-pane__triage-pager"
                                     TestId="inbox-triage-pager" />
                    }
                    <AppButton Size="ButtonSize.Small"
                               CssClass="inbox-pane__triage-leave"
                               Title="Return to the list on this item (Esc)"
                               OnClick="LeaveTriage"
                               TestId="inbox-triage-leave">Back to the list</AppButton>
                </div>

                @if (State.SelectedItem is null)
                {
                    <EmptyState Title="@($"Nothing left to triage in {State.SliceName}")"
                                Description="Every item here has been decided on. Go back to the list to see where they went."
                                BaseClass="empty-state inbox-pane__empty-state"
                                TestId="inbox-triage-done" />
                }
                else
                {
                    <InboxItemDetail @ref="_detail" State="State" />
                }
            </div>
        }
        else
        {
            <div class="inbox-pane__body" data-testid="inbox-pane-body">
                <InboxSideMenu State="State" />

                @* The list is the fixed pane and the detail takes the rest: a row is a
                   line of metadata that fits a known width, and a detail is a page that
                   wants whatever is left. Anchored at the start for that reason. *@
                <SplitPane CssClass="inbox-pane__split"
                           Anchor="SplitPaneAnchor.Start"
                           FixedWidthRem="28"
                           MinRem="18"
                           AriaLabel="Inbox list width"
                           TestId="inbox-pane-split"
                           SeparatorTestId="inbox-pane-split-handle">
                    <Start>
                        <InboxItemList State="State" />
                    </Start>
                    <End>
                        <InboxItemDetail @ref="_detail" State="State" />
                    </End>
                </SplitPane>
            </div>
        }
    };

    private bool _addOpen;
    private string _title = string.Empty;
    private string _notes = string.Empty;

    private const string PaneId = "inbox-pane";

    private const string QueueTabId = "inbox-queue";
    private const string SourcesTabId = "inbox-sources";

    private bool _shortcutsOpen;
    private InboxItemDetail? _detail;
    private DotNetObjectReference<InboxPane>? _self;

    /// <summary>An element to focus once the render that draws it has landed —
    /// the row a step or a triage session ended on, or the tag field.</summary>
    private string? _focusAfterRender;

    /// <summary>Every key the pane binds, in the order a session uses them.</summary>
    internal static readonly IReadOnlyList<(string Keys, string Action)> Shortcuts =
    [
        ("j", "Next item"),
        ("k", "Previous item"),
        ("a", "Archive"),
        ("d", "Defer…"),
        ("l", "Move to list…"),
        ("r", "Move to backlog"),
        ("t", "Tags"),
        ("x", "Pick the item for a bulk action"),
        ("Esc", "Back to the list, from triage"),
        ("?", "These shortcuts"),
    ];

    private static readonly IReadOnlyList<RecordPagerHint> TriageHints =
    [
        new("j k", "move"),
        new("a", "archive"),
        new("d", "defer"),
        new("l", "list"),
        new("r", "route"),
        new("t", "tags"),
        new("Esc", "back"),
    ];

    protected override void OnInitialized()
    {
        State.Changed += HandleStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("backlogPaneShortcuts.register", PaneId, _self);
        }

        if (_focusAfterRender is { } id)
        {
            _focusAfterRender = null;
            await Js.InvokeVoidAsync("backlogFocus", id, false);
        }
    }

    /// <summary>One shortcut, already judged by components.js to be a shortcut
    /// rather than typing. An act the header would not offer for this item — a
    /// decided item has no Archive — is not offered by its key either.</summary>
    [JSInvokable]
    public async Task OnShortcutAsync(string key)
    {
        await InvokeAsync(async () =>
        {
            // On the Sources tab the rows are not on screen, and a key that
            // decided an item the reader cannot see would be a surprise.
            if (State.SourcesShown && Sources is not null && key != "?") return;

            switch (key)
            {
                case "j":
                case "k":
                    State.Step(key == "j" ? 1 : -1);
                    if (!State.TriageMode && State.SelectedItemId is { } id) _focusAfterRender = InboxItemList.RowId(id);
                    break;
                case "a" when _detail?.CanDecide == true:
                    await State.ArchiveAsync();
                    break;
                case "r" when _detail?.CanDecide == true:
                    await State.RouteToBacklogAsync();
                    break;
                case "d":
                    _detail?.OpenDefer();
                    break;
                case "l":
                    _detail?.OpenMove();
                    break;
                case "t" when _detail?.CanDecide == true:
                    _focusAfterRender = InboxItemDetail.TagsInputId;
                    break;
                case "x" when State.SelectedItemId is { } picked && State.TriagePosition >= 0:
                    State.TogglePicked(picked, !State.IsPicked(picked), range: false);
                    break;
                case "?":
                    _shortcutsOpen = true;
                    break;
                case "Escape" when State.TriageMode:
                    LeaveTriage();
                    break;
                default:
                    return;
            }

            StateHasChanged();
        });
    }

    private void OpenShortcuts() => _shortcutsOpen = true;

    /// <summary>Back to the columns, on the row the session stopped at.</summary>
    private void LeaveTriage()
    {
        State.SetTriageMode(false);
        if (State.SelectedItemId is { } id && State.TriagePosition >= 0) _focusAfterRender = InboxItemList.RowId(id);
    }

    private void OpenAdd() => _addOpen = true;

    private void CloseAdd()
    {
        _addOpen = false;
        _title = string.Empty;
        _notes = string.Empty;
    }

    /// <summary>Closes first, then files. The state's refusal — the only one
    /// the module has is a blank title, which the button already guards — is a
    /// toast, and the item lands selected so the detail opens on it.</summary>
    private async Task SubmitAddAsync()
    {
        // The button is disabled for a blank title, so reaching here with one
        // means the caller went around it; refusing is still cheaper than
        // asking the module to store nothing.
        if (string.IsNullOrWhiteSpace(_title)) return;

        var capture = new InboxCapture(_title.Trim(), _notes.Trim());
        CloseAdd();
        await State.CaptureAsync(capture);
    }

    /// <summary>The state raises from whichever thread finished the store call;
    /// the render is marshalled onto the renderer's.</summary>
    private void HandleStateChanged() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        State.Changed -= HandleStateChanged;

        if (_self is null) return;

        try
        {
            await Js.InvokeVoidAsync("backlogPaneShortcuts.unregister", PaneId);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the page with it; there is nothing left to unregister from.
        }

        _self.Dispose();
    }
}
