@implements IDisposable
@inject TechnologyKnowledgeService TechnologyKnowledge
@inject KnowledgeFolderOpenService KnowledgeFolderOpen

@*
    The "Knowledge base" eyebrow is gone from both branches: the tab strip above
    already says Technology and the eyebrow said only where the reader already
    was. The available branch keeps its heading because that one is the root
    document's own title read off `.tech`, so it names the document rather than
    repeating the section — and this is the one section with no knowledge menu
    beside it, which makes it the only heading that column has. The unavailable
    branch had no document to title, so its hard-coded "Technology" was the
    repeat, and it goes with the eyebrow.
*@

<aside class="knowledge-pane tech-knowledge-pane" data-testid="technology-knowledge-panel" aria-label="Technology knowledge">
    @if (_view is null)
    {
        <Alert Message="Loading technology knowledge..." BaseClass="knowledge-empty" Role="status" />
    }
    else if (!_view.Available)
    {
        <EmptyState BaseClass="knowledge-empty"
                    Title="@_view.Summary"
                    TitleCssClass="@(null)"
                    ActionCssClass="@(null)"
                    role="status">
            <Action>
                <a href="settings">Open repository settings</a>
            </Action>
        </EmptyState>
    }
    else
    {
        @* Title and action on one row. The folder path and the root document's
           summary used to sit between them: the path named a location the reader
           cannot act on from here, and the summary explained a section the reader
           had already chosen. *@
        <header class="knowledge-pane__header">
            <h2>@_view.Title</h2>
            <AppButton BaseClass="knowledge-folder-open"
                       Variant="ButtonVariant.None"
                       TestId="technology-open-vscode-button"
                       Disabled="@_openingTechnologyFolder"
                       title="Open Technology in VS Code"
                       aria-label="Open Technology in VS Code"
                       OnClick="OpenTechnologyFolderAsync">
                @(_openingTechnologyFolder ? "..." : "Open in VS Code")
            </AppButton>
            <Alert Message="@_technologyFolderOpenError"
                   TestId="technology-open-vscode-error"
                   CssClass="knowledge-folder-open-error" />
        </header>

        <section class="tech-stats" aria-label="Technology graph summary">
            <div class="tech-stat">
                <span class="tech-stat__value">@NodeCount</span>
                <span class="tech-stat__label">Technologies</span>
            </div>
            <div class="tech-stat">
                <span class="tech-stat__value">@RelationshipCount</span>
                <span class="tech-stat__label">Depends-on edges</span>
            </div>
            <div class="tech-stat">
                <span class="tech-stat__value">@_view.Layers.Count</span>
                <span class="tech-stat__label">Layers</span>
            </div>
        </section>

        @* Two tabs rather than one long scroll: the graph is what this pane opens
           with, and the layer detail below it — diagram, layer picker, node grid
           — is a second reading of the same folder rather than a continuation of
           the first. *@
        <Tabs AriaLabel="Technology views" TestId="technology-tabs">
            <TabPanel Id="graph"
                      Title="Graph"
                      Element="section"
                      TestId="technology-graph-panel"
                      TabTestId="technology-graph-tab"
                      aria-label="Technology graph">
                @if (_view.Graph.Nodes.Count > 0)
                {
                    <TechnologyGraphView Graph="@_view.Graph" />
                }
            </TabPanel>

            <TabPanel Id="layers"
                      Title="Layers"
                      Element="section"
                      TestId="technology-layers-panel"
                      TabTestId="technology-layers-tab"
                      aria-label="Technology layer detail">
                @if (_view.Diagrams.Count > 0)
                {
                    <DiagramView Title="@_view.Diagrams[0].Title" Language="@_view.Diagrams[0].Language" Source="@_view.Diagrams[0].Source" />
                }

                @if (string.IsNullOrWhiteSpace(SelectedPath))
                {
                    <section class="tech-layer-tabs" aria-label="Technology layers">
                        @foreach (var layer in _view.Layers)
                        {
                            <ToggleButton BaseClass="tech-layer-tab"
                                          PressedCssClass="tech-layer-tab--active"
                                          Pressed="@(ReferenceEquals(layer, ActiveLayer))"
                                          PressedChanged="() => SelectLayer(layer)">
                                <span>@LayerLabel(layer)</span>
                                <Badge BaseClass="tech-layer-tab__count" Kind="">@layer.Nodes.Count</Badge>
                            </ToggleButton>
                        }
                    </section>
                }

                @if (ActiveLayer is { } activeLayer)
                {
                    <section class="tech-layer" aria-label="@activeLayer.Title">
                        <header class="tech-layer__header">
                            <div>
                                <h3>@activeLayer.Title</h3>
                                <p>@activeLayer.FileName</p>
                            </div>
                            @RenderStatusSelect(LayerPath(activeLayer), activeLayer.Title, activeLayer.Metadata.Status ?? "draft")
                        </header>

                        <div class="tech-node-grid">
                            @foreach (var node in activeLayer.Nodes)
                            {
                                <article class="tech-node tech-node--@node.Status" data-testid="technology-node">
                                    <header class="tech-node__header">
                                        <div>
                                            <h4>@node.Label</h4>
                                            <p>@node.Description</p>
                                        </div>
                                        <span class="tech-node__kind">@node.Kind</span>
                                    </header>

                                    <div class="tech-node__meta">
                                        @RenderStatusSelect(node.Id, node.Label, node.Status)
                                        @if (!string.IsNullOrWhiteSpace(node.Metadata.Version))
                                        {
                                            <Badge Kind="">@node.Metadata.Version</Badge>
                                        }
                                    </div>

                                    @* Both relation lists draw the shared reference
                                       control now. They were hand-rolled anchors whose
                                       href was the reference itself — `.arc42/03-….md`
                                       — which the app's own origin has nothing to
                                       serve, so every relation on every node was a way
                                       out of the app to a page that does not exist. The
                                       chip's own class went with them: a reference is a
                                       link, which is the same trade the metadata strip
                                       already made when it stopped drawing badges. *@
                                    @if (node.DependsOn.Count > 0)
                                    {
                                        <div class="tech-node__relations">
                                            <span>Depends on</span>
                                            <div>@RenderRelations(node.DependsOn)</div>
                                        </div>
                                    }

                                    @if (node.Related.Count > 0)
                                    {
                                        <div class="tech-node__relations">
                                            <span>Related</span>
                                            <div>@RenderRelations(node.Related)</div>
                                        </div>
                                    }
                                </article>
                            }
                        </div>

                        @* The layer file itself is not rendered below the grid. The grid is
                           already that file, read — repeating it as prose put the same
                           content on screen twice, once as nodes and once as the document
                           they were parsed from. Editing the file stays available through
                           "Open in VS Code" in the header. *@
                    </section>
                }
            </TabPanel>
        </Tabs>
    }
</aside>

@code {
    private static readonly string[] KnowledgeStatuses = ["draft", "candidate", "accepted", "active", "adopted"];

    private readonly Dictionary<string, string> _statusErrors = new(StringComparer.OrdinalIgnoreCase);
    private TechnologyKnowledgeView? _view;
    private string? _activeLayerFile;
    private string? _loadedRepositoryAlias;
    private bool _openingTechnologyFolder;
    private string? _technologyFolderOpenError;

    [Parameter]
    public string? RepositoryAlias { get; set; }

    [Parameter]
    public string? SelectedPath { get; set; }

    /// <summary>
    /// Raised when a reader follows a relation off a technology node.
    /// <para>
    /// This section has no chapter selection of its own — it is the one section with
    /// no knowledge menu beside it, and its layer tabs are the selection instead —
    /// so what following a relation can move is the section. Which is most of what
    /// these relations are for: a node depends on a runtime and is related to an
    /// architecture chapter, and the chapter is what a reader is trying to get to.
    /// The host decides whether the target exists; a relation that resolves to no
    /// section stays the label it was.
    /// </para>
    /// </summary>
    [Parameter]
    public EventCallback<KnowledgeChapterLink> OnNavigateToChapter { get; set; }

    private TechnologyLayer? ActiveLayer => !string.IsNullOrWhiteSpace(SelectedPath)
        ? _view?.Layers.FirstOrDefault(layer => PathMatches(layer.FileName, SelectedPath)) ?? _view?.Layers.FirstOrDefault()
        : _view?.Layers.FirstOrDefault(layer => layer.FileName == _activeLayerFile) ?? _view?.Layers.FirstOrDefault();

    private int NodeCount => _view?.Layers.Sum(layer => layer.Nodes.Count) ?? 0;

    private int RelationshipCount => _view?.Relationships.Count ?? 0;

    protected override void OnInitialized()
    {
        TechnologyKnowledge.Changed += OnKnowledgeChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_view is null || !string.Equals(_loadedRepositoryAlias, RepositoryAlias, StringComparison.Ordinal))
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _view = await TechnologyKnowledge.ReadAsync(RepositoryAlias);
        _loadedRepositoryAlias = RepositoryAlias;
        if (_view.Layers.All(layer => layer.FileName != _activeLayerFile))
        {
            _activeLayerFile = _view.Layers.FirstOrDefault()?.FileName;
        }
    }

    private void SelectLayer(TechnologyLayer layer) => _activeLayerFile = layer.FileName;

    private async void OnKnowledgeChanged()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private static bool PathMatches(string candidate, string selectedPath)
    {
        var candidatePath = NormalizePath(candidate);
        var selected = NormalizePath(selectedPath);
        return string.Equals(candidatePath, selected, StringComparison.OrdinalIgnoreCase)
            || candidatePath.EndsWith($"/{selected}", StringComparison.OrdinalIgnoreCase)
            || string.Equals(Path.GetFileName(candidatePath), Path.GetFileName(selected), StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizePath(string path) => path.Replace('\\', '/').TrimStart('.', '/');
    private RenderFragment RenderStatusSelect(string itemPath, string title, string status) => @<span class="knowledge-status-control">
        <StatusSelector Id="@StateSelectId(itemPath)"
                        CurrentValue="@status"
                        Options="@StatusOptions(status)"
                        Label="@($"State for {title}")"
                        TestId="knowledge-state-select"
                        OnChanged="value => ChangeKnowledgeStatusAsync(itemPath, status, value)" />
        @if (_statusErrors.TryGetValue(itemPath, out var error))
        {
            <span class="domain-knowledge__action-error" role="status">@error</span>
        }
    </span>;


    private async Task OpenTechnologyFolderAsync()
    {
        _technologyFolderOpenError = null;
        _openingTechnologyFolder = true;
        try
        {
            await KnowledgeFolderOpen.OpenAsync("tech", ".tech", RepositoryAlias);
        }
        catch (KnowledgeFolderOpenException ex)
        {
            _technologyFolderOpenError = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            _technologyFolderOpenError = ex.Message;
        }
        finally
        {
            _openingTechnologyFolder = false;
        }
    }

    private async Task ChangeKnowledgeStatusAsync(string itemPath, string currentStatus, string? status)
    {
        if (string.IsNullOrWhiteSpace(status) || string.Equals(status, currentStatus, StringComparison.OrdinalIgnoreCase)) return;

        _statusErrors.Remove(itemPath);
        try
        {
            await TechnologyKnowledge.UpdateStatusAsync(RepositoryAlias, itemPath, status);
            await LoadAsync();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException or ArgumentException)
        {
            _statusErrors[itemPath] = ex.Message;
        }
    }

    private static IReadOnlyList<SelectorOption> StatusOptions(string status)
    {
        var statuses = KnowledgeStatuses.Contains(status, StringComparer.OrdinalIgnoreCase)
            ? KnowledgeStatuses
            : [.. KnowledgeStatuses, status];
        return [.. statuses.Select(value => new SelectorOption(value, value))];
    }

    private static string LayerLabel(TechnologyLayer layer) => layer.Title.EndsWith(" Technologies", StringComparison.OrdinalIgnoreCase)
        ? layer.Title[..^" Technologies".Length]
        : layer.Title.EndsWith(" Stack", StringComparison.OrdinalIgnoreCase)
            ? layer.Title[..^" Stack".Length]
            : layer.Title;

    private static string LayerPath(TechnologyLayer layer) => $".tech/{layer.FileName}";

    private static string ReferenceLabel(string reference)
    {
        var label = reference[(reference.LastIndexOf('#') + 1)..];
        if (label.Length == reference.Length) label = Path.GetFileNameWithoutExtension(reference);
        return string.Join(' ', label.Split('-', StringSplitOptions.RemoveEmptyEntries).Select(word => char.ToUpperInvariant(word[0]) + word[1..]));
    }

    /// <summary>One relation list, drawn through the shared reference control so a
    /// relation reads and behaves the way one does everywhere else. The label stays
    /// this panel's: the node grid is a summary and a full repository path in a card
    /// this dense is mostly punctuation, so the shortened words go on the control and
    /// the reference itself stays on the title.</summary>
    private RenderFragment RenderRelations(IReadOnlyList<string> references) => __builder =>
    {
        @foreach (var reference in references)
        {
            @if (KnowledgeReference.Parse(reference) is { } parsed)
            {
                <KnowledgeReferenceLink Reference="@parsed"
                                        Text="@ReferenceLabel(reference)"
                                        OnNavigate="NavigateKnowledgeReferenceAsync" />
            }
        }
    };

    /// <summary>Follows a relation by asking the host for the chapter it names. A
    /// relation naming no section resolves to nothing, which leaves the label
    /// reading as the label it always was.</summary>
    private Task NavigateKnowledgeReferenceAsync(KnowledgeReference reference) =>
        KnowledgeChapterLink.From(reference) is { } target ? OnNavigateToChapter.InvokeAsync(target) : Task.CompletedTask;

    private static string StateSelectId(string itemPath) => "knowledge-" + new string(itemPath.Select(ch => char.IsLetterOrDigit(ch) ? ch : '-').ToArray()).Trim('-') + "-state";

    public void Dispose()
    {
        TechnologyKnowledge.Changed -= OnKnowledgeChanged;
    }
}

