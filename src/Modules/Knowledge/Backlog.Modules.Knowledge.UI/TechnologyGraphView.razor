@*
    The technology graph is the shared GraphExplorer — board, roadmap and cloud
    views, zoom and panning all live in the library — plus one app-specific
    adapter: what a status means and which lanes and clusters exist comes from
    .tech metadata, so backlogDiagrams.renderTechnologyGraph in app.js maps that
    metadata into the explorer's model and hands it over.
*@
@* No title, description or badge: the pane above already says Technology and
   counts the technologies and dependencies in its stat tiles, so the header
   here repeated both. An empty Title drops the explorer's header entirely. *@
<GraphExplorer Title=""
               Data="@Graph"
               JsFunction="backlogDiagrams.renderTechnologyGraph"
               StatusText="Rendering technology visualizer..."
               AriaLabel="Technology dependency visualizer" />

@code {
    [Parameter, EditorRequired]
    public TechnologyGraphData Graph { get; set; } = TechnologyGraphData.Empty;
}
