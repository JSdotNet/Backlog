@inject GitHubSettingsStore Repositories
@inject InstructionSourceDiscovery InstructionSources
@inject IKnowledgeFolderSource Folders

@*
    The eyebrow and the title are gone: the tab strip says Instructions and the
    knowledge menu heads its column with it, so a third copy here named the
    section to a reader who had just picked it. The name survives as this
    region's label for a screen reader (.design/accessibility.md, "Names &
    roles"). The subtitle stays — it says which agents' guidance this collects,
    which is the one thing nothing else on the screen answers.
*@

<aside class="knowledge-pane instructions-knowledge" data-testid="instructions-knowledge-panel" aria-label="Instructions knowledge">
    <p class="knowledge-pane__subtitle">
        Agent guidance from GitHub Copilot, Claude Code, and shared <code>AGENTS.md</code> files in the current repository or storage folder.
    </p>

    @if (!_repositories.Any())
    {
        <EmptyState BaseClass="knowledge-empty"
                    TestId="instructions-empty-state"
                    Title="No instruction source is configured."
                    TitleCssClass="@(null)"
                    ActionCssClass="@(null)"
                    role="status">
            <Action>
                <a href="settings">Open storage settings</a>
            </Action>
        </EmptyState>
    }
    else
    {
        @if (ActiveRepository is { } activeRepository)
        {
            <section data-testid="instructions-repository" aria-label="@($"{activeRepository.Repository.FullName} instructions")">
                @* The repository's name is the pane's line above the tabs; this
                   line is about where its clone sits, which the pane does not say. *@
                <div class="knowledge-pane__source">
                    @if (activeRepository.LocalRoot is null)
                    {
                        <span>No local clone directory configured.</span>
                    }
                    else
                    {
                        <code>@activeRepository.LocalRoot</code>
                    }
                </div>

                @if (activeRepository.Message is not null && SelectedDocument is null)
                {
                    <EmptyState BaseClass="knowledge-empty"
                                TestId="instructions-repository-empty"
                                Title="No instruction content to show."
                                TitleCssClass="@(null)"
                                Description="@activeRepository.Message"
                                DescriptionCssClass="@(null)"
                                role="status" />
                }
                else
                {
                    <div class="instructions-layout @(string.IsNullOrWhiteSpace(SelectedPath) ? string.Empty : "instructions-layout--document-only")">
                        @if (string.IsNullOrWhiteSpace(SelectedPath))
                        {
                            <nav class="instructions-list" aria-label="Instruction documents">
                                @foreach (var document in activeRepository.Documents)
                                {
                                    <ToggleButton BaseClass="instructions-list__item"
                                                  PressedCssClass="instructions-list__item--active"
                                                  Pressed="@IsDocumentSelected(document)"
                                                  TestId="instructions-document-button"
                                                  PressedChanged="() => SelectDocument(document.RelativePath)">
                                        <span class="instructions-list__title">@document.RelativePath</span>
                                        <span class="instructions-list__meta">@document.Agent - @document.Scope</span>
                                    </ToggleButton>
                                }
                            </nav>
                        }

                        @if (SelectedDocument is { } selectedDocument)
                        {
                            @* The shared file view, in place of a header and a body this
                               panel used to draw itself. The panel's own pair said the
                               path twice — once beside the name and once on the editing
                               surface's bar — and the way to stop saying it twice was
                               never to delete one of them but to have one component own
                               the identity. Everything the old header carried is here:
                               the short name, the agent and scope and size as the meta
                               line, and the relative path opposite them.

                               A document this may not write keeps its body and loses only
                               the way in, and this is the one area that still has that
                               body: the discovery record read every instruction file in
                               the clone. So there is no BodyContent for it, and the file
                               view reads the record's own text the way it reads any file
                               nobody can write. *@
                            <FileView Name="@selectedDocument.Title"
                                      Source="@selectedDocument.Agent"
                                      Kind="@selectedDocument.Scope"
                                      SizeInBytes="@selectedDocument.SizeBytes"
                                      Path="@selectedDocument.RelativePath"
                                      Body="@(_chapter.Chapter is null ? selectedDocument.Content : null)"
                                      MaxHeight="min(72vh, 52rem)"
                                      TestId="instructions-document"
                                      BodyContent="@(_chapter.Chapter is null ? null : ChapterEditor())" />
                        }
                    </div>
                }
            </section>
        }
    }
</aside>

@code {
    private IReadOnlyList<InstructionRepositoryView> _repositories = [];
    private string? _loadedRepositoryAlias;
    private string? _selectedDocumentPath;
    private KnowledgeChapterContent _chapter = KnowledgeChapterContent.None;
    private InstructionDocument? _chapterDocument;

    [Parameter]
    public string? RepositoryAlias { get; set; }

    [Parameter]
    public string? SelectedPath { get; set; }

    private InstructionRepositoryView? ActiveRepository =>
        string.IsNullOrWhiteSpace(RepositoryAlias)
            ? _repositories.FirstOrDefault(r => string.Equals(r.Repository.Alias, "storage", StringComparison.Ordinal))
            : _repositories.FirstOrDefault(r => string.Equals(r.Repository.Alias, RepositoryAlias, StringComparison.Ordinal));

    private InstructionDocument? SelectedDocument => ResolveSelectedDocument();

    protected override async Task OnParametersSetAsync()
    {
        if (_repositories.Count == 0 || !string.Equals(_loadedRepositoryAlias, RepositoryAlias, StringComparison.Ordinal))
        {
            Discover();
            _selectedDocumentPath = ActiveRepository?.Documents.FirstOrDefault()?.RelativePath;
        }

        await LoadSelectedChapterAsync();
    }

    private void Discover()
    {
        _repositories = string.IsNullOrWhiteSpace(RepositoryAlias)
            ? InstructionSources.Discover([StorageInstructionRepository()])
            : InstructionSources.Discover(Repositories.Current.Repositories);
        _loadedRepositoryAlias = RepositoryAlias;
    }

    /// <summary>
    /// The selected document as a chapter and the text that chapter has right now,
    /// or nothing when it is not somewhere this may write.
    /// <para>
    /// The clone directory is the containment root because that is what the
    /// <c>instructions</c> area is — it has no folder of its own, which is why its
    /// configured default relative path is empty. Discovery already refused
    /// anything outside the instruction roots, and the resolver refuses anything
    /// outside the clone, so a document that reached the list is either placeable
    /// or not offered.
    /// </para>
    /// <para>
    /// The pair is loaded here rather than assembled from the discovery record for
    /// the reason the pair exists at all: the ref and the text have to come from
    /// one read, or the editor holds a body that was true when the list was built
    /// and writes it back over whatever the file says now. Guarded on reference
    /// identity so a parameter set that changed nothing costs no read, and every
    /// re-discovery hands back new records, so a save is read again.
    /// </para>
    /// </summary>
    private async Task LoadSelectedChapterAsync()
    {
        var document = SelectedDocument;
        if (ReferenceEquals(_chapterDocument, document)) return;

        _chapterDocument = document;
        _chapter = ActiveRepository is { } repository && document is not null
            ? await KnowledgeChapterContent.LoadAsync("instructions", repository.LocalRoot, document.RelativePath)
            : KnowledgeChapterContent.None;
    }

    /// <summary>
    /// Discovery again, so the header follows the file.
    /// <para>
    /// It re-reads rather than patching the document in place: the size and the
    /// modified time beside the title come from the file. Deliberately outside
    /// the alias guard in <see cref="OnParametersSetAsync"/> — nothing about the
    /// scope changed, which is exactly why that guard would skip it.
    /// </para>
    /// </summary>
    private async Task OnChapterSavedAsync()
    {
        Discover();
        await LoadSelectedChapterAsync();
    }

    /// <summary>
    /// The chapter as a buffer, for the file view's body.
    /// <para>
    /// The whole file, frontmatter and all. It used to be shown with the
    /// frontmatter cut off, which is the right call for a body nobody can write —
    /// but this one is written back over the source, and a buffer missing the first
    /// four lines would save the file without them. What is on screen is what is on
    /// disk. Which is also why the text comes from the chapter pair and not from
    /// the discovery record beside it: discovery read every instruction file in the
    /// clone to build the list, and a file that changed after that would be edited
    /// from the text it used to have.
    /// </para>
    /// <para>
    /// No Title is handed over. The file view's header above it names the file and
    /// gives its path, and repeating the path on the document bar is the thing this
    /// panel was reported for.
    /// </para>
    /// </summary>
    private RenderFragment ChapterEditor() => @<KnowledgeChapterEditor Chapter="@_chapter.Chapter"
                                                                       InitialText="@_chapter.Text"
                                                                       OnSaved="OnChapterSavedAsync" />;

    private GitHubRepositoryRef StorageInstructionRepository() => new("storage", "Storage", "Folder")
    {
        CloneDirectory = Folders.StorageDirectory,
        KnowledgeFolders = [.. Folders.Folders(null)]
    };

    private InstructionDocument? ResolveSelectedDocument()
    {
        var repository = ActiveRepository;
        if (repository is null) return null;

        if (!string.IsNullOrWhiteSpace(SelectedPath))
        {
            return repository.Documents.FirstOrDefault(d => PathMatches(d.RelativePath, SelectedPath))
                ?? TryReadSelectedInstructionFile(repository, SelectedPath);
        }

        return repository.Documents.FirstOrDefault(d => string.Equals(d.RelativePath, _selectedDocumentPath, StringComparison.OrdinalIgnoreCase))
            ?? repository.Documents.FirstOrDefault();
    }

    private static InstructionDocument? TryReadSelectedInstructionFile(InstructionRepositoryView repository, string selectedPath)
    {
        if (string.IsNullOrWhiteSpace(repository.LocalRoot)) return null;

        var relativePath = NormalizePath(selectedPath);
        if (!IsInstructionRootPath(relativePath)) return null;

        var root = Path.GetFullPath(repository.LocalRoot);
        var fullPath = Path.GetFullPath(Path.Combine(root, relativePath.Replace('/', Path.DirectorySeparatorChar)));
        if (!File.Exists(fullPath) && relativePath.StartsWith(".agent/", StringComparison.OrdinalIgnoreCase))
        {
            var fallbackPath = ".agents/" + relativePath[".agent/".Length..];
            fullPath = Path.GetFullPath(Path.Combine(root, fallbackPath.Replace('/', Path.DirectorySeparatorChar)));
        }

        if (!fullPath.StartsWith(root + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase) || !File.Exists(fullPath)) return null;

        var info = new FileInfo(fullPath);
        return new InstructionDocument(
            Path.GetFileName(relativePath),
            relativePath.Replace('/', Path.DirectorySeparatorChar),
            InstructionAgent(relativePath),
            "Repository file",
            File.ReadAllText(fullPath),
            info.Length,
            info.LastWriteTimeUtc);
    }

    private static bool PathMatches(string candidate, string selectedPath)
    {
        var candidatePath = NormalizePath(candidate);
        var selected = NormalizePath(selectedPath);
        return string.Equals(candidatePath, selected, StringComparison.OrdinalIgnoreCase)
            || candidatePath.EndsWith($"/{selected}", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsInstructionRootPath(string path) =>
        path.StartsWith(".github/", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith(".claude/", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith(".agent/", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith(".agents/", StringComparison.OrdinalIgnoreCase);

    private static string InstructionAgent(string path)
    {
        if (path.StartsWith(".github/", StringComparison.OrdinalIgnoreCase)) return "GitHub Copilot";
        if (path.StartsWith(".claude/", StringComparison.OrdinalIgnoreCase)) return "Claude Code";
        return "Agent instructions";
    }

    private static string NormalizePath(string path) => path.Replace('\\', '/').TrimStart('.', '/').Insert(0, path.TrimStart().StartsWith('.') ? "." : string.Empty);

    private bool IsDocumentSelected(InstructionDocument document) =>
        string.Equals(document.RelativePath, SelectedDocument?.RelativePath, StringComparison.OrdinalIgnoreCase);

    private async Task SelectDocument(string relativePath)
    {
        _selectedDocumentPath = relativePath;
        await LoadSelectedChapterAsync();
    }
}

