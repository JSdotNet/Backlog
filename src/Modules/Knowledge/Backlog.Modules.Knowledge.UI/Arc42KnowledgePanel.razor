@implements IDisposable
@inject Arc42KnowledgeStore Knowledge
@inject IServiceProvider Services
@inject IKnowledgeFolderSource Folders

@*
    No "Knowledge base" eyebrow and no title of its own: the tab strip above this
    panel already says Architecture and the knowledge menu heads its column with
    the same word, so a third copy here was the section announcing itself to a
    reader who had just clicked it. The name survives for a screen reader as this
    region's label (.design/accessibility.md, "Names & roles"). The chapter count
    went with it: the number of chapters is the length of the list beside them, so
    a line above that list saying how many there were was the list counting itself.
*@

<aside class="knowledge-pane knowledge-pane--arc42" data-testid="arc42-knowledge-panel" aria-label="Architecture knowledge">
    @if (_loading)
    {
        <Alert Message="Loading architecture knowledge..." BaseClass="knowledge-empty" Role="status" />
    }
    else if (_catalog is null || !_catalog.Exists)
    {
        <EmptyState BaseClass="knowledge-empty"
                    Title="No arc42 folder here yet."
                    TitleCssClass="knowledge-empty__title"
                    DescriptionCssClass="@(null)"
                    role="status">
            <DescriptionContent>
                Point storage at a repository root that contains <code>.arc42</code> to browse architecture chapters beside the backlog.
            </DescriptionContent>
        </EmptyState>
    }
    else if (_selected is null)
    {
        <EmptyState BaseClass="knowledge-empty"
                    Title="No architecture chapters found."
                    TitleCssClass="knowledge-empty__title"
                    DescriptionCssClass="@(null)"
                    role="status">
            <DescriptionContent>
                The <code>.arc42</code> folder exists, but it does not contain readable Markdown chapters.
            </DescriptionContent>
        </EmptyState>
    }
    else
    {
        @* Two tabs rather than one surface, the same shape the Technology panel
           keeps: the chapters are what this section opens with, and the C4 model is
           a second reading of the same architecture rather than a continuation of
           the first. It is not a chapter and it is in no chapter, so it was never
           going to sit comfortably in the chapter list — which is where it was, and
           why it moved.

           The second tab is absent, not empty, when the feature is off or nobody has
           written a workspace. A tab that opens onto nothing is worse than no tab. *@
        <Tabs AriaLabel="Architecture views"
              TestId="arc42-tabs"
              ActiveId="@_tab"
              ActiveIdChanged="OnTabChanged">

            <TabPanel Id="@ChaptersTab"
                      Title="Chapters"
                      Element="section"
                      TestId="arc42-chapters-panel"
                      TabTestId="arc42-chapters-tab"
                      aria-label="Architecture chapters">
        <div class="arc42-knowledge-layout">
            @if (string.IsNullOrWhiteSpace(SelectedPath))
            {
                <nav class="knowledge-chapters" aria-label="arc42 chapters">
                    @foreach (var chapter in _catalog.Documents)
                    {
                        <div class="knowledge-chapter @(ReferenceEquals(chapter, _selected) ? "knowledge-chapter--active" : string.Empty)" data-testid="arc42-chapter-option">
                            <AppButton BaseClass="knowledge-chapter__button"
                                       Variant="ButtonVariant.None"
                                       aria-current="@(ReferenceEquals(chapter, _selected) ? "page" : null)"
                                       OnClick="() => Select(chapter)">
                                <span class="knowledge-chapter__title">@chapter.Title</span>
                                <span class="knowledge-chapter__meta">
                                    <StatusBadge BaseClass="knowledge-status" Kind="" Status="@chapter.Status" />
                                    @if (chapter.DiagramCount > 0)
                                    {
                                        <span>@chapter.DiagramCount diagram@(chapter.DiagramCount == 1 ? string.Empty : "s")</span>
                                    }
                                </span>
                            </AppButton>
                        </div>
                    }
                </nav>
            }

            @* No longer a card. This article always holds a file view now, and the
               file view draws its own edge, so a card here framed a framed
               document — the nesting that was reported. It stays as an element
               because it is what the knowledge stack scrolls and what holds the
               chapter together; it simply draws nothing of its own. *@
            <article class="knowledge-document" data-testid="arc42-document" aria-label="@_selected.Title">
                @* The panel's own header, its state select, its relation count and
                   its chapter outline are all gone. Each was this panel reading the
                   file a second time to draw around the outside what the file view
                   now draws from the file itself: the state beside the heading it
                   describes, the outline as the headings in the body, a copy button
                   on each chapter. Drawing them here is what made the state appear
                   twice — once as this panel's select and once as the raw `meta`
                   fence in the body — and disagree the moment either was edited.

                   What stays outside the file view is only what is genuinely not in
                   the file: a write that failed. It is the panel's attempt to save
                   that failed, not anything the file says, so it has no place in a
                   body that is the file. *@
                <Alert Message="@_chapterSaveError" TestId="arc42-chapter-save-error" Role="status" />

                @* The same file view every other knowledge area shows a file
                   through, given the same contract, so a chapter reads and edits
                   the same way here as it does on the Domain page: its status where
                   its heading is, its diagrams where their fences are, a copy button
                   per chapter, and the way in and out of editing on the header that
                   already names the file.

                   Body is the file's own text, so the view parses and renders it
                   rather than being handed a block list this panel pre-parsed — the
                   status, the copies and the diagrams are all read from that one
                   text, so there is no second reading to drift from it. It is passed
                   only when there is real text: a chapter that could not be read off
                   disk has none, and then the catalog's parsed content is supplied
                   as the body instead, through BodyContent below. Copy is off for
                   that fallback for the reason the file view names — there is no text
                   to copy — and the view names the chapter either way, which is why
                   the read-only fallback lives inside it and not beside it.

                   Editing is held to the same condition CanEdit is, and not to
                   _editing alone. The file view draws its edit body whenever it is
                   editing and one was handed in, so an edit mode that outlived the
                   chapter it can no longer read would win over the fallback here — the
                   editor would blank its buffer against a chapter that is now None
                   while the way out of edit mode is gone with CanEdit, and the parsed
                   fallback this very state exists to show would never get its turn. A
                   same-path reload can land there: the debounce after a keystroke-save
                   and a background folder change both re-read the open chapter, and a
                   read that comes back empty — locked, gone, or newly unreadable
                   between the catalog read and this one — leaves _editing set with no
                   chapter behind it. Gating the mode on the readable chapter is what
                   makes that transient a read-only render and not a wedged, exit-less
                   blank editor; when the read succeeds again the reader is back where
                   they were writing. *@
                <FileView Name="@_selected.Title"
                          Kind="@ChapterKind(_selected)"
                          Path="@_selected.Path"
                          Body="@_chapter.Text"
                          MaxHeight="@(null)"
                          TestId="arc42-chapter-file"
                          AllowCopy="@(_chapter.Chapter is not null)"
                          AllowChapterCopy="true"
                          RenderKnowledgeMetadata="true"
                          RenderKnowledgeMetadataFields="false"
                          KnowledgeFolder="KnowledgeFolder.Arc42"
                          KnowledgeDocumentPath="@DocumentPath(_selected)"
                          OnKnowledgeStatusChanged="ChangeChapterStatusAsync"
                          OnKnowledgeNavigate="NavigateKnowledgeReferenceAsync"
                          Comments="@ChapterComments()"
                          OnAddComment="index => AddChapterComment(index)"
                          OnResolveComment="ResolveChapterComment"
                          OnEditComment="EditChapterComment"
                          OnDeleteComment="DeleteChapterComment"
                          CanEdit="@(_chapter.Chapter is not null)"
                          Editing="@(_editing && _chapter.Chapter is not null)"
                          EditingChanged="OnEditingChangedAsync"
                          EditBodyContent="@ChapterEditor()"
                          BodyContent="@(_chapter.Chapter is null ? ParsedChapter(_selected) : null)" />

                @* The other half of the reference, under the chapter.
                   It is here rather than in the file view's metadata because this
                   panel deliberately does not draw metadata fields — the note on
                   RenderKnowledgeMetadataFields says why — so a chapter's `related`
                   entry naming a view would otherwise be authored, honoured on the
                   view side, and invisible on the chapter side. Drawn from the same
                   single statement as the view's own list, read the same way. *@
                @if (ViewsReferencedBy(_selected) is { Count: > 0 } chapterViews)
                {
                    <nav class="knowledge-chapters knowledge-chapters--c4" aria-label="C4 views documenting this chapter" data-testid="arc42-chapter-c4-views">
                        @foreach (var view in chapterViews)
                        {
                            <div class="knowledge-chapter" data-testid="arc42-chapter-c4-view">
                                <AppButton BaseClass="knowledge-chapter__button"
                                           Variant="ButtonVariant.None"
                                           title="@view.Reference"
                                           OnClick="() => SelectView(view)">
                                    <span class="knowledge-chapter__title">@view.Title</span>
                                    <span class="knowledge-chapter__meta">
                                        <StatusBadge BaseClass="knowledge-status" Kind="" Status="@ViewKindLabel(view)" />
                                    </span>
                                </AppButton>
                            </div>
                        }
                    </nav>
                }
            </article>
        </div>
            </TabPanel>

            @if (_c4.Workspaces.Count > 0)
            {
                <TabPanel Id="@C4Tab"
                          Title="C4"
                          Element="section"
                          TestId="arc42-c4-panel"
                          TabTestId="arc42-c4-tab"
                          aria-label="C4 model">

                    @* More than one workspace is possible and not expected, so the
                       picker appears only when there is a choice to make. *@
                    @if (_c4.Workspaces.Count > 1)
                    {
                        <nav class="knowledge-chapters" aria-label="C4 workspaces" data-testid="arc42-c4-workspaces">
                            @foreach (var entry in _c4.Workspaces)
                            {
                                <div class="knowledge-chapter" data-testid="arc42-c4-workspace">
                                    <AppButton BaseClass="knowledge-chapter__button"
                                               Variant="ButtonVariant.None"
                                               aria-current="@(ReferenceEquals(entry, Workspace) ? "page" : null)"
                                               OnClick="() => SelectWorkspace(entry)">
                                        <span class="knowledge-chapter__title">@entry.Name</span>
                                    </AppButton>
                                </div>
                            }
                        </nav>
                    }

                    @if (Workspace is { } workspace)
                    {
                        <C4Explorer Workspace="@workspace.Workspace"
                                    Problems="@workspace.Problems"
                                    ViewKey="@_viewKey"
                                    ViewKeyChanged="key => _viewKey = key"
                                    ViewFooter="@ViewReferences"
                                    TestId="arc42-c4-explorer" />
                    }
                </TabPanel>
            }
        </Tabs>
    }
</aside>

@code {
    /// <summary>Remarks on a chapter, kept per chapter path and only for the life
    /// of the app — the same session-scoped shape the Domain panel uses, and
    /// deliberately not written anywhere for the same reason it records: a comment
    /// anchored to a block index needs a home that can be re-anchored when the file
    /// is edited, and choosing one is a decision about a governed knowledge folder
    /// rather than a detail of this panel.</summary>
    private readonly Dictionary<string, List<MarkdownComment>> _chapterComments = new(StringComparer.OrdinalIgnoreCase);

    private Arc42KnowledgeCatalog? _catalog;

    /// <summary>The C4 model beside these chapters. Empty and harmless when the
    /// feature is off, which is what keeps every branch below a no-op rather than a
    /// condition the rest of the panel has to be written around.</summary>
    private C4Catalog _c4 = C4Catalog.Off;

    /// <summary>Which tab is open. Panel state: the host's selection is a chapter
    /// path, and which of two readings of the folder is on screen is not something a
    /// path can say.</summary>
    private string _tab = ChaptersTab;

    /// <summary>The workspace the C4 tab is showing, when there is more than one to
    /// choose between.</summary>
    private C4WorkspaceEntry? _selectedWorkspace;

    /// <summary>Which view the explorer has open. Held here rather than left to the
    /// explorer so that arriving from a chapter reference, or from another section,
    /// opens the view that was asked for.</summary>
    private string? _viewKey;

    private const string ChaptersTab = "chapters";
    private const string C4Tab = "c4";

    /// <summary>The knowledge area this panel's own chapters belong to. A reference
    /// into another section is the host's to follow and leaves this panel's tab
    /// alone — switching to Chapters for a `.domain` target would show the reader a
    /// list they are about to leave.</summary>
    private const string ChaptersArea = "arc42";

    private KnowledgeDocument? _selected;
    private KnowledgeChapterContent _chapter = KnowledgeChapterContent.None;
    private KnowledgeDocument? _chapterDocument;
    private KnowledgeChapterEditor? _editor;
    private string? _chapterSaveError;
    private bool _loading = true;
    private bool _editing;
    private int _nextComment = 1;
    private string? _loadedRepositoryAlias;

    [Parameter]
    public string? RepositoryAlias { get; set; }

    [Parameter]
    public string? SelectedPath { get; set; }

    /// <summary>
    /// Raised when a reader follows a reference to another chapter.
    /// <para>
    /// Which chapter is shown is <see cref="SelectedPath"/>, and that is the host's
    /// — the pane holds one selection per section and this panel is one section's
    /// screen. So following a reference is a request rather than a move: the panel
    /// says which chapter was asked for and the host decides whether it exists. A
    /// host that does not take the callback gets a reference that still reads
    /// correctly and goes nowhere, which is what the standalone page has. The same
    /// shape the Domain panel already keeps.
    /// </para>
    /// </summary>
    [Parameter]
    public EventCallback<KnowledgeChapterLink> OnNavigateToChapter { get; set; }

    /// <summary>
    /// A C4 view to open, named by its reference.
    /// <para>
    /// How a reference from outside this section arrives: a <c>.domain</c> chapter
    /// naming an arc42 C4 view has nowhere to send the reader except here, and the
    /// host cannot select it through the knowledge menu because a view is not a file
    /// in it. So the host names the view and this panel opens it.
    /// </para>
    /// </summary>
    [Parameter]
    public string? SelectedC4View { get; set; }

    /// <summary>
    /// The C4 model, or nothing.
    /// <para>
    /// Resolved from the provider rather than injected, by the same rule the shared
    /// diagram component already follows for Archify artifacts: a host that has not
    /// registered it — the storybook page, a unit test rendering this panel for a
    /// reason that has nothing to do with C4 — gets the panel as it was, rather than
    /// an injection error for a feature it never asked about.
    /// </para>
    /// </summary>
    private C4KnowledgeStore? _c4Store;

    protected override void OnInitialized()
    {
        Knowledge.Changed += OnKnowledgeChanged;

        _c4Store = Services.GetService<C4KnowledgeStore>();
        if (_c4Store is not null) _c4Store.Changed += OnKnowledgeChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_catalog is null || !string.Equals(_loadedRepositoryAlias, RepositoryAlias, StringComparison.Ordinal))
        {
            await LoadAsync();
        }

        SelectRequestedDocument();
        SelectRequestedView();
        await LoadSelectedChapterAsync();
    }

    /// <summary>A folder that moved or changed underneath the panel. A refresh
    /// rather than a load for the same reason a save is: the scope did not change,
    /// and an open editor is not something a background event gets to close.</summary>
    private async void OnKnowledgeChanged()
    {
        await RefreshAsync(_selected?.Path);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>The first load, and any load where what is on screen has stopped
    /// being about the repository being read. The loading line is honest there —
    /// the chapters listed belong to a scope that is leaving — and it is the only
    /// place it is, which is why <see cref="RefreshAsync"/> exists beside
    /// it.</summary>
    private async Task LoadAsync(string? selectedPath = null)
    {
        _loading = true;
        await RefreshAsync(selectedPath);
        _loading = false;
    }

    /// <summary>
    /// The same read without the loading gate.
    /// <para>
    /// <c>_loading</c> takes the whole article off screen, and the editing surface
    /// with it. A save-triggered reload that raised it would dispose the editor
    /// mid-sentence: the textarea would vanish under the caret, and the "Saved" the
    /// save was about to show would be set on a component that no longer renders.
    /// A refresh is for the chrome around the chapter — the counts, the nav, the
    /// state beside the title — and it has no business removing the chapter.
    /// </para>
    /// </summary>
    private async Task RefreshAsync(string? selectedPath = null)
    {
        _catalog = await Knowledge.LoadAsync(RepositoryAlias);
        _c4 = _c4Store is null ? C4Catalog.Off : await _c4Store.LoadAsync(RepositoryAlias);
        _loadedRepositoryAlias = RepositoryAlias;

        // A workspace that is gone must not stay selected. The explorer holds the view
        // and re-resolves it against whatever loaded, so only the workspace is checked
        // here.
        if (_selectedWorkspace is not null && !_c4.Workspaces.Contains(_selectedWorkspace)) _selectedWorkspace = null;
        _selected = selectedPath is null
            ? _catalog.Documents.FirstOrDefault(document => document.DiagramCount > 0) ?? _catalog.Documents.FirstOrDefault()
            : _catalog.Documents.FirstOrDefault(document => PathMatches(document.Path, selectedPath))
                ?? _catalog.Documents.FirstOrDefault(document => document.DiagramCount > 0)
                ?? _catalog.Documents.FirstOrDefault();
        SelectRequestedDocument();
        await LoadSelectedChapterAsync();
    }

    private void SelectRequestedDocument()
    {
        if (_catalog is null || string.IsNullOrWhiteSpace(SelectedPath)) return;

        _selected = _catalog.Documents.FirstOrDefault(document => PathMatches(document.Path, SelectedPath)) ?? _selected;
    }

    private async Task Select(KnowledgeDocument document)
    {
        _selected = document;
        await LoadSelectedChapterAsync();
    }

    /// <summary>
    /// Reads the selected chapter off disk, once per selection.
    /// <para>
    /// The folder comes from the knowledge-folder port and never from
    /// <see cref="Arc42KnowledgeCatalog.RootDirectory"/>: the reader sets that to
    /// the <em>repository</em> the folder sits in, so a chapter rooted there would
    /// hand the writer a containment root covering the whole repository. The port
    /// is asked for the same folder the catalog was built from, rather than
    /// reconstructed by combining a literal <c>.arc42</c> back onto the root.
    /// </para>
    /// <para>
    /// Guarded on reference identity, which is what makes the guard clear itself:
    /// every reload rebuilds the catalog, so the same chapter comes back as a
    /// different record and is read again, while a parameter set that changed
    /// nothing hands back the very document already loaded and costs no read.
    /// </para>
    /// </summary>
    private async Task LoadSelectedChapterAsync()
    {
        if (ReferenceEquals(_chapterDocument, _selected)) return;

        // The same file by path, even though the catalog reload handed back a new
        // record for it: a save re-reads the whole folder, so the open chapter
        // comes back as a different object every time. Reference identity above is
        // the right test for "is there anything to do"; this is the right one for
        // "is this a different chapter", which is what leaving the editor hangs off.
        // Resetting the mode on a same-file reload would close the editor under a
        // reader mid-save — the debounce re-reads through here on every write.
        var sameChapter = string.Equals(_selected?.Path, _chapterDocument?.Path, StringComparison.OrdinalIgnoreCase);

        _chapterDocument = _selected;
        _chapterSaveError = null;
        _chapter = _selected is null
            ? KnowledgeChapterContent.None
            : await KnowledgeChapterContent.LoadAsync("arc42", Folders.Resolve(".arc42", RepositoryAlias), _selected.Path);

        // A different chapter is read fresh, so nothing the last one was doing
        // carries over — including the editing mode, which is now the file view's
        // and no longer the editor's own toggle.
        if (!sameChapter) _editing = false;

        // Blazor assigns a component reference but never clears it, so an editor
        // that has stopped rendering would still be reachable here. Cleared with
        // the chapter it belonged to, which is the condition the markup renders it
        // on.
        if (_chapter.Chapter is null) _editor = null;
    }

    /// <summary>The catalog again, so the chapter list, the summary counts and the
    /// state beside the title follow the file a save just changed.
    /// <see cref="RefreshAsync"/> ignores the repository-alias guard, which is
    /// exactly why it is the one to call here: nothing about the scope changed,
    /// and that is the reason the guard would skip the reload.</summary>
    private Task OnChapterSavedAsync() => RefreshAsync(_selected?.Path);

    /// <summary>A save that failed after the editor stopped being able to say so.
    /// It is shown here because this panel is still on screen when that
    /// happens.</summary>
    private void OnChapterSaveFailed(string message) => _chapterSaveError = message;

    /// <summary>Flushes the editing surface if there is one. Guarded on the same
    /// condition the markup renders it on, because a captured reference outlives
    /// the component it points at.</summary>
    private Task FlushEditorAsync() =>
        _editor is not null && _chapter.Chapter is not null ? _editor.FlushAsync() : Task.CompletedTask;

    private static bool PathMatches(string candidate, string selectedPath)
    {
        var candidatePath = NormalizePath(candidate);
        var selected = NormalizePath(selectedPath);
        return string.Equals(candidatePath, selected, StringComparison.OrdinalIgnoreCase)
            || candidatePath.EndsWith($"/{selected}", StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizePath(string path) => path.Replace('\\', '/').TrimStart('.', '/');

    /// <summary>The chapter as a buffer, and nothing else: no title, because the
    /// file view's header above it names the chapter, and Bare because that header
    /// now carries the way in and out of editing too. Only on screen while the
    /// reader is writing.
    ///
    /// <para>Fill for the other half of that bargain. The file view here is given
    /// no MaxHeight and sits in a scrolling article, so the pane is what decides
    /// how tall the chapter is — and a surface sized by a textarea's row count
    /// would leave the reader a short box with the rest of the pane empty under
    /// it, which is exactly the space the header's Edit button just opened.</para></summary>
    private RenderFragment ChapterEditor() => @<KnowledgeChapterEditor @ref="_editor"
                                                                       Chapter="@_chapter.Chapter"
                                                                       InitialText="@_chapter.Text"
                                                                       Bare="true"
                                                                       Fill="true"
                                                                       OnSaved="OnChapterSavedAsync"
                                                                       OnSaveFailed="OnChapterSaveFailed" />;

    /// <summary>The chapter could not be placed on disk, or could not be read once
    /// it was. Either way there is no text to hand an editor, so what the catalog
    /// already parsed is shown instead — the way in is what is lost, not the
    /// chapter. The file view cannot render this itself: it takes a body as text,
    /// and this is the only form the catalog kept.</summary>
    private RenderFragment ParsedChapter(KnowledgeDocument document) =>
        @<KnowledgeMarkdownView Blocks="@document.ContentBlocks"
                                InlineTarget="@KnowledgeInlineTargets.For(DocumentPath(document), null, EventCallback.Factory.Create<KnowledgeReference>(this, NavigateKnowledgeReferenceAsync))"
                                OnKnowledgeNavigate="NavigateKnowledgeReferenceAsync" />;

    /// <summary>The chapter's path as the rest of the product spells one:
    /// repository-relative, with the area folder on the front.
    ///
    /// <para>The catalog reads the folder and names what it finds relative to it —
    /// <c>08-concepts.md</c>, <c>adr/0001-….md</c> — which is the right spelling for
    /// a menu selection and the wrong one for resolving a link against. A sibling
    /// link in a chapter has to land in the arc42 folder, and against an
    /// area-relative base it would land in the repository root instead: every link
    /// in every chapter, one folder too high. So the prefix goes on here, at the
    /// one place that knows which folder the catalog was read from, rather than
    /// being guessed at inside the resolver.</para></summary>
    private static string DocumentPath(KnowledgeDocument document) =>
        ".arc42/" + document.Path.Replace('\\', '/').TrimStart('/');

    /// <summary>What kind of file the header calls this. arc42 keeps no per-file
    /// kind label the way Domain does, so the one distinction it does draw is the
    /// one it already draws everywhere: a decision record reads differently from a
    /// chapter, and it is the only arc42 file whose folder says so.</summary>
    private static string ChapterKind(KnowledgeDocument document) =>
        IsDecisionRecord(document) ? "Decision record" : "Architecture chapter";

    /// <summary>
    /// A status changed beside a heading in the file view, written to the chapter
    /// that heading belongs to.
    /// <para>
    /// The view reports the heading text; the knowledge writer addresses a status
    /// by path, with the file's own path for its top heading and a <c>path#anchor</c>
    /// for a section under it. The document's title is its top heading, so a match
    /// there is the file itself; anything else is a section, addressed by the slug
    /// of its heading — the same slug the writer derives when it goes looking for
    /// the fence to change.
    /// </para>
    /// <para>
    /// A failed write lands in the same alert a failed save does, for the same
    /// reason: it is the panel's attempt to write the file, not anything the file
    /// says.
    /// </para>
    /// </summary>
    private async Task ChangeChapterStatusAsync(KnowledgeStatusChange change)
    {
        if (_chapterDocument is not { } document || change.Heading is not { } heading) return;

        var itemPath = string.Equals(heading, document.Title, StringComparison.OrdinalIgnoreCase)
            ? document.Path
            : $"{document.Path}#{Slug(heading)}";

        _chapterSaveError = null;
        try
        {
            // The body goes first; KnowledgeChapterEditor.FlushAsync says why. It is
            // rarely anything but a no-op here — the status control lives in the read
            // view and the editor is only on screen while writing, so leaving edit
            // mode has already flushed — but a debounce can still be a moment behind,
            // and the ordering must not depend on it.
            await FlushEditorAsync();

            // A null status is the reader choosing to state none, which removes the
            // field rather than writing a word into it. The two are separate verbs
            // all the way down to the file: an `.arc42` chapter that is simply
            // current says so by saying nothing.
            if (string.IsNullOrWhiteSpace(change.Status))
            {
                await Knowledge.ClearStatusAsync(RepositoryAlias, itemPath);
            }
            else
            {
                await Knowledge.UpdateStatusAsync(RepositoryAlias, itemPath, change.Status);
            }

            await RefreshAsync(document.Path);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException or ArgumentException)
        {
            _chapterSaveError = ex.Message;
        }
    }

    /// <summary>Follows a reference the file view parsed out of the prose, by asking
    /// the host for that chapter — the host owns the selection, so this is a request
    /// and not a move. A reference that does not resolve to a chapter in a section
    /// goes nowhere, which is what leaves a bare file path reading as the text the
    /// author wrote.</summary>
    private Task NavigateKnowledgeReferenceAsync(KnowledgeReference reference)
    {
        // A reference into this section's own C4 model is followed here rather than
        // handed up. The host selects by path in the knowledge menu and a view is not
        // a file in it, so asking the host would be asking for something it cannot
        // do — and the reference would read as a control that goes nowhere.
        if (_c4.Find(reference?.Raw) is { } view)
        {
            SelectView(view);
            return Task.CompletedTask;
        }

        if (reference is null || KnowledgeChapterLink.From(reference) is not { } target) return Task.CompletedTask;

        // A chapter reference brings the Chapters tab with it. Following one from the
        // C4 tab otherwise opened the chapter *behind* the diagram: the host changed
        // its selection, this panel stayed where it was, and the reader was left
        // looking at the picture they had just navigated away from.
        //
        // The mirror of what SelectView does for a view, and for the same reason —
        // the tab is part of the answer to "take me there", not a separate setting
        // the reader is expected to change themselves.
        if (target.AreaKey is ChaptersArea) _tab = ChaptersTab;

        return OnNavigateToChapter.InvokeAsync(target);
    }

    /// <summary>
    /// Into the editor, or back out of it.
    /// <para>
    /// Leaving flushes whatever the debounce still owes and re-reads the folder, so
    /// the read view the reader lands back on is the file as it now is — the status
    /// beside the heading, the chapter titles, the diagrams, all of which this panel
    /// reads from the file the save just changed. The flush goes first, while the
    /// surface that owns the pending write is still on screen.
    /// </para>
    /// </summary>
    private async Task OnEditingChangedAsync(bool editing)
    {
        if (editing)
        {
            _editing = true;
            return;
        }

        await FlushEditorAsync();
        _editing = false;
        await RefreshAsync(_selected?.Path);
    }

    /// <summary>The remarks on the open chapter. A different chapter's remarks stay
    /// with that chapter — they are about its blocks and mean nothing against
    /// another file's.</summary>
    private IReadOnlyList<MarkdownComment> ChapterComments() =>
        _chapterDocument is { } document && _chapterComments.TryGetValue(document.Path, out var comments)
            ? comments
            : [];

    /// <summary>A remark, where it was asked for — empty, because the read view
    /// now opens a fresh one straight into its own textarea rather than asking a
    /// reader to find the Edit button first. The empty body is exactly the signal
    /// that tells it to.</summary>
    private void AddChapterComment(int blockIndex)
    {
        if (_chapterDocument is not { } document) return;

        if (!_chapterComments.TryGetValue(document.Path, out var comments))
        {
            comments = [];
            _chapterComments[document.Path] = comments;
        }

        comments.Add(new MarkdownComment(
            $"remark-{_nextComment++}",
            blockIndex,
            string.Empty,
            "You",
            "just now"));
    }

    /// <summary>Resolved rather than removed: the reason a paragraph reads the way
    /// it does is usually in the remark that got it there. See
    /// <see cref="DeleteChapterComment"/> for the remark that should not stick
    /// around at all.</summary>
    private void ResolveChapterComment(string id) =>
        ReplaceChapterComment(id, comment => comment with { Resolved = !comment.Resolved });

    private void EditChapterComment(MarkdownComment edited) =>
        ReplaceChapterComment(edited.Id, _ => edited);

    /// <summary>Taken away outright — a stray double-press, or a fresh draft
    /// Cancel is abandoning rather than saving.</summary>
    private void DeleteChapterComment(string id)
    {
        if (_chapterDocument is not { } document) return;
        if (!_chapterComments.TryGetValue(document.Path, out var comments)) return;

        comments.RemoveAll(comment => string.Equals(comment.Id, id, StringComparison.Ordinal));
    }

    private void ReplaceChapterComment(string id, Func<MarkdownComment, MarkdownComment> replace)
    {
        if (_chapterDocument is not { } document) return;
        if (!_chapterComments.TryGetValue(document.Path, out var comments)) return;

        var index = comments.FindIndex(comment => string.Equals(comment.Id, id, StringComparison.Ordinal));
        if (index < 0) return;

        comments[index] = replace(comments[index]);
    }

    private static bool IsDecisionRecord(KnowledgeDocument document) => Arc42KnowledgeCatalog.IsDecisionRecord(document.Path);

    /// <summary>The heading's anchor, made the same way the knowledge writer makes
    /// it when it goes looking for the fence to change — letters and digits kept,
    /// everything else a single hyphen. The two have to agree: the anchor this hands
    /// the writer is matched back against the slug the writer derives from the file,
    /// and a chapter whose status could not be found is a control that writes
    /// nowhere.</summary>
    private static string Slug(string heading)
    {
        var chars = heading.ToLowerInvariant().Select(ch => char.IsLetterOrDigit(ch) ? ch : '-').ToArray();
        return string.Join('-', new string(chars).Split('-', StringSplitOptions.RemoveEmptyEntries));
    }

    // ---- the C4 model beside the chapters ----------------------------------

    /// <summary>The workspace the C4 tab is on: the one chosen, or the only one
    /// there is.</summary>
    private C4WorkspaceEntry? Workspace =>
        _selectedWorkspace is not null && _c4.Workspaces.Contains(_selectedWorkspace)
            ? _selectedWorkspace
            : _c4.Workspaces.FirstOrDefault();

    private void SelectWorkspace(C4WorkspaceEntry entry)
    {
        _selectedWorkspace = entry;
        _viewKey = null;
    }

    private void OnTabChanged(string tab) => _tab = tab;

    /// <summary>The view the host asked for, if it names one these workspaces have.
    /// A reference that resolves to nothing leaves the panel where it was rather than
    /// switching tabs for a view that does not exist.</summary>
    private void SelectRequestedView()
    {
        if (string.IsNullOrWhiteSpace(SelectedC4View)) return;
        if (_c4.Find(SelectedC4View) is not { } view) return;

        SelectView(view);
    }

    /// <summary>
    /// Opening a view: the C4 tab, on that view's workspace, at that view.
    /// <para>
    /// Switching the tab is the point. Every way in — a chapter that lists the views
    /// documenting it, a <c>.domain</c> chapter reaching across, the host naming one —
    /// asks for a picture, and leaving the reader on the chapters tab with the
    /// selection changed underneath them answers a question nobody asked.
    /// </para>
    /// </summary>
    private void SelectView(C4ViewEntry view)
    {
        _selectedWorkspace = _c4.WorkspaceOf(view) ?? _selectedWorkspace;
        _viewKey = view.Key;
        _tab = C4Tab;
    }

    /// <summary>The chapters the open view documents, drawn under the diagram. Handed
    /// to the explorer as a slot because the component library has no idea what a
    /// knowledge chapter is, and should not learn.</summary>
    private RenderFragment<C4View> ViewReferences => view => builder =>
    {
        var references = ReferencesTo(view);
        var sequence = 0;

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "knowledge-c4-references");
        builder.AddAttribute(sequence++, "data-testid", "arc42-c4-view-references");

        if (references.Count > 0)
        {
            builder.OpenComponent<MetadataReferenceList>(sequence++);
            builder.AddAttribute(sequence++, "References", references);
            builder.AddAttribute(sequence++, "OnNavigate", EventCallback.Factory.Create<KnowledgeReference>(this, NavigateKnowledgeReferenceAsync));
            builder.CloseComponent();
        }
        else
        {
            builder.OpenComponent<Alert>(sequence++);
            builder.AddAttribute(sequence++, "Message", "No chapter references this view yet. Name it in _c4/references.json to tie the two together.");
            builder.AddAttribute(sequence++, "TestId", "arc42-c4-view-unreferenced");
            builder.AddAttribute(sequence++, "Role", "status");
            builder.CloseComponent();
        }

        builder.CloseElement();
    };

    /// <summary>The view kind as a reader says it: "System Context", not
    /// "SystemContext".</summary>
    private static string ViewKindLabel(C4ViewEntry view) => view.Kind switch
    {
        C4ViewKind.SystemLandscape => "System landscape",
        C4ViewKind.SystemContext => "System context",
        C4ViewKind.Container => "Container",
        C4ViewKind.Component => "Component",
        C4ViewKind.Dynamic => "Dynamic",
        C4ViewKind.Deployment => "Deployment",
        _ => "C4"
    };

    /// <summary>
    /// The chapters the open view documents, as <c>_c4/references.json</c> states
    /// them.
    /// <para>
    /// One authored statement, read here as written and inverted for the chapter side
    /// — so the two directions cannot disagree, because there is only one of them on
    /// disk. A reference may name a section and this keeps the section: it is part of
    /// what the author wrote. Whether a given chapter counts as documented is a
    /// question about the file, which is <c>C4ViewEntry.Documented</c>.
    /// </para>
    /// </summary>
    private List<KnowledgeReference> ReferencesTo(C4View view) =>
        [.. (Workspace?.Documents(view.Key) ?? []).Select(KnowledgeReference.Parse).OfType<KnowledgeReference>()];

    /// <summary>The views that say they document this chapter — the same authored
    /// statement as <see cref="ReferencesTo"/> reads, inverted.</summary>
    private List<C4ViewEntry> ViewsReferencedBy(KnowledgeDocument? document) =>
        document is null || !_c4.HasViews
            ? []
            : [.. _c4.Views.Where(view => view.Documented(document.Path))];

    private List<C4WorkspaceProblem> ProblemsFor(C4ViewEntry view) =>
        [.. _c4.Problems.Where(problem => string.Equals(problem.WorkspaceFile, view.WorkspaceFile, StringComparison.OrdinalIgnoreCase))];

    public void Dispose()
    {
        Knowledge.Changed -= OnKnowledgeChanged;
        if (_c4Store is not null) _c4Store.Changed -= OnKnowledgeChanged;
    }
}
