@implements IDisposable
@using Backlog.Infrastructure.Copilot
@inject DomainKnowledgeStore DomainKnowledge
@inject KnowledgeCopilotCli KnowledgeCopilot
@inject IGitFileHistoryService GitHistory
@inject IAppFeatureSettings Features

@*
    The pane above already says which section this is — the tab strip names it and
    the knowledge menu heads its column with it — so this panel no longer opens
    with a "Knowledge base" eyebrow and a title repeating the same word a third
    time. It names itself to a screen reader instead, the way every other labelled
    region in this product does (.design/accessibility.md, "Names & roles"). The
    same rule the chapter documents already follow, one level up: the article
    header gives up kind, title and path to the file view that says all three.
*@

<section class="domain-knowledge @(Compact ? "domain-knowledge--compact" : string.Empty)" data-testid="domain-knowledge-panel" aria-label="Domain knowledge">
    @if (_view is null)
    {
        <Alert Message="Loading domain knowledge..." BaseClass="domain-knowledge__state" Role="status" />
    }
    else if (_view.Error is not null)
    {
        <div class="domain-knowledge__empty" role="status">
            <p>@_view.Error</p>
            <a class="md-link" href="settings">Configure repository knowledge folders</a>
        </div>
    }
    else
    {
        @* The folder's own path is gone from here. It said where the knowledge
           folder is, which is a fact about the workspace rather than about
           anything on this screen; the file the reader opened says where it is on
           the file view's header, and that one is the file's identity. *@
        @if (string.IsNullOrWhiteSpace(SelectedPath))
        {
            <nav class="domain-knowledge__contexts" aria-label="Bounded contexts">
                <ToggleButton BaseClass="domain-context-tab"
                              PressedCssClass="domain-context-tab--active"
                              Pressed="@IsContextSelected(null)"
                              PressedChanged="() => SelectContext(null)">Context map</ToggleButton>
                @foreach (var context in _view.Contexts)
                {
                    <ToggleButton BaseClass="domain-context-tab"
                                  PressedCssClass="domain-context-tab--active"
                                  Pressed="@IsContextSelected(context)"
                                  PressedChanged="() => SelectContext(context)">@context.DisplayName</ToggleButton>
                }
            </nav>
        }

        @if (SelectedDocument is { } selectedDocument)
        {
            @RenderDocument(selectedDocument, DocumentClass(selectedDocument))
        }
        else if (SelectedContext is null)
        {
            @RenderDocument(_view.ContextMap, "domain-document--context-map")
        }
        else
        {
            <article class="domain-context" data-testid="domain-context">
                <header class="domain-context__header">
                    <div>
                        <p class="domain-knowledge__eyebrow">Bounded context</p>
                        <h3>@SelectedContext.DisplayName</h3>
                    </div>
                    @* The library's status badge, which composes exactly the three
                       classes this span spelled out. FallbackSlug is the domain's own
                       word rather than the component's "draft" default: a context with
                       no status reads "none" everywhere else in this panel, and a badge
                       that invented "draft" would disagree with the store. *@
                    <StatusBadge Kind="domain-status" Status="@SelectedContext.Status" FallbackSlug="none" />
                </header>

                <div class="domain-context__documents">
                    @foreach (var document in SelectedContext.Documents)
                    {
                        @RenderDocument(document, DocumentClass(document))
                    }
                </div>
            </article>
        }
    }
</section>

@code {
    private static readonly string[] KnowledgeStatuses = ["draft", "candidate", "accepted", "active", "adopted"];
    private static readonly HashSet<string> HeaderMetadataKeys = new(StringComparer.OrdinalIgnoreCase) { "status", "knowledge-issue", "github-issue", "issue" };
    private static readonly HashSet<string> NavigableMetadataKeys = new(StringComparer.OrdinalIgnoreCase) { "implements", "implemented-by", "related", "depends-on", "refines", "supersedes" };

    /// <summary>The chapter as it was when it was opened, and the chapter as it
    /// was last committed. Two answers to "compared with what?", and the two a
    /// reader of a knowledge folder actually asks: what have I changed in this
    /// sitting, and what has changed since this was agreed.</summary>
    private const string OpenedBaselineId = "opened";

    private const string CommittedBaselineId = "committed";

    /// <summary>This panel's own section, as the menu and the area catalog name
    /// it. A reference into it moves the context column beside the chapter; a
    /// reference out of it is somebody else's section to show.</summary>
    private const string DomainAreaKey = "domain";

    private readonly HashSet<string> _copilotBusy = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _copilotErrors = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _statusErrors = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Remarks on a chapter, kept per chapter path and only for as long as the app
    /// is running.
    /// <para>
    /// Deliberately not written anywhere. A comment anchored to a block index needs
    /// a home that can be re-anchored when the file is edited, and choosing that
    /// home — a sidecar file beside the chapter, or markers inside it — is a
    /// decision about a governed knowledge folder rather than a detail of this
    /// panel. Session-scoped remarks are useful now and commit the repository to
    /// nothing.
    /// </para>
    /// </summary>
    private readonly Dictionary<string, List<MarkdownComment>> _chapterComments = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Which of the chapter's headings state a status of their own, and
    /// so which of them the read view is already showing a control for.</summary>
    private HashSet<string> _statusHeadings = new(StringComparer.OrdinalIgnoreCase);

    private string? _chapterRoot;
    private string? _openedText;
    private string? _committedText;
    private string? _committedUnavailable;
    private bool _committedRead;
    private bool _disposed;
    private int _nextComment = 1;
    private bool _editing;
    private bool _comparing;
    private string _baselineId = OpenedBaselineId;
    private DomainKnowledgeView? _view;
    private KnowledgeChapterContent _chapter = KnowledgeChapterContent.None;
    private DomainKnowledgeDocument? _chapterDocument;
    private KnowledgeChapterEditor? _editor;
    private string? _chapterSaveError;
    private string? _selectedContextSlug;
    private string? _loadedRepositoryAlias;

    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public DomainKnowledgeView? View { get; set; }

    [Parameter]
    public string? RepositoryAlias { get; set; }

    [Parameter]
    public string? SelectedPath { get; set; }

    /// <summary>
    /// Raised when a reader follows a reference to another chapter.
    /// <para>
    /// Which chapter is shown is <see cref="SelectedPath"/>, and that is the host's
    /// — the pane holds one selection per section and this panel is one section's
    /// screen. So following a reference is a request rather than a move: the panel
    /// says which chapter was asked for and the host decides whether it exists and
    /// what to select. A host that does not take the callback gets a reference that
    /// still reads correctly and goes nowhere, which is what the standalone Domain
    /// page has always had.
    /// </para>
    /// </summary>
    [Parameter]
    public EventCallback<KnowledgeChapterLink> OnNavigateToChapter { get; set; }

    private DomainKnowledgeContext? SelectedContext => _view?.Contexts.FirstOrDefault(c => c.Slug == _selectedContextSlug);

    private DomainKnowledgeDocument? SelectedDocument => string.IsNullOrWhiteSpace(SelectedPath) || _view is null
        ? null
        : new[] { _view.ContextMap }
            .Concat(_view.Contexts.SelectMany(context => context.Documents))
            .FirstOrDefault(document => PathMatches(document.Path, SelectedPath));

    protected override void OnInitialized()
    {
        DomainKnowledge.Changed += OnKnowledgeChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (View is not null)
        {
            _view = View;
        }
        else if (_view is null || !string.Equals(_loadedRepositoryAlias, RepositoryAlias, StringComparison.Ordinal))
        {
            _view = await DomainKnowledge.LoadAsync(RepositoryAlias);
            _loadedRepositoryAlias = RepositoryAlias;
        }
        SelectDefaultContext();

        await LoadSelectedChapterAsync();
    }

    /// <summary>The configured folder moved, so every cached read is stale —
    /// including the open chapter, which is why this goes through
    /// <see cref="ReloadAsync"/> rather than re-reading the view alone. A
    /// parent-supplied <see cref="View"/> is the parent's to refresh, not
    /// ours.</summary>
    private async void OnKnowledgeChanged()
    {
        if (View is not null) return;

        await ReloadAsync();
        SelectDefaultContext();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>A reload can drop the selected context, so the selection is
    /// re-resolved against whatever loaded.</summary>
    private void SelectDefaultContext()
    {
        if (_view is null) return;
        if (_selectedContextSlug is null || !_view.Contexts.Any(c => c.Slug == _selectedContextSlug))
        {
            _selectedContextSlug = Compact ? _view.Contexts.FirstOrDefault()?.Slug : null;
        }
    }

    /// <summary>
    /// Reads the selected chapter off disk, once per selection.
    /// <para>
    /// The root is the view's own <see cref="DomainKnowledgeView.RootPath"/> —
    /// the <c>.domain</c> folder the port resolved, not the repository above it —
    /// and the selection is the document's path, which names a file and so never
    /// carries an anchor. Sections do carry one, in <c>path#slug</c> form, but a
    /// section is not a chapter: it is the same file, and only its state and its
    /// Copilot launch are addressed that way.
    /// </para>
    /// <para>
    /// Guarded on reference identity so a parameter set that changed nothing
    /// costs no read. A reload forces past it, because a view handed in by a
    /// parent can come back with the same records after the file underneath them
    /// changed.
    /// </para>
    /// </summary>
    private async Task LoadSelectedChapterAsync(bool force = false)
    {
        var document = SelectedDocument;
        if (!force && ReferenceEquals(_chapterDocument, document)) return;

        // By path and not by reference: a reload re-parses the folder, so the same
        // file comes back as a different record every time. Reference identity is
        // the right test for "is there anything to do" above and the wrong one for
        // "is this a different chapter" — which is the question the baselines, the
        // modes and the committed read all hang off.
        // The root belongs in the comparison too: the same relative path under a
        // folder that has moved is a different file, and a baseline read from the
        // one before it would compare a chapter against somebody else's copy of it.
        var sameChapter = string.Equals(document?.Path, _chapterDocument?.Path, StringComparison.OrdinalIgnoreCase)
            && string.Equals(_view?.RootPath, _chapterRoot, StringComparison.OrdinalIgnoreCase);

        _chapterRoot = _view?.RootPath;

        _chapterDocument = document;
        _chapterSaveError = null;
        _chapter = _view is null || document is null
            ? KnowledgeChapterContent.None
            : await KnowledgeChapterContent.LoadAsync("domain", _view.RootPath, document.Path);

        _statusHeadings = HeadingsWithStatus(_chapter.Text);

        if (sameChapter)
        {
            // The working copy moved on; the commit did not. Re-running git on
            // every debounce would spend a process to be told the same thing.
            _openedText ??= _chapter.Text;
        }
        else
        {
            // A different file: every one of these was about the last one.
            _openedText = _chapter.Text;
            _committedText = null;
            _committedUnavailable = null;
            _committedRead = false;
            _baselineId = OpenedBaselineId;
            _editing = false;
            _comparing = false;
        }

        // Blazor assigns a component reference but never clears it, so an editor
        // that has stopped rendering would still be reachable here. Cleared with
        // the chapter it belonged to, which is the condition the markup renders it
        // on.
        if (_chapter.Chapter is null) _editor = null;

        BeginCommittedBaselineRead();
    }

    /// <summary>
    /// Asks git what this chapter last looked like, as it opens, and lets the
    /// answer land on its own.
    /// <para>
    /// The read used to wait for a reader to press Compare, which made the press
    /// the only thing that could produce the answer — and the control deciding
    /// whether to offer itself had to keep offering itself in the meantime. So the
    /// button appeared on every chapter in the folder and said nothing about any of
    /// them. Whether there is a difference worth showing is a question about the
    /// file, and it has to be answered before the control claims there is.
    /// </para>
    /// <para>
    /// Not awaited, because a git process in front of the first paint would make
    /// every chapter open at the speed of a subprocess, and the chapter is what the
    /// reader came for. It is a read per chapter open and not per keystroke:
    /// <see cref="_committedRead"/> is reset only when the chapter changes, so the
    /// debounced reloads that follow an edit find it already answered.
    /// </para>
    /// </summary>
    private async void BeginCommittedBaselineRead()
    {
        if (_committedRead || _chapter.Chapter is null) return;

        await ReadCommittedBaselineAsync();

        // A reader can leave the section while git is still answering, and a
        // re-render asked for after this panel is gone is asked of a renderer that
        // may have shut down with it. The answer is kept either way — it is a field
        // on a panel nobody is looking at — so there is nothing to report.
        if (_disposed) return;

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// The view again, past the repository-alias guard.
    /// <para>
    /// <see cref="OnParametersSetAsync"/> reloads only when the scope changed,
    /// which is the right rule for a parameter set and the wrong one after a
    /// save: the file changed and the alias did not, so that guard would skip
    /// precisely the reload that is needed.
    /// </para>
    /// </summary>
    private async Task ReloadAsync()
    {
        _view = await DomainKnowledge.LoadAsync(RepositoryAlias);
        _loadedRepositoryAlias = RepositoryAlias;
        await LoadSelectedChapterAsync(force: true);
    }

    /// <summary>Everything the panel derives from the chapter — the status beside
    /// the title, the metadata rows, the section list — is read from the file, so
    /// a save makes all of it stale at once.</summary>
    private Task OnChapterSavedAsync() => ReloadAsync();

    /// <summary>
    /// Into the editor, or back out of it.
    /// <para>
    /// Leaving writes whatever the debounce still owes and re-reads the folder, so
    /// the rendering the reader lands back on is the file as it now is — including
    /// the statuses, diagrams and chapter titles this panel derives from it. Coming
    /// back to a rendering of the text as it was before they typed is the bug this
    /// avoids, and it is not a hypothetical: the read view is drawn from the parse,
    /// and the parse was made before the keystrokes.
    /// </para>
    /// </summary>
    private async Task OnEditingChangedAsync(bool editing)
    {
        if (editing)
        {
            _editing = true;
            return;
        }

        // The body goes first, while the surface that owns the pending write is
        // still the thing on screen — the same order the status handler keeps, and
        // for the same reason.
        await FlushEditorAsync();
        _editing = false;
        await ReloadAsync();
    }

    /// <summary>
    /// Into the comparison, or back out.
    /// <para>
    /// The file goes to disk first, for the same reason the status handler flushes:
    /// a comparison is between two versions of a file, and a keystroke the debounce
    /// has not written yet is not a version of anything. The committed read is asked
    /// for again here and is almost always already done — the chapter opening starts
    /// it — but a reader who presses Compare while it is still in flight, or who
    /// pressed it on a chapter whose read never began, must not be left comparing
    /// against nothing.
    /// </para>
    /// </summary>
    private async Task OnComparingChangedAsync(bool comparing)
    {
        if (!comparing)
        {
            _comparing = false;
            return;
        }

        await FlushEditorAsync();
        _comparing = true;
        await ReloadAsync();
        await ReadCommittedBaselineAsync();
    }

    private async Task OnBaselineChangedAsync(string baselineId)
    {
        _baselineId = baselineId;
        await ReadCommittedBaselineAsync();
    }

    /// <summary>
    /// The chapter's committed version, read once per chapter.
    /// <para>
    /// Once, and not once per baseline the reader picks: the guard is the chapter's
    /// own <see cref="_committedRead"/> and nothing else. It used to also refuse
    /// unless the committed baseline was the selected one, which made the selection
    /// the only thing that could start the read — and the offer to compare was being
    /// decided from an answer that selection was waiting for.
    /// </para>
    /// <para>
    /// "Never committed" is an ordinary answer and not a failure — a chapter written
    /// this morning has no earlier version — so it is said in the reader's terms
    /// instead of being reported as an error. What git says when it genuinely fails
    /// is passed through unchanged: this panel has no better wording for it than
    /// git's own.
    /// </para>
    /// </summary>
    private async Task ReadCommittedBaselineAsync()
    {
        if (_committedRead || _chapter.Chapter is not { } chapter) return;

        _committedRead = true;
        var result = await GitHistory.ReadAtHeadAsync(chapter.FullPath);

        (_committedText, _committedUnavailable) = result.State switch
        {
            GitFileAtRevisionState.Committed => (result.Content, (string?)null),
            GitFileAtRevisionState.NotTracked => (null, "This chapter has not been committed yet, so there is no earlier version of it to compare with."),
            GitFileAtRevisionState.NotARepository => (null, result.Message ?? "The knowledge folder is not inside a git repository."),
            _ => (null, result.Message ?? "Git could not read the committed version of this chapter.")
        };
    }

    /// <summary>
    /// What the chapter can be compared against, in the order a reader reaches for
    /// them.
    /// <para>
    /// The commit joins the list when git has answered for it, and not before. A
    /// baseline that is neither text nor unavailable reads to the file view as one
    /// still being waited for, and the file view goes on offering the comparison
    /// through that — rightly, for a host that only reads when the button is
    /// pressed. This panel is no longer such a host: it starts the read as the
    /// chapter opens, so the wait is a moment rather than a state, and listing the
    /// commit during it would put the control on screen for the length of a git
    /// process and then take it away again. A version nobody can compare against
    /// yet is not one to offer.
    /// </para>
    /// </summary>
    private IReadOnlyList<FileCompareBaseline> ChapterBaselines()
    {
        var opened = new FileCompareBaseline(
            OpenedBaselineId,
            "As opened",
            _openedText,
            _openedText is null ? "Nothing was read from this chapter when it was opened." : null);

        return _committedRead
            ? [opened, new FileCompareBaseline(CommittedBaselineId, "Last commit", _committedText, _committedUnavailable)]
            : [opened];
    }

    /// <summary>The remarks on the open chapter. A different chapter's remarks stay
    /// with that chapter — they are about its blocks and mean nothing against
    /// another file's.</summary>
    private IReadOnlyList<MarkdownComment> ChapterComments() =>
        _chapterDocument is { } document && _chapterComments.TryGetValue(document.Path, out var comments)
            ? comments
            : [];

    /// <summary>
    /// A remark, where it was asked for.
    /// <para>
    /// It arrives with wording rather than empty, because the read view offers no
    /// way to write one before it exists: a reader presses the affordance on a
    /// block and then edits what appears. An empty comment would render as a blank
    /// note beside the prose, which reads as something having gone wrong.
    /// </para>
    /// </summary>
    private void AddChapterComment(int blockIndex)
    {
        if (_chapterDocument is not { } document) return;

        if (!_chapterComments.TryGetValue(document.Path, out var comments))
        {
            comments = [];
            _chapterComments[document.Path] = comments;
        }

        comments.Add(new MarkdownComment(
            $"remark-{_nextComment++}",
            blockIndex,
            "A new remark. Edit it to say what it is.",
            "You",
            "just now"));
    }

    /// <summary>Resolved rather than removed, for the reason MarkdownComment
    /// records: the reason a paragraph reads the way it does is usually in the
    /// remark that got it there.</summary>
    private void ResolveChapterComment(string id) =>
        ReplaceChapterComment(id, comment => comment with { Resolved = !comment.Resolved });

    private void EditChapterComment(MarkdownComment edited) =>
        ReplaceChapterComment(edited.Id, _ => edited);

    private void ReplaceChapterComment(string id, Func<MarkdownComment, MarkdownComment> replace)
    {
        if (_chapterDocument is not { } document) return;
        if (!_chapterComments.TryGetValue(document.Path, out var comments)) return;

        var index = comments.FindIndex(comment => string.Equals(comment.Id, id, StringComparison.Ordinal));
        if (index < 0) return;

        comments[index] = replace(comments[index]);
    }

    /// <summary>
    /// A status changed in the body, written to whichever chapter it belongs to.
    /// <para>
    /// The read view reports the heading, and the knowledge writer addresses a
    /// status by path — the document's own path for the file's top heading, and the
    /// <c>path#anchor</c> the parse produced for a section. So the heading is
    /// matched back to one of those here; this panel already holds both lists, and
    /// it is the only thing that does.
    /// </para>
    /// </summary>
    private Task ChangeChapterStatusAsync(DomainKnowledgeDocument document, KnowledgeStatusChange change)
    {
        if (change.Heading is not { } heading) return Task.CompletedTask;

        if (string.Equals(heading, document.Title, StringComparison.OrdinalIgnoreCase))
        {
            return ChangeKnowledgeStatusAsync(
                new KnowledgeActionItem(document.Title, document.KindLabel, document.Path, document.Metadata, document.Summary),
                change.Status);
        }

        if (document.Sections.FirstOrDefault(section => string.Equals(section.Title, heading, StringComparison.OrdinalIgnoreCase)) is { } section)
        {
            return ChangeKnowledgeStatusAsync(
                new KnowledgeActionItem(section.Title, $"{document.KindLabel} section", section.Anchor, section.Metadata, section.Excerpt),
                change.Status);
        }

        // Nothing on screen answers to that heading, which means the parse this
        // panel is holding and the text the body rendered have drifted apart. Said
        // rather than swallowed: the alternative is a control that appears to work
        // and writes nowhere.
        _statusErrors[document.Path] = $"Could not tell which chapter \"{heading}\" is, so its state was not saved. Reopen the chapter and try again.";
        return Task.CompletedTask;
    }

    /// <summary>
    /// Which headings state a status of their own — the ones whose control the read
    /// view draws beside the heading.
    /// <para>
    /// Read through <see cref="MarkdownChapters"/> rather than with a second
    /// regular expression over the file, so that "the heading owns the fence under
    /// it" means the same thing here as it does in the view: a <c>```meta</c> in a
    /// quoted fence is not a status, and neither view nor panel should be fooled by
    /// one.
    /// </para>
    /// </summary>
    private static HashSet<string> HeadingsWithStatus(string? markdown)
    {
        var headings = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var chapter in MarkdownChapters.Split(markdown))
        {
            foreach (var line in chapter.Text.Split('\n').Skip(1).Select(line => line.Trim()))
            {
                if (line.Length == 0) continue;

                if ((line.StartsWith("```", StringComparison.Ordinal) || line.StartsWith("~~~", StringComparison.Ordinal))
                    && MetadataReader.IsMetaBlock(line[3..]))
                {
                    headings.Add(chapter.Title);
                }

                break;
            }
        }

        return headings;
    }

    /// <summary>Whether the open file view is already showing this heading's
    /// status.
    ///
    /// <para>In every mode, now that the file's own record is drawn in the file
    /// view's header rather than at the top of its body: the header is the part
    /// that stays put, so the status is reachable while a reader is editing or
    /// comparing without this panel offering a second control for it. It used to
    /// have to, and the mode test is gone with the reason for it.</para></summary>
    private bool ShowsStatusInFileView(DomainKnowledgeDocument document, string heading) =>
        IsEditedChapter(document) && _statusHeadings.Contains(heading);

    /// <summary>A save that failed after the editor stopped being able to say so.
    /// It is shown here because this panel is still on screen when that
    /// happens.</summary>
    private void OnChapterSaveFailed(string message) => _chapterSaveError = message;

    /// <summary>Flushes the editing surface if there is one. Guarded on the same
    /// condition the markup renders it on, because a captured reference outlives
    /// the component it points at.</summary>
    private Task FlushEditorAsync() =>
        _editor is not null && _chapter.Chapter is not null ? _editor.FlushAsync() : Task.CompletedTask;

    /// <summary>Whether this is the document the editing surface is holding — the
    /// very record the text was read for, so the buffer on screen and the body it
    /// replaced can never turn out to be about different files. The context
    /// documents render through the same fragment, and only one of them is the
    /// selected chapter.</summary>
    private bool IsEditedChapter(DomainKnowledgeDocument document) =>
        _chapter.Chapter is not null && ReferenceEquals(document, _chapterDocument);

    private void SelectContext(DomainKnowledgeContext? context) => _selectedContextSlug = context?.Slug;

    private static bool PathMatches(string candidate, string selectedPath)
    {
        var candidatePath = NormalizePath(candidate);
        var selected = NormalizePath(selectedPath);
        return string.Equals(candidatePath, selected, StringComparison.OrdinalIgnoreCase)
            || candidatePath.EndsWith($"/{selected}", StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizePath(string path) => path.Replace('\\', '/').TrimStart('.', '/');
    /// <summary>The class and the aria-pressed value used to be derived
    /// separately from this same comparison, which is two chances to disagree.
    /// ToggleButton derives both from the one answer.</summary>
    private bool IsContextSelected(DomainKnowledgeContext? context) =>
        string.Equals(_selectedContextSlug, context?.Slug, StringComparison.Ordinal);

    private static IReadOnlyList<SelectorOption> KnowledgeStatusOptions() =>
        [.. KnowledgeStatuses.Select(status => new SelectorOption(status, status))];

    /// <summary>The modifier a document's article wears, so a stylesheet can tell
    /// one kind of knowledge file from another. The context map is on the list
    /// because it is reachable two ways — as the folder's own view when nothing is
    /// selected, and as a document somebody picked out of the knowledge menu — and
    /// it has to be the same document both times. It used to fall through to
    /// nothing on the second route, which meant the map lost the treatment that
    /// says it is the map.</summary>
    private static string DocumentClass(DomainKnowledgeDocument document) => document.Kind switch
    {
        DomainKnowledgeDocumentKind.ContextMap => "domain-document--context-map",
        DomainKnowledgeDocumentKind.Domain => "domain-document--domain",
        DomainKnowledgeDocumentKind.Features => "domain-document--features",
        DomainKnowledgeDocumentKind.Model => "domain-document--model",
        DomainKnowledgeDocumentKind.Flow => "domain-document--flow",
        DomainKnowledgeDocumentKind.Dependencies => "domain-document--dependencies",
        DomainKnowledgeDocumentKind.Naming => "domain-document--naming",
        _ => string.Empty
    };

    /// <summary>The chapter as a buffer, and nothing else: no title, because the
    /// file view's header above it names the document, and Bare because that header
    /// now carries the way in and out of editing too. This is only on screen while
    /// the reader is writing.
    ///
    /// <para>Fill for the other half of that bargain. The file view here is given
    /// no MaxHeight and sits in a scrolling article, so the pane is what decides
    /// how tall the document is — and a surface sized by a textarea's row count
    /// would leave the reader a short box with the rest of the pane empty under
    /// it, which is exactly the space the header's Edit button just opened.</para></summary>
    private RenderFragment ChapterEditor() => @<KnowledgeChapterEditor @ref="_editor"
                                                                       Chapter="@_chapter.Chapter"
                                                                       InitialText="@_chapter.Text"
                                                                       Bare="true"
                                                                       Fill="true"
                                                                       OnSaved="OnChapterSavedAsync"
                                                                       OnSaveFailed="OnChapterSaveFailed" />;

    @* The chapter's article gives up its card, because the file view inside it
       draws one and a card inside a card reads as a document inside a document —
       which is what was reported. The article itself stays: it is the scroll
       container the knowledge stack sizes, the anchor the knowledge menu jumps to,
       and the only thing holding the chapter's controls, metadata and sections
       together. Every other document in the pane is still a card, since a list of
       files needs its entries told apart. *@
    private RenderFragment RenderDocument(DomainKnowledgeDocument document, string cssClass) => @<article class="domain-document @cssClass @(IsEditedChapter(document) ? "domain-document--chapter" : string.Empty)" id="@ElementId(document.Path)" data-testid="domain-document">
        <header class="domain-document__header">
            @* Kind, title and path move into the file view's header for the one
               document the file view shows, because that header says all three and
               saying them twice is what made the pane look like it had lost count.
               Every other document on screen — a context's other files, the folder
               overview — still names itself here, since nothing else does. *@
            @if (!IsEditedChapter(document))
            {
                <div>
                    <p class="domain-document__kind">@document.KindLabel</p>
                    <h3>@document.Title</h3>
                    <p class="domain-document__path"><code>@document.Path</code></p>
                </div>
            }
            @RenderKnowledgeActions(
                new KnowledgeActionItem(document.Title, document.KindLabel, document.Path, document.Metadata, document.Summary),
                showStatus: !ShowsStatusInFileView(document, document.Title))
        </header>

        @if (IsEditedChapter(document))
        {
            @* The chapter as the file has it, in place of the summary and the
               section excerpts that retold it. Those are a reading of this same
               text, and two readings on one screen disagree the moment either is
               typed into.

               And now the same argument, applied to the rest of what this panel
               used to draw around the file. A chapter's status, its diagrams and
               a way to copy it are all *in* the file, so they are rendered from
               the file: the status beside the heading it describes, the diagram
               where its fence is, a copy button on each chapter, and remarks in
               the margin beside the block they are about. Drawing them outside
               meant a diagram appeared below the file that contained it and a
               status appeared twice — once as this panel's select and once as the
               raw `meta` fence in the body — which is the drift the file view now
               removes by being the only one rendering them.

               What stays outside is what is genuinely not in the file: the save
               state, a failed write, the Copilot launch, and the linked knowledge
               issue. *@
            <Alert Message="@_chapterSaveError" TestId="domain-chapter-save-error" Role="status" />
            <FileView Name="@document.Title"
                      Kind="@document.KindLabel"
                      Path="@document.Path"
                      Body="@_chapter.Text"
                      MaxHeight="@(null)"
                      TestId="domain-chapter-file"
                      AllowCopy="true"
                      AllowChapterCopy="true"
                      RenderKnowledgeMetadata="true"
                      RenderKnowledgeMetadataFields="false"
                      ShowDiagramSource="false"
                      KnowledgeFolder="KnowledgeFolder.Domain"
                      KnowledgeDocumentPath="@document.Path"
                      OnKnowledgeStatusChanged="change => ChangeChapterStatusAsync(document, change)"
                      OnKnowledgeNavigate="NavigateKnowledgeReferenceAsync"
                      Comments="@ChapterComments()"
                      OnAddComment="index => AddChapterComment(index)"
                      OnResolveComment="ResolveChapterComment"
                      OnEditComment="EditChapterComment"
                      CanEdit="@(_chapter.Chapter is not null)"
                      Editing="@_editing"
                      EditingChanged="OnEditingChangedAsync"
                      EditBodyContent="@ChapterEditor()"
                      Comparing="@_comparing"
                      ComparingChanged="OnComparingChangedAsync"
                      CompareBaselines="@ChapterBaselines()"
                      CompareBaselineId="@_baselineId"
                      CompareBaselineIdChanged="OnBaselineChangedAsync" />
        }
        else
        {
            @* Everything below this point is a second reading of a file, assembled
               out of the parse this panel holds: the summary, the metadata strip,
               the diagrams, and one collapsible per heading with its excerpt. It
               is what the pane has to draw for a document nobody opened — a
               context's other files and the folder overview are a list, and a list
               entry has to say something about itself.

               For the document the file view *is* showing, the file says all of it
               already, in the order the author wrote it. Drawing both put a strip
               of raw field names and a stack of section cards under a file that
               had just finished stating the same things, and the two disagree the
               moment either is typed into. So the open chapter gets the file and
               nothing after it. *@
            @if (!string.IsNullOrWhiteSpace(document.Summary))
            {
                <p class="domain-document__summary">@document.Summary</p>
            }

            @if (HasVisibleMetadata(document.Metadata, document.Links))
            {
                @RenderMetadata(document.Metadata, document.Links, "Document metadata")
            }

            @foreach (var diagram in document.Diagrams)
            {
                <DiagramView Source="@diagram.Source" Language="@diagram.Language" />
            }

            <div class="domain-sections">
                @foreach (var section in document.Sections.Take(Compact ? 4 : 12))
                {
                    <section class="domain-section" id="@ElementId(section.Anchor)">
                        <header class="domain-section__header">
                            <h4>@section.Title</h4>
                            @RenderKnowledgeActions(
                                new KnowledgeActionItem(section.Title, $"{document.KindLabel} section", section.Anchor, section.Metadata, section.Excerpt))
                        </header>
                        @if (HasVisibleMetadata(section.Metadata, section.Links))
                        {
                            @RenderMetadata(section.Metadata, section.Links, "Section metadata")
                        }
                        @if (!string.IsNullOrWhiteSpace(section.Excerpt))
                        {
                            <p class="domain-section__excerpt">@section.Excerpt</p>
                        }
                        @foreach (var diagram in section.Diagrams)
                        {
                            <DiagramView Source="@diagram.Source" Language="@diagram.Language" />
                        }
                    </section>
                }
            </div>
        }
    </article>;

    @* showStatus is false for a heading whose status the open file view is already
       drawing. Two selects for one field is how the pane used to disagree with
       itself: the reader changed one and the other went on showing the old word
       until something reloaded. Conditional on the file and not on the mode — a
       chapter that states no status has no record for the file view to draw, and
       the only way to give it one is still this select. *@
    private RenderFragment RenderKnowledgeActions(KnowledgeActionItem item, bool showStatus = true) => @<div class="domain-knowledge__actions" aria-label="Knowledge item actions">
        @if (showStatus)
        {
            <StatusSelector Id="@StateSelectId(item)"
                            CurrentValue="@KnowledgeActionMetadata.Status(item.Metadata)"
                            Options="@KnowledgeStatusOptions()"
                            Label="@($"State for {item.Title}")"
                            TestId="knowledge-state-select"
                            OnChanged="value => ChangeKnowledgeStatusAsync(item, value)" />
        }

        @if (KnowledgeActionMetadata.Issue(item.Metadata, _view?.RepositoryLabel) is { } issue)
        {
            @* Unknown rather than open: the link carries a repo, a number and a
               label, and nothing on this path fetches the issue's state, so the
               badge must not claim one. The visible word already says "linked". *@
            <a class="badge badge--gh badge--gh-unknown"
               data-testid="knowledge-issue-badge"
               href="@issue.Url"
               target="_blank"
               rel="noopener"
               title="Knowledge Issue @issue.Label in @issue.RepoFullName">
                Knowledge Issue @issue.Label
                <span class="badge__state">linked</span>
            </a>
        }

        @if (IsFeatureEnabled(AppFeatureKeys.CopilotCli))
        {
            <IconButton BaseClass="entry-doc__icon-action entry-doc__icon-action--copilot"
                        TestId="knowledge-copilot-cli-button"
                        Disabled="@IsCopilotBusy(item)"
                        Title="Start GitHub Copilot CLI for this knowledge item"
                        AriaLabel="@($"Start GitHub Copilot CLI for {item.Title}")"
                        OnClick="() => StartKnowledgeCopilotAsync(item)">
                @if (IsCopilotBusy(item))
                {
                    <span>...</span>
                }
                else
                {
                    <span class="entry-doc__cli-mark">gh</span>
                }
            </IconButton>
        }

        @if (_statusErrors.TryGetValue(item.Path, out var statusError))
        {
            <span class="domain-knowledge__action-error" role="status">@statusError</span>
        }
        @if (_copilotErrors.TryGetValue(item.Path, out var error))
        {
            <span class="domain-knowledge__action-error" role="status">@error</span>
        }
    </div>;

    private RenderFragment RenderMetadata(IReadOnlyDictionary<string, string> metadata, IReadOnlyList<string> links, string label) => @<div class="domain-metadata" aria-label="@label">
        @foreach (var item in VisibleMetadata(metadata))
        {
            <span class="domain-metadata__item">
                @if (KnowledgeMetadataDisplay.ShouldShowLabel(item.Key))
                {
                    <strong>@item.Key</strong>
                }
                @foreach (var value in MetadataValues(item.Value))
                {
                    @RenderMetadataValue(item.Key, value)
                }
            </span>
        }
        @foreach (var link in links.Where(link => !MetadataContainsLink(metadata, link)).Take(4))
        {
            <span class="domain-metadata__item domain-metadata__item--link">@RenderKnowledgeLink(link)</span>
        }
    </div>;

    private RenderFragment RenderMetadataValue(string key, string value) => builder =>
    {
        if (NavigableMetadataKeys.Contains(key) || IsKnowledgeLink(value))
        {
            RenderKnowledgeLink(value)(builder);
            return;
        }

        builder.AddContent(0, value);
    };

    /// <summary>A relation, drawn as a control only where there is somewhere to go.
    /// The same rule KnowledgeReferenceLink keeps for the references it draws: given
    /// a way to follow it, it is something to press; given none, it is the text the
    /// author wrote. A relation naming a folder this pane has no section for is the
    /// second, and a button on one would be a promise the panel cannot keep.</summary>
    private RenderFragment RenderKnowledgeLink(string link) =>
        KnowledgeChapterLink.From(link) is { } target ? FollowableKnowledgeLink(link, target) : UnfollowableKnowledgeLink(link);

    private RenderFragment FollowableKnowledgeLink(string link, KnowledgeChapterLink target) =>
        @<AppButton BaseClass="domain-metadata__link" Variant="ButtonVariant.None" OnClick="() => NavigateKnowledgeLinkAsync(target)">@link</AppButton>;

    private static RenderFragment UnfollowableKnowledgeLink(string link) => builder => builder.AddContent(0, link);

    private async Task ChangeKnowledgeStatusAsync(KnowledgeActionItem item, string? status)
    {
        if (string.IsNullOrWhiteSpace(status) || string.Equals(status, KnowledgeActionMetadata.Status(item.Metadata), StringComparison.OrdinalIgnoreCase)) return;

        _statusErrors.Remove(item.Path);
        try
        {
            // The body goes first; KnowledgeChapterEditor.FlushAsync says why.
            await FlushEditorAsync();

            await DomainKnowledge.UpdateStatusAsync(RepositoryAlias, item.Path, status);
            await ReloadAsync();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException or ArgumentException)
        {
            _statusErrors[item.Path] = ex.Message;
        }
    }

    /// <summary>
    /// Follows a reference in the metadata strip or in the prose.
    /// <para>
    /// It used to read the context slug out of the path and stop there, which moved
    /// the column beside the chapter and left the chapter itself where it was — the
    /// reader pressed a reference to another file and the same file stayed on
    /// screen. The slug still moves, because in the compact pane that is which
    /// context the panel is showing; what is new is that the chapter is asked for
    /// too, of the host that owns the selection.
    /// </para>
    /// <para>
    /// A reference that resolves to no section is not followed. The prose can only
    /// produce references into a section — <see cref="KnowledgeReference.ParseKnowledgePath"/>
    /// refuses everything else — but a <c>related</c> field is a list of whatever
    /// somebody wrote, and <c>.github/copilot-instructions.md</c> in one names a
    /// real file that this pane has no section for.
    /// </para>
    /// </summary>
    private Task NavigateKnowledgeLinkAsync(KnowledgeChapterLink target)
    {
        if (string.Equals(target.AreaKey, DomainAreaKey, StringComparison.Ordinal))
        {
            var slash = target.RelativePath.IndexOf('/');
            _selectedContextSlug = slash < 0 ? null : target.RelativePath[..slash];
        }

        return OnNavigateToChapter.InvokeAsync(target);
    }

    /// <summary>The same, for a reference the file view parsed out of the prose. It
    /// arrives whole — path and heading slug — where the old handler was handed the
    /// path alone and dropped the slug on the floor.</summary>
    private Task NavigateKnowledgeReferenceAsync(KnowledgeReference reference) =>
        KnowledgeChapterLink.From(reference) is { } target ? NavigateKnowledgeLinkAsync(target) : Task.CompletedTask;

    private bool IsCopilotBusy(KnowledgeActionItem item) => _copilotBusy.Contains(item.Path);

    private async Task StartKnowledgeCopilotAsync(KnowledgeActionItem item)
    {
        if (_view is null || !_copilotBusy.Add(item.Path)) return;

        _copilotErrors.Remove(item.Path);
        try
        {
            await KnowledgeCopilot.StartAsync(item, _view.RepositoryRoot);
        }
        catch (CopilotCliException ex)
        {
            _copilotErrors[item.Path] = ex.Message;
        }
        finally
        {
            _copilotBusy.Remove(item.Path);
        }
    }

    private static bool HasVisibleMetadata(IReadOnlyDictionary<string, string> metadata, IReadOnlyList<string> links) =>
        metadata.Any(pair => !HeaderMetadataKeys.Contains(pair.Key)) || links.Count > 0;

    private static IEnumerable<KeyValuePair<string, string>> VisibleMetadata(IReadOnlyDictionary<string, string> metadata) =>
        metadata.Where(pair => !HeaderMetadataKeys.Contains(pair.Key));

    private static IReadOnlyList<string> MetadataValues(string value) =>
        [.. value.Trim().Trim('[', ']').Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Select(v => v.Trim().Trim('"', '\'', '[', ']')).Where(v => v.Length > 0)];

    private static bool MetadataContainsLink(IReadOnlyDictionary<string, string> metadata, string link) =>
        metadata.Where(pair => !HeaderMetadataKeys.Contains(pair.Key)).SelectMany(pair => MetadataValues(pair.Value)).Any(value => string.Equals(value, link, StringComparison.OrdinalIgnoreCase));

    private static bool IsKnowledgeLink(string value) => value.StartsWith(".", StringComparison.Ordinal) && value.Contains('/');

    private static string ElementId(string path) => "knowledge-" + new string(path.Select(ch => char.IsLetterOrDigit(ch) ? ch : '-').ToArray()).Trim('-');

    private static string StateSelectId(KnowledgeActionItem item) => ElementId(item.Path) + "-state";

    private bool IsFeatureEnabled(string key) => Features.IsEnabled(key);

    public void Dispose()
    {
        _disposed = true;
        DomainKnowledge.Changed -= OnKnowledgeChanged;
    }
}
