<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Sync module's public surface — everything a host or a client is allowed
    to see (ADR 0005, ADR 0009):
      DataTransferObjects/  the wire records the sync API accepts and returns
      SyncRoutes            where those records are posted to
      SyncClaims            the claim names a device token carries
      PairingCodeFormat     the pairing-code alphabet, shared by the service that
                            mints a code and the client that asks a person to type
                            one back in; a second copy of that alphabet would be a
                            second thing to keep in step
      SyncErrorCodes        the stable codes a ProblemDetails `type` is built from
    The device aggregate, the ports, and the use-case handlers stay in the
    implementation project. Nothing here may reference it, or anything else in
    the solution beyond the shared kernel.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.Modules.Sync.Abstractions</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Backlog.SharedKernel\Backlog.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The code format is worth testing directly rather than only through
         whatever happens to call it. -->
    <InternalsVisibleTo Include="Backlog.Modules.Sync.UnitTests" />
  </ItemGroup>

</Project>
