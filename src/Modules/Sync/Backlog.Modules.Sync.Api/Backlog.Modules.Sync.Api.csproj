<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The sync service: the one HTTP surface in the product. It is a host, not a
    module — it owns the token signing key, the validation parameters, and the
    mapping from a Result to a status code, and it delegates every decision to
    a handler in Backlog.Modules.Sync.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.Modules.Sync.Api</RootNamespace>
    <UserSecretsId>98bfd847-3884-49f0-aebf-b11e1e89fcb1</UserSecretsId>
    <!-- The version GET / reports, and the one every client compares its own
         against: a desktop or phone whose version is lower stops syncing and asks
         to be updated (docs/deployment/sync.md). Raised on purpose, never by
         default — raising it past the released clients stops all of them. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- The release the build ships under, which GET / reports as `release`. Release
       All sets the BacklogRelease property, through the environment of the
       `azd deploy` step (MSBuild reads environment variables as properties), and
       never touches Version above. Absent, there is no release. -->
  <ItemGroup Condition="'$(BacklogRelease)' != ''">
    <AssemblyMetadata Include="BacklogRelease" Value="$(BacklogRelease)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Aspire\Backlog.Aspire.ServiceDefaults\Backlog.Aspire.ServiceDefaults.csproj" />
    <!-- The Cosmos-backed ITaskReplica. A host is what picks an adapter for a
         port, so the two Cosmos packages stay in that project and this one
         depends on a port implementation rather than on a database driver. -->
    <ProjectReference Include="..\..\..\Infrastructure\Backlog.Infrastructure.Cosmos\Backlog.Infrastructure.Cosmos.csproj" />
    <!-- The blob-backed IAttachmentStore (.devbook/arc42/adr/0014), for the same
         reason: the storage packages stay in that project. -->
    <ProjectReference Include="..\..\..\Infrastructure\Backlog.Infrastructure.BlobStorage\Backlog.Infrastructure.BlobStorage.csproj" />
    <!-- The Web PubSub INotificationNudgeChannel (local ADR 0038 §4), on the same
         terms: the Web PubSub client stays in that project. -->
    <ProjectReference Include="..\..\..\Infrastructure\Backlog.Infrastructure.WebPubSub\Backlog.Infrastructure.WebPubSub.csproj" />
    <ProjectReference Include="..\Backlog.Modules.Sync\Backlog.Modules.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Validating the device tokens this service issued, and issuing them.
         Both halves live here on purpose: a signing key that one project mints
         with and another validates against is a key in two places. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Backlog.Modules.Sync.Api.UnitTests" />
  </ItemGroup>

</Project>
