@implements IDisposable

@*
    One view for every document-shaped devbook folder — `.design`, `.ai` — told
    which one it is drawing through the provider it is handed. Everything the
    markup says about the folder (its name, its status vocabulary, its root, the
    prefix its references carry) is read off that provider's Folder; nothing in
    this file spells a folder's name. The stylesheet hooks are the `folder-*`
    family for the same reason: a class that named one folder would be a lie on
    the other.

    Neither branch opens with a "Devbook" eyebrow and a title any more: the
    tab strip says the area's name and the Devbook menu heads its column with
    it, so the panel repeating it was the third copy of one word. The name survives as this
    region's label for a screen reader (.devbook/design/accessibility.md, "Names &
    roles"), the same trade the documents below already made when the file view
    took over saying a chapter's name.
*@

@*
    The modifier is what tells the stylesheet a chapter is on screen, and it is
    on the root because that is where the height has to be capped: the pane fills
    the section instead of growing past it, so the scrollbar belongs to the file
    view's body rather than to the section around it. In the folder overview
    there is no file view to hand it to, so the pane keeps growing and the
    section keeps scrolling it.
*@
<section class="@RootClass" aria-label="@($"{Folder.DisplayName} area")" data-testid="@($"{Folder.AreaKey}-devbook-view")">
    @if (_model is null)
    {
        <Alert Message="@($"Loading the {Folder.DisplayName} area...")" BaseClass="folder-devbook__message" Role="status" />
    }
    else if (!_model.IsAvailable)
    {
        @* Unavailable is only ever constructed with a reason, so this never
           takes the alert's hidden shape. *@
        <Alert Message="@_model.Message" BaseClass="folder-devbook__message" Role="status" />
        <a class="folder-devbook__settings" href="settings">Open repository settings</a>
    }
    else
    {
        @* The folder path was here until the pane stopped introducing itself.
           Where the folder is is a repository setting, and it was printing an
           absolute machine path above a document that already says which file it
           is — one line of chrome before every reader reached the first word. *@

        @* A status the reader picked and this pane could not write. It belongs
           above the documents rather than beside the control: it is the pane's
           failed attempt at the file, not anything the file says, and the same
           trade the other Devbook panes make with their save errors. *@
        @if (_statusError is { } statusError)
        {
            <Alert Message="@statusError" BaseClass="folder-devbook__message" />
        }

        @* The nav shows whenever the overview below is what is on screen, which is
           the same question the documents ask and so cannot disagree with them. It
           used to ask whether a path had been handed in, and that made the whole
           overview unreachable from the Devbook pane: the pane always hands one
           in. A path naming the folder rather than a file in it is how the pane
           asks for this view, and a path naming a document that has since been
           renamed away lands here too — on the folder, which is a way out, rather
           than on whichever file happened to be first. *@
        @if (SelectedFile is null)
        {
            <nav class="folder-devbook__nav" aria-label="@($"{Folder.DisplayName} documents")">
                @foreach (var file in _model.Files)
                {
                    @* A link to a document is a different subject from the
                       document, so a status here is not the document's answer
                       given twice — it is what makes the list scannable. Drawn
                       folder-aware, because the same word means different things
                       in different folders and this view knows its own; drawn as
                       nothing at all for a file that states no status, which the
                       badge it replaced could not do. *@
                    <a href="#@FileAnchor(file)" class="folder-devbook__nav-link">
                        <span>@file.Title</span>
                        <DevbookStatusPill Status="@file.Meta.Status" Folder="@Folder.Folder" />
                    </a>
                }
            </nav>
        }

        <div class="folder-devbook__documents">
            @foreach (var file in VisibleFiles())
            {
                <article class="folder-document" id="@FileAnchor(file)">
                    @* Only the folder overview has a header now, and only because
                       that is the one view where a document has to name itself:
                       several of them are stacked and nothing else says which is
                       which. A selected chapter is named by the file view below,
                       and the file's own record goes in that view's header
                       instead — a file-level block belongs beside the name, on
                       the part of the surface that stays put while the body
                       scrolls (.devbook/design/content-editing.md, "Devbook Metadata
                       Blocks").

                       Here in the overview this header *is* that surface's
                       header, so the record is drawn in it, around the name
                       rather than beside it. Fields off: the reader is looking
                       at eight documents and what they want from each is whether
                       it is current, and the fields printed back as rows are the
                       fence again with the fence taken off.

                       An empty block used to draw nothing at all, so the heading
                       had to be drawn on its own rather than handed to a record
                       that was going to stand down and take it off the page. It
                       no longer does: `.design` states a status only while a
                       guideline is unsettled, so an empty block is now the
                       ordinary resting shape of a current one, and MetadataView
                       draws the heading and a "No status" select for it. Handing
                       every file to the record is what keeps clearing a status
                       reversible here — the bare heading had no control on it,
                       so a reader who cleared one could not set it again. In
                       `.ai` a status is required, and the vocabulary says so:
                       the same record then offers no "No status" row. *@
                    @if (EditableChapter(file) is null)
                    {
                        <header class="folder-document__header">
                            <p class="folder-document__file">@file.FileName</p>
                            <MetadataView Metadata="@file.Meta"
                                               Vocabulary="@DevbookStatus.Vocabulary(Folder.Folder)"
                                               ShowFields="false"
                                               CanEditStatus="@CanEdit"
                                               AriaLabel="@($"{file.Title} metadata")"
                                               CssClass="folder-document__record"
                                               Heading="@DocumentHeading(file)"
                                               OnStatusChanged="status => ChangeFileStatusAsync(file, status)" />
                        </header>
                    }

                    @* The summary paragraph went with the header. It was the
                       file's own opening sentences lifted out of the file and
                       printed above it, so a reader met the same prose twice
                       before reaching anything else. *@

                    @* The token strip is the folder overview's answer to not
                       being able to see the file: a designer scanning eight
                       documents still gets the values out of each one. With the
                       chapter open the file is right there and its own tables are
                       in it, so the strip was the summary's mistake in another
                       shape — and a tall one, because it grows a row per token
                       and would have taken the height the file view was capped
                       to. Only a `.design` file has one — the strip asks for a
                       Token column and no other folder writes one — so the
                       branch is folder-blind and still draws nothing for `.ai`. *@
                    @if (EditableChapter(file) is null && file.TokenTables.Any())
                    {
                        <section class="design-token-strip" aria-label="Design token highlights">
                            @foreach (var table in file.TokenTables.Take(2))
                            {
                                @foreach (var row in table.Rows.Take(8))
                                {
                                    <div class="design-token" title="@TokenUsage(table, row)">
                                        <span class="design-token__name">@TokenName(table, row)</span>
                                        <span class="design-token__value">@TokenValue(table, row)</span>
                                    </div>
                                }
                            }
                        </section>
                    }

                    @if (EditableChapter(file) is { } chapter)
                    {
                        @* One chapter, so the whole file including its meta fences:
                           this text is written back over the source, and a buffer
                           that had the parsed sections stitched back together
                           would not be the file it came from. Shown through the
                           same file view the rest of the product shows a file
                           through, which is where the name, the path and the
                           file's own metadata record live. The record used to sit
                           above the view as a strip of its own; a file-level block
                           belongs in the header of the surface reading the file,
                           beside the name, and drawn twice it would read as two
                           facts about one file.

                           The view renders the read body itself, from Body, and
                           that is the whole of what this branch got wrong before:
                           an editor handed over as BodyContent is a body the view
                           does not parse, so every chapter's block stayed the raw
                           fence it was written as and the file's own block was
                           drawn twice — once in the header, once as that fence at
                           the top of the body. Parsed here, each `##` fence is
                           folded into its own heading and the `#` one is drawn in
                           the header alone, which is what .devbook/design/content-editing.md
                           ("Devbook Metadata Blocks") asks for at both levels.
                           Fields off for the reason the overview turns them off:
                           the file is right there, and the fence is in it.

                           No BodyContent at all, unlike the other Devbook panes:
                           they draw the file view whatever the read returned and
                           need a fallback for a chapter with no text. Here the
                           chapter is the branch's own condition — EditableChapter
                           is a readable chapter or nothing — so the unreadable case
                           is the section list below, which is a better fallback
                           than any this could pass: it keeps the per-chapter
                           records instead of trading them for a re-render of what
                           the parse already holds.

                           The path a link in the body resolves against is handed
                           over separately from the one printed beside the name:
                           the model carries a bare file name, and a sibling link
                           resolved against that lands in the repository root
                           rather than in `.design`. Following one is a request
                           to the host rather than a move, because the selection
                           is the host's.

                           Editing is a mode of the header rather than a surface
                           mounted on arrival, so the reader who came to read gets
                           the file and the reader who came to write asks for the
                           buffer. CanEdit used to be unconditional here for the
                           same reason BodyContent is absent — this branch only
                           runs for a chapter that resolved. It is conditional now
                           because resolving is no longer the whole question: a
                           folder read from a repository branch resolves a real
                           chapter that must not be written to, since the file
                           behind it is a copy of a commit and the next fetch
                           would take the edit with it.

                           Asked to fill rather than given a height: the chapter is
                           as long as it is, and a body that sized to its content
                           pushed the pane past the section already scrolling it,
                           which is how one file ended up with a scrollbar outside
                           it instead of in it. *@
                        <FileView Name="@file.Title"
                                  Path="@file.FileName"
                                  Body="@_chapter.Text"
                                  Fill="true"
                                  TestId="@($"{Folder.AreaKey}-chapter-file")"
                                  AllowCopy="true"
                                  AllowChapterCopy="true"
                                  RenderDevbookMetadata="true"
                                  RenderDevbookMetadataFields="false"
                                  DevbookFolder="@Folder.Folder"
                                  DevbookDocumentPath="@DocumentPath(file)"
                                  CanEditDevbookStatus="@CanEdit"
                                  OnDevbookStatusChanged="change => ChangeChapterStatusAsync(file, change)"
                                  OnDevbookNavigate="NavigateDevbookReferenceAsync"
                                  CanEdit="@(chapter is { CanEdit: true })"
                                  Editing="@(_editing && chapter is { CanEdit: true })"
                                  EditingChanged="OnEditingChangedAsync"
                                  EditBodyContent="@ChapterEditor(chapter, file)" />
                    }
                    else
                    {
                        @* The overview, and the fallback for a chapter that could
                           not be read: per-section status and metadata is what the
                           whole folder is worth reading for, and losing it to make
                           room for an editor nobody asked for would be the loss. *@
                        @foreach (var section in file.Sections)
                        {
                            <section class="folder-section" id="@section.Anchor">
                                @* A chapter's block folded into the chapter's own
                                   heading, status at the right edge of the line.
                                   It used to be a badge in a header and a strip
                                   under it — one subject, two answers, the second
                                   of them the raw fence in another shape.

                                   Empty means the heading on its own, for the
                                   reason the document header above says: a record
                                   with nothing in it renders nothing, heading
                                   included. *@
                                @if (section.Meta.IsEmpty)
                                {
                                    <header class="folder-section__header">
                                        <h4>@section.Heading</h4>
                                    </header>
                                }
                                else
                                {
                                    <MetadataView Metadata="@section.Meta"
                                                       Vocabulary="@DevbookStatus.Vocabulary(Folder.Folder)"
                                                       ShowFields="false"
                                                       CanEditStatus="@CanEdit"
                                                       AriaLabel="@($"{section.Heading} metadata")"
                                                       CssClass="folder-section__record"
                                                       Heading="@SectionHeading(section)"
                                                       OnStatusChanged="status => ChangeSectionStatusAsync(file, section, status)" />
                                }
                                @* The overview draws every file at once, so which
                                   document a reference resolves against is per file
                                   rather than per pane. *@
                                <DevbookBlocks Blocks="section.Blocks"
                                                 DiagramTitle="@section.Heading"
                                                 InlineTarget="@InlineTargetFor(file)" />
                            </section>
                        }
                    }
                </article>
            }
        </div>
    }
</section>

@code {
    private DocumentDevbookModel? _model;

    /// <summary>Whether this view may write anything back. False for a folder
    /// read from a repository branch, which draws every status as a badge and
    /// renders chapters read-only.</summary>
    private bool CanEdit => _model?.CanEdit ?? true;
    private string? _loadedRepositoryAlias;
    private DevbookChapterContent _chapter = DevbookChapterContent.None;
    private DevbookChapterEditor? _editor;
    private string? _statusError;
    private bool _editing;

    /// <summary>
    /// The folder's provider, which is also how the view learns which folder it
    /// is: the provider carries the <see cref="DocumentDevbookFolder"/>. Handed
    /// in rather than injected because an injection names one type, and this
    /// view serves two — the per-folder wrappers (<c>DesignDevbookView</c>,
    /// <c>AiDevbookView</c>) are where the injection happens. Read once, at
    /// initialisation: the wrapper never changes it.
    /// </summary>
    [Parameter, EditorRequired]
    public DocumentDevbookProvider Provider { get; set; } = default!;

    [Parameter]
    public string? RepositoryAlias { get; set; }

    [Parameter]
    public string? SelectedPath { get; set; }

    /// <summary>
    /// Raised when a reader follows a reference out of a document.
    /// <para>
    /// Which chapter is shown is <see cref="SelectedPath"/>, and that is the host's
    /// — the pane holds one selection per section and this panel is one section's
    /// screen. So following a reference is a request rather than a move: the panel
    /// says which chapter was asked for and the host decides whether it exists. A
    /// host that does not take the callback gets a reference that still reads
    /// correctly and goes nowhere, which is what the standalone page has. The same
    /// shape the Domain and arc42 panels already keep.
    /// </para>
    /// </summary>
    [Parameter]
    public EventCallback<DevbookChapterLink> OnNavigateToChapter { get; set; }

    private DocumentDevbookFolder Folder => Provider.Folder;

    protected override void OnInitialized()
    {
        ArgumentNullException.ThrowIfNull(Provider);
        Provider.Changed += OnDevbookChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_model is null || !string.Equals(_loadedRepositoryAlias, RepositoryAlias, StringComparison.Ordinal))
        {
            await ReloadAsync();
            return;
        }

        // The selection can move without the scope moving, and the guard above is
        // there precisely to skip a re-parse when it does — so the chapter is
        // read outside it.
        await ReadChapterAsync();
    }

    /// <summary>The configured folder moved, so every cached read is stale —
    /// including the open chapter, which is why this goes through
    /// <see cref="ReloadAsync"/> rather than re-reading the folder alone.</summary>
    private async void OnDevbookChanged()
    {
        await ReloadAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Parses the folder again and re-reads the open chapter, whatever
    /// the guard in <see cref="OnParametersSetAsync"/> would have decided. The
    /// status badges and the token strip are derived from the file, so after a
    /// write they are stale until this runs; the editor's own buffer is the one
    /// thing that does not need telling.</summary>
    private async Task ReloadAsync()
    {
        // Stamped from the alias the load was asked for, not the parameter after
        // the await: the provider reads off the renderer's thread, so a scope
        // switch can land while it is out, and a load stamped from the new
        // parameter would label the old scope's documents as the new one's — and
        // the guard in OnParametersSetAsync would then never ask again. A load
        // the scope has moved on from is dropped; the switch's own load has it.
        var alias = RepositoryAlias;
        var model = await Provider.LoadAsync(alias);
        if (!string.Equals(alias, RepositoryAlias, StringComparison.Ordinal)) return;

        _model = model;
        _loadedRepositoryAlias = alias;
        await ReadChapterAsync();
    }

    /// <summary>
    /// The open chapter off disk, and the editing mode kept or dropped with it.
    /// <para>
    /// A different file is read fresh, so nothing the last one was doing carries
    /// over — the mode belongs to the file view's header now, and left set it
    /// would open the next document straight into a textarea nobody asked for. A
    /// re-read of the <em>same</em> file must not reset it: every keystroke's
    /// debounce comes back through here after a save, and resetting there would
    /// close the editor under the reader who is typing.
    /// </para>
    /// </summary>
    private async Task ReadChapterAsync()
    {
        var previous = _chapter.Chapter?.RelativePath;
        _chapter = await LoadChapterAsync();

        if (!string.Equals(previous, _chapter.Chapter?.RelativePath, StringComparison.OrdinalIgnoreCase)) _editing = false;

        // Blazor assigns a component reference but never clears it, so an editor
        // that has stopped rendering would still be reachable. Cleared with the
        // chapter it belonged to, which is the condition the markup renders it on.
        if (_chapter.Chapter is null) _editor = null;
    }

    private Task OnChapterSavedAsync() => ReloadAsync();

    /// <summary>
    /// Into the editor, or back out of it.
    /// <para>
    /// Leaving flushes whatever the debounce still owes and re-reads the folder, so
    /// the read view the reader lands back on is the file as it now is — the nav
    /// link, the records beside the headings and the file's own record in the
    /// header are all derived from the parse, and none of them would follow a save
    /// on their own. The flush goes first, while the surface holding the pending
    /// write is still on screen.
    /// </para>
    /// </summary>
    private async Task OnEditingChangedAsync(bool editing)
    {
        if (editing)
        {
            _editing = true;
            return;
        }

        await FlushEditorAsync();
        _editing = false;
        await ReloadAsync();
    }

    /// <summary>Flushes the editing surface if one is on screen. Guarded on the
    /// condition the markup renders it on, because a captured reference outlives
    /// the component it points at.</summary>
    private Task FlushEditorAsync() =>
        _editor is not null && _editing && _chapter.Chapter is not null ? _editor.FlushAsync() : Task.CompletedTask;

    /// <summary>The document's name, for the record's headline to hold the status
    /// against. Handed over as a fragment rather than as a string because the
    /// heading and the status only genuinely share a line if they share a
    /// parent.</summary>
    private RenderFragment DocumentHeading(DocumentDevbookFile file) => @<h3>@file.Title</h3>;

    /// <summary>The chapter's heading, for the same reason.</summary>
    private RenderFragment SectionHeading(DocumentDevbookSection section) => @<h4>@section.Heading</h4>;

    /// <summary>
    /// A status picked on a document in the folder overview, written to the fence
    /// under that file's title.
    /// </summary>
    private Task ChangeFileStatusAsync(DocumentDevbookFile file, string? status) =>
        WriteStatusAsync(DocumentPath(file), status);

    /// <summary>
    /// A status picked on a chapter in the folder overview, written to the fence
    /// under that chapter's heading. Addressed by the slug of the heading rather
    /// than by the section's anchor: the anchor is prefixed for uniqueness across
    /// the whole folder, and the writer goes looking for the heading itself.
    /// </summary>
    private Task ChangeSectionStatusAsync(DocumentDevbookFile file, DocumentDevbookSection section, string? status) =>
        WriteStatusAsync($"{DocumentPath(file)}#{Slug(section.Heading)}", status);

    /// <summary>
    /// A status picked anywhere in the open file, written to the fence it belongs
    /// to.
    /// <para>
    /// The view reports the heading the control sat under, and that is what decides
    /// the subject: the file's title is the file's own block, in the header, and
    /// every other heading is a chapter of it. Both cases are real now that the
    /// view renders the body — each `##` fence is a record with its own control, so
    /// a handler that only knew the title would have quietly dropped every chapter's
    /// pick and left the reader watching a select snap back.
    /// </para>
    /// </summary>
    private async Task ChangeChapterStatusAsync(DocumentDevbookFile file, DevbookStatusChange change)
    {
        if (change.Heading is not { } heading) return;

        var itemPath = string.Equals(heading, file.Title, StringComparison.OrdinalIgnoreCase)
            ? DocumentPath(file)
            : $"{DocumentPath(file)}#{Slug(heading)}";

        // The body goes first; DevbookChapterEditor.FlushAsync says why. It is
        // rarely anything but a no-op — these controls live in the read view and
        // the editor is only on screen while writing, so leaving edit mode has
        // already flushed — but a debounce can still be a moment behind, and the
        // ordering must not depend on it.
        await FlushEditorAsync();

        await WriteStatusAsync(itemPath, change.Status);
    }

    /// <summary>
    /// The one place this pane writes a status. Reloading afterwards is not
    /// optional: the nav link, the token strip and every other record on screen
    /// are read from the parsed folder, so without it the pane would keep showing
    /// what the file said before the write.
    /// </summary>
    /// <param name="status">The word to write, or null where the reader chose to
    /// state none — which removes the field instead of writing one. The two are
    /// different operations all the way down to the file, so they are two calls
    /// here rather than one call with a blank.</param>
    private async Task WriteStatusAsync(string itemPath, string? status)
    {
        _statusError = null;
        try
        {
            if (string.IsNullOrWhiteSpace(status))
            {
                await Provider.ClearStatusAsync(RepositoryAlias, itemPath);
            }
            else
            {
                await Provider.UpdateStatusAsync(RepositoryAlias, itemPath, status);
            }

            await ReloadAsync();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException or ArgumentException)
        {
            _statusError = ex.Message;
        }
    }

    /// <summary>The heading slug the status writer addresses a chapter by. Kept
    /// here rather than shared with <see cref="DocumentDevbookParser"/>'s anchor,
    /// which prefixes the file name so an id is unique across the whole folder —
    /// the writer wants the heading alone.</summary>
    private static string Slug(string heading)
    {
        var chars = heading.ToLowerInvariant().Select(ch => char.IsLetterOrDigit(ch) ? ch : '-').ToArray();
        return string.Join('-', new string(chars).Split('-', StringSplitOptions.RemoveEmptyEntries));
    }

    /// <summary>The root's classes, carrying the chapter modifier when a file
    /// view is on screen to take the pane's scrollbar. Derived from what actually
    /// renders rather than from <see cref="SelectedPath"/>, because a selection
    /// whose chapter could not be read falls back to the sections and leaves
    /// nothing to hand the scroll to.</summary>
    private string RootClass =>
        _model is { IsAvailable: true } && VisibleFiles().Any(file => EditableChapter(file) is not null)
            ? "folder-devbook folder-devbook--chapter"
            : "folder-devbook";

    /// <summary>The chapter as a buffer, and nothing else: no title, because the
    /// file view's header above it already names the file, and Bare because that
    /// header now carries the way in and out of editing too — the bar would put a
    /// second Edit button directly under the first and render the chapter again
    /// underneath the one already on screen. Only there while the reader is
    /// writing.
    ///
    /// <para>The document path and the navigate callback go with it even so. Bare
    /// holds this surface in its editing mode for as long as it is on screen, so
    /// today the pair reaches nothing here — the read view a reference is followed
    /// out of is the file view's, above. They stay because they are what this
    /// surface needs the moment it draws a read view again, and because the three
    /// areas that show a chapter through it rather than through a file view hand it
    /// the same pair.</para></summary>
    private RenderFragment ChapterEditor(DevbookChapterRef chapter, DocumentDevbookFile file) =>
        @<DevbookChapterEditor @ref="_editor"
                                 Chapter="@chapter"
                                 InitialText="@_chapter.Text"
                                 Bare="true"
                                 DevbookDocumentPath="@DocumentPath(file)"
                                 OnDevbookNavigate="NavigateDevbookReferenceAsync"
                                 OnSaved="OnChapterSavedAsync" />;

    /// <summary>The document's path as the rest of the product spells one:
    /// repository-relative, with the area folder on the front.
    ///
    /// <para>The provider parses its folder <c>TopDirectoryOnly</c>, so a file name
    /// is the whole of what the model carries — and a sibling link resolved against
    /// a bare file name lands in the repository root rather than in the folder.
    /// Which is most of the links these folders have: each is one flat folder of
    /// documents that cross-reference each other by name.</para></summary>
    private string DocumentPath(DocumentDevbookFile file) => Folder.DocumentPath(file.FileName);

    /// <summary>How a reference in this file's prose is drawn. Built per file
    /// because the base document is what a relative link resolves against, and the
    /// folder overview has every file on screen at once.</summary>
    private MarkdownRender.MarkdownInlineTarget InlineTargetFor(DocumentDevbookFile file) =>
        DevbookInlineTargets.For(
            DocumentPath(file),
            null,
            EventCallback.Factory.Create<DevbookReference>(this, NavigateDevbookReferenceAsync));

    /// <summary>Follows a reference by asking the host for that chapter — the host
    /// owns the selection, so this is a request and not a move. A reference that
    /// does not resolve to a chapter in a section goes nowhere, which is what leaves
    /// a bare file path reading as the text the author wrote.</summary>
    private Task NavigateDevbookReferenceAsync(DevbookReference reference) =>
        DevbookChapterLink.From(reference) is { } target ? OnNavigateToChapter.InvokeAsync(target) : Task.CompletedTask;

    /// <summary>
    /// The chapter behind the document on screen, and its text, or
    /// <see cref="DevbookChapterContent.None"/> when nothing is selected.
    /// <para>
    /// Resolved from the document on screen rather than from
    /// <see cref="SelectedPath"/>, because the two can differ: a selection that
    /// matches no file puts the folder overview on screen, and a chapter
    /// resolved from the selection would then be pointing at a file nobody is
    /// looking at — and offering to edit it.
    /// </para>
    /// </summary>
    private Task<DevbookChapterContent> LoadChapterAsync() =>
        _model is { IsAvailable: true } model && SelectedFile is { } file
            ? DevbookChapterContent.LoadAsync(Folder.AreaKey, model.FolderPath, file.FileName, model.CanEdit)
            : Task.FromResult(DevbookChapterContent.None);

    /// <summary>
    /// The one document a selection puts on screen, or null while the folder
    /// overview is showing. The provider parses its folder <c>TopDirectoryOnly</c>, so a
    /// file name is the whole relative path and the resolver needs nothing else.
    /// <para>
    /// Resolved against the folder rather than against whatever the overview would
    /// render, so this and <see cref="VisibleFiles"/> answer in one direction: a
    /// selection matching no file is no document, and no document is the overview.
    /// A path the folder does not have is the ordinary case now rather than the
    /// odd one — the Devbook pane names the folder itself to ask for this view.
    /// </para>
    /// </summary>
    private DocumentDevbookFile? SelectedFile =>
        _model is null || string.IsNullOrWhiteSpace(SelectedPath)
            ? null
            : _model.Files.FirstOrDefault(file => PathMatches(file.FileName, SelectedPath));

    /// <summary>The ref to hand the editing surface for this document, or null so
    /// the sections render instead. Matched on the file name because the loaded
    /// pair belongs to whichever document was on screen when it was read.</summary>
    private DevbookChapterRef? EditableChapter(DocumentDevbookFile file) =>
        _chapter is { Chapter: { } chapter, Text: not null }
        && string.Equals(chapter.RelativePath, file.FileName, StringComparison.OrdinalIgnoreCase)
            ? chapter
            : null;

    /// <summary>The selected document alone, or the whole folder when there is no
    /// selected document — the two states this view has, read off the one
    /// question.</summary>
    private IReadOnlyList<DocumentDevbookFile> VisibleFiles() =>
        SelectedFile is { } file ? [file] : _model?.Files ?? [];

    private string FileAnchor(DocumentDevbookFile file) =>
        $"{Folder.AreaKey}-file-{Path.GetFileNameWithoutExtension(file.FileName).ToLowerInvariant()}";

    private static bool PathMatches(string candidate, string selectedPath)
    {
        var candidatePath = NormalizePath(candidate);
        var selected = NormalizePath(selectedPath);
        return string.Equals(candidatePath, selected, StringComparison.OrdinalIgnoreCase)
            || candidatePath.EndsWith($"/{selected}", StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizePath(string path) => path.Replace('\\', '/').TrimStart('.', '/');

    private static string TokenName(DocumentDevbookTable table, IReadOnlyList<string> row) =>
        Cell(table, row, "Token") ?? row.FirstOrDefault() ?? string.Empty;

    private static string TokenValue(DocumentDevbookTable table, IReadOnlyList<string> row) =>
        Cell(table, row, "Value") ?? Cell(table, row, "Value (dark)") ?? string.Empty;

    private static string TokenUsage(DocumentDevbookTable table, IReadOnlyList<string> row) =>
        Cell(table, row, "Usage") ?? string.Empty;

    private static string? Cell(DocumentDevbookTable table, IReadOnlyList<string> row, string header)
    {
        var index = table.Headers.ToList().FindIndex(h => string.Equals(h, header, StringComparison.OrdinalIgnoreCase));
        return index >= 0 && index < row.Count ? row[index] : null;
    }

    public void Dispose()
    {
        Provider.Changed -= OnDevbookChanged;
    }
}
