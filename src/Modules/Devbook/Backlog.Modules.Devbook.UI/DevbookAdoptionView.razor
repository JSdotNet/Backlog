@*
    The AI section's Devbook tab: how far the devbook itself has been adopted,
    read from AiModel. Empty for now; until it is drawn the tab says so rather
    than showing a blank panel.
*@
<div data-testid="devbook-adoption-view">
    <EmptyState Title="Devbook adoption is not drawn yet"
                Description="How far this repository has taken up the devbook will be drawn here." />
</div>

@code {
    /// <summary>The model the tab draws, read from the folder by <see cref="AiModel.From"/>.</summary>
    [Parameter, EditorRequired]
    public AiModel Model { get; set; } = default!;

    /// <summary>Raised when a reader opens a usage's chapter; the host owns the selection.</summary>
    [Parameter]
    public EventCallback<DevbookChapterLink> OnNavigateToChapter { get; set; }
}
