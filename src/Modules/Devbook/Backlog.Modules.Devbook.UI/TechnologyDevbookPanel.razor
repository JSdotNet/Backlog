@implements IDisposable
@inject TechnologyDevbookService TechnologyDevbook
@inject DevbookFolderOpenService DevbookFolderOpen
@inject IServiceProvider Services

@*
    The Technology page (.devbook/domain/devbook/features.md#technology-view): one
    tab bar over five views — Overview, Dependencies, Complexity, Clusters and Type
    lenses — in place of the Atlas and Layers tabs it had before.

    The panel owns three things and hands them to every view: the folder as read,
    the one selected technology, and the status write. The selection lives here
    rather than in a view so switching views keeps it. Each view is its own
    component inheriting TechnologyViewBase, so a view filled in later touches only
    its own file.
*@

<aside class="devbook-pane tech-devbook-pane" data-testid="technology-devbook-panel" aria-label="Technology area">
    @if (_loadError is not null)
    {
        @* The folder could not be read, so there is nothing to show but that and
           the way back (.devbook/design/interaction-guidelines.md, Error States).
           Retry is the load itself. *@
        <Alert Message="@_loadError"
               ActionLabel="Retry"
               OnAction="LoadOrReportAsync"
               ActionTestId="technology-load-retry"
               TestId="technology-load-error" />
    }
    else if (_view is null)
    {
        <Spinner Label="Loading the technology area" TestId="technology-loading" />
    }
    else if (!_view.Available)
    {
        <EmptyState BaseClass="devbook-empty"
                    Title="@_view.Summary"
                    TitleCssClass="@(null)"
                    ActionCssClass="@(null)"
                    role="status">
            <Action>
                <a href="settings">Open repository settings</a>
            </Action>
        </EmptyState>
    }
    else
    {
        <header class="devbook-pane__header">
            <h2>@_view.Title</h2>
            @* A branch snapshot is an app-managed cache folder, not somebody's
               working copy, so the launcher is left out rather than disabled. *@
            @if (CanEdit)
            {
                <AppButton BaseClass="devbook-folder-open"
                           Variant="ButtonVariant.None"
                           TestId="technology-open-vscode-button"
                           Disabled="@_openingTechnologyFolder"
                           title="Open Technology in VS Code"
                           aria-label="Open Technology in VS Code"
                           OnClick="OpenTechnologyFolderAsync">
                    @(_openingTechnologyFolder ? "..." : "Open in VS Code")
                </AppButton>
                <Alert Message="@_technologyFolderOpenError"
                       TestId="technology-open-vscode-error"
                       CssClass="devbook-folder-open-error" />
            }
        </header>

        <Tabs AriaLabel="Technology views"
              ListCssClass="tabs__list tech-devbook-pane__tabs"
              ActiveId="@_activeView"
              ActiveIdChanged="OpenViewAsync"
              TestId="technology-tabs">
            <TabPanel Id="@TechnologyViews.Overview"
                      Title="Overview"
                      Element="section"
                      KeepAlive="true"
                      TestId="technology-overview-panel"
                      TabTestId="technology-overview-tab">
                <TechnologyOverviewView @attributes="ViewParameters" />
            </TabPanel>
            <TabPanel Id="@TechnologyViews.Dependencies"
                      Title="Dependencies"
                      Element="section"
                      TestId="technology-dependencies-panel"
                      TabTestId="technology-dependencies-tab">
                <TechnologyDependenciesView @attributes="ViewParameters" />
            </TabPanel>
            <TabPanel Id="@TechnologyViews.Complexity"
                      Title="Complexity"
                      Element="section"
                      TestId="technology-complexity-panel"
                      TabTestId="technology-complexity-tab">
                <TechnologyComplexityView @attributes="ViewParameters" />
            </TabPanel>
            <TabPanel Id="@TechnologyViews.Clusters"
                      Title="Clusters"
                      Element="section"
                      TestId="technology-clusters-panel"
                      TabTestId="technology-clusters-tab">
                <TechnologyClustersView @attributes="ViewParameters" />
            </TabPanel>
            <TabPanel Id="@TechnologyViews.TypeLenses"
                      Title="Type lenses"
                      Element="section"
                      TestId="technology-type-lenses-panel"
                      TabTestId="technology-type-lenses-tab">
                <TechnologyTypeLensesView @attributes="ViewParameters" FocusSelection="@_openedByLink" />
            </TabPanel>
        </Tabs>
    }
</aside>

@code {
    private TechnologyDevbookView? _view;

    /// <summary>Why the folder could not be read, when the last load failed.</summary>
    private string? _loadError;

    private string? _loadedRepositoryAlias;
    private bool _openingTechnologyFolder;
    private string? _technologyFolderOpenError;
    private string? _statusError;

    /// <summary>The view on screen, by its <see cref="TechnologyViews"/> id.</summary>
    private string _activeView = TechnologyViews.Overview;

    /// <summary>Whether the view on screen was opened by a link in another view
    /// rather than from the tab strip.</summary>
    private bool _openedByLink;

    /// <summary>The one selected technology every view shares.</summary>
    private string? _selectedId;

    /// <summary>Whether this panel may write anything back. The view carries the
    /// whole resolved location, so the answer comes straight off it.</summary>
    private bool CanEdit => _view?.Location.CanEdit ?? true;

    [Parameter]
    public string? RepositoryAlias { get; set; }

    /// <summary>
    /// Raised to open a chapter: a technology's own, from the inspector's "Open
    /// chapter", or one in another devbook folder that a technology sits on. The
    /// host decides whether the target exists.
    /// </summary>
    [Parameter]
    public EventCallback<DevbookChapterLink> OnNavigateToChapter { get; set; }

    /// <summary>The parameters every view takes, as one set, so the five tab panels
    /// cannot drift apart in what they hand over.</summary>
    private IReadOnlyDictionary<string, object?> ViewParameters => new Dictionary<string, object?>
    {
        [nameof(TechnologyViewBase.View)] = _view,
        [nameof(TechnologyViewBase.SelectedId)] = _selectedId,
        [nameof(TechnologyViewBase.SelectedIdChanged)] = EventCallback.Factory.Create<string?>(this, Select),
        [nameof(TechnologyViewBase.OnOpenView)] = EventCallback.Factory.Create<string>(this, OpenViewByLink),
        [nameof(TechnologyViewBase.OnNavigateToChapter)] = OnNavigateToChapter,
        [nameof(TechnologyViewBase.OnStatusChanged)] = EventCallback.Factory.Create<TechnologyStatusChange>(this, ChangeTechnologyStatusAsync),
        [nameof(TechnologyViewBase.StatusError)] = _statusError,
        [nameof(TechnologyViewBase.StatusShown)] = _switches.StatusShown,
    };

    protected override void OnInitialized()
    {
        TechnologyDevbook.Changed += OnDevbookChanged;

        // Resolved optionally, as the other areas do: a host with no scope shows
        // the status as the panel always did.
        _switches = DevbookScope.Watch(Services.GetService<DevbookScope>(), InvokeAsync, RedrawAsync);
    }

    /// <summary>Whether the inspector shows a technology's stated status, as
    /// Devbook answers. A rating drawn in a view is not a status and does not ask.</summary>
    private DevbookViewerSwitches _switches = null!;

    private Task RedrawAsync()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_view is null || !string.Equals(_loadedRepositoryAlias, RepositoryAlias, StringComparison.Ordinal))
        {
            await LoadOrReportAsync();
        }
    }

    /// <summary>The load a scope change asks for, and the Retry after one failed.
    /// Caught here rather than in <see cref="LoadAsync"/>, which the status change
    /// and the folder-change handler call with a view already on screen to keep.</summary>
    private async Task LoadOrReportAsync()
    {
        _loadError = null;

        try
        {
            await LoadAsync();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _loadError = $"Could not read the technology area. {ex.Message}";
        }
    }

    private async Task LoadAsync()
    {
        // The alias is taken before the await and stamped from that copy: a scope
        // switch can land while the read is out, and a load the scope has moved on
        // from is dropped — the switch's own load carries the answer.
        var alias = RepositoryAlias;
        var view = await TechnologyDevbook.ReadAsync(alias);
        if (!string.Equals(alias, RepositoryAlias, StringComparison.Ordinal)) return;

        var scopeChanged = !string.Equals(alias, _loadedRepositoryAlias, StringComparison.Ordinal);
        _view = view;
        _loadedRepositoryAlias = alias;
        _loadError = null;
        _selectedId = KeptOrDefaultSelection(view, scopeChanged ? null : _selectedId);
    }

    /// <summary>The selection survives a re-read while the technology is still in
    /// the folder. Otherwise the page opens on the most used technology, so the
    /// inspector always has one to show.</summary>
    private static string? KeptOrDefaultSelection(TechnologyDevbookView view, string? current)
    {
        var technologies = view.Graph.Nodes.Where(node => !node.IsBoundary).ToList();
        if (current is not null && view.Graph.Nodes.Any(node => string.Equals(node.Id, current, StringComparison.Ordinal))) return current;

        return technologies
            .OrderByDescending(node => node.UsedBy)
            .ThenByDescending(node => node.RestsOn)
            .ThenBy(node => node.Label, StringComparer.CurrentCultureIgnoreCase)
            .FirstOrDefault()?.Id;
    }

    private void Select(string? id)
    {
        _selectedId = id;
        _statusError = null;
    }

    /// <summary>A view picked on the tab strip, where the focus stays.</summary>
    private Task OpenViewAsync(string id)
    {
        _activeView = id;
        _openedByLink = false;
        return Task.CompletedTask;
    }

    /// <summary>A view opened by a link in another view. The link went with the
    /// view it sat in, so the view opened is told to take the focus.</summary>
    private void OpenViewByLink(string id)
    {
        _activeView = id;
        _openedByLink = true;
    }

    /// <summary>The view a link opened took the flag on its first render, which
    /// is this one; cleared after it, so a later rebuild of the tabs — the folder
    /// going and coming back, a Retry — never takes the focus again.</summary>
    protected override void OnAfterRender(bool firstRender) => _openedByLink = false;

    /// <summary>The folder moved or changed underneath the panel, so it is read
    /// again — inside <c>InvokeAsync</c>, because a pull announces itself off the
    /// dispatcher, and guarded, because out of an <c>async void</c> an exception
    /// would end the process. The view that last read stays on screen.</summary>
    private async void OnDevbookChanged() =>
        await InvokeAsync(async () =>
        {
            try
            {
                await LoadAsync();
            }
            catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or DirectoryNotFoundException)
            {
                // Nothing to record and nothing to show: the view that last read
                // stays up.
            }

            StateHasChanged();
        });

    private async Task OpenTechnologyFolderAsync()
    {
        _technologyFolderOpenError = null;
        _openingTechnologyFolder = true;
        try
        {
            await DevbookFolderOpen.OpenAsync("tech", ".tech", RepositoryAlias);
        }
        catch (DevbookFolderOpenException ex)
        {
            _technologyFolderOpenError = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            _technologyFolderOpenError = ex.Message;
        }
        finally
        {
            _openingTechnologyFolder = false;
        }
    }

    /// <summary>The inspector's status write, back to the technology's chapter in
    /// its layer file, then the folder read again so every figure follows.</summary>
    private async Task ChangeTechnologyStatusAsync(TechnologyStatusChange change)
    {
        _statusError = null;

        try
        {
            await TechnologyDevbook.UpdateStatusAsync(RepositoryAlias, change.ItemPath, change.Status);
            await LoadAsync();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException or ArgumentException)
        {
            _statusError = ex.Message;
        }
    }

    public void Dispose()
    {
        TechnologyDevbook.Changed -= OnDevbookChanged;
        _switches?.Dispose();
    }
}
