@*
    The architecture surface's header (plan c4-zoom-navigation): where the reader is —
    Backlog / Devbook / Architecture and then the view, the chapter or the record open —
    and one field that finds any of them: an element of the model, a chapter, an ADR
    or a TDR.

    The crumbs before the last are not links: Backlog and Devbook are the shell's tabs
    above this pane, and Architecture is this surface. Only the last, the place itself,
    is marked current.

    The find field is the library's Combobox: the panel works out the suggestions for
    what is typed (Arc42Surface.Find) and opens what is picked. Its keys are the
    field's for the reason the Devbook source field gives: the Devbook takes the screen
    and closes on Escape, and the Escape that clears the field must not also close it.
*@

<header class="arc42-surface-header" data-testid="arc42-surface-header">
    <nav class="arc42-surface-header__crumbs" aria-label="Breadcrumb" data-testid="arc42-surface-breadcrumb">
        <ol class="arc42-surface-header__trail">
            @{ var trail = Trail; }
            @for (var index = 0; index < trail.Count; index++)
            {
                var crumb = trail[index];
                var last = index == trail.Count - 1;
                <li class="arc42-surface-header__crumb@(last ? " arc42-surface-header__crumb--current" : string.Empty)"
                    aria-current="@(last ? "location" : null)"
                    data-testid="arc42-surface-crumb">@crumb</li>
            }
        </ol>
    </nav>

    <span class="arc42-surface-header__find-keys" @onkeydown:stopPropagation="true">
        <Combobox CssClass="arc42-surface-header__find"
                  OpenOnInput="true"
                  Compact="true"
                  AriaLabel="Find an element, chapter or record"
                  ListAriaLabel="Matches"
                  Placeholder="Find element, chapter, ADR, TDR"
                  Value="@_query"
                  ValueChanged="SetQueryAsync"
                  Options="@_options"
                  OnCommit="CommitAsync"
                  TestId="arc42-surface-find">
            <OptionTemplate Context="option">
                <span class="arc42-surface-header__hit">
                    <span class="arc42-surface-header__hit-label">@option.Label</span>
                    @if (option.Hint is not null)
                    {
                        <span class="arc42-surface-header__hit-detail">@option.Hint</span>
                    }
                </span>
            </OptionTemplate>
        </Combobox>
    </span>
</header>

@code {
    private string _query = string.Empty;
    private IReadOnlyList<SelectorOption> _options = [];
    private IReadOnlyList<Arc42FindHit> _hits = [];

    /// <summary>The crumbs after Backlog / Devbook / Architecture: the view, or
    /// "arc42" and a chapter's number, or a record.</summary>
    [Parameter]
    public IReadOnlyList<string> Place { get; set; } = [];

    /// <summary>The suggestions for what is typed. The panel's, because it holds the
    /// catalogs they are read from.</summary>
    [Parameter]
    public Func<string, IReadOnlyList<Arc42FindHit>> Find { get; set; } = _ => [];

    /// <summary>A suggestion was picked, or Enter pressed on the text with a match: the
    /// first match then.</summary>
    [Parameter]
    public EventCallback<Arc42FindHit> OnOpen { get; set; }

    private IReadOnlyList<string> Trail => ["Backlog", "Devbook", "Architecture", .. Place];

    private Task SetQueryAsync(string text)
    {
        _query = text;

        // A pick puts the option's value in the field before it commits; the hits it
        // was picked from are kept, so the commit finds it among them.
        if (_hits.Any(hit => string.Equals(hit.Value, text, StringComparison.Ordinal))) return Task.CompletedTask;

        _hits = Find(text);
        _options = [.. _hits.Select(hit => new SelectorOption(hit.Value, hit.Label, hit.Detail))];
        return Task.CompletedTask;
    }

    private async Task CommitAsync(ComboboxCommit commit)
    {
        var hit = _hits.FirstOrDefault(candidate => string.Equals(candidate.Value, commit.Value, StringComparison.Ordinal))
            ?? (commit.Reason == ComboboxCommitReason.Entered ? _hits.FirstOrDefault() : null);

        if (hit is null) return;

        // What was found is open now; the field is ready for the next search.
        _query = string.Empty;
        _hits = [];
        _options = [];
        await OnOpen.InvokeAsync(hit);
    }
}
