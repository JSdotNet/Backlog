@implements IDisposable
@inject IServiceProvider Services
@inject NavigationManager Navigation

@*
    The Lobes atlas, full-window (.devbook/domain/brain/features.md#lobes-atlas):
    the Brain and the registered devbooks drawn as brains — the ones the shell's
    repository scope holds, which the atlas follows rather than filtering on its
    own: one in scope is that scope's own layout, several or none (every
    repository) is All with just those. Unregistered devbooks are not in that
    scope, so a Ghosts toggle draws them in All too.

    A takeover's body and nothing more. The host gives it the screen and its
    repository scope, and answers what a selection asks for — a Brain note or a
    repository chapter opened in the Devbook, which closes the atlas because the
    Devbook takes the screen in its place, or a row asking for its scope alone.
    The map fills the takeover and everything else floats over it, as the
    design draws it: the title at the top left; the picture's own controls and
    the close button at the top right, in the place every takeover's close
    sits, with a chip per region of a scope under them; the left panel listing
    the scopes in view or the regions, with the scope card
    under it saying what the scope holds and when it was last indexed; the index
    list on the right; and the foot's drag/scroll hint and orientation marker at
    the bottom. None of them is inside the canvas, so a drag or a wheel on one
    never moves the camera. A narrow window stacks them in one column instead,
    with the panel and the card folded into a sheet. With no Brain index yet the
    takeover offers to build it instead of a map.

    Nothing here draws: the canvas renderer paints the LobesAtlasModel and
    DevbookLobesAtlas maps the read model to it, with the index rows beside it
    built from the same marks, so the picture and the keyboard control never
    disagree about what is on screen.
*@

<section class="@ClassValue" data-testid="lobes-atlas" data-scope="@_layout" aria-label="Atlas">
    <header class="lobes-atlas__header">
        <div class="lobes-atlas__lead">
            <div class="lobes-atlas__heading">
                <span class="lobes-atlas__dot @AccentClass" aria-hidden="true"></span>
                <h2 class="lobes-atlas__title">Atlas</h2>
                @if (_graph is { Available: true })
                {
                    <span class="lobes-atlas__headline" data-testid="lobes-atlas-headline">— @Headline</span>
                }
                else if (_graph is { Available: false })
                {
                    @* With no map to scope, the header still says whose atlas is
                       waiting: the Brain's, as the empty state's design names it. *@
                    <Badge Kind="brain" CssClass="lobes-atlas__subject" TestId="lobes-atlas-subject">Brain</Badge>
                }
            </div>
        </div>

        <div class="lobes-atlas__controls">
            <div class="lobes-atlas__tools">
                @if (_graph is { Available: true })
                {
                    <ToggleButton BaseClass="btn btn--toggle"
                                  Pressed="_showLabels"
                                  TestId="lobes-atlas-labels"
                                  Title="@(_showLabels ? "Hide the names on the map" : "Show the names on the map")"
                                  OnClick="ToggleLabels">
                        Labels
                    </ToggleButton>
                    @* The brains turn on their own after a few quiet seconds, so
                       the reader can stop them (WCAG 2.2.2). Held while the atlas
                       is open; a fling, a drag and the zoom still move it. *@
                    <ToggleButton BaseClass="btn btn--toggle"
                                  Pressed="_paused"
                                  TestId="lobes-atlas-motion"
                                  Title="@(_paused ? "Let the brains turn on their own again" : "Stop the brains turning on their own")"
                                  OnClick="TogglePause">
                        Pause
                    </ToggleButton>
                    @* All has no region chips, so every devbook's technology —
                       hidden in All to start with — has a toggle of its own here.
                       It acts on All alone: each devbook scope's Parietal chip
                       keeps what the reader set. *@
                    @if (IsAll)
                    {
                        <ToggleButton BaseClass="btn btn--toggle"
                                      Pressed="_showTech"
                                      TestId="lobes-atlas-tech"
                                      Title="@(_showTech ? "Hide every devbook's technology chapters" : "Show every devbook's technology chapters")"
                                      OnClick="ToggleTech">
                            Tech
                        </ToggleButton>
                    }
                    @* An unregistered devbook is in no repository scope, so it
                       has a toggle of its own: on, every ghost joins All. *@
                    @if (HasGhosts)
                    {
                        <ToggleButton BaseClass="btn btn--toggle"
                                      Pressed="_showGhosts"
                                      TestId="lobes-atlas-ghosts"
                                      Title="@(_showGhosts ? "Take the devbooks not registered here off the map" : "Draw the devbooks your notes name that are not registered here")"
                                      OnClick="ToggleGhosts">
                            Ghosts
                        </ToggleButton>
                    }
                    @* A scope's regions, all shown or all hidden; starting with
                       the word it shows, so a speech user can still say it
                       (WCAG 2.5.3). *@
                    @if (!IsAll)
                    {
                        <AppButton Variant="ButtonVariant.Secondary"
                                   TestId="lobes-atlas-show-all"
                                   aria-label="All regions"
                                   title="Show every region"
                                   OnClick="() => ShowEverything(true)">
                            All
                        </AppButton>
                        <AppButton Variant="ButtonVariant.Secondary"
                                   TestId="lobes-atlas-show-none"
                                   title="Hide every region"
                                   OnClick="() => ShowEverything(false)">
                            None
                        </AppButton>
                    }
                }
                <IconButton AriaLabel="Close the atlas"
                            CssClass="btn--ghost"
                            TestId="lobes-atlas-close"
                            OnClick="() => OnClose.InvokeAsync()">✕</IconButton>
            </div>

            @if (_graph is { Available: true } && CurrentScope is { } chipScope)
            {
                @* What is drawn: one chip per region of the scope on screen,
                   pressed while shown. The same toggles as the panel's rows, kept
                   beside the picture's other controls. Which scopes are drawn is
                   the shell's repository scope, so All has none. *@
                <ButtonGroup CssClass="lobes-atlas__chips"
                             AriaLabel="Show regions"
                             TestId="lobes-atlas-chips">
                    @foreach (var lobe in RegionOrder)
                    {
                        var region = new LobesAtlasRegionKey(chipScope.Key, DevbookLobesAtlas.LobeKey(lobe));
                        <ToggleButton BaseClass="btn btn--toggle lobes-atlas__chip"
                                      Pressed="@(!_hiddenLobes.Contains(region))"
                                      TestId="lobes-atlas-chip"
                                      AriaLabel="@($"{DevbookLobesAtlas.RegionAbbreviation(chipScope.Kind, lobe)} {DevbookLobesAtlas.RegionName(chipScope.Kind, lobe)}")"
                                      data-lobe="@region.Lobe"
                                      OnClick="() => ToggleRegion(region)">
                            @DevbookLobesAtlas.RegionAbbreviation(chipScope.Kind, lobe)
                        </ToggleButton>
                    }
                </ButtonGroup>
            }
        </div>
    </header>

    @if (_graph is null)
    {
        <Spinner Label="Reading the atlas" TestId="lobes-atlas-loading" />
    }
    else if (_graph.BrainIndexMissing)
    {
        @* No Brain index yet: the one absence the atlas can mend, so it offers
           to build it — through the same refresher that builds it in the
           background — beside the way back. *@
        <EmptyState Title="Your Brain isn’t indexed yet"
                    Description="The atlas is drawn from the Brain’s own database, which Backlog builds in the background from your notes. Once it exists, every note, area and repository link shows up here as a map."
                    CssClass="lobes-atlas__empty"
                    TestId="lobes-atlas-empty">
            <Icon>
                <svg class="lobes-atlas__art" focusable="false" width="160" height="110" viewBox="0 0 160 110" fill="none" stroke-width="2" stroke-linecap="round">
                    <path d="M30 30 Q60 10 90 34 M90 34 Q120 60 132 84 M30 30 Q36 70 62 86" stroke-dasharray="5 6" />
                    <circle cx="30" cy="30" r="8" />
                    <circle cx="90" cy="34" r="8" />
                    <circle cx="62" cy="86" r="8" />
                    <rect x="124" y="76" width="16" height="16" rx="3" />
                </svg>
            </Icon>
            <Action>
                <div class="lobes-atlas__actions">
                    @if (Lobes.CanBuildBrainIndex)
                    {
                        <AppButton Variant="ButtonVariant.Primary"
                                   TestId="lobes-atlas-build"
                                   Busy="_building"
                                   BusyLabel="Building the index"
                                   OnClick="BuildIndexAsync">
                            Build the index now
                        </AppButton>
                    }
                    <AppButton Variant="ButtonVariant.Secondary"
                               TestId="lobes-atlas-back"
                               OnClick="() => OnClose.InvokeAsync()">
                        Back to notes
                    </AppButton>
                </div>
                <Alert Message="@_buildProblem" TestId="lobes-atlas-build-problem" />
                <p class="lobes-atlas__footnote" aria-live="polite" data-testid="lobes-atlas-footnote">
                    @(_building
                        ? "Building the index… Notes stay readable in the pane meanwhile."
                        : "Notes stay readable in the pane while the index builds; only the atlas and search wait for it.")
                </p>
            </Action>
        </EmptyState>
    }
    else if (!_graph.Available)
    {
        @* No Brain index, no Brain folder, or a read that failed: said in words,
           never an empty map. *@
        <EmptyState Title="@_graph.Message" role="status" TestId="lobes-atlas-unavailable">
            <Action>
                <AppButton Variant="ButtonVariant.Secondary"
                           TestId="lobes-atlas-back"
                           OnClick="() => OnClose.InvokeAsync()">
                    Back
                </AppButton>
            </Action>
        </EmptyState>
    }
    else if (_nothingInView)
    {
        @* The shell's scope holds nothing the atlas can draw — a repository
           with no devbook: said in words, never an empty map, and never
           everything drawn instead. *@
        <EmptyState Title="None of the repositories in scope has a devbook to map"
                    Description="@(HasGhosts ? "Pick another in the header, or turn on Ghosts." : "Pick another in the header.")"
                    role="status"
                    TestId="lobes-atlas-nothing-in-view" />
    }
    else
    {
        @* The panel and the scope card. Over the map they float as two boxes on
           the left; in a narrow window, where the map needs the height, they fold
           into a sheet behind one disclosure whose name says what the panel and
           the card are about, and the map stays in view under it. *@
        <aside class="lobes-atlas__panel" aria-label="@PanelTitle">
            <FoldControl BaseClass="lobes-atlas__sheet-toggle"
                         Controls="@_sheetId"
                         ChevronAtEnd="true"
                         Expanded="_sheetOpen"
                         ExpandedChanged="open => _sheetOpen = open"
                         TestId="lobes-atlas-sheet-toggle">
                <LabelContent>
                    <span class="lobes-atlas__sheet-toggle-title">@PanelTitle</span>
                    <span class="lobes-atlas__sheet-toggle-sub">@CardTitle</span>
                </LabelContent>
            </FoldControl>

            <div class="lobes-atlas__sheet" id="@_sheetId" data-testid="lobes-atlas-panel-sheet">
                <div class="lobes-atlas__legend">
                    <h3 class="lobes-atlas__panel-title">@PanelTitle</h3>

                    @if (IsAll)
                    {
                        @* The scopes in view, with what each holds. A registered
                           one's row asks the shell for that scope alone; a ghost's
                           steps into the ghost here, since the shell has no chip for
                           it. A host that wires no scope gets a plain legend. *@
                        <ul class="lobes-atlas__rows" data-testid="lobes-atlas-rows">
                            @foreach (var scope in DrawnScopes)
                            {
                                var key = scope.Key;
                                var ghost = scope.Kind == DevbookLobesScopeKind.Ghost;
                                <li>
                                    @if (ghost || OnScopeTo.HasDelegate)
                                    {
                                        <AppButton BaseClass="lobes-atlas__row"
                                                   Variant="ButtonVariant.None"
                                                   TestId="lobes-atlas-row"
                                                   aria-label="@($"Open {scope.Label}")"
                                                   data-scope="@key"
                                                   OnClick="() => OpenRowAsync(scope)">
                                            @ScopeRowContent(scope)
                                        </AppButton>
                                    }
                                    else
                                    {
                                        <div class="lobes-atlas__row" data-testid="lobes-atlas-row" data-scope="@key">
                                            @ScopeRowContent(scope)
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else if (CurrentScope is { } current)
                    {
                        @* The scope's six regions, each a toggle: pressed while drawn. *@
                        <ul class="lobes-atlas__rows" data-testid="lobes-atlas-rows">
                            @foreach (var lobe in RegionOrder)
                            {
                                var region = new LobesAtlasRegionKey(current.Key, DevbookLobesAtlas.LobeKey(lobe));
                                var shown = !_hiddenLobes.Contains(region);
                                var name = DevbookLobesAtlas.RegionName(current.Kind, lobe);
                                <li>
                                    <ToggleButton BaseClass="lobes-atlas__row"
                                                  PressedCssClass="lobes-atlas__row--shown"
                                                  Pressed="shown"
                                                  TestId="lobes-atlas-region"
                                                  data-lobe="@region.Lobe"
                                                  OnClick="() => ToggleRegion(region)">
                                        <span class="lobes-atlas__swatch lobes-atlas__swatch--@KindSlug(current.Kind)" aria-hidden="true"></span>
                                        <span class="lobes-atlas__row-text">
                                            <span class="lobes-atlas__row-name">@name</span>
                                            <span class="lobes-atlas__row-sub">@RegionSub(current.Kind, lobe)</span>
                                        </span>
                                        <Badge BaseClass="lobes-atlas__row-count" Kind="">@current.LobeCounts.GetValueOrDefault(lobe)</Badge>
                                    </ToggleButton>
                                </li>
                            }
                        </ul>
                    }
                </div>

                <section class="lobes-atlas__card lobes-atlas__card--@CardSlug" aria-label="Scope details" data-testid="lobes-atlas-card">
                    <span class="lobes-atlas__card-kind">@CardKind</span>
                    <span class="lobes-atlas__card-title">@CardTitle</span>
                    @foreach (var line in CardLines)
                    {
                        <span class="lobes-atlas__card-line">@line</span>
                    }
                    @if (CurrentScope is { Kind: DevbookLobesScopeKind.Ghost })
                    {
                        <AppButton Variant="ButtonVariant.Primary"
                                   CssClass="lobes-atlas__card-action"
                                   TestId="lobes-atlas-card-action"
                                   OnClick="RegisterRepository">
                            Register repository
                        </AppButton>
                        @* The way back from a ghost stepped into: All again, as
                           Ghosts off or a change of the shell's scope also is. *@
                        <AppButton Variant="ButtonVariant.Secondary"
                                   CssClass="lobes-atlas__card-action"
                                   TestId="lobes-atlas-ghost-back"
                                   OnClick="LeaveGhost">
                            Back to all scopes
                        </AppButton>
                    }
                    else if (!IsAll || OnScopeTo.HasDelegate)
                    {
                        <AppButton Variant="ButtonVariant.Primary"
                                   CssClass="lobes-atlas__card-action"
                                   TestId="lobes-atlas-card-action"
                                   OnClick="CardActionAsync">
                            @CardAction
                        </AppButton>
                    }
                </section>
            </div>
        </aside>

        <GraphAtlas Title=""
                    Data="@_model"
                    Nodes="@_nodes"
                    JsFunction="backlogDiagrams.renderLobesAtlas"
                    StatusText="Drawing the atlas..."
                    AriaLabel="@($"Lobes atlas, {Headline}")"
                    IndexLabel="@IndexLabel"
                    SelectedId="@_selectedId"
                    SelectedIdChanged="SelectAsync"
                    Announcement="@Announcement"
                    CssClass="lobes-atlas__graph"
                    OnCameraMoved="_showCamera"
                    TestId="lobes-atlas-graph">
            <Detail>
                <DetailSheet Open="@(Selected is not null)"
                             OpenChanged="OnSheetOpenChanged"
                             Kicker="@SelectedKicker"
                             Title="@Selected?.Label"
                             Lede="@(Selected is { Path.Length: > 0 } picked ? picked.Path : null)"
                             TestId="lobes-atlas-sheet"
                             CloseLabel="Close the details">
                    @if (Selected is { } node)
                    {
                        @* A link from the Brain: its chip, gold where it can be
                           followed and dashed with the reason where it cannot
                           — the chip a note draws. *@
                        @if (node.RepositoryLink is { } repository)
                        {
                            <div class="lobes-atlas__open">
                                <RepoLinkChip Alias="@repository.Alias"
                                              Label="@node.Label"
                                              Reference="@repository.Raw"
                                              Resolved="@repository.Resolved"
                                              Problem="@repository.Problem"
                                              TestId="lobes-atlas-repo-link"
                                              OnOpen="OpenRepositoryLinkAsync" />
                            </div>
                        }
                        else if (node.Kind == DevbookLobesNodeKind.Note && node.Path.Length > 0)
                        {
                            <div class="lobes-atlas__open">
                                <AppButton Variant="ButtonVariant.Secondary"
                                           TestId="lobes-atlas-open-note"
                                           OnClick="() => OnOpenNote.InvokeAsync(node.Path)">
                                    Open @node.Label in the pane
                                </AppButton>
                            </div>
                        }
                        else if (node.Kind == DevbookLobesNodeKind.Chapter && ChapterLink(node) is { } chapter)
                        {
                            <div class="lobes-atlas__open">
                                <AppButton Variant="ButtonVariant.Secondary"
                                           TestId="lobes-atlas-open-chapter"
                                           OnClick="() => OnOpenRepositoryChapter.InvokeAsync(chapter)">
                                    Open @node.Label
                                </AppButton>
                            </div>
                        }
                    }
                </DetailSheet>
            </Detail>
        </GraphAtlas>

        <LobesAtlasCompass @ref="_compass" />
    }
</section>

@code {
    private static readonly DevbookLobe[] RegionOrder =
    [
        DevbookLobe.Frontal,
        DevbookLobe.Parietal,
        DevbookLobe.Temporal,
        DevbookLobe.Occipital,
        DevbookLobe.Cerebellum,
        DevbookLobe.Stem
    ];

    private readonly HashSet<LobesAtlasRegionKey> _hiddenLobes = [];
    // The devbook and ghost scopes whose Parietal has had its hidden start:
    // once per scope key, so a reread never hides again what the reader turned
    // on, and a devbook registered since — a ghost's included, under its new
    // repo: key — still starts with its technology hidden.
    private readonly HashSet<string> _seededScopes = new(StringComparer.Ordinal);
    private bool _showTech;
    private DevbookLobesGraph? _graph;
    private LobesAtlasModel? _model;
    private IReadOnlyList<GraphAtlasNode> _nodes = [];
    // The layout on screen and the scopes it draws, derived from the shell's
    // repository scope, the Ghosts toggle and a ghost stepped into.
    private string _layout = LobesAtlasModel.AllLayout;
    private IReadOnlyList<string> _drawn = [];
    private bool _nothingInView;
    private bool _showGhosts;
    private string? _ghostFocus;
    private string? _appliedSelection;
    private string? _appliedScope;
    private string? _selectedId;
    private bool _showLabels = true;
    private bool _paused;
    private bool _sheetOpen;
    private readonly string _sheetId = "lobes-atlas-sheet-" + Guid.NewGuid().ToString("N");
    private bool _building;
    private string? _buildProblem;
    private LobesAtlasCompass? _compass;
    private readonly Action<GraphAtlasCamera> _showCamera;

    public LobesAtlasTakeover() => _showCamera = ShowCamera;

    /// <summary>The window's repository scope, in its order, <c>BrainScope.Value</c>
    /// for the Brain; empty for every repository. One member the graph holds is
    /// drawn in its own layout, several in All.</summary>
    [Parameter]
    public IReadOnlyList<string> RepositoryScope { get; set; } = [];

    /// <summary>Asks the host to scope the window to one member alone — an alias,
    /// or <c>BrainScope.Value</c> for the Brain. Unbound, All's rows are a plain
    /// legend and its card offers nothing.</summary>
    [Parameter]
    public EventCallback<string> OnScopeTo { get; set; }

    /// <summary>A ghost to step into, <c>ghost:&lt;alias&gt;</c>, as Register
    /// repository left it. Applied once per hand-over; a ghost whose alias has been
    /// registered since asks the host for that repository instead.</summary>
    [Parameter]
    public string? Scope { get; set; }

    /// <summary>The close button and the empty state's way back.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>A Brain note opened in the pane, by its path from the Brain's
    /// root.</summary>
    [Parameter]
    public EventCallback<string> OnOpenNote { get; set; }

    /// <summary>A repository chapter followed — a resolved link out of the Brain,
    /// or a devbook's own chapter — to open that repository's devbook at it.</summary>
    [Parameter]
    public EventCallback<DevbookRepositoryChapter> OnOpenRepositoryChapter { get; set; }

    /// <summary>Where the graph comes from: the source the personal devbook's
    /// context registered (local ADR 0040 §2), or, in a host that composes none,
    /// one with nothing to map.</summary>
    private IDevbookLobesSource Lobes => _lobes ??= Services.GetService<IDevbookLobesSource>() ?? UnavailableLobesSource.Instance;

    private IDevbookLobesSource? _lobes;

    /// <summary>The scope card's action: the Devbook opened on the Brain (an empty
    /// alias) or on that repository's devbook.</summary>
    [Parameter]
    public EventCallback<string> OnOpenScope { get; set; }

    /// <summary>Register repository pressed on a ghost's card, with that ghost's
    /// scope key, just before the atlas leaves for the Repositories settings.</summary>
    [Parameter]
    public EventCallback<string> OnRegisterRepository { get; set; }

    private bool IsAll => _layout == LobesAtlasModel.AllLayout;

    private bool HasGhosts => _graph?.Scopes.Any(scope => scope.Kind == DevbookLobesScopeKind.Ghost) ?? false;

    /// <summary>The scopes drawn, in the graph's order — the order the renderer
    /// seats them in.</summary>
    private IEnumerable<DevbookLobesScope> DrawnScopes =>
        _graph?.Scopes.Where(scope => _drawn.Contains(scope.Key, StringComparer.OrdinalIgnoreCase)) ?? [];

    /// <summary>The root's classes: the sheet's state rides on it, because only a
    /// narrow window folds the panel and the card into a sheet — over the map
    /// they are always shown, whatever the disclosure last said.</summary>
    private string ClassValue => _sheetOpen ? "lobes-atlas lobes-atlas--sheet-open" : "lobes-atlas";

    private DevbookLobesScope? CurrentScope => IsAll ? null : _graph?.Scope(_layout);

    private DevbookLobesNode? Selected =>
        _selectedId is null ? null : _graph?.Nodes.FirstOrDefault(node => string.Equals(node.Id, _selectedId, StringComparison.Ordinal));

    private string AccentClass => CurrentScope?.Kind switch
    {
        DevbookLobesScopeKind.Devbook => "lobes-atlas__dot--devbook",
        DevbookLobesScopeKind.Ghost => "lobes-atlas__dot--ghost",
        _ => "lobes-atlas__dot--brain"
    };

    private int DevbookCount => DrawnScopes.Count(scope => scope.Kind != DevbookLobesScopeKind.Brain);

    private bool BrainDrawn => DrawnScopes.Any(scope => scope.Kind == DevbookLobesScopeKind.Brain);

    private string Headline => CurrentScope switch
    {
        null => $"{(BrainDrawn ? "Brain + " : string.Empty)}{DevbookCount} {(DevbookCount == 1 ? "devbook" : "devbooks")}",
        { Kind: DevbookLobesScopeKind.Brain } => "Brain · 6 regions",
        { Kind: DevbookLobesScopeKind.Ghost } scope => $"{scope.Label} · not registered",
        var scope => $"{scope.Label} devbook · 6 folders"
    };

    private string PanelTitle => CurrentScope?.Kind switch
    {
        null => "Scopes",
        DevbookLobesScopeKind.Brain => "Anatomical regions",
        _ => "Devbook folders"
    };

    private string IndexLabel => CurrentScope is { } scope ? $"{scope.Label} marks" : "Every mark";

    private string? SelectedKicker => Selected is { } node && _graph?.Scope(node.ScopeKey) is { } scope
        ? $"{scope.Label} · {DevbookLobesAtlas.RegionName(scope.Kind, node.Lobe)}"
        : null;

    private string? Announcement => Selected is { } node ? $"{node.Label}, {SelectedKicker}." : null;

    private static string KindSlug(DevbookLobesScopeKind kind) => kind switch
    {
        DevbookLobesScopeKind.Brain => "brain",
        DevbookLobesScopeKind.Ghost => "ghost",
        _ => "devbook"
    };

    /// <summary>A scope's row in All: its swatch, name, what it is and its count.</summary>
    private static RenderFragment ScopeRowContent(DevbookLobesScope scope) => __builder =>
    {
        <span class="lobes-atlas__swatch lobes-atlas__swatch--@KindSlug(scope.Kind)" aria-hidden="true"></span>
        <span class="lobes-atlas__row-text">
            <span class="lobes-atlas__row-name">@scope.Label</span>
            <span class="lobes-atlas__row-sub">@ScopeSub(scope)</span>
        </span>
        <Badge BaseClass="lobes-atlas__row-count" Kind="">@(scope.Kind == DevbookLobesScopeKind.Ghost ? "—" : scope.ItemCount.ToString(System.Globalization.CultureInfo.InvariantCulture))</Badge>
    };

    private static string ScopeSub(DevbookLobesScope scope) => scope.Kind switch
    {
        DevbookLobesScopeKind.Brain => "Your notes",
        DevbookLobesScopeKind.Ghost => "Devbook · not registered here",
        _ => $"Devbook · {Notes(scope.LinkingNotes)} link in"
    };

    private static string RegionSub(DevbookLobesScopeKind kind, DevbookLobe lobe) => kind == DevbookLobesScopeKind.Brain
        ? lobe switch
        {
            DevbookLobe.Frontal => "Projects",
            DevbookLobe.Parietal => "Areas · Resources",
            DevbookLobe.Temporal => "People",
            DevbookLobe.Occipital => "Repository chapters",
            DevbookLobe.Cerebellum => "Journal · Inbox",
            _ => "Area roots · Conventions"
        }
        : lobe switch
        {
            DevbookLobe.Frontal => "Structure · Decisions · Debt",
            DevbookLobe.Parietal => "Technologies · Ratings",
            DevbookLobe.Temporal => "Contexts · Language",
            DevbookLobe.Occipital => "Principles · Tokens",
            DevbookLobe.Cerebellum => "Ways of working",
            _ => "Roots · Reading order"
        };

    private static string Notes(int count) => count == 1 ? "1 note" : $"{count} notes";

    private string CardSlug => CurrentScope is { } scope ? KindSlug(scope.Kind) : "all";

    private string CardKind => CurrentScope?.Kind switch
    {
        null => "Everything",
        DevbookLobesScopeKind.Brain => "Brain",
        DevbookLobesScopeKind.Ghost => "Devbook · not registered",
        _ => "Devbook"
    };

    private string CardTitle => CurrentScope switch
    {
        null => Headline,
        { Kind: DevbookLobesScopeKind.Brain } => "Your notes",
        var scope => scope.Label
    };

    private IReadOnlyList<string> CardLines
    {
        get
        {
            if (_graph is null) return [];

            var brain = DrawnScopes.FirstOrDefault(scope => scope.Kind == DevbookLobesScopeKind.Brain);
            switch (CurrentScope)
            {
                case null:
                    var chapters = DrawnScopes.Where(scope => scope.Kind == DevbookLobesScopeKind.Devbook).Sum(scope => scope.ItemCount);
                    return
                    [
                        $"{Notes(brain?.ItemCount ?? 0)} · {chapters} {(chapters == 1 ? "chapter" : "chapters")}",
                        $"{Notes(brain?.LinkingNotes ?? 0)} reach into a devbook",
                        "Select a scope to step inside it."
                    ];
                case { Kind: DevbookLobesScopeKind.Brain } scope:
                    return [Notes(scope.ItemCount), $"{Notes(scope.LinkingNotes)} link into a devbook", Indexed(scope)];
                case { Kind: DevbookLobesScopeKind.Ghost } scope:
                    return [$"No repository with this alias is on this machine, so only the {scope.ItemCount} {(scope.ItemCount == 1 ? "chapter" : "chapters")} your notes name are shown, in the link's own words."];
                case var scope:
                    List<string> lines = [$"{scope.ItemCount} {(scope.ItemCount == 1 ? "chapter" : "chapters")}", $"{Notes(scope.LinkingNotes)} from the Brain link here", Indexed(scope)];
                    if (!scope.Available && scope.Message is { Length: > 0 } message) lines.Add(message);
                    return lines;
            }
        }
    }

    /// <summary>When the scope's index was last built, coarse — "4 minutes ago" —
    /// or that it has not been.</summary>
    private string Indexed(DevbookLobesScope scope) => scope.IndexedAt is { } at
        ? $"Indexed {DevbookAnnotationComments.Ago(at, (Services.GetService<TimeProvider>() ?? TimeProvider.System).GetUtcNow())}"
        : "Not indexed yet";

    private string CardAction => CurrentScope?.Kind switch
    {
        null => "Step into the Brain",
        DevbookLobesScopeKind.Brain => "Open in the pane",
        _ => "Open devbook"
    };

    protected override void OnInitialized() => Lobes.Changed += OnLobesChanged;

    /// <summary>Every render the host makes hands the scope in again; the atlas lays
    /// out again only when what it draws changed, since a fresh model repaints.</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (_graph is null) await LoadAsync();
        else await FollowAsync(force: false);
    }

    private async Task LoadAsync()
    {
        _graph = await Lobes.ReadAsync();
        SeedHiddenTechnology();

        // A ghost stepped into whose alias was registered meanwhile: the shell is
        // asked for that repository, and the atlas follows it there.
        if (_ghostFocus is { } ghost && _graph.Scope(ghost) is null)
        {
            _ghostFocus = null;
            if (RegisteredAlias(ghost) is { } alias) await OnScopeTo.InvokeAsync(alias);
        }

        await FollowAsync(force: true);
    }

    /// <summary>The shell's scope and the host's hand-over applied, then the layout
    /// derived again. A change of the shell's scope is a new view, so it leaves a
    /// ghost the reader stepped into.</summary>
    private async Task FollowAsync(bool force)
    {
        var selection = $"{RepositoryScope.Count}:{string.Join('\u001f', RepositoryScope)}";
        if (_appliedSelection is not null && !string.Equals(selection, _appliedSelection, StringComparison.Ordinal)) _ghostFocus = null;
        _appliedSelection = selection;

        await ApplyHandOverAsync();
        Relayout(force);
    }

    /// <summary>The ghost the host handed in, applied once per hand-over and only
    /// once there is a map: stepped into with Ghosts on, or — registered since —
    /// the shell asked for its repository.</summary>
    private async Task ApplyHandOverAsync()
    {
        var asked = string.IsNullOrWhiteSpace(Scope) ? null : Scope.Trim();
        if (_graph is not { Available: true } || string.Equals(asked, _appliedScope, StringComparison.Ordinal)) return;

        _appliedScope = asked;
        if (asked is null) return;

        if (_graph.Scope(asked) is { Kind: DevbookLobesScopeKind.Ghost } ghost)
        {
            _ghostFocus = ghost.Key;
            _showGhosts = true;
        }
        else if (RegisteredAlias(asked) is { } alias)
        {
            await OnScopeTo.InvokeAsync(alias);
        }
    }

    /// <summary>
    /// The layout and the scopes it draws: one scope in view, and no ghost, is
    /// that scope's own layout; otherwise All with the scopes in view and, with
    /// Ghosts on, every ghost. A ghost stepped into wins over both. A new layout
    /// or a new set of scopes drops the selection and hands the renderer a fresh
    /// model, which starts from its default camera.
    /// </summary>
    private void Relayout(bool force = false)
    {
        if (_graph is not { Available: true })
        {
            _nothingInView = false;
            Project();
            return;
        }

        List<string> inView = RepositoryScope.Count == 0
            ? [.. _graph.Scopes.Where(scope => scope.Kind != DevbookLobesScopeKind.Ghost).Select(scope => scope.Key)]
            : [.. RepositoryScope
                .Select(member => _graph.Scope(DevbookLobesAtlas.ScopeKeyFor(member)))
                .OfType<DevbookLobesScope>()
                .Where(scope => scope.Kind != DevbookLobesScopeKind.Ghost)
                .Select(scope => scope.Key)
                .Distinct(StringComparer.Ordinal)];
        List<string> ghosts = _showGhosts
            ? [.. _graph.Scopes.Where(scope => scope.Kind == DevbookLobesScopeKind.Ghost).Select(scope => scope.Key)]
            : [];

        if (_ghostFocus is { } focus && _graph.Scope(focus) is not { Kind: DevbookLobesScopeKind.Ghost }) _ghostFocus = null;

        var layout = _ghostFocus ?? (inView.Count == 1 && ghosts.Count == 0 ? inView[0] : LobesAtlasModel.AllLayout);
        IReadOnlyList<string> drawn = layout == LobesAtlasModel.AllLayout ? [.. inView, .. ghosts] : [layout];

        var changed = layout != _layout || !drawn.Order(StringComparer.Ordinal).SequenceEqual(_drawn.Order(StringComparer.Ordinal), StringComparer.Ordinal);
        if (changed) _selectedId = null;

        _layout = layout;
        _drawn = drawn;
        _nothingInView = drawn.Count == 0;
        if (changed || force) Project();
    }

    /// <summary>A row of All's panel: a ghost's steps into it here; a registered
    /// scope's asks the shell for it alone.</summary>
    private Task OpenRowAsync(DevbookLobesScope scope)
    {
        if (scope.Kind == DevbookLobesScopeKind.Ghost)
        {
            _ghostFocus = scope.Key;
            Relayout();
            return Task.CompletedTask;
        }

        return OnScopeTo.InvokeAsync(scope.Kind == DevbookLobesScopeKind.Brain ? BrainScope.Value : scope.Alias ?? scope.Label);
    }

    /// <summary>The ghost card's Back to all scopes.</summary>
    private void LeaveGhost()
    {
        _ghostFocus = null;
        Relayout();
    }

    /// <summary>Ghosts: every unregistered devbook drawn in All, or taken off the
    /// map again — and a ghost stepped into left with them.</summary>
    private void ToggleGhosts()
    {
        _showGhosts = !_showGhosts;
        if (!_showGhosts) _ghostFocus = null;
        Relayout();
    }

    private void ToggleLabels()
    {
        _showLabels = !_showLabels;
        Project();
    }

    /// <summary>Pause: the idle turn held, or let go again. It lasts while the
    /// atlas is open; the renderer waits its delay before turning again.</summary>
    private void TogglePause()
    {
        _paused = !_paused;
        Project();
    }

    /// <summary>Each devbook's Parietal — its <c>tech/</c> chapters, a ghost
    /// devbook's included — starts hidden in that scope, the first time the
    /// atlas reads it.</summary>
    private void SeedHiddenTechnology()
    {
        if (_graph is null) return;

        foreach (var region in DevbookLobesAtlas.TechRegions(_graph))
        {
            if (_seededScopes.Add(region.Scope)) _hiddenLobes.Add(region);
        }
    }

    /// <summary>All's Tech toggle: every devbook's technology drawn and listed
    /// in All, or hidden again. It never touches a scope's own regions.</summary>
    private void ToggleTech()
    {
        _showTech = !_showTech;
        Project();
    }

    private void ToggleRegion(LobesAtlasRegionKey region)
    {
        if (!_hiddenLobes.Remove(region)) _hiddenLobes.Add(region);
        Project();
    }

    /// <summary>All and None: every region of the scope on screen, shown or
    /// hidden — and its Archive dust with them, which is no region and has no
    /// chip of its own, so None leaves nothing on the map. What is hidden
    /// elsewhere stays as it was.</summary>
    private void ShowEverything(bool show)
    {
        if (_graph is null || IsAll) return;

        _hiddenLobes.RemoveWhere(region => region.Scope == _layout);
        if (!show) _hiddenLobes.UnionWith(RegionOrder.Append(DevbookLobe.Dust).Select(lobe => new LobesAtlasRegionKey(_layout, DevbookLobesAtlas.LobeKey(lobe))));

        Project();
    }

    /// <summary>The renderer's model and the index rows, built once per change
    /// rather than per render: a fresh model is a changed parameter, and a
    /// changed parameter repaints the scene. All is drawn from the scopes in view
    /// alone, left out rather than hidden, so the renderer seats only them; a
    /// scope's own layout keeps the whole graph for the Brain's bundles into it.</summary>
    private void Project()
    {
        if (_graph is not { Available: true } || _nothingInView)
        {
            _model = null;
            _nodes = [];
            return;
        }

        var view = IsAll ? DevbookLobesAtlas.InView(_graph, _drawn) : _graph;
        IReadOnlyList<LobesAtlasRegionKey> hiddenAll = _showTech ? [] : DevbookLobesAtlas.TechRegions(view);
        _model = DevbookLobesAtlas.Model(view, _layout, [], _hiddenLobes, _showLabels, hiddenAll, idleMotion: !_paused);
        _nodes = DevbookLobesAtlas.IndexNodes(view, _layout, [], _hiddenLobes, hiddenAll);
        if (_selectedId is not null && _nodes.All(node => !string.Equals(node.Id, _selectedId, StringComparison.Ordinal))) _selectedId = null;
    }

    /// <summary>A camera report from the renderer, handed to the foot alone so
    /// the takeover and its index do not re-render on every drag.</summary>
    private void ShowCamera(GraphAtlasCamera camera) => _compass?.Show(camera);

    /// <summary>The empty state's Build the index now: the build waited for,
    /// then the atlas read again. A build that ran raises Changed as well, which
    /// reads again too; reading twice is harmless.</summary>
    private async Task BuildIndexAsync()
    {
        if (_building) return;

        _building = true;
        _buildProblem = null;
        StateHasChanged();

        try
        {
            _buildProblem = await Lobes.BuildBrainIndexAsync();
            await LoadAsync();
            if (_buildProblem is null && _graph is { BrainIndexMissing: true })
            {
                _buildProblem = NothingToIndex;
            }
        }
        catch (Exception ex)
        {
            // A button's handler that throws takes the whole renderer down, so
            // anything the build or the read after it raises — a cancellation as
            // the app stops included — is said in words instead.
            _buildProblem = $"The Brain's index could not be built: {ex.Message}";
        }
        finally
        {
            _building = false;
        }
    }

    /// <summary>What the empty state says when a build finished and there is
    /// still no index: the folder held nothing the Brain's convention builds.</summary>
    internal const string NothingToIndex =
        "The build finished, but the Brain folder held nothing to index yet. Add a note, then try again.";

    private Task SelectAsync(string? id)
    {
        _selectedId = id;
        return Task.CompletedTask;
    }

    private Task OnSheetOpenChanged(bool open) => open ? Task.CompletedTask : SelectAsync(null);

    private Task OpenRepositoryLinkAsync(string? raw) =>
        Lobes.RepositoryChapterFor(raw) is { } chapter ? OnOpenRepositoryChapter.InvokeAsync(chapter) : Task.CompletedTask;

    /// <summary>A registered devbook's own chapter as a link into it: the alias
    /// and the chapter's id within its devbook, which is the reference the
    /// Devbook opens.</summary>
    private DevbookRepositoryChapter? ChapterLink(DevbookLobesNode node)
    {
        if (_graph?.Scope(node.ScopeKey) is not { Kind: DevbookLobesScopeKind.Devbook, Alias: { Length: > 0 } alias }) return null;

        var bar = node.Id.IndexOf('|', StringComparison.Ordinal);
        return bar < 0 ? null : ChapterReference(alias, node.Id[(bar + 1)..]);
    }

    /// <summary>A devbook chapter's id as the reference the Devbook opens: the path
    /// with any leading <c>./</c> or <c>/</c> dropped, and its heading kept when
    /// there is one.</summary>
    internal static DevbookRepositoryChapter? ChapterReference(string alias, string id)
    {
        var target = id.Replace('\\', '/');
        string? slug = null;
        var hash = target.IndexOf('#', StringComparison.Ordinal);
        if (hash >= 0)
        {
            var anchor = target[(hash + 1)..].Trim();
            slug = anchor.Length == 0 ? null : anchor;
            target = target[..hash];
        }

        var path = target.Trim();
        while (path.StartsWith("./", StringComparison.Ordinal)) path = path[2..];
        path = path.TrimStart('/');

        var trimmedAlias = alias.Trim();
        return trimmedAlias.Length == 0 || path.Length == 0 ? null : new DevbookRepositoryChapter(trimmedAlias, slug is null ? path : $"{path}#{slug}");
    }

    /// <summary>The alias of a ghost's key that has been registered since — the
    /// graph holding its devbook instead; null for any other key.</summary>
    private string? RegisteredAlias(string key)
    {
        const string ghost = DevbookLobesGraph.GhostScopePrefix;
        if (_graph is null || !key.StartsWith(ghost, StringComparison.OrdinalIgnoreCase) || _graph.Scope(key) is not null) return null;

        var alias = key[ghost.Length..];
        return _graph.Scope(DevbookLobesAtlas.ScopeKeyFor(alias)) is { Kind: DevbookLobesScopeKind.Devbook } devbook
            ? devbook.Alias ?? alias
            : null;
    }

    /// <summary>The ghost card's Register repository: the Repositories settings,
    /// where a clone of that alias is registered. The host hears the scope first,
    /// to reopen the atlas on it once the reader comes back.</summary>
    private async Task RegisterRepository()
    {
        await OnRegisterRepository.InvokeAsync(_layout);
        Navigation.NavigateTo(RepositorySettings);
    }

    /// <summary>Where Register repository goes.</summary>
    internal const string RepositorySettings = "settings/repositories";

    /// <summary>The card's action. All's Step into the Brain asks the shell for the
    /// Brain alone, and the atlas follows it there.</summary>
    private Task CardActionAsync() => CurrentScope switch
    {
        null => OnScopeTo.InvokeAsync(BrainScope.Value),
        { Kind: DevbookLobesScopeKind.Brain } => OnOpenScope.InvokeAsync(string.Empty),
        var scope => OnOpenScope.InvokeAsync(scope.Alias ?? scope.Label)
    };

    /// <summary>The Brain's index or a devbook changed: the atlas reads again,
    /// inside <c>InvokeAsync</c> because the word arrives off the renderer's
    /// thread, and guarded because a read can find a folder moving under it — the
    /// atlas that last read then stays on screen.</summary>
    private async void OnLobesChanged() =>
        await InvokeAsync(async () =>
        {
            try
            {
                await LoadAsync();
            }
            catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
            {
            }

            StateHasChanged();
        });

    public void Dispose() => Lobes.Changed -= OnLobesChanged;
}
