@inject DesignDevbookProvider DesignDevbook

@*
    The Design section of the pane. All of the drawing is DocumentDevbookView's;
    what this wrapper adds is which folder — the injection names the design
    provider by type, and the provider carries the folder. It exists so the pane
    and the tests keep naming the section they mean rather than assembling one
    out of a view and a provider at every call site.
*@
<DocumentDevbookView Provider="@DesignDevbook"
                     RepositoryAlias="@RepositoryAlias"
                     SelectedPath="@SelectedPath"
                     OnNavigateToChapter="@OnNavigateToChapter" />

@code {
    [Parameter]
    public string? RepositoryAlias { get; set; }

    [Parameter]
    public string? SelectedPath { get; set; }

    /// <summary>Raised when a reader follows a reference out of a design
    /// document; see <see cref="DocumentDevbookView.OnNavigateToChapter"/>.</summary>
    [Parameter]
    public EventCallback<DevbookChapterLink> OnNavigateToChapter { get; set; }
}
