@*
    The AI adoption record drawn as the delivery path: the seven stages in path
    order, the four before the pull request on the first row and the three after
    it on the second, then the three layers beneath, and at each the AI usages
    that sit there. What is drawn is AiModel's, which reads it off the chapters'
    own fields — this file only lays it out, so nothing here decides where a
    usage goes.

    An interim picture: the Adoption, Cohesion and Model tabs replace it, and the
    eight-stage infinity figure it used to draw went with the eight stages.

    The ladder is shaded on the chart ramp — one hue, lighter for less adopted —
    because the palette is single-hue by rule; a stage's accent takes the highest
    rung among its usages, and an empty stage wears the track, which is the
    picture reporting an absence rather than hiding one.
*@
<section class="ai-loop" aria-label="AI usage along the delivery path" data-testid="ai-loop">
    <div class="ai-loop__grid">
        @foreach (var stage in Model.Stages)
        {
            @Card(stage.Key, stage.Name, stage.BeforePullRequest ? "Before PR" : "After PR", stage.Status, stage.Usages, "stage")
        }
    </div>

    <div class="ai-loop__grid" role="group" aria-label="Layers beneath the path">
        @foreach (var layer in Model.Layers)
        {
            @Card(layer.Key, layer.Name, "Layer", layer.Status, layer.Usages, "layer")
        }
    </div>

    @if (Model.Throughout.Count > 0)
    {
        <section class="ai-loop__concepts" aria-label="Throughout the path" data-testid="ai-loop-concepts">
            <h4 class="ai-loop__stage-name">Throughout the path</h4>
            <ul class="ai-loop__usages ai-loop__usages--inline">
                @foreach (var concept in Model.Throughout)
                {
                    <li>@Usage(concept)</li>
                }
            </ul>
        </section>
    }

    <p class="ai-loop__legend" aria-label="Adoption ladder">
        @foreach (var rung in Rungs)
        {
            <span class="@($"ai-loop__key ai-loop__key--{rung}")">@rung</span>
        }
    </p>
</section>

@code {
    /// <summary>The model to draw, read from the folder by <see cref="AiModel.From"/>.</summary>
    [Parameter, EditorRequired]
    public AiModel Model { get; set; } = default!;

    /// <summary>Raised when a reader opens a usage's chapter. The host owns the
    /// selection, so this is a request rather than a move — the same shape as the
    /// folder view's own reference links.</summary>
    [Parameter]
    public EventCallback<DevbookChapterLink> OnNavigateToChapter { get; set; }

    private static readonly string[] Rungs = ["adopted", "trial", "candidate", "hold", "retired"];

    private RenderFragment Card(string key, string name, string where, string? status, IReadOnlyList<AiModelUsage> usages, string kind) =>
        @<section class="@($"ai-loop__stage ai-loop__stage--{RungClass(status)}")"
                  aria-label="@($"{name} {kind}")"
                  data-testid="@($"ai-loop-{kind}-{key}")">
            <header class="ai-loop__stage-header">
                <h4 class="ai-loop__stage-name">@name</h4>
                <span class="ai-loop__half">@where</span>
            </header>
            @if (usages.Count == 0)
            {
                <EmptyState BaseClass="ai-loop__empty" TitleCssClass="ai-loop__empty-text" Title="No AI usage" />
            }
            else
            {
                <ul class="ai-loop__usages">
                    @foreach (var usage in usages)
                    {
                        <li>@Usage(usage)</li>
                    }
                </ul>
            }
        </section>;

    private RenderFragment Usage(AiModelUsage usage) =>
        @<AppButton Variant="ButtonVariant.None"
                    BaseClass="ai-loop__usage"
                    CssClass="@($"ai-loop__usage--{RungClass(usage.Status)}")"
                    TestId="ai-loop-usage"
                    OnClick="() => OnNavigateToChapter.InvokeAsync(usage.Link)"
                    AdditionalAttributes="@UsageAttributes(usage)">
            <span class="ai-loop__usage-name">@usage.Heading</span>
            @* The rating leads the second line rather than sharing the first: a
               status badge is a fixed-width column, and beside the name it left a
               quarter of the card for the words a reader came for. *@
            <span class="ai-loop__usage-meta">
                <DevbookStatusPill Status="@usage.Status" Folder="DevbookFolder.Ai" />
                @if (usage.Type is not null)
                {
                    <span class="ai-loop__usage-type">@usage.Type</span>
                }
                @foreach (var technology in usage.Technologies)
                {
                    <span class="ai-loop__usage-tech">@technology</span>
                }
            </span>
        </AppButton>;

    private static IReadOnlyDictionary<string, object> UsageAttributes(AiModelUsage usage) =>
        new Dictionary<string, object>
        {
            ["title"] = usage.Date is null ? $"Open {usage.Heading}" : $"Open {usage.Heading} — rated {usage.Date}"
        };

    /// <summary>The rung as a class, or <c>empty</c> — for a stage nothing sits
    /// at, and for a usage whose status is off the ladder, which the pill beside
    /// it already flags.</summary>
    private static string RungClass(string? status) =>
        status is not null && Rungs.Contains(status.Trim().ToLowerInvariant())
            ? status.Trim().ToLowerInvariant()
            : "empty";
}
