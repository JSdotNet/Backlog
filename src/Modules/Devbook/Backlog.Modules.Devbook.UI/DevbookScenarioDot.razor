@*
    The four-state dot of a scenario page, from its ScenarioState: the library's
    ScenarioStateDot, so the knowledge view, a task's acceptance checklist and a
    run's evidence draw one dot. The precedence is the page's: never run, then
    stale, then failed, then passed.
*@
<ScenarioStateDot State="@ScenarioEvidence.Slug(State)" TestId="@TestId" />

@code {
    [Parameter, EditorRequired]
    public ScenarioState State { get; set; }

    [Parameter]
    public string? TestId { get; set; } = "devbook-scenario-dot";
}
