@*
    The architecture surface's left navigation (local ADR 0046): one tree, the same
    groups in the same order whatever is open, so the reader never loses the way back.

    - "C4 views" — every view once, the zoom chain indented under the system it opens:
      a line opens its view in the picture, and is the way back to the picture from a
      document.
    - "arc42" — a group headed as "C4 views" is, listing every chapter with its C4 /
      ADR / TDR badges and the chapters that document the open view marked. The records
      sit under the chapter that holds them: "Decisions" under 09, the decision log
      under its All / Accepted / Proposed filter, and "Technical debt" under 11, each a
      fold with its count.
    - "Flows" and "Deployment", then "Other views", last.

    Opening a records fold folds it open in place and leaves the picture up; opening a
    record, or the chapter that holds it, folds its records open. There was a version of this that
    swapped the whole column for the decision log or the chapter list, with a "Back
    to the C4 model" line as the only way out: the column stopped saying where the
    reader was. What each line opens is the panel's; this only draws the tree, each
    line a button that reports what it names.
*@

<nav class="arc42-surface-nav" aria-label="Architecture" data-testid="arc42-surface-nav">
    @foreach (var group in Views.Where(entry => entry.Group == C4ViewIndexGroup.Model).GroupBy(entry => entry.Group))
    {
        @ViewGroup(group.Key, [.. group])
    }

    <section class="arc42-surface-nav__group" aria-labelledby="@Id("chapters")" data-testid="arc42-surface-chapters">
        <h2 class="arc42-surface-nav__heading" id="@Id("chapters")">arc42</h2>
        <div class="arc42-surface-nav__folded" data-testid="arc42-surface-documents">
            @if (HasModel && Documenting.Count == 0)
            {
                <p class="arc42-surface-nav__none" data-testid="arc42-surface-documents-none">No chapter documents this view.</p>
            }
            @foreach (var chapter in Chapters)
            {
                var open = Same(chapter.Path, OpenPath);
                var citation = CitationOf(chapter.Path);
                <AppButton @key="chapter.Path"
                           BaseClass="arc42-surface-nav__item"
                           CssClass="@ItemClass(open, citation is null ? null : "arc42-surface-nav__item--documents")"
                           Variant="ButtonVariant.None"
                           aria-current="@(open ? "page" : null)"
                           title="@ChapterTooltip(chapter.Number, chapter.Title, citation)"
                           data-documents="@(citation is null ? null : "true")"
                           TestId="arc42-surface-chapter"
                           OnClick="() => OnOpenDocument.InvokeAsync(citation?.Reference ?? chapter.Path)">
                    @if (chapter.Number is not null)
                    {
                        <span class="arc42-surface-nav__number">@chapter.Number</span>
                    }
                    <span class="arc42-surface-nav__label">@chapter.Title</span>
                    @if (citation is not null)
                    {
                        <span class="arc42-surface-nav__mark" aria-hidden="true"></span>
                        <span class="sr-only">, documents this view</span>
                    }
                    @if (chapter.Views > 0)
                    {
                        <Badge BaseClass="arc42-surface-nav__badge" Kind="c4" TestId="arc42-surface-chapter-c4">C4 @chapter.Views</Badge>
                    }
                    @if (chapter.Decisions > 0)
                    {
                        <Badge BaseClass="arc42-surface-nav__badge" Kind="adr" TestId="arc42-surface-chapter-adr">@chapter.Decisions ADR</Badge>
                    }
                    @if (chapter.Debt > 0)
                    {
                        <Badge BaseClass="arc42-surface-nav__badge" Kind="tdr" TestId="arc42-surface-chapter-tdr">@chapter.Debt TDR</Badge>
                    }
                </AppButton>
                @RecordsUnder(chapter.Number)
            }
            @* A chapter the views map names that the folder does not have — renamed
               since — is still offered, so the map's mistake shows; opening it
               leaves the surface where it is. *@
            @foreach (var citation in Documenting.Where(citation => !Chapters.Any(chapter => Same(chapter.Path, citation.Path))))
            {
                <AppButton @key="citation.Reference"
                           BaseClass="arc42-surface-nav__item"
                           CssClass="arc42-surface-nav__item--documents"
                           Variant="ButtonVariant.None"
                           title="@ChapterTooltip(citation.Number, citation.Title, citation)"
                           data-documents="true"
                           TestId="arc42-surface-chapter"
                           OnClick="() => OnOpenDocument.InvokeAsync(citation.Reference)">
                    @if (citation.Number is not null)
                    {
                        <span class="arc42-surface-nav__number">@citation.Number</span>
                    }
                    <span class="arc42-surface-nav__label">@citation.Title</span>
                    <span class="arc42-surface-nav__mark" aria-hidden="true"></span>
                    <span class="sr-only">, documents this view</span>
                </AppButton>
            }
            @* Decisions or debt the folder has no chapter for still sit in the
               group, last, so no record is out of reach. *@
            @if (!Chapters.Any(chapter => chapter.Number == Arc42Surface.DecisionsChapter))
            {
                @RecordsUnder(Arc42Surface.DecisionsChapter)
            }
            @if (!Chapters.Any(chapter => chapter.Number == Arc42Surface.DebtChapter))
            {
                @RecordsUnder(Arc42Surface.DebtChapter)
            }
        </div>
    </section>

    @foreach (var group in Views.Where(entry => entry.Group is not C4ViewIndexGroup.Model and not C4ViewIndexGroup.Other).GroupBy(entry => entry.Group))
    {
        @ViewGroup(group.Key, [.. group])
    }

    @if (Views.Any(entry => entry.Group == C4ViewIndexGroup.Other))
    {
        @ViewGroup(C4ViewIndexGroup.Other, [.. Views.Where(entry => entry.Group == C4ViewIndexGroup.Other)])
    }
</nav>

@code {
    private readonly string _id = "arc42-surface-nav-" + Guid.NewGuid().ToString("N");

    /// <summary>The model's views, as <see cref="C4ViewIndex"/> lists them.</summary>
    [Parameter]
    public IReadOnlyList<C4ViewIndexEntry> Views { get; set; } = [];

    /// <summary>Where the zoom is: the line marked open while no document is.</summary>
    [Parameter]
    public C4ZoomLocation? Location { get; set; }

    /// <summary>The chapters that document the view the zoom is at, marked on the
    /// chapter list.</summary>
    [Parameter]
    public IReadOnlyList<Arc42SurfaceCitation> Documenting { get; set; } = [];

    [Parameter]
    public IReadOnlyList<Arc42SurfaceChapter> Chapters { get; set; } = [];

    [Parameter]
    public IReadOnlyList<Arc42SurfaceRecord> Decisions { get; set; } = [];

    [Parameter]
    public IReadOnlyList<Arc42SurfaceRecord> Debt { get; set; } = [];

    /// <summary>The document open in place of the picture, or null while the picture
    /// is up. Marked where it sits, and its group folded open.</summary>
    [Parameter]
    public string? OpenPath { get; set; }

    /// <summary>Whether there is a model. Without one the surface is the chapters
    /// alone: no view groups, and the chapter list open.</summary>
    [Parameter]
    public bool HasModel { get; set; } = true;

    [Parameter]
    public EventCallback<C4ViewIndexEntry> OnOpenView { get; set; }

    /// <summary>A chapter or a record, by its path — a reference that may name a
    /// section.</summary>
    [Parameter]
    public EventCallback<string> OnOpenDocument { get; set; }

    private string DecisionsDetail
    {
        get
        {
            var local = Decisions.Where(record => !record.Guideline).ToList();
            var proposed = local.Count(record => record.Proposed);
            return proposed == 0 ? $"{local.Count}" : $"{local.Count} · {proposed} proposed";
        }
    }

    /// <summary>A chapter line's tooltip: its number and full title, which the line cuts
    /// with an ellipsis, and the section the views map names when it documents the view.</summary>
    private static string ChapterTooltip(string? number, string title, Arc42SurfaceCitation? citation)
    {
        var name = number is null ? title : $"{number} {title}";
        return citation is null ? name : $"{name} · documents this view ({citation.Reference})";
    }

    private string Id(string part) => $"{_id}-{part}";

    // ---- the folds -----------------------------------------------------------------

    /// <summary>The records folds, each under the chapter that holds it.</summary>
    private enum Fold
    {
        Decisions,
        Debt
    }

    private readonly Dictionary<Fold, bool> _open = [];
    private bool _initialised;
    private string? _seenOpenPath;

    private bool IsOpen(Fold fold) => _open.TryGetValue(fold, out var open) && open;

    private void SetOpen(Fold fold, bool open) => _open[fold] = open;

    /// <summary>
    /// The folds follow what is opened, and are the reader's otherwise: a record opened,
    /// or the chapter that holds it, folds its records open; a fold folded by hand stays
    /// as it was left until the next document.
    /// </summary>
    protected override void OnParametersSet()
    {
        if ((!_initialised || !SamePath(OpenPath, _seenOpenPath)) && Owner(OpenPath) is { } owner)
        {
            _open[owner] = true;
        }

        _initialised = true;
        _seenOpenPath = OpenPath;
    }

    /// <summary>The records fold a document belongs to: a decision record or the
    /// decisions chapter to Decisions, a debt record or the risks chapter to Technical
    /// debt; any other chapter to none.</summary>
    private static Fold? Owner(string? path)
    {
        if (path is null) return null;
        if (Arc42DevbookCatalog.IsArchitectureDecision(path)) return Fold.Decisions;
        if (Arc42DevbookCatalog.IsDebtRecord(path)) return Fold.Debt;

        return C4ElementInspection.NumberOf(path) switch
        {
            Arc42Surface.DecisionsChapter => Fold.Decisions,
            Arc42Surface.DebtChapter => Fold.Debt,
            _ => null
        };
    }

    // ---- the decision log's filter -------------------------------------------------

    /// <summary>What the decision log's filter keeps.</summary>
    private enum DecisionStatus
    {
        All,
        Accepted,
        Proposed
    }

    private static readonly DecisionStatus[] StatusChoices = [DecisionStatus.All, DecisionStatus.Accepted, DecisionStatus.Proposed];

    /// <summary>The filter chosen. Kept while the navigation lives, so moving from one
    /// record to the next keeps the list the reader narrowed.</summary>
    private DecisionStatus _status = DecisionStatus.All;

    private void ChooseStatus(DecisionStatus choice, bool pressed)
    {
        if (pressed) _status = choice;
    }

    private static bool Keeps(DecisionStatus status, Arc42SurfaceRecord record) => status switch
    {
        DecisionStatus.Accepted => record.Accepted,
        DecisionStatus.Proposed => record.Proposed,
        _ => true
    };

    // ---- the lines -----------------------------------------------------------------

    /// <summary>One group of the views list, under its heading. A line is marked open
    /// only while the picture is up: with a document open, the document's line is.</summary>
    private RenderFragment ViewGroup(C4ViewIndexGroup key, IReadOnlyList<C4ViewIndexEntry> entries) => @<text>
        @{ var groupId = Id($"views-{key.ToString().ToLowerInvariant()}"); }
        <section class="arc42-surface-nav__group"
                 aria-labelledby="@groupId"
                 data-group="@key.ToString().ToLowerInvariant()"
                 data-testid="@(key == C4ViewIndexGroup.Model ? "arc42-surface-views" : "arc42-surface-views-group")">
            <h2 class="arc42-surface-nav__heading" id="@groupId">@GroupTitle(key)</h2>
            @foreach (var entry in entries)
            {
                var open = OpenPath is null && entry.IsOpen(Location?.ViewKey, Location?.CodeComponentId);
                <AppButton @key="(entry.ViewKey, entry.CodeComponentId)"
                           BaseClass="arc42-surface-nav__item"
                           CssClass="@ItemClass(open, $"arc42-surface-nav__item--line arc42-surface-nav__item--depth-{Math.Min(entry.Depth, 4)}")"
                           Variant="ButtonVariant.None"
                           aria-current="@(open ? "page" : null)"
                           title="@entry.Title"
                           data-view="@entry.ViewKey"
                           data-code="@entry.CodeComponentId"
                           TestId="arc42-surface-view"
                           OnClick="() => OnOpenView.InvokeAsync(entry)">
                    <span class="arc42-surface-nav__label">@entry.Label</span>
                    <span class="arc42-surface-nav__detail arc42-surface-nav__detail--column">@entry.Detail</span>
                </AppButton>
            }
        </section>
    </text>;

    /// <summary>What a group of the views list is headed: the model's levels, then the
    /// views beside them.</summary>
    private static string GroupTitle(C4ViewIndexGroup group) => group switch
    {
        C4ViewIndexGroup.Flows => "Flows",
        C4ViewIndexGroup.Deployment => "Deployment",
        C4ViewIndexGroup.Other => "Other views",
        _ => "C4 views"
    };

    private static string? ItemClass(bool open, string? extra = null)
    {
        var classes = string.Join(' ', new[] { open ? "arc42-surface-nav__item--open" : null, extra }.Where(part => part is not null));
        return classes.Length == 0 ? null : classes;
    }

    private static bool Same(string path, string? other) =>
        other is not null && string.Equals(C4ViewEntry.FileOf(path), C4ViewEntry.FileOf(other), StringComparison.OrdinalIgnoreCase);

    private static bool SamePath(string? path, string? other) =>
        path is null ? other is null : Same(path, other);

    private Arc42SurfaceCitation? CitationOf(string path) =>
        Documenting.FirstOrDefault(citation => Same(path, citation.Path));

    /// <summary>The records a chapter holds, folded under its line one step in:
    /// "Decisions" under 09, the decision log under its status filter, and "Technical
    /// debt" under 11. Any other chapter holds none.</summary>
    private RenderFragment RecordsUnder(string? number) => number switch
    {
        Arc42Surface.DecisionsChapter => DecisionsFold,
        Arc42Surface.DebtChapter => DebtFold,
        _ => _ => { }
    };

    private RenderFragment DecisionsFold => @<FoldControl BaseClass="arc42-surface-nav__fold arc42-surface-nav__fold--records"
                                                          HeadingLevel="3"
                                                          HeadingCssClass="arc42-surface-nav__fold-heading"
                                                          Expanded="@IsOpen(Fold.Decisions)"
                                                          ExpandedChanged="@(expanded => SetOpen(Fold.Decisions, expanded))"
                                                          TestId="arc42-surface-decisions">
        <LabelContent>
            <span class="arc42-surface-nav__fold-title">Decisions</span>
            <span class="arc42-surface-nav__detail" data-testid="arc42-surface-decisions-count">@DecisionsDetail</span>
        </LabelContent>
        <ChildContent>
            <div class="arc42-surface-nav__folded" data-testid="arc42-surface-decision-log">
                @if (Decisions.Count > 0)
                {
                    @* The status filter: one choice, counted over the local decisions the
                       trigger counts, and applied to the guidelines below them too. *@
                    <ButtonGroup Radio="true"
                                 CssClass="arc42-surface-nav__filter"
                                 AriaLabel="Status filter"
                                 TestId="arc42-surface-decision-filter">
                        @foreach (var choice in StatusChoices)
                        {
                            <ToggleButton @key="choice"
                                          Pressed="@(_status == choice)"
                                          PressedChanged="@(pressed => ChooseStatus(choice, pressed))"
                                          BaseClass="btn btn--toggle btn--small"
                                          TestId="@($"arc42-surface-decision-filter-{choice.ToString().ToLowerInvariant()}")">@choice @Decisions.Count(record => !record.Guideline && Keeps(choice, record))</ToggleButton>
                        }
                    </ButtonGroup>
                }

                @RecordList(Decisions.Where(record => !record.Guideline && Keeps(_status, record)), "ADR")
                @if (Decisions.Any(record => record.Guideline && Keeps(_status, record)))
                {
                    <h4 class="arc42-surface-nav__subheading">Guidelines · @Decisions.Count(record => record.Guideline && Keeps(_status, record))</h4>
                    @RecordList(Decisions.Where(record => record.Guideline && Keeps(_status, record)), "ADR")
                }
            </div>
        </ChildContent>
    </FoldControl>;

    private RenderFragment DebtFold => @<FoldControl BaseClass="arc42-surface-nav__fold arc42-surface-nav__fold--records"
                                                     HeadingLevel="3"
                                                     HeadingCssClass="arc42-surface-nav__fold-heading"
                                                     Expanded="@IsOpen(Fold.Debt)"
                                                     ExpandedChanged="@(expanded => SetOpen(Fold.Debt, expanded))"
                                                     TestId="arc42-surface-debt">
        <LabelContent>
            <span class="arc42-surface-nav__fold-title">Technical debt</span>
            <span class="arc42-surface-nav__detail arc42-surface-nav__detail--debt" data-testid="arc42-surface-debt-count">@Debt.Count</span>
        </LabelContent>
        <ChildContent>
            <div class="arc42-surface-nav__folded" data-testid="arc42-surface-debt-log">
                @RecordList(Debt, "TDR")
            </div>
        </ChildContent>
    </FoldControl>;

    /// <summary>A record per line: its number, small, then its title on one line cut
    /// with an ellipsis — never broken inside a word — and the note on a line of its
    /// own under it. The whole "ADR 0005 Title", and the file it is, is the tooltip;
    /// the cut is the stylesheet's, so the text stays whole for a screen reader.</summary>
    private RenderFragment RecordList(IEnumerable<Arc42SurfaceRecord> records, string kind) => @<text>
        @foreach (var record in records)
        {
            var open = Same(record.Path, OpenPath);
            <AppButton @key="record.Path"
                       BaseClass="arc42-surface-nav__item"
                       CssClass="@ItemClass(open, "arc42-surface-nav__item--record")"
                       Variant="ButtonVariant.None"
                       aria-current="@(open ? "page" : null)"
                       title="@($"{kind} {record.Number} {record.Title} · {record.Slug}")"
                       data-numbered="@(record.Numbered ? null : "false")"
                       TestId="arc42-surface-record"
                       OnClick="() => OnOpenDocument.InvokeAsync(record.Path)">
                <span class="arc42-surface-nav__number">@record.Number</span>
                <span class="arc42-surface-nav__label">@record.Title</span>
                @if (record.Note is not null)
                {
                    <span class="arc42-surface-nav__detail arc42-surface-nav__detail--note" data-testid="arc42-surface-record-note">@record.Note</span>
                }
            </AppButton>
        }
    </text>;
}
