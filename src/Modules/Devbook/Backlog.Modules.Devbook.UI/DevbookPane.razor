@implements IDisposable
@inject DevbookMenu DevbookMenu
@inject DevbookFolderOpenService DevbookFolderOpen
@inject DevbookScope Scope
@inject DevbookUpdateService DevbookUpdate
@inject DevbookSourceSelection DevbookSource

@*
    The Devbook pane. Everything it needs arrives as a repository alias:
    which repository is being read follows the scope chosen above the backlog, so
    the knowledge beside an entry is the knowledge of the repository that entry
    belongs to — but the pane resolves that alias through DevbookScope rather
    than reading backlog state, so nothing here knows an entry exists.
*@

<section @key=@("devbook-pane") class="devbook-stack" id="repository-devbook-pane" data-testid="devbook-stack" aria-label="Repository devbook">
    @* No repository line above the strip. The repository was chosen by the scope
       strip over the workspace and is named there, and every file this pane opens
       carries its own path, so a third copy of the name only cost the sections a
       row of height. *@

    @* The section strip is the shared Tabs component wearing this pane's
       classes. It used to be a hand-rolled row of role="tab" buttons: correct
       roles, but every one of them its own tab stop and no arrow-key movement,
       which is the half of a tablist the component brings. The panels sit inside
       the body next to the menu, so the strip is rendered bare. *@
    <Tabs Bare="true"
          ListElement="nav"
          ListCssClass="devbook-stack__nav"
          AriaLabel="Devbook sections"
          TabCssClass="devbook-stack__nav-item"
          ActiveTabCssClass="devbook-stack__nav-item devbook-stack__nav-item--active"
          ActiveId="@EffectiveSection"
          ActiveIdChanged="SelectSection"
          StripCssClass="devbook-stack__strip">

    @* Which source the sections are read from, before the sections themselves,
       because it qualifies all five of them at once — the same reason the update
       control outlives the section it was pressed on. *@
    <ListLeading>
        @if (DevbookSource.CanChoose(ActiveRepositoryAlias))
        {
            @* The default shape, not Form: a label wrapping the select with the
               name read aloud rather than drawn, which is exactly what a control
               sitting on a strip beside tabs wants. *@
            @* Keyed on what the list contains, so loading the branches rebuilds
               the control rather than re-rendering it in place. Without this the
               browser is left holding the value of the entry that was picked to
               trigger the load — an option that no longer exists once the list is
               in — and the select shows a branch nobody selected while the
               configured source is something else entirely. *@
            <SelectField @key="@($"{ActiveRepositoryAlias}:{DevbookSource.HasBranches(ActiveRepositoryAlias)}")"
                         BaseClass="devbook-stack__source"
                         SelectCssClass="devbook-stack__source-select"
                         Label="@($"Devbook source for {ActiveRepositoryAlias}")"
                         TestId="devbook-source-select"
                         CurrentValue="@DevbookSource.CurrentValue(ActiveRepositoryAlias)"
                         Options="@DevbookSource.Options(ActiveRepositoryAlias)"
                         OnChanged="ChangeDevbookSourceAsync" />
            <Alert Message="@_sourceError"
                   TestId="devbook-source-error"
                   CssClass="devbook-stack__source-error"
                   Role="status"
                   Inline />
        }
    </ListLeading>

    @* One quiet button, on the same line as the section tabs rather than on a row
       of its own below them — that row cost height and gave nothing back. The map
       is a second way of looking at a set of documents rather than the way you
       read them, so it is offered and not imposed; Technology is the exception,
       and it has a tab of its own because a technology stack *is* a graph. *@
    <ListTrailing>
        @* The version control comes before the atlas toggle and outlives the
           section: which version of the knowledge you are reading is true of the
           whole clone, not of the tab you happen to be on, so unlike the atlas it
           does not disappear on Technology. One button, whose label follows the
           state, because "check" and "pull" are never both worth offering — you
           cannot pull what you have not found out is there. *@
        @if (ShowUpdateControl)
        {
            @if (BehindLabel is { } behind)
            {
                <Badge Kind="devbook-update"
                       Slug="behind"
                       BaseClass="devbook-stack__update-badge"
                       TestId="devbook-update-behind"
                       Title="@_updateState.Message">
                    @behind
                </Badge>
            }
            <AppButton BaseClass="devbook-stack__update-toggle"
                       Variant="ButtonVariant.None"
                       TestId="devbook-update-action"
                       Busy="_updateBusy"
                       BusyLabel="@DevbookUpdatePresentation.BusyLabel(_updateState)"
                       title="@UpdateActionTitle"
                       OnClick="RunUpdateActionAsync">
                @DevbookUpdatePresentation.ActionLabel(_updateState)
            </AppButton>
        }
        @* Search comes before the atlas and, unlike it, stays on Technology: the
           map is a second way of looking at the documents in one section, and
           search is a way into all of them at once, so which tab is open says
           nothing about whether it is worth offering. Behind a flag because the
           surface is only half the feature - the other half is a generated index
           the repository may not have, which the surface itself reports. *@
        @if (Scope.SearchOffered && VisibleAreas.Count > 0)
        {
            <AppButton BaseClass="devbook-stack__search-toggle"
                       Variant="ButtonVariant.None"
                       TestId="devbook-search-toggle"
                       title="@(_searchOpen ? "Close search" : "Search every devbook area at once")"
                       aria-expanded="@(_searchOpen ? "true" : "false")"
                       OnClick="ToggleSearch">
                @(_searchOpen ? "Hide search" : "Search")
            </AppButton>
        }
        @if (VisibleAreas.Count > 0 && !IsSectionActive("tech") && !_searchOpen)
        {
            @if (_atlasOpen)
            {
                <AppButton BaseClass="devbook-stack__atlas-all"
                           Variant="ButtonVariant.None"
                           TestId="devbook-atlas-all"
                           title="See the whole devbook at once"
                           OnClick="ShowAllDevbook">
                    All knowledge
                </AppButton>
            }
            <AppButton BaseClass="devbook-stack__atlas-toggle"
                       Variant="ButtonVariant.None"
                       TestId="devbook-atlas-toggle"
                       title="@(_atlasOpen ? "Close the atlas" : "See how this devbook links together")"
                       aria-expanded="@(_atlasOpen ? "true" : "false")"
                       OnClick="ToggleAtlasAsync">
                @(_atlasOpen ? "Hide atlas" : "Atlas")
            </AppButton>
        }
    </ListTrailing>

    <ChildContent>
        @* Above the body rather than in the strip: the strip has room for a
           control and none for a sentence, and what came back from the remote is
           always a sentence — "on the latest version", or the reason git gave for
           refusing. Role status, because it answers something the reader asked
           for and interrupting them with it would be too much. *@
        <Alert Message="@_updateState.Message"
               BaseClass="@DevbookUpdatePresentation.StatusClass(_updateState)"
               Role="status"
               TestId="devbook-update-status" />

        <div class="devbook-stack__body @(ShowMenu ? string.Empty : "devbook-stack__body--without-menu")">
            @if (ShowMenu)
            {
                <DevbookMenuTreeView HeadingLabel="@(VisibleAreas.FirstOrDefault(area => IsSectionActive(area.Key))?.Label ?? "Devbook")"
                                       RootFolder="ActiveMenuRoot"
                                       ShowOpenButton="@CanOpenActiveFolder"
                                       Nodes="ActiveMenuNodes"
                                       IsLoading="_menuLoading"
                                       OpenErrorMessage="@_folderOpenError"
                                       IsNodeSelected="IsMenuNodeSelected"
                                       IsNodeExpanded="IsMenuNodeExpanded"
                                       NodeClass="MenuNodeClass"
                                       IsFolderOpening="IsFolderOpening"
                                       OnNodeSelected="SelectMenuNode"
                                       OnOpenFolder="OpenFolderAsync" />
            }

            @if (VisibleAreas.Count == 0)
            {
                @* No areas means no tabs, so there is no panel to carry the
                   message that explains why the pane is empty. *@
                <div class="devbook-stack__section">
                    @RenderSection(string.Empty)
                </div>
            }
            else
            {
                @foreach (var area in VisibleAreas)
                {
                    @* The panel always renders: Tabs builds the section strip from
                       the panels that register with it, so swapping the panels out
                       for the map took the strip away with them and left the reader
                       no way back to a section. What the map replaces is the panel's
                       contents. *@
                    <TabPanel Id="@area.Key"
                              Title="@area.Label"
                              BaseClass="@(_atlasOpen || _searchOpen ? "devbook-stack__section devbook-stack__section--atlas" : "devbook-stack__section")">
                        @if (_searchOpen)
                        {
                            <DevbookSearchView RepositoryAlias="@ActiveRepositoryAlias"
                                                 OnNavigateToChapter="OpenChapterFromSearch" />
                        }
                        else if (_atlasOpen)
                        {
                            <DevbookAtlasView Scope="@AtlasScope"
                                                RepositoryAlias="@ActiveRepositoryAlias"
                                                OnNavigateToChapter="OpenChapterFromAtlas" />
                        }
                        else
                        {
                            @RenderSection(area.Key)
                        }
                    </TabPanel>
                }
            }
        </div>
    </ChildContent>
</Tabs>
</section>

@code {
    private readonly HashSet<string> _expandedMenuNodes = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _selectedChapterPaths = new(StringComparer.Ordinal);
    private readonly HashSet<string> _openingFolders = new(StringComparer.Ordinal);
    private DevbookMenuTree _menuTree = DevbookMenuTree.Empty;
    private string? _folderOpenError;
    private bool _menuLoading;
    private string _selectedSection = "instructions";
    private string _atlasScopeKey = "all";
    private bool _atlasOpen;
    private bool _searchOpen;
    private string? _loadedMenuRepositoryAlias;
    private string _loadedMenuVisibleKeyFingerprint = string.Empty;
    private DevbookUpdateState _updateState = DevbookUpdateState.NotChecked;
    private bool _updateBusy;
    private string? _checkedRepositoryAlias;

    /// <summary>The repository scope to read knowledge for. Empty or null is
    /// no scope, and the shell does not open the pane for one — every area
    /// would only say to pick a repository.</summary>
    [Parameter]
    public string? RepositoryAlias { get; set; }

    protected override void OnInitialized() => DevbookMenu.Changed += OnDevbookChanged;

    /// <summary>
    /// A folder, a repository or the snapshot cache moved under the pane. Both
    /// halves of what is on screen are read from settings that just changed —
    /// which sections there are, and what the menu lists inside the one being
    /// read — and neither the alias nor the visible-section fingerprint has moved,
    /// so <see cref="RefreshMenuAsync"/> would skip it. <see cref="ReloadMenuAsync"/>
    /// is what forgets that guard; the render it ends in re-reads the scope, which
    /// is why the section strip needs nothing of its own here.
    /// <para>
    /// The whole body sits inside <c>InvokeAsync</c>, not just the re-render. Most
    /// of what raises this arrives on the renderer's dispatcher, but a pull
    /// announces itself from <c>DevbookUpdateService.PullAsync</c>, which resumes
    /// on a threadpool continuation — and the reload writes <c>_menuTree</c>,
    /// <c>_expandedMenuNodes</c> and <c>_selectedChapterPaths</c>, which the render
    /// path reads and indexes into. Every other caller of
    /// <see cref="ReloadMenuAsync"/> was already on the dispatcher, so this is the
    /// one entry that has to say so.
    /// </para>
    /// <para>
    /// The version answer goes with the folder it was asked about. Keeping it
    /// would leave the pane reporting this clone three commits behind on the
    /// strength of a check run against the directory that just stopped being the
    /// one on screen — the staleness <see cref="ForgetUpdateStateOnScopeChange"/>
    /// exists to prevent, arriving by the one route that never changes the alias.
    /// A pull is the single case that gets here holding a fresh answer, and it
    /// assigns that answer after this has run, so forgetting costs it nothing.
    /// </para>
    /// </summary>
    private async void OnDevbookChanged() =>
        await InvokeAsync(async () =>
        {
            _updateState = DevbookUpdateState.NotChecked;
            _folderOpenError = null;
            await ReloadMenuAsync();
            StateHasChanged();
        });

    public void Dispose() => DevbookMenu.Changed -= OnDevbookChanged;

    protected override async Task OnParametersSetAsync()
    {
        ForgetUpdateStateOnScopeChange();
        await RefreshMenuAsync();
    }

    private IReadOnlyList<DevbookArea> VisibleAreas => Scope.VisibleAreas(RepositoryAlias);

    private string? ActiveRepositoryAlias => Scope.Repository(RepositoryAlias)?.Alias;

    /// <summary>The section actually shown. A section can stop being available
    /// (instructions turned off for this repository), and a tab panel pointing at
    /// nothing is worse than one that has moved on to the next section.</summary>
    private string EffectiveSection
    {
        get
        {
            var areas = VisibleAreas;
            if (areas.Count == 0) return string.Empty;

            return areas.Any(area => string.Equals(area.Key, _selectedSection, StringComparison.Ordinal))
                ? _selectedSection
                : areas[0].Key;
        }
    }

    private bool IsSectionActive(string key) => string.Equals(EffectiveSection, key, StringComparison.Ordinal);

    private IReadOnlyList<DevbookMenuNode> ActiveMenuNodes => ActiveMenuRoot switch
    {
        null => [],
        { Children.Count: > 0 } root => AreaOverviewRow(root) is { } overview ? [overview, .. root.Children] : root.Children,
        var root => [root]
    };

    private DevbookMenuNode? ActiveMenuRoot => RootOf(EffectiveSection);

    private DevbookMenuNode? RootOf(string areaKey) =>
        _menuTree.Roots.FirstOrDefault(node => string.Equals(node.AreaKey, areaKey, StringComparison.Ordinal));

    /// <summary>
    /// The row that opens a whole knowledge folder at once, above the chapters —
    /// or nothing, for an area whose panel has no such reading.
    /// <para>
    /// Only <c>.design</c>. Its panel draws every file of the folder stacked, each
    /// subject's status beside its own heading, and that is the reading a design
    /// folder is opened as a folder for; the other areas draw one chapter, and a
    /// row promising a folder view they do not have would go nowhere. The Domain
    /// panel draws a folder whole too, but the folder it draws is a bounded
    /// context — a row the tree already has.
    /// </para>
    /// <para>
    /// It is the area root wearing a name that says what it opens. Carrying the
    /// root's own path is the whole point: the path a reader selects is then a
    /// real node of the tree, which is what stops
    /// <see cref="EnsureSelectedChapter"/> replacing it with a chapter on the next
    /// menu load. Its children are dropped so the row is a destination rather than
    /// a second copy of the list below it.
    /// </para>
    /// </summary>
    private static DevbookMenuNode? AreaOverviewRow(DevbookMenuNode? root) =>
        root is { Available: true, AreaKey: "design" } ? root with { Label = "All documents", Children = [] } : null;

    /// <summary>Whether this row is that one, asked of a node the menu handed
    /// back.</summary>
    private bool IsAreaOverviewNode(DevbookMenuNode node) =>
        AreaOverviewRow(RootOf(node.AreaKey)) is { } overview
        && string.Equals(overview.Path, node.Path, StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Whether the menu offers to open this scope's folder in an editor.
    /// <para>
    /// A branch snapshot says no. The folder behind it is an app-managed cache
    /// the next fetch replaces wholesale, so opening it in an editor would be an
    /// invitation to type into something that quietly disappears. A null
    /// repository reads as yes so a fake that resolved a plain folder for an
    /// unknown alias still gets the offer.
    /// </para>
    /// </summary>
    private string? _sourceError;

    /// <summary>
    /// The reader picked a source — or asked for the branch list, which is the
    /// one entry that is a request rather than a source.
    /// <para>
    /// Nothing reloads the panels here. Writing the choice raises the settings
    /// store's change event, which the folder source republishes, and every open
    /// panel already reloads on that — the same path a folder being re-pointed
    /// in Settings has always taken.
    /// </para>
    /// </summary>
    private async Task ChangeDevbookSourceAsync(string? value)
    {
        _sourceError = null;

        if (DevbookSourceSelection.IsLoadRequest(value))
        {
            _sourceError = await DevbookSource.LoadBranchesAsync(ActiveRepositoryAlias, CancellationToken.None);
            return;
        }

        _sourceError = DevbookSource.Select(ActiveRepositoryAlias, value);

        // The version state was about the source that was just left, so it is
        // dropped rather than shown against the new one — "up to date" earned by
        // a clone must not sit beside a branch nobody has fetched.
        _updateState = DevbookUpdateState.NotChecked;
    }

    private bool CanOpenActiveFolder =>
        DevbookUpdate.Repository(ActiveRepositoryAlias)?.DevbookSource is not DevbookSourceKind.Branch;

    private bool SectionUsesMenu => !string.Equals(EffectiveSection, "tech", StringComparison.Ordinal);

    /// <summary>Whether the chapter tree sits beside the body. The map and the
    /// search results are both readings of the whole area rather than of the one
    /// chapter a menu selects, so neither shares the width with it — and Technology
    /// never had a menu to begin with.</summary>
    private bool ShowMenu => SectionUsesMenu && !_atlasOpen && !_searchOpen;

    private string? SelectedChapterPath =>
        SectionUsesMenu && _selectedChapterPaths.TryGetValue(EffectiveSection, out var path) ? path : null;

    /// <summary>Keeps the map on the section the strip is showing. With the atlas
    /// open the tabs are still live, and a reader pressing Domain while looking at
    /// the Design map plainly means "show me Domain" — leaving the map where it was
    /// would make the strip and the scope picker disagree about what is on
    /// screen.</summary>
    private void FollowSectionWithAtlas(string key)
    {
        if (!_atlasOpen) return;

        _atlasScopeKey = AtlasScopes.Any(scope => string.Equals(scope.Key, key, StringComparison.Ordinal))
            ? key
            : DevbookAtlasScope.All.Key;
    }

    private void SelectSection(string key)
    {
        FollowSectionWithAtlas(key);
        _selectedSection = key;
        _folderOpenError = null;
        if (SectionUsesMenu)
        {
            EnsureSelectedChapter();
        }
    }

    private void SelectMenuNode(DevbookMenuNode node)
    {
        if (!node.Available || node.Kind == DevbookMenuNodeKind.Message) return;

        _selectedSection = node.AreaKey;
        if (IsSelectableMenuNode(node) || IsContextOverviewNode(node) || IsAreaOverviewNode(node))
        {
            _selectedChapterPaths[node.AreaKey] = node.Path;
        }

        if (!node.HasChildren) return;

        var key = MenuNodeKey(node);
        if (!_expandedMenuNodes.Add(key))
        {
            _expandedMenuNodes.Remove(key);
        }
    }

    /// <summary>
    /// Opens the chapter a knowledge reference names, wherever in the pane it
    /// lives.
    /// <para>
    /// A panel renders the reference and this pane holds the selection, so this is
    /// the other half of following one. It is the same move a menu click makes —
    /// the section, the chapter, and the folders opened down to it — because
    /// arriving from a reference and arriving from the menu should leave the reader
    /// in the same place, with the menu showing where they are.
    /// </para>
    /// <para>
    /// A target the menu has never heard of is not followed. A reference is prose:
    /// it can name a chapter that was renamed, or one in a section this repository
    /// has turned off, and the menu tree is the only thing that knows. Selecting a
    /// path with nothing behind it would empty the panel, which reads as the
    /// reference having broken the pane rather than as the reference being stale.
    /// </para>
    /// </summary>
    /// <summary>The scopes the atlas offers: whichever sections this repository
    /// has turned on, and all of them together. Built from the same list the
    /// section strip is built from, so a folder switched off disappears from both
    /// at once.</summary>
    private IReadOnlyList<DevbookAtlasScope> AtlasScopes =>
    [
        DevbookAtlasScope.All,
        .. VisibleAreas
            .Where(area => !string.Equals(area.Key, "instructions", StringComparison.Ordinal))
            .Select(DevbookAtlasScope.ForArea)
    ];

    private DevbookAtlasScope AtlasScope =>
        AtlasScopes.FirstOrDefault(scope => string.Equals(scope.Key, _atlasScopeKey, StringComparison.Ordinal))
            ?? DevbookAtlasScope.All;

    /// <summary>Opens the map on the section the reader is in, so the button means
    /// "show me this" rather than "show me everything" — widening to the whole
    /// base is then one control away, inside the map.</summary>
    private Task ToggleAtlasAsync()
    {
        if (_atlasOpen)
        {
            CloseAtlas();
            return Task.CompletedTask;
        }

        _atlasScopeKey = AtlasScopes.Any(scope => string.Equals(scope.Key, EffectiveSection, StringComparison.Ordinal))
            ? EffectiveSection
            : DevbookAtlasScope.All.Key;

        _atlasOpen = true;
        return Task.CompletedTask;
    }

    private void CloseAtlas() => _atlasOpen = false;

    /// <summary>
    /// Opens or closes the search surface.
    /// <para>
    /// It closes the atlas on the way in, and the two are mutually exclusive
    /// rather than stacked, because both replace the same panel body: showing one
    /// over the other would leave the reader with two controls, one of which does
    /// nothing visible until the other is pressed.
    /// </para>
    /// </summary>
    private void ToggleSearch()
    {
        _searchOpen = !_searchOpen;
        if (_searchOpen) _atlasOpen = false;
    }

    /// <summary>Following a result out of the list closes the list, for the reason
    /// the atlas closes on the same move: the reader asked to go and read that
    /// chapter, and leaving the search over it would answer a question they have
    /// stopped asking.</summary>
    private void OpenChapterFromSearch(DevbookChapterLink target)
    {
        SelectChapter(target);
        _searchOpen = false;
    }

    /// <summary>Widens the map to every knowledge folder at once. This is the
    /// explicit way back to the unfiltered view — the section tabs already narrow
    /// the map to the one they name via <see cref="FollowSectionWithAtlas"/>, but
    /// none of them names "all of it", because none of them is a knowledge area of
    /// its own.</summary>
    private void ShowAllDevbook()
    {
        _atlasScopeKey = DevbookAtlasScope.All.Key;
        _atlasOpen = true;
    }

    /// <summary>Following a document out of the map closes the map. The reader
    /// asked to go and read it, and leaving the atlas up over the thing they asked
    /// for would be answering a different question.</summary>
    private void OpenChapterFromAtlas(DevbookChapterLink target)
    {
        SelectChapter(target);
        _atlasOpen = false;
    }

    /// <summary>The C4 view a reference from another section asked for, handed to the
    /// architecture panel. Held here because it is a selection and the pane is what
    /// holds selections; the panel cannot be reached any other way from a
    /// <c>.domain</c> chapter, since a view is not a file in the knowledge
    /// menu.</summary>
    private string? _selectedC4View;

    private void SelectChapter(DevbookChapterLink target)
    {
        if (target is null) return;

        // A C4 view is not in the menu tree, so the containment check below would
        // refuse it. It is not a chapter either: what the reader gets is the
        // architecture section with that view open.
        if (target.IsC4View)
        {
            _selectedSection = target.AreaKey;
            _selectedC4View = target.Reference;
            _folderOpenError = null;
            return;
        }

        _selectedC4View = null;

        var root = _menuTree.Roots.FirstOrDefault(node => string.Equals(node.AreaKey, target.AreaKey, StringComparison.Ordinal));
        if (root is null || !root.Available || !ContainsPath(root, target.RelativePath)) return;

        _selectedSection = target.AreaKey;
        _selectedChapterPaths[target.AreaKey] = target.RelativePath;
        _folderOpenError = null;
        ExpandAncestorsToSelected(root.Children, target.RelativePath);
    }

    private bool IsMenuNodeExpanded(DevbookMenuNode node) => _expandedMenuNodes.Contains(MenuNodeKey(node));

    private static bool IsSelectableMenuNode(DevbookMenuNode node) =>
        node.Kind == DevbookMenuNodeKind.File || node.Path.EndsWith(".md", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// A bounded context of <c>.domain</c>, which the panel can show whole — its
    /// documents stacked under the context's own name and status, with the row of
    /// contexts above them — rather than one chapter at a time.
    /// <para>
    /// This is what makes that row reachable at all. The panel draws it when no
    /// chapter is open, and until now nothing here could produce that state:
    /// <see cref="EnsureSelectedChapter"/> assigns a chapter as soon as the menu
    /// loads and every route through this pane only ever assigns another one. So
    /// the context list — the names, the order and the statuses the knowledge
    /// database answers with, and the drift check local ADR 0004 pairs with it —
    /// was on screen only on the standalone Domain page.
    /// </para>
    /// <para>
    /// A folder is already a row carrying its own path, so selecting the thing the
    /// row names needs no new control and no state beside the selection: the path
    /// is in the tree, which is what keeps <see cref="EnsureSelectedChapter"/> from
    /// replacing it on the next menu reload.
    /// </para>
    /// <para>
    /// Direct children of <c>.domain</c> only, and only where the folder is not
    /// already a chapter: a directory holding an <c>index.md</c> reports that file
    /// as its path and is opened as the chapter it is. Nothing deeper is offered
    /// because the panel has no view of a sub-folder, and no other area is,
    /// because a bounded context is the only folder any panel draws whole.
    /// </para>
    /// </summary>
    private static bool IsContextOverviewNode(DevbookMenuNode node) =>
        node.Kind == DevbookMenuNodeKind.Folder
        && string.Equals(node.AreaKey, "domain", StringComparison.Ordinal)
        && !node.Path.EndsWith(".md", StringComparison.OrdinalIgnoreCase)
        && !node.Path.Contains('/', StringComparison.Ordinal);

    private static string MenuNodeKey(DevbookMenuNode node) => $"{node.AreaKey}:{node.Key}";

    private bool IsMenuNodeSelected(DevbookMenuNode node) =>
        string.Equals(SelectedChapterPath, node.Path, StringComparison.OrdinalIgnoreCase);

    private string MenuNodeClass(DevbookMenuNode node) => string.Join(' ', new[]
    {
        "devbook-menu__item",
        node.Kind == DevbookMenuNodeKind.Folder ? "devbook-menu__item--folder" : "devbook-menu__item--file",
        IsMenuNodeSelected(node) ? "devbook-menu__item--active" : null,
        !node.Available ? "devbook-menu__item--unavailable" : null
    }.Where(value => value is not null));

    private bool IsFolderOpening(DevbookMenuNode node) => _openingFolders.Contains(MenuNodeKey(node));

    private async Task OpenFolderAsync(DevbookMenuNode node)
    {
        if (node.Kind != DevbookMenuNodeKind.Folder || !node.Available) return;

        var key = MenuNodeKey(node);
        _folderOpenError = null;
        _openingFolders.Add(key);
        try
        {
            await DevbookFolderOpen.OpenAsync(node.AreaKey, node.Path, ActiveRepositoryAlias);
        }
        catch (DevbookFolderOpenException ex)
        {
            _folderOpenError = BuildFolderOpenError(node.Label, ex.Message);
        }
        catch (InvalidOperationException ex)
        {
            _folderOpenError = BuildFolderOpenError(node.Label, ex.Message);
        }
        finally
        {
            _openingFolders.Remove(key);
        }
    }

    private static string BuildFolderOpenError(string label, string details) => $"Couldn't open {label} in VS Code. {details}";

    /// <summary>Whether this scope has a version to be behind. A repository
    /// configured to read its clone, with no clone on this machine, has none —
    /// a control would only ever say so.</summary>
    private bool ShowUpdateControl => DevbookUpdate.CanCheck(RepositoryAlias);

    private string? BehindLabel => DevbookUpdatePresentation.BehindLabel(_updateState);

    private string UpdateActionTitle => _updateState.CanPull
        ? "Pull the latest version of this devbook into the local clone"
        : "Check whether this devbook is on the latest version";

    /// <summary>
    /// The one button. Its label already told the reader which of the two things
    /// it does, so the handler follows the same state rather than asking again:
    /// once a check has found the clone behind, pressing it pulls.
    /// </summary>
    private async Task RunUpdateActionAsync()
    {
        if (_updateBusy) return;

        var alias = RepositoryAlias;
        var pulling = _updateState.CanPull;

        _updateBusy = true;
        try
        {
            _updateState = pulling
                ? await DevbookUpdate.PullAsync(alias)
                : await DevbookUpdate.CheckAsync(alias);
            _checkedRepositoryAlias = alias;
        }
        finally
        {
            _updateBusy = false;
        }

        // A pull replaces the files the menu was built from and says so on the
        // folder source, which is where the menu hears it now — the same way the
        // panels always did, and the reason nothing here reaches into any of them.
        // Rebuilding it here as well would walk every enabled folder a second time
        // for one press. The announcement is on the success path only, which is
        // also the only path that changed a file, so nothing is left unreloaded.
    }

    /// <summary>
    /// A version answer belongs to the clone it was asked about, so scoping to a
    /// different repository drops it. Carrying it over would leave the pane saying
    /// this repository is three commits behind on the strength of a check that was
    /// run against another one.
    /// </summary>
    private void ForgetUpdateStateOnScopeChange()
    {
        if (string.Equals(_checkedRepositoryAlias, RepositoryAlias, StringComparison.Ordinal)) return;

        _checkedRepositoryAlias = RepositoryAlias;
        _updateState = DevbookUpdateState.NotChecked;
    }

    /// <summary>
    /// Rebuild the menu even though nothing about the scope changed.
    /// <para>
    /// <see cref="RefreshMenuAsync"/> is guarded on scope and visible sections
    /// because it runs on every parameter set, and that guard is exactly wrong
    /// after a pull: the same repository showing the same sections is now a
    /// different set of files. Forgetting what was loaded is how you ask again.
    /// </para>
    /// </summary>
    private async Task ReloadMenuAsync()
    {
        _loadedMenuRepositoryAlias = null;
        _loadedMenuVisibleKeyFingerprint = string.Empty;
        await RefreshMenuAsync();
    }

    /// <summary>Reloads the menu when the scope or the set of visible sections
    /// has actually moved; re-reading the disk on every render would make a tab
    /// click cost a folder walk.</summary>
    private async Task RefreshMenuAsync()
    {
        var repositoryAlias = ActiveRepositoryAlias;
        var visibleKeys = VisibleAreas.Select(area => area.Key).ToArray();
        var fingerprint = string.Join("|", visibleKeys);
        if (string.Equals(_loadedMenuRepositoryAlias, repositoryAlias, StringComparison.Ordinal)
            && string.Equals(_loadedMenuVisibleKeyFingerprint, fingerprint, StringComparison.Ordinal))
        {
            return;
        }

        _menuLoading = true;
        try
        {
            _menuTree = await DevbookMenu.LoadAsync(visibleKeys, repositoryAlias);
            _loadedMenuRepositoryAlias = repositoryAlias;
            _loadedMenuVisibleKeyFingerprint = fingerprint;

            var selectedVisible = visibleKeys.Contains(_selectedSection, StringComparer.Ordinal);
            if (!selectedVisible && visibleKeys.Length > 0)
            {
                _selectedSection = visibleKeys[0];
            }

            foreach (var root in _menuTree.Roots)
            {
                _expandedMenuNodes.Add(MenuNodeKey(root));
            }

            EnsureSelectedChapter();
        }
        finally
        {
            _menuLoading = false;
        }
    }

    private void EnsureSelectedChapter()
    {
        var root = ActiveMenuRoot;
        if (root is null) return;

        var selectedPath = SelectedChapterPath;
        if (selectedPath is null || !ContainsPath(root, selectedPath))
        {
            var first = PreferredChapter(root) ?? FirstSelectableChapter(root);
            if (first is not null)
            {
                _selectedChapterPaths[root.AreaKey] = first.Path;
                selectedPath = first.Path;
            }
        }

        ExpandAncestorsToSelected(root.Children, selectedPath);
    }

    private void ExpandAncestorsToSelected(IEnumerable<DevbookMenuNode> nodes, string? selectedPath)
    {
        if (string.IsNullOrWhiteSpace(selectedPath)) return;

        foreach (var node in nodes.Where(node => node.HasChildren && ContainsPath(node, selectedPath)))
        {
            _expandedMenuNodes.Add(MenuNodeKey(node));
            ExpandAncestorsToSelected(node.Children, selectedPath);
        }
    }

    private static DevbookMenuNode? PreferredChapter(DevbookMenuNode root) => root.AreaKey switch
    {
        "domain" => FindSelectableChapter(root, "context-map.md"),
        _ => null
    };

    private static DevbookMenuNode? FindSelectableChapter(DevbookMenuNode node, string path)
    {
        if (IsSelectableMenuNode(node) && node.Available && string.Equals(node.Path, path, StringComparison.OrdinalIgnoreCase)) return node;

        foreach (var child in node.Children)
        {
            var selected = FindSelectableChapter(child, path);
            if (selected is not null) return selected;
        }

        return null;
    }

    private static DevbookMenuNode? FirstSelectableChapter(DevbookMenuNode node)
    {
        if (IsSelectableMenuNode(node) && node.Available) return node;

        foreach (var child in node.Children)
        {
            var selected = FirstSelectableChapter(child);
            if (selected is not null) return selected;
        }

        return null;
    }

    private static bool ContainsPath(DevbookMenuNode node, string selectedPath) =>
        string.Equals(node.Path, selectedPath, StringComparison.OrdinalIgnoreCase)
        || node.Children.Any(child => ContainsPath(child, selectedPath));

    private RenderFragment RenderSection(string section)
    {
        return section switch
        {
            @* Every section takes the same callback. Two of them used to, and the
               difference was not a decision anybody made about Design, Technology
               or Instructions — it was that those three grew a reference control
               after this switch was written. A reader who can follow a reference
               out of a domain chapter and not out of the design chapter beside it
               is being told the two kinds of chapter are different things, and they
               are not: the target is a repository path either way and the selection
               this pane holds is the same selection. *@
            "design" => @<DesignDevbookView RepositoryAlias="@ActiveRepositoryAlias" SelectedPath="@SelectedChapterPath" OnNavigateToChapter="SelectChapter" />,
            "arc42" => @<Arc42DevbookPanel RepositoryAlias="@ActiveRepositoryAlias" SelectedPath="@SelectedChapterPath" SelectedC4View="@_selectedC4View" OnNavigateToChapter="SelectChapter" />,
            "domain" => @<DomainDevbookPanel Compact="true" RepositoryAlias="@ActiveRepositoryAlias" SelectedPath="@SelectedChapterPath" OnNavigateToChapter="SelectChapter" />,
            "tech" => @<TechnologyDevbookPanel RepositoryAlias="@ActiveRepositoryAlias" OnNavigateToChapter="SelectChapter" />,
            "instructions" => @<InstructionsDevbookPanel RepositoryAlias="@ActiveRepositoryAlias" SelectedPath="@SelectedChapterPath" OnNavigateToChapter="SelectChapter" />,
            _ => @<Alert Message="Turn on Devbook sections in Settings to read the repository's devbook here." BaseClass="devbook-empty" Role="status" />
        };
    }
}
