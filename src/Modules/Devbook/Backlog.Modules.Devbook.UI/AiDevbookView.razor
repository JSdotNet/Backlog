@inject AiDevbookProvider AiDevbook
@inject IServiceProvider Services

@*
    The AI section of the pane: the repository's `.ai` adoption record — how the
    project develops with AI, one file per stage of its flow, each chapter rated
    on the `.tech` ladder. It is a flat folder of documents with `##` chapters,
    which is exactly the shape DocumentDevbookView draws, so this wrapper adds
    only the folder and its picture: the injection names the AI provider by type,
    the provider carries the folder, and the picture — a tab strip over the four
    views of the record, Adoption, Cohesion, Model and Devbook — is handed in as
    the root's picture. The chapter list stays below it, as it is for every
    folder. Otherwise the same shape as DesignDevbookView, for the same reason.
*@
<DocumentDevbookView Provider="@AiDevbook"
                     RepositoryAlias="@RepositoryAlias"
                     SelectedPath="@SelectedPath"
                     OnNavigateToChapter="@OnNavigateToChapter"
                     RootPicture="@TabsPicture" />

@code {
    private const string AdoptionTab = "ai-adoption";
    private const string CohesionTab = "ai-cohesion";
    private const string ModelTab = "ai-model";
    private const string DevbookTab = "ai-devbook";

    [Parameter]
    public string? RepositoryAlias { get; set; }

    [Parameter]
    public string? SelectedPath { get; set; }

    /// <summary>Raised when a reader follows a reference out of an AI adoption
    /// chapter — most often into `.tech`, which is where a chapter's
    /// `depends-on` points; see <see cref="DocumentDevbookView.OnNavigateToChapter"/>.</summary>
    [Parameter]
    public EventCallback<DevbookChapterLink> OnNavigateToChapter { get; set; }

    private IReadOnlyList<DocumentDevbookFile>? _modelFiles;
    private AiModel? _model;
    private DevbookStackStamps? _stamps;
    private IReadOnlyDictionary<string, string>? _platformNames;

    /// <summary>The open tab, held here rather than by the strip: the picture is
    /// drawn in the overview and above the open root file, two places in the
    /// tree, and a strip that kept its own choice would lose it on every move
    /// between them. Adoption opens first.</summary>
    private string _tab = AdoptionTab;

    /// <summary>The folder drawn as the four views, in place of the adoption
    /// map's hand-drawn diagram — the picture `devbook-ai.md` says the folder is
    /// authored for. The model is read again only when the folder was
    /// re-parsed, which hands over a new list.</summary>
    private RenderFragment TabsPicture(IReadOnlyList<DocumentDevbookFile> files)
    {
        if (!ReferenceEquals(files, _modelFiles))
        {
            _modelFiles = files;
            _model = AiModel.From(files);

            // The Devbook tab's stamps, read again with the folder: the
            // configuration sits beside it in the same repository.
            _stamps = DevbookStackStamps.Load(Services.GetService<IDevbookFolderSource>(), AiDevbook.Folder.Key, RepositoryAlias);

            // The Cohesion tab's platform names: each `.tech` chapter's own heading.
            _platformNames = DevbookChapterHeadings.Load(Services.GetService<IDevbookFolderSource>(), AiDevbook.Folder.Key, RepositoryAlias, _model.Usages.SelectMany(usage => usage.DependsOn));
        }

        var model = _model!;

        return @<Tabs AriaLabel="AI adoption views"
                      TestId="ai-tabs"
                      CssClass="ai-tabs"
                      ListTestId="ai-tabs-list"
                      ActiveId="@_tab"
                      ActiveIdChanged="SelectTab">
            <TabPanel Id="@AdoptionTab" Title="Adoption" Element="section" TestId="ai-adoption-panel" TabTestId="ai-adoption-tab">
                <AiAdoptionView Model="@model" OnNavigateToChapter="@OnNavigateToChapter" />
            </TabPanel>
            <TabPanel Id="@CohesionTab" Title="Cohesion" Element="section" TestId="ai-cohesion-panel" TabTestId="ai-cohesion-tab">
                <AiCohesionView Model="@model" PlatformNames="@_platformNames" OnNavigateToChapter="@OnNavigateToChapter" />
            </TabPanel>
            <TabPanel Id="@ModelTab" Title="Model" Element="section" TestId="ai-model-panel" TabTestId="ai-model-tab">
                <AiModelView Model="@model" OnNavigateToChapter="@OnNavigateToChapter" />
            </TabPanel>
            <TabPanel Id="@DevbookTab" Title="Devbook" Element="section" TestId="ai-devbook-panel" TabTestId="ai-devbook-tab">
                <DevbookAdoptionView Model="@model" Stamps="@_stamps" OnNavigateToChapter="@OnNavigateToChapter" />
            </TabPanel>
        </Tabs>;
    }

    private void SelectTab(string id) => _tab = id;
}
