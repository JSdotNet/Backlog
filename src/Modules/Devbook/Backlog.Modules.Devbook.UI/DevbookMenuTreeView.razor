@*
    The Devbook menu is the library's TreeView with this app's vocabulary
    mapped onto it. DevbookMenuNode keys are only unique within a folder, so
    the adapter numbers rows by their position in the tree and keeps the original
    node behind that id — callers still receive the node they handed in.
*@

<TreeView ClassPrefix="devbook-menu"
          NavClass="devbook-stack__menu"
          HeadingClass="devbook-stack__menu-heading"
          MessageClass="devbook-stack__menu-message"
          OpenErrorClass="devbook-stack__menu-error"
          HeadingTestId="devbook-menu-heading"
          OpenButtonTestId="devbook-open-vscode-button"
          OpenErrorTestId="devbook-menu-open-error"
          NavAriaLabel="Devbook menu"
          TreeAriaLabel="Devbook chapters"
          EmptyMessage="No chapters are available for this area."
          HeadingLabel="@HeadingLabel"
          HeadingTrailing="@HeadingTrailing"
          RootFolder="@RootTreeNode"
          Nodes="@TreeNodes"
          IsLoading="@IsLoading"
          ShowOpenButton="@ShowOpenButton"
          OpenErrorMessage="@OpenErrorMessage"
          IsNodeSelected="node => IsNodeSelected(Original(node))"
          IsNodeExpanded="node => IsNodeExpanded(Original(node))"
          NodeClass="node => NodeClass(Original(node))"
          NodeMark="@(NodeMark is null ? null : MarkFor)"
          NodeTrail="@CountFor"
          IsFolderOpening="node => IsFolderOpening(Original(node))"
          OnNodeSelected="node => OnNodeSelected.InvokeAsync(Original(node))"
          OnOpenFolder="node => OnOpenFolder.InvokeAsync(Original(node))" />

@code {
    private readonly Dictionary<string, DevbookMenuNode> _originals = new(StringComparer.Ordinal);

    [Parameter]
    public string HeadingLabel { get; set; } = "Devbook";

    /// <summary>A control at the end of the heading row, handed to the tree's
    /// own slot — the Brain's Show hidden switch. Null draws the heading as
    /// before.</summary>
    [Parameter]
    public RenderFragment? HeadingTrailing { get; set; }

    [Parameter]
    public DevbookMenuNode? RootFolder { get; set; }

    /// <summary>Whether the heading offers "open this folder in an editor". A
    /// devbook folder read from a repository branch says no: the folder behind
    /// it is an app-managed snapshot the next fetch replaces wholesale, so
    /// opening it in an editor would invite edits that quietly vanish.</summary>
    [Parameter]
    public bool ShowOpenButton { get; set; } = true;

    [Parameter]
    public IReadOnlyList<DevbookMenuNode> Nodes { get; set; } = [];

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? OpenErrorMessage { get; set; }

    [Parameter]
    public Func<DevbookMenuNode, bool> IsNodeSelected { get; set; } = static _ => false;

    [Parameter]
    public Func<DevbookMenuNode, bool> IsNodeExpanded { get; set; } = static _ => false;

    [Parameter]
    public Func<DevbookMenuNode, string> NodeClass { get; set; } = static _ => "devbook-menu__item";

    /// <summary>A row's leading mark, or null for none — the scenario glyph and
    /// its run's dot on a scenario page.</summary>
    [Parameter]
    public Func<DevbookMenuNode, RenderFragment?>? NodeMark { get; set; }

    [Parameter]
    public Func<DevbookMenuNode, bool> IsFolderOpening { get; set; } = static _ => false;

    [Parameter]
    public EventCallback<DevbookMenuNode> OnNodeSelected { get; set; }

    [Parameter]
    public EventCallback<DevbookMenuNode> OnOpenFolder { get; set; }

    private TreeNode? RootTreeNode { get; set; }

    private IReadOnlyList<TreeNode> TreeNodes { get; set; } = [];

    /// <summary>The root and rows the tree was last mapped from, or null before
    /// the first mapping.</summary>
    private DevbookMenuNode? _mappedRootFolder;
    private IReadOnlyList<DevbookMenuNode>? _mappedNodes;

    /// <summary>Maps the tree when the host hands in another one. The pane passes
    /// callbacks, so it hands this its parameters again on every render of its
    /// own — every keystroke typed into a task beside it — and a menu that has not
    /// changed has nothing to map. The pane keeps the same root and rows until a
    /// menu load replaces them, so reference identity is the whole test.</summary>
    protected override void OnParametersSet()
    {
        if (_mappedNodes is not null && ReferenceEquals(_mappedRootFolder, RootFolder) && ReferenceEquals(_mappedNodes, Nodes)) return;

        _mappedRootFolder = RootFolder;
        _mappedNodes = Nodes;
        _originals.Clear();
        RootTreeNode = RootFolder is null ? null : Map(RootFolder, "root");
        TreeNodes = [.. Nodes.Select((node, index) => Map(node, index.ToString()))];
    }

    private TreeNode Map(DevbookMenuNode node, string id)
    {
        _originals[id] = node;

        return new TreeNode(
            id,
            node.Label,
            node.Kind switch
            {
                DevbookMenuNodeKind.Folder => TreeNodeKind.Folder,
                DevbookMenuNodeKind.Message => TreeNodeKind.Message,
                _ => TreeNodeKind.Item
            },
            node.Available,
            node.Message,
            [.. node.Children.Select((child, index) => Map(child, $"{id}/{index}"))]);
    }

    private RenderFragment? MarkFor(TreeNode node) => NodeMark?.Invoke(Original(node));

    /// <summary>A kind row's count in the New domain view: how many rows it
    /// holds, read with the label ("Domain, 13 items").</summary>
    private RenderFragment? CountFor(TreeNode node) => Original(node).Count is { } count
        ? @<span data-testid="devbook-menu-count"><span class="sr-only">, </span>@count<span class="sr-only">@(count == 1 ? " item" : " items")</span></span>
        : null;

    private DevbookMenuNode Original(TreeNode node) =>
        _originals.TryGetValue(node.Id, out var original)
            ? original
            : new DevbookMenuNode(node.Id, node.Label, node.Id, DevbookMenuNodeKind.Message, string.Empty, [], node.Available, node.Message);
}
