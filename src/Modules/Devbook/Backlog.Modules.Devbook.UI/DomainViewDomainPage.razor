@implements IDisposable
@inject IServiceProvider Services

@*
    The Domain view's Domain page for one domain file — domain.md or a
    domain.<name>.md split (local ADR 0044). It reads the file, the context's
    other domain files (where the events a unit raises are written), its
    requirements files and its invariants files (where Always true reads its
    rules) through the domain store, and hands them to the library's
    DomainUnitPage: a chapter bar over an unsplit file's units, one unit opened
    straight away for a split.
*@

@if (_page is { } opened)
{
    <DomainUnitPage File="@opened"
                    DomainFiles="@_domainFiles"
                    RequirementFiles="@_requirementFiles"
                    InvariantFiles="@_invariantFiles"
                    ModelPath="@_modelPath"
                    @bind-ActiveUnit="_activeUnit"
                    ActiveUnitPage="@OpenUnitPage"
                    ActiveRule="@OpenRule"
                    OnOpenAlwaysTrue="OnOpenAlwaysTrue"
                    OnNavigate="NavigateAsync"
                    AriaLabel="@($"Domain of {_contextName}")" />
}
else if (_problem is not null)
{
    <EmptyState BaseClass="devbook-empty"
                TitleCssClass="devbook-empty__title"
                DescriptionCssClass="@(null)"
                Title="Domain"
                Description="@_problem"
                TestId="domain-view-domain-problem"
                role="status" />
}

@code {
    [Parameter]
    public string? RepositoryAlias { get; set; }

    /// <summary>The domain file, relative to the Domain folder: <c>tasks/domain.md</c>.</summary>
    [Parameter]
    public string? SelectedPath { get; set; }

    /// <summary>A requirement, or a link in a unit's prose, the reader followed.</summary>
    [Parameter]
    public EventCallback<DevbookChapterLink> OnNavigateToChapter { get; set; }

    /// <summary>The unit to open the file on, by its anchor — the one an Always
    /// true link on Requirements named. Unset is the file's first unit.</summary>
    [Parameter]
    public string? OpenUnit { get; set; }

    /// <summary>The aggregate page to open the unit on: <see cref="DomainUnitPage.AlwaysTruePage"/>
    /// for Always true. Unset is About.</summary>
    [Parameter]
    public string? OpenUnitPage { get; set; }

    /// <summary>The rule Always true lands on, by its reference — the one a rule
    /// shown on another page linked to. Unset is the tab's top.</summary>
    [Parameter]
    public string? OpenRule { get; set; }

    /// <summary>A rule shown here whose unit is another domain file's, followed
    /// to its row on that unit's Always true tab.</summary>
    [Parameter]
    public EventCallback<DomainAlwaysTrueLink> OnOpenAlwaysTrue { get; set; }

    private DomainDevbookStore? _store;
    private DomainChapterFile? _page;
    private IReadOnlyList<DomainChapterFile> _domainFiles = [];
    private IReadOnlyList<DomainChapterFile> _requirementFiles = [];
    private IReadOnlyList<DomainChapterFile> _invariantFiles = [];
    private string? _modelPath;
    private string _contextName = "the context";
    private string? _activeUnit;
    private string? _problem;
    private (string? Alias, string? Path)? _loaded;
    private bool _disposed;
    private int _version;

    protected override void OnInitialized()
    {
        // Resolved rather than injected, as the pane resolves its stores: a host
        // composing no domain store gets a sentence, not a render failure.
        _store = Services.GetService<DomainDevbookStore>();
        if (_store is not null) _store.Changed += OnStoreChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded == (RepositoryAlias, SelectedPath)) return;
        _loaded = (RepositoryAlias, SelectedPath);
        _activeUnit = OpenUnit;
        await LoadAsync(clear: true);
    }

    /// <param name="clear">Whether the page on screen goes while the read runs: yes
    /// for another file, no for the same file read again after a folder change, so
    /// the reader's place is kept rather than flashed away.</param>
    private async Task LoadAsync(bool clear)
    {
        var version = ++_version;
        var alias = RepositoryAlias;
        var path = SelectedPath;
        if (_store is null)
        {
            (_page, _problem) = (null, "This host has no domain folder to read the domain from.");
            return;
        }

        // Nothing of the previous file stays on screen while the next one is read.
        if (clear) (_page, _problem) = (null, null);

        DomainViewDomainRead read;
        try
        {
            var view = await _store.LoadAsync(alias);
            if (_disposed || version != _version) return;

            // On the pool: a context's documents are read on first access, and
            // the desktop host's dispatcher is the UI thread.
            read = await Task.Run(() => Read(view, path));
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            read = DomainViewDomainRead.Failed($"The domain could not be read: {ex.Message}");
        }

        // A later read, for another file or after another folder change, wins.
        if (_disposed || version != _version) return;
        (_page, _domainFiles, _requirementFiles, _invariantFiles, _contextName, _problem) =
            (read.Page, read.DomainFiles, read.RequirementFiles, read.InvariantFiles, read.ContextName, read.Problem);
        _modelPath = read.ModelPath;
    }

    /// <summary>The domain file the menu path names, the context's domain files
    /// beside it and its requirements files, or why there is nothing to show.</summary>
    internal static DomainViewDomainRead Read(DomainDevbookView view, string? selectedPath)
    {
        if (view.Error is { } error) return DomainViewDomainRead.Failed(error);

        var relative = (selectedPath ?? string.Empty).Replace('\\', '/').Trim('/');
        var slug = relative.Split('/')[0];
        var context = view.Contexts.FirstOrDefault(c => string.Equals(c.Slug, slug, StringComparison.OrdinalIgnoreCase));
        var document = context?.Documents.FirstOrDefault(d =>
            string.Equals(d.Path, ".domain/" + relative, StringComparison.OrdinalIgnoreCase));

        if (context is null || document is null) return DomainViewDomainRead.Failed($"No domain file at {relative}.");

        var domainFiles = context.Documents
            .Where(d => d.Kind == DomainDevbookDocumentKind.Domain)
            .Select(d => Parse(view, d))
            .ToList();
        var requirementFiles = context.Documents
            .Where(d => d.Kind == DomainDevbookDocumentKind.Requirements)
            .Select(d => Parse(view, d))
            .ToList();
        var invariantFiles = context.Documents
            .Where(d => d.Kind == DomainDevbookDocumentKind.Invariants)
            .Select(d => Parse(view, d))
            .ToList();
        var page = domainFiles.FirstOrDefault(file => string.Equals(file.Path, document.Path, StringComparison.OrdinalIgnoreCase))
            ?? Parse(view, document);

        return new DomainViewDomainRead(page, domainFiles, requirementFiles, invariantFiles, context.DisplayName, null)
        {
            ModelPath = context.Documents.FirstOrDefault(d => d.Kind == DomainDevbookDocumentKind.Model)?.Path
        };
    }

    private static DomainChapterFile Parse(DomainDevbookView view, DomainDevbookDocument document) =>
        DomainUnits.Parse(DomainDevbookStore.ReadText(view, document), document.Path);

    private Task NavigateAsync(DevbookReference reference) =>
        DevbookChapterLink.From(reference) is { } target
            ? OnNavigateToChapter.InvokeAsync(target)
            : Task.CompletedTask;

    private void OnStoreChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            await LoadAsync(clear: false);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        if (_store is not null) _store.Changed -= OnStoreChanged;
    }
}
