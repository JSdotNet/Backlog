@implements IDisposable
@inject IServiceProvider Services

@*
    The Domain view's Demo strip (local ADR 0047): one Demo button per click demo
    the page on screen owns, each showing that demo in a DemoView below the strip
    and hiding it again. Drawn once by DomainView above whichever page is open, so
    no page carries a copy.

    Which demos a page owns, and what each holds, is DevbookDemos' answer — the
    one the old panel draws: the demo beside the file by name, and every demo its
    own or its chapters' `demo` field names, once each, with those places as the
    frame's chips. A folder row is the context, so its demo is context.md's
    demo.html. The context map owns none.

    Hidden until pressed: a demo is up to 500 KB of someone's picture, and the
    page is what the reader opened.
*@
@if (_demos.Count > 0)
{
    <div class="domain-view__demos" data-testid="domain-view-demos">
        <ButtonGroup AriaLabel="Demos" CssClass="domain-view__demo-buttons">
            @foreach (var demo in _demos)
            {
                <ToggleButton @key="demo.FullPath"
                              Pressed="@_shown.Contains(demo.FullPath)"
                              PressedChanged="@(pressed => Show(demo.FullPath, pressed))"
                              TestId="domain-view-demo"
                              data-path="@demo.Path">@Label(demo)</ToggleButton>
            }
        </ButtonGroup>
        @foreach (var demo in _demos.Where(demo => _shown.Contains(demo.FullPath)))
        {
            <DemoView @key="demo.FullPath" Html="@demo.Html" Path="@demo.Path" Addresses="@demo.Addresses" />
        }
    </div>
}

@code {
    [Parameter]
    public string? RepositoryAlias { get; set; }

    /// <summary>The menu row on screen, relative to the Domain folder: a context's
    /// folder (<c>tasks</c>) or a file in it (<c>tasks/features.md</c>).</summary>
    [Parameter]
    public string? SelectedPath { get; set; }

    private DomainDevbookStore? _store;
    private IReadOnlyList<DevbookDemos.LoadedDemo> _demos = [];
    private readonly HashSet<string> _shown = new(StringComparer.OrdinalIgnoreCase);
    private (string? Alias, string? Path)? _loaded;
    private int _version;
    private bool _disposed;

    protected override void OnInitialized()
    {
        // Resolved rather than injected, as the pages resolve the store.
        _store = Services.GetService<DomainDevbookStore>();
        if (_store is not null) _store.Changed += OnStoreChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded == (RepositoryAlias, SelectedPath)) return;
        _loaded = (RepositoryAlias, SelectedPath);

        // Another page's demos never stand above this one while its own are read.
        _demos = [];
        _shown.Clear();
        await LoadAsync();
    }

    /// <summary>Only the latest read lands: a page left while its demo was still
    /// coming off disk must not put that demo above the page the reader moved to.</summary>
    private async Task LoadAsync()
    {
        var version = ++_version;
        var alias = RepositoryAlias;
        var path = SelectedPath;

        IReadOnlyList<DevbookDemos.LoadedDemo> demos = [];
        if (_store is not null && DomainViewUnit.PageFor(path) is not (DomainViewPage.None or DomainViewPage.ContextMap))
        {
            try
            {
                var view = await _store.LoadAsync(alias);
                if (_disposed || version != _version) return;

                // On the pool: a context's documents are read on first access, and
                // the desktop host's dispatcher is the UI thread.
                if (await Task.Run(() => Page(view, path)) is { } document)
                {
                    demos = await DevbookDemos.ReadAsync(document, view.RootPath, Services);
                }
            }
            catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
            {
                // The page says why it cannot read; the strip has nothing to add.
                demos = [];
            }
        }

        if (_disposed || version != _version) return;
        _demos = demos;
        _shown.RemoveWhere(shown => !demos.Any(demo => string.Equals(demo.FullPath, shown, StringComparison.OrdinalIgnoreCase)));
    }

    /// <summary>The document a menu path opens, found as the pages find it: a
    /// context's folder is its <c>context.md</c>.</summary>
    internal static DomainDevbookDocument? Page(DomainDevbookView view, string? selectedPath)
    {
        if (view.Error is not null) return null;

        var relative = (selectedPath ?? string.Empty).Replace('\\', '/').Trim('/');
        if (relative.Length == 0) return null;
        if (!relative.EndsWith(".md", StringComparison.OrdinalIgnoreCase)) relative += "/" + DevbookReadingConvention.ContextDemoPage;

        var slug = relative.Split('/')[0];
        var context = view.Contexts.FirstOrDefault(c => string.Equals(c.Slug, slug, StringComparison.OrdinalIgnoreCase));
        return context?.Documents.FirstOrDefault(d => string.Equals(d.Path, ".domain/" + relative, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>"Demo" for a page's one demo; with several, each says which it is
    /// by its file's stem — <c>features</c> for <c>features.demo.html</c>.</summary>
    private string Label(DevbookDemos.LoadedDemo demo) =>
        _demos.Count == 1 ? "Demo" : $"Demo · {Stem(demo.Path)}";

    internal static string Stem(string path)
    {
        var name = path.Replace('\\', '/');
        name = name[(name.LastIndexOf('/') + 1)..];
        if (string.Equals(name, DevbookReadingConvention.ContextDemo, StringComparison.OrdinalIgnoreCase)) return Path.GetFileNameWithoutExtension(name);
        return name.EndsWith(DevbookReadingConvention.DemoSuffix, StringComparison.OrdinalIgnoreCase)
            ? name[..^DevbookReadingConvention.DemoSuffix.Length]
            : Path.GetFileNameWithoutExtension(name);
    }

    private void Show(string fullPath, bool pressed)
    {
        if (pressed) _shown.Add(fullPath);
        else _shown.Remove(fullPath);
    }

    private void OnStoreChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        if (_store is not null) _store.Changed -= OnStoreChanged;
    }
}
