<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The Monitoring & Dashboard module's UI: the read side that turns signals
    from the other contexts into visibility and follow-up (see
    .domain/context-map.md). Scaffolding only for now; the project exists so the
    module has somewhere to grow that is not the desktop shell.

    It references the shared control library rather than growing its own
    controls, which is the rule every module UI project follows.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.Modules.Monitoring.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Backlog.UI.Components\Backlog.UI.Components.csproj" />
  </ItemGroup>

</Project>
