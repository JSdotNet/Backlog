<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Backlog module — the Backlog Management bounded context (.domain/backlog).
    Clean architecture, inside out:
      DomainModels/  aggregates, value objects, enums, domain exceptions
      Features/      one vertical slice per use case (command/query + handler)
      Services/      domain services shared by more than one slice
      Extensions/    AddBacklogModule() composition root for hosts
    Ports such as IBacklogRepository live here; adapters live in src/Infrastructure.
    This project may reference the shared kernel and its own Abstractions, and
    nothing else in the solution. Hosts go the other way: they call the handlers
    and hold the DTOs, never the aggregate.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Backlog.Modules.Backlog</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\Backlog.SharedKernel\Backlog.SharedKernel.csproj" />
    <ProjectReference Include="..\Backlog.Modules.Backlog.Abstractions\Backlog.Modules.Backlog.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only for AddBacklogModule(); the domain and the handlers know nothing
         about the container. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Backlog.Modules.Backlog.UnitTests" />
  </ItemGroup>

</Project>