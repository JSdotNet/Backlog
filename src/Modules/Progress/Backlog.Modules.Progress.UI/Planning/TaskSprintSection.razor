@using global::Backlog.Modules.Progress.Abstractions.DataTransferObjects
@using global::Backlog.Modules.Progress.Abstractions.Services
@using global::Backlog.SharedKernel.Results
@using global::Backlog.UI.Components.Progress
@implements IDisposable
@*
    A task's Sprint section in its side panel
    (.devbook/domain/progress/features.md#planning-from-a-task). The desktop shell
    composes it beside "Sessions and pull requests", the way LinkedWorkSection is
    composed: the Tasks pane offers a slot and draws whatever the shell puts in it, so
    Tasks gains no sprint field and never learns a sprint exists (local ADR 0028).

    It finds the first series switched on that holds one of the task's repositories,
    and draws how the task stands in that series' open sprint. Every act is a write
    through ISprintSeriesPlanning; the series it answers with is drawn at once. With
    Progress off, or the task's repositories in no series switched on, nothing is drawn.

    A series saved anywhere else - pulled from another desktop by the sync, or changed
    from the sprint view or Settings - raises ISprintSeriesPlanning.Changed and the
    section finds and draws its series again. A note dialog left open keeps what is
    typed in it: it takes the stored note only as it opens.
*@
@if (_series is { } series)
{
    var panel = SprintPlanning.Panel(series, Candidate);
    <SprintTaskPanel Model="panel"
                     Busy="_writing"
                     Error="@_error"
                     OnAdd="() => WriteAsync(planning => planning.AddTaskAsync(series.Id, OpenNumber, Candidate.TaskId))"
                     OnRemove="() => WriteAsync(planning => planning.RemoveTaskAsync(series.Id, OpenNumber, Candidate.TaskId))"
                     OnLinkPlan="() => WriteAsync(planning => planning.LinkPlanAsync(series.Id, OpenNumber, panel.PlanTag!))"
                     OnUnlinkPlan="() => WriteAsync(planning => planning.UnlinkPlanAsync(series.Id, OpenNumber, panel.PlanTag!))"
                     OnGoalChanged="goal => WriteAsync(planning => planning.MarkGoalAsync(series.Id, OpenNumber, Candidate.TaskId, goal))"
                     OnEditNote="OpenNote" />
    @if (series.OpenSprint is { } open)
    {
        <SprintItemNoteDialog Open="_noting"
                              OpenChanged="value => _noting = value"
                              TaskTitle="@Candidate.Title"
                              SprintName="@open.Name"
                              Current="@(new SprintItemNote(panel.Note, panel.OpenQuestion))"
                              Busy="_writing"
                              Error="@_noteError"
                              OnSave="note => SaveNoteAsync(panel, note)" />
    }
}

@code {
    [Inject] private IServiceProvider Services { get; set; } = default!;

    /// <summary>The task, as the host knows it: its id, title, repositories and plans.</summary>
    [Parameter, EditorRequired]
    public SprintCandidate Candidate { get; set; } = default!;

    private IAppFeatureSettings? _features;
    private ISprintSeriesPlanning? _notices;
    private SprintSeriesDto? _series;
    private string _taskKey = "\u0000";
    private bool _writing;
    private string? _error;
    private bool _noting;
    private string? _noteError;
    private int _generation;

    private int OpenNumber => _series?.OpenSprint?.Number ?? 0;

    private ISprintSeriesPlanning? Planning => Services.GetService(typeof(ISprintSeriesPlanning)) as ISprintSeriesPlanning;

    protected override void OnInitialized()
    {
        _features = Services.GetService(typeof(IAppFeatureSettings)) as IAppFeatureSettings;
        if (_features is not null) _features.Changed += OnFeaturesChanged;
        _notices = Planning;
        if (_notices is not null) _notices.Changed += OnSeriesChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        // The task's repositories decide the series; a new title or plan does not.
        var key = $"{Candidate.TaskId}\u001e{string.Join("\u001f", Candidate.Repositories.Select(alias => alias.Trim().ToUpperInvariant()))}";
        if (key == _taskKey) return;

        _taskKey = key;
        _error = null;
        _noting = false;
        await FindSeriesAsync();
    }

    /// <summary>A series was saved somewhere else: the task's series is found and drawn
    /// again, so a sprint changed on another desktop shows here.</summary>
    private void OnSeriesChanged() => _ = InvokeAsync(ReadAgainAsync);

    private void OnFeaturesChanged() => _ = InvokeAsync(ReadAgainAsync);

    private async Task ReadAgainAsync()
    {
        await FindSeriesAsync();
        StateHasChanged();
    }

    private async Task FindSeriesAsync()
    {
        var generation = ++_generation;
        SprintSeriesDto? found = null;

        if ((_features?.IsEnabled(ProgressFeatures.Progress) ?? false) && Planning is { } planning)
        {
            var listed = await planning.ListSeriesAsync();
            if (listed.IsSuccess) found = SprintPlanning.SeriesOf(listed.Value, Candidate.Repositories);
        }

        if (generation == _generation) _series = found;
    }

    private void OpenNote()
    {
        _noteError = null;
        _noting = true;
    }

    private async Task SaveNoteAsync(SprintTaskPanelModel panel, SprintItemNote note)
    {
        if (_series is not { } series) return;

        var number = OpenNumber;
        if (!string.Equals(panel.Note, note.Note, StringComparison.Ordinal))
        {
            var noted = await RunAsync(planning => planning.SetNoteAsync(series.Id, number, Candidate.TaskId, note.Note));
            if (noted is null) return;
            if (noted.IsFailure)
            {
                _noteError = noted.Error.Message;
                return;
            }
        }

        if (panel.OpenQuestion != note.OpenQuestion)
        {
            var asked = await RunAsync(planning => planning.SetOpenQuestionAsync(series.Id, number, Candidate.TaskId, note.OpenQuestion));
            if (asked is null) return;
            if (asked.IsFailure)
            {
                _noteError = asked.Error.Message;
                return;
            }
        }

        _noteError = null;
        _noting = false;
    }

    private async Task WriteAsync(Func<ISprintSeriesPlanning, Task<Result<SprintSeriesDto>>> write)
    {
        var written = await RunAsync(write);
        _error = written is { IsFailure: true } ? written.Error.Message : null;
    }

    /// <summary>One write through the module; the series it answers with is drawn.</summary>
    private async Task<Result<SprintSeriesDto>?> RunAsync(Func<ISprintSeriesPlanning, Task<Result<SprintSeriesDto>>> write)
    {
        if (Planning is not { } planning)
        {
            return Result.Failure<SprintSeriesDto>(Error.Unexpected("progress.not_composed", "The sprint could not be changed: Progress is not composed in this host."));
        }

        if (_writing) return null;

        _writing = true;
        try
        {
            var written = await write(planning);
            if (written.IsSuccess) _series = written.Value;
            return written;
        }
        finally
        {
            _writing = false;
        }
    }

    public void Dispose()
    {
        if (_features is not null) _features.Changed -= OnFeaturesChanged;
        if (_notices is not null) _notices.Changed -= OnSeriesChanged;
    }
}
