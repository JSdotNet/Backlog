@*
    Settings › Sprints (.devbook/domain/progress/features.md#setting-up-a-sprint-series),
    which the shell draws because the host registered it (AddProgressSettings) rather
    than because the shell knows anything about sprints. A card per series, the
    repositories in no series, and Add another sprint.

    The shell offers the page only while the progress switch is on, and ProgressOnly
    says so again for a host that renders it directly: with the switch off the ports
    answer "off" and there is nothing to draw.

    Every change goes through ISprintSeriesPlanning as it is made and the card is drawn
    again from what the port answers, so the page shows what the series holds rather
    than what was typed. A refused change keeps the series as it was and says why on
    its card, in the module's own words. Delete series… is the one change a card asks
    about first; once confirmed the card goes and its repositories are free.

    A series saved anywhere else - pulled from another desktop by the sync, or changed
    from the sprint view or a task - raises ISprintSeriesPlanning.Changed, and the page
    reads every series again. Each card keeps its place (@key) and its own drafts: a
    plan or tag half typed, a pattern held back for want of {n}.

    The namespace is the project's root rather than the folder's, on the
    WorkingWeekSettings precedent.
*@
@namespace Backlog.Modules.Progress.UI
@using System.Globalization
@using global::Backlog.Modules.Progress.Abstractions.DataTransferObjects
@using global::Backlog.Modules.Progress.Abstractions.Services
@using global::Backlog.UI.Components.Badges
@using global::Backlog.UI.Components.Buttons
@using global::Backlog.UI.Components.Feedback
@using global::Backlog.UI.Components.Layout
@using global::Backlog.UI.Components.Progress
@using global::Backlog.UI.Components.Selects
@inject ISprintSeriesPlanning Planning
@inject ISprintRepositories RepositoryList
@implements IDisposable

<ProgressOnly>
    <div class="sprint-settings" data-testid="sprint-settings">
        <p class="setting__body">
            A sprint covers one or more repositories. Repositories in no sprint keep today's
            In progress view.
        </p>

        <Alert Message="@(_readError ?? _pageError)" TestId="sprint-settings-error" />

        @foreach (var series in _series)
        {
            <SprintSeriesCard @key="series.Id"
                              Model="@ToCard(series)"
                              FreeRepositories="@Free"
                              Error="@_errors.GetValueOrDefault(series.Id)"
                              TestId="@($"sprint-series-{series.Id:N}")"
                              OnSwitch="on => ChangeAsync(series.Id, ct => Planning.SwitchAsync(series.Id, on, ct))"
                              OnAddRepository="alias => ChangeAsync(series.Id, ct => Planning.AddRepositoryAsync(series.Id, alias, ct))"
                              OnRemoveRepository="alias => ChangeAsync(series.Id, ct => Planning.RemoveRepositoryAsync(series.Id, alias, ct))"
                              OnLengthChanged="weeks => ChangeCadenceAsync(series.Id, LengthOf(weeks), null)"
                              OnStartWeekdayChanged="day => ChangeCadenceAsync(series.Id, null, day)"
                              OnNamePatternChanged="pattern => ChangeAsync(series.Id, ct => Planning.RenameAsync(series.Id, series.Name, pattern, ct))"
                              OnGoalChanged="goal => ChangeAsync(series.Id, ct => Planning.SetGoalRulesAsync(series.Id, RulesOf(goal), goal.Share, ct))"
                              OnShowInChanged="briefs => ChangeAsync(series.Id, ct => Planning.ShowInBriefsAsync(series.Id, briefs.Daily, briefs.Weekly, ct))"
                              OnDelete="() => DeleteAsync(series.Id)" />
        }

        <Card Title="@FreeRepositoriesCardTitle" TestId="sprint-settings-free">
            <p class="setting__body">These keep today's In progress view. Each can join one sprint.</p>
            <div class="sprint-settings__chips" data-testid="sprint-settings-free-repositories">
                @foreach (var alias in Free)
                {
                    <TagChip Text="@alias" data-repository="@alias" />
                }
            </div>
        </Card>

        <div class="sprint-settings__add">
            @if (_adding)
            {
                <SelectField Form="true"
                             Label="Its first repository"
                             Options="@FreeOptions"
                             IncludeEmptyOption="true"
                             EmptyLabel="Pick a repository"
                             TestId="sprint-settings-new-repository"
                             OnChanged="CreateAsync" />
                <AppButton Variant="ButtonVariant.None" TestId="sprint-settings-add-cancel" OnClick="() => _adding = false">Cancel</AppButton>
            }
            else
            {
                <AppButton TestId="sprint-settings-add"
                           Disabled="@(Free.Count == 0)"
                           OnClick="() => _adding = true">@(_series.Count == 0 ? "Add a sprint" : "Add another sprint")</AppButton>
                @if (Free.Count == 0)
                {
                    <span class="setting__body">Every repository is in a sprint.</span>
                }
            }
        </div>
    </div>
</ProgressOnly>

@code {
    /// <summary>The page's one fixed card - what its
    /// <c>SettingsSection.CardTitles</c> declares; a series card is titled by its series.</summary>
    public const string FreeRepositoriesCardTitle = "Not in a sprint";

    /// <summary>The module's code for a series that is not there.</summary>
    private const string SeriesNotFoundCode = "progress.series_not_found";

    private readonly Dictionary<Guid, string> _errors = [];

    /// <summary>The length and weekday last asked for per series, ahead of the store:
    /// the port takes both in one call, so a second change made before the first is
    /// saved has to carry the first rather than what the card last drew.</summary>
    private readonly Dictionary<Guid, (SprintLength Length, DayOfWeek Start)> _cadence = [];
    private List<SprintSeriesDto> _series = [];
    /// <summary>Why the series could not be read, from the last read; null once one
    /// succeeds.</summary>
    private string? _readError;

    /// <summary>Why the person's last Add did not go through. Kept across a read the
    /// page did not ask for, so a series pulled from another desktop does not wipe it.</summary>
    private string? _pageError;
    private bool _adding;

    /// <summary>Changes handed to the port and not yet answered.</summary>
    private int _saving;

    /// <summary>The registered repositories no series holds, in the registry's order —
    /// what Add repository and Add another sprint offer, and what the Not in a sprint
    /// card lists.</summary>
    private IReadOnlyList<string> Free { get; set; } = [];

    /// <summary>Works out the free repositories once, after the series change, rather
    /// than on every read during a render.</summary>
    private void RefreshFree() =>
        Free =
        [
            .. RepositoryList.Aliases.Where(alias =>
                !_series.Any(series => series.Repositories.Contains(alias, StringComparer.OrdinalIgnoreCase)))
        ];

    private IReadOnlyList<SelectorOption> FreeOptions => [.. Free.Select(alias => new SelectorOption(alias, alias))];

    protected override Task OnInitializedAsync()
    {
        Planning.Changed += OnSeriesChanged;
        return LoadAsync();
    }

    /// <summary>
    /// A series was saved somewhere else - most often pulled from another desktop - so
    /// every series is read again. What the page said about the person's own last Add
    /// stays; the page's own saves raise this too, after they have drawn their answer,
    /// and cost one more read.
    /// </summary>
    private void OnSeriesChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync(keepCadence: _saving > 0);
        StateHasChanged();
    });

    public void Dispose() => Planning.Changed -= OnSeriesChanged;

    /// <param name="keepCadence">A read between a cadence change and its save: the
    /// length or weekday asked for and not yet stored stays, so the next change still
    /// carries it.</param>
    private async Task LoadAsync(bool keepCadence = false)
    {
        try
        {
            var listed = await Planning.ListSeriesAsync();
            _series = listed.IsSuccess ? [.. listed.Value] : [];
            _readError = listed.IsSuccess ? null : listed.Error.Message;
        }
        catch (Exception exception) when (exception is IOException or System.Data.Common.DbException or UnauthorizedAccessException)
        {
            _series = [];
            _readError = $"The sprint series could not be read: {exception.Message}";
        }

        if (!keepCadence) _cadence.Clear();
        RefreshFree();
    }

    private Task ChangeCadenceAsync(Guid seriesId, SprintLength? length, DayOfWeek? start)
    {
        var current = _series.FirstOrDefault(series => series.Id == seriesId);
        if (current is null) return Task.CompletedTask;

        (SprintLength Length, DayOfWeek Start) asked = _cadence.TryGetValue(seriesId, out var pending)
            ? pending
            : (current.Length, current.StartWeekday);
        asked = (length ?? asked.Length, start ?? asked.Start);
        _cadence[seriesId] = asked;

        return ChangeAsync(seriesId, ct => Planning.ChangeCadenceAsync(seriesId, asked.Length, asked.Start, ct));
    }

    /// <summary>
    /// Makes one change through the port and draws the series from its answer. A
    /// refusal is said on the series' card and the page reads every series again, so
    /// the card shows what is stored; a store that could not be reached or written is
    /// said the same way rather than thrown into the renderer.
    /// </summary>
    private async Task ChangeAsync(Guid seriesId, Func<CancellationToken, Task<global::Backlog.SharedKernel.Results.Result<SprintSeriesDto>>> change)
    {
        global::Backlog.SharedKernel.Results.Result<SprintSeriesDto> changed;
        _saving++;
        try
        {
            changed = await change(CancellationToken.None);
        }
        catch (Exception exception) when (exception is IOException or System.Data.Common.DbException or UnauthorizedAccessException)
        {
            _errors[seriesId] = $"The change could not be saved: {exception.Message}";
            await LoadAsync();
            return;
        }
        finally
        {
            _saving--;
        }

        if (changed.IsFailure)
        {
            _errors[seriesId] = changed.Error.Message;
            await LoadAsync();
            return;
        }

        _errors.Remove(seriesId);
        var index = _series.FindIndex(series => series.Id == seriesId);
        if (index >= 0) _series[index] = changed.Value;
        else await LoadAsync();
        RefreshFree();
    }

    /// <summary>
    /// Deletes a series the person confirmed on its card. Once it is gone its card goes
    /// and its repositories join the Not in a sprint card, free for another series. A
    /// refusal, or a store that could not be written, is said on the card, which the
    /// page reads again so it shows what is stored.
    /// </summary>
    private async Task DeleteAsync(Guid seriesId)
    {
        global::Backlog.SharedKernel.Results.Result deleted;
        try
        {
            deleted = await Planning.DeleteSeriesAsync(seriesId);
        }
        catch (Exception exception) when (exception is IOException or System.Data.Common.DbException or UnauthorizedAccessException)
        {
            _errors[seriesId] = $"The series could not be deleted: {exception.Message}";
            await LoadAsync();
            return;
        }

        // A series already gone — most often deleted by a pull from another desktop
        // while the confirmation was open — is what the person asked for: the card goes.
        if (deleted.IsFailure && deleted.Error.Code != SeriesNotFoundCode)
        {
            _errors[seriesId] = deleted.Error.Message;
            await LoadAsync();
            return;
        }

        _errors.Remove(seriesId);
        _cadence.Remove(seriesId);
        _series.RemoveAll(series => series.Id == seriesId);
        RefreshFree();
    }

    private async Task CreateAsync(string? alias)
    {
        if (string.IsNullOrWhiteSpace(alias)) return;

        _adding = false;
        try
        {
            var created = await Planning.CreateSeriesAsync(new CreateSprintSeries([alias]));
            if (created.IsFailure)
            {
                await LoadAsync();
                _pageError = created.Error.Message;
                return;
            }

            _pageError = null;
            // The save's own notice may have read the new series in already.
            var index = _series.FindIndex(series => series.Id == created.Value.Id);
            if (index >= 0) _series[index] = created.Value;
            else _series.Add(created.Value);
            RefreshFree();
        }
        catch (Exception exception) when (exception is IOException or System.Data.Common.DbException or UnauthorizedAccessException)
        {
            await LoadAsync();
            _pageError = $"The sprint series could not be added: {exception.Message}";
        }
    }

    private static SprintLength LengthOf(int weeks) => weeks == 1 ? SprintLength.OneWeek : SprintLength.TwoWeeks;

    /// <summary>The card's goal section as the series' rules: one rule per ticked
    /// kind, the plans and tags the two naming kinds carry. None ticked is no rule,
    /// which the series reads as every task in the sprint.</summary>
    public static IReadOnlyList<GoalRuleDto> RulesOf(SprintGoalSettings goal)
    {
        var rules = new List<GoalRuleDto>();
        if (goal.InPlans && goal.Plans.Count > 0) rules.Add(GoalRuleDto.InPlans([.. goal.Plans]));
        if (goal.MarkedAsGoal) rules.Add(GoalRuleDto.MarkedAsGoal());
        if (goal.Tagged && goal.Tags.Count > 0) rules.Add(GoalRuleDto.Tagged([.. goal.Tags]));
        if (goal.Everything) rules.Add(GoalRuleDto.Everything());
        return rules;
    }

    /// <summary>A series as its card draws it.</summary>
    public static SprintSeriesCardModel ToCard(SprintSeriesDto series)
    {
        var plans = series.GoalRules.FirstOrDefault(rule => rule.Kind == GoalRuleKind.InPlans);
        var tags = series.GoalRules.FirstOrDefault(rule => rule.Kind == GoalRuleKind.Tagged);

        return new SprintSeriesCardModel(
            series.Id.ToString("N"),
            series.Name,
            series.IsOn,
            series.OpenSprint is { } open ? RunningOf(open) : null,
            series.Repositories,
            series.Length == SprintLength.OneWeek ? 1 : 2,
            series.StartWeekday,
            series.NamePattern,
            NextNumberOf(series),
            new SprintGoalSettings(
                plans is not null,
                plans?.Choices ?? [],
                series.GoalRules.Any(rule => rule.Kind == GoalRuleKind.MarkedAsGoal),
                tags is not null,
                tags?.Choices ?? [],
                series.GoalRules.Any(rule => rule.Kind == GoalRuleKind.Everything),
                series.GoalShare),
            series.ShowInDailyBrief,
            series.ShowInWeeklyBrief,
            series.OffReason);
    }

    /// <summary>The number the next sprint will carry: one past the open sprint, or
    /// past the last one, or 1 before any has started.</summary>
    public static int NextNumberOf(SprintSeriesDto series) =>
        series.Sprints.Count == 0 ? 1 : series.Sprints.Max(sprint => sprint.Number) + 1;

    /// <summary>"Sprint 42 runs Mon 5 Oct to Sun 18 Oct" — in the invariant culture,
    /// the settings screen's language.</summary>
    public static string RunningOf(SprintDto sprint) =>
        string.Create(
            CultureInfo.InvariantCulture,
            $"{sprint.Name} runs {sprint.Start:ddd d MMM} to {sprint.End:ddd d MMM}");
}
