<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The Progress module's UI (.devbook/domain/progress/features.md): the Goals view
    (Goals/GoalsHost), which the desktop shell draws as one of its main views, and
    the attach-to-goal control it offers on tasks and pull requests. The board it draws
    is the shared library's GoalsBoard, so the storybook shows it with no goal behind it.

    It references the shared control library rather than growing its own controls,
    which is the rule every module UI project follows, and the module's published
    surface only — never a goal, its repository or the handlers.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.Modules.Progress.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <!-- GoalControlRegistration registers the attach-to-goal control. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Backlog.UI.Components\Backlog.UI.Components.csproj" />
    <!-- Result: what every goal port call answers with. -->
    <ProjectReference Include="..\..\..\Core\Backlog.SharedKernel\Backlog.SharedKernel.csproj" />
    <ProjectReference Include="..\Backlog.Modules.Progress.Abstractions\Backlog.Modules.Progress.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- GoalsAiContentSource is internal; its tests sit beside the other areas' sources. -->
    <InternalsVisibleTo Include="Backlog.Desktop.UI.UnitTests" />
  </ItemGroup>

</Project>
