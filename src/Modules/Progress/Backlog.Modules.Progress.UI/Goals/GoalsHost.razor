@using global::Backlog.Modules.Progress.Abstractions.DataTransferObjects
@using global::Backlog.Modules.Progress.Abstractions.Services
@using global::Backlog.SharedKernel.Results
@using global::Backlog.UI.Components.Feedback
@using global::Backlog.UI.Components.Goals
@using global::Backlog.UI.Components.Icons
@using global::Backlog.UI.Components.Progress
@implements IDisposable
@inject IServiceProvider Services

@*
    The Goals view's host (.devbook/domain/progress/features.md#the-goals-view): it reads
    the stand-up through IStandUp at the person's own iteration length, each goal's
    attachments through IGoals.ListAsync over the last window, and the status of every
    pull request the board shows through IGoalPullRequestReader, and hands GoalsMapper's
    board to the library's GoalsBoard. The shell hands in its tasks, plan tags and open
    pull requests as GoalsCandidates, because Progress UI may not reach Tasks
    (ADR 0035 §6, local ADR 0028).

    The view is read when it opens, on a change of iteration and on Refresh, and again
    whenever IGoals, IImpediments or IIterationSettings say something changed — a write
    the sync pulled in, or one made elsewhere on this machine. A write made here is read
    once, by the write itself: the Changed the module raises for it while the write and
    its read are under way is not read a second time, since that read would ask GitHub for
    every pull request on the board again. A newer read wins over a slower older one. The
    shell's Revision only maps the last reading again over its candidates, with no read.

    Without the Progress ports the view says the module is not set up, under its own test
    id; goals-view-empty is the board's real empty state alone.

    Every write goes through the module and the view is read again once it lands:
    - the iteration switch, through IIterationSettings.SetLength. The first time 2 weeks
      is chosen — no two-week start kept yet — TwoWeekStartDialog asks for the day first,
      offering the Monday of the current week; Save keeps it through SetTwoWeekStart and
      then sets the length, and Cancel leaves the iteration as it was;
    - New goal, through IGoals.CreateAsync, the refusal kept in the dialog;
    - attach, through IGoals.AttachAsync, every item a GoalSubject that GoalSubjects
      turns into the module's item. A No goal row's Attach… with no goal open opens the
      shared GoalPicker for it, over the open goals, its New goal… setting a goal (title
      and an optional due date) and attaching to it. An item another goal holds is refused with
      progress.item_in_other_goal: the GoalPicker opens on the goal it was meant for,
      with IGoals.FindGoalOfAsync's goal as the one it holds — the picker names that
      goal and says the attach moves it — and Attach attaches again with
      moveFromOtherGoal. A refusal inside the picker stays in it;
    - a goal's "New task" row, when the shell hands in CreateTask: the shell creates the
      task — Progress UI may not reach Tasks — and IGoals.AttachAsync attaches it. The
      shell's refusal shows above the board and nothing is attached; an attach refused
      after the create says the task is in the backlog but not on the goal, and the task
      stays as ordinary work;
    - a field of the open goal, through IGoals.EditAsync with the other two as stored;
      an emptied due date clears it. A refusal — no title, an outcome of more than one
      line — shows in the
      goal under its fields, in the module's words, and the field shows the stored value;
    - Delete goal…, once the board's ConfirmDialog has asked, through IGoals.DeleteAsync.
      What the goal held is left as it is and shows under No goal on the next reading;
    - a row's Detach, through IGoals.DetachAsync. A refusal shows above the board;
    - a goal moved on the board — dragged by its grip, or Move up / Move down — through
      IGoals.MoveAsync at its new place. The board draws the new order at once; a refusal
      shows above the board, and the reading after it puts the stored order back;
    - a state picked for an impediment, through IImpediments.MoveAsync with no person,
      so the last one stands. A refusal shows above the board and the picker goes back
      to the stored state;
    - a note written on an impediment's row, through IImpediments.EditNoteAsync, blank
      clearing it. A refusal shows above the board and the row shows the stored note.
*@
@if (!Available)
{
    <EmptyState Title="Goals are not set up here"
                Description="This build has no Goals module behind the view."
                TestId="goals-view-unavailable">
        <Icon><TargetIcon Size="24" /></Icon>
    </EmptyState>
}
else if (_model is null)
{
    @if (_readError is not null)
    {
        <Alert Message="@_readError" ActionLabel="Try again" OnAction="ReadAsync" TestId="goals-host-error" />
    }
    else
    {
        <Spinner Label="Reading the goals" TestId="goals-host-loading" />
    }
}
else
{
    <GoalsBoard Model="_model"
                SelectedGoalId="@_selectedGoalId"
                SelectedGoalIdChanged="SelectGoal"
                IterationChanged="SetIterationAsync"
                OnNewGoal="() => { _createError = null; _creating = true; }"
                OnRefresh="RefreshAsync"
                OnAttach="AttachAsync"
                OnPickGoal="OpenPicker"
                OnMoveImpediment="MoveAsync"
                OnEditImpedimentNote="EditNoteAsync"
                OnEditGoal="EditGoalAsync"
                OnDeleteGoal="DeleteGoalAsync"
                OnDetach="DetachAsync"
                OnMoveGoal="MoveGoalAsync"
                OnQuickAddTask="@(CreateTask is null ? default : EventCallback.Factory.Create<GoalQuickAddRequest>(this, QuickAddAsync))"
                EditError="@_editError"
                Error="@(_writeError ?? _readError)"
                Busy="_writing"
                TestId="goals-board" />
}

<GoalCreateDialog Open="_creating"
                  OpenChanged="open => _creating = open"
                  Busy="_writing"
                  Error="@_createError"
                  OnSave="CreateAsync" />

<TwoWeekStartDialog Open="_askingStart"
                    OpenChanged="open => _askingStart = open"
                    Offered="@Iterations.MondayOf(Today)"
                    OnSave="SetTwoWeekStartAsync" />

<GoalPicker Open="@(_picking is not null)"
            OpenChanged="open => { if (!open) _picking = null; }"
            Subject="@_picking?.Subject"
            Goals="PickerGoals"
            CurrentGoal="@_picking?.Holder"
            InitialSelection="@_picking?.Target"
            Busy="_writing"
            Error="@_pickError"
            OnAttach="PickAsync"
            OnCreate="PickNewAsync" />

@code {
    /// <summary>The refusal an item another goal holds is attached with.</summary>
    public const string ItemInOtherGoal = "progress.item_in_other_goal";

    /// <summary>The shell's tasks, plan tags and open pull requests, asked for on every
    /// mapping and never kept.</summary>
    [Parameter]
    public Func<GoalsCandidates>? Candidates { get; set; }

    /// <summary>Raised by the shell when its candidates changed — its reader's pull
    /// requests landed, or its task list moved: the last reading is mapped again.</summary>
    [Parameter]
    public int Revision { get; set; }

    /// <summary>The view opened (false) or Refresh was pressed (true): the shell reads its
    /// open pull requests as its other views do.</summary>
    [Parameter]
    public EventCallback<bool> OnRead { get; set; }

    /// <summary>The shell's create for a goal's "New task" row: a task titled with the text
    /// given, its id back or the Tasks module's refusal. Without it no goal offers the row.</summary>
    [Parameter]
    public Func<string, Task<Result<Guid>>>? CreateTask { get; set; }

    private IStandUp? _standUp;
    private IGoals? _goals;
    private IImpediments? _impediments;
    private IIterationSettings? _settings;
    private IGoalPullRequestReader? _pullRequests;

    private StandUpDto? _reading;
    private IReadOnlyList<GoalSummaryDto> _summaries = [];
    private IReadOnlyList<GoalPullRequestDto> _pulls = [];
    private GoalsBoardModel? _model;
    private int _mappedRevision;
    private int _generation;
    private int _ownWrites;

    private string? _selectedGoalId;
    private string? _readError;
    private string? _writeError;
    private bool _writing;
    private bool _creating;
    private bool _askingStart;
    private string? _createError;
    private string? _editError;
    private Picking? _picking;
    private string? _pickError;

    /// <summary>The goal a New goal… in the picker set, while the attach that followed it
    /// was refused: a second Attach with the same draft attaches to it rather than setting
    /// it twice.</summary>
    private (GoalDraft Draft, Guid Id)? _pickCreated;

    /// <summary>The work the GoalPicker is open for: the goal that holds it when a move
    /// asked, and the goal the move was meant for, chosen at opening.</summary>
    private sealed record Picking(GoalSubject Subject, GoalOption? Holder, Guid? Target);

    private bool Available => _standUp is not null && _goals is not null;

    private DateOnly Today =>
        DateOnly.FromDateTime(((Services.GetService(typeof(TimeProvider)) as TimeProvider) ?? TimeProvider.System).GetLocalNow().DateTime);

    protected override void OnInitialized()
    {
        _standUp = Services.GetService(typeof(IStandUp)) as IStandUp;
        _goals = Services.GetService(typeof(IGoals)) as IGoals;
        _impediments = Services.GetService(typeof(IImpediments)) as IImpediments;
        _settings = Services.GetService(typeof(IIterationSettings)) as IIterationSettings;
        _pullRequests = Services.GetService(typeof(IGoalPullRequestReader)) as IGoalPullRequestReader;

        if (_goals is not null) _goals.Changed += OnChanged;
        if (_impediments is not null) _impediments.Changed += OnChanged;
        if (_settings is not null) _settings.Changed += OnChanged;
        _mappedRevision = Revision;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Available) return;

        await OnRead.InvokeAsync(false);
        await ReadAsync();
    }

    protected override void OnParametersSet()
    {
        if (Revision == _mappedRevision) return;

        _mappedRevision = Revision;
        Remap();
    }

    /// <summary>Something was saved — here or pulled in by the sync — so the view is read
    /// again.</summary>
    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        // This host's own write reads once it lands; its Changed is that same news.
        if (_ownWrites > 0) return;

        await ReadAsync();
        StateHasChanged();
    });

    /// <summary>Runs a write made here and the read after it, with the module's Changed
    /// for that write set aside.</summary>
    private async Task WriteAsync(Func<Task<bool>> write)
    {
        _ownWrites++;
        try
        {
            if (await write()) await ReadAsync();
        }
        finally
        {
            _ownWrites--;
        }
    }

    private async Task ReadAsync()
    {
        if (_standUp is null || _goals is null) return;

        var generation = ++_generation;

        var standUp = await _standUp.ReadAsync();
        if (generation != _generation) return;
        if (standUp.IsFailure)
        {
            _readError = standUp.Error.Message;
            return;
        }

        var goals = await _goals.ListAsync(standUp.Value.Last.First, standUp.Value.Last.Last);
        if (generation != _generation) return;
        if (goals.IsFailure)
        {
            _readError = goals.Error.Message;
            return;
        }

        var refs = GoalsMapper.PullRequestsToRead(standUp.Value, goals.Value, CandidatesNow());
        IReadOnlyList<GoalPullRequestDto> pulls = refs.Count == 0 || _pullRequests is null ? [] : await _pullRequests.ReadAsync(refs);
        if (generation != _generation) return;

        _reading = standUp.Value;
        _summaries = goals.Value;
        _pulls = pulls;
        _readError = null;
        Remap();
    }

    private void Remap()
    {
        if (_reading is null) return;
        _model = GoalsMapper.Map(_reading, _summaries, _pulls, CandidatesNow());
    }

    private GoalsCandidates CandidatesNow() => Candidates?.Invoke() ?? GoalsCandidates.Empty;

    private async Task RefreshAsync()
    {
        _writeError = null;
        await OnRead.InvokeAsync(true);
        await ReadAsync();
    }

    private async Task SetIterationAsync(GoalsIteration iteration)
    {
        if (_settings is null) return;

        _writeError = null;

        // 2 weeks with no start yet asks for the day first; nothing is kept until it is given.
        if (iteration == GoalsIteration.TwoWeeks && _settings.TwoWeekStart is null)
        {
            _askingStart = true;
            return;
        }

        var settings = _settings;
        await WriteAsync(() =>
        {
            settings.SetLength(GoalsMapper.Length(iteration), Today);
            return Task.FromResult(true);
        });
    }

    /// <summary>The day was given: it is kept as the two-week start, then the view reads by
    /// 2 weeks.</summary>
    private async Task SetTwoWeekStartAsync(DateOnly start)
    {
        if (_settings is not { } settings) return;

        _askingStart = false;
        await WriteAsync(() =>
        {
            settings.SetTwoWeekStart(start);
            settings.SetLength(IterationLength.TwoWeeks, Today);
            return Task.FromResult(true);
        });
    }

    private async Task CreateAsync(NewGoalDraft draft)
    {
        if (_goals is not { } goals) return;

        await WriteAsync(async () =>
        {
            _writing = true;
            try
            {
                var created = await goals.CreateAsync(new SetGoalRequest(draft.Title, draft.Outcome, draft.DueDate));
                if (created.IsFailure)
                {
                    _createError = created.Error.Message;
                    return false;
                }

                _createError = null;
                _creating = false;
                _selectedGoalId = created.Value.Id.ToString();
                return true;
            }
            finally
            {
                _writing = false;
            }
        });
    }

    private async Task AttachAsync(GoalAttachRequest request)
    {
        if (_goals is not { } goals || !Guid.TryParse(request.GoalId, out var goalId)) return;

        var item = GoalSubjects.ToItem(request.Subject);
        _writeError = null;
        await WriteAsync(async () =>
        {
            _writing = true;
            try
            {
                var attached = await goals.AttachAsync(goalId, item);
                if (attached.IsSuccess) return true;

                if (attached.Error.Code != ItemInOtherGoal)
                {
                    _writeError = attached.Error.Message;
                    return false;
                }

                // The picker names the goal that holds it and asks before the move.
                var holder = await goals.FindGoalOfAsync(item);
                if (holder.IsFailure || holder.Value is not { } held)
                {
                    _writeError = attached.Error.Message;
                    return false;
                }

                Open(new Picking(request.Subject, Option(held), goalId));
                return false;
            }
            finally
            {
                _writing = false;
            }
        });
    }

    /// <summary>A goal's "New task" row: the shell creates the task, then it is attached
    /// here. A create refused attaches nothing and reads nothing; an attach refused after it
    /// leaves the task in the backlog — creating it wrote no goal into it — and is read
    /// again so it shows under No goal.</summary>
    private async Task QuickAddAsync(GoalQuickAddRequest request)
    {
        // Not while a write is under way: creating is not idempotent, and the row's Busy
        // reaches the screen a render after the press that started this one.
        if (_goals is not { } goals || CreateTask is not { } create || _writing || !Guid.TryParse(request.GoalId, out var goalId)) return;

        _writeError = null;
        await WriteAsync(async () =>
        {
            _writing = true;
            try
            {
                var created = await create(request.Title);
                if (created.IsFailure)
                {
                    _writeError = created.Error.Message;
                    return false;
                }

                var attached = await goals.AttachAsync(goalId, GoalItemDto.ForTask(created.Value));
                if (attached.IsFailure)
                {
                    _writeError = $"{request.Title} was added to the backlog, but not to this goal: {attached.Error.Message}";
                }

                return true;
            }
            finally
            {
                _writing = false;
            }
        });
    }

    /// <summary>A No goal row's Attach… with no goal open.</summary>
    private void OpenPicker(GoalSubject subject) => Open(new Picking(subject, null, null));

    private void Open(Picking picking)
    {
        _pickError = null;
        _pickCreated = null;
        _picking = picking;
    }

    /// <summary>The open goals, the goal a move was meant for among them even once reached.</summary>
    private IReadOnlyList<GoalOption> PickerGoals
    {
        get
        {
            var open = GoalSubjects.OpenGoals(_summaries, _picking?.Holder?.Id);
            return _picking?.Target is { } target && open.All(goal => goal.Id != target)
                   && _summaries.FirstOrDefault(summary => summary.Goal.Id == target) is { } meant
                ? [.. open, GoalSubjects.Option(meant)]
                : open;
        }
    }

    private GoalOption Option(GoalDto goal) =>
        _summaries.FirstOrDefault(summary => summary.Goal.Id == goal.Id) is { } summary
            ? GoalSubjects.Option(summary)
            : new GoalOption(goal.Id, goal.Title, 0, goal.Attachments.Count, goal.DueDate);

    private Task PickAsync(Guid goalId) => PickWriteAsync((goals, picking) => AttachPickedAsync(goals, picking, goalId));

    private Task PickNewAsync(GoalDraft draft) => PickWriteAsync(async (goals, picking) =>
    {
        // Set once: a refused attach after the goal was set is retried on that goal.
        if (_pickCreated is { } earlier && earlier.Draft == draft) return await AttachPickedAsync(goals, picking, earlier.Id);

        var created = await goals.CreateAsync(new SetGoalRequest(draft.Title, null, draft.DueDate));
        if (created.IsFailure) return created;

        _pickCreated = (draft, created.Value.Id);
        return await AttachPickedAsync(goals, picking, created.Value.Id);
    });

    private static Task<Result<GoalDto>> AttachPickedAsync(IGoals goals, Picking picking, Guid goalId) =>
        goals.AttachAsync(goalId, GoalSubjects.ToItem(picking.Subject),
            moveFromOtherGoal: picking.Holder is { } holder && holder.Id != goalId);

    /// <summary>The picker's attach, its refusal kept in the picker.</summary>
    private async Task PickWriteAsync(Func<IGoals, Picking, Task<Result<GoalDto>>> write)
    {
        if (_goals is not { } goals || _picking is not { } picking || _writing) return;

        _writeError = null;
        await WriteAsync(async () =>
        {
            _writing = true;
            try
            {
                var written = await write(goals, picking);
                if (written.IsFailure)
                {
                    _pickError = written.Error.Message;
                    // A goal set before the refusal is on the board now.
                    return _pickCreated is not null;
                }

                _pickError = null;
                _pickCreated = null;
                _picking = null;
                return true;
            }
            finally
            {
                _writing = false;
            }
        });
    }

    /// <summary>Another goal opened, or none: an edit refused on the last one is not its.</summary>
    private void SelectGoal(string? id)
    {
        if (id != _selectedGoalId) _editError = null;
        _selectedGoalId = id;
    }

    private async Task EditGoalAsync(GoalEditRequest request)
    {
        if (_goals is not { } goals || !Guid.TryParse(request.GoalId, out var goalId)) return;

        _writeError = null;
        await WriteAsync(async () =>
        {
            _writing = true;
            try
            {
                var edited = await goals.EditAsync(goalId, new SetGoalRequest(request.Title, request.Outcome, request.DueDate));
                _editError = edited.IsFailure ? edited.Error.Message : null;
                return edited.IsSuccess;
            }
            finally
            {
                _writing = false;
            }
        });
    }

    private async Task DeleteGoalAsync(string goalId)
    {
        if (_goals is not { } goals || !Guid.TryParse(goalId, out var id)) return;

        _writeError = null;
        _editError = null;
        await WriteAsync(async () =>
        {
            _writing = true;
            try
            {
                var deleted = await goals.DeleteAsync(id);
                if (deleted.IsFailure) _writeError = deleted.Error.Message;
                else if (_selectedGoalId == goalId) _selectedGoalId = null;
                return true;
            }
            finally
            {
                _writing = false;
            }
        });
    }

    private async Task DetachAsync(GoalDetachRequest request)
    {
        if (_goals is not { } goals || !Guid.TryParse(request.GoalId, out var goalId)) return;

        var item = GoalSubjects.ToItem(request.Subject);
        _writeError = null;
        await WriteAsync(async () =>
        {
            _writing = true;
            try
            {
                var detached = await goals.DetachAsync(goalId, item);
                if (detached.IsFailure) _writeError = detached.Error.Message;
                return true;
            }
            finally
            {
                _writing = false;
            }
        });
    }

    /// <summary>A goal moved on the board, which drew the new order at once. The view is
    /// read again either way, so a refusal puts the stored order back.</summary>
    private async Task MoveGoalAsync(GoalMoveRequest request)
    {
        if (_goals is not { } goals || !Guid.TryParse(request.GoalId, out var goalId)) return;

        _writeError = null;
        await WriteAsync(async () =>
        {
            _writing = true;
            try
            {
                var moved = await goals.MoveAsync(goalId, request.ToIndex);
                if (moved.IsFailure) _writeError = moved.Error.Message;
                return true;
            }
            finally
            {
                _writing = false;
            }
        });
    }

    private async Task MoveAsync(ImpedimentMoveRequest request)
    {
        if (_impediments is not { } impediments || !Guid.TryParse(request.ImpedimentId, out var id)) return;

        _writeError = null;
        await WriteAsync(async () =>
        {
            _writing = true;
            try
            {
                // No person: the last one the impediment was with stands. A refusal is
                // read again too, so the picker draws the stored state from a fresh reading.
                var moved = await impediments.MoveAsync(id, GoalsMapper.State(request.State));
                if (moved.IsFailure) _writeError = moved.Error.Message;
                return true;
            }
            finally
            {
                _writing = false;
            }
        });
    }

    private async Task EditNoteAsync(ImpedimentNoteRequest request)
    {
        if (_impediments is not { } impediments || !Guid.TryParse(request.ImpedimentId, out var id)) return;

        _writeError = null;
        await WriteAsync(async () =>
        {
            _writing = true;
            try
            {
                var edited = await impediments.EditNoteAsync(id, request.Note);
                if (edited.IsFailure) _writeError = edited.Error.Message;
                return true;
            }
            finally
            {
                _writing = false;
            }
        });
    }

    public void Dispose()
    {
        if (_goals is not null) _goals.Changed -= OnChanged;
        if (_impediments is not null) _impediments.Changed -= OnChanged;
        if (_settings is not null) _settings.Changed -= OnChanged;
    }
}
