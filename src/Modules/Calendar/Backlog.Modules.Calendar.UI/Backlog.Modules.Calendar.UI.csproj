<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The Calendar module's UI (.devbook/domain/calendar/features.md#calendar-view): the
    Calendar the desktop shell shows as a view (CalendarSurface, registered by
    AddCalendarSurface), which draws its own grid (CalendarGrid, local ADR 0056 §1) from
    the layers it reads — the Tasks, Plans and Events layers and the hours worked a day —
    with the range and the Show tasks, Show plans and Show events choices it keeps
    (ICalendarViewPreferences). Its layout is the grid's rules in the shared library's
    components.css (the task-calendar classes), so it ships no stylesheet.

    It references the shared control library rather than growing its own controls,
    which is the rule every module UI project follows, and the module's published
    surface only — never the read policy's implementation or the registration.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.Modules.Calendar.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Backlog.UI.Components\Backlog.UI.Components.csproj" />
    <ProjectReference Include="..\Backlog.Modules.Calendar.Abstractions\Backlog.Modules.Calendar.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The grid's lane arithmetic (CalendarLanes) is internal; its tests sit with the
         other bUnit tests of the module UIs. -->
    <InternalsVisibleTo Include="Backlog.Desktop.UI.UnitTests" />
  </ItemGroup>

</Project>
