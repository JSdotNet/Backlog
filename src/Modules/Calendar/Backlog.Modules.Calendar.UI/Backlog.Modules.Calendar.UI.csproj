<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The Calendar module's UI (.devbook/domain/calendar/features.md#calendar-view): the
    Calendar the desktop shell shows as a view (CalendarSurface, registered by
    AddCalendarSurface), which hosts the Tasks layer as the part Tasks offers through
    Backlog.UI.Components and hands it the layers the Calendar reads — the Plans layer
    and the hours worked a day — with the range and Show plans it keeps
    (ICalendarViewPreferences). Its layout is the calendar's own rules in the shared
    library's components.css, so it ships no stylesheet.

    It references the shared control library rather than growing its own controls,
    which is the rule every module UI project follows, and the module's published
    surface only — never the read policy's implementation or the registration.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.Modules.Calendar.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Backlog.UI.Components\Backlog.UI.Components.csproj" />
    <ProjectReference Include="..\Backlog.Modules.Calendar.Abstractions\Backlog.Modules.Calendar.Abstractions.csproj" />
  </ItemGroup>

</Project>
