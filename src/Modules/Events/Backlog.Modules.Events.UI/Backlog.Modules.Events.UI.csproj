<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The Events module's UI (.devbook/domain/events/features.md#events-pane): the Events
    pane the desktop shell opens as a takeover (EventsSurface, registered by
    AddEventsSurface behind the `events` flag), its list grouped by state (EventList),
    the editor beside it (EventEditor) with its note links (EventNoteLinks), its tasks
    (EventTasks) and the skip dialog (EventSkipDialog). The layout ships in
    wwwroot/events.css.

    It references the shared control library rather than growing its own controls,
    which is the rule every module UI project follows, and the module's published
    surface only — never a knowledge event, its repository or the registration.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.Modules.Events.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Backlog.UI.Components\Backlog.UI.Components.csproj" />
    <ProjectReference Include="..\Backlog.Modules.Events.Abstractions\Backlog.Modules.Events.Abstractions.csproj" />
  </ItemGroup>

</Project>
