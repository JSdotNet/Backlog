    private void TitleInput(string value)
    {
        _title = value;
        var id = Event.Id;
        Queue("title", () => Pane.RenameAsync(id, value));
    }

    private Task DatesChangedAsync(Action<string> input, ChangeEventArgs change)
    {
        input(change.Value?.ToString() ?? string.Empty);

        var zone = _time.LocalTimeZone;
        var start = EventPresentation.DayOf(_startDate, _startTime, zone);
        // An end with no start is not offered, so a cleared start clears both.
        var end = start is null ? null : EventPresentation.DayOf(_endDate, _endTime, zone);
        var id = Event.Id;
        return WriteAsync("dates", () => Pane.SetDatesAsync(id, start, end));
    }

    /// <summary>Online on or off saves the place at once. Going online drops the address; back
    /// in person, the address fields still hold what was typed, and that is the address saved.</summary>
    private Task OnlineChangedAsync(bool online)
    {
        _online = online;
        _pending.Remove("place");
        _committedAddress = online ? null : DraftAddress();
        return WriteAsync("place", PlaceWrite());
    }

    /// <summary>The venue's name typed: it saves on the pause in typing like any text, with the
    /// address the event holds, so the address and its point stay. A held address not looked up
    /// yet is sent again by that save — the whole stored address, the next save ADR 0061 §5
    /// names — never a part still being typed.</summary>
    private void VenueInput(string value)
    {
        _venue = value;
        Queue("place", PlaceWrite());
    }

    /// <summary>The focus left an address part: the address is saved unless the focus is now on
    /// another of the four parts. Nowhere — the body, after a click on a spot nothing can focus —
    /// is leaving too. The browser is asked afterwards, because a focusout does not say where the
    /// focus went (<c>backlogFocusWithin</c>).</summary>
    private async Task AddressFocusOutAsync(FocusEventArgs _)
    {
        if (DraftAddress() == _committedAddress) return;

        bool left;
        try
        {
            left = !await Js.InvokeAsync<bool>("backlogFocusWithin", "#" + AddressId);
        }
        catch (JSException)
        {
            left = true;
        }

        if (left) await CommitAddressAsync();
    }

    private Task AddressKeyAsync(KeyboardEventArgs args) => args.Key == "Enter" ? CommitAddressAsync() : Task.CompletedTask;

    /// <summary>The address as the four parts hold it is saved, and so looked up, when it differs
    /// from the one last sent; four blank parts are no address. The save lands at once and the
    /// lookup runs after it in the pane, so the indicator stops at the save.</summary>
    private async Task CommitAddressAsync()
    {
        var address = DraftAddress();
        if (address == _committedAddress) return;

        _committedAddress = address;
        _pending.Remove("place");
        _lookUpNote = null;
        if (_debounce is not null) await _debounce.SaveNowAsync();
        await WriteAsync("place", PlaceWrite());
    }

    /// <summary>The event's address changed underneath — another window, the sync — while the
    /// person is not typing one: the fields read it, and it is the address a venue edit sends
    /// back from now on. An address being typed is the person's and is kept.</summary>
    private void ReadHeldAddress()
    {
        var held = Event.Place?.Address;
        if (held == _eventAddress) return;

        _eventAddress = held;
        if (DraftAddress() != _committedAddress) return;

        _street = held?.Street ?? string.Empty;
        _postcode = held?.Postcode ?? string.Empty;
        _town = held?.Town ?? string.Empty;
        _country = held?.Country ?? string.Empty;
        _committedAddress = DraftAddress();
    }

    /// <summary>
    /// Look up now: the event's address, not looked up yet or not found, is sent once more, and
    /// the editor waits for its answer — outside the pane's write queue, so no other save waits
    /// behind it, and outside the save indicator, since nothing the person typed is unsaved. When
    /// no answer came back the event is as it was, so the editor says nothing was looked up
    /// rather than leave the old hint to read as a second "not found". The button goes once the
    /// address is placed, so the focus moves to the venue field, whose hint gives the number.
    /// </summary>
    private async Task LookUpNowAsync()
    {
        if (_lookingUp) return;

        _lookingUp = true;
        _lookUpNote = null;
        try
        {
            var looked = await Pane.LookUpAddressAsync(Event.Id);
            if (looked is not Ok<AddressLookUpDto>(var answer))
            {
                _lookUpNote = ((global::Backlog.SharedKernel.Results.Error)looked.Value!).Message;
                return;
            }

            if (answer.Answer == AddressLookup.NotLookedUpYet) _lookUpNote = LookUpNoAnswer;
            await OnSaved.InvokeAsync(answer.Event);
            if (answer.Event.Place is { Lookup: AddressLookup.Placed }) _focusVenue = true;
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _lookUpNote = "Could not look up: " + exception.Message;
        }
        finally
        {
            _lookingUp = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusVenue) return;

        _focusVenue = false;
        try
        {
            await Js.InvokeVoidAsync("backlogFocus", VenueId, false);
        }
        catch (JSException)
        {
        }
    }

    /// <summary>A map search for the place, or null while there is none.</summary>
    private static string? MapLink(string query) =>
        string.IsNullOrWhiteSpace(query)
            ? null
            : "https://www.google.com/maps/search/?api=1&query=" + Uri.EscapeDataString(query.Trim());

    /// <summary>The address the four fields hold, or null when every one is blank.</summary>
    private AddressDto? DraftAddress()
    {
        var address = new AddressDto(Part(_street), Part(_postcode), Part(_town), Part(_country));
        return address is { Street: null, Postcode: null, Town: null, Country: null } ? null : address;
    }

    private static string? Part(string text) => string.IsNullOrWhiteSpace(text) ? null : text.Trim();

    /// <summary>The place write, read when it runs rather than when it was queued: online, none
    /// when there is neither a venue nor an address, else in person with the venue as typed and
    /// the address last committed — the event's own, read again when it changed underneath.</summary>
    private Func<Task<Result<KnowledgeEventDto>>> PlaceWrite()
    {
        var id = Event.Id;
        return () => Pane.SetPlaceAsync(id, CurrentPlace());
    }

    private PlaceDto? CurrentPlace() =>
        _online ? new PlaceDto(null, true)
        : Part(_venue) is null && _committedAddress is null ? null
        : new PlaceDto(Part(_venue), false, _committedAddress);

