<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Goals module — the Goals bounded context (.devbook/domain/goals, local
    ADR 0035). Clean architecture, inside out:
      DomainModels/  the Goal and Impediment aggregates
      Features/      one vertical slice per use case (command/query + handler)
      Services/      the domain services, and the published ports over the handlers
      Extensions/    AddGoalsModule() composition root for hosts
    Ports such as IGoalRepository live here; adapters live in
    src/Infrastructure. Tasks are read through IGoalsTaskSource, answered by an
    adapter over Tasks' published surface: this project may reference the shared
    kernel and its own Abstractions, and nothing else in the solution.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.Modules.Goals</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Backlog.SharedKernel\Backlog.SharedKernel.csproj" />
    <ProjectReference Include="..\Backlog.Modules.Goals.Abstractions\Backlog.Modules.Goals.Abstractions.csproj" />
  </ItemGroup>


  <ItemGroup>
    <InternalsVisibleTo Include="Backlog.Modules.Goals.UnitTests" />
  </ItemGroup>

</Project>
