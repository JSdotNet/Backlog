<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The Capture module's UI: the sources panel the shell folds into the Inbox
    pane — which sources are watched, what each is pointed at, when each was
    last looked at and what that run said (.domain/capture/features.md#run-capture-now).

    It sits beside the Inbox on screen but not in code: the Inbox pane offers a
    render slot and the shell fills it with this, so neither context references
    the other. It references the shared control library rather than growing its
    own controls, which is the rule every module UI project follows.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.Modules.Capture.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Backlog.UI.Components\Backlog.UI.Components.csproj" />
    <!-- The module's published surface only: the vocabulary of sources and the
         two ports the panel reads and writes — the settings and the run log.
         The run itself stays behind that line; the shell presses the button. -->
    <ProjectReference Include="..\Backlog.Modules.Capture.Abstractions\Backlog.Modules.Capture.Abstractions.csproj" />
  </ItemGroup>

</Project>
