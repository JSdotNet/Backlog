@using Microsoft.Extensions.DependencyInjection
@inject global::Backlog.SharedKernel.ISurfaceCatalog Catalog
@inject IServiceProvider Services

@*
    The Sessions context's session list as a shell surface (local ADR 0043 §1, §3, §6):
    a takeover, in the main window in place of the main view or in a window of its own.
    `session=<id>` opens it on that session, its row selected and focused — a jump from
    a task or a pull request that names the session. What only the host can answer
    comes through the window's SessionsSurfaceWiring, and opening an entry is a jump to
    the Tasks surface that lands in this window. `page=schedules` opens it on the
    Schedules page instead, and `schedule=<id>` on that schedule there — a schedule
    alert's Open Schedules. A Holding dispatcher's See usage opens the Dashboard on its
    Sessions tab, through the window's navigator, while the catalog offers the Dashboard.
    A pull request's chip is asked for only while the catalog offers the pull requests
    surface, the flag that gates it.
*@
<SessionsPane OnClose="OnClose"
              RepositoryScope="@(_wiring?.RepositoryScope?.Invoke() ?? [])"
              RepositoryAlias="@_wiring?.RepositoryAlias"
              RepositoryColour="@_wiring?.RepositoryColour"
              OnOpenTask="@OpenTaskCallback"
              SessionTask="@_wiring?.SessionTask"
              PullRequestStatus="@(Catalog.TryGet(PullRequestsSurfaceId, out _) ? _wiring?.PullRequestStatus : null)"
              OnAnswerQuestion="@AnswerQuestionCallback"
              FocusSessionId="@FocusSessionId"
              OpenOnSchedules="@OpenOnSchedules"
              FocusScheduleId="@FocusScheduleId"
              OnSeeUsage="@SeeUsageCallback" />

@code {
    /// <summary>The pull requests surface's id, the Sessions context's second list.</summary>
    private const string PullRequestsSurfaceId = SessionsSurfaceRegistration.PullRequestsSurfaceId;

    /// <summary>The query the surface was shown with: <c>session</c>, or nothing.</summary>
    [Parameter]
    public IReadOnlyDictionary<string, string>? Query { get; set; }

    /// <summary>Closes the surface: back to the main view, or the window closed.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private SessionsSurfaceWiring? _wiring;

    protected override void OnInitialized() => _wiring = Services.GetService<SessionsSurfaceWiring>();

    private string? FocusSessionId =>
        Query is not null && Query.TryGetValue(SessionsSurfaceRegistration.SessionKey, out var session) && session.Length > 0
            ? session
            : null;

    private bool OpenOnSchedules =>
        Query is not null
        && Query.TryGetValue(SessionsSurfaceRegistration.PageKey, out var page)
        && string.Equals(page, SessionsSurfaceRegistration.SchedulesPage, StringComparison.OrdinalIgnoreCase);

    private string? FocusScheduleId =>
        Query is not null && Query.TryGetValue(SessionsSurfaceRegistration.ScheduleKey, out var schedule) && schedule.Length > 0
            ? schedule
            : null;

    private EventCallback<DeliveryRunReference> OpenTaskCallback =>
        _wiring?.OpenTask is { } open ? EventCallback.Factory.Create(this, open) : default;

    /// <summary>The Dashboard surface's id and the query that opens it on its Sessions tab,
    /// where the app shows Claude Code usage and the limits it hit. Named as strings here,
    /// since the Sessions module references no Dashboard UI project.</summary>
    internal const string DashboardSurfaceId = "dashboard";

    internal const string DashboardTabKey = "tab";

    internal const string DashboardSessionsTab = "sessions";

    /// <summary>Only while the catalog offers the Dashboard, so See usage never opens
    /// nothing; without it a Holding card offers none.</summary>
    private EventCallback SeeUsageCallback =>
        Catalog.TryGet(DashboardSurfaceId, out _) && Services.GetService<global::Backlog.SharedKernel.ISurfaceNavigator>() is { } navigator
            ? EventCallback.Factory.Create(this, () => navigator.Show(
                DashboardSurfaceId,
                new Dictionary<string, string>(StringComparer.Ordinal) { [DashboardTabKey] = DashboardSessionsTab }))
            : default;

    /// <summary>Only while the window offers the centre, so an Answer never opens
    /// nothing; without it the strip still says what the session asks.</summary>
    private EventCallback<Guid> AnswerQuestionCallback =>
        _wiring?.AnswerQuestion is { } answer && (_wiring.AnswerQuestionOffered?.Invoke() ?? true)
            ? EventCallback.Factory.Create(this, answer)
            : default;
}
