@*
    The Claude Code page on the settings screen: where this app receives Claude
    Code's OpenTelemetry events, and the block to paste into Claude Code's settings
    so it sends them (local ADR 0024).

    The address comes from the host. The desktop head composes
    IClaudeCodeTelemetryEndpoint over its MCP listener - loopback, the configured
    port, and the headers helper that fetches a token for the Telemetry grant. A host that composes none, the
    browser harness, serves the endpoint on its own origin with no token, so the page
    reads the address off the page's own base URI there.
*@
@namespace Backlog.Modules.Sessions.UI
@using global::Backlog.UI.Components.Code
@using global::Backlog.UI.Components.Settings
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services
@inject NavigationManager Navigation

<SettingsHeadline>@Headline</SettingsHeadline>

<SettingsCard Title="@CardTitle"
              Id="claude-code-telemetry-title"
              Description="Claude Code reports what each model request cost through OpenTelemetry."
              TestId="claude-code-telemetry-card">
    <p class="setting__body">
        Point its exporter at this app and every <code>claude_code.api_request</code> event - the
        model, the effort, the cost, the tokens and how long it took - is kept in this app's local
        database, once per request. Every other event Claude Code sends is dropped.
    </p>

    <p class="setting__label" id="claude-code-telemetry-endpoint-label">Endpoint</p>
    <div class="setting__body">
        <code data-testid="claude-code-telemetry-endpoint" aria-labelledby="claude-code-telemetry-endpoint-label">@Endpoint</code>
        <CopyButton Text="@Endpoint.ToString()"
                    Label="Copy the endpoint"
                    TestId="claude-code-telemetry-endpoint-copy" />
    </div>

    <p class="setting__body">
        Paste this into <code>~/.claude/settings.json</code>, or a project's
        <code>.claude/settings.json</code>, and start a new Claude Code session.
        Keep <code>OTEL_LOG_TOOL_DETAILS</code> in it: without that key Claude Code hides which
        sub-agent made each request, and a stage's cost can then only be estimated.
    </p>
    @* No secret in the block: it names the headers helper and the Telemetry grant's id, a
       label rather than a password (local ADR 0052, Phase 1), so it is drawn as copied. *@
    <CodeView Source="@Snippet"
              Language="json"
              Title="settings.json"
              AllowCopy="false"
              TestId="claude-code-telemetry-settings" />
    <div class="setting__actions">
        <CopyButton Text="@Snippet"
                    Label="Copy the settings block"
                    TestId="claude-code-telemetry-settings-copy">
            Copy the settings block
        </CopyButton>
    </div>

    <p class="setting__note" data-testid="claude-code-telemetry-note">
        @if (_headersHelper is not null)
        {
            <span>
                The endpoint answers on this machine only, on the MCP server's port, and takes a
                token for the Telemetry grant alone - one that calls no tool. Claude Code runs the
                headers helper to fetch it from this app, every ten minutes, so nothing in the block
                is a secret. A block that still carries an Authorization header holds a retired
                token and is refused: paste this one in its place. Moving the MCP server to another
                port means pasting the block again.
            </span>
        }
        else
        {
            <span>This host asks for no token.</span>
        }
    </p>
</SettingsCard>

@code {
    /// <summary>The sentence the frame shows over this page.</summary>
    public const string Headline = "How Claude Code reports what each session cost.";

    /// <summary>The page's one card - what its
    /// <c>SettingsSection.CardTitles</c> declares.</summary>
    public const string CardTitle = "Cost from Claude Code";

    private IClaudeCodeTelemetryEndpoint? _endpoint;
    private string? _headersHelper;

    private Uri Endpoint => _endpoint?.LogsEndpoint
        ?? new Uri(new Uri(Navigation.BaseUri), ClaudeCodeTelemetrySnippet.LogsPath);

    private string Snippet => ClaudeCodeTelemetrySnippet.Settings(Endpoint, _headersHelper);

    protected override void OnInitialized()
    {
        _endpoint = Services.GetService<IClaudeCodeTelemetryEndpoint>();

        // The Telemetry grant the first start after the upgrade made; null in a host that
        // asks for no token.
        _headersHelper = _endpoint?.HeadersHelper;
    }
}
