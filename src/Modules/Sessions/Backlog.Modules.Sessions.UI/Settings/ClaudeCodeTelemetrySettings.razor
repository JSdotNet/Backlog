@*
    The Claude Code page on the settings screen: where this app receives Claude
    Code's OpenTelemetry events, and the block to paste into Claude Code's settings
    so it sends them (local ADR 0024).

    The address comes from the host. The desktop head composes
    IClaudeCodeTelemetryEndpoint over its MCP listener - loopback, the configured
    port, and the bearer token the listener checks. A host that composes none, the
    browser harness, serves the endpoint on its own origin with no token, so the page
    reads the address off the page's own base URI there.
*@
@namespace Backlog.Modules.Sessions.UI
@using global::Backlog.UI.Components.Code
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services
@inject NavigationManager Navigation

<h3 class="setting__subtitle" id="claude-code-telemetry-title">Cost from Claude Code</h3>
<p class="setting__body">
    Claude Code reports what each model request cost through OpenTelemetry. Point its
    exporter at this app and every <code>claude_code.api_request</code> event - the model,
    the effort, the cost, the tokens and how long it took - is kept in this app's local
    database, once per request. Every other event Claude Code sends is dropped.
</p>

<p class="setting__label" id="claude-code-telemetry-endpoint-label">Endpoint</p>
<div class="setting__body">
    <code data-testid="claude-code-telemetry-endpoint" aria-labelledby="claude-code-telemetry-endpoint-label">@Endpoint</code>
    <CopyButton Text="@Endpoint.ToString()"
                Label="Copy the endpoint"
                TestId="claude-code-telemetry-endpoint-copy" />
</div>

<p class="setting__body">
    Paste this into <code>~/.claude/settings.json</code>, or a project's
    <code>.claude/settings.json</code>, and start a new Claude Code session.
</p>
@* The block on screen hides the token and the copy carries it: the token is a
   secret, and a page that drew it would put it in every screenshot of Settings. *@
<CodeView Source="@ShownSnippet"
          Language="json"
          Title="settings.json"
          AllowCopy="false"
          TestId="claude-code-telemetry-settings" />
<CopyButton Text="@Snippet"
            Label="Copy the settings block"
            TestId="claude-code-telemetry-settings-copy">
    Copy the settings block
</CopyButton>

<p class="setting__note" data-testid="claude-code-telemetry-note">
    @if (_token is not null)
    {
        <span>
            The endpoint answers on this machine only, on the MCP server's port, and asks for the
            MCP server's token - the same one its registrations carry. The copied block holds the
            token itself, where the one above shows it hidden. Moving the MCP server to another
            port, or giving it a new token, means pasting the block again.
        </span>
    }
    else
    {
        <span>This host asks for no token.</span>
    }
</p>

@code {
    private IClaudeCodeTelemetryEndpoint? _endpoint;
    private string? _token;

    private Uri Endpoint => _endpoint?.LogsEndpoint
        ?? new Uri(new Uri(Navigation.BaseUri), ClaudeCodeTelemetrySnippet.LogsPath);

    private string Snippet => ClaudeCodeTelemetrySnippet.Settings(Endpoint, _token);

    private string ShownSnippet => ClaudeCodeTelemetrySnippet.Settings(
        Endpoint, _token is null ? null : ClaudeCodeTelemetrySnippet.HiddenToken);

    protected override void OnInitialized()
    {
        _endpoint = Services.GetService<IClaudeCodeTelemetryEndpoint>();

        // The listener mints the token when it starts, so this reads the one that is
        // already there; it mints only where nothing has started a listener yet, which
        // is the order a person following this page needs anyway.
        _token = _endpoint?.EnsureToken();
    }
}
