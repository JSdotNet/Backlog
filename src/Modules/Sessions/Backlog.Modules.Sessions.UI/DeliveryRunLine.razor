@using global::Microsoft.AspNetCore.Components.Web
@using global::Backlog.UI.Components.Metrics
@using global::Backlog.UI.Components.Devbook
@using global::System.Globalization

@*
    One delivery run, as a card: under the session that ran it, or in a row of its
    own when no listed session did. One component for both places so a run reads the
    same wherever it landed.

    Top to bottom in the order a reader asks: what it is and how it ended, whether it
    was unusual, how much it took, how each stage ran, what the figures mean, and the
    rest of what the run file records.

    - **The header.** "Delivery run", the flow it ran in the mono face, the work it is
      linked to, and its outcome at the right. The references are the Integrations
      family's own — the provider's mark, "#128" or "PR #74", the item's title in the
      tooltip, opening on GitHub — with no state chip, because this product has not
      asked GitHub how the item is doing. The outcome is the library's status badge
      over the dashboard's own word, and **it leads to the Backlog entry** where the
      run names one and the host can open one; otherwise it is the span every badge
      is. A run a schedule fired says so beside it.
    - **The insight**, a callout directly under the header, once the run has finished
      and enough earlier runs of its flow were priced (DeliveryRunInsightLine).
    - **The figures**, as tiles: stages done, what it cost, the context peak and the
      tool calls. A figure the run does not carry is left out, never shown as zero —
      "$0.00" would be a claim about the run rather than about the file. Under them,
      quietly, the host's word on the run's part of the week.
    - **The stages** (DeliveryRunStages): the legend, then a row per stage with one
      panel open at a time.
    - **The footnote**, saying what Configured and the cost against "typical" mean.
    - **Run details**, folded: the run's own title and id, its surfaces, change,
      schedule and sync verdicts, the context gauge, the token buckets, and the tool
      calls and MCP servers ranked by time. Everything a run file records beyond the
      headline numbers, behind one fold, because a run holds ten stages, six token
      buckets per stage and tens of thousands of tool calls.

    **The run's own title is not in the header.** A dashboard names a run after the
    work it was doing, so beside the reference to that work the title is the same
    sentence twice. It stays in Run details.

    The latest run on a row is drawn whole. An earlier one (Collapsible) folds to its
    header, the title the library's fold inside the heading, so a session that ran
    three flows shows the one that matters now and two lines, not three cards.
*@
<article class="@(Collapsible ? "sessions-run sessions-run--collapsible" : "sessions-run")"
         data-testid="sessions-run"
         data-run-id="@Run.Id"
         aria-label="@($"Delivery run {Run.Title}")">
    <header class="sessions-run__header">
        @if (Collapsible)
        {
            @* The trigger only, inside the heading: the region it folds is the card's
               body below, which the card owns. *@
            <FoldControl Label="Delivery run"
                         BaseClass="sessions-run__fold"
                         HeadingLevel="4"
                         HeadingCssClass="sessions-run__title"
                         AriaLabel="@($"Delivery run {Run.Title}")"
                         Controls="@_panelId"
                         Expanded="_expanded"
                         ExpandedChanged="@(expanded => _expanded = expanded)"
                         TestId="sessions-run-fold" />
        }
        else
        {
            <h4 class="sessions-run__title">Delivery run</h4>
        }

        <span class="sessions-run__flow data-table__mono" data-testid="sessions-run-flow">@Run.SkillId</span>

        @* The mark and the label only: the item's own title travels in the tooltip. *@
        @foreach (var reference in Linked)
        {
            <IntegrationLink Link="@Link(reference)"
                             ShowTitle="false"
                             CssClass="sessions-run__reference"
                             TestId="@($"sessions-run-{Slug(reference.Kind)}")" />
        }

        <span class="sessions-run__outcome">
            @* Only where a schedule fired the run. An attended run is the ordinary
               case and says nothing. *@
            @if (Run.Scheduled)
            {
                <Badge Kind="trigger"
                       CssClass="sessions-run__trigger"
                       Title="@(string.IsNullOrWhiteSpace(Run.Schedule) ? "Fired by a schedule, unattended" : $"Fired by the {Run.Schedule} schedule, unattended")"
                       TestId="sessions-run-scheduled">scheduled</Badge>
            }

            @* A button where the run names a Backlog entry and the host can open one,
               and a span otherwise. Never an anchor to the pull request beside it:
               this one's place is the entry. *@
            <StatusBadge Status="@Run.Status"
                         Text="@StatusLabel(Run.Status)"
                         CssClass="sessions-run__status"
                         OnClick="@(Entry is { } entry && OnOpenTask.HasDelegate ? EventCallback.Factory.Create<MouseEventArgs>(this, () => OnOpenTask.InvokeAsync(entry)) : default)"
                         Title="@(Entry is { } which && OnOpenTask.HasDelegate ? $"Open {which.Label} in the task list" : null)"
                         TestId="sessions-run-status" />
        </span>
    </header>

    <div class="sessions-run__body"
         id="@_panelId"
         hidden="@(Collapsible && !_expanded)"
         data-testid="sessions-run-panel">
        <DeliveryRunInsightLine Insight="@Comparison?.Insight" Flow="@Run.SkillId" OnOpen="@OpenEconomics" Id="@DeliveryRunInsightLine.DomId(Run)" />

        @if (Figures is { Count: > 0 } figures)
        {
            <MetricGrid Label="@($"Figures of run {Run.Title}")"
                        MinColumnWidth="7.5rem"
                        CssClass="sessions-run__figures"
                        TestId="sessions-run-figures">
                @foreach (var figure in figures)
                {
                    <MetricTile Label="@figure.Label"
                                Value="@figure.Value"
                                Footnote="@figure.Footnote"
                                CssClass="sessions-run__figure"
                                TestId="@($"sessions-run-figure-{figure.Key}")"
                                title="@figure.Title" />
                }
            </MetricGrid>
        }

        @* What the host has to say about the run's part of the week, drawn by the
           host's own component so the card holds no figure it did not read. *@
        @if (Usage is not null)
        {
            <div class="sessions-run__usage">@Usage</div>
        }

        @if (Run.Stages.Count > 0)
        {
            <DeliveryRunStages Run="Run" Costs="Costs" Comparison="Comparison" />

            <p class="sessions-run__footnote" data-testid="sessions-run-footnote">@Footnote</p>
        }

        <FoldControl Label="Run details"
                     BaseClass="sessions-run__more"
                     AriaLabel="@($"Details of run {Run.Title}")"
                     Expanded="_details"
                     ExpandedChanged="@(expanded => _details = expanded)"
                     TestId="sessions-run-details-toggle">
            <dl class="sessions-run__details">
                @* The run's own name for itself, which the header deliberately does
                   not repeat. *@
                <div class="sessions-run__group">
                    <dt>Title</dt>
                    <dd data-testid="sessions-run-title">@Run.Title</dd>

                    <dt>Run</dt>
                    <dd class="data-table__mono">@Run.Id · @Run.Dashboard · @Run.WorktreeName</dd>

                    @* Provenance, where more than one surface reported the run: a flow
                       reports to every surface it is bound to, each files its own copy,
                       and the reader folded them into this one line. Only then — a run
                       one surface recorded has nothing to say about it. *@
                    @if (Run.Surfaces.Count > 1)
                    {
                        <dt>Surfaces</dt>
                        <dd data-testid="sessions-run-surfaces">Reported to @Run.Surfaces.Count surfaces: @string.Join(", ", Run.Surfaces)</dd>
                    }

                    @if (!string.IsNullOrWhiteSpace(Run.ChangeKind))
                    {
                        <dt>Change</dt>
                        <dd>@Run.ChangeKind</dd>
                    }

                    @if (!string.IsNullOrWhiteSpace(Run.Schedule))
                    {
                        <dt>Schedule</dt>
                        <dd class="data-table__mono" data-testid="sessions-run-schedule">@Run.Schedule@(string.IsNullOrWhiteSpace(Run.Repository) ? "" : $" · {Run.Repository}")</dd>
                    }

                    @* What a sync sweep found, counted by verdict. The verdicts themselves
                       are read beside the chapters they are about, in the Devbook panes;
                       here they are the run's outcome in a line. *@
                    @if (Run.Verdicts.Count > 0)
                    {
                        <dt>Sync</dt>
                        <dd data-testid="sessions-run-verdicts">@VerdictSummary</dd>
                    }

                    @* A peak against a limit is a meter. Without a limit there is no track
                       to fill, and the figures stay words. *@
                    @if (Run.Context is { } context)
                    {
                        <dt>Context</dt>
                        <dd data-testid="sessions-run-context">
                            @if (context.PeakShare is { } share)
                            {
                                <MetricMeter Value="@context.PeakTokens"
                                             Max="@context.TokenLimit"
                                             AriaLabel="Context peak"
                                             Caption="@($"{MetricFormat.Percent(share, 0)} at peak · last sample {MetricFormat.Compact(context.CurrentTokens)}")"
                                             TestId="sessions-run-context-meter" />
                            }
                            else
                            {
                                @($"Peak {MetricFormat.Compact(context.PeakTokens)}; last sample {MetricFormat.Compact(context.CurrentTokens)}")
                            }
                        </dd>
                    }
                </div>

                @* A figure the run does not carry is left out rather than shown as
                   zero — the same rule the figure tiles already apply, and it has
                   to hold in both places or the details contradict the tiles above
                   them. It used to hold only above, which cost nothing while every run
                   came from a dashboard that measured consumption; a run this product
                   records carries the model it resolved and no consumption at all,
                   because those figures are counted by watching a session's own tool
                   calls and this product sees the call rather than the session. That
                   made "0 calls · 0 out · 0 in" the normal case instead of a rare
                   one. *@
                @if (Run.TokenUsage is { } usage && (usage.Total.ModelCalls > 0 || usage.Models.Count > 0))
                {
                    <div class="sessions-run__group">
                        <dt>Tokens</dt>
                        <dd data-testid="sessions-run-tokens">
                            @* The four kinds are one whole, so they are one bar — cheapest
                               first, as the component orders tokens — and the legend under it
                               is where each figure is read. The calls are a count of a
                               different thing and stay words. *@
                            @if (usage.Total.ModelCalls > 0)
                            {
                                <MetricBreakdownBar Label="@CallCount(usage.Total.ModelCalls)"
                                                    Parts="@Kinds(usage.Total)"
                                                    TestId="sessions-run-token-mix" />
                            }
                            @if (usage.SubAgent.ModelCalls > 0)
                            {
                                <MetricBreakdownBar Label="@($"Sub-agents · {CallCount(usage.SubAgent.ModelCalls)}")"
                                                    Parts="@Kinds(usage.SubAgent)"
                                                    TestId="sessions-run-subagent-mix" />
                            }
                            @if (usage.Models.Count > 0)
                            {
                                <span class="sessions-run__fact">Models: @string.Join(", ", usage.Models)</span>
                            }
                            @* Stages ranked by what they produced, as the tool calls beside
                               them are ranked by time: a stage's cache reads grow with every
                               turn it takes, so output is the figure that says where the
                               work went. The stage list above already gives the run order. *@
                            @if (usage.ByStage.Count > 0)
                            {
                                <MetricRanking Label="Output by stage"
                                               Items="@StageRanking(usage.ByStage)"
                                               FormatValue="@(tokens => $"{MetricFormat.Compact(tokens)} out")"
                                               TestId="sessions-run-stage-tokens" />
                            }
                        </dd>
                    </div>
                }

                @* Ranked by the time they took, each with its own bar: where the run's
                   time went is read off lengths, and the calls and failures behind it
                   are printed beside the figure. *@
                @if (Run.InsightsByCategory.Count > 0)
                {
                    <div class="sessions-run__group">
                        <dt>Tool calls</dt>
                        <dd>
                            <MetricRanking Items="@Ranking(Run.InsightsByCategory)"
                                           FormatValue="@(ms => Duration((long)ms))"
                                           TestId="sessions-run-insights" />
                        </dd>
                    </div>
                }

                @if (Run.InsightsByServer.Count > 0)
                {
                    <div class="sessions-run__group">
                        <dt>MCP servers</dt>
                        <dd>
                            <MetricRanking Items="@Ranking(Run.InsightsByServer)"
                                           FormatValue="@(ms => Duration((long)ms))"
                                           NameCssClass="data-table__mono"
                                           TestId="sessions-run-servers" />
                        </dd>
                    </div>
                }
            </dl>
        </FoldControl>
    </div>
</article>

@code {
    private readonly string _panelId = "sessions-run-" + Guid.NewGuid().ToString("N");
    private bool _expanded;
    private bool _details;

    [Parameter, EditorRequired]
    public DeliveryRun Run { get; set; } = default!;

    /// <summary>Folds the card to its header until opened: an earlier run on a row
    /// whose latest run is drawn whole above it.</summary>
    [Parameter]
    public bool Collapsible { get; set; }

    /// <summary>Draws a <see cref="Collapsible"/> card open when it first appears. The
    /// host's list is drawn afresh on returning from Delivery economics, every fold
    /// closed again; the run whose insight opened the page starts open so the action the
    /// focus returns to is on screen. Read once: the reader's own fold wins after.</summary>
    [Parameter]
    public bool StartExpanded { get; set; }

    protected override void OnInitialized() => _expanded = StartExpanded;

    /// <summary>How the host opens a Backlog entry, where it can. Without one a task
    /// reference is inert text, which is the honest rendering of a reference nobody
    /// on this surface can follow.</summary>
    [Parameter]
    public EventCallback<DeliveryRunReference> OnOpenTask { get; set; }

    /// <summary>How the host opens Delivery economics on this run's flow. With it the
    /// insight callout ends on a way into the run's flow; without it, it has none.</summary>
    [Parameter]
    public EventCallback<DeliveryRun> OnOpenEconomics { get; set; }

    /// <summary>The insight's action, handing the host this run; inert without a host.</summary>
    private EventCallback<string> OpenEconomics =>
        OnOpenEconomics.HasDelegate ? EventCallback.Factory.Create<string>(this, () => OnOpenEconomics.InvokeAsync(Run)) : default;

    /// <summary>What the header draws in place of the run's own references, where the
    /// row knows more than the run file does — a pull request the session linked and
    /// the run never recorded (<see cref="SessionRow.ReferencesFor"/>). Null draws the
    /// run's own.</summary>
    [Parameter]
    public IReadOnlyList<DeliveryRunReference>? References { get; set; }

    /// <summary>What each stage and each of its sub-agent calls cost, in stage order
    /// (<see cref="DeliveryRunCosts"/>), or null where the host worked none out — the
    /// stage rows then show no cost, never a zero.</summary>
    [Parameter]
    public IReadOnlyList<DeliveryRunStageCost>? Costs { get; set; }

    /// <summary>The run's costs against its usual (<see cref="DeliveryRunBaselines"/>),
    /// or null where the host compared none — the stage rows then show no share or
    /// ratio, and there is no insight.</summary>
    [Parameter]
    public DeliveryRunCostComparison? Comparison { get; set; }

    /// <summary>What the run cost: the sum of its stages', or null where none was
    /// priced.</summary>
    private CostFigure? Total => Comparison?.Total ?? (Costs is { } costs ? CostFigure.Sum(costs.Select(cost => cost.Stage)) : null);

    /// <summary>The run's share of the week, under its figures; nothing when null.</summary>
    [Parameter]
    public RenderFragment? Usage { get; set; }

    private IReadOnlyList<DeliveryRunReference> AllReferences => References ?? Run.References;

    /// <summary>The references drawn in the header: the work that lives elsewhere. The
    /// Backlog entry is not among them — the status badge is how this card reaches
    /// one, and a chip beside it would be a second control to the same place.</summary>
    private IEnumerable<DeliveryRunReference> Linked =>
        AllReferences.Where(reference => reference.Kind is not DeliveryRunReferenceKind.Task);

    /// <summary>The Backlog entry this run was started from, where it names one.</summary>
    private DeliveryRunReference? Entry =>
        AllReferences.FirstOrDefault(reference => reference.Kind is DeliveryRunReferenceKind.Task);

    /// <summary>One figure tile: its key for the test id, what it is called, its value,
    /// and what qualifies it.</summary>
    private sealed record Figure(string Key, string Label, string Value, string? Footnote = null, string? Title = null);

    /// <summary>
    /// The four figures a reader wants before reading the stages — stages done, what
    /// the run cost, the context peak and the tool calls. Each is left out rather than
    /// shown as zero when nothing answers it.
    /// </summary>
    private IReadOnlyList<Figure> Figures
    {
        get
        {
            var figures = new List<Figure>();

            if (Run.Stages.Count > 0)
            {
                var done = Run.Stages.Count(stage => IsDone(stage.Status));

                figures.Add(new Figure("stages", "Stages done", $"{done}/{Run.Stages.Count}", Title: $"{done} of {Run.Stages.Count} stages done"));
            }

            if (Total is { UsdMicros: > 0 } cost)
            {
                figures.Add(new Figure("cost", cost.Estimated ? "Est. cost" : "Cost", cost.Label, Title: DeliveryRunStages.CostTitle(cost)));
            }

            if (Run.Context is { PeakTokens: > 0 } context)
            {
                figures.Add(new Figure(
                    "context",
                    "Context peak",
                    MetricFormat.Compact(context.PeakTokens),
                    context.PeakShare is { } share ? $"{MetricFormat.Percent(share, 0)} of the limit" : null));
            }

            var calls = Run.InsightsByCategory.Sum(group => group.Count);

            if (calls > 0)
            {
                figures.Add(new Figure("calls", "Tool calls", calls.ToString("N0", CultureInfo.InvariantCulture)));
            }

            return figures;
        }
    }

    /// <summary>What the stage list's Configured and cost against "typical" mean, for
    /// this run's own flow, over the window the baselines are taken from.</summary>
    private string Footnote =>
        "Configured is the phase map the run resolved when it started: the team default in .devbook/config.json, then your overlay. "
        + "Cost is each stage's tokens priced by the session's own telemetry; "
        + $"\"vs typical\" compares with that stage's median over your last {DeliveryRunBaselines.Window} {Run.SkillId} runs.";

    /// <summary>The run's units counted by their verdict, largest count first:
    /// "12 units: 9 aligned · 2 code-ahead · 1 conflict".</summary>
    private string VerdictSummary
    {
        get
        {
            var counts = Run.Verdicts
                .GroupBy(unit => string.IsNullOrWhiteSpace(unit.Verdict) ? "no verdict" : unit.Verdict, StringComparer.OrdinalIgnoreCase)
                .OrderByDescending(group => group.Count())
                .ThenBy(group => group.Key, StringComparer.Ordinal)
                .Select(group => $"{group.Count()} {group.Key}");

            var units = Run.Verdicts.Count == 1 ? "1 unit" : $"{Run.Verdicts.Count} units";

            return $"{units}: {string.Join(" · ", counts)}";
        }
    }

    private static bool IsDone(string status) =>
        status.ToLowerInvariant() is "done" or "completed" or "success";

    /// <summary>The dashboards' status words, made readable. Anything unrecognised
    /// keeps its own spelling with the underscores spaced out, so a new word still
    /// says what the file said.</summary>
    internal static string StatusLabel(string status) => status.ToLowerInvariant() switch
    {
        "done" or "completed" or "success" => "Done",
        "in_progress" => "In progress",
        "" => "Unknown",
        var other => char.ToUpperInvariant(other[0]) + other[1..].Replace('_', ' ')
    };

    /// <summary>The dashboards' stage words as the library's step tones. A word none
    /// of them has written yet reads as not reached, which is the one claim that is
    /// never wrong about a stage nobody reported on.</summary>
    internal static FlowStepTone Tone(string status) => status.ToLowerInvariant() switch
    {
        "done" or "completed" or "success" => FlowStepTone.Done,
        "in_progress" or "active" or "running" => FlowStepTone.Active,
        "blocked" or "failed" or "error" => FlowStepTone.Blocked,
        "skipped" => FlowStepTone.Skipped,
        _ => FlowStepTone.Pending
    };

    /// <summary>A stage's evidence as checklist rows: the part's anchor, its
    /// outcome, the page's stem, and when the run ran — the row's quiet line reads
    /// "stem · date". A part named twice keeps its last report. No failed step: the
    /// engine's evidence carries none, and the run.json that does is the task's to
    /// read.</summary>
    internal static IReadOnlyList<ScenarioChecklistPart> EvidenceParts(DeliveryRunStage stage) =>
        [
            .. stage.Evidence
                .GroupBy(part => $"{part.Stem}#{part.Part}", StringComparer.OrdinalIgnoreCase)
                .Select(group => group.Last())
                .Select(part => new ScenarioChecklistPart(
                    string.IsNullOrWhiteSpace(part.Part) ? "(whole page)" : part.Part,
                    part.Outcome ?? "not-run",
                    part.Stem,
                    RanAt(part.RunAt),
                    string.IsNullOrWhiteSpace(part.Stem) || string.IsNullOrWhiteSpace(part.Part) ? null : $"{part.Stem}#{part.Part}"))
        ];

    /// <summary>A run's <c>ranAt</c> as the pane writes a time, or the text as sent
    /// when it is no time.</summary>
    private static string? RanAt(string? runAt) =>
        string.IsNullOrWhiteSpace(runAt)
            ? null
            : DateTimeOffset.TryParse(runAt, CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal, out var time)
                ? time.ToLocalTime().ToString("d MMM yyyy HH:mm", CultureInfo.InvariantCulture)
                : runAt;

    /// <summary>
    /// One of the run's references as the Integrations family draws one. No artifact
    /// state on it, because none was read: a chip would say this product had asked
    /// GitHub how the item is doing.
    /// </summary>
    internal static IntegrationLinkRef Link(DeliveryRunReference reference) =>
        new(
            reference.Url ?? reference.Label,
            reference.Kind is DeliveryRunReferenceKind.Task ? IntegrationProvider.None : IntegrationProvider.GitHub,
            reference.Kind switch
            {
                DeliveryRunReferenceKind.PullRequest => IntegrationLinkKind.PullRequest,
                DeliveryRunReferenceKind.Issue => IntegrationLinkKind.Issue,
                _ => IntegrationLinkKind.Other
            },
            reference.Label,
            reference.Title,
            reference.Url,
            Repository: string.IsNullOrWhiteSpace(reference.Repository)
                ? null
                : new IntegrationRepositoryRef(reference.Repository, reference.Repository));

    private static string Slug(DeliveryRunReferenceKind kind) => kind switch
    {
        DeliveryRunReferenceKind.PullRequest => "pull-request",
        DeliveryRunReferenceKind.Issue => "issue",
        _ => "task"
    };

    /// <summary>The four token counts in the order and the words this table uses for
    /// them everywhere — a session's in its own row.</summary>
    internal static string TokenFigures(long output, long input, long cacheRead, long cacheWrite) =>
        $"{MetricFormat.Compact(output)} out · {MetricFormat.Compact(input)} in · {MetricFormat.Compact(cacheRead)} cache read · {MetricFormat.Compact(cacheWrite)} cache write";

    private static string CallCount(long calls) =>
        calls == 1 ? "1 call" : $"{MetricFormat.Compact(calls)} calls";

    /// <summary>The four kinds as parts of one whole, cheapest first. A kind the run
    /// did not spend is dropped by the bar itself rather than drawn as a sliver.</summary>
    private static IReadOnlyList<MetricPart> Kinds(DeliveryRunTokens tokens) =>
    [
        new("Cache read", tokens.CacheReadTokens),
        new("Input", tokens.InputTokens),
        new("Cache write", tokens.CacheWriteTokens),
        new("Output", tokens.OutputTokens)
    ];

    /// <summary>A stage's output with its call count beside it, as a tool category's
    /// time is. Its other three counts stay off the row: in a column a quarter of the
    /// pane wide they squeezed the stage's own name to an ellipsis.</summary>
    private static IReadOnlyList<MetricRankItem> StageRanking(IEnumerable<DeliveryRunStageTokens> stages) =>
    [
        .. stages.Select(stage => new MetricRankItem(stage.StageName, stage.Total.OutputTokens, CallCount(stage.Total.ModelCalls)))
    ];

    /// <summary>A group of tool activity as a ranking row: the time it took is what
    /// ranks it, and the calls and failures ride beside that figure.</summary>
    private static IReadOnlyList<MetricRankItem> Ranking(IEnumerable<DeliveryRunInsightGroup> groups) =>
    [
        .. groups.Select(group => new MetricRankItem(group.Name, group.DurationMs, Calls(group)))
    ];

    private static string Calls(DeliveryRunInsightGroup group)
    {
        var calls = CallCount(group.Count);

        return group.Failed == 0 ? calls : $"{calls} · {group.Failed} failed";
    }

    /// <summary>Milliseconds as the two largest units that matter: hours and minutes
    /// for a stage, minutes and seconds for a short one, and seconds alone below a
    /// minute. A duration in milliseconds is a number nobody reads.</summary>
    internal static string Duration(long milliseconds)
    {
        var span = TimeSpan.FromMilliseconds(Math.Max(0, milliseconds));

        if (span.TotalHours >= 1) return $"{(int)span.TotalHours}h {span.Minutes}m";
        if (span.TotalMinutes >= 1) return $"{span.Minutes}m {span.Seconds}s";

        return span.TotalSeconds >= 1 ? $"{(int)span.TotalSeconds}s" : "<1s";
    }
}
