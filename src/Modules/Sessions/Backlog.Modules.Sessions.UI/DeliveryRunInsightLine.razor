@using global::Backlog.UI.Components.Icons

@*
    The run's insight, as a callout directly under its header: the run's cost against
    the median of the last 30 finished runs of the same flow as the headline, and the
    stage that explains most of the difference — with how often it was entered again
    and over how many review rounds — as the why (DeliveryRunBaselines). Absent while
    the run is under way or fewer than five earlier runs were priced.

    The callout carries the run's band, and a run from 1.5× its usual wears the warning
    edge: the one a reader should look at twice.

    Where the host can open Delivery economics, the callout ends on "Compare
    configurations for this flow", which opens it on the run's flow: the callout says
    this run is unusual, and the page says which configurations the flow's phases ran
    under and what each cost. The action wears the run's id, so the host can put the
    focus back on it when the page is left. With no insight there is no callout, and
    so no way in from here.
*@
@if (Insight is { } insight)
{
    <Callout Heading="@insight.Head"
             Tone="@(insight.Usual.Band is CostBand.Higher ? "warning" : null)"
             CssClass="sessions-run__insight"
             TestId="sessions-run-insight"
             ActionLabel="@(CanOpen ? "Compare configurations for this flow" : null)"
             OnAction="@(CanOpen ? EventCallback.Factory.Create(this, () => OnOpen.InvokeAsync(Flow)) : default)"
             ActionId="@Id"
             ActionTitle="@($"Opens Delivery economics for {Flow}.")"
             ActionTestId="sessions-run-insight-action"
             title="@insight.Usual.Title"
             data-band="@DeliveryRunStageUsual.BandSlug(insight.Usual.Band)"
             Icon="@Bulb"
             ChildContent="@WhyOf(insight)" />
}

@code {
    [Parameter]
    public DeliveryRunCostInsight? Insight { get; set; }

    /// <summary>The run's flow, which the page opens on.</summary>
    [Parameter]
    public string? Flow { get; set; }

    /// <summary>How the host opens Delivery economics on a flow. Without it the
    /// callout has no action.</summary>
    [Parameter]
    public EventCallback<string> OnOpen { get; set; }

    /// <summary>The action's id, so the host can put the focus back on it when the
    /// page it opened is left.</summary>
    [Parameter]
    public string? Id { get; set; }

    private RenderFragment Bulb => @<LightbulbIcon Size="18" />;

    /// <summary>The why under the headline, or nothing for a run no stage explains.</summary>
    private static RenderFragment? WhyOf(DeliveryRunCostInsight insight) =>
        insight.Why is { } why ? builder => builder.AddContent(0, why) : null;

    private bool CanOpen => OnOpen.HasDelegate && !string.IsNullOrWhiteSpace(Flow);

    /// <summary>The id the callout's action wears for one run: unique per run file,
    /// and made of characters an id may hold.</summary>
    public static string DomId(DeliveryRun run) =>
        "sessions-run-insight-" + string.Concat($"{run.Dashboard}-{run.Worktree}-{run.Id}".Select(c => char.IsAsciiLetterOrDigit(c) || c is '-' or '_' ? c : '-'));
}
