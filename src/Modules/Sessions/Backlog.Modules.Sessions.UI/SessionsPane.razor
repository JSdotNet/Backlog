    protected override async Task OnInitializedAsync()
    {
        _keeper = Services.GetService<ISessionRecordKeeper>();
        _requestStore = Services.GetService<IClaudeApiRequestStore>();
        _priceStore = Services.GetService<IModelPriceStore>();
        _records = Services.GetService<IAgentSessionRecordStore>();
        _clock = Services.GetService<TimeProvider>() ?? TimeProvider.System;

        await RefreshAsync();

        // Every opening amends the records of the sessions that moved since the last
        // one, so a session is written down while its transcript is still there to
        // read. Not awaited by the list: the records are what a later reading falls
        // back to, not what this one shows.
        if (_keeper is not null) _ = KeepRecordsAsync(_keeper);
    }

    private static async Task KeepRecordsAsync(ISessionRecordKeeper keeper)
    {
        try
        {
            await keeper.UpdateAsync(everything: false);
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException)
        {
            // The next opening tries again; the list is unaffected either way.
        }
    }

    private ISessionRecordKeeper? _keeper;

    private bool _updating;

    private string? _recordsMessage;

    /// <summary>The update button: every session the files still hold, amended into
    /// its record, then the list read again.</summary>
    private async Task UpdateRecordsAsync()
    {
        if (_keeper is null) return;

        _updating = true;
        _recordsMessage = null;

        try
        {
            var update = await _keeper.UpdateAsync(everything: true);

            _recordsMessage = RecordsMessage(update);
        }
        finally
        {
            _updating = false;
        }

        await RefreshAsync();
    }

    internal static string RecordsMessage(SessionRecordUpdate update)
    {
        var what = update.Started + update.Amended == 0
            ? "No session files to read, so every record is as it was."
            : $"Updated {update.Amended} session record{(update.Amended == 1 ? "" : "s")} and started {update.Started}.";

        return update.Published
            ? $"{what} Sync will send every record again on its next cycle."
            : what;
    }

    private async Task RefreshAsync()
    {
        _loading = true;

        try
        {
            // Both readings in flight together: neither needs the other's answer
            // until both are in.
            var sessions = Sessions.GetSessionsAsync();
            var runs = Runs.GetRunsAsync();

            _catalog = await sessions;
            _runs = await runs;
            await ReadPricesAsync();
            _rows = SessionRows.Of(_catalog.Sessions, _runs.Runs);
            _read = true;
            _readAt = DateTimeOffset.UtcNow;

            // A re-read can lose the environment the list was narrowed to. Left in
            // place, the select would read "All machines" over a list narrowed to
            // nothing; widening back out is the honest reset.
            if (_environmentId is not null && Environments.All(environment => environment.Id != _environmentId))
            {
                _environmentId = null;
            }

            // A fresh reading may hold newer verdicts too, newer requests, and prices
            // somebody changed in Settings since.
            _statuses.Clear();
            _asked.Clear();
            _costs.Clear();
            _costAsked.Clear();
            _earlierCosts.Clear();
            _shares.Clear();
            _weekly = null;
            _statusGeneration++;
        }
        finally
        {
            _loading = false;
        }

        RevealFocused();
    }

    /// <summary>The <see cref="FocusSessionId"/> last acted on, so re-rendering with
    /// the same one does not widen the filters the reader has since narrowed.</summary>
    private string? _focusApplied;

    private bool _focusPending;

    private bool _focusMissing;

    /// <summary>Whether the list has been read once.</summary>
    private bool _read;

    protected override void OnParametersSet()
    {
        if (string.Equals(FocusSessionId, _focusApplied, StringComparison.OrdinalIgnoreCase)) return;

        _focusApplied = FocusSessionId;
        _focusMissing = false;
        _focusPending = !string.IsNullOrWhiteSpace(FocusSessionId);

        RevealFocused();
    }

    /// <summary>A row is the focused session when it is that session, or when one of
    /// its runs was driven by it.</summary>
    internal bool IsFocused(SessionRow row) =>
        !string.IsNullOrWhiteSpace(FocusSessionId)
        && (string.Equals(row.Session?.Id, FocusSessionId, StringComparison.OrdinalIgnoreCase)
            || row.Runs.Any(run => run.SessionIds.Contains(FocusSessionId, StringComparer.OrdinalIgnoreCase)));

    private void RevealFocused()
    {
        if (!_focusPending || !_read) return;

        if (ScopedSessions.FirstOrDefault(IsFocused) is not { } focused)
        {
            _focusMissing = true;
            _focusPending = false;

            return;
        }

        // The session asked for is the one the panel shows.
        _selectedKey = focused.Key;

        if (!Visible.Any(IsFocused))
        {
            _view = AgentSessionView.All;
            _withRuns = false;
            _environmentId = null;
        }
    }

    private string? FocusMessage => _focusMissing && FocusSessionId is { } id
        ? _rows.Any(IsFocused)
            ? $"Session {id} is outside the repositories the header is scoped to."
            : $"This PC has no record of session {id}."
        : null;

    private static string RowDomId(SessionRow row) =>
        "sessions-row-" + string.Concat(row.Key.Select(c => char.IsAsciiLetterOrDigit(c) || c is '-' or '_' ? c : '-'));

    private IReadOnlyDictionary<string, object>? FocusAttributes(SessionRow row) =>
        IsFocused(row)
            ? new Dictionary<string, object>
            {
                ["id"] = RowDomId(row),
                ["aria-current"] = "true",
                ["data-focused"] = "true",
            }
            : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        AskAboutPullRequests();
        AskAboutCosts();

        if (!_focusPending || _loading) return;

        var row = Visible.FirstOrDefault(IsFocused);
        if (row is null) return;

        _focusPending = false;

        try
        {
            await JS.InvokeVoidAsync("backlogFocus", RowDomId(row));
        }
        catch (JSDisconnectedException)
        {
            // The pane went with its circuit; there is nothing left to focus.
        }
        catch (InvalidOperationException)
        {
            // Prerendering, or a test host with no JavaScript: the row is still
            // selected and marked, which is the part a reader sees.
        }
    }

    private void ChooseView(AgentSessionView view) => _view = view;

    private void ChooseGrouping(string? slug) =>
        _grouping = Groupings.FirstOrDefault(grouping => Slug(grouping) == slug, AgentSessionGrouping.When);

    private void ChooseEnvironment(string? id) => _environmentId = string.IsNullOrWhiteSpace(id) ? null : id;

    private void Select(SessionRow row) => _selectedKey = row.Key;

    /// <summary>
    /// The row the panel shows: the one the reader picked while the filters still
    /// admit it, else the first row the list draws. Never a row the list does not
    /// show — a panel about a session the filters hid would contradict the list.
    /// </summary>
    private SessionRow? Selected => SelectedOf(Sections);

    private SessionRow? SelectedOf(IReadOnlyList<AgentSessionGroup> sections)
    {
        var drawn = sections.SelectMany(section => section.Rows).ToList();

        return drawn.FirstOrDefault(row => row.Key == _selectedKey) ?? drawn.FirstOrDefault();
    }

    /// <summary>The key of the row the panel shows in the render under way.</summary>
    private string? _shownKey;

    private bool IsSelected(SessionRow row) => _shownKey == row.Key;

    /// <summary>Every environment the reading holds a record of, off the whole catalog
    /// and not off the view, so switching Show does not take a chosen option away.</summary>
    private IReadOnlyList<AgentSessionEnvironment> Environments => AgentSessionEnvironments.Of(_rows);

    private IReadOnlyList<SelectorOption> EnvironmentOptions =>
        [.. Environments.Select(environment => new SelectorOption(environment.Id, environment.Name))];

    private string? EnvironmentName =>
        _environmentId is null ? null : Environments.FirstOrDefault(environment => environment.Id == _environmentId)?.Name;

    /// <summary>Whether the header has narrowed the list to some repositories.</summary>
    private bool Scoped => RepositoryScope.Count > 0;

    private string ScopeLabel => string.Join(", ", RepositoryScope);

    /// <summary>A row in the scope: one whose repository — recorded, resolved, or named
    /// by a run — the shell resolves to a scoped alias. With none, the row is out.</summary>
    private bool InScope(SessionRow row) =>
        !Scoped || row.Repositories.Any(Scopes);

    private bool Scopes(string? repository) =>
        RepositoryAlias?.Invoke(repository) is { } alias
        && RepositoryScope.Contains(alias, StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<SessionRow> ScopedSessions =>
        Scoped ? [.. _rows.Where(InScope)] : _rows;

    /// <summary>The rows every filter but Show admits: the scope, the machine and the
    /// runs toggle. What Live's tally counts the live rows of.</summary>
    private IReadOnlyList<SessionRow> Narrowed
    {
        get
        {
            var rows = AgentSessionEnvironments.On(ScopedSessions, _environmentId);

            return _withRuns ? [.. rows.Where(row => row.Runs.Count > 0)] : rows;
        }
    }

    /// <summary>The rows the filters admit, before any grouping. Neither narrowing
    /// reorders, and the grouping never sees what any of them left out.</summary>
    private IReadOnlyList<SessionRow> Visible => AgentSessionViews.Of(Narrowed, _view);

    /// <summary>How many rows Live would show under the other filters.</summary>
    private int LiveTally => AgentSessionViews.Of(Narrowed, AgentSessionView.Live).Count;

    /// <summary>How many sessions the chosen environment has a record of, whatever the
    /// view. The number the empty state offers as the way back out.</summary>
    private int OnEnvironment => AgentSessionEnvironments.On(ScopedSessions, _environmentId).Count;

    /// <summary>The sections, from the module's own grouping, against the reading's
    /// clock and the reader's own time zone.</summary>
    private IReadOnlyList<AgentSessionGroup> Sections =>
        AgentSessionGroups.Of(Visible, _grouping, _readAt, TimeZoneInfo.Local);

    /// <summary>What the reading found. The subtitle's number and the badge's total.</summary>
    private int Total => _rows.Count;

    /// <summary>What the filters kept.</summary>
    private int Shown => Visible.Count;

    /// <summary>
    /// Both numbers whenever the filters hide some, one when they hide none — never
    /// "2 of 2". The noun agrees with the total, the number it is the noun for.
    /// </summary>
    private string CountLabel => Shown == Total
        ? (Total == 1 ? $"1 {Noun}" : $"{Total} {Nouns}")
        : (Total == 1 ? $"{Shown} of 1 {Noun}" : $"{Shown} of {Total} {Nouns}");

    /// <summary>"Session" while every row is one, and "session or run" once a run the
    /// list holds no session for is a row of its own.</summary>
    private bool AnyRunOnly => _rows.Any(row => row.RunOnly);

    private string Noun => AnyRunOnly ? "session or run" : "session";

    private string Nouns => AnyRunOnly ? "sessions and runs" : "sessions";

    /// <summary>
    /// The reading's own line — both numbers when the cap took something, only the
    /// honest claim when it did not — plus the runs and schedules that are rows of
    /// their own, and while the header has narrowed the list, what a session is in by.
    /// It describes the reading and not the filters, which is the badge's job.
    /// </summary>
    private string Subtitle
    {
        get
        {
            var reading = _catalog.Capped
                ? $"The {_catalog.Sessions.Count} most recent of {_catalog.Discovered} sessions this PC has a record of, most recently active first."
                : "The sessions this PC has a record of, most recently active first.";

            var runs = _rows.Count(row => row.RunOnly && row.Schedule is null);

            if (runs > 0)
            {
                reading += runs == 1
                    ? " And 1 delivery run no listed session drove, as a row of its own."
                    : $" And {runs} delivery runs no listed session drove, as rows of their own.";
            }

            var schedules = _rows.Count(row => row.Schedule is not null);

            if (schedules > 0)
            {
                reading += schedules == 1
                    ? " And 1 schedule's unattended runs, as one row."
                    : $" And {schedules} schedules' unattended runs, a row per schedule and repository.";
            }

            return Scoped
                ? $"{reading} Narrowed to {ScopeLabel}: a session is in by the repository its agent recorded, or by its working folder lying inside a registered clone; one with neither is left out."
                : reading;
        }
    }

    /// <summary>Nothing on this machine, or nothing these filters admit — two different
    /// facts.</summary>
    private string EmptyMessage => Total == 0
        ? "No sessions on this PC."
        : _withRuns && Shown == 0
            ? "No delivery runs here."
        : Scoped && ScopedSessions.Count == 0
            ? $"No sessions in {ScopeLabel}."
            : EnvironmentName is null
                ? "No live sessions right now."
                : $"No live sessions on {EnvironmentName} right now.";

    /// <summary>Names which states Live keeps and how many rows are on the other side,
    /// and the way back out.</summary>
    private string EmptyDescription => Total == 0
        ? "Neither Claude nor Copilot has left a session record in this profile yet."
        : _withRuns && Shown == 0
            ? "None of the rows this view admits carries a run an orchestration dashboard recorded. Turn off With delivery runs to see them all."
        : Scoped && ScopedSessions.Count == 0
            ? "A session is matched to the scope by the repository its agent recorded, or by its working folder lying inside a clone registered for it — Claude records none, so its sessions need the clone. Clear the repository scope in the header to see every session."
        : EnvironmentName is null
            ? Scoped
                ? $"Nothing in {ScopeLabel} is running or stalled. Choose {AllLabel} to see the {SessionCount(ScopedSessions.Count)} recorded there."
                : $"Nothing is running or stalled on this PC. Choose {AllLabel} to see the {SessionCount(Total)} it has a record of."
            : $"Nothing on {EnvironmentName} is running or stalled. Choose {AllLabel} to see the {SessionCount(OnEnvironment)} recorded there.";

    private static string SessionCount(int count) => count == 1 ? "1 session" : $"{count} sessions";

    /// <summary>The other view's own word, read from the module: the sentence names the
    /// button the reader has to press.</summary>
    private static string AllLabel => AgentSessionViews.Label(AgentSessionView.All);

    /// <summary>What could not be read, across both readings.</summary>
    private IReadOnlyList<string> Unreadable => [.. _catalog.Unreadable, .. _runs.Unreadable];

    private string UnreadableMessage =>
        $"Could not read {string.Join(" or ", Unreadable)} on this PC. Everything else below is complete.";

    private static string GroupingLabel(AgentSessionGrouping grouping) => grouping switch
    {
        AgentSessionGrouping.Repository => "Repository",
        AgentSessionGrouping.Environment => "Machine",
        _ => "When"
    };

    private static string Slug(AgentSessionView view) => view switch
    {
        AgentSessionView.All => "all",
        _ => "live"
    };

    private static string Slug(AgentSessionGrouping grouping) => grouping switch
    {
        AgentSessionGrouping.Repository => "repository",
        AgentSessionGrouping.Environment => "machine",
        _ => "when"
    };

    private static IntegrationProvider Provider(AgentSessionKind kind) => kind switch
    {
        AgentSessionKind.Copilot => IntegrationProvider.Copilot,
        _ => IntegrationProvider.Claude
    };

    /// <summary>The three states this context can evidence, in the control library's
    /// vocabulary — the mapping is this narrow because nothing else is derivable from
    /// a file on disk.</summary>
    private static IntegrationSessionState State(AgentSessionState state) => state switch
    {
        AgentSessionState.Running => IntegrationSessionState.Running,
        AgentSessionState.Stalled => IntegrationSessionState.Stalled,
        _ => IntegrationSessionState.Finished
    };

    private static string Or(string? value) => string.IsNullOrWhiteSpace(value) ? Missing : value;

    /// <summary>Local time: a person comparing a session against their own morning is
    /// not thinking in UTC.</summary>
    private static string Moment(DateTimeOffset? moment) =>
        moment is null ? Missing : moment.Value.ToLocalTime().ToString("ddd d MMM HH:mm");

    /// <summary>How long ago, coarsely; the exact timestamp is in the title.</summary>
    private string Ago(DateTimeOffset moment)
    {
        var elapsed = _readAt - moment;

        if (elapsed < TimeSpan.FromMinutes(1)) return "just now";
        if (elapsed < TimeSpan.FromHours(1)) return Plural((int)elapsed.TotalMinutes, "minute");
        if (elapsed < TimeSpan.FromDays(1)) return Plural((int)elapsed.TotalHours, "hour");

        return Plural((int)elapsed.TotalDays, "day");
    }

    private static string Plural(int count, string unit) =>
        count == 1 ? $"1 {unit} ago" : $"{count} {unit}s ago";
}
