    private string Heading => _view is AgentSessionView.Live ? "Running now" : "Claude and Copilot";

    /// <summary>What a run's line draws: the row's references for the run, plus the
    /// entry its session was linked to where the run names no entry of its own.</summary>
    private IReadOnlyList<DeliveryRunReference> ReferencesOf(SessionRow row, DeliveryRun run)
    {
        var references = row.ReferencesFor(run);

        if (SessionTask is null || row.Session is not { } session) return references;

        if (references.Any(reference => reference.Kind is DeliveryRunReferenceKind.Task)) return references;

        return SessionTask(session.Id) is { } task ? [.. references, task] : references;
    }

    /// <summary>Every reference the row leads to, one per address.</summary>
    private IReadOnlyList<DeliveryRunReference> ReferencesOf(SessionRow row)
    {
        IEnumerable<DeliveryRunReference> references = row.Runs.Count > 0
            ? row.Runs.SelectMany(run => ReferencesOf(row, run))
            : row.PullRequests
                .Select(pr => new DeliveryRunReference(
                    DeliveryRunReferenceKind.PullRequest,
                    $"PR #{pr.Number}",
                    Title: null,
                    pr.Url,
                    string.IsNullOrWhiteSpace(pr.Repository) ? null : pr.Repository))
                .Concat(SessionTask is not null && row.Session is { } session && SessionTask(session.Id) is { } task ? [task] : []);

        return [.. references.DistinctBy(reference => (reference.Kind, reference.EntryId, reference.Url ?? reference.Label))];
    }

    private IReadOnlyList<DeliveryRunReference> PullRequestsOf(SessionRow row) =>
        [.. ReferencesOf(row).Where(reference => reference.Kind is DeliveryRunReferenceKind.PullRequest)];

    /// <summary>The Backlog entry the row was worked for: the first run that names one,
    /// else the one its session was linked to.</summary>
    private DeliveryRunReference? TaskOf(SessionRow row) =>
        ReferencesOf(row).FirstOrDefault(reference => reference.Kind is DeliveryRunReferenceKind.Task);

    private static IntegrationLinkRef TaskLink(DeliveryRunReference task) =>
        new(task.EntryId?.ToString() ?? task.Label, IntegrationProvider.None, IntegrationLinkKind.Other, task.Label, Title: $"Open {task.Label} in the task list");

    /// <summary>Inert where the shell wired no way to open an entry.</summary>
    private EventCallback<IntegrationLinkRef> TaskOpener(DeliveryRunReference task) =>
        OnOpenTask.HasDelegate
            ? EventCallback.Factory.Create<IntegrationLinkRef>(this, () => OnOpenTask.InvokeAsync(task))
            : default;

    /// <summary>The verdicts read so far, by the pull request's address, and the
    /// addresses asked about — so a row shown twice asks once.</summary>
    private readonly Dictionary<string, SessionPullRequestStatus?> _statuses = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _asked = new(StringComparer.OrdinalIgnoreCase);
    private bool _disposed;

    /// <summary>Which reading the verdicts belong to. A refresh starts a new one, so an
    /// answer still out for the last reading is dropped rather than kept as this
    /// one's.</summary>
    private int _statusGeneration;

    private static string PullKey(DeliveryRunReference pull) => $"{pull.Repository}|{pull.Url ?? pull.Label}";

    private SessionPullRequestStatus? StatusOf(DeliveryRunReference pull) =>
        _statuses.TryGetValue(PullKey(pull), out var status) ? status : null;

    private string? PullTitle(DeliveryRunReference pull) =>
        !string.IsNullOrWhiteSpace(pull.Title) ? pull.Title : StatusOf(pull)?.Title;

    /// <summary>Asks the host about the selected row's pull requests it has not asked
    /// about yet. Each answer redraws the panel as it lands; one that fails leaves
    /// that card without a chip rather than failing the pane.</summary>
    private void AskAboutPullRequests()
    {
        if (PullRequestStatus is not { } read || Selected is not { } row) return;

        foreach (var pull in PullRequestsOf(row))
        {
            var key = PullKey(pull);
            if (!_asked.Add(key)) continue;

            _ = AskAsync(read, pull, key, _statusGeneration);
        }
    }

    private async Task AskAsync(Func<DeliveryRunReference, Task<SessionPullRequestStatus?>> read, DeliveryRunReference pull, string key, int generation)
    {
        SessionPullRequestStatus? status;

        try
        {
            status = await read(pull);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            status = null;
        }

        if (_disposed || generation != _statusGeneration) return;

        _statuses[key] = status;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => _disposed = true;

    /// <summary>What one row cost, worked out once its requests are in.</summary>
    private sealed record RowCosts(
        CostFigure? Session,
        IReadOnlyDictionary<DeliveryRun, IReadOnlyList<DeliveryRunStageCost>> Stages,
        IReadOnlyDictionary<DeliveryRun, DeliveryRunCostComparison> Comparisons)
    {
        public IReadOnlyList<DeliveryRunStageCost>? StagesOf(DeliveryRun run) => Stages.TryGetValue(run, out var costs) ? costs : null;

        public DeliveryRunCostComparison? ComparisonOf(DeliveryRun run) => Comparisons.TryGetValue(run, out var comparison) ? comparison : null;
    }

    /// <summary>What part of the week one row and each of its runs make up.</summary>
    private sealed record RowShares(WeeklyUsage Usage, UsageShare? Session, IReadOnlyDictionary<DeliveryRun, UsageShare?> Runs)
    {
        public UsageShare? Of(DeliveryRun run) => Runs.TryGetValue(run, out var share) ? share : null;
    }

    /// <summary>How far back limit refusals are read to place the week and size the
    /// limits: a refusal older than this sizes nothing any more.</summary>
    private static readonly TimeSpan LimitHitHorizon = TimeSpan.FromDays(28);

    /// <summary>Where the limit refusals come from: this machine's session records,
    /// which hold each transcript already folded. Never the activity port, which
    /// reads the transcripts' bodies — the pane may not pay that to draw a figure.</summary>
    private IAgentSessionRecordStore? _records;

    private TimeProvider _clock = TimeProvider.System;

    /// <summary>The week's total and limits, read once per refresh over every stored
    /// request; cleared with the costs.</summary>
    private Task<WeeklyUsage?>? _weekly;

    private readonly Dictionary<string, RowShares> _shares = new(StringComparer.Ordinal);

    private RowShares? SharesOf(SessionRow row) => _shares.TryGetValue(row.Key, out var shares) ? shares : null;

    private Task<WeeklyUsage?> WeeklyAsync() => _weekly ??= ReadWeeklyAsync();

    /// <summary>Every stored request and every limit refusal inside the horizon. A
    /// store that fails shows no share; records that fail to read only lose the
    /// refusals, so the week falls back to the trailing seven days.</summary>
    private async Task<WeeklyUsage?> ReadWeeklyAsync()
    {
        if (_requestStore is not { } store) return null;

        var now = _clock.GetUtcNow();
        IReadOnlyList<ClaudeApiRequest> requests;

        try
        {
            // Only the limit horizon and the week before its oldest refusal can matter.
            var from = now - LimitHitHorizon - UsageWeek.Length;
            requests = [.. (await store.ListAsync()).Where(request => request.Timestamp >= from)];
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            return null;
        }

        IReadOnlyList<AgentLimitHit> hits = [];

        if (_records is { } records)
        {
            try
            {
                var since = now - LimitHitHorizon;
                var held = await Task.Run(records.All);
                hits = [.. held.SelectMany(record => record.Activity?.LimitHits ?? []).Where(hit => hit.At >= since)];
            }
            catch (Exception exception) when (exception is not OperationCanceledException)
            {
                hits = [];
            }
        }

        return WeeklyUsage.Of(requests, hits, now);
    }

    private IClaudeApiRequestStore? _requestStore;

    private IModelPriceStore? _priceStore;

    private ModelPriceTable _prices = ModelPriceTable.Empty;

    /// <summary>Each row's costs, by row key, once worked out; cleared by a refresh,
    /// which also reads the prices again.</summary>
    private readonly Dictionary<string, RowCosts> _costs = new(StringComparer.Ordinal);

    private readonly HashSet<string> _costAsked = new(StringComparer.Ordinal);

    private RowCosts? CostsOf(SessionRow row) => _costs.TryGetValue(row.Key, out var costs) ? costs : null;

    /// <summary>The sessions whose requests a row's costs are read from: its own, and
    /// every one its runs name.</summary>
    private static IReadOnlyList<string> CostSessionsOf(SessionRow row) =>
        [.. new[] { row.Session?.Id }.Concat(row.Runs.SelectMany(run => run.SessionIds)).OfType<string>().Where(id => id.Length > 0).Distinct(StringComparer.Ordinal)];

    /// <summary>Works out the selected row's costs, reading its sessions' requests from
    /// the store where the host keeps one. A store that fails leaves the row on the
    /// estimate alone rather than failing the pane.</summary>
    private void AskAboutCosts()
    {
        if (Selected is not { } row || !_costAsked.Add(row.Key)) return;

        _ = WorkOutCostsAsync(row, _statusGeneration);
    }

    private async Task WorkOutCostsAsync(SessionRow row, int generation)
    {
        var requests = new List<ClaudeApiRequest>();

        if (_requestStore is { } store)
        {
            try
            {
                foreach (var id in CostSessionsOf(row)) requests.AddRange(await store.ListAsync(id));
            }
            catch (Exception exception) when (exception is not OperationCanceledException)
            {
                requests.Clear();
            }
        }

        if (_disposed || generation != _statusGeneration) return;

        var sessionId = row.Session?.Id ?? row.Runs.SelectMany(run => run.SessionIds).FirstOrDefault();
        var stages = new Dictionary<DeliveryRun, IReadOnlyList<DeliveryRunStageCost>>(ReferenceEqualityComparer.Instance);
        var comparisons = new Dictionary<DeliveryRun, DeliveryRunCostComparison>(ReferenceEqualityComparer.Instance);
        CostFigure? session;

        try
        {
            foreach (var run in row.Runs)
            {
                stages[run] = DeliveryRunCosts.Of(run, requests, _prices, sessionId, row.Model);
            }

            session = DeliveryRunCosts.Session(sessionId, requests, row.Runs, _prices, row.Model, row.Session?.ModelUsage);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            // A run file shaped in a way the attribution did not expect costs that row
            // its figures, not the pane: the row shows no cost, which is the honest
            // answer to a question nothing could answer.
            stages.Clear();
            session = null;
        }

        // The row's own figures first: pricing the earlier runs its comparison needs
        // reads up to thirty runs' requests, and the row's cost should not wait on them.
        _costs[row.Key] = new RowCosts(session, stages, new Dictionary<DeliveryRun, DeliveryRunCostComparison>());

        // The costs are drawn before the week is read: the week reads every request,
        // and the row's own figures should not wait on it.
        await InvokeAsync(StateHasChanged);

        WeeklyUsage? weekly;

        try
        {
            weekly = await WeeklyAsync();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            weekly = null;
        }

        if (weekly is not null && !_disposed && generation == _statusGeneration)
        {
            var shares = new Dictionary<DeliveryRun, UsageShare?>(ReferenceEqualityComparer.Instance);

            try
            {
                foreach (var run in row.Runs) shares[run] = weekly.ShareOfRun(run, requests, sessionId);

                _shares[row.Key] = new RowShares(weekly, weekly.ShareOfSession(sessionId, requests), shares);
            }
            catch (Exception exception) when (exception is not OperationCanceledException)
            {
                // The same honest answer as the costs above: a run the matching could
                // not read shows no share rather than failing the pane.
                _shares.Remove(row.Key);
            }
        }

        await InvokeAsync(StateHasChanged);

        foreach (var (run, costs) in stages)
        {
            if (await CompareAsync(run, costs, generation) is { } comparison) comparisons[run] = comparison;

            if (_disposed || generation != _statusGeneration) return;
        }

        if (comparisons.Count == 0) return;

        _costs[row.Key] = new RowCosts(session, stages, comparisons);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>What each earlier run cost, by run, once asked: the baseline of a flow
    /// is the same thirty runs for every run that follows them, so each is priced once
    /// per refresh rather than once per row — the task kept, so two rows asking at once
    /// share one pricing.</summary>
    private readonly Dictionary<DeliveryRun, Task<IReadOnlyList<DeliveryRunStageCost>>> _earlierCosts = new(ReferenceEqualityComparer.Instance);

    /// <summary>
    /// A run's costs against its usual: the last thirty finished runs of its flow
    /// (<see cref="DeliveryRunBaselines.Earlier"/>), each priced the way its own row
    /// would be — its sessions' reported requests, else its tokens at the Settings
    /// prices. Null where the comparison could not be worked out, which leaves the run
    /// with its costs and nothing to compare them with.
    /// </summary>
    private async Task<DeliveryRunCostComparison?> CompareAsync(DeliveryRun run, IReadOnlyList<DeliveryRunStageCost> costs, int generation)
    {
        try
        {
            var earlier = DeliveryRunBaselines.Earlier(run, _runs.Runs);
            var priced = new List<PricedDeliveryRun>(earlier.Count);

            foreach (var other in earlier)
            {
                if (!_earlierCosts.TryGetValue(other, out var pricing))
                {
                    pricing = PriceAsync(other);
                    _earlierCosts[other] = pricing;
                }

                var otherCosts = await pricing;

                // A refresh cleared the cache and re-read the runs while this waited;
                // the comparison it was for is no longer on screen.
                if (_disposed || generation != _statusGeneration) return null;

                priced.Add(new PricedDeliveryRun(other, otherCosts));
            }

            return DeliveryRunBaselines.Compare(run, costs, priced);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            return null;
        }
    }

    /// <summary>What an earlier run's stages cost, read from the row that holds it.</summary>
    private async Task<IReadOnlyList<DeliveryRunStageCost>> PriceAsync(DeliveryRun run)
    {
        var owner = _rows.FirstOrDefault(row => row.Runs.Any(candidate => ReferenceEquals(candidate, run)));
        var sessionId = owner?.Session?.Id ?? run.SessionIds.FirstOrDefault();
        var ids = run.SessionIds.Count > 0 ? run.SessionIds : sessionId is null ? [] : [sessionId];
        var requests = new List<ClaudeApiRequest>();

        if (_requestStore is { } store)
        {
            try
            {
                foreach (var id in ids.Distinct(StringComparer.Ordinal)) requests.AddRange(await store.ListAsync(id));
            }
            catch (Exception exception) when (exception is not OperationCanceledException)
            {
                requests.Clear();
            }
        }

        return DeliveryRunCosts.Of(run, requests, _prices, sessionId, owner?.Model);
    }

    private async Task ReadPricesAsync()
    {
        if (_priceStore is not { } store) return;

        try
        {
            _prices = await store.GetAsync();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _prices = ModelPriceTable.Empty;
        }
    }

