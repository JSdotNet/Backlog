@using global::Backlog.UI.Components.Metrics
@using global::Backlog.UI.Components.Devbook

@*
    How each stage of one delivery run ran, as a list: the legend above it, then one
    row per stage with its mode chip, the model it ran on, its effort chip and at most
    one mark — ≠ where it ran other than as configured, ? where its mode was inferred.
    .devbook/design/effort-and-mode-chips.md is the drawing's rule; what each value
    means is DeliveryRunStageResolution's, the port of the delivery-run-view plugin's
    stage resolution, so this list and that pane say the same thing about a run.

    Each row is one line on a fixed grid, so the columns line up down the list: the
    status dot, the name with its rounds where it took more than one (and what its
    latest pass found, and its scenario evidence, quietly after them), the mode chip,
    the model with its effort chip and mark, the time it took or the word for where
    it stands ("Failed", "Not yet"), its cost, its cost against its usual, and the
    chevron. The dot is decorative; the word beside it carries the state.

    One panel open at a time. Each row is the library's fold, and opening one closes
    the one that was open: the panel is long, and two of them open would push the
    second stage a reader asked about off the card. The panel says in words what the
    row's chips and mark summarise — what ran, what was configured and where from,
    the skill, the servers, the skills run around it, what its passes found — then
    why a stage is marked, as a callout with the mark as its glyph, and every
    sub-agent call the stage made, as a table.

    Cost, where the host worked one out (DeliveryRunCosts): on the row, followed by
    its share of the run and its ratio to its usual (DeliveryRunStageUsual), and
    under each sub-agent call's tokens. Reported by Claude Code, or estimated from
    tokens at the Settings prices and marked so; with neither, nothing is drawn —
    never a zero.

    What the pass found (Stage Counts): the round rides on the name, and Review's open
    blockers and Verify's defects follow it quietly, as the latest pass reported them;
    the panel's Found line adds the run's cumulative Quality Facts where it carries
    them, and each sub-agent call names the round it worked. Absent stays absent.

    Scenario evidence (BL2), where a stage reported any — the verify stage, for a
    delivery run: the row says how many of its parts passed after the name, and the
    panel lists them, so the evidence sits under the stage that ran it.

    Screenshots and links, where a stage reported any. Verify sends scenarios, each
    with the screenshot paths it took — a scenario page's label shots, and a failed
    part's own as fail.<anchor>.png, which the panel calls a failure screenshot in
    words rather than by colour. Personal Validation sends links — the app it
    started, the review targets — drawn as anchors with their description as the
    title. Scope and Implement send neither: their output is the run folder's
    scope.md and implement.md, which is text, not something to draw here.
*@
@if (_stages.Count > 0)
{
    <div class="sessions-stages" data-testid="sessions-stages">
        <StageLegend CssClass="sessions-stages__legend" />

        <ol class="sessions-stages__list" aria-label="@($"How each stage of run {Run.Title} ran")">
            @for (var index = 0; index < _stages.Count; index++)
            {
                var position = index;
                var stage = _stages[position];
                var tone = DeliveryRunLine.Tone(stage.Status);

                <li class="sessions-stage" data-testid="sessions-stage" data-stage="@stage.Name" data-tone="@tone.ToString().ToLowerInvariant()">
                    <FoldControl Expanded="@(_open == position)"
                                 ExpandedChanged="@(expanded => Toggle(position, expanded))"
                                 BaseClass="sessions-stage__fold"
                                 AriaLabel="@($"{stage.Name}: how it ran")"
                                 TestId="sessions-stage-toggle">
                        <LabelContent>
                            @* The dot is decorative: the word or the time further along
                               the row says where the stage stands. *@
                            <StatusDot Tone="@tone" CssClass="sessions-stage__dot" TestId="sessions-stage-dot" />
                            <span class="sessions-stage__name">
                                @stage.Name
                                @if (Rounds(stage) is { } rounds)
                                {
                                    <span class="sessions-stage__rounds" data-testid="sessions-stage-rounds">@rounds</span>
                                }
                                @* What the latest pass left behind, quietly after the
                                   name: the round is already in the rounds. *@
                                @if (RowFound(stage) is { } found)
                                {
                                    <span class="sessions-stage__found"
                                          data-testid="sessions-stage-found"
                                          data-tone="@(FoundSomething(stage) ? "found" : "clean")">@found</span>
                                }
                                @if (EvidenceOf(position) is { Count: > 0 } evidence)
                                {
                                    <span class="sessions-stage__evidence"
                                          title="Scenario parts this stage ran; open the stage for each part"
                                          data-testid="sessions-stage-evidence-summary">@ScenarioPartChecklist.SummaryOf(evidence)</span>
                                }
                            </span>
                            <span class="sessions-stage__mode">
                                <ModeChip Mode="@ModeWord(stage.Mode)" TestId="sessions-stage-mode" />
                            </span>
                            <span class="sessions-stage__ran-on">
                                @if (stage.Model is { } model)
                                {
                                    <span class="sessions-stage__model" title="@model" data-testid="sessions-stage-model">@AgentModels.Label(model)</span>
                                }
                                <EffortChip Effort="@stage.Effort" TestId="sessions-stage-effort" />
                                @if (Mark(stage) is var mark and not StageMarkKind.None)
                                {
                                    <StageMark Kind="@mark"
                                               Title="@(mark is StageMarkKind.Drift ? DeliveryRunStageResolution.DriftTitle(stage) : null)"
                                               TestId="sessions-stage-mark" />
                                }
                            </span>
                            <span class="sessions-stage__took"
                                  data-tone="@tone.ToString().ToLowerInvariant()"
                                  data-testid="sessions-stage-took">@Took(stage)</span>
                            <span class="sessions-stage__price">
                                @if (CostOf(position) is { } cost)
                                {
                                    <span class="sessions-stage__cost"
                                          title="@CostTitle(cost)"
                                          data-testid="sessions-stage-cost"
                                          data-source="@CostSlug(cost)">
                                        @cost.Label
                                        @if (cost.Estimated)
                                        {
                                            <abbr class="sessions-stage__estimate" title="@CostFigure.EstimatedNote">est.</abbr>
                                        }
                                    </span>
                                }
                            </span>
                            <span class="sessions-stage__against">
                                @if (CostOf(position) is not null)
                                {
                                    <DeliveryRunStageUsual Comparison="@UsualOf(position)" />
                                }
                            </span>
                        </LabelContent>
                        <ChildContent>
                            <div class="sessions-stage__panel" data-testid="sessions-stage-panel">
                                <dl class="sessions-stage__facts">
                                    <div class="sessions-stage__fact">
                                        <dt>Ran</dt>
                                        <dd data-testid="sessions-stage-ran">@Ran(stage, CostOf(position))</dd>
                                    </div>
                                    <div class="sessions-stage__fact">
                                        <dt>Configured</dt>
                                        <dd data-testid="sessions-stage-configured">@Configured(stage)</dd>
                                    </div>
                                    <div class="sessions-stage__fact">
                                        <dt>Skill</dt>
                                        <dd class="data-table__mono" data-testid="sessions-stage-skill">@(stage.Skill ?? NotRecorded)</dd>
                                    </div>
                                    <div class="sessions-stage__fact">
                                        <dt>MCP servers</dt>
                                        <dd class="data-table__mono" data-testid="sessions-stage-mcp">@Servers(stage)</dd>
                                    </div>
                                    @if (stage.Before.Count > 0 || stage.After.Count > 0)
                                    {
                                        <div class="sessions-stage__fact">
                                            <dt>Around it</dt>
                                            <dd class="data-table__mono" data-testid="sessions-stage-chores">@Chores(stage)</dd>
                                        </div>
                                    }
                                    @if (FoundFact(stage, Run.Quality) is { } foundFact)
                                    {
                                        <div class="sessions-stage__fact">
                                            <dt>Found</dt>
                                            <dd data-testid="sessions-stage-found-fact"
                                                data-tone="@(FoundSomething(stage) ? "found" : "clean")">@foundFact</dd>
                                        </div>
                                    }
                                @if (ScenariosOf(position) is { Count: > 0 } scenarios)
                                {
                                    @* File names, not images: the paths are relative to
                                       the run's worktree, which the run file does not
                                       record, so the pane names what was taken and
                                       leaves opening it to the person with the
                                       worktree. *@
                                    <div class="sessions-stage__fact">
                                        <dt>Screenshots</dt>
                                        <dd data-testid="sessions-stage-screenshots">
                                            <ul class="sessions-stage__scenarios">
                                                @foreach (var scenario in scenarios)
                                                {
                                                    <li class="sessions-stage__scenario" data-testid="sessions-stage-scenario">
                                                        <span class="sessions-stage__scenario-name">@scenario.Name</span>
                                                        <StatusBadge Status="@ScenarioStatusSlug(scenario.Status)"
                                                                     Text="@ScenarioStatusLabel(scenario.Status)"
                                                                     TestId="sessions-stage-scenario-status" />
                                                        @if (!string.IsNullOrWhiteSpace(scenario.Notes))
                                                        {
                                                            <span class="sessions-stage__scenario-notes">@scenario.Notes</span>
                                                        }
                                                        @if (scenario.Evidence is { Count: > 0 } files)
                                                        {
                                                            <ul class="sessions-stage__screenshots">
                                                                @foreach (var file in files)
                                                                {
                                                                    <li class="sessions-stage__screenshot" data-testid="sessions-stage-screenshot">
                                                                        <span class="sessions-stage__screenshot-file data-table__mono" title="@file">@FileName(file)</span>
                                                                        @if (IsFailureShot(file))
                                                                        {
                                                                            <Badge Kind="trigger"
                                                                                   Title="The page captured this when the part failed"
                                                                                   TestId="sessions-stage-failure-shot">Failure screenshot</Badge>
                                                                        }
                                                                    </li>
                                                                }
                                                            </ul>
                                                        }
                                                    </li>
                                                }
                                            </ul>
                                        </dd>
                                    </div>
                                }
                                @if (LinksOf(position) is { Count: > 0 } links)
                                {
                                    <div class="sessions-stage__fact">
                                        <dt>Links</dt>
                                        <dd data-testid="sessions-stage-links">
                                            <ul class="sessions-stage__links">
                                                @foreach (var link in links)
                                                {
                                                    <li>
                                                        <IntegrationLink Link="@StageLink(link)"
                                                                         ShowTitle="false"
                                                                         TestId="sessions-stage-link" />
                                                    </li>
                                                }
                                            </ul>
                                        </dd>
                                    </div>
                                }
                                </dl>

                                @* Why the row carries its mark, as a callout under the
                                   facts it qualifies: the mark is its glyph. *@
                                @if (DeliveryRunStageResolution.Explanations(stage) is { Count: > 0 } notes)
                                {
                                    <Callout Tone="@(stage.Drifted ? "warning" : null)"
                                             CssClass="sessions-stage__why"
                                             TestId="sessions-stage-notes"
                                             Icon="@MarkGlyph(stage)"
                                             ChildContent="@Lines(notes)" />
                                }

                                @if (stage.Workers.Count == 0)
                                {
                                    <p class="sessions-stage__none" data-testid="sessions-stage-workers">@NoWorkers(stage)</p>
                                }
                                else
                                {
                                    <DataTable TItem="WorkerRow"
                                               Columns="@WorkerColumns"
                                               Items="@WorkersOf(position, stage)"
                                               RowKey="@(row => row.Index)"
                                               RowAttributes="@(_ => WorkerAttributes)"
                                               AriaLabel="@($"Sub-agent runs of {stage.Name}")"
                                               RowNoun="sub-agent run"
                                               CssClass="sessions-stage__workers"
                                               TestId="sessions-stage-workers">
                                        <Row Context="row">
                                            <td>
                                                <span class="data-table__mono">@row.Worker.Agent</span>
                                                @if (row.Worker.Revise)
                                                {
                                                    <Badge Kind="trigger" CssClass="sessions-stage__revise" Title="@ReviseTitle(row.Worker)" TestId="sessions-stage-revise">@ReviseLabel(row.Worker)</Badge>
                                                }
                                                @if (WorkerQualifier(row.Worker) is { } qualifier)
                                                {
                                                    <span class="sessions-stage__qualifier">@qualifier</span>
                                                }
                                            </td>
                                            <td>@WorkerModel(row.Worker)</td>
                                            <td class="sessions-stage__figure">@(row.Worker.DurationMs is { } ms ? DeliveryRunLine.Duration(ms) : NotReported)</td>
                                            <td class="sessions-stage__figure data-table__mono">
                                                @(row.Worker.Tokens is { } tokens ? MetricFormat.Compact(tokens) : NotReported)
                                                @if (row.Cost is { } workerCost)
                                                {
                                                    <span class="sessions-stage__qualifier" title="@CostTitle(workerCost)">@CostText(workerCost)</span>
                                                }
                                            </td>
                                            <td class="sessions-stage__figure">@(row.Worker.ToolCalls is { } calls ? calls.ToString(System.Globalization.CultureInfo.InvariantCulture) : NotReported)</td>
                                            <td data-outcome="@WorkerOutcome(row.Worker)">@WorkerResult(row.Worker)</td>
                                        </Row>
                                    </DataTable>
                                }

                                @if (EvidenceOf(position) is { Count: > 0 } parts)
                                {
                                    @* The parts stay plain text: a run's evidence opens
                                       nothing, it only says what the stage ran. *@
                                    <ScenarioPartChecklist Parts="@parts"
                                                           Heading="Scenario evidence"
                                                           TestId="sessions-stage-evidence" />
                                }
                            </div>
                        </ChildContent>
                    </FoldControl>
                </li>
            }
        </ol>
    </div>
}

@code {
    private IReadOnlyList<DeliveryRunStageExecution> _stages = [];

    /// <summary>The run whose stages are drawn when the list was last resolved, so a
    /// re-render of the same run keeps the open panel and costs nothing.</summary>
    private DeliveryRun? _resolvedFor;

    /// <summary>The one open stage, or -1 for none.</summary>
    private int _open = -1;

    private const string NotRecorded = "not recorded";

    [Parameter, EditorRequired]
    public DeliveryRun Run { get; set; } = default!;

    /// <summary>What each stage cost, in stage order, or null where the host worked
    /// none out.</summary>
    [Parameter]
    public IReadOnlyList<DeliveryRunStageCost>? Costs { get; set; }

    /// <summary>Each stage's cost against the run and its usual, in stage order
    /// (<see cref="DeliveryRunBaselines"/>), or null where the host compared none.</summary>
    [Parameter]
    public DeliveryRunCostComparison? Comparison { get; set; }

    private StageCostAgainstUsual? UsualOf(int stage) =>
        Comparison is { } comparison && stage < comparison.Stages.Count ? comparison.Stages[stage] : null;

    private CostFigure? CostOf(int stage) => Costs is { } costs && stage < costs.Count ? costs[stage].Stage : null;

    /// <summary>The scenario parts the stage reported, as checklist rows. Read from
    /// the run's own stage, because the resolved execution carries no evidence; the
    /// resolution maps the run's stages one to one, so the positions agree.</summary>
    private IReadOnlyList<ScenarioChecklistPart> EvidenceOf(int stage) =>
        stage < Run.Stages.Count ? DeliveryRunLine.EvidenceParts(Run.Stages[stage]) : [];

    /// <summary>The scenarios the stage reported, read from the run's own stage for
    /// the reason <see cref="EvidenceOf"/> is.</summary>
    private IReadOnlyList<DeliveryScenario> ScenariosOf(int stage) =>
        stage < Run.Stages.Count ? Run.Stages[stage].Scenarios : [];

    /// <summary>The links the stage recorded, read from the run's own stage.</summary>
    private IReadOnlyList<DeliveryStageLink> LinksOf(int stage) =>
        stage < Run.Stages.Count ? Run.Stages[stage].Links : [];

    /// <summary>A scenario's status as the status badge's tone: a pass reads done, a
    /// failure blocked, and anything else — flaky, a word no writer has sent yet —
    /// the neutral tone, its own word still on the badge.</summary>
    internal static string ScenarioStatusSlug(string? status) => status?.Trim().ToLowerInvariant() switch
    {
        "pass" or "passed" => "done",
        "fail" or "failed" => "blocked",
        _ => "draft"
    };

    /// <summary>A scenario's status in words.</summary>
    internal static string ScenarioStatusLabel(string? status) => status?.Trim().ToLowerInvariant() switch
    {
        "pass" or "passed" => "Passed",
        "fail" or "failed" => "Failed",
        "flaky" => "Flaky",
        null or "" => "Not recorded",
        _ => DeliveryRunLine.StatusLabel(status!)
    };

    /// <summary>The file's own name, whichever separator the path was sent with.</summary>
    internal static string FileName(string path) =>
        path[(path.LastIndexOfAny(['/', '\\']) + 1)..];

    /// <summary>Whether the file is a part's failure screenshot: devbook's reporter
    /// names it <c>fail.&lt;anchor&gt;.png</c>, the dot keeping it apart from every
    /// label's shot.</summary>
    internal static bool IsFailureShot(string path)
    {
        var name = FileName(path);
        return name.StartsWith("fail.", StringComparison.OrdinalIgnoreCase)
            && name.EndsWith(".png", StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>A stage link as the library's integration link: the label — or the
    /// url, with none — as the anchor's text and the description as its title. No
    /// provider: an app started on localhost is nobody's tracker item.</summary>
    internal static IntegrationLinkRef StageLink(DeliveryStageLink link)
    {
        var url = link.Url ?? string.Empty;
        var label = string.IsNullOrWhiteSpace(link.Label) ? url : link.Label;
        return new IntegrationLinkRef(url, IntegrationProvider.None, IntegrationLinkKind.Other, label, link.Description, url);
    }

    private CostFigure? WorkerCostOf(int stage, int worker) =>
        Costs is { } costs && stage < costs.Count && worker < costs[stage].Workers.Count ? costs[stage].Workers[worker] : null;

    /// <summary>Where a figure came from, in words, for its tooltip.</summary>
    internal static string CostTitle(CostFigure cost) => cost.Estimated
        ? $"{cost.Label}, {CostFigure.EstimatedNote} at the prices in Settings"
        : $"{cost.Label}, as Claude Code reported it";

    private static string CostSlug(CostFigure cost) => cost.Estimated ? "estimated" : "reported";

    /// <summary>A figure as a sentence part: the amount, and for an estimate, so.</summary>
    internal static string CostText(CostFigure cost) =>
        cost.Estimated ? $"{cost.Label} {CostFigure.EstimatedNote}" : $"{cost.Label} reported";

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(Run, _resolvedFor)) return;

        _resolvedFor = Run;
        _stages = DeliveryRunStageResolution.Of(Run);

        if (_open >= _stages.Count) _open = -1;
    }

    private void Toggle(int index, bool expanded) => _open = expanded ? index : _open == index ? -1 : _open;

    internal static string ModeWord(DeliveryRunStageMode mode) => mode.ToString().ToLowerInvariant();

    /// <summary>≠ wins over ?, because a stage that ran differently is the one a reader
    /// needs to look at.</summary>
    internal static StageMarkKind Mark(DeliveryRunStageExecution stage) =>
        stage.Drifted ? StageMarkKind.Drift : stage.Inferred ? StageMarkKind.Inferred : StageMarkKind.None;

    /// <summary>"· 3 rounds" after the name, where the stage reported its round or was
    /// entered more than once; nothing for a stage that ran once.</summary>
    internal static string? Rounds(DeliveryRunStageExecution stage) =>
        (stage.Round ?? stage.Passes) is var rounds and > 1 ? $"· {rounds} rounds" : null;

    /// <summary>The row's time column: how long a finished stage took, or the word for
    /// where an unfinished one stands — "Not yet" for one nobody reported on.</summary>
    internal static string Took(DeliveryRunStageExecution stage) => DeliveryRunLine.Tone(stage.Status) switch
    {
        FlowStepTone.Pending => "Not yet",
        FlowStepTone.Done when stage.DurationMs is { } ms => DeliveryRunLine.Duration(ms),
        _ => DeliveryRunLine.StatusLabel(stage.Status)
    };

    /// <summary>The stage's mark, as the glyph of the callout that explains it.</summary>
    private static RenderFragment MarkGlyph(DeliveryRunStageExecution stage) => builder =>
    {
        builder.OpenComponent<StageMark>(0);
        builder.AddComponentParameter(1, nameof(StageMark.Kind), stage.Drifted ? StageMarkKind.Drift : StageMarkKind.Inferred);
        builder.AddComponentParameter(2, nameof(StageMark.Title), stage.Drifted ? DeliveryRunStageResolution.DriftTitle(stage) : null);
        builder.AddComponentParameter(3, nameof(StageMark.TestId), null);
        builder.CloseComponent();
    };

    /// <summary>Each explanation as a line of its own.</summary>
    private static RenderFragment Lines(IReadOnlyList<string> notes) => builder =>
    {
        foreach (var note in notes)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "sessions-stage__note");
            builder.AddContent(2, note);
            builder.CloseElement();
        }
    };

    /// <summary>What ran: the mode, the agent or the owner session, the model and the
    /// effort, then what the stage cost where the run counted it.</summary>
    internal static string Ran(DeliveryRunStageExecution stage, CostFigure? cost = null)
    {
        // A stage nobody has reported on has not run: what the configuration would
        // run is the Configured line's to say.
        if (DeliveryRunLine.Tone(stage.Status) is FlowStepTone.Pending) return "Not run yet";

        var parts = new List<string>
        {
            stage.Mode switch
            {
                DeliveryRunStageMode.Gate => "Your approval",
                DeliveryRunStageMode.Inline => "Owner session, inline",
                DeliveryRunStageMode.Fork => $"Fork of the owner session · {stage.Agent ?? "general-purpose"}",
                _ => $"Delegated · {stage.Agent ?? "agent not recorded"}"
            }
        };

        if (stage.Mode is not DeliveryRunStageMode.Gate)
        {
            parts.Add(stage.Model is { } model ? AgentModels.Label(model) : "session model");
            parts.Add(stage.Effort is { } effort ? $"{effort} effort" : "session effort");
        }

        if (stage.OutputTokens is { } output) parts.Add($"{MetricFormat.Compact(output)} output tokens");
        if (stage.ToolCalls > 0) parts.Add(stage.ToolCalls == 1 ? "1 tool call" : $"{stage.ToolCalls} tool calls");
        if (cost is not null) parts.Add(CostText(cost));

        return string.Join(" · ", parts);
    }

    /// <summary>What the run resolved for the stage and where it came from, or why
    /// there is nothing to say.</summary>
    internal static string Configured(DeliveryRunStageExecution stage)
    {
        if (stage.Configured is not { } configured)
        {
            return stage.RunRecordsPhases ? "The run's phase map has no entry for this stage" : "Not recorded: this run records no resolved phases";
        }

        var text = string.Join(" · ",
            configured.Agent ?? "owner session",
            configured.Model is { } model ? AgentModels.Label(model) : "session model",
            configured.Effort is { } effort ? $"{effort} effort" : "session effort");

        return configured.Origin is { } origin ? $"{text} — from the {origin}" : text;
    }

    /// <summary>Why the stage lists no sub-agent: one that ran without one, or one
    /// that was handed off and whose calls the run did not record.</summary>
    private static string NoWorkers(DeliveryRunStageExecution stage) =>
        stage.Mode is DeliveryRunStageMode.Delegate or DeliveryRunStageMode.Fork
            ? "Not recorded: the run saw no sub-agent call in this stage."
            : "None: no sub-agent ran in this stage.";

    private static string Servers(DeliveryRunStageExecution stage) => stage.Mcp switch
    {
        null => NotRecorded,
        { Count: 0 } => "none",
        var servers => string.Join(", ", servers)
    };

    private static string Chores(DeliveryRunStageExecution stage)
    {
        var parts = new List<string>();

        if (stage.Before.Count > 0) parts.Add($"before {string.Join(", ", stage.Before)}");
        if (stage.After.Count > 0) parts.Add($"after {string.Join(", ", stage.After)}");

        return string.Join(" · ", parts);
    }

    /// <summary>
    /// What the stage's latest pass found, for the row: Implement's and Review's round,
    /// Review's open blockers, Verify's defects — each left out where the stage did not
    /// report it, and null where it reported none. Zero reads as clean, never as absent.
    /// </summary>
    internal static string? Found(DeliveryRunStageExecution stage)
    {
        var parts = new List<string>();

        if (stage.Round is { } round) parts.Add($"round {round}");
        if (stage.Blockers is { } blockers) parts.Add(blockers == 0 ? "no blockers" : Plural(blockers, "blocker") + " open");
        if (stage.DefectsFound is { } defects) parts.Add(defects == 0 ? "no defects" : Plural(defects, "defect") + " found");

        return parts.Count == 0 ? null : string.Join(" · ", parts);
    }

    /// <summary>
    /// What the latest pass found, for the row: Review's open blockers and Verify's
    /// defects, each left out where the stage did not report it — the round rides on
    /// the name already. Null where it reported neither. Zero reads as clean.
    /// </summary>
    internal static string? RowFound(DeliveryRunStageExecution stage)
    {
        var parts = new List<string>();

        if (stage.Blockers is { } blockers) parts.Add(blockers == 0 ? "no blockers" : Plural(blockers, "blocker") + " open");
        if (stage.DefectsFound is { } defects) parts.Add(defects == 0 ? "no defects" : Plural(defects, "defect") + " found");

        return parts.Count == 0 ? null : string.Join(" · ", parts);
    }

    /// <summary>Whether the latest pass left a blocker open or found a defect.</summary>
    internal static bool FoundSomething(DeliveryRunStageExecution stage) =>
        stage.Blockers is > 0 || stage.DefectsFound is > 0;

    /// <summary>
    /// The panel's Found line: what the latest pass reported, then — on Implement,
    /// Review and Verify — what the run's cumulative Quality Facts say across every pass,
    /// where the run carries them. Null where neither says anything.
    /// </summary>
    internal static string? FoundFact(DeliveryRunStageExecution stage, DeliveryQualityFacts? facts)
    {
        var sentences = new List<string>();

        if (Found(stage) is { } latest) sentences.Add($"Latest pass: {latest}");

        var measure = DeliveryEconomics.MeasureOf(stage.Name);
        var across = new List<string>();

        if (facts is not null && measure is DeliveryQualityMeasure.ReviewRounds or DeliveryQualityMeasure.BlockersPerRound
            && facts.ReviewRounds is { } rounds)
        {
            across.Add(Plural(rounds, "review round"));
        }

        if (facts is not null && measure is DeliveryQualityMeasure.BlockersPerRound
            && facts.BlockerRounds is { } listed && facts.BlockersOpen is { } open)
        {
            across.Add($"{(open == 0 ? "no blockers" : Plural(open, "blocker"))} left open over {Plural(listed, "round")}");
        }

        if (facts is not null && measure is DeliveryQualityMeasure.DefectFound && facts.VerifyDefects is { } defects)
        {
            across.Add(defects == 0 ? "no defect found" : $"{Plural(defects, "defect")} found");
        }

        if (across.Count > 0) sentences.Add($"Across the run: {string.Join(", ", across)}");

        return sentences.Count == 0 ? null : string.Join(". ", sentences);
    }

    private static string Plural(int count, string noun) => count == 1 ? $"1 {noun}" : $"{count} {noun}s";

    /// <summary>The revise badge: the round the call worked, where it carries one.</summary>
    internal static string ReviseLabel(DeliveryRunStageWorker worker) =>
        worker.Round is { } round ? $"revise · round {round}" : "revise round";

    private static string ReviseTitle(DeliveryRunStageWorker worker) => worker.Round is { } round
        ? $"Ran under the gate: a revise round after you asked for changes, working implement-review round {round}"
        : "Ran under the gate: a revise round after you asked for changes";

    /// <summary>A sub-agent call and what it cost, in the order the run made them.</summary>
    private sealed record WorkerRow(int Index, DeliveryRunStageWorker Worker, CostFigure? Cost);

    private static readonly IReadOnlyList<DataTableColumn> WorkerColumns =
    [
        new("Sub-agent run"),
        new("Model"),
        new("Time", "sessions-stage__figure"),
        new("Tokens", "sessions-stage__figure"),
        new("Tool calls", "sessions-stage__figure"),
        new("Result")
    ];

    private static readonly IReadOnlyDictionary<string, object> WorkerAttributes =
        new Dictionary<string, object> { ["data-testid"] = "sessions-stage-worker" };

    /// <summary>What a column says for a figure the run did not record.</summary>
    private const string NotReported = "—";

    private IReadOnlyList<WorkerRow> WorkersOf(int position, DeliveryRunStageExecution stage) =>
        [.. stage.Workers.Select((worker, index) => new WorkerRow(index, worker, WorkerCostOf(position, index)))];

    /// <summary>What qualifies the call under its name: the slice it built and the
    /// round it worked — a revise call's round is on its badge instead.</summary>
    internal static string? WorkerQualifier(DeliveryRunStageWorker worker)
    {
        var parts = new List<string>();

        if (worker.Slice is { } slice) parts.Add($"slice {slice}");
        if (worker.Round is { } round && !worker.Revise) parts.Add($"round {round}");

        return parts.Count == 0 ? null : string.Join(" · ", parts);
    }

    /// <summary>The model the call ran on and its effort, where recorded.</summary>
    internal static string WorkerModel(DeliveryRunStageWorker worker) => (worker.Model, worker.Effort) switch
    {
        ({ } model, { } effort) => $"{AgentModels.Label(model)} · {effort} effort",
        ({ } model, null) => AgentModels.Label(model),
        (null, { } effort) => $"{effort} effort",
        _ => NotReported
    };

    /// <summary>How the call ended, in words.</summary>
    internal static string WorkerResult(DeliveryRunStageWorker worker) =>
        worker.Declared ? "declared, not seen running"
        : !worker.Observed ? "result not recorded"
        : worker.Failed ? "failed"
        : "completed";

    private static string WorkerOutcome(DeliveryRunStageWorker worker) =>
        worker.Declared ? "declared" : !worker.Observed ? "unknown" : worker.Failed ? "failed" : "completed";
}
