@*
    Dev PC Management's Tools as a shell surface (local ADR 0043 §1): a takeover, in
    the main window in place of the main view or in a window of its own. The pane
    needs nothing from the shell, and draws no close of its own: its header option
    or Escape closes it in the main window, the OS close in a window of its own.
*@
<ToolsPane />

@code {
    /// <summary>Unused: Tools takes no query.</summary>
    [Parameter]
    public IReadOnlyDictionary<string, string>? Query { get; set; }

    /// <summary>The shell's close callback, declared because the shell hands it to
    /// every surface. Unused: Tools draws no close of its own.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }
}
