@inject IDevToolService DevTools

@*
    The system tools pane: which Copilot plugins, repository tools, MCP servers
    and applications this machine is configured for, and what can be updated,
    enabled or disabled. It asks IDevToolService and renders the answer — which
    host is behind that port, and whether that host can do anything but read, is
    not something the pane knows.

    Grouped, because the subject grew. Six rows of AI tooling is a list; the
    machine's whole software inventory is a document, and the kind heading and
    the catalog's own group headings are the structure it arrives with. Groups
    with nothing outstanding fold themselves away: a correctly set-up machine
    should open this pane to headings and no rows.

    Three shapes of row rather than one. Most rows report a version and offer an
    Update or an Install. A checklist row has no version anywhere and reports
    whether it was detected. And a manual row reports nothing at all — nothing
    can check it, so its control is a box somebody ticks, and the box is the one
    control here that is not a verb.

    It owns its own loading for the same reason KnowledgePane does: the list is
    the pane's subject, and a shell holding it would be holding state about a
    context it only makes room for. The shell decides *whether* there is a tools
    pane — the feature flag and the header toggle stay there — and this decides
    what is in one.

    Three states, not two. "There is no catalog file" and "the catalog is empty"
    used to render the same sentence and the same nothing-to-do, which made a
    fresh machine a dead end: the one act that would have helped — write the
    catalog — was not on the screen. CatalogExists is what tells them apart, and
    each gets the affordance that actually moves it on.

    Every editing affordance is behind CanEditCatalog. A host that answers this
    port read-only says so once, and the create, add, import and remove controls
    are simply not drawn rather than drawn and refused.
*@

<section @key=@("tools-pane") class="tools-panel" id="tools-pane" aria-labelledby="installed-tools-title" data-testid="tools-panel">
    <header class="tools-panel__header">
        <div>
            <p class="tools-panel__eyebrow">System tools</p>
            <h2 id="installed-tools-title" class="tools-panel__title">System tools</h2>
            <p class="tools-panel__subtitle">What this machine is configured to have: Copilot and Claude plugins, marketplaces, MCP servers, and the applications and checks the setup guide asks for.</p>
        </div>
        <div class="tools-panel__header-actions">
            @* A re-check over rows that are already on screen does not blank them
               — the versions below stay readable while the newer ones are being
               looked up — so the only place left to say that something is running
               is here, beside the count it is about to change. *@
            @if (_toolsLoading && _tools.Count > 0)
            {
                <Spinner Size="SpinnerSize.Small" Label="Checking tools" TestId="tools-refreshing" />
            }
            @* The library's badge wearing this pane's count class. *@
            <Badge BaseClass="tools-panel__count" Kind="">@CountLabel</Badge>
            <IconButton AriaLabel="Close tools pane" CssClass="btn--ghost" OnClick="() => OnClose.InvokeAsync()">✕</IconButton>
        </div>
    </header>

    <div class="tools-panel__content" id="installed-tools-content">
        @* Two columns rather than one stack, at the widths that have room
           for them. The transcript used to be the last thing in the pane,
           which on a fifty-row inventory put it a scroll and a half below
           the button that produced it — so the one thing a failed install
           left behind was the one thing nobody saw. The list keeps the
           column it always had and the transcript takes a rail beside it;
           below the width where both fit, the rail simply falls back under
           the list and this is the stack it was. *@
        <div class="tools-panel__main">
            <div class="tools-panel__toolbar">
                @* The library's alert wearing this pane's message class. The fallback
                   behind ToolMessage keeps it non-empty, so it never takes the alert's
                   hidden shape: a toolbar that loses its status line collapses. *@
                <Alert Message="@ToolMessage" BaseClass="tools-panel__message" Role="status" />
                <div class="tools-panel__toolbar-actions">
                    @* Checking and updating both read the catalog, so neither is offered
                       while there is no catalog to read. *@
                    <AppButton Variant="ButtonVariant.Secondary" Disabled="@(!_catalogExists || _toolsLoading || ToolActionBusy)" OnClick="RefreshToolsAsync" TestId="tools-refresh">
                        @(_toolsLoading ? "Checking..." : "Check for updates")
                    </AppButton>
                    <AppButton Variant="ButtonVariant.Primary" Disabled="@(!_catalogExists || _toolsLoading || ToolActionBusy || !CanUpdateAnyTool)" OnClick="UpdateAllToolsAsync">
                        @(_toolActionKey == UpdateAllKey ? "Updating..." : "Update all")
                    </AppButton>
                    @if (CanEdit && _catalogExists && _tools.Count > 0)
                    {
                        @* Only alongside a populated table. The two empty states carry
                           their own copies of these, where they are the point of the
                           screen rather than one more button on a toolbar. *@
                        <AppButton Variant="ButtonVariant.Secondary" Disabled="@ToolActionBusy" OnClick="OpenAddDialog" TestId="tools-add-open">
                            Add tool
                        </AppButton>
                        <AppButton Variant="ButtonVariant.Ghost" Disabled="@ToolActionBusy" OnClick="OpenImportDialog" TestId="tools-import-open">
                            Import
                        </AppButton>
                    }
                </div>
            </div>

            @if (_toolsLoading && _tools.Count == 0)
            {
                @* The first read walks the machine — plugin manifests, marketplaces,
                   a version probe per application — and on a cold cache that is
                   several seconds of a pane with nothing in it. One grey sentence
                   there was indistinguishable from a pane that had failed to draw,
                   so what stands in for the inventory is the inventory's own shape:
                   the same kind sections, the same four-column grid, the same frame,
                   with bars where the rows will be.

                   It reuses this pane's row classes rather than describing a table of
                   its own, which is what keeps the placeholder honest — it restacks
                   with the real rows when the pane is narrow, because it is laid out
                   by the same container query.

                   Hidden from assistive technology in one piece. A reader who cannot
                   see the bars gains nothing from forty of them; the toolbar's status
                   line above already says the catalog is being checked, and it says
                   it once. *@
                <div class="tools-panel__skeleton" data-testid="tools-loading" aria-hidden="true">
                    @foreach (var section in SkeletonSections)
                    {
                        <section class="tools-kind">
                            <Skeleton Shape="SkeletonShape.Heading" Width="8rem" />
                            <div class="tools-table">
                                <div class="tools-table__row tools-table__row--head">
                                    <Skeleton Width="2.5rem" />
                                    <Skeleton Width="4rem" />
                                    <Skeleton Width="4rem" />
                                    <Skeleton Width="3.5rem" />
                                </div>
                                @foreach (var name in section)
                                {
                                    <div class="tools-table__row">
                                        <div class="tools-table__tool">
                                            <Skeleton Width="@name" />
                                            <Skeleton Width="55%" />
                                        </div>
                                        <Skeleton Width="3rem" />
                                        <Skeleton Width="3rem" />
                                        <Skeleton Shape="SkeletonShape.Block" Width="5rem" />
                                    </div>
                                }
                            </div>
                        </section>
                    }
                </div>
            }
            else if (!_catalogExists)
            {
                <EmptyState Title="No tool catalog yet"
                            Description="@NoCatalogDescription"
                            Action="@NoCatalogActions"
                            TestId="tools-empty-no-catalog" />
            }
            else if (_tools.Count == 0)
            {
                <EmptyState Title="No tools in the catalog yet"
                            Description="@EmptyCatalogDescription"
                            Action="@EmptyCatalogActions"
                            TestId="tools-empty-no-entries" />
            }
            else
            {
                @* Grouped rather than one list, because the catalog stopped being six
                   rows of AI tooling and became this machine's whole software
                   inventory. Fifty-odd ungrouped rows lose the structure the setup
                   guide they come from is made of — and the kind heading is the first
                   thing a reader needs, because "a plugin is missing" and "an
                   application is missing" are two different afternoons. *@
                @foreach (var kind in ToolKinds)
                {
                    <section class="tools-kind" data-tool-kind="@kind.Kind" data-testid="tools-kind">
                        <SectionHeader Level="3"
                                       Title="@kind.Title"
                                       Description="@KindCount(kind)"
                                       CssClass="tools-kind__header" />

                        @foreach (var group in kind.Groups)
                        {
                            <div class="tools-group" data-tool-group="@group.Key">
                                @if (group.Title is { Length: > 0 } groupTitle)
                                {
                                    @* Only the sub-groups fold. A kind with one
                                       unnamed group is the three plugins and the
                                       three MCP servers this pane started as, and a
                                       disclosure over three rows is a control that
                                       costs more than it saves. *@
                                    <FoldControl CssClass="tools-group__fold"
                                                 Expanded="@IsExpanded(group)"
                                                 ExpandedChanged="expanded => SetExpanded(group, expanded)"
                                                 Controls="@group.RegionId"
                                                 Label="@GroupLabel(group, groupTitle)"
                                                 TestId="tools-group-toggle" />
                                }

                                <div class="tools-table"
                                     role="table"
                                     aria-label="@group.AriaLabel(kind.Title)"
                                     id="@group.RegionId"
                                     hidden="@(!IsExpanded(group))">
                                    <div class="tools-table__row tools-table__row--head" role="row">
                                        <span role="columnheader">Tool</span>
                                        <span role="columnheader">Installed</span>
                                        <span role="columnheader">Available</span>
                                        <span role="columnheader">Actions</span>
                                    </div>

                                    @foreach (var tool in group.Tools)
                                    {
                                        <div class="tools-table__row @(tool.ConfiguredEnabled ? string.Empty : "tools-table__row--disabled")" role="row" data-tool-key="@tool.Key" @key="tool.Key">
                                            <div role="cell" class="tools-table__tool">
                                                <strong>@tool.Name</strong>
                                                @* The library's badge wearing this table's host class.
                                                   Which hosts an entry is for decides what its Update
                                                   actually does, and a catalog that drives two of them
                                                   with one row is unreadable without it being said.

                                                   An application has no host at all — it is machine
                                                   software, not a registration with an AI tool — so it
                                                   gets no badge rather than a badge reading "No host",
                                                   which answered a question the row never asked. *@
                                                @if (tool.Hosts is not DevToolHosts.None)
                                                {
                                                    <Badge BaseClass="tools-table__hosts"
                                                           Kind=""
                                                           Title="@HostTitle(tool)"
                                                           TestId="tools-row-hosts">@HostLabel(tool.Hosts)</Badge>
                                                }
                                                <span class="tools-table__meta">@Humanize(tool.Kind.ToString()) · @StatusOf(tool)</span>
                                                @if (NoteOf(tool) is { Length: > 0 } note)
                                                {
                                                    @* The catalog's own warning, on a line of its own
                                                       rather than run together with the status. Several
                                                       of these are the only reason a row reads the way it
                                                       does — a version that legitimately reads backwards,
                                                       a probe that is a heuristic, a package that does not
                                                       exist — and appended to the status they were a
                                                       sentence nobody finished reading. *@
                                                    <span class="tools-table__note" data-testid="tools-row-note">@note</span>
                                                }
                                            </div>
                                            @* Each version cell names itself. The row's four columns only
                                               fit while the pane is wide enough for them — it is a surface
                                               beside a workspace, so it often is not — and below that the
                                               row stacks and the heading row goes. Two bare version strings
                                               in a column say nothing about which is which, so the label is
                                               in the markup at every width and the stylesheet decides when
                                               it shows. *@
                                            <span role="cell" class="tools-table__version" data-testid="tools-row-installed">
                                                <span class="tools-table__cell-label">Installed</span>@InstalledLabel(tool)
                                            </span>
                                            <span role="cell" class="tools-table__version @(tool.CanUpdate ? "tools-table__version--new" : string.Empty)">
                                                <span class="tools-table__cell-label">Available</span>@tool.AvailableVersion
                                            </span>
                                            <div role="cell" class="tools-table__actions">
                                                @* One slot per thing the row lets you do: the action
                                                   or the status, the toggle, and Remove. Each names
                                                   its own column in the stylesheet rather than taking
                                                   the one its order would give it, because a
                                                   marketplace has no toggle and a read-only host no
                                                   Remove — and under auto-placement the survivors
                                                   would slide into the empty track, misaligning
                                                   exactly the rows that differ from the ones around
                                                   them. Why the tracks are the widths they are is in
                                                   `.tools-table__actions`. *@
                                                <span class="tools-table__action">
                                                    @if (tool.Kind is DevToolKind.Marketplace)
                                                    {
                                                        @* A marketplace has no version to be behind, so it
                                                           never earns an Update through CanUpdate the way a
                                                           tool does. What it has is two states — Claude
                                                           knows it or does not — and one verb for each. *@
                                                        <AppButton Variant="ButtonVariant.Secondary"
                                                                   Disabled="@(_toolsLoading || ToolActionBusy)"
                                                                   OnClick="() => ApplyToolActionAsync(tool, DevToolAction.Update)">
                                                            @(tool.Installed ? "Update" : "Add")
                                                        </AppButton>
                                                    }
                                                    else if (tool.ConfirmedByHand && tool.ConfiguredEnabled)
                                                    {
                                                        @* The one row whose control is not a verb. Nothing
                                                           can check it, so the only honest answer on it is
                                                           somebody's word — and a box, unlike a button, can
                                                           be taken back. It went through Update once, and
                                                           that was the defect: ticking it removed the only
                                                           control the row had, so a mis-click was permanent
                                                           short of hand-editing the per-PC file.

                                                           Only while the machine wants the row at all. A
                                                           switched-off row has nothing to confirm, and a
                                                           tick on one would be a statement about something
                                                           this machine has said it is not doing. *@
                                                        <Checkbox Checked="@tool.Acknowledged"
                                                                  CheckedChanged="acknowledged => AcknowledgeAsync(tool, acknowledged)"
                                                                  Disabled="@(_toolsLoading || ToolActionBusy)"
                                                                  Label="Done here"
                                                                  CssClass="tools-table__ack"
                                                                  TestId="tools-row-acknowledge" />
                                                    }
                                                    else if (tool.CanUpdate)
                                                    {
                                                        <AppButton Variant="ButtonVariant.Secondary"
                                                                   Disabled="@(_toolsLoading || ToolActionBusy)"
                                                                   OnClick="() => ApplyToolActionAsync(tool, DevToolAction.Update)">
                                                            Update
                                                        </AppButton>
                                                    }
                                                    else if (tool.CanInstall)
                                                    {
                                                        @* The same action as an update. The port has one
                                                           verb for "make this machine match the config",
                                                           and behind it the host already runs
                                                           "plugin install" or "tool install" for a tool
                                                           that is enabled and absent — what changes here
                                                           is only that the row now offers it.

                                                           CanInstall is false for a row with no mechanism
                                                           behind it, which is what keeps the checklist rows
                                                           and the install-by-hand packages from being given
                                                           a button with nothing to run. *@
                                                        <AppButton Variant="ButtonVariant.Secondary"
                                                                   Disabled="@(_toolsLoading || ToolActionBusy)"
                                                                   OnClick="() => ApplyToolActionAsync(tool, DevToolAction.Update)">
                                                            Install
                                                        </AppButton>
                                                    }
                                                    else
                                                    {
                                                        <span class="tools-table__action-note">@ActionNote(tool)</span>
                                                    }
                                                </span>
                                                @if (tool.Kind is not DevToolKind.Marketplace)
                                                {
                                                    <span class="tools-table__toggle">
                                                        @* Not for a marketplace. It is not a tool this
                                                           machine opts into — it is where the Claude
                                                           plugins that do come from — so the only way to
                                                           stop wanting one is to remove it. *@
                                                        <AppButton Variant="ButtonVariant.Ghost"
                                                                   Disabled="@(_toolsLoading || ToolActionBusy)"
                                                                   OnClick="() => ApplyToolActionAsync(tool, tool.ConfiguredEnabled ? DevToolAction.Disable : DevToolAction.Enable)">
                                                            @(tool.ConfiguredEnabled ? "Disable" : "Enable")
                                                        </AppButton>
                                                    </span>
                                                }
                                                @if (CanEdit)
                                                {
                                                    <span class="tools-table__remove">
                                                        @* The row's test id is shared by every row, so a driver
                                                           scopes it through the row's data-tool-key. One id per
                                                           row would be an id nobody could write a selector for
                                                           without knowing the catalog first. *@
                                                        <DeleteButton Label="Remove"
                                                                      AriaLabel="@($"Remove {tool.Name} from the catalog")"
                                                                      Size="ButtonSize.Small"
                                                                      ShowIcon="false"
                                                                      Disabled="@(_toolsLoading || ToolActionBusy)"
                                                                      TestId="tools-row-remove"
                                                                      OnClick="() => AskToRemove(tool)" />
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                        }
                    </section>
                }

            }
        </div>

        @if (_commands.Count > 0)
        {
            @* Checking tools runs about a dozen processes, and until this was
               here the only trace of any of them was the sentence in the status
               line above. The output was already captured and then dropped, so a
               refused install or a search that could not reach nuget.org had
               nowhere left to be read.

               Folded, because it is diagnostics and not the pane's subject: it
               matters exactly when the one-line summary is not enough — and a
               rail is what lets it be both: closed it is a line of text beside
               the list, open it is a column the list is read against rather than
               a block the list has been pushed off the screen by.

               A plain element and not a landmark: an aside with a name of its own
               would file a complementary region inside the app's main one and
               announce it as a word nothing on screen says. FoldControl already
               gives the transcript a labelled region and its trigger already names
               it, so a third wrapper here would be structure without content. *@
            <div class="tools-panel__side">
                <FoldControl CssClass="tools-panel__log"
                             Expanded="_commandsShown"
                             ExpandedChanged="shown => _commandsShown = shown"
                             Label="@($"Command output ({_commands.Count})")"
                             TestId="tools-command-log">
                    <CodeView Source="@CommandLog" Language="console" TestId="tools-command-log-output" />
                </FoldControl>
            </div>
        }
    </div>
</section>

<Modal Open="@_addOpen"
       OpenChanged="OnAddOpenChanged"
       Title="Add a tool"
       CssClass="tools-dialog"
       TestId="tools-add-dialog">
    <ChildContent>
        <div class="tools-form">
            @* SelectField rather than EnumSelect: the enum member is McpServer and
               the humanised form of that reads "Mcp Server", which is not what the
               product calls it anywhere else. *@
            @* Form, like every field below it: the two selects at the top of this
               dialog are the ones that decide which of those fields exist, so of
               everything here they are the last things that should read as
               captions rather than as controls. *@
            <SelectField Label="Kind"
                         Form="true"
                         CurrentValue="@_draftKind.ToString()"
                         Options="@KindOptions"
                         HelpText="What the tool is. Changing it changes what the form asks for below."
                         TestId="tools-add-kind"
                         OnChanged="OnDraftKindChanged" />

            @if (_draftKind is DevToolKind.Plugin or DevToolKind.McpServer)
            {
                @* Named kinds rather than "not a marketplace", because the list
                   grew a third kind that has no hosts either. A marketplace is a
                   Claude mechanism and nothing else; an application is installed
                   into the machine rather than into an AI host. Offering either of
                   them the choice would be offering an answer that cannot be
                   given — and the condition this replaced would have offered it to
                   applications silently. *@
                <SelectField Label="Hosts"
                             Form="true"
                             CurrentValue="@_draftHosts.ToString()"
                             Options="@HostOptions"
                             HelpText="Which host CLIs it is installed for. Including Claude adds the fields it needs."
                             TestId="tools-add-hosts"
                             OnChanged="OnDraftHostsChanged" />
            }

            @if (_draftKind is DevToolKind.Marketplace)
            {
                <TextField Label="Name"
                           Value="@_draftMarketplaceName"
                           ValueChanged="value => _draftMarketplaceName = value"
                           HelpText="What Claude will call it — the marketplace half of a plugin id."
                           ErrorMessage="@_draftIdError"
                           TestId="tools-add-name" />
                <TextField Label="Source"
                           Value="@_draftSource"
                           ValueChanged="value => _draftSource = value"
                           HelpText="The repository it is added from: an owner/repo, or a URL."
                           ErrorMessage="@_draftSourceError"
                           TestId="tools-add-source" />
            }
            else if (_draftKind is DevToolKind.Plugin)
            {
                <TextField Label="Name"
                           Value="@_draftPluginName"
                           ValueChanged="value => _draftPluginName = value"
                           HelpText="The plugin's name, exactly as its host CLI lists it. Claude's own name for it, when it differs, goes below."
                           ErrorMessage="@_draftIdError"
                           TestId="tools-add-name" />
                <TextField Label="Source"
                           Value="@_draftSource"
                           ValueChanged="value => _draftSource = value"
                           HelpText="Where it is installed from: an owner/repo:path, or a URL."
                           ErrorMessage="@_draftSourceError"
                           TestId="tools-add-source" />
                <SelectField Label="Kind of plugin"
                             Form="true"
                             CurrentValue="@_draftPluginKind"
                             Options="@PluginKindOptions"
                             IncludeEmptyOption="true"
                             EmptyLabel="Plugin (default)"
                             HelpText="Optional. Only the kinds the desktop host branches on; a plain plugin needs none."
                             TestId="tools-add-plugin-kind"
                             OnChanged="value => _draftPluginKind = value ?? string.Empty" />

                @if (_draftHosts.HasFlag(DevToolHosts.Claude))
                {
                    @* Both blank in the ordinary case: a plugin's Claude id falls
                       back to its own name and to the first marketplace in the
                       catalog, and writing either out when it only restates the
                       fallback makes the catalog harder to read. *@
                    <TextField Label="Claude name"
                               Value="@_draftClaudeName"
                               ValueChanged="value => _draftClaudeName = value"
                               HelpText="Optional. Only when the marketplace calls it something else."
                               TestId="tools-add-claude-name" />
                    <TextField Label="Claude marketplace"
                               Value="@_draftClaudeMarketplace"
                               ValueChanged="value => _draftClaudeMarketplace = value"
                               HelpText="Optional. Defaults to the first marketplace in the catalog."
                               TestId="tools-add-claude-marketplace" />
                }
            }
            else if (_draftKind is DevToolKind.Application)
            {
                @* An explicit branch, and not because it needs different fields —
                   because the chain it joins is binary-exhaustive and falls
                   through to the MCP server. Without this, choosing Application
                   would have drawn a package id and a Claude registration, and
                   submitted whatever was typed into them as an application. *@
                @* Form, like the two selects above it. This is the third of the
                   dialog's mode switches — it decides whether the command fields
                   below exist — and a switch that reads as a caption is the thing
                   the form shape was added for. *@
                <SelectField Label="Installed by"
                             Form="true"
                             CurrentValue="@_draftProvider.ToString()"
                             Options="@ProviderOptions"
                             HelpText="How this machine gets it. Choosing a command asks for the probe to run."
                             TestId="tools-add-provider"
                             OnChanged="OnDraftProviderChanged" />
                <TextField Label="ID"
                           Value="@_draftApplicationId"
                           ValueChanged="value => _draftApplicationId = value"
                           HelpText="@ApplicationIdHelp"
                           ErrorMessage="@_draftIdError"
                           TestId="tools-add-app-id" />
                <TextField Label="Name"
                           Value="@_draftDisplayName"
                           ValueChanged="value => _draftDisplayName = value"
                           HelpText="Optional. What the row reads as; defaults to the id."
                           TestId="tools-add-name" />

                @if (_draftProvider is DevToolProvider.Command)
                {
                    @* The other three mechanisms know how to find their own
                       package. A command entry is the one that has to be told, and
                       one that was not can never answer whether the machine has
                       it — so the detect command is required here rather than
                       written and drawn forever as a row of unknowns. *@
                    <TextField Label="Detect command"
                               Value="@_draftDetectCommand"
                               ValueChanged="value => _draftDetectCommand = value"
                               HelpText="What answers whether this machine already has it."
                               ErrorMessage="@_draftDetectError"
                               TestId="tools-add-detect-command" />
                    <TextField Label="Detect arguments"
                               Value="@_draftDetectArgs"
                               ValueChanged="value => _draftDetectArgs = value"
                               HelpText="Optional. Separated by spaces, in the order they are passed."
                               TestId="tools-add-detect-args" />
                    <TextField Label="Expect"
                               Value="@_draftDetectExpect"
                               ValueChanged="value => _draftDetectExpect = value"
                               HelpText="Optional. The substring that means yes, when the command answers in prose rather than with a version."
                               TestId="tools-add-detect-expect" />
                    <TextField Label="Install command"
                               Value="@_draftInstallCommand"
                               ValueChanged="value => _draftInstallCommand = value"
                               HelpText="Leave blank for a checklist item: something worth looking for that is not ours to press a button about."
                               TestId="tools-add-install-command" />
                    <TextField Label="Install arguments"
                               Value="@_draftInstallArgs"
                               ValueChanged="value => _draftInstallArgs = value"
                               HelpText="Optional. Separated by spaces, in the order they are passed."
                               TestId="tools-add-install-args" />
                }
            }
            else
            {
                <TextField Label="Package ID"
                           Value="@_draftPackageId"
                           ValueChanged="value => _draftPackageId = value"
                           HelpText="The .NET tool package the server ships as."
                           ErrorMessage="@_draftIdError"
                           TestId="tools-add-package-id" />
                <TextField Label="Name"
                           Value="@_draftDisplayName"
                           ValueChanged="value => _draftDisplayName = value"
                           HelpText="Optional. What the row reads as beside the package id."
                           TestId="tools-add-name" />

                @if (_draftHosts.HasFlag(DevToolHosts.Claude))
                {
                    @* The .NET tool above is shared by both hosts. These three are
                       the extra step Claude needs on top of it: a user-scope
                       registration pointing at the executable the tool installs. *@
                    <TextField Label="Claude server name"
                               Value="@_draftClaudeServerName"
                               ValueChanged="value => _draftClaudeServerName = value"
                               HelpText="Optional. What 'claude mcp' registers it as; defaults to the name above."
                               TestId="tools-add-claude-server-name" />
                    <TextField Label="Claude command"
                               Value="@_draftClaudeCommand"
                               ValueChanged="value => _draftClaudeCommand = value"
                               HelpText="The executable the tool installs. Leave blank to install the tool without registering it."
                               TestId="tools-add-claude-command" />
                    <TextField Label="Claude arguments"
                               Value="@_draftClaudeArgs"
                               ValueChanged="value => _draftClaudeArgs = value"
                               HelpText="Optional. Separated by spaces, in the order they are passed."
                               TestId="tools-add-claude-args" />
                }
            }
        </div>
    </ChildContent>
    <Footer>
        <AppButton Variant="ButtonVariant.Ghost" OnClick="CloseAddDialog" TestId="tools-add-cancel">Cancel</AppButton>
        <AppButton Variant="ButtonVariant.Primary" Disabled="@ToolActionBusy" OnClick="SubmitAddAsync" TestId="tools-add-submit">
            @(_toolActionKey == AddKey ? "Adding..." : "Add tool")
        </AppButton>
    </Footer>
</Modal>

<Modal Open="@_importOpen"
       OpenChanged="OnImportOpenChanged"
       Title="Import a tool catalog"
       CssClass="tools-dialog"
       TestId="tools-import-dialog">
    <ChildContent>
        <div class="tools-form">
            <p class="tools-form__note">
                The catalog is replaced, not merged. The one that is there now is kept beside it as a .bak file.
            </p>
            <FileField Label="Catalog file"
                       Accept=".json"
                       HelpText="An ai-tools.json with a plugins, mcpServers, claude.marketplaces or applications array."
                       ErrorMessage="@_importError"
                       OnTextRead="OnImportFileRead"
                       OnRejected="OnImportFileRejected"
                       TestId="tools-import-file" />
            @* The paste box is not a fallback for a broken picker: a catalog
               arrives as often in a message or a review as it does as a file on
               this machine, and both end at the same ImportAsync(string). *@
            <TextArea Label="Or paste the JSON"
                      Value="@_importJson"
                      ValueChanged="value => _importJson = value"
                      AutoGrow="false"
                      Rows="8"
                      Placeholder="@ImportPlaceholder"
                      TestId="tools-import-json" />
        </div>
    </ChildContent>
    <Footer>
        <AppButton Variant="ButtonVariant.Ghost" OnClick="CloseImportDialog">Cancel</AppButton>
        <AppButton Variant="ButtonVariant.Primary" Disabled="@ToolActionBusy" OnClick="SubmitImportAsync" TestId="tools-import-submit">
            @(_toolActionKey == ImportKey ? "Importing..." : "Replace catalog")
        </AppButton>
    </Footer>
</Modal>

@* No OpenChanged binding, deliberately. ConfirmDialog raises it before OnConfirm,
   so a handler that cleared the subject there would clear it a moment before the
   confirm needed it. Cancel, Escape and the backdrop all arrive on OnCancel, which
   is the one path that has to forget what was being removed. *@
<ConfirmDialog Open="@(_removing is not null)"
               Title="Remove this tool?"
               Message="@RemoveMessage"
               ConfirmText="Remove"
               Destructive="true"
               TestId="tools-remove-dialog"
               ConfirmTestId="tools-remove-confirm"
               CancelTestId="tools-remove-cancel"
               OnConfirm="ConfirmRemoveAsync"
               OnCancel="CancelRemove" />

@code {
    /// <summary>The keys the busy state is held under for acts that are not one
    /// tool's. A tool's own key is its catalog key, and none of those can collide
    /// with these: a key is <c>plugin:</c> or <c>mcp:</c> prefixed.</summary>
    private const string UpdateAllKey = "__all__";
    private const string CreateKey = "__create__";
    private const string AddKey = "__add__";
    private const string ImportKey = "__import__";

    private bool _toolsLoading;
    private string? _toolMessage;
    private string? _toolActionKey;
    private bool _commandsShown;
    private IReadOnlyList<DevToolInfo> _tools = [];
    private IReadOnlyList<DevToolCommand> _commands = [];

    private bool _catalogExists;
    private bool _canEditCatalog;
    private string _catalogPath = string.Empty;

    private bool _addOpen;
    private DevToolKind _draftKind = DevToolKind.Plugin;
    private DevToolHosts _draftHosts = DevToolHosts.Default;
    private string _draftPluginName = string.Empty;
    private string _draftSource = string.Empty;
    private string _draftPluginKind = string.Empty;
    private string _draftPackageId = string.Empty;
    private string _draftDisplayName = string.Empty;
    private string _draftMarketplaceName = string.Empty;
    private string _draftClaudeName = string.Empty;
    private string _draftClaudeMarketplace = string.Empty;
    private string _draftClaudeServerName = string.Empty;
    private string _draftClaudeCommand = string.Empty;
    private string _draftClaudeArgs = string.Empty;
    private DevToolProvider _draftProvider = DevToolProvider.Winget;
    private string _draftApplicationId = string.Empty;
    private string _draftDetectCommand = string.Empty;
    private string _draftDetectArgs = string.Empty;
    private string _draftDetectExpect = string.Empty;
    private string _draftInstallCommand = string.Empty;
    private string _draftInstallArgs = string.Empty;
    private string? _draftIdError;
    private string? _draftSourceError;
    private string? _draftDetectError;

    private bool _importOpen;
    private string _importJson = string.Empty;
    private string? _importError;

    private DevToolInfo? _removing;

    /// <summary>Raised when somebody dismisses the pane. Whether that hides it,
    /// collapses a stack or does nothing is the shell's decision — the pane only
    /// reports that the ✕ was pressed.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override Task OnInitializedAsync() => RefreshToolsAsync();

    private bool ToolActionBusy => _toolActionKey is not null;

    private bool CanEdit => _canEditCatalog;

    /// <summary>Never empty, so the toolbar always has a status line. The
    /// shared alert renders nothing for a blank message, and "no message yet"
    /// here means the check is still running - which is the one thing the line
    /// most needs to say.</summary>
    private string ToolMessage => _toolMessage ?? "Checking configured tools...";

    /// <summary>The placeholder inventory: two kind sections of three and two
    /// rows, and the width of each row's name bar.
    ///
    /// <para>Uneven on purpose. Bars of one length read as a pattern — a loading
    /// graphic — where a ragged right edge reads as names, which is the whole
    /// point of standing in for the content rather than announcing its absence.
    /// Two sections rather than the real four: enough to show the pane arrives
    /// grouped, without a screenful of grey where a short catalog is coming.</para></summary>
    private static readonly string[][] SkeletonSections =
    [
        ["62%", "78%", "45%"],
        ["70%", "52%"]
    ];

    /// <summary>"No catalog" is a different fact from "no tools", and the badge is
    /// where it is said in one glance.
    ///
    /// <para>Three facts, not two: until the first read comes back, neither of the
    /// others is known. <c>_catalogExists</c> starts false, so the badge used to
    /// open on "No catalog" and correct itself — a claim the pane had not checked,
    /// beside a placeholder promising rows were coming.</para></summary>
    private string CountLabel => _toolsLoading && _tools.Count == 0
        ? "Checking"
        : !_catalogExists
            ? "No catalog"
            : _tools.Count == 0 ? "Check tools" : $"{_tools.Count} tools";

    private string NoCatalogDescription => _catalogPath.Length == 0
        ? "This machine has no tool catalog. Create one, or import a catalog you already have."
        : $"Nothing has been configured on this machine yet. The catalog will be written to {_catalogPath}.";

    /// <summary>Names all four kinds a catalog can hold, because this fires only
    /// when every one of them is empty. It said "no plugins or MCP servers" while
    /// those were the only two, and a person who had just added an applications
    /// array read a sentence that did not mention the thing they were editing.</summary>
    private string EmptyCatalogDescription => _catalogPath.Length == 0
        ? "The catalog is there but has no plugins, marketplaces, MCP servers or applications in it yet."
        : $"{_catalogPath} has no plugins, marketplaces, MCP servers or applications in it yet.";

    private string RemoveMessage => _removing is null
        ? string.Empty
        : $"{_removing.Name} is dropped from the catalog, along with anything this PC had overridden about it. The tool itself is not uninstalled.";

    /// <summary>Whether "Update all" has anything to do. A marketplace Claude has
    /// never been told about counts, even though it has no version to be behind:
    /// every Claude plugin id resolves against one, so a missing marketplace is a
    /// whole block of rows failing for a single reason.</summary>
    private bool CanUpdateAnyTool =>
        _tools.Any(tool => tool.CanUpdate || (tool.Kind is DevToolKind.Marketplace && !tool.Installed));

    /// <summary>
    /// What a row says when there is nothing to press.
    ///
    /// <para>Six answers rather than the two it started with. "Up to date" used to
    /// cover every row without an update button, which put it beside "not
    /// installed" on enabled tools the machine did not have, and beside "unknown"
    /// on tools whose version lookup had failed. Neither of those is a tool that
    /// is up to date.</para>
    ///
    /// <para>The two newest arms are what applications brought. A checklist row
    /// has no version on either side, so every version-shaped answer is a claim
    /// about nothing — "Version unknown" was true and useless, because the row
    /// never had one to look up. And a row with no mechanism behind it is not a
    /// row that failed; it is one somebody has to go and do, which is a different
    /// sentence and a different afternoon.</para>
    /// </summary>
    private static string ActionNote(DevToolInfo tool) => tool switch
    {
        { ConfiguredEnabled: false } => "Disabled",
        { ConfirmedByHand: true } => tool.Acknowledged ? "Confirmed by hand" : "Not confirmed yet",
        _ when ReportsDetection(tool) => tool.Installed ? "Detected" : "Not detected",
        { Installable: false } => HasNote(tool) ? "Install by hand — see the note" : "Install by hand",
        { AvailableVersionKnown: false } => "Version unknown",
        _ => "Up to date"
    };

    /// <summary>
    /// Whether this row answers "is it there" rather than "which version".
    ///
    /// <para>The no-version sentinel in the installed column is what says so, and
    /// it is put there by exactly one thing: a probe that matched — or failed to
    /// match — a substring in some prose, because the thing it asks about has no
    /// version anywhere. Rendering that as a version column is how "Dev Drive
    /// configured" came to read "—" opposite "Version unknown", which is three
    /// words about a lookup nobody attempted.</para>
    /// </summary>
    private static bool ReportsDetection(DevToolInfo tool) =>
        tool.Kind is DevToolKind.Application
        && !tool.ConfirmedByHand
        && string.Equals(tool.InstalledVersion.Trim(), DevToolOutput.NoVersion, StringComparison.Ordinal);

    /// <summary>What the Installed column reads, which is not always a version.
    ///
    /// <para>A manual row never says a version and never says "installed": nothing
    /// looked, and the column has to keep saying so — that is the whole reason the
    /// manual provider is not just an unchecked box on an ordinary row.</para></summary>
    private static string InstalledLabel(DevToolInfo tool) => tool switch
    {
        { ConfirmedByHand: true } => tool.Acknowledged ? "Confirmed by hand" : "Not confirmed",
        _ when ReportsDetection(tool) => tool.Installed ? "Detected" : "Not detected",
        _ => tool.InstalledVersion
    };

    /// <summary>
    /// The row's status, without whatever the catalog had to add to it.
    ///
    /// <para>The port hands both down one string, joined by a middle dot: the
    /// status is what was found and the notes are what the entry wanted said
    /// about it, and a host with nothing to add sends the status alone. Split
    /// here rather than left as one line because several of the notes are two
    /// sentences of warning, and run together with "not installed" they read as
    /// part of the finding rather than as the caveat on it.</para>
    /// </summary>
    private static string StatusOf(DevToolInfo tool) => Split(tool.Status).Status;

    /// <inheritdoc cref="StatusOf" />
    private static string? NoteOf(DevToolInfo tool) => Split(tool.Status).Note;

    private static bool HasNote(DevToolInfo tool) => NoteOf(tool) is { Length: > 0 };

    private const string NoteSeparator = " · ";

    private static (string Status, string? Note) Split(string status)
    {
        var index = status.IndexOf(NoteSeparator, StringComparison.Ordinal);

        return index < 0
            ? (status, null)
            : (status[..index], status[(index + NoteSeparator.Length)..]);
    }

    /// <summary>
    /// The rows, filed under a heading per kind and — for applications — a
    /// sub-heading per group.
    ///
    /// <para>Grouped in the order the rows arrive rather than in an order this
    /// pane decides: <see cref="Enumerable.GroupBy{TSource, TKey}(IEnumerable{TSource}, Func{TSource, TKey})"/>
    /// yields groups by first appearance, and the sequence the port answers in is
    /// the sequence the catalog is written in — which for a setup guide is the
    /// order somebody is meant to do the steps in.</para>
    /// </summary>
    private IReadOnlyList<ToolKindGroup> ToolKinds =>
        _tools
            .GroupBy(tool => tool.Kind)
            .Select(kind => new ToolKindGroup(
                kind.Key,
                KindTitle(kind.Key),
                kind
                    .GroupBy(tool => string.IsNullOrWhiteSpace(tool.Group) ? null : tool.Group.Trim())
                    .Select(group => new ToolGroup($"{kind.Key}:{group.Key ?? "all"}", group.Key, group.ToArray()))
                    .ToArray()))
            .ToArray();

    /// <summary>The heading a kind files under, spelled out with no catch-all for
    /// the reason the port's own key mint has none: a kind added to the enum and
    /// not named here should fail to compile rather than inherit a heading that
    /// is about something else.</summary>
    private static string KindTitle(DevToolKind kind) => kind switch
    {
        DevToolKind.Plugin => "Plugins",
        DevToolKind.McpServer => "MCP servers",
        DevToolKind.Marketplace => "Claude marketplaces",
        DevToolKind.Application => "Applications"
    };

    /// <summary>How much is under a heading, and how much of it still wants
    /// something. The second number is the one worth reading: a closed group has
    /// to be able to say it is closed because there is nothing in it to do.</summary>
    private static string KindCount(ToolKindGroup kind) => Counted(kind.Count, kind.Outstanding);

    private static string GroupLabel(ToolGroup group, string title) =>
        $"{title} — {Counted(group.Tools.Count, group.Outstanding)}";

    private static string Counted(int count, int outstanding) => outstanding == 0
        ? $"{count} row(s), nothing outstanding"
        : $"{count} row(s), {outstanding} outstanding";

    /// <summary>
    /// Whether a row still wants something done about it.
    ///
    /// <para>What decides which groups open by themselves. A machine that is set
    /// up correctly should open this pane to headings and no rows; the fifty-odd
    /// rows behind them are worth having and are not worth scrolling past every
    /// time. A row this machine has switched off wants nothing by definition —
    /// that is what switching it off said.</para>
    /// </summary>
    private static bool NeedsAttention(DevToolInfo tool) => tool switch
    {
        { ConfiguredEnabled: false } => false,
        { ConfirmedByHand: true } => !tool.Acknowledged,
        { Kind: DevToolKind.Marketplace } => !tool.Installed,
        _ => tool.CanUpdate || tool.CanInstall
    };

    /// <summary>Whichever groups somebody has opened or closed by hand. Held per
    /// group key so it survives a refresh: checking for updates re-reads every row
    /// and would otherwise close a group the reader had just opened to watch.</summary>
    private readonly Dictionary<string, bool> _expanded = new(StringComparer.Ordinal);

    /// <summary>A hand toggle wins; otherwise a group opens when it has something
    /// outstanding, and an ungrouped kind is always open — it is the three-row
    /// list this pane started as, and there is nothing there to fold away.</summary>
    private bool IsExpanded(ToolGroup group) => _expanded.TryGetValue(group.Key, out var expanded)
        ? expanded
        : group.Title is null || group.Outstanding > 0;

    private void SetExpanded(ToolGroup group, bool expanded) => _expanded[group.Key] = expanded;

    /// <summary>One heading's worth of rows: a kind's whole list when the entries
    /// file themselves under nothing, and one of a kind's sub-groups when they
    /// do.</summary>
    private sealed record ToolGroup(string Key, string? Title, IReadOnlyList<DevToolInfo> Tools)
    {
        public int Outstanding => Tools.Count(NeedsAttention);

        /// <summary>What the fold's trigger points <c>aria-controls</c> at. Derived
        /// from the key rather than generated, so the id a driver reads off the
        /// trigger is the id of the table it opens, across re-renders.</summary>
        public string RegionId => "tools-group-" + new string(Key.Select(ch => char.IsLetterOrDigit(ch) ? char.ToLowerInvariant(ch) : '-').ToArray());

        /// <summary>The table's own label. A screen reader landing in one of a
        /// dozen tables needs to know which, and "Configured tools" said twelve
        /// times is the same as saying nothing.</summary>
        public string AriaLabel(string kindTitle) => Title is { Length: > 0 } title ? $"{kindTitle}: {title}" : kindTitle;
    }

    /// <summary>Every group under one kind's heading.</summary>
    private sealed record ToolKindGroup(DevToolKind Kind, string Title, IReadOnlyList<ToolGroup> Groups)
    {
        public int Count => Groups.Sum(group => group.Tools.Count);

        public int Outstanding => Groups.Sum(group => group.Outstanding);
    }

    private const string ImportPlaceholder = """{ "plugins": [], "mcpServers": [] }""";

    /// <summary>The two acts that move a machine with no catalog on. Null when the
    /// host cannot write one, which drops the action row entirely rather than
    /// drawing an empty one under the description.</summary>
    private RenderFragment? NoCatalogActions => !CanEdit ? null :
        @<text>
            <AppButton Variant="ButtonVariant.Primary" Disabled="@ToolActionBusy" OnClick="CreateCatalogAsync" TestId="tools-create-catalog">
                @(_toolActionKey == CreateKey ? "Creating..." : "Create catalog")
            </AppButton>
            <AppButton Variant="ButtonVariant.Secondary" Disabled="@ToolActionBusy" OnClick="OpenImportDialog" TestId="tools-import-open">
                Import JSON…
            </AppButton>
        </text>;

    /// <inheritdoc cref="NoCatalogActions" />
    private RenderFragment? EmptyCatalogActions => !CanEdit ? null :
        @<text>
            <AppButton Variant="ButtonVariant.Primary" Disabled="@ToolActionBusy" OnClick="OpenAddDialog" TestId="tools-add-open">
                Add tool
            </AppButton>
            <AppButton Variant="ButtonVariant.Ghost" Disabled="@ToolActionBusy" OnClick="OpenImportDialog" TestId="tools-import-open">
                Import JSON…
            </AppButton>
        </text>;

    private static readonly IReadOnlyList<SelectorOption> KindOptions =
    [
        new(nameof(DevToolKind.Plugin), "Plugin"),
        new(nameof(DevToolKind.McpServer), "MCP server"),
        new(nameof(DevToolKind.Marketplace), "Claude marketplace"),
        new(nameof(DevToolKind.Application), "Application")
    ];

    /// <summary>What can install an application. The one kind whose mechanism is
    /// declared rather than implied by the kind itself, which is why this list
    /// exists at all — the other three are their own mechanism.</summary>
    private static readonly IReadOnlyList<SelectorOption> ProviderOptions =
    [
        new(nameof(DevToolProvider.Winget), "winget package"),
        new(nameof(DevToolProvider.VsCodeExtension), "VS Code extension"),
        new(nameof(DevToolProvider.Command), "A command it declares"),
        new(nameof(DevToolProvider.Manual), "Nothing — confirmed by hand")
    ];

    /// <summary>The id is a different thing per mechanism, and naming the wrong
    /// one is the mistake this form is most likely to invite: a winget id and an
    /// extension id look alike and are not interchangeable.</summary>
    private string ApplicationIdHelp => _draftProvider switch
    {
        DevToolProvider.Winget => "The exact winget package id, as 'winget search' lists it.",
        DevToolProvider.VsCodeExtension => "The extension's marketplace id: publisher.name.",
        DevToolProvider.Command => "A slug for this check. It is what the row and any per-PC override are addressed by.",
        DevToolProvider.Manual => "A slug for this check. Nothing is run for it; it carries a tick per machine."
    };

    /// <summary>Both first, because it is both the default and the common answer:
    /// an entry that says nothing about hosts is an entry for both, and the catalog
    /// writes the property only when the answer is one of the other two.</summary>
    private static readonly IReadOnlyList<SelectorOption> HostOptions =
    [
        new(nameof(DevToolHosts.Default), "Copilot and Claude"),
        new(nameof(DevToolHosts.Copilot), "Copilot only"),
        new(nameof(DevToolHosts.Claude), "Claude only")
    ];

    /// <summary>The plugin kinds the desktop host actually branches on, plus the
    /// empty option for the ordinary case. Not read from the port: the host reads
    /// this string as free text, so a catalog can carry one nothing here has met
    /// and a hand edit stays the way to write it.</summary>
    private static readonly IReadOnlyList<SelectorOption> PluginKindOptions =
    [
        new("repository-skills", "Repository skills"),
        new("repository-canvases", "Repository canvases")
    ];

    /// <summary>Every command as one block, in the order it ran: the line you
    /// could have typed, whatever it printed, and the exit code only when it is
    /// not zero — a command that succeeded has already said so by printing
    /// nothing alarming, and a column of "exit code 0" would bury the one line
    /// that is worth finding.</summary>
    private string CommandLog =>
        string.Join(Environment.NewLine + Environment.NewLine, _commands.Select(Transcribe));

    private static string Transcribe(DevToolCommand command)
    {
        var lines = new List<string> { $"$ {command.CommandLine}" };

        if (command.Output.Length > 0)
        {
            lines.Add(command.Output);
        }

        if (command.ExitCode != 0)
        {
            lines.Add($"exit code {command.ExitCode}");
        }

        return string.Join(Environment.NewLine, lines);
    }

    private async Task RefreshToolsAsync()
    {
        _toolsLoading = true;
        _toolMessage = null;
        try
        {
            var catalog = await DevTools.ListAsync();
            _tools = catalog.Tools;
            _toolMessage = catalog.Message;
            _catalogExists = catalog.CatalogExists;
            _catalogPath = catalog.CatalogPath;
            _canEditCatalog = catalog.CanEditCatalog;
            _commands = catalog.Commands;
        }
        catch (Exception ex)
        {
            _toolMessage = $"Tools could not be checked: {ex.Message}";
        }
        finally
        {
            _toolsLoading = false;
        }
    }

    private async Task UpdateAllToolsAsync()
    {
        _toolActionKey = UpdateAllKey;
        try
        {
            var result = await DevTools.UpdateAllAsync();
            _toolMessage = result.Message;
            if (result.Succeeded)
            {
                await RefreshToolsAsync();
            }

            // After the refresh rather than before it. The refresh runs a dozen
            // commands of its own, and letting those land last would replace the
            // update the reader just asked about with the check that followed it.
            _commands = result.Commands;
        }
        finally
        {
            _toolActionKey = null;
        }
    }

    private async Task ApplyToolActionAsync(DevToolInfo tool, DevToolAction action)
    {
        _toolActionKey = tool.Key;
        try
        {
            var result = action switch
            {
                DevToolAction.Update => await DevTools.UpdateAsync(tool.Key),
                DevToolAction.Enable => await DevTools.EnableAsync(tool.Key),
                DevToolAction.Disable => await DevTools.DisableAsync(tool.Key),
                _ => DevToolActionResult.Failed("Unknown tool action.")
            };

            _toolMessage = result.Message;
            if (result.Succeeded)
            {
                await RefreshToolsAsync();
            }

            // See UpdateAllToolsAsync: the action's commands win over the
            // refresh's, because the action is what the reader pressed.
            _commands = result.Commands;
        }
        finally
        {
            _toolActionKey = null;
        }
    }

    /// <summary>
    /// The one row whose control is not an action verb.
    /// </summary>
    /// <param name="acknowledged">Whichever way the box has just gone. Passed
    /// through rather than toggled from what the row last showed: the row is
    /// re-read after every action, and a toggle computed from a stale copy would
    /// write back the state nobody asked for.</param>
    private async Task AcknowledgeAsync(DevToolInfo tool, bool acknowledged)
    {
        _toolActionKey = tool.Key;
        try
        {
            var result = await DevTools.AcknowledgeAsync(tool.Key, acknowledged);
            _toolMessage = result.Message;
            if (result.Succeeded)
            {
                await RefreshToolsAsync();
            }

            // See UpdateAllToolsAsync: the action's commands win over the
            // refresh's, because the action is what the reader pressed.
            _commands = result.Commands;
        }
        finally
        {
            _toolActionKey = null;
        }
    }

    private Task CreateCatalogAsync() => RunCatalogEditAsync(CreateKey, () => DevTools.CreateCatalogAsync());

    private void OpenAddDialog()
    {
        ResetDraft();
        _addOpen = true;
    }

    private void CloseAddDialog() => _addOpen = false;

    private void OnAddOpenChanged(bool open) => _addOpen = open;

    private void OnDraftKindChanged(string? value)
    {
        // Spelled out for every kind, because the arm this joins is the same
        // fall-through the add form's field chain was: a kind not named here
        // silently becomes a plugin, and the dialog then reads back the kind the
        // reader did not pick.
        _draftKind = value switch
        {
            nameof(DevToolKind.McpServer) => DevToolKind.McpServer,
            nameof(DevToolKind.Marketplace) => DevToolKind.Marketplace,
            nameof(DevToolKind.Application) => DevToolKind.Application,
            _ => DevToolKind.Plugin
        };

        // The fields the other kind filled in are not this kind's fields, and a
        // stale error under a field that is no longer on screen would reappear
        // over whichever field takes its place.
        _draftIdError = null;
        _draftSourceError = null;
        _draftDetectError = null;
    }

    private void OnDraftProviderChanged(string? value)
    {
        _draftProvider = value switch
        {
            nameof(DevToolProvider.VsCodeExtension) => DevToolProvider.VsCodeExtension,
            nameof(DevToolProvider.Command) => DevToolProvider.Command,
            nameof(DevToolProvider.Manual) => DevToolProvider.Manual,
            _ => DevToolProvider.Winget
        };

        // The command boxes leave the screen with the mechanism that has them.
        _draftDetectError = null;
    }

    private void OnDraftHostsChanged(string? value) => _draftHosts = value switch
    {
        nameof(DevToolHosts.Copilot) => DevToolHosts.Copilot,
        nameof(DevToolHosts.Claude) => DevToolHosts.Claude,
        _ => DevToolHosts.Default
    };

    /// <summary>
    /// What the form can decide on its own, decided on its own. The port validates
    /// the same things and would answer with the same words, but its answer lands
    /// on the pane's status line — and "a plugin needs a source" belongs under the
    /// source field, not at the top of the dialog.
    /// </summary>
    private async Task SubmitAddAsync()
    {
        _draftIdError = null;
        _draftSourceError = null;
        _draftDetectError = null;

        var plugin = _draftKind is DevToolKind.Plugin;
        var marketplace = _draftKind is DevToolKind.Marketplace;
        var application = _draftKind is DevToolKind.Application;
        var command = application && _draftProvider is DevToolProvider.Command;

        // Spelled out per kind rather than as the two-way ternary this replaced,
        // whose else was the MCP server's package id: an application submitted
        // whatever was in a box it never showed, under an id nobody typed.
        var id = (_draftKind switch
        {
            DevToolKind.Plugin => _draftPluginName,
            DevToolKind.Marketplace => _draftMarketplaceName,
            DevToolKind.Application => _draftApplicationId,
            DevToolKind.McpServer => _draftPackageId
        }).Trim();

        if (id.Length == 0)
        {
            _draftIdError = _draftKind switch
            {
                DevToolKind.Plugin => "A plugin needs a name.",
                DevToolKind.Marketplace => "A marketplace needs a name.",
                DevToolKind.Application => "An application needs an id.",
                DevToolKind.McpServer => "An MCP server needs a package id."
            };
        }

        // A marketplace is all source — a name with nothing behind it is a name
        // Claude has no way to resolve — so it is required for the same reason a
        // plugin's is.
        if ((plugin || marketplace) && string.IsNullOrWhiteSpace(_draftSource))
        {
            _draftSourceError = plugin ? "A plugin needs a source." : "A marketplace needs a source.";
        }

        // The same thing the port refuses, refused under the field it is about.
        if (command && string.IsNullOrWhiteSpace(_draftDetectCommand))
        {
            _draftDetectError = "A command application needs a detect command.";
        }

        if (_draftIdError is not null || _draftSourceError is not null || _draftDetectError is not null)
        {
            return;
        }

        var draft = new DevToolDraft(
            _draftKind,
            id,
            plugin || marketplace ? _draftSource.Trim() : null,
            plugin || marketplace ? null : NullIfBlank(_draftDisplayName),
            plugin ? NullIfBlank(_draftPluginKind) : null)
        {
            // A marketplace is a Claude mechanism whatever the form last had
            // selected, and an application is not an AI host's tool at all —
            // neither has the hosts selector on screen, so neither inherits
            // whatever it was left on.
            Hosts = marketplace ? DevToolHosts.Claude : application ? DevToolHosts.None : _draftHosts,
            ClaudeName = plugin ? NullIfBlank(_draftClaudeName) : null,
            ClaudeMarketplace = plugin ? NullIfBlank(_draftClaudeMarketplace) : null,
            ClaudeServerName = plugin || marketplace || application ? null : NullIfBlank(_draftClaudeServerName),
            ClaudeCommand = plugin || marketplace || application ? null : NullIfBlank(_draftClaudeCommand),
            ClaudeArgs = plugin || marketplace || application ? [] : SplitArgs(_draftClaudeArgs),

            // Written even when it is the default, unlike everything above: the
            // catalog's silence means "both hosts" and "no override" for the rest,
            // and means nothing at all for a mechanism.
            Provider = application ? _draftProvider : DevToolProvider.Winget,
            DetectCommand = command ? NullIfBlank(_draftDetectCommand) : null,
            DetectArgs = command ? SplitArgs(_draftDetectArgs) : [],
            DetectExpect = command ? NullIfBlank(_draftDetectExpect) : null,
            InstallCommand = command ? NullIfBlank(_draftInstallCommand) : null,
            InstallArgs = command ? SplitArgs(_draftInstallArgs) : []
        };

        if (await RunCatalogEditAsync(AddKey, () => DevTools.AddAsync(draft)))
        {
            _addOpen = false;
            ResetDraft();
        }
    }

    /// <summary>The arguments box as an argument list. Split on whitespace, which
    /// is what the field says it does and what an argument list looks like when it
    /// is typed rather than assembled — <c>agent mcp</c>, not a JSON array.</summary>
    private static IReadOnlyList<string> SplitArgs(string value) =>
        value.Split((char[])[' ', '\t'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private void OpenImportDialog()
    {
        _importJson = string.Empty;
        _importError = null;
        _importOpen = true;
    }

    private void CloseImportDialog() => _importOpen = false;

    private void OnImportOpenChanged(bool open) => _importOpen = open;

    /// <summary>The file and the paste box are one value. Picking a file fills the
    /// box, so what is about to be imported is on screen either way and there is
    /// never a question of which of the two won.</summary>
    private void OnImportFileRead(string text)
    {
        _importJson = text;
        _importError = null;
    }

    private void OnImportFileRejected(string message) => _importError = message;

    private async Task SubmitImportAsync()
    {
        if (string.IsNullOrWhiteSpace(_importJson))
        {
            _importError = "Choose a file or paste the catalog JSON.";
            return;
        }

        _importError = null;

        if (await RunCatalogEditAsync(ImportKey, () => DevTools.ImportAsync(_importJson)))
        {
            _importOpen = false;
            _importJson = string.Empty;
        }
    }

    /// <summary>Arms the confirm dialog. Nothing is removed here — the first click
    /// asks, and only the confirm calls the port.</summary>
    private void AskToRemove(DevToolInfo tool) => _removing = tool;

    private void CancelRemove() => _removing = null;

    private async Task ConfirmRemoveAsync()
    {
        if (_removing is not { } tool)
        {
            return;
        }

        _removing = null;
        await RunCatalogEditAsync(tool.Key, () => DevTools.RemoveAsync(tool.Key));
    }

    /// <summary>
    /// The four catalog edits run the same way: hold the busy key, call the port,
    /// put whatever it says on the status line, and re-read only when it worked.
    ///
    /// <para>Only on success, deliberately. A refresh after a failed edit would
    /// replace the reason it failed with the ordinary "showing tools from ..."
    /// line, which is the one moment that line is worth less than what it
    /// overwrites.</para>
    /// </summary>
    private async Task<bool> RunCatalogEditAsync(string busyKey, Func<Task<DevToolActionResult>> edit)
    {
        _toolActionKey = busyKey;
        try
        {
            var result = await edit();
            _toolMessage = result.Message;

            if (!result.Succeeded)
            {
                return false;
            }

            await RefreshToolsAsync();
            return true;
        }
        finally
        {
            _toolActionKey = null;
        }
    }

    private void ResetDraft()
    {
        _draftKind = DevToolKind.Plugin;
        _draftHosts = DevToolHosts.Default;
        _draftPluginName = string.Empty;
        _draftSource = string.Empty;
        _draftPluginKind = string.Empty;
        _draftPackageId = string.Empty;
        _draftDisplayName = string.Empty;
        _draftMarketplaceName = string.Empty;
        _draftClaudeName = string.Empty;
        _draftClaudeMarketplace = string.Empty;
        _draftClaudeServerName = string.Empty;
        _draftClaudeCommand = string.Empty;
        _draftClaudeArgs = string.Empty;
        _draftProvider = DevToolProvider.Winget;
        _draftApplicationId = string.Empty;
        _draftDetectCommand = string.Empty;
        _draftDetectArgs = string.Empty;
        _draftDetectExpect = string.Empty;
        _draftInstallCommand = string.Empty;
        _draftInstallArgs = string.Empty;
        _draftIdError = null;
        _draftSourceError = null;
        _draftDetectError = null;
    }

    /// <summary>Which hosts a row is for, short enough to sit beside the name.
    /// Both hosts is spelled out rather than left blank: a row that says nothing about
    /// hosts is indistinguishable from one whose badge failed to render, and the
    /// whole point of the badge is that the answer is never assumed.</summary>
    private static string HostLabel(DevToolHosts hosts) => hosts switch
    {
        DevToolHosts.Copilot => "Copilot",
        DevToolHosts.Claude => "Claude",
        DevToolHosts.Default => "Copilot + Claude",
        _ => "No host"
    };

    /// <summary>The badge's tooltip: what each host answered, when they answered
    /// differently enough to be worth reading one by one. A row whose hosts agree
    /// gets no tooltip, because the columns already say it.</summary>
    private static string? HostTitle(DevToolInfo tool) => tool.HostStates.Count < 2
        ? null
        : string.Join(" · ", tool.HostStates.Select(state => $"{HostLabel(state.Host)}: {state.Status}"));

    private static string? NullIfBlank(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string Humanize(string enumName)
    {
        var text = System.Text.RegularExpressions.Regex.Replace(enumName, "(?<!^)([A-Z])", " $1");
        return text.ToLowerInvariant();
    }
}
