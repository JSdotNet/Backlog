    private void OnDraftKindChanged(string? value)
    {
        // Spelled out for every kind, because the arm this joins is the same
        // fall-through the add form's field chain was: a kind not named here
        // silently becomes a plugin, and the dialog then reads back the kind the
        // reader did not pick.
        _draftKind = value switch
        {
            nameof(DevToolKind.McpServer) => DevToolKind.McpServer,
            nameof(DevToolKind.Marketplace) => DevToolKind.Marketplace,
            nameof(DevToolKind.Application) => DevToolKind.Application,
            _ => DevToolKind.Plugin
        };

        // The fields the other kind filled in are not this kind's fields, and a
        // stale error under a field that is no longer on screen would reappear
        // over whichever field takes its place.
        _draftIdError = null;
        _draftSourceError = null;
        _draftDetectError = null;
        _draftCommandError = null;
    }

    /// <summary>Which kind of MCP server is being added. Spelled out like the
    /// kind above it and with the same fall-through, but landing on the .NET
    /// tool: that is what every entry written before there was a choice was, and
    /// a mechanism that writes no package id at all is not somewhere a value
    /// nobody typed should end up.
    ///
    /// <para>Every offered option is named here. The fall-through is for a value
    /// the select never held, and an option missing from this list is one somebody
    /// picks and silently gets a .NET tool for — which was true of <c>http</c>
    /// until the arm below existed.</para></summary>
    private void OnDraftMcpMechanismChanged(string? value)
    {
        _draftMcpMechanism = value switch
        {
            nameof(DevToolMcpMechanism.Command) => DevToolMcpMechanism.Command,
            nameof(DevToolMcpMechanism.Http) => DevToolMcpMechanism.Http,
            _ => DevToolMcpMechanism.DotNetTool
        };

        // The id box changes with the mechanism, so an error under the one that
        // has just left the screen would reappear over the one replacing it.
        _draftIdError = null;
        _draftCommandError = null;
    }

    private void OnDraftProviderChanged(string? value)
    {
        _draftProvider = value switch
        {
            nameof(DevToolProvider.VsCodeExtension) => DevToolProvider.VsCodeExtension,
            nameof(DevToolProvider.Command) => DevToolProvider.Command,
            nameof(DevToolProvider.Manual) => DevToolProvider.Manual,
            _ => DevToolProvider.Winget
        };

        // The command boxes leave the screen with the mechanism that has them.
        _draftDetectError = null;
    }

    private void OnDraftHostsChanged(string? value) => _draftHosts = value switch
    {
        nameof(DevToolHosts.Copilot) => DevToolHosts.Copilot,
        nameof(DevToolHosts.Claude) => DevToolHosts.Claude,
        _ => DevToolHosts.Default
    };

    /// <summary>
    /// What the form can decide on its own, decided on its own. The port validates
    /// the same things and would answer with the same words, but its answer lands
    /// on the pane's status line — and "a plugin needs a source" belongs under the
    /// source field, not at the top of the dialog.
    /// </summary>
    private async Task SubmitAddAsync()
    {
        _draftIdError = null;
        _draftSourceError = null;
        _draftDetectError = null;
        _draftCommandError = null;

        var plugin = _draftKind is DevToolKind.Plugin;
        var marketplace = _draftKind is DevToolKind.Marketplace;
        var application = _draftKind is DevToolKind.Application;
        var command = application && _draftProvider is DevToolProvider.Command;

        // The two mechanisms the mcpServers array holds that are identified by a
        // name rather than by a package id. Read once here rather than at each of
        // the places that ask, and kept as two flags because they differ in what
        // the entry then has to carry: a command, or a URL.
        var registeredByCommand = _draftKind is DevToolKind.McpServer && _draftMcpMechanism is DevToolMcpMechanism.Command;
        var reachedAtUrl = _draftKind is DevToolKind.McpServer && _draftMcpMechanism is DevToolMcpMechanism.Http;
        var namedServer = registeredByCommand || reachedAtUrl;

        // Spelled out per kind rather than as the two-way ternary this replaced,
        // whose else was the MCP server's package id: an application submitted
        // whatever was in a box it never showed, under an id nobody typed.
        var id = (_draftKind switch
        {
            DevToolKind.Plugin => _draftPluginName,
            DevToolKind.Marketplace => _draftMarketplaceName,
            DevToolKind.Application => _draftApplicationId,
            DevToolKind.McpServer => namedServer ? _draftServerName : _draftPackageId
        }).Trim();

        if (id.Length == 0)
        {
            _draftIdError = _draftKind switch
            {
                DevToolKind.Plugin => "A plugin needs a name.",
                DevToolKind.Marketplace => "A marketplace needs a name.",
                DevToolKind.Application => "An application needs an id.",
                // The port's own three sentences, so the message under the field
                // and the message the port would have thrown say the same thing.
                DevToolKind.McpServer => reachedAtUrl
                    ? "An MCP server reached over HTTP needs a name."
                    : registeredByCommand
                        ? "An MCP server registered by a command needs a name."
                        : "An MCP server needs a package id."
            };
        }

        // A marketplace is all source — a name with nothing behind it is a name
        // Claude has no way to resolve — so it is required for the same reason a
        // plugin's is.
        if ((plugin || marketplace) && string.IsNullOrWhiteSpace(_draftSource))
        {
            _draftSourceError = plugin ? "A plugin needs a source." : "A marketplace needs a source.";
        }

        // The same thing the port refuses, refused under the field it is about.
        if (command && string.IsNullOrWhiteSpace(_draftDetectCommand))
        {
            _draftDetectError = "A command application needs a detect command.";
        }

        // And the same again for the server that is registered rather than
        // installed: with no package id there is nothing to install it by, so the
        // command is the one thing that entry cannot be written without.
        if (registeredByCommand && string.IsNullOrWhiteSpace(_draftServerCommand))
        {
            _draftCommandError = "An MCP server registered by a command needs a command.";
        }

        // And the HTTP half of the same rule, under the field it is about: a
        // server that is reached rather than started says where.
        if (reachedAtUrl && string.IsNullOrWhiteSpace(_draftServerUrl))
        {
            _draftCommandError = "An MCP server reached over HTTP needs the URL that serves it.";
        }

        if (_draftIdError is not null || _draftSourceError is not null || _draftDetectError is not null || _draftCommandError is not null)
        {
            return;
        }

        var draft = new DevToolDraft(
            _draftKind,
            id,
            plugin || marketplace ? _draftSource.Trim() : null,
            plugin || marketplace ? null : NullIfBlank(_draftDisplayName),
            plugin ? NullIfBlank(_draftPluginKind) : null)
        {
            // A marketplace is a Claude mechanism whatever the form last had
            // selected, and an application is not an AI host's tool at all —
            // neither has the hosts selector on screen, so neither inherits
            // whatever it was left on.
            Hosts = marketplace ? DevToolHosts.Claude : application ? DevToolHosts.None : _draftHosts,
            ClaudeName = plugin ? NullIfBlank(_draftClaudeName) : null,
            ClaudeMarketplace = plugin ? NullIfBlank(_draftClaudeMarketplace) : null,
            // A command-registered server is asked for no Claude section at
            // all: its own command is what every host it targets is registered
            // with, so a section here would be a second place for the same command
            // to drift — and the boxes are not on screen for it to have been typed
            // into.
            ClaudeServerName = plugin || marketplace || application || namedServer ? null : NullIfBlank(_draftClaudeServerName),
            ClaudeCommand = plugin || marketplace || application || namedServer ? null : NullIfBlank(_draftClaudeCommand),
            ClaudeArgs = plugin || marketplace || application || namedServer ? [] : SplitArgs(_draftClaudeArgs),

            // Which of the two kinds of MCP server this is. Not written into the
            // entry — the shape of what is written says it — but the port needs it
            // to know whether the id it was handed is a package id or a name.
            McpMechanism = _draftKind is DevToolKind.McpServer ? _draftMcpMechanism : DevToolMcpMechanism.DotNetTool,
            ServerCommand = registeredByCommand ? NullIfBlank(_draftServerCommand) : null,
            ServerArgs = registeredByCommand ? SplitArgs(_draftServerArgs) : [],
            ServerUrl = reachedAtUrl ? NullIfBlank(_draftServerUrl) : null,
            ServerHeaders = reachedAtUrl ? SplitHeaders(_draftServerHeaders) : [],

            // Written even when it is the default, unlike everything above: the
            // catalog's silence means "both hosts" and "no override" for the rest,
            // and means nothing at all for a mechanism.
            Provider = application ? _draftProvider : DevToolProvider.Winget,
            DetectCommand = command ? NullIfBlank(_draftDetectCommand) : null,
            DetectArgs = command ? SplitArgs(_draftDetectArgs) : [],
            DetectExpect = command ? NullIfBlank(_draftDetectExpect) : null,
            InstallCommand = command ? NullIfBlank(_draftInstallCommand) : null,
            InstallArgs = command ? SplitArgs(_draftInstallArgs) : []
        };

        if (await RunCatalogEditAsync(AddKey, () => DevTools.AddAsync(draft)))
        {
            _addOpen = false;
            ResetDraft();
        }
    }

    /// <summary>The arguments box as an argument list. Split on whitespace, which
    /// is what the field says it does and what an argument list looks like when it
    /// is typed rather than assembled — <c>agent mcp</c>, not a JSON array.</summary>
    private static IReadOnlyList<string> SplitArgs(string value) =>
        value.Split((char[])[' ', '\t'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    /// <summary>The headers box as ordered name/value pairs — one per line, split
    /// at the first colon.
    ///
    /// <para>The first colon and not every colon, because the value is where a
    /// URL goes and a <c>Bearer</c> is not the only thing a header carries. Order
    /// is kept because it is what the repeated <c>--header</c> flags are built
    /// from, and a line with no colon is dropped rather than turned into a header
    /// with an empty value: half a header is not something to send.</para></summary>
    private static IReadOnlyList<KeyValuePair<string, string>> SplitHeaders(string value)
    {
        var headers = new List<KeyValuePair<string, string>>();

        foreach (var line in value.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var separator = line.IndexOf(':', StringComparison.Ordinal);
            if (separator <= 0)
            {
                continue;
            }

            var name = line[..separator].Trim();
            if (name.Length > 0)
            {
                headers.Add(new KeyValuePair<string, string>(name, line[(separator + 1)..].Trim()));
            }
        }

        return headers;
    }

