    private DevToolInfo? _removing;

    /// <summary>Raised when somebody dismisses the pane. Whether that hides it,
    /// collapses a stack or does nothing is the shell's decision — the pane only
    /// reports that the ✕ was pressed.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override Task OnInitializedAsync()
    {
        // Everything else this pane draws is written by its own buttons, and
        // each of those re-lists afterwards. The port's Changed is for the one
        // input nothing here touches: this machine's MCP server, whose port is
        // edited on the Settings screen and whose listener binds, fails and stops
        // on its own.
        DevTools.Changed += OnToolsChanged;

        RestoreView();

        return LoadAsync();
    }

    /// <summary>The listing and the last-run record, read side by side: the
    /// record is one small file, and the listing is not held up waiting on it.</summary>
    private async Task LoadAsync()
    {
        var lastRun = ReadLastRunAsync();
        await RefreshToolsAsync();
        await lastRun;
    }

    /// <summary>Lets go of the port's event. The shell renders this pane only
    /// while its surface is open, so this really does run — and without it a pane
    /// that has been closed stays on a singleton service's event, kept alive by
    /// it and re-listing into a renderer that has gone.</summary>
    public void Dispose() => DevTools.Changed -= OnToolsChanged;

    /// <summary>
    /// Something outside this pane changed what a listing would answer, so the
    /// listing is taken again.
    ///
    /// <para><c>InvokeAsync</c> is not optional: the raise arrives on whatever
    /// thread the MCP worker's bind or release finished on, which is a thread pool
    /// thread. And <c>StateHasChanged</c> is explicit for the other half of the
    /// same reason — this is not a component event callback, so Blazor does not
    /// render for free at the end of it.</para>
    ///
    /// <para>The guard is load-bearing rather than hygiene. Registering this
    /// machine's own server mints a token when it has none, and minting raises
    /// this very event from inside the apply that is still running — so without
    /// the guard, pressing Re-register on a fresh machine starts a full listing
    /// (winget, <c>dotnet tool list</c>, a dozen <c>claude</c> calls) in the middle
    /// of the registration it was asked for.</para>
    /// </summary>
    private void OnToolsChanged() => _ = InvokeAsync(async () =>
    {
        if (_toolsLoading || ToolActionBusy) return;

        await RefreshToolsAsync();
        StateHasChanged();
    });

    private bool ToolActionBusy => _toolActionKey is not null;

    private bool CanEdit => _canEditCatalog;

    /// <summary>Never empty, so the toolbar always has a status line. The
    /// shared alert renders nothing for a blank message, and "no message yet"
    /// here means the check is still running - which is the one thing the line
    /// most needs to say.</summary>
    private string ToolMessage => _toolMessage ?? "Checking configured tools...";

    /// <summary>The headings, in the order the row template writes its cells.
    ///
    /// <para>Each carries the class its column's floor is declared on, because the
    /// heading is the one cell in a column this pane does not write — the row
    /// template writes the cells and the component writes the headings — and a
    /// column with no floor is the clipping <c>ToolsInventoryLayoutTests</c> exists
    /// for.</para></summary>
    private static readonly DataTableColumn[] Columns =
    [
        new("Tool", "tools-inventory__col-tool"),
        new("Installed", "tools-inventory__col-version"),
        new("Available", "tools-inventory__col-version"),
        new("Status", "tools-inventory__col-status"),
        new("Actions", "tools-inventory__col-actions")
    ];

    /// <summary>What identifies a row across renders: the catalog key, which is the
    /// same thing the port acts on and is unique within the catalog.</summary>
    private static object ToolKey(DevToolInfo tool) => tool.Key;

    /// <summary>What the row element says about itself. The test ids inside a row
    /// are shared by every row, so a driver scopes them through this rather than
    /// through an id per row that nobody could write a selector for without
    /// knowing the catalog first.</summary>
    private static IReadOnlyDictionary<string, object> RowIdentity(DevToolInfo tool) =>
        new Dictionary<string, object>(StringComparer.Ordinal) { ["data-tool-key"] = tool.Key };

    /// <summary>A row this machine has switched off, drawn quieter. Null for the
    /// rest, which is the library's way of saying the host has nothing to add to
    /// this one.</summary>
    private static string? RowClass(DevToolInfo tool) =>
        tool.ConfiguredEnabled ? null : "tools-inventory__row--disabled";

    /// <summary>The placeholder inventory: two kind sections of three and two
    /// rows, and the width of each row's name bar.
    ///
    /// <para>Uneven on purpose. Bars of one length read as a pattern — a loading
    /// graphic — where a ragged right edge reads as names, which is the whole
    /// point of standing in for the content rather than announcing its absence.
    /// Two sections rather than the real four: enough to show the pane arrives
    /// grouped, without a screenful of grey where a short catalog is coming.</para></summary>
    private static readonly string[][] SkeletonSections =
    [
        ["62%", "78%", "45%"],
        ["70%", "52%"]
    ];

    private string NoCatalogDescription => _catalogPath.Length == 0
        ? "This machine has no tool catalog. Create one, or import a catalog you already have."
        : $"Nothing has been configured on this machine yet. The catalog will be written to {_catalogPath}.";

    /// <summary>Names all four kinds a catalog can hold, because this fires only
    /// when every one of them is empty. It said "no plugins or MCP servers" while
    /// those were the only two, and a person who had just added an applications
    /// array read a sentence that did not mention the thing they were editing.</summary>
    private string EmptyCatalogDescription => _catalogPath.Length == 0
        ? "The catalog is there but has no plugins, marketplaces, MCP servers or applications in it yet."
        : $"{_catalogPath} has no plugins, marketplaces, MCP servers or applications in it yet.";

    private string RemoveMessage => _removing is null
        ? string.Empty
        : $"{_removing.Name} is dropped from the catalog, along with anything this PC had overridden about it. The tool itself is not uninstalled.";

    /// <summary>Whether "Update all" has anything to do. A marketplace Claude has
    /// never been told about counts, even though it has no version to be behind:
    /// every Claude plugin id resolves against one, so a missing marketplace is a
    /// whole block of rows failing for a single reason.</summary>
    private bool CanUpdateAnyTool =>
        _tools.Any(tool => tool.CanUpdate || (tool.Kind is DevToolKind.Marketplace && !tool.Installed));

    /// <summary>How many cached folders across every row nothing loads any more
    /// — what "Clear stale cache" would delete, and whether it is offered at
    /// all.</summary>
    private int StaleCacheCount => _tools.Sum(tool => tool.StaleCachedVersions.Count);

    /// <summary>What a cached version's chip says beside the number. "In use" is
    /// the one that matters: it is why there is no Remove on it.</summary>
    private static string CacheUseLabel(DevToolCachedVersion cached) => cached.Installs switch
    {
        0 => "stale",
        1 => "in use",
        var count => $"in use by {count} installs"
    };

    /// <summary>The cache delete waiting on the person's word: one version of
    /// one tool, or — with no version — every stale version in the cache.</summary>
    private (DevToolInfo Tool, DevToolCachedVersion? Cached)? _cacheRemoval;

    private string CacheRemovalTitle => _cacheRemoval is { Cached: not null }
        ? "Remove this cached version?"
        : "Clear the stale cache?";

    private string CacheRemovalMessage => _cacheRemoval switch
    {
        null => string.Empty,
        { Cached: { } cached, Tool: var tool } =>
            $"{cached.Version} of {tool.Name} is deleted from Claude's plugin cache. Nothing loads it now; a scope that installs it later downloads it again.",
        _ => $"{StaleCacheCount} cached versions nothing loads are deleted from Claude's plugin cache. The versions in use stay; a scope that installs a removed one later downloads it again."
    };

    private void AskToRemoveCachedVersion(DevToolInfo tool, DevToolCachedVersion cached) => _cacheRemoval = (tool, cached);

    /// <summary>The subject is the pane rather than a tool; the tool half of
    /// the pair is whichever row is first, and is not read for the clear.</summary>
    private void AskToClearStaleCache() => _cacheRemoval = (_tools[0], null);

    private void CancelCacheRemoval() => _cacheRemoval = null;

    private async Task ConfirmCacheRemovalAsync()
    {
        if (_cacheRemoval is not { } removal)
        {
            return;
        }

        _cacheRemoval = null;
        if (removal.Cached is { } cached)
        {
            await RunCatalogEditAsync($"{removal.Tool.Key}|{cached.Version}", () => DevTools.RemoveCachedVersionAsync(removal.Tool.Key, cached.Version));
        }
        else
        {
            await RunCatalogEditAsync(ClearCacheKey, () => RecordRunAsync(DevToolRunKind.ClearStaleCache, () => DevTools.RemoveStaleCacheAsync()));
        }
    }

    /// <summary>
    /// What a row says when there is nothing to press.
    ///
    /// <para>Six answers rather than the two it started with. "Up to date" used to
    /// cover every row without an update button, which put it beside "not
    /// installed" on enabled tools the machine did not have, and beside "unknown"
    /// on tools whose version lookup had failed. Neither of those is a tool that
    /// is up to date.</para>
    ///
    /// <para>The two newest arms are what applications brought. A checklist row
    /// has no version on either side, so every version-shaped answer is a claim
    /// about nothing — "Version unknown" was true and useless, because the row
    /// never had one to look up. And a row with no mechanism behind it is not a
    /// row that failed; it is one somebody has to go and do, which is a different
    /// sentence and a different afternoon.</para>
    ///
    /// <para>And the newest is the MCP server that is not a .NET tool. "Install by
    /// hand" would be the wrong afternoon entirely for it: nobody is going to
    /// install anything, because the catalog registers it by the command it
    /// declares. What the row is short of is a package, and the status beside it
    /// says whether that is by design or because the mechanism it named is one
    /// this build has never heard of.</para>
    /// </summary>
    private static string ActionNote(DevToolInfo tool) => tool switch
    {
        { ConfiguredEnabled: false } => "Disabled",
        { ConfirmedByHand: true } => tool.Acknowledged ? "Confirmed by hand" : "Not confirmed yet",
        _ when ReportsDetection(tool) => tool.Installed ? "Detected" : "Not detected",
        { Kind: DevToolKind.McpServer, Installable: false } => "No .NET tool to install",
        { Installable: false } => HasNote(tool) ? "Install by hand — see the note" : "Install by hand",
        { AvailableVersionKnown: false } => "Version unknown",
        _ => "Up to date"
    };

    /// <summary>
    /// Whether this row answers "is it there" rather than "which version".
    ///
    /// <para>The no-version sentinel in the installed column is what says so, and
    /// it is put there by exactly one thing: a probe that matched — or failed to
    /// match — a substring in some prose, because the thing it asks about has no
    /// version anywhere. Rendering that as a version column is how "Dev Drive
    /// configured" came to read "—" opposite "Version unknown", which is three
    /// words about a lookup nobody attempted.</para>
    /// </summary>
    private static bool ReportsDetection(DevToolInfo tool) =>
        tool.Kind is DevToolKind.Application
        && !tool.ConfirmedByHand
        && string.Equals(tool.InstalledVersion.Trim(), DevToolOutput.NoVersion, StringComparison.Ordinal);

    /// <summary>What the Installed column reads, which is not always a version.
    ///
    /// <para>A manual row never says a version and never says "installed": nothing
    /// looked, and the column has to keep saying so — that is the whole reason the
    /// manual provider is not just an unchecked box on an ordinary row.</para></summary>
    private static string InstalledLabel(DevToolInfo tool) => tool switch
    {
        { ConfirmedByHand: true } => tool.Acknowledged ? "Confirmed by hand" : "Not confirmed",
        _ when ReportsDetection(tool) => tool.Installed ? "Detected" : "Not detected",
        _ => tool.InstalledVersion
    };

    /// <summary>
    /// The row's status, without whatever the catalog had to add to it.
    ///
    /// <para>The port hands both down one string, joined by a middle dot: the
    /// status is what was found and the notes are what the entry wanted said
    /// about it, and a host with nothing to add sends the status alone. Split
    /// here rather than left as one line because several of the notes are two
    /// sentences of warning, and run together with "not installed" they read as
    /// part of the finding rather than as the caveat on it.</para>
    /// </summary>
    private static string StatusOf(DevToolInfo tool) => Split(tool.Status).Status;

    /// <inheritdoc cref="StatusOf" />
    private static string? NoteOf(DevToolInfo tool) => Split(tool.Status).Note;

    private static bool HasNote(DevToolInfo tool) => NoteOf(tool) is { Length: > 0 };

    private const string NoteSeparator = " · ";

    private static (string Status, string? Note) Split(string status)
    {
        var index = status.IndexOf(NoteSeparator, StringComparison.Ordinal);

        return index < 0
            ? (status, null)
            : (status[..index], status[(index + NoteSeparator.Length)..]);
    }

    /// <summary>What a group's fold says: its title, how many rows, and how many of
    /// them are outstanding — so a folded group can be read without opening it.</summary>
    private static string GroupLabel(ToolGroup group) =>
        $"{group.Title} — {Counted(group.Tools.Count, group.Outstanding)}";

    private static string Counted(int count, int outstanding) => outstanding == 0
        ? $"{count} row(s), nothing outstanding"
        : $"{count} row(s), {outstanding} outstanding";

    /// <summary>Whichever groups somebody has opened or closed by hand. Held per
    /// group key so it survives a refresh: checking for updates re-reads every row
    /// and would otherwise close a group the reader had just opened to watch.</summary>
    private readonly Dictionary<string, bool> _expanded = new(StringComparer.Ordinal);

    /// <summary>A hand toggle wins; otherwise a group opens when it has something
    /// outstanding and starts folded when it has nothing — a correctly set-up
    /// machine opens a tab to cards and no rows.</summary>
    private bool IsExpanded(ToolGroup group) => _expanded.TryGetValue(group.Key, out var expanded)
        ? expanded
        : group.Outstanding > 0;

    private void SetExpanded(ToolGroup group, bool expanded) => _expanded[group.Key] = expanded;

    /// <summary>One card's worth of rows: one of the catalog's groups on a tab,
    /// or the tab's ungrouped rows.</summary>
    private sealed record ToolGroup(string Key, string Title, IReadOnlyList<DevToolInfo> Tools)
    {
        public int Outstanding => Tools.Count(NeedsAttention);

        /// <summary>What the fold's trigger points <c>aria-controls</c> at. Derived
        /// from the key rather than generated, so the id a driver reads off the
        /// trigger is the id of the table it opens, across re-renders.</summary>
        public string RegionId => "tools-group-" + new string(Key.Select(ch => char.IsLetterOrDigit(ch) ? char.ToLowerInvariant(ch) : '-').ToArray());

        /// <summary>The table's own label. A screen reader landing in one of a
        /// dozen tables needs to know which.</summary>
        public string AriaLabel(string tabTitle) => Title == tabTitle ? tabTitle : $"{tabTitle}: {Title}";
    }

    private const string ImportPlaceholder = """{ "plugins": [], "mcpServers": [] }""";

    /// <summary>The two acts that move a machine with no catalog on. Null when the
    /// host cannot write one, which drops the action row entirely rather than
    /// drawing an empty one under the description.</summary>
    private RenderFragment? NoCatalogActions => !CanEdit ? null :
        @<text>
            <AppButton Variant="ButtonVariant.Primary" Disabled="@ToolActionBusy" OnClick="CreateCatalogAsync" TestId="tools-create-catalog">
                @(_toolActionKey == CreateKey ? "Creating..." : "Create catalog")
            </AppButton>
            <AppButton Variant="ButtonVariant.Secondary" Disabled="@ToolActionBusy" OnClick="OpenImportDialog" TestId="tools-import-open">
                Import JSON…
            </AppButton>
        </text>;

    /// <inheritdoc cref="NoCatalogActions" />
    private RenderFragment? EmptyCatalogActions => !CanEdit ? null :
        @<text>
            <AppButton Variant="ButtonVariant.Primary" Disabled="@ToolActionBusy" OnClick="OpenAddDialog" TestId="tools-add-open">
                Add tool
            </AppButton>
            <AppButton Variant="ButtonVariant.Ghost" Disabled="@ToolActionBusy" OnClick="OpenImportDialog" TestId="tools-import-open">
                Import JSON…
            </AppButton>
        </text>;

    private static readonly IReadOnlyList<SelectorOption> KindOptions =
    [
        new(nameof(DevToolKind.Plugin), "Plugin"),
        new(nameof(DevToolKind.McpServer), "MCP server"),
        new(nameof(DevToolKind.Marketplace), "Claude marketplace"),
        new(nameof(DevToolKind.Application), "Application")
    ];

    /// <summary>What can install an application. The one kind whose mechanism is
    /// declared rather than implied by the kind itself, which is why this list
    /// exists at all — the other three are their own mechanism.</summary>
    private static readonly IReadOnlyList<SelectorOption> ProviderOptions =
    [
        new(nameof(DevToolProvider.Winget), "winget package"),
        new(nameof(DevToolProvider.VsCodeExtension), "VS Code extension"),
        new(nameof(DevToolProvider.Command), "A command it declares"),
        new(nameof(DevToolProvider.Manual), "Nothing — confirmed by hand")
    ];

    /// <summary>How an MCP server is reached. Three of the four mechanisms,
    /// because the fourth is where an entry whose declared mechanism this build
    /// does not recognise lands — a landing spot is not something to offer
    /// somebody as a choice.</summary>
    private static readonly IReadOnlyList<SelectorOption> McpMechanismOptions =
    [
        new(nameof(DevToolMcpMechanism.DotNetTool), "A .NET tool"),
        new(nameof(DevToolMcpMechanism.Command), "A command it declares"),
        new(nameof(DevToolMcpMechanism.Http), "A URL it is reached at")
    ];

    /// <summary>The id is a different thing per mechanism, and naming the wrong
    /// one is the mistake this form is most likely to invite: a winget id and an
    /// extension id look alike and are not interchangeable.</summary>
    private string ApplicationIdHelp => _draftProvider switch
    {
        DevToolProvider.Winget => "The exact winget package id, as 'winget search' lists it.",
        DevToolProvider.VsCodeExtension => "The extension's marketplace id: publisher.name.",
        DevToolProvider.Command => "A slug for this check. It is what the row and any per-PC override are addressed by.",
        DevToolProvider.Manual => "A slug for this check. Nothing is run for it; it carries a tick per machine."
