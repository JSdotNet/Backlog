    /// <summary>
    /// The four catalog edits — and the two cache deletes, which are edits to the
    /// machine rather than the catalog but want exactly this — run the same way:
    /// hold the busy key, call the port, put whatever it says on the status line,
    /// and re-read only when it worked.
    ///
    /// <para>Only on success, deliberately. A refresh after a failed edit would
    /// replace the reason it failed with the ordinary "showing tools from ..."
    /// line, which is the one moment that line is worth less than what it
    /// overwrites.</para>
    /// </summary>
    private async Task<bool> RunCatalogEditAsync(string busyKey, Func<Task<DevToolActionResult>> edit)
    {
        _toolActionKey = busyKey;
        try
        {
            var result = await edit();
            _toolMessage = result.Message;

            if (!result.Succeeded)
            {
                return false;
            }

            await RefreshToolsAsync();
            return true;
        }
        finally
        {
            _toolActionKey = null;
        }
    }

