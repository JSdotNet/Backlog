@inject ICopilotToolService CopilotTools

@*
    The system tools pane: which Copilot plugins, repository tools and MCP
    servers this machine is configured for, and what can be updated, enabled or
    disabled. It asks ICopilotToolService and renders the answer — which host is
    behind that port, and whether that host can do anything but read, is not
    something the pane knows.

    It owns its own loading for the same reason KnowledgePane does: the list is
    the pane's subject, and a shell holding it would be holding state about a
    context it only makes room for. The shell decides *whether* there is a tools
    pane — the feature flag and the header toggle stay there — and this decides
    what is in one.

    Three states, not two. "There is no catalog file" and "the catalog is empty"
    used to render the same sentence and the same nothing-to-do, which made a
    fresh machine a dead end: the one act that would have helped — write the
    catalog — was not on the screen. CatalogExists is what tells them apart, and
    each gets the affordance that actually moves it on.

    Every editing affordance is behind CanEditCatalog. A host that answers this
    port read-only says so once, and the create, add, import and remove controls
    are simply not drawn rather than drawn and refused.
*@

<section @key=@("tools-pane") class="tools-panel" id="tools-pane" aria-labelledby="installed-tools-title" data-testid="tools-panel">
    <header class="tools-panel__header">
        <div>
            <p class="tools-panel__eyebrow">System tools</p>
            <h2 id="installed-tools-title" class="tools-panel__title">System tools</h2>
            <p class="tools-panel__subtitle">Configured and disabled Copilot and Claude plugins, marketplaces, repository tools, and MCP servers.</p>
        </div>
        <div class="tools-panel__header-actions">
            @* The library's badge wearing this pane's count class. *@
            <Badge BaseClass="tools-panel__count" Kind="">@CountLabel</Badge>
            <IconButton AriaLabel="Close tools pane" CssClass="btn--ghost" OnClick="() => OnClose.InvokeAsync()">✕</IconButton>
        </div>
    </header>

    <div class="tools-panel__content" id="installed-tools-content">
        <div class="tools-panel__toolbar">
            @* The library's alert wearing this pane's message class. The fallback
               behind ToolMessage keeps it non-empty, so it never takes the alert's
               hidden shape: a toolbar that loses its status line collapses. *@
            <Alert Message="@ToolMessage" BaseClass="tools-panel__message" Role="status" />
            <div class="tools-panel__toolbar-actions">
                @* Checking and updating both read the catalog, so neither is offered
                   while there is no catalog to read. *@
                <AppButton Variant="ButtonVariant.Secondary" Disabled="@(!_catalogExists || _toolsLoading || ToolActionBusy)" OnClick="RefreshToolsAsync">
                    @(_toolsLoading ? "Checking..." : "Check for updates")
                </AppButton>
                <AppButton Variant="ButtonVariant.Primary" Disabled="@(!_catalogExists || _toolsLoading || ToolActionBusy || !CanUpdateAnyTool)" OnClick="UpdateAllToolsAsync">
                    @(_toolActionKey == UpdateAllKey ? "Updating..." : "Update all")
                </AppButton>
                @if (CanEdit && _catalogExists && _tools.Count > 0)
                {
                    @* Only alongside a populated table. The two empty states carry
                       their own copies of these, where they are the point of the
                       screen rather than one more button on a toolbar. *@
                    <AppButton Variant="ButtonVariant.Secondary" Disabled="@ToolActionBusy" OnClick="OpenAddDialog" TestId="tools-add-open">
                        Add tool
                    </AppButton>
                    <AppButton Variant="ButtonVariant.Ghost" Disabled="@ToolActionBusy" OnClick="OpenImportDialog" TestId="tools-import-open">
                        Import
                    </AppButton>
                }
            </div>
        </div>

        @if (_toolsLoading && _tools.Count == 0)
        {
            <p class="tools-panel__empty">Loading installed tool versions.</p>
        }
        else if (!_catalogExists)
        {
            <EmptyState Title="No tool catalog yet"
                        Description="@NoCatalogDescription"
                        Action="@NoCatalogActions"
                        TestId="tools-empty-no-catalog" />
        }
        else if (_tools.Count == 0)
        {
            <EmptyState Title="No tools in the catalog yet"
                        Description="@EmptyCatalogDescription"
                        Action="@EmptyCatalogActions"
                        TestId="tools-empty-no-entries" />
        }
        else
        {
            <div class="tools-table" role="table" aria-label="Configured Copilot and Claude tools">
                <div class="tools-table__row tools-table__row--head" role="row">
                    <span role="columnheader">Tool</span>
                    <span role="columnheader">Installed</span>
                    <span role="columnheader">Available</span>
                    <span role="columnheader">Actions</span>
                </div>

                @foreach (var tool in _tools)
                {
                    <div class="tools-table__row @(tool.ConfiguredEnabled ? string.Empty : "tools-table__row--disabled")" role="row" data-tool-key="@tool.Key" @key="tool.Key">
                        <div role="cell" class="tools-table__tool">
                            <strong>@tool.Name</strong>
                            @* The library's badge wearing this table's host class.
                               Which hosts an entry is for decides what its Update
                               actually does, and a catalog that drives two of them
                               with one row is unreadable without it being said. *@
                            <Badge BaseClass="tools-table__hosts"
                                   Kind=""
                                   Title="@HostTitle(tool)"
                                   TestId="tools-row-hosts">@HostLabel(tool.Hosts)</Badge>
                            <span class="tools-table__meta">@Humanize(tool.Kind.ToString()) · @tool.Status</span>
                        </div>
                        @* Each version cell names itself. The row's four columns only
                           fit while the pane is wide enough for them — it is a surface
                           beside a workspace, so it often is not — and below that the
                           row stacks and the heading row goes. Two bare version strings
                           in a column say nothing about which is which, so the label is
                           in the markup at every width and the stylesheet decides when
                           it shows. *@
                        <span role="cell" class="tools-table__version">
                            <span class="tools-table__cell-label">Installed</span>@tool.InstalledVersion
                        </span>
                        <span role="cell" class="tools-table__version @(tool.CanUpdate ? "tools-table__version--new" : string.Empty)">
                            <span class="tools-table__cell-label">Available</span>@tool.AvailableVersion
                        </span>
                        <div role="cell" class="tools-table__actions">
                            @if (tool.Kind is CopilotToolKind.Marketplace)
                            {
                                @* A marketplace has no version to be behind, so it
                                   never earns an Update through CanUpdate the way a
                                   tool does. What it has is two states — Claude
                                   knows it or does not — and one verb for each. *@
                                <AppButton Variant="ButtonVariant.Secondary"
                                           Disabled="@(_toolsLoading || ToolActionBusy)"
                                           OnClick="() => ApplyToolActionAsync(tool, CopilotToolAction.Update)">
                                    @(tool.Installed ? "Update" : "Add")
                                </AppButton>
                            }
                            else if (tool.CanUpdate)
                            {
                                <AppButton Variant="ButtonVariant.Secondary"
                                           Disabled="@(_toolsLoading || ToolActionBusy)"
                                           OnClick="() => ApplyToolActionAsync(tool, CopilotToolAction.Update)">
                                    Update
                                </AppButton>
                            }
                            else if (tool.CanInstall)
                            {
                                @* The same action as an update. The port has one
                                   verb for "make this machine match the config",
                                   and behind it the host already runs
                                   "plugin install" or "tool install" for a tool
                                   that is enabled and absent — what changes here
                                   is only that the row now offers it. *@
                                <AppButton Variant="ButtonVariant.Secondary"
                                           Disabled="@(_toolsLoading || ToolActionBusy)"
                                           OnClick="() => ApplyToolActionAsync(tool, CopilotToolAction.Update)">
                                    Install
                                </AppButton>
                            }
                            else
                            {
                                <span class="tools-table__action-note">@ActionNote(tool)</span>
                            }
                            @if (tool.Kind is not CopilotToolKind.Marketplace)
                            {
                                @* Not for a marketplace. It is not a tool this
                                   machine opts into — it is where the Claude
                                   plugins that do come from — so the only way to
                                   stop wanting one is to remove it. *@
                                <AppButton Variant="ButtonVariant.Ghost"
                                           Disabled="@(_toolsLoading || ToolActionBusy)"
                                           OnClick="() => ApplyToolActionAsync(tool, tool.ConfiguredEnabled ? CopilotToolAction.Disable : CopilotToolAction.Enable)">
                                    @(tool.ConfiguredEnabled ? "Disable" : "Enable")
                                </AppButton>
                            }
                            @if (CanEdit)
                            {
                                @* The row's test id is shared by every row, so a driver
                                   scopes it through the row's data-tool-key. One id per
                                   row would be an id nobody could write a selector for
                                   without knowing the catalog first. *@
                                <DeleteButton Label="Remove"
                                              AriaLabel="@($"Remove {tool.Name} from the catalog")"
                                              Size="ButtonSize.Small"
                                              ShowIcon="false"
                                              Disabled="@(_toolsLoading || ToolActionBusy)"
                                              TestId="tools-row-remove"
                                              OnClick="() => AskToRemove(tool)" />
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @if (_commands.Count > 0)
        {
            @* Checking tools runs about a dozen processes, and until this was
               here the only trace of any of them was the sentence in the status
               line above. The output was already captured and then dropped, so a
               refused install or a search that could not reach nuget.org had
               nowhere left to be read.

               Folded, because it is diagnostics and not the pane's subject: it
               matters exactly when the one-line summary is not enough. *@
            <FoldControl CssClass="tools-panel__log"
                         Expanded="_commandsShown"
                         ExpandedChanged="shown => _commandsShown = shown"
                         Label="@($"Command output ({_commands.Count})")"
                         TestId="tools-command-log">
                <CodeView Source="@CommandLog" Language="console" TestId="tools-command-log-output" />
            </FoldControl>
        }
    </div>
</section>

<Modal Open="@_addOpen"
       OpenChanged="OnAddOpenChanged"
       Title="Add a tool"
       CssClass="tools-dialog"
       TestId="tools-add-dialog">
    <ChildContent>
        <div class="tools-form">
            @* SelectField rather than EnumSelect: the enum member is McpServer and
               the humanised form of that reads "Mcp Server", which is not what the
               product calls it anywhere else. *@
            <SelectField Label="Kind"
                         CurrentValue="@_draftKind.ToString()"
                         Options="@KindOptions"
                         TestId="tools-add-kind"
                         OnChanged="OnDraftKindChanged" />

            @if (_draftKind is not CopilotToolKind.Marketplace)
            {
                @* A marketplace has no hosts to choose between: it is a Claude
                   mechanism and nothing else, so offering the choice would be
                   offering an answer that cannot be given. *@
                <SelectField Label="Hosts"
                             CurrentValue="@_draftHosts.ToString()"
                             Options="@HostOptions"
                             TestId="tools-add-hosts"
                             OnChanged="OnDraftHostsChanged" />
            }

            @if (_draftKind is CopilotToolKind.Marketplace)
            {
                <TextField Label="Name"
                           Value="@_draftMarketplaceName"
                           ValueChanged="value => _draftMarketplaceName = value"
                           HelpText="What Claude will call it — the marketplace half of a plugin id."
                           ErrorMessage="@_draftIdError"
                           TestId="tools-add-name" />
                <TextField Label="Source"
                           Value="@_draftSource"
                           ValueChanged="value => _draftSource = value"
                           HelpText="The repository it is added from: an owner/repo, or a URL."
                           ErrorMessage="@_draftSourceError"
                           TestId="tools-add-source" />
            }
            else if (_draftKind is CopilotToolKind.Plugin)
            {
                <TextField Label="Name"
                           Value="@_draftPluginName"
                           ValueChanged="value => _draftPluginName = value"
                           HelpText="The plugin's name, exactly as its host CLI lists it. Claude's own name for it, when it differs, goes below."
                           ErrorMessage="@_draftIdError"
                           TestId="tools-add-name" />
                <TextField Label="Source"
                           Value="@_draftSource"
                           ValueChanged="value => _draftSource = value"
                           HelpText="Where it is installed from: an owner/repo:path, or a URL."
                           ErrorMessage="@_draftSourceError"
                           TestId="tools-add-source" />
                <SelectField Label="Kind of plugin"
                             CurrentValue="@_draftPluginKind"
                             Options="@PluginKindOptions"
                             IncludeEmptyOption="true"
                             EmptyLabel="Plugin (default)"
                             TestId="tools-add-plugin-kind"
                             OnChanged="value => _draftPluginKind = value ?? string.Empty" />

                @if (_draftHosts.HasFlag(CopilotToolHosts.Claude))
                {
                    @* Both blank in the ordinary case: a plugin's Claude id falls
                       back to its own name and to the first marketplace in the
                       catalog, and writing either out when it only restates the
                       fallback makes the catalog harder to read. *@
                    <TextField Label="Claude name"
                               Value="@_draftClaudeName"
                               ValueChanged="value => _draftClaudeName = value"
                               HelpText="Optional. Only when the marketplace calls it something else."
                               TestId="tools-add-claude-name" />
                    <TextField Label="Claude marketplace"
                               Value="@_draftClaudeMarketplace"
                               ValueChanged="value => _draftClaudeMarketplace = value"
                               HelpText="Optional. Defaults to the first marketplace in the catalog."
                               TestId="tools-add-claude-marketplace" />
                }
            }
            else
            {
                <TextField Label="Package ID"
                           Value="@_draftPackageId"
                           ValueChanged="value => _draftPackageId = value"
                           HelpText="The .NET tool package the server ships as."
                           ErrorMessage="@_draftIdError"
                           TestId="tools-add-package-id" />
                <TextField Label="Name"
                           Value="@_draftDisplayName"
                           ValueChanged="value => _draftDisplayName = value"
                           HelpText="Optional. What the row reads as beside the package id."
                           TestId="tools-add-name" />

                @if (_draftHosts.HasFlag(CopilotToolHosts.Claude))
                {
                    @* The .NET tool above is shared by both hosts. These three are
                       the extra step Claude needs on top of it: a user-scope
                       registration pointing at the executable the tool installs. *@
                    <TextField Label="Claude server name"
                               Value="@_draftClaudeServerName"
                               ValueChanged="value => _draftClaudeServerName = value"
                               HelpText="Optional. What 'claude mcp' registers it as; defaults to the name above."
                               TestId="tools-add-claude-server-name" />
                    <TextField Label="Claude command"
                               Value="@_draftClaudeCommand"
                               ValueChanged="value => _draftClaudeCommand = value"
                               HelpText="The executable the tool installs. Leave blank to install the tool without registering it."
                               TestId="tools-add-claude-command" />
                    <TextField Label="Claude arguments"
                               Value="@_draftClaudeArgs"
                               ValueChanged="value => _draftClaudeArgs = value"
                               HelpText="Optional. Separated by spaces, in the order they are passed."
                               TestId="tools-add-claude-args" />
                }
            }
        </div>
    </ChildContent>
    <Footer>
        <AppButton Variant="ButtonVariant.Ghost" OnClick="CloseAddDialog" TestId="tools-add-cancel">Cancel</AppButton>
        <AppButton Variant="ButtonVariant.Primary" Disabled="@ToolActionBusy" OnClick="SubmitAddAsync" TestId="tools-add-submit">
            @(_toolActionKey == AddKey ? "Adding..." : "Add tool")
        </AppButton>
    </Footer>
</Modal>

<Modal Open="@_importOpen"
       OpenChanged="OnImportOpenChanged"
       Title="Import a tool catalog"
       CssClass="tools-dialog"
       TestId="tools-import-dialog">
    <ChildContent>
        <div class="tools-form">
            <p class="tools-form__note">
                The catalog is replaced, not merged. The one that is there now is kept beside it as a .bak file.
            </p>
            <FileField Label="Catalog file"
                       Accept=".json"
                       HelpText="An ai-tools.json with a plugins, mcpServers or claude.marketplaces array."
                       ErrorMessage="@_importError"
                       OnTextRead="OnImportFileRead"
                       OnRejected="OnImportFileRejected"
                       TestId="tools-import-file" />
            @* The paste box is not a fallback for a broken picker: a catalog
               arrives as often in a message or a review as it does as a file on
               this machine, and both end at the same ImportAsync(string). *@
            <TextArea Label="Or paste the JSON"
                      Value="@_importJson"
                      ValueChanged="value => _importJson = value"
                      AutoGrow="false"
                      Rows="8"
                      Placeholder="@ImportPlaceholder"
                      TestId="tools-import-json" />
        </div>
    </ChildContent>
    <Footer>
        <AppButton Variant="ButtonVariant.Ghost" OnClick="CloseImportDialog">Cancel</AppButton>
        <AppButton Variant="ButtonVariant.Primary" Disabled="@ToolActionBusy" OnClick="SubmitImportAsync" TestId="tools-import-submit">
            @(_toolActionKey == ImportKey ? "Importing..." : "Replace catalog")
        </AppButton>
    </Footer>
</Modal>

@* No OpenChanged binding, deliberately. ConfirmDialog raises it before OnConfirm,
   so a handler that cleared the subject there would clear it a moment before the
   confirm needed it. Cancel, Escape and the backdrop all arrive on OnCancel, which
   is the one path that has to forget what was being removed. *@
<ConfirmDialog Open="@(_removing is not null)"
               Title="Remove this tool?"
               Message="@RemoveMessage"
               ConfirmText="Remove"
               Destructive="true"
               TestId="tools-remove-dialog"
               ConfirmTestId="tools-remove-confirm"
               CancelTestId="tools-remove-cancel"
               OnConfirm="ConfirmRemoveAsync"
               OnCancel="CancelRemove" />

@code {
    /// <summary>The keys the busy state is held under for acts that are not one
    /// tool's. A tool's own key is its catalog key, and none of those can collide
    /// with these: a key is <c>plugin:</c> or <c>mcp:</c> prefixed.</summary>
    private const string UpdateAllKey = "__all__";
    private const string CreateKey = "__create__";
    private const string AddKey = "__add__";
    private const string ImportKey = "__import__";

    private bool _toolsLoading;
    private string? _toolMessage;
    private string? _toolActionKey;
    private bool _commandsShown;
    private IReadOnlyList<CopilotToolInfo> _tools = [];
    private IReadOnlyList<CopilotToolCommand> _commands = [];

    private bool _catalogExists;
    private bool _canEditCatalog;
    private string _catalogPath = string.Empty;

    private bool _addOpen;
    private CopilotToolKind _draftKind = CopilotToolKind.Plugin;
    private CopilotToolHosts _draftHosts = CopilotToolHosts.Both;
    private string _draftPluginName = string.Empty;
    private string _draftSource = string.Empty;
    private string _draftPluginKind = string.Empty;
    private string _draftPackageId = string.Empty;
    private string _draftDisplayName = string.Empty;
    private string _draftMarketplaceName = string.Empty;
    private string _draftClaudeName = string.Empty;
    private string _draftClaudeMarketplace = string.Empty;
    private string _draftClaudeServerName = string.Empty;
    private string _draftClaudeCommand = string.Empty;
    private string _draftClaudeArgs = string.Empty;
    private string? _draftIdError;
    private string? _draftSourceError;

    private bool _importOpen;
    private string _importJson = string.Empty;
    private string? _importError;

    private CopilotToolInfo? _removing;

    /// <summary>Raised when somebody dismisses the pane. Whether that hides it,
    /// collapses a stack or does nothing is the shell's decision — the pane only
    /// reports that the ✕ was pressed.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override Task OnInitializedAsync() => RefreshToolsAsync();

    private bool ToolActionBusy => _toolActionKey is not null;

    private bool CanEdit => _canEditCatalog;

    /// <summary>Never empty, so the toolbar always has a status line. The
    /// shared alert renders nothing for a blank message, and "no message yet"
    /// here means the check is still running - which is the one thing the line
    /// most needs to say.</summary>
    private string ToolMessage => _toolMessage ?? "Checking configured tools...";

    /// <summary>"No catalog" is a different fact from "no tools", and the badge is
    /// where it is said in one glance.</summary>
    private string CountLabel => !_catalogExists
        ? "No catalog"
        : _tools.Count == 0 ? "Check tools" : $"{_tools.Count} tools";

    private string NoCatalogDescription => _catalogPath.Length == 0
        ? "This machine has no tool catalog. Create one, or import a catalog you already have."
        : $"Nothing has been configured on this machine yet. The catalog will be written to {_catalogPath}.";

    private string EmptyCatalogDescription => _catalogPath.Length == 0
        ? "The catalog is there but has no plugins or MCP servers in it yet."
        : $"{_catalogPath} has no plugins or MCP servers in it yet.";

    private string RemoveMessage => _removing is null
        ? string.Empty
        : $"{_removing.Name} is dropped from the catalog, along with anything this PC had overridden about it. The tool itself is not uninstalled.";

    /// <summary>Whether "Update all" has anything to do. A marketplace Claude has
    /// never been told about counts, even though it has no version to be behind:
    /// every Claude plugin id resolves against one, so a missing marketplace is a
    /// whole block of rows failing for a single reason.</summary>
    private bool CanUpdateAnyTool =>
        _tools.Any(tool => tool.CanUpdate || (tool.Kind is CopilotToolKind.Marketplace && !tool.Installed));

    /// <summary>What a row says when there is nothing to press.
    ///
    /// <para>Three answers rather than the two it had. "Up to date" used to cover
    /// every row without an update button, which put it beside "not installed" on
    /// enabled tools the machine did not have, and beside "unknown" on tools whose
    /// version lookup had failed. Neither of those is a tool that is up to
    /// date.</para></summary>
    private static string ActionNote(CopilotToolInfo tool) => tool switch
    {
        { ConfiguredEnabled: false } => "Disabled",
        { AvailableVersionKnown: false } => "Version unknown",
        _ => "Up to date"
    };

    private const string ImportPlaceholder = """{ "plugins": [], "mcpServers": [] }""";

    /// <summary>The two acts that move a machine with no catalog on. Null when the
    /// host cannot write one, which drops the action row entirely rather than
    /// drawing an empty one under the description.</summary>
    private RenderFragment? NoCatalogActions => !CanEdit ? null :
        @<text>
            <AppButton Variant="ButtonVariant.Primary" Disabled="@ToolActionBusy" OnClick="CreateCatalogAsync" TestId="tools-create-catalog">
                @(_toolActionKey == CreateKey ? "Creating..." : "Create catalog")
            </AppButton>
            <AppButton Variant="ButtonVariant.Secondary" Disabled="@ToolActionBusy" OnClick="OpenImportDialog" TestId="tools-import-open">
                Import JSON…
            </AppButton>
        </text>;

    /// <inheritdoc cref="NoCatalogActions" />
    private RenderFragment? EmptyCatalogActions => !CanEdit ? null :
        @<text>
            <AppButton Variant="ButtonVariant.Primary" Disabled="@ToolActionBusy" OnClick="OpenAddDialog" TestId="tools-add-open">
                Add tool
            </AppButton>
            <AppButton Variant="ButtonVariant.Ghost" Disabled="@ToolActionBusy" OnClick="OpenImportDialog" TestId="tools-import-open">
                Import JSON…
            </AppButton>
        </text>;

    private static readonly IReadOnlyList<SelectorOption> KindOptions =
    [
        new(nameof(CopilotToolKind.Plugin), "Plugin"),
        new(nameof(CopilotToolKind.McpServer), "MCP server"),
        new(nameof(CopilotToolKind.Marketplace), "Claude marketplace")
    ];

    /// <summary>Both first, because it is both the default and the common answer:
    /// an entry that says nothing about hosts is an entry for both, and the catalog
    /// writes the property only when the answer is one of the other two.</summary>
    private static readonly IReadOnlyList<SelectorOption> HostOptions =
    [
        new(nameof(CopilotToolHosts.Both), "Copilot and Claude"),
        new(nameof(CopilotToolHosts.Copilot), "Copilot only"),
        new(nameof(CopilotToolHosts.Claude), "Claude only")
    ];

    /// <summary>The plugin kinds the desktop host actually branches on, plus the
    /// empty option for the ordinary case. Not read from the port: the host reads
    /// this string as free text, so a catalog can carry one nothing here has met
    /// and a hand edit stays the way to write it.</summary>
    private static readonly IReadOnlyList<SelectorOption> PluginKindOptions =
    [
        new("repository-skills", "Repository skills"),
        new("repository-canvases", "Repository canvases")
    ];

    /// <summary>Every command as one block, in the order it ran: the line you
    /// could have typed, whatever it printed, and the exit code only when it is
    /// not zero — a command that succeeded has already said so by printing
    /// nothing alarming, and a column of "exit code 0" would bury the one line
    /// that is worth finding.</summary>
    private string CommandLog =>
        string.Join(Environment.NewLine + Environment.NewLine, _commands.Select(Transcribe));

    private static string Transcribe(CopilotToolCommand command)
    {
        var lines = new List<string> { $"$ {command.CommandLine}" };

        if (command.Output.Length > 0)
        {
            lines.Add(command.Output);
        }

        if (command.ExitCode != 0)
        {
            lines.Add($"exit code {command.ExitCode}");
        }

        return string.Join(Environment.NewLine, lines);
    }

    private async Task RefreshToolsAsync()
    {
        _toolsLoading = true;
        _toolMessage = null;
        try
        {
            var catalog = await CopilotTools.ListAsync();
            _tools = catalog.Tools;
            _toolMessage = catalog.Message;
            _catalogExists = catalog.CatalogExists;
            _catalogPath = catalog.CatalogPath;
            _canEditCatalog = catalog.CanEditCatalog;
            _commands = catalog.Commands;
        }
        catch (Exception ex)
        {
            _toolMessage = $"Tools could not be checked: {ex.Message}";
        }
        finally
        {
            _toolsLoading = false;
        }
    }

    private async Task UpdateAllToolsAsync()
    {
        _toolActionKey = UpdateAllKey;
        try
        {
            var result = await CopilotTools.UpdateAllAsync();
            _toolMessage = result.Message;
            if (result.Succeeded)
            {
                await RefreshToolsAsync();
            }

            // After the refresh rather than before it. The refresh runs a dozen
            // commands of its own, and letting those land last would replace the
            // update the reader just asked about with the check that followed it.
            _commands = result.Commands;
        }
        finally
        {
            _toolActionKey = null;
        }
    }

    private async Task ApplyToolActionAsync(CopilotToolInfo tool, CopilotToolAction action)
    {
        _toolActionKey = tool.Key;
        try
        {
            var result = action switch
            {
                CopilotToolAction.Update => await CopilotTools.UpdateAsync(tool.Key),
                CopilotToolAction.Enable => await CopilotTools.EnableAsync(tool.Key),
                CopilotToolAction.Disable => await CopilotTools.DisableAsync(tool.Key),
                _ => CopilotToolActionResult.Failed("Unknown tool action.")
            };

            _toolMessage = result.Message;
            if (result.Succeeded)
            {
                await RefreshToolsAsync();
            }

            // See UpdateAllToolsAsync: the action's commands win over the
            // refresh's, because the action is what the reader pressed.
            _commands = result.Commands;
        }
        finally
        {
            _toolActionKey = null;
        }
    }

    private Task CreateCatalogAsync() => RunCatalogEditAsync(CreateKey, () => CopilotTools.CreateCatalogAsync());

    private void OpenAddDialog()
    {
        ResetDraft();
        _addOpen = true;
    }

    private void CloseAddDialog() => _addOpen = false;

    private void OnAddOpenChanged(bool open) => _addOpen = open;

    private void OnDraftKindChanged(string? value)
    {
        _draftKind = value switch
        {
            nameof(CopilotToolKind.McpServer) => CopilotToolKind.McpServer,
            nameof(CopilotToolKind.Marketplace) => CopilotToolKind.Marketplace,
            _ => CopilotToolKind.Plugin
        };

        // The fields the other kind filled in are not this kind's fields, and a
        // stale error under a field that is no longer on screen would reappear
        // over whichever field takes its place.
        _draftIdError = null;
        _draftSourceError = null;
    }

    private void OnDraftHostsChanged(string? value) => _draftHosts = value switch
    {
        nameof(CopilotToolHosts.Copilot) => CopilotToolHosts.Copilot,
        nameof(CopilotToolHosts.Claude) => CopilotToolHosts.Claude,
        _ => CopilotToolHosts.Both
    };

    /// <summary>
    /// What the form can decide on its own, decided on its own. The port validates
    /// the same things and would answer with the same words, but its answer lands
    /// on the pane's status line — and "a plugin needs a source" belongs under the
    /// source field, not at the top of the dialog.
    /// </summary>
    private async Task SubmitAddAsync()
    {
        _draftIdError = null;
        _draftSourceError = null;

        var plugin = _draftKind is CopilotToolKind.Plugin;
        var marketplace = _draftKind is CopilotToolKind.Marketplace;
        var id = (marketplace ? _draftMarketplaceName : plugin ? _draftPluginName : _draftPackageId).Trim();

        if (id.Length == 0)
        {
            _draftIdError = _draftKind switch
            {
                CopilotToolKind.Plugin => "A plugin needs a name.",
                CopilotToolKind.Marketplace => "A marketplace needs a name.",
                _ => "An MCP server needs a package id."
            };
        }

        // A marketplace is all source — a name with nothing behind it is a name
        // Claude has no way to resolve — so it is required for the same reason a
        // plugin's is.
        if ((plugin || marketplace) && string.IsNullOrWhiteSpace(_draftSource))
        {
            _draftSourceError = plugin ? "A plugin needs a source." : "A marketplace needs a source.";
        }

        if (_draftIdError is not null || _draftSourceError is not null)
        {
            return;
        }

        var draft = new CopilotToolDraft(
            _draftKind,
            id,
            plugin || marketplace ? _draftSource.Trim() : null,
            plugin || marketplace ? null : NullIfBlank(_draftDisplayName),
            plugin ? NullIfBlank(_draftPluginKind) : null)
        {
            // A marketplace is a Claude mechanism whatever the form last had
            // selected, and the hosts selector is not on screen for one.
            Hosts = marketplace ? CopilotToolHosts.Claude : _draftHosts,
            ClaudeName = plugin ? NullIfBlank(_draftClaudeName) : null,
            ClaudeMarketplace = plugin ? NullIfBlank(_draftClaudeMarketplace) : null,
            ClaudeServerName = plugin || marketplace ? null : NullIfBlank(_draftClaudeServerName),
            ClaudeCommand = plugin || marketplace ? null : NullIfBlank(_draftClaudeCommand),
            ClaudeArgs = plugin || marketplace ? [] : SplitArgs(_draftClaudeArgs)
        };

        if (await RunCatalogEditAsync(AddKey, () => CopilotTools.AddAsync(draft)))
        {
            _addOpen = false;
            ResetDraft();
        }
    }

    /// <summary>The arguments box as an argument list. Split on whitespace, which
    /// is what the field says it does and what an argument list looks like when it
    /// is typed rather than assembled — <c>agent mcp</c>, not a JSON array.</summary>
    private static IReadOnlyList<string> SplitArgs(string value) =>
        value.Split((char[])[' ', '\t'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private void OpenImportDialog()
    {
        _importJson = string.Empty;
        _importError = null;
        _importOpen = true;
    }

    private void CloseImportDialog() => _importOpen = false;

    private void OnImportOpenChanged(bool open) => _importOpen = open;

    /// <summary>The file and the paste box are one value. Picking a file fills the
    /// box, so what is about to be imported is on screen either way and there is
    /// never a question of which of the two won.</summary>
    private void OnImportFileRead(string text)
    {
        _importJson = text;
        _importError = null;
    }

    private void OnImportFileRejected(string message) => _importError = message;

    private async Task SubmitImportAsync()
    {
        if (string.IsNullOrWhiteSpace(_importJson))
        {
            _importError = "Choose a file or paste the catalog JSON.";
            return;
        }

        _importError = null;

        if (await RunCatalogEditAsync(ImportKey, () => CopilotTools.ImportAsync(_importJson)))
        {
            _importOpen = false;
            _importJson = string.Empty;
        }
    }

    /// <summary>Arms the confirm dialog. Nothing is removed here — the first click
    /// asks, and only the confirm calls the port.</summary>
    private void AskToRemove(CopilotToolInfo tool) => _removing = tool;

    private void CancelRemove() => _removing = null;

    private async Task ConfirmRemoveAsync()
    {
        if (_removing is not { } tool)
        {
            return;
        }

        _removing = null;
        await RunCatalogEditAsync(tool.Key, () => CopilotTools.RemoveAsync(tool.Key));
    }

    /// <summary>
    /// The four catalog edits run the same way: hold the busy key, call the port,
    /// put whatever it says on the status line, and re-read only when it worked.
    ///
    /// <para>Only on success, deliberately. A refresh after a failed edit would
    /// replace the reason it failed with the ordinary "showing tools from ..."
    /// line, which is the one moment that line is worth less than what it
    /// overwrites.</para>
    /// </summary>
    private async Task<bool> RunCatalogEditAsync(string busyKey, Func<Task<CopilotToolActionResult>> edit)
    {
        _toolActionKey = busyKey;
        try
        {
            var result = await edit();
            _toolMessage = result.Message;

            if (!result.Succeeded)
            {
                return false;
            }

            await RefreshToolsAsync();
            return true;
        }
        finally
        {
            _toolActionKey = null;
        }
    }

    private void ResetDraft()
    {
        _draftKind = CopilotToolKind.Plugin;
        _draftHosts = CopilotToolHosts.Both;
        _draftPluginName = string.Empty;
        _draftSource = string.Empty;
        _draftPluginKind = string.Empty;
        _draftPackageId = string.Empty;
        _draftDisplayName = string.Empty;
        _draftMarketplaceName = string.Empty;
        _draftClaudeName = string.Empty;
        _draftClaudeMarketplace = string.Empty;
        _draftClaudeServerName = string.Empty;
        _draftClaudeCommand = string.Empty;
        _draftClaudeArgs = string.Empty;
        _draftIdError = null;
        _draftSourceError = null;
    }

    /// <summary>Which hosts a row is for, short enough to sit beside the name.
    /// "Both" is spelled out rather than left blank: a row that says nothing about
    /// hosts is indistinguishable from one whose badge failed to render, and the
    /// whole point of the badge is that the answer is never assumed.</summary>
    private static string HostLabel(CopilotToolHosts hosts) => hosts switch
    {
        CopilotToolHosts.Copilot => "Copilot",
        CopilotToolHosts.Claude => "Claude",
        CopilotToolHosts.Both => "Copilot + Claude",
        _ => "No host"
    };

    /// <summary>The badge's tooltip: what each host answered, when they answered
    /// differently enough to be worth reading one by one. A row whose hosts agree
    /// gets no tooltip, because the columns already say it.</summary>
    private static string? HostTitle(CopilotToolInfo tool) => tool.HostStates.Count < 2
        ? null
        : string.Join(" · ", tool.HostStates.Select(state => $"{HostLabel(state.Host)}: {state.Status}"));

    private static string? NullIfBlank(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string Humanize(string enumName)
    {
        var text = System.Text.RegularExpressions.Regex.Replace(enumName, "(?<!^)([A-Z])", " $1");
        return text.ToLowerInvariant();
    }
}
