<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The Dev PC Management context's UI: what the machines the work system runs on
    are configured with, and what an operator can do about it (see
    .devbook/domain/context-map.md). Today that is the system tools pane — the Copilot
    plugins, repository tools and MCP servers this PC is set up for.

    It references the shared control library rather than growing its own
    controls, which is the rule every module UI project follows, and its own
    module's published surface for the port it injects. It sees no host, no
    workspace and no sibling context: the tools pane is scoped by nothing but
    the machine it is running on.
  -->
  <PropertyGroup>
    <!--
      Unlike its siblings this root namespace does match the project name, and
      it is safe for a reason worth stating rather than assuming. The Razor
      generator emits a component's @using directives inside the component's
      namespace and without a global:: prefix, so under
      Backlog.Modules.DevPc.UI a bare "Backlog.*" import would bind to
      Backlog.Modules as soon as a Backlog.Modules.Tasks namespace entered
      this project's reference closure. Nothing here brings one in — the only
      references are the control library, the shared kernel and this module's
      own abstractions — and _Imports.razor writes every Backlog.* import as
      global:: anyway, so
      neither half of that has to stay true by luck.
    -->
    <RootNamespace>Backlog.Modules.DevPc.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <!-- For AddToolsAiContentSource(), the composition root a host calls to put
         the tool catalog behind the shell's Ask AI port. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- The record shape the Ask AI source writes a tool in is a contract with
         the assistant, so it is worth asserting without a DOM. -->
    <InternalsVisibleTo Include="Backlog.Desktop.UI.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Backlog.UI.Components\Backlog.UI.Components.csproj" />
    <!-- IAiContentSource: the shell's Ask AI port, which this module answers for
         the tool catalog. The kernel is what everything may see. -->
    <ProjectReference Include="..\..\..\Core\Backlog.SharedKernel\Backlog.SharedKernel.csproj" />
    <!-- The module's published surface only: the IDevToolService port and
         the DTOs it answers with. Which host implements it, and whether that
         host can do more than read, stays behind that line. -->
    <ProjectReference Include="..\Backlog.Modules.DevPc.Abstractions\Backlog.Modules.DevPc.Abstractions.csproj" />
  </ItemGroup>

</Project>
