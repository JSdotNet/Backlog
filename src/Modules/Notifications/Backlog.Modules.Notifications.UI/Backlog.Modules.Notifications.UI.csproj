<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The Notifications module's UI (.devbook/domain/notifications/features.md): the
    notification centre the desktop shell opens as a takeover (NotificationCentrePane),
    its list grouped by subject (NotificationList), and the count of open questions
    the shell's option wears (NotificationsWaitingBadge). The question card itself is
    the library's NotificationCard, so the storybook can draw it with nothing behind
    it; this project maps a notification onto it (NotificationPresentation). The
    layout ships in wwwroot/notifications.css.

    It references the shared control library rather than growing its own controls,
    which is the rule every module UI project follows, and the module's published
    surface only — never a notification, its repository or the services.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.Modules.Notifications.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Backlog.UI.Components\Backlog.UI.Components.csproj" />
    <ProjectReference Include="..\Backlog.Modules.Notifications.Abstractions\Backlog.Modules.Notifications.Abstractions.csproj" />
  </ItemGroup>

</Project>
