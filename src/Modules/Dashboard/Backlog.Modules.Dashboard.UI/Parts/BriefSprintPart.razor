@*
    The brief's Sprint block, first in the brief: for each sprint series marked "Show it
    in the weekly brief" whose sprint overlaps the reported week, the series, its
    repositories and which week of the sprint this is; one templated sentence (goal tasks
    and items done against the even pace, added and removed, blocked); the figures; what
    shipped that week, by plan, with the pull requests it merged; and what carries on.

    It reads Progress through the dashboard's own port, ISprintBriefSource, which an
    adapter answers from Progress's published surface — this project may not name a
    Progress type. Every week the brief can step to is read once, when it opens; stepping
    a week moves what the block draws and never what it fetches (SprintWeekBrief).

    With Progress switched off, not composed, or no series marked, the port answers with
    no sprint and the block draws nothing at all — no heading, no spinner, no "missing"
    line — so the brief is the one it was before. The repository filter keeps a series
    that has a repository in focus.
*@
@inherits BriefPartBase<IReadOnlyList<SprintBriefSprint>>
@using global::Backlog.UI.Components.Integrations

@if (IsReady)
{
    @foreach (var brief in SprintWeekBrief.For(Value!, Week, Scope.Repositories))
    {
        var id = $"dashboard-brief-sprint-{brief.Sprint.SeriesId:N}";
        <section class="dashboard-brief-sprint" aria-labelledby="@id" data-testid="dashboard-brief-sprint">
            <div class="dashboard-brief-sprint__head">
                <p class="dashboard-brief-block__tag">Sprint</p>
                <h4 class="dashboard-brief-sprint__name" id="@id" data-testid="dashboard-brief-sprint-name">@brief.Sprint.Name</h4>
                <p class="dashboard-brief-sprint__meta" data-testid="dashboard-brief-sprint-meta">@WeeklyBriefSentences.SprintMeta(brief)</p>
            </div>

            <p class="dashboard-brief-sprint__summary" data-testid="dashboard-brief-sprint-summary">@WeeklyBriefSentences.SprintSummary(brief)</p>

            <dl class="dashboard-brief-sprint__figures" data-testid="dashboard-brief-sprint-figures">
                @Figure("goal", $"{brief.GoalDone} of {brief.GoalTotal}", "goal tasks done")
                @Figure("done", brief.DoneThisWeek.ToString(System.Globalization.CultureInfo.InvariantCulture), "done this week")
                @Figure("items", brief.Total.ToString(System.Globalization.CultureInfo.InvariantCulture), brief.Added > 0 ? $"in the sprint, +{brief.Added} added" : "in the sprint")
                @Figure("merged", brief.Merged.ToString(System.Globalization.CultureInfo.InvariantCulture), brief.Merged == 1 ? "pull request merged" : "pull requests merged")
                @Figure("blocked", brief.Blocked.Count.ToString(System.Globalization.CultureInfo.InvariantCulture), "blocked")
            </dl>

            <div class="dashboard-brief-sprint__section" data-testid="dashboard-brief-sprint-shipped">
                <p class="dashboard-brief-block__tag">Shipped, by plan</p>
                @if (brief.Shipped.Count == 0)
                {
                    <p class="dashboard-brief-sprint__note" data-testid="dashboard-brief-sprint-shipped-none">@WeeklyBriefSentences.SprintNothingShipped</p>
                }
                else
                {
                    <ul class="dashboard-brief-sprint__plans">
                        @foreach (var plan in brief.Shipped)
                        {
                            <li class="dashboard-brief-sprint__plan" data-testid="dashboard-brief-sprint-plan">
                                <span class="dashboard-brief-sprint__plan-name" data-testid="dashboard-brief-sprint-plan-name">@(plan.PlanTag is null ? WeeklyBriefSentences.SprintNoPlan : $"+{plan.PlanTag}")</span>
                                <ul class="dashboard-brief-sprint__items">
                                    @foreach (var item in plan.Items)
                                    {
                                        <li class="dashboard-brief-sprint__item" data-testid="dashboard-brief-sprint-item">
                                            <span>@item.Title</span>
                                            @foreach (var pull in item.Merged)
                                            {
                                                <IntegrationLink Link="@Link(pull)"
                                                                 ShowTitle="false"
                                                                 TestId="dashboard-brief-sprint-pull" />
                                            }
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="dashboard-brief-sprint__section" data-testid="dashboard-brief-sprint-into">
                <p class="dashboard-brief-block__tag" data-testid="dashboard-brief-sprint-into-heading">@WeeklyBriefSentences.SprintIntoHeading(brief)</p>
                <p class="dashboard-brief-sprint__note" data-testid="dashboard-brief-sprint-into-detail">@WeeklyBriefSentences.SprintInto(brief)</p>
            </div>
        </section>
    }
}

@code {
    [Inject]
    private IServiceProvider Services { get; set; } = default!;

    /// <summary>The series' repositories decide what the block shows, not the fetch,
    /// so moving the repository filter re-reads nothing.</summary>
    protected override bool FollowsRepository => false;

    protected override bool FollowsWindow => false;

    private static RenderFragment Figure(string name, string value, string label) =>
        @<div class="dashboard-brief-sprint__figure" data-testid="@($"dashboard-brief-sprint-figure-{name}")">
            <dt class="dashboard-brief-sprint__figure-label">@label</dt>
            <dd class="dashboard-brief-sprint__figure-value">@value</dd>
        </div>;

    private static IntegrationLinkRef Link(SprintBriefPullRequest pull) =>
        IntegrationLinkRef.PullRequest(
            $"{pull.Repository}#{pull.Number}",
            $"#{pull.Number.Trim()}",
            IntegrationArtifactState.Merged,
            url: SprintWeekBrief.Url(pull));

    /// <summary>Every week the brief can step to, from the earliest to the last completed
    /// one, so stepping between them needs no second read.</summary>
    protected override async Task<InsightResult<IReadOnlyList<SprintBriefSprint>>> FetchAsync(CancellationToken cancellationToken)
    {
        if (Services.GetService(typeof(ISprintBriefSource)) is not ISprintBriefSource source)
        {
            return InsightResult<IReadOnlyList<SprintBriefSprint>>.Ready([]);
        }

        var latest = Week.Monday.AddDays(7 * Week.WeeksBack);
        var earliest = latest.AddDays(-7 * BriefWeek.MaxWeeksBack);

        return InsightResult<IReadOnlyList<SprintBriefSprint>>.Ready(
            await source.ReadAsync(earliest, latest.AddDays(6), cancellationToken));
    }

    // Nothing cached: the port reads Progress afresh every time.
    protected override void InvalidateSource()
    {
    }
}
