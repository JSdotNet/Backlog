@*
    The Overview's devbook drift issues open: the Devbook tab's count, from the same read.

    No comparison and no sparkline. The issue source reads only the issues open now, so
    it cannot say how many were open when the window began, nor how many were open any
    week before this one; a delta or a line drawn anyway would be one nobody measured.

    The chip is drift's own tone while any issue is open. It counts the ones whose sync
    failed — "1 sync failed", "3 sync failed" — because those are the ones no sweep will
    retry until a person clears the label. None open is good news and says so.

    GitHub unreadable is not "none open": with the issues unread and none counted, the
    tile carries the reason instead of a zero; with some counted, the count is a floor
    and the unit says so.
*@
@inherits DashboardPartBase<DriftInsight>
@inject IDriftInsights Insights

<OverviewTile OnRetry="RefreshAsync"
              Label="Devbook drift"
              Value="@(IsReady ? MetricFormat.Compact(Value!.Issues.Count) : null)"
              Unit="@(IsReady ? Unit : null)"
              Chip="@(IsReady ? Chip : null)"
              Status="TileStatus"
              StatusMessage="@TileMessage"
              TestId="dashboard-overview-tile-drift" />

@code {
    protected override DashboardSources Sources => DashboardSources.Drift;

    protected override bool FollowsWindow => false;

    /// <summary>Unavailable, with GitHub's reason, when the issues could not be read and
    /// none were counted — the one reading that would otherwise draw a false zero.</summary>
    private bool IssuesUnread => IsReady && Value!.IssuesNote is not null && Value!.Issues.Count == 0;

    private MetricStatusKind TileStatus => IssuesUnread ? MetricStatusKind.Unavailable : Status;

    private string? TileMessage => IssuesUnread ? Value!.IssuesNote : StatusMessage;

    private OverviewChip Chip
    {
        get
        {
            var failed = Value!.SyncFailed;
            if (failed.Count > 0) return new OverviewChip($"{failed.Count} sync failed", OverviewTone.Drift);

            return Value!.Issues.Count > 0
                ? new OverviewChip("Drift open", OverviewTone.Drift)
                : new OverviewChip("None open", OverviewTone.Good);
        }
    }

    /// <summary>"issue open" or "issues open", and "or more" before it when the
    /// issues were not all read.</summary>
    private string Unit
    {
        get
        {
            if (Value!.IssuesNote is not null) return "or more issues open";

            return Value!.Issues.Count == 1 ? "issue open" : "issues open";
        }
    }

    protected override Task<InsightResult<DriftInsight>> FetchAsync(CancellationToken cancellationToken) =>
        Insights.GetDriftAsync(Scope, cancellationToken);

    protected override bool IsEmpty(DriftInsight value) => false;

    // The issues are kept per repository focus, so a refresh drops them.
    protected override void InvalidateSource() => Insights.Invalidate();
}
