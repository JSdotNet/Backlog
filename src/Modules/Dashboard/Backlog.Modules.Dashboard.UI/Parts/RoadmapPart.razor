@*
    What the roadmap planned into the window and how that work stands: the pace the
    roadmap places work at, the items whose own stretch overlaps the window, the effort
    gathered under each and how much of it is ticked off — drawn as a timeline of the
    window's weeks, one bar per item.

    The bars answer the one question the task charts below them cannot — whether the
    work that was planned is landing where it was planned to — in the roadmap's own
    terms, so a figure here can be found again on the roadmap. It is not the roadmap's
    timeline: nothing here is dragged or opened, and a bar spans whole weeks rather than
    days. The axis runs from the window's first week past today to the latest end of an
    item it shows, at most half a year ahead, with today marked on it, so an item still
    running is drawn whole rather than as a stub cut off at today (AC17). The
    pace is the one the roadmap quotes for the repositories in scope, and the stretch it
    was measured over is said with it, because a measured pace and a typed one are
    different claims.

    An outlook is text on a tone, never a colour alone: the word is printed under the
    item's name, and the projection behind it is an info mark beside it — a real button,
    so a keyboard or a touch reaches the sentence, not only a pointer hovering the bar
    (AC18) — so a reader who cannot tell the tones apart loses nothing.

    Nothing at all while the roadmap is switched off. The roadmap sits behind a feature
    flag, and a frame announcing a switched-off surface would be this dashboard
    advertising it. An unavailable answer still draws the frame with its reason: the
    roadmap is on and could not be read, which is news.
*@
@using System.Globalization
@inherits DashboardPartBase<PlanInsight>
@inject ITaskInsights Insights

@if (Value is not { RoadmapEnabled: false })
{
    <PartFrame Title="Roadmap"
               Note="@Note"
               Busy="Status == MetricStatusKind.Loading"
               OnRefresh="RefreshAsync"
               TestId="dashboard-roadmap">
        @if (IsReady)
        {
            var weeks = Weeks;
            <div class="dashboard-part__stack">
                @* The roadmap's figures are the Tasks tab's joined row now (TaskFiguresPart),
                   so the pace, the items and the effort are said once on the tab. *@
                @* The timeline: one column per ISO week of the window, one row per item,
                   and a bar from the week the item starts in to the week it ends in —
                   for a finished item, the week its work landed — clipped to the
                   window. The weeks are the window the insight was read
                   for, so a bar never contradicts which items the window kept. It
                   scrolls sideways inside the card rather than squeezing the weeks
                   below the width a label fits in. *@
                <div class="dashboard-timeline"
                     style="@($"--dashboard-timeline-weeks: {weeks.Count}")"
                     data-testid="dashboard-roadmap-timeline">
                    <div class="dashboard-timeline__legend" aria-hidden="true">
                        <span class="dashboard-timeline__key"><span class="dashboard-timeline__swatch dashboard-timeline__swatch--done"></span>Done</span>
                        <span class="dashboard-timeline__key"><span class="dashboard-timeline__swatch dashboard-timeline__swatch--planned"></span>Planned</span>
                        <span class="dashboard-timeline__key"><span class="dashboard-timeline__swatch dashboard-timeline__swatch--behind"></span>Behind or overdue</span>
                        <span class="dashboard-timeline__key"><span class="dashboard-timeline__swatch dashboard-timeline__swatch--finished"></span>Finished</span>
                    </div>
                    <div class="dashboard-timeline__scroll">
                        <div class="dashboard-timeline__grid">
                            @* The axis is for the eye. A screen reader gets each bar's
                               stretch in its label instead of a row of week numbers it
                               would have to line up by itself. *@
                            <div class="dashboard-timeline__row dashboard-timeline__axis" aria-hidden="true">
                                <span class="dashboard-timeline__corner">Item</span>
                                @foreach (var week in weeks)
                                {
                                    <span class="@(week == TodayWeek ? "dashboard-timeline__week dashboard-timeline__week--today" : "dashboard-timeline__week")"
                                          data-testid="dashboard-roadmap-week">@WeekLabel(week)</span>
                                }
                            </div>
                            @if (TodayAt(weeks) is { } today)
                            {
                                @* Today, as a line down the weeks: where the window ends and
                                   the plan runs on. Placed as a share of the weeks' width,
                                   which is what the columns divide between them. *@
                                <span class="dashboard-timeline__today"
                                      style="@($"--dashboard-timeline-today: {today.ToString("0.####", CultureInfo.InvariantCulture)}")"
                                      data-testid="dashboard-roadmap-today">Today</span>
                            }
                            <ol class="dashboard-timeline__rows"
                                aria-label="@($"Roadmap items overlapping the last {Scope.Weeks} weeks")">
                                @foreach (var row in Value!.Items)
                                {
                                    var bar = Place(row, weeks);
                                    <li @key="row.Item.Id" class="dashboard-timeline__row" data-testid="dashboard-roadmap-row">
                                        <span class="dashboard-timeline__item">
                                            <span class="dashboard-timeline__name">@row.Item.Title</span>
                                            <span class="dashboard-timeline__standing">
                                                <span class="dashboard-timeline__progress">@Progress(row)</span>
                                                <InfoHint AriaLabel="@($"How {row.Item.Title} stands")"
                                                          Text="@Sentence(row)"
                                                          CssClass="dashboard-timeline__outlook"
                                                          TriggerTestId="dashboard-roadmap-outlook"
                                                          TooltipTestId="dashboard-roadmap-outlook-sentence" />
                                            </span>
                                        </span>
                                        @if (bar is { } placed)
                                        {
                                            <span class="@BarClass(row, placed)"
                                                  style="@($"grid-column: {placed.First + 2} / {placed.Last + 3}")"
                                                  role="img"
                                                  aria-label="@($"{row.Item.Title}, {DashboardFormat.Span(row.DrawnStart, row.DrawnEnd)}")"
                                                  title="@Sentence(row)"
                                                  data-testid="dashboard-roadmap-bar">
                                                <span class="dashboard-timeline__fill"
                                                      style="@($"width: {PlanOutlookFormat.DoneShare(row).ToString(CultureInfo.InvariantCulture)}%")"></span>
                                            </span>
                                        }
                                    </li>
                                }
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <MetricStatus Kind="Status" Message="@StatusMessage" TestId="dashboard-roadmap-status" />
        }
    </PartFrame>
}

@code {
    protected override DashboardSources Sources => DashboardSources.Tasks;

    /// <summary>A plan is filed under repositories, so the chips narrow it — the
    /// insight keeps the plan-wide items in every scope.</summary>
    protected override bool FollowsRepository => true;

    /// <summary>The window picks which items overlap it.</summary>
    protected override bool FollowsWindow => true;

    private const string Note =
        "The roadmap's items whose own window overlaps the selected one, with the effort gathered "
        + "under each and how much of it is ticked off. The pace is the one the roadmap places work "
        + "at for the repositories in scope; an item's outlook uses its own repositories' pace "
        + "(ADR 0013). The repository chips narrow it; the machine filter does not apply, because a "
        + "plan records no machine.";

    /// <summary>The stretch the pace was measured over, in words — or that nothing was
    /// measured and the figure is the one typed on the roadmap.</summary>
    private static string Basis(PlanPaceBasis basis) => basis switch
    {
        PlanPaceBasis.LastTwoWeeks => "Measured over the last 2 weeks",
        PlanPaceBasis.LastFourWeeks => "Measured over the last 4 weeks",
        PlanPaceBasis.LastEightWeeks => "Measured over the last 8 weeks",
        _ => "Set by hand in the roadmap"
    };

    /// <summary>Only when something was left unweighed: a footnote saying "0 entries
    /// have no estimate" on every complete reading would train the reader past it.</summary>
    private string? PlannedFootnote =>
        IsReady && Value!.Unestimated > 0
            ? Value!.Unestimated == 1
                ? "1 gathered entry has no estimate and adds nothing, so this is a floor."
                : $"{Value!.Unestimated} gathered entries have no estimate and add nothing, so this is a floor."
            : null;

    /// <summary>
    /// The line under an item's name: the effort done against the effort gathered, and
    /// the outlook in the board's chip words, the Overview's own. An item nothing it gathered is estimated on has no points
    /// to compare, so it says the count of entries instead of "0 / 0 pts".
    /// </summary>
    private static string Progress(PlanItemInsight row) =>
        row.Item.TotalEffort == 0
            ? $"{row.Item.DoneCount} of {row.Item.GatheredCount} entries · {PlanOutlookFormat.Chip(row)}"
            : $"{row.Item.DoneEffort} / {row.Item.TotalEffort} pts · {PlanOutlookFormat.Chip(row)}";

    /// <summary>How far past today the axis may run: half a year. One item planned to
    /// end years out would otherwise stretch the axis and squash every other bar; past
    /// this it is drawn clipped at the edge, which its squared-off end says.</summary>
    private const int FurthestAheadDays = 7 * 26;

    /// <summary>
    /// The Monday of every ISO week the axis shows, oldest first: from the window's first
    /// week — the weeks the task charts below bucket into — through the latest drawn end
    /// of an item it shows (<see cref="PlanInsight.TimelineTo"/>), never past
    /// <see cref="FurthestAheadDays"/> beyond today. An insight built without a window
    /// falls back to the items' own stretch.
    /// </summary>
    private IReadOnlyList<DateOnly> Weeks
    {
        get
        {
            if (!IsReady) return [];

            var (from, to) = Axis(Value!);
            if (from == default || to < from) return [];

            var weeks = new List<DateOnly>();
            var last = Monday(to);

            // Bounded rather than trusted: an absurd fallback stretch should draw a wide
            // axis, not hang the pane.
            for (var cursor = Monday(from); cursor <= last && weeks.Count < 104; cursor = cursor.AddDays(7))
            {
                weeks.Add(cursor);
            }

            return weeks;
        }
    }

    /// <summary>The first and last day the axis covers. Public to the tests through the
    /// rendered weeks only; the rule is the window to the latest drawn item end, capped.</summary>
    private static (DateOnly From, DateOnly To) Axis(PlanInsight plan)
    {
        if (plan.WindowFrom == default)
        {
            return plan.Items.Count == 0
                ? (default, default)
                : (plan.Items.Min(row => row.DrawnStart), plan.Items.Max(row => row.DrawnEnd));
        }

        var to = plan.TimelineTo == default ? plan.WindowTo : plan.TimelineTo;
        var furthest = plan.WindowTo.AddDays(FurthestAheadDays);

        return (plan.WindowFrom, to > furthest ? furthest : to);
    }

    /// <summary>The Monday of the week today falls in, where the window ends; default
    /// for an insight built without a window, which has no today to mark.</summary>
    private DateOnly TodayWeek => IsReady && Value!.WindowFrom != default ? Monday(Value!.WindowTo) : default;

    /// <summary>Where today sits along the weeks, as a share of their width — the start
    /// of its week plus the days into it — or null when it is not on the axis.</summary>
    private double? TodayAt(IReadOnlyList<DateOnly> weeks)
    {
        if (TodayWeek == default || weeks.Count == 0) return null;

        var index = (TodayWeek.DayNumber - weeks[0].DayNumber) / 7;
        if (index < 0 || index >= weeks.Count) return null;

        var into = Value!.WindowTo.DayNumber - TodayWeek.DayNumber + 0.5;

        return (index + into / 7d) / weeks.Count;
    }

    private static DateOnly Monday(DateOnly day) =>
        day.AddDays(-(((int)day.DayOfWeek + 6) % 7));

    /// <summary>An axis label as the task charts write one: <c>W41</c>.</summary>
    private static string WeekLabel(DateOnly monday) =>
        "W" + ISOWeek.GetWeekOfYear(monday.ToDateTime(TimeOnly.MinValue)).ToString("00", CultureInfo.InvariantCulture);

    /// <summary>Where an item's bar sits, as week indexes into <see cref="Weeks"/>, and
    /// whether either end was cut off by the window. The bar spans the item's drawn days,
    /// so a finished one stops where its work landed. The window keeps an item by its
    /// planned days, so one that landed before the window opened is still handed over: it
    /// is drawn in the first week, cut off there, rather than left as an empty lane. Null
    /// only when the item starts past the axis.</summary>
    private readonly record struct Placement(int First, int Last, bool ClippedStart, bool ClippedEnd);

    private static Placement? Place(PlanItemInsight row, IReadOnlyList<DateOnly> weeks)
    {
        if (weeks.Count == 0) return null;

        var (start, end) = (row.DrawnStart, row.DrawnEnd);
        var axisStart = weeks[0];
        var axisEnd = weeks[^1].AddDays(6);
        if (start > axisEnd) return null;
        if (end < axisStart) end = axisStart;

        var first = (Monday(start < axisStart ? axisStart : start).DayNumber - axisStart.DayNumber) / 7;
        var last = (Monday(end > axisEnd ? axisEnd : end).DayNumber - axisStart.DayNumber) / 7;

        return new Placement(first, Math.Max(first, last), start < axisStart, end > axisEnd);
    }

    /// <summary>The tone the bar is drawn in. Behind and overdue share the behind tone —
    /// both are work landing later than planned — and a finished item the success one.</summary>
    private static string BarClass(PlanItemInsight row, Placement placed)
    {
        var tone = row.Outlook switch
        {
            PlanOutlook.Behind or PlanOutlook.Overdue => " dashboard-timeline__bar--behind",
            PlanOutlook.Finished => " dashboard-timeline__bar--finished",
            _ => null
        };

        return "dashboard-timeline__bar" + tone
            + (placed.ClippedStart ? " dashboard-timeline__bar--clipped-start" : null)
            + (placed.ClippedEnd ? " dashboard-timeline__bar--clipped-end" : null);
    }

    /// <summary>
    /// What the word stands on: the projected end and the pace it was projected at
    /// beside the planned end, where there is a projection — or why there is none. The
    /// bar's title rather than more text in the row, so the row stays two
    /// lines tall and the reasoning is one pointer away from the bar it explains.
    /// </summary>
    private static string Sentence(PlanItemInsight row)
    {
        var item = row.Item;
        var planned = DashboardFormat.Date(item.End);
        var pace = Paces(item);

        return row.Outlook switch
        {
            PlanOutlook.Finished => row.ProjectedEnd is { } landed
                ? $"Every gathered entry is done; the last on {DashboardFormat.Date(landed)}. Planned to end {planned}."
                : $"Every gathered entry is done. Planned to end {planned}.",
            PlanOutlook.OnTrack or PlanOutlook.Behind when row.ProjectedEnd is { } projected =>
                $"Projected to end {DashboardFormat.Date(projected)} at {pace} pts/week; planned to end {planned}.",
            PlanOutlook.Overdue => row.ProjectedEnd is { } late
                ? $"Planned to end {planned}, which has passed with {item.TotalEffort - item.DoneEffort} pts still open; projected to end {DashboardFormat.Date(late)} at {pace} pts/week."
                : $"Planned to end {planned}, which has passed with work still open.",
            PlanOutlook.Unsized => "Nothing it gathered carries an estimate, so there is nothing to project.",
            PlanOutlook.NoPace => "There is no pace to project at for its repositories.",
            PlanOutlook.PlacedByEffort =>
                $"Its window is still the one the importer sized from effort, so it moves with the pace and is not judged against itself. Planned to end {planned}.",
            _ => $"Planned to end {planned}."
        };
    }

    /// <summary>
    /// The pace the projection counted at, ahead of "pts/week": one figure when every part
    /// with work left runs at the same pace, else each repository's — "app 8, site 4" — since
    /// every part is projected at its own repository's pace.
    /// </summary>
    private static string Paces(PlanItemProgress item)
    {
        var counted = item.Parts.Where(part => part.RemainingEffort > 0 && part.PacePointsPerWeek > 0).ToList();
        if (counted.Count == 0) counted = [.. item.Parts];

        var distinct = counted.Select(part => part.PacePointsPerWeek).Distinct().ToList();
        if (distinct.Count <= 1) return MetricFormat.Score(distinct.FirstOrDefault());

        return string.Join(
            ", ",
            counted
                .GroupBy(part => part.Alias ?? "unfiled", StringComparer.OrdinalIgnoreCase)
                .Select(group => $"{group.Key} {MetricFormat.Score(group.First().PacePointsPerWeek)}"));
    }

    protected override Task<InsightResult<PlanInsight>> FetchAsync(CancellationToken cancellationToken) =>
        Insights.GetPlanAsync(Scope, cancellationToken);

    /// <summary>
    /// Empty when the roadmap is on and nothing it holds overlaps the window. Not when
    /// it is off: that answer renders nothing at all, for the reason the header gives,
    /// and an empty state would be the part announcing the switched-off surface anyway.
    /// </summary>
    protected override bool IsEmpty(PlanInsight value) => value.RoadmapEnabled && value.Items.Count == 0;

    protected override string EmptyMessage => "No roadmap item overlaps this window.";

    // Nothing to drop: the roadmap is read afresh on every call, as the tasks are.
    protected override void InvalidateSource()
    {
    }
}
