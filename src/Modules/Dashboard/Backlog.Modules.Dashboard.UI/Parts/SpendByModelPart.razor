@*
    Where the money went, by model, across every provider in one table.

    One table rather than one per provider. The question here is which model costs
    the most, and answering it across tables makes the reader do the merge by eye.
    The provider travels in each row's detail column instead.

    The tokens column is populated for Claude and empty for the other two, and that
    is a fact about the APIs rather than a gap: Anthropic reports tokens beside its
    cost, GitHub meters in AI credits, Azure meters in each meter's own unit. Putting
    those under a heading that says Tokens would place different units in one
    column, so the cell stays unreported — MetricBreakdown draws that as an em dash,
    which is a different statement from a zero. An Azure row is a meter rather than
    a model — the model plus the direction of its tokens — because that is what the
    bill names.
*@
@inherits DashboardPartBase<SpendByModelInsight>
@inject ICostInsights Costs

<PartFrame Title="Spend by model"
           Note="Your own usage this month. Tokens are reported by Claude only — Copilot meters in AI credits and Azure Foundry in per-meter units, which are different units and are left out of that column rather than mixed into it. Azure rows are billing meters: one model appears once per token direction."
           Busy="Status == MetricStatusKind.Loading"
           OnRefresh="RefreshAsync"
           TestId="dashboard-spend-model">
    <MetricBreakdown Rows="@Rows"
                     Label="Spend by model this month"
                     NameHeading="Model"
                     TokensHeading="Tokens"
                     CostHeading="Spend"
                     ShareOf="MetricShareOf.Cost"
                     Status="Status"
                     StatusMessage="@StatusMessage"
                     TestId="dashboard-spend-model-table" />
</PartFrame>

@code {
    /// <summary>Spend narrows by nothing on the filter strip. See
    /// <see cref="DashboardPartBase{T}.FollowsRepository"/>.</summary>
    protected override bool FollowsRepository => false;

    protected override bool FollowsWindow => false;

    private IReadOnlyList<MetricRow> Rows =>
        IsReady
            ? [.. Value!.Rows.Select(row => new MetricRow(
                row.Name,
                row.Tokens,
                row.Cost is null ? null : new MoneyAmount(row.Cost.Amount, row.Cost.Currency),
                row.Detail))]
            : [];

    protected override Task<InsightResult<SpendByModelInsight>> FetchAsync(CancellationToken cancellationToken) =>
        Costs.GetByModelAsync(cancellationToken);

    protected override bool IsEmpty(SpendByModelInsight value) => value.Rows.Count == 0;

    protected override string EmptyMessage =>
        "No spend to break down this month.";

    protected override void InvalidateSource() => Costs.Invalidate();
}
