@using global::Backlog.UI.Components.Icons
@*
    The frame every part of the dashboard wears: a title, an optional note saying
    what the figures do and do not cover — behind an info mark, not on the face,
    so the figures are what the part shows — a refresh control, and the part's
    own content below.

    It exists so the seven parts look like seven parts of one thing without each
    of them re-deciding what a heading is. There is nothing configurable on it —
    no fold, no hide, no reorder — because the dashboard's composition is fixed;
    its own control is refresh, which changes what is shown rather than which
    parts exist. Beside it, where the shell can answer, is Ask AI, which opens the
    assistant on the Dashboard with a question naming the part (DashboardAskAi).
    A part may put a control of its own on the heading's line through
    Actions — the volume chart's measure — and that too only changes what the part
    draws, never which parts exist.

    Not a shared-library component. It is the dashboard's own page furniture and a
    second host would want its own rhythm, which is the same reason the storybook
    keeps sb-dashboard-panel to itself rather than publishing it.
*@

<section class="dashboard-part @CssClass" data-testid="@TestId">
    <header class="dashboard-part__header">
        <div class="dashboard-part__heading">
            <h3 class="dashboard-part__title">@Title</h3>
            @if (!string.IsNullOrWhiteSpace(Note))
            {
                @* Beside the heading rather than inside it, so the heading's name
                   stays the title and the mark's name stays "About <title>". *@
                <InfoHint AriaLabel="@($"About {Title}")"
                          Text="@Note"
                          CssClass="dashboard-part__hint"
                          TriggerTestId="@(TestId is null ? null : TestId + "-info")"
                          TooltipTestId="@(TestId is null ? null : TestId + "-note")" />
            }
        </div>

        @if (Actions is not null)
        {
            @* A control that changes what the part draws rather than which part this
               is — the volume chart's measure — sits on the heading's line, before
               refresh. *@
            <div class="dashboard-part__actions">
                @Actions
            </div>
        }

        @if (AskAi is not null)
        {
            @* Opens the shell's Ask AI panel on the Dashboard with a question that
               names this part. Only while the pane cascades a handler — the shell
               offers one when the assistant is on and has a Dashboard source — so a
               frame never shows a control that leads nowhere. Before refresh, so the
               control that changes nothing on the part sits apart from the one that
               does. *@
            <IconButton AriaLabel="@($"Ask AI about {Title}")"
                        Title="Ask AI"
                        CssClass="btn--ghost dashboard-part__ask"
                        TestId="@(TestId is null ? null : TestId + "-ask-ai")"
                        OnClick="() => AskAi.AskAsync(Title)"><SparklesIcon Size="14" /></IconButton>
        }

        @* A refresh while one is already in flight would only cancel and restart
           it, so the control reports the wait rather than offering to duplicate it:
           its glyph turns into a spinner and a press is dropped. It is blocked with
           aria-disabled rather than the native attribute, so the focus a press put
           on it survives the refresh (interaction-guidelines.md#accessibility). *@
        <IconButton AriaLabel="@($"Refresh {Title}")"
                    Title="@(Busy ? "Refreshing" : "Refresh")"
                    CssClass="btn--ghost"
                    aria-disabled="@(Busy ? "true" : null)"
                    aria-busy="@(Busy ? "true" : null)"
                    TestId="@(TestId is null ? null : TestId + "-refresh")"
                    OnClick="RefreshAsync">
            @if (Busy)
            {
                <Spinner Size="SpinnerSize.Small" Label="Refreshing" />
            }
            else
            {
                @("↻")
            }
        </IconButton>
    </header>

    <div class="dashboard-part__content" aria-busy="@(Busy ? "true" : null)">
        @ChildContent
    </div>
</section>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    /// <summary>What the figures cover, read on hover or focus of the info mark.
    /// The cost parts use it to say they are not filtered by repository, which is
    /// the one thing about this dashboard a reader could otherwise get wrong.</summary>
    [Parameter]
    public string? Note { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Controls on the heading's line, between the title and refresh.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>The pane's Ask AI handler, or null where nobody can answer — see
    /// <see cref="DashboardAskAi"/>.</summary>
    [CascadingParameter]
    public DashboardAskAi? AskAi { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    private Task RefreshAsync() => Busy ? Task.CompletedTask : OnRefresh.InvokeAsync();
}
