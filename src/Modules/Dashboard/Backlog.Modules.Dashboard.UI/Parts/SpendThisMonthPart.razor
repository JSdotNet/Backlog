@*
    What your assistants have cost this calendar month.

    A calendar month rather than a rolling thirty days, because a bill arrives per
    calendar month and "this month" has to mean what the invoice will mean.

    One tile per provider, never a total. The figures are not the same kind of
    number: Anthropic reports an estimate against its own published rates, GitHub
    reports what it charged, Azure reports what it billed in the subscription's own
    currency. Adding them would produce a single authoritative-looking figure that
    is partly an estimate and possibly in two currencies, and nothing on screen
    would say which part. So each tile says whose it is and whether it is
    estimated, and the reader does the addition knowing that.

    Each tile is a card: the spend so far out of the provider's monthly budget, a
    meter with a mark where the month-end projection falls, and a chip saying
    whether that projection passes the budget. The budget is the person's own,
    set in Dashboard settings; a provider with none shows its spend and projection
    and no meter, because a meter needs a ceiling and nobody published one.

    Charged against consumed is a caption, and only for a provider that reported
    a discount — today Copilot: GitHub says how much of the month's consumption
    the plan already covered. Anthropic and Azure report no allowance, so for them
    what was charged is all there is to say.
*@
@inherits DashboardPartBase<SpendThisMonthInsight>
@inject ICostInsights Costs

<PartFrame Title="Spend this month"
           Note="Your own usage, across everything — Claude, Copilot, and the Azure Foundry resource in Settings. No provider reports spend per repository, so the repository filter does not change these figures."
           Busy="Status == MetricStatusKind.Loading"
           OnRefresh="RefreshAsync"
           TestId="dashboard-spend-month">
    @if (IsReady)
    {
        <div class="dashboard-part__stack">
            <MetricGrid Label="Spend so far this month" TestId="dashboard-spend-month-tiles">
                @foreach (var provider in Value!.Providers)
                {
                    <MetricTile Label="@Name(provider.Provider)"
                                Value="@MetricFormat.Money(new MoneyAmount(provider.Spend.Amount, provider.Spend.Currency))"
                                Emphasis="@(provider.Provider == SpendProvider.Claude)"
                                Footnote="@Footnote(provider)"
                                TestId="@($"dashboard-spend-month-{Slug(provider.Provider)}")"
                                Unit="@OfBudget(provider)"
                                CssClass="dashboard-spend-card">
                        <Trend>
                            @if (ProjectionOf(provider) is { } projection && projection.Budget is { } budget)
                            {
                                <Badge Kind=""
                                       Slug="@(projection.IsProjectedPastBudget ? "over" : "within")"
                                       BaseClass="dashboard-spend-card__chip"
                                       TestId="@($"dashboard-spend-month-chip-{Slug(provider.Provider)}")">
                                    @(projection.IsProjectedPastBudget ? "Will pass budget" : "Within budget")
                                </Badge>
                                <MetricMeter AriaLabel="@($"{Name(provider.Provider)} spend against its monthly budget")"
                                             Value="@provider.Spend.Amount"
                                             Max="@budget.Amount"
                                             Marker="@projection.Projected.Amount"
                                             MarkerLabel="@($"Projected {Money(projection.Projected)}")"
                                             FormatValue="@(amount => MetricFormat.Money(new MoneyAmount(amount, provider.Spend.Currency)))"
                                             Caption=""
                                             TestId="@($"dashboard-spend-month-meter-{Slug(provider.Provider)}")" />
                            }
                        </Trend>
                    </MetricTile>
                }
            </MetricGrid>
        </div>
    }
    else
    {
        <MetricStatus Kind="Status" Message="@StatusMessage" TestId="dashboard-spend-month-status" />
    }
</PartFrame>

@code {
    /// <summary>Spend narrows by nothing on the filter strip — not the repository, not
    /// the machine, not the window — so none of them may make this part fetch again. The
    /// machine needs no override: <see cref="DashboardPartBase{T}.FollowsMachine"/> is
    /// already false for every part that did not ask for it. See
    /// <see cref="DashboardPartBase{T}.FollowsRepository"/>.</summary>
    protected override bool FollowsRepository => false;

    protected override bool FollowsWindow => false;

    /// <summary>Each provider's projection and budget, by provider. Empty when the
    /// projection could not be read, which costs the cards their meter and chip and
    /// leaves the spend standing.</summary>
    private IReadOnlyDictionary<SpendProvider, SpendProjection> _projections =
        new Dictionary<SpendProvider, SpendProjection>();

    /// <summary>
    /// The month's spend, and beside it the projection the meter and chip read. Both
    /// derive from one cached read of the month, so the second call asks no provider
    /// again.
    /// </summary>
    protected override async Task<InsightResult<SpendThisMonthInsight>> FetchAsync(CancellationToken cancellationToken)
    {
        var month = await Costs.GetThisMonthAsync(cancellationToken);
        var projection = await Costs.GetProjectionAsync(cancellationToken);

        _projections = projection.HasValue
            ? projection.Value!.Providers.ToDictionary(one => one.Provider)
            : new Dictionary<SpendProvider, SpendProjection>();

        return month;
    }

    /// <summary>
    /// Empty when no provider is in the list. A provider present with a spend of
    /// nothing is a real answer — you used no credits this month — and shows as a
    /// zero rather than as an empty part.
    /// </summary>
    protected override bool IsEmpty(SpendThisMonthInsight value) => value.Providers.Count == 0;

    protected override string EmptyMessage =>
        "No assistant reported any spend this month.";

    protected override void InvalidateSource() => Costs.Invalidate();

    private static string Name(SpendProvider provider) => provider switch
    {
        SpendProvider.Claude => "Claude",
        SpendProvider.Copilot => "Copilot",
        SpendProvider.AzureFoundry => "Azure Foundry",
        _ => provider.ToString()
    };

    private static string Slug(SpendProvider provider) => provider switch
    {
        SpendProvider.Claude => "claude",
        SpendProvider.Copilot => "copilot",
        SpendProvider.AzureFoundry => "azure-foundry",
        _ => provider.ToString().ToLowerInvariant()
    };

    private SpendProjection? ProjectionOf(MonthlySpend provider) =>
        _projections.TryGetValue(provider.Provider, out var projection) ? projection : null;

    /// <summary>"of $250" beside the spend, when the provider has a budget.</summary>
    private string? OfBudget(MonthlySpend provider) =>
        ProjectionOf(provider)?.Budget is { } budget ? $"of {Money(budget)}" : null;

    /// <summary>
    /// What was charged against what was consumed, where the provider reported the
    /// difference, and where the month is heading. A provider with no allowance says
    /// which days the figure covers instead, because charged is all there is.
    /// </summary>
    private string Footnote(MonthlySpend provider)
    {
        var parts = new List<string>
        {
            provider.Allowance is { } allowance
                ? $"Charged {Money(provider.Spend)} against {Money(provider.Spend + allowance)} consumed"
                : $"1–{provider.Through.Day} {provider.Through:MMM}"
        };

        if (ProjectionOf(provider) is { } projection) parts.Add($"projected {Money(projection.Projected)}");

        var caption = string.Join(" · ", parts);

        return provider.IsEstimate
            ? $"{caption}, estimated by the provider"
            : caption;
    }

    private static string Money(DashboardMoney money) =>
        MetricFormat.Money(new MoneyAmount(money.Amount, money.Currency));
}
