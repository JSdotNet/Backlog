@*
    Spend over time — this calendar month, day by day, to its last day.

    The question on the Cost tab is whether the month will stay inside its budget,
    so the chart runs to the month's end rather than stopping at today. The days
    after today are projected — each at the providers' average daily spend over the
    last seven days, the same average the cards project from — and drawn faded, so a
    projection never reads as spend that happened.

    Cumulative or per day, the reader's choice. Cumulative answers the budget
    question and so carries the budget line: the sum of the providers' budgets,
    dashed. Per day shows the rhythm of the month, where a running budget would mean
    nothing, so the line goes with the mode.

    One bar per day across the providers, which is the one place on this tab they
    are added: the budget line is a sum, and bars set against it have to be one too.
    Across two currencies the module refuses to add them and the part says so,
    rather than drawing a total in no currency at all.
*@
@inherits DashboardPartBase<SpendByDayInsight>
@inject ICostInsights Costs

<PartFrame Title="Spend over time"
           Note="@Note"
           Busy="Status == MetricStatusKind.Loading"
           OnRefresh="RefreshAsync"
           TestId="dashboard-spend-trend">
    @if (IsReady)
    {
        <div class="dashboard-part__stack">
            <ButtonGroup AriaLabel="Cumulative or per day" CssClass="dashboard-spend-trend__mode" TestId="dashboard-spend-trend-mode">
                <ToggleButton Pressed="_cumulative"
                              PressedChanged="_ => _cumulative = true"
                              TestId="dashboard-spend-trend-cumulative">
                    Cumulative
                </ToggleButton>
                <ToggleButton Pressed="!_cumulative"
                              PressedChanged="_ => _cumulative = false"
                              TestId="dashboard-spend-trend-daily">
                    Per day
                </ToggleButton>
            </ButtonGroup>

            <MetricBars Points="@Points"
                        Label="@Label"
                        Note="@(ProjectedFrom is null ? null : "Faded bars are projected from the last 7 days.")"
                        BucketHeading="Day"
                        ValueHeading="Spend"
                        ProjectedFrom="@ProjectedFrom"
                        Reference="@(_cumulative ? Value!.Budget?.Amount : null)"
                        ReferenceLabel="@BudgetLabel"
                        MaxLabels="6"
                        FormatValue="Money"
                        TestId="dashboard-spend-trend-bars" />
        </div>
    }
    else
    {
        <MetricStatus Kind="Status" Message="@StatusMessage" TestId="dashboard-spend-trend-status" />
    }
</PartFrame>

@code {
    /// <summary>Spend narrows by nothing on the filter strip. See
    /// <see cref="DashboardPartBase{T}.FollowsRepository"/>.</summary>
    protected override bool FollowsRepository => false;

    protected override bool FollowsWindow => false;

    /// <summary>Cumulative first: it is the view that answers the budget question.</summary>
    private bool _cumulative = true;

    private string Note =>
        IsReady && Value!.IsEstimate
            ? "Your own usage this calendar month, across every provider. Some of it is estimated by the provider."
            : "Your own usage this calendar month, across every provider.";

    private string Label => IsReady
        ? $"{(_cumulative ? "Spend so far" : "Spend per day")}, {Value!.Currency}"
        : "Spend per day";

    private string? BudgetLabel =>
        _cumulative && IsReady && Value!.Budget is { } budget
            ? $"Budget {MetricFormat.Money(new MoneyAmount(budget.Amount, budget.Currency))}"
            : null;

    /// <summary>The index of the first day after today, or null when the month has no
    /// days left to project.</summary>
    private int? ProjectedFrom
    {
        get
        {
            if (!IsReady) return null;

            var index = Value!.Days.ToList().FindIndex(day => day.IsProjected);

            return index < 0 ? null : index;
        }
    }

    private IReadOnlyList<MetricPoint> Points
    {
        get
        {
            if (!IsReady) return [];

            var running = 0m;

            return
            [
                .. Value!.Days.Select(day => new MetricPoint(
                    day.Date.ToString("d MMM", System.Globalization.CultureInfo.CurrentCulture),
                    _cumulative ? running += day.Amount : day.Amount))
            ];
        }
    }

    protected override Task<InsightResult<SpendByDayInsight>> FetchAsync(CancellationToken cancellationToken) =>
        Costs.GetByDayAsync(cancellationToken);

    /// <summary>
    /// Empty when no day of the month — reported or projected — has any spend in it. A
    /// month of nothing is drawn as an empty part rather than as a chart of nothing.
    /// </summary>
    protected override bool IsEmpty(SpendByDayInsight value) =>
        value.Days.Count == 0 || value.Days.All(day => day.Amount == 0m);

    protected override string EmptyMessage =>
        "No spend this month.";

    protected override void InvalidateSource() => Costs.Invalidate();

    private string Money(decimal amount) =>
        MetricFormat.Money(new MoneyAmount(amount, Value?.Currency ?? "USD"));
}
