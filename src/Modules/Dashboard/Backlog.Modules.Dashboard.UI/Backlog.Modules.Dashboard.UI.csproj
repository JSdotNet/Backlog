<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The Dashboard context's UI: the full-screen surface, its eight parts, the Ask AI
    source over what the pane shows, and the one adapter that wraps no provider -
    the machine directory, which reads this device's identity.

    The provider adapters are not here. Each lives in the infrastructure project it
    maps from - Backlog.Infrastructure.GitHub, .Claude and .AzureFoundry - and
    answers its port in the Abstractions project, which is the only part of this
    context those projects see. They used to live here; a screen project that owned
    them could not be hosted without every provider client, and HTTP-backed mapping
    is not a screen's job. The assistant-session facts are a cross-context join, so
    the adapter answering that port is in Backlog.Infrastructure.FileSystem, which
    is the only place allowed to see the Sessions context as well as this one.

    No infrastructure reference at all, then, and no sibling module's surface
    either, which is why the absent context-map entry for a Dashboard context
    constrains nothing yet.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.Modules.Dashboard.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- The machine directory's union of this device and the machines the records
         name is worth testing directly rather than only through the pane. -->
    <InternalsVisibleTo Include="Backlog.Desktop.UI.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Backlog.UI.Components\Backlog.UI.Components.csproj" />
    <ProjectReference Include="..\..\..\Core\Backlog.SharedKernel\Backlog.SharedKernel.csproj" />
    <!-- The module's published surface only: the scope, the DTOs, the two
         questions the parts ask, and the ports the adapters answer. The
         derivations stay behind that line — the host wires them up, the parts do
         not see them. -->
    <ProjectReference Include="..\Backlog.Modules.Dashboard.Abstractions\Backlog.Modules.Dashboard.Abstractions.csproj" />
  </ItemGroup>

</Project>
