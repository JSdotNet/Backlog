@*
    The Dashboard's page on the settings screen, which the shell draws because the
    host registered it (AddDashboardSettings, reached through AddDashboardUi) rather
    than because the shell knows anything about the dashboard. The weekly usage
    reset was a group under the working week on the shell's Storage page; only the
    dashboard reads it, so a change to how it is set touches the Dashboard and not
    the desktop shell.

    The namespace is the project's root rather than the folder's, on the Inbox's
    precedent: a Backlog.Modules.Dashboard.UI.Settings namespace would shadow the
    settings screen's own component for everything under this project.
*@
@namespace Backlog.Modules.Dashboard.UI
@using System.Globalization
@using global::Backlog.SharedKernel
@using global::Backlog.UI.Components.Inputs
@using global::Backlog.UI.Components.Settings
@using global::Backlog.Modules.Dashboard.Abstractions.Insights
@using global::Backlog.Modules.Dashboard.Abstractions.Services
@using Microsoft.JSInterop
@using global::Backlog.UI.Components.Badges
@using global::Backlog.UI.Components.Buttons
@implements IDisposable
@inject IUsageResetSettings UsageReset
@inject IJSRuntime JS
@inject ISpendBudgetSettings SpendBudgets

<SettingsHeadline>@Headline</SettingsHeadline>

<div class="setting-columns">
@* The weeks the dashboard cuts by. The assistant's allowance resets on a fixed
   weekday and time, and a week of sessions read against calendar Mondays is a week
   nobody spends; each row is the person's own reading of the "Resets Mon 2:00 PM" on
   one account's usage screen, in their own clock. A person with two accounts has two
   resets, so the card holds a named list and the Sessions tab picks which one cuts
   the weeks. Plain rows rather than editors that expand in place: a reset is three
   fields, and an editor opened under a row would be the row again. Detection from
   the assistant's records stands in while the list is empty. Add a reset sits in the
   card's corner, where the settings card puts an action that belongs to the whole
   card rather than to its last row. *@
<SettingsCard Title="@UsageResetCardTitle"
              Description="When each of your assistant accounts' weekly allowance resets, as its usage screen shows it in your own clock."
              TestId="usage-reset-settings">
    <Action>
        <AppButton Variant="ButtonVariant.Secondary"
                   data-testid="usage-reset-add-button"
                   OnClick="AddUsageReset">
            Add a reset
        </AppButton>
    </Action>
    <ChildContent>
    <p class="setting__note">
        The dashboard's weekly columns and hour grids then run from one reset to the
        next instead of from a calendar Monday. With more than one reset, the Sessions
        tab chooses which of them cuts the weeks.
    </p>

    @if (UsageReset.Resets.Count == 0)
    {
        <p class="setting__note" data-testid="usage-reset-empty">
            No reset yet. The dashboard uses the reset it detects from your assistant's
            records, or calendar weeks.
        </p>
    }

    <div class="dashboard-usage-reset-list">
    @foreach (var (reset, position) in UsageReset.Resets.Select((reset, index) => (reset, index + 1)))
    {
        @* The badge is a line of its own over the row's controls rather than a cell
           beside them: a fourth column that only one row fills took its width out of
           the day and the time, and a card as narrow as the harness's squeezed them
           to a letter. The day is the select's inline shape, its name read aloud and
           not printed, like the name and time beside it: a printed "<name> resets on"
           wrapped over three lines in a column that narrow, and the row's values
           already say what each field is. *@
        <div class="working-day dashboard-usage-reset-row" data-testid="usage-reset-row" data-reset-id="@reset.Id" @key="reset.Id">
            @if (UsageReset.Resets.Count >= 2 && UsageReset.Selected?.Id == reset.Id)
            {
                <Badge Kind="tone" Slug="live" CssClass="dashboard-usage-reset-row__badge" TestId="usage-reset-in-use">Cuts the dashboard's weeks</Badge>
            }

            <TextField Bare="true"
                       InputCssClass="@($"{InputClass(reset.Id, NameField)} dashboard-usage-reset-row__name")"
                       AriaLabel="@($"Reset name, row {position}")"
                       Id="@NameInputId(reset.Id)"
                       data-testid="usage-reset-name"
                       autocomplete="off"
                       maxlength="@NamedUsageReset.MaxNameLength"
                       aria-describedby="usage-reset-status"
                       Value="@Draft(reset.Id, NameField, reset.Name)"
                       @onchange="@(e => ApplyUsageResetName(reset.Id, e))" />

            <SelectField Label="@($"{reset.Name} resets on")"
                         Id="@($"usage-reset-day-{reset.Id}")"
                         BaseClass="dashboard-usage-reset-row__day"
                         SelectCssClass="setting__input"
                         TestId="usage-reset-day"
                         CurrentValue="@reset.Reset.Day.ToString()"
                         IncludeEmptyOption="false"
                         Options="@UsageResetDayOptions"
                         OnChanged="@(value => SetUsageResetDay(reset.Id, value))" />

            <TextField Bare="true"
                       InputCssClass="@InputClass(reset.Id, TimeField)"
                       AriaLabel="@($"{reset.Name} resets at")"
                       Id="@($"usage-reset-time-{reset.Id}")"
                       data-testid="usage-reset-time"
                       Type="time"
                       autocomplete="off"
                       aria-describedby="usage-reset-status"
                       Value="@Draft(reset.Id, TimeField, FormatTime(reset.Reset.Time))"
                       @onchange="@(e => ApplyUsageResetTime(reset.Id, e))" />

            <AppButton Variant="ButtonVariant.Danger"
                       Size="ButtonSize.Small"
                       data-testid="usage-reset-remove-button"
                       aria-label="@($"Remove {reset.Name}")"
                       OnClick="@(() => RemoveUsageReset(reset.Id))">
                Remove
            </AppButton>
        </div>
    }
    </div>

    <p class="setting__status" id="usage-reset-status" data-testid="usage-reset-status" role="status">
        @if (_usageResetError is not null)
        {
            <span class="setting__status--error">@_usageResetError</span>
        }
        else
        {
            <span>@UsageResetSummary</span>
        }
    </p>

    <p class="setting__note">
        Kept in <code>@UsageReset.SettingsPath</code>, beside the app's other per-user
        choices rather than in the backlog folder - it is yours, not the workspace's.
    </p>
    </ChildContent>
</SettingsCard>

@* The monthly spend budget, one amount per provider. Bare amounts, read in the
   currency each provider reports its spend in: Backlog holds no exchange rate, so a
   budget in any other currency could not be set against the spend. Committed on
   change rather than bound, so a half-typed amount never reaches the store. A text
   input with a decimal keypad rather than type="number": a number input hands the
   server an empty value for text it cannot parse, and empty means "no budget", so
   "1e" would silently delete the budget in force instead of being refused. *@
<SettingsCard Title="@SpendBudgetCardTitle"
              Description="How much you mean to spend on each assistant in a calendar month, in the currency that provider reports its spend in."
              TestId="spend-budget-settings">
    <p class="setting__note">
        The dashboard projects each provider's spend to the end of the month and says
        when it will pass its budget. Leave a provider empty and it has no budget.
    </p>

    @foreach (var provider in BudgetProviders)
    {
        <TextField Label="@BudgetLabel(provider)"
                   Id="@($"spend-budget-{Slug(provider)}")"
                   TestId="@($"spend-budget-{Slug(provider)}")"
                   inputmode="decimal"
                   autocomplete="off"
                   Placeholder="No budget"
                   Value="@BudgetDraft(provider)"
                   @onchange="@(e => ApplyBudget(provider, e))" />
    }

    <p class="setting__status" data-testid="spend-budget-status" role="status">
        @if (_budgetErrors.Count > 0)
        {
            <span class="setting__status--error">@string.Join(" ", BudgetProviders.Where(_budgetErrors.ContainsKey).Select(provider => _budgetErrors[provider]))</span>
        }
        else
        {
            <span>@BudgetSummary</span>
        }
    </p>

    <p class="setting__note">
        Kept in <code>@SpendBudgets.SettingsPath</code>, on this device only.
    </p>
</SettingsCard>
</div>

@code {
    /// <summary>The sentence the frame shows over this page.</summary>
    public const string Headline = "Choose what the dashboard counts and how it reads your week.";

    /// <summary>The page's cards, in the order it draws them - what its
    /// <c>SettingsSection.CardTitles</c> declares.</summary>
    public const string UsageResetCardTitle = "Weekly usage reset";

    public const string SpendBudgetCardTitle = "Monthly spend budget";

    private const string NameField = "name";

    private const string TimeField = "time";

    private string? _usageResetError;

    /// <summary>The field whose typed text was refused, which wears the error style
    /// and keeps showing what was typed so it can be corrected - one at a time,
    /// because the status line says one refusal.</summary>
    private (string Id, string Field, string Text)? _refused;

    /// <summary>The name field a just-added reset moves the focus to, once it is
    /// drawn.</summary>
    private string? _focusAfterRender;

    /// <summary>Why a field's typed amount was refused, per provider, so committing
    /// another field never hides a refusal whose text is still on screen.</summary>
    private readonly Dictionary<SpendProvider, string> _budgetErrors = [];

    /// <summary>What each budget field shows: the typed text while it is refused, so the
    /// person can correct it, and otherwise what the store holds.</summary>
    private readonly Dictionary<SpendProvider, string> _budgetDrafts = [];

    private static readonly SpendProvider[] BudgetProviders =
        [SpendProvider.Claude, SpendProvider.Copilot, SpendProvider.AzureFoundry];

    private static readonly IReadOnlyList<SelectorOption> UsageResetDayOptions =
        [.. WorkingHours.Week.Select(day => new SelectorOption(day.ToString(), day.ToString()))];

    /// <summary>The page stays alive while hidden, so a reset picked on the Sessions
    /// tab has to reach it: the badge and the summary name the reset in force.</summary>
    protected override void OnInitialized() => UsageReset.Changed += OnUsageResetChanged;

    private void OnUsageResetChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => UsageReset.Changed -= OnUsageResetChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusAfterRender is not { } id) return;

        _focusAfterRender = null;

        try
        {
            await JS.InvokeVoidAsync("backlogFocus", id, true);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    /// <summary>A new reset arrives complete - the next free "Account N", on the
    /// assistant's usual Monday afternoon - so a half-configured one never exists,
    /// and the focus goes to its name, the one field nobody keeps.</summary>
    private void AddUsageReset()
    {
        var (id, error) = UsageReset.Add(NextFreeName(), DayOfWeek.Monday, new TimeOnly(14, 0));

        _refused = null;
        _usageResetError = error;

        if (id is not null) _focusAfterRender = NameInputId(id);
    }

    private void RemoveUsageReset(string id)
    {
        _refused = null;
        _usageResetError = UsageReset.Remove(id);
    }

    private void ApplyUsageResetName(string id, ChangeEventArgs e)
    {
        if (Find(id) is not { } reset) return;

        var typed = e.Value?.ToString() ?? string.Empty;

        Commit(id, NameField, typed, UsageReset.Update(id, typed, reset.Reset.Day, reset.Reset.Time));
    }

    /// <summary>Picking a day keeps the reset's name and time.</summary>
    private void SetUsageResetDay(string id, string? value)
    {
        if (Find(id) is not { } reset || !Enum.TryParse<DayOfWeek>(value, ignoreCase: true, out var day)) return;

        _refused = null;
        _usageResetError = UsageReset.Update(id, reset.Name, day, reset.Reset.Time);
    }

    private void ApplyUsageResetTime(string id, ChangeEventArgs e)
    {
        if (Find(id) is not { } reset) return;

        var typed = e.Value?.ToString() ?? string.Empty;

        Commit(
            id,
            TimeField,
            typed,
            TryReadTime(typed, out var time)
                ? UsageReset.Update(id, reset.Name, reset.Reset.Day, time)
                : "Give the reset a time, as HH:mm.");
    }

    /// <summary>A refusal keeps the typed text on screen beside its reason; a value the
    /// store took shows what it now holds - including one that took effect but could
    /// not be written, whose message is not a refusal.</summary>
    private void Commit(string id, string field, string typed, string? error)
    {
        _refused = error is not null && !Took(id, field, typed) ? (id, field, typed) : null;
        _usageResetError = error;
    }

    private bool Took(string id, string field, string typed) =>
        Find(id) is { } reset
        && (field == NameField
            ? string.Equals(reset.Name, typed.Trim(), StringComparison.Ordinal)
            : TryReadTime(typed, out var time) && reset.Reset.Time == time);

    private NamedUsageReset? Find(string id) => UsageReset.Resets.FirstOrDefault(reset => reset.Id == id);

    private bool IsRefused(string id, string field) =>
        _refused is { } refused && refused.Id == id && refused.Field == field;

    private string Draft(string id, string field, string stored) =>
        IsRefused(id, field) ? _refused!.Value.Text : stored;

    private string InputClass(string id, string field) =>
        IsRefused(id, field) ? "setting__input setting__input--error" : "setting__input";

    private static string NameInputId(string id) => $"usage-reset-name-{id}";

    private string NextFreeName()
    {
        for (var number = UsageReset.Resets.Count + 1; ; number++)
        {
            var name = $"Account {number}";

            if (!UsageReset.Resets.Any(reset => string.Equals(reset.Name, name, StringComparison.OrdinalIgnoreCase))) return name;
        }
    }

    private void ApplyBudget(SpendProvider provider, ChangeEventArgs e)
    {
        var typed = (e.Value?.ToString() ?? string.Empty).Trim();
        _budgetDrafts[provider] = typed;

        string? error;

        if (typed.Length == 0)
        {
            error = SpendBudgets.Set(provider, null);
        }
        else if (decimal.TryParse(typed, NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var amount))
        {
            error = SpendBudgets.Set(provider, amount);
        }
        else
        {
            error = typed.StartsWith('-')
                ? "A budget can't be negative."
                : $"Give the {Name(provider)} budget as an amount, such as 50 or 49.50.";
        }

        if (error is null)
        {
            _budgetErrors.Remove(provider);
            _budgetDrafts.Remove(provider);
        }
        else
        {
            _budgetErrors[provider] = error;
        }
    }

    private string BudgetDraft(SpendProvider provider) =>
        _budgetDrafts.TryGetValue(provider, out var draft)
            ? draft
            : SpendBudgets.BudgetFor(provider)?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;

    private string BudgetSummary
    {
        get
        {
            var set = BudgetProviders
                .Where(provider => SpendBudgets.BudgetFor(provider) is not null)
                .Select(Name)
                .ToList();

            return set.Count == 0
                ? "No budgets set - the dashboard shows spend without one to set it against."
                : $"Budgets set for {string.Join(", ", set)}; the rest have none.";
        }
    }

    private static string BudgetLabel(SpendProvider provider) => $"{Name(provider)} budget a month";

    /// <summary>The provider as every cost part names it (AC27).</summary>
    private static string Name(SpendProvider provider) => provider.DisplayName();

    private static string Slug(SpendProvider provider) => provider switch
    {
        SpendProvider.AzureFoundry => "azure-foundry",
        _ => provider.ToString().ToLowerInvariant()
    };

    private string UsageResetSummary =>
        UsageReset.Selected is not { } selected
            ? string.Empty
            : UsageReset.Resets.Count == 1
                ? $"Weeks run from {Describe(selected.Reset)} to the next {Describe(selected.Reset)}, on this machine's clock."
                : $"{selected.Name} cuts the dashboard's weeks, from {Describe(selected.Reset)} to the next, on this machine's clock. Choose another on the Sessions tab.";

    private static string Describe(UsageWeekReset reset) => $"{reset.Day} {FormatTime(reset.Time)}";

    /// <summary>The wire format a <c>time</c> input takes and returns, and the
    /// one the settings file is written in - invariant, so the two never drift
    /// apart on a machine whose locale writes times some other way. The
    /// working-week editor beside it keeps its own copy.</summary>
    private static string FormatTime(TimeOnly time) =>
        time.ToString("HH:mm", CultureInfo.InvariantCulture);

    /// <summary>Seconds are accepted as well as minutes because a browser is
    /// entitled to send them, and refusing a time for being more precise than
    /// the field asked for is a rejection nobody could act on.</summary>
    private static bool TryReadTime(string text, out TimeOnly time) =>
        TimeOnly.TryParseExact(
            text,
            ["HH:mm", "HH:mm:ss"],
            CultureInfo.InvariantCulture,
            DateTimeStyles.None,
            out time);
}
