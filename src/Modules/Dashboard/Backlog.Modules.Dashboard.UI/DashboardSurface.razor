@using Microsoft.Extensions.DependencyInjection
@inject global::Backlog.SharedKernel.ISurfaceNavigator Navigator
@inject global::Backlog.SharedKernel.ISurfaceCatalog Catalog
@inject IServiceProvider Services

@*
    The Dashboard as a shell surface (local ADR 0043 §1, §3): a takeover, in the main
    window in place of the main view or in a window of its own. What it reads of the
    window — the repository scope, the hues and Ask AI — comes through the window's
    DashboardSurfaceWiring. The Sessions tab's link to every session is a jump to the
    Sessions surface through the window's navigator, offered while the catalog offers
    that surface. `tab=<id>` opens it on that tab: the Sessions surface's See usage asks
    for `tab=sessions`.
*@
<DashboardPane OnClose="OnClose"
               RepositoryAliases="@(_wiring?.RepositoryAliases?.Invoke() ?? [])"
               RepositoryColour="@_wiring?.RepositoryColour"
               OnOpenSessions="@OpenSessionsCallback"
               OnAskAi="@AskAiCallback"
               InitialTab="@InitialTab" />

@code {
    /// <summary>The Sessions surface's id, named here as a string, since the Dashboard
    /// module references no Sessions UI project.</summary>
    private const string SessionsSurfaceId = "sessions";

    /// <summary>The query the surface was shown with: <c>tab=&lt;id&gt;</c> opens it on that
    /// tab — <c>tab=sessions</c> is a Holding dispatcher's See usage — or nothing.</summary>
    [Parameter]
    public IReadOnlyDictionary<string, string>? Query { get; set; }

    /// <summary>The query key naming the tab the Dashboard opens on.</summary>
    public const string TabKey = "tab";

    private string? InitialTab =>
        Query is not null && Query.TryGetValue(TabKey, out var tab) && tab.Length > 0 ? tab : null;

    /// <summary>Closes the surface: back to the main view, or the window closed.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private DashboardSurfaceWiring? _wiring;

    protected override void OnInitialized() => _wiring = Services.GetService<DashboardSurfaceWiring>();

    private EventCallback OpenSessionsCallback =>
        Catalog.TryGet(SessionsSurfaceId, out _)
            ? EventCallback.Factory.Create(this, () => Navigator.Show(SessionsSurfaceId))
            : default;

    private EventCallback<string> AskAiCallback =>
        _wiring?.AskAi is { } askAi ? EventCallback.Factory.Create(this, askAi) : default;
}
