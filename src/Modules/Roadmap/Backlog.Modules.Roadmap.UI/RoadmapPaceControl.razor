@*
    The pace a band's plans are placed at: how many story points a week an imported
    plan with no due date is drawn at (ADR 0013, ruling 4).

    Up to three paces, one of them in use, each measured from the estimated work
    finished over the last two, four and eight weeks and shown with its figure so the
    reader can see what they are choosing. A stretch that finished nothing measured no
    pace and is not offered at all. The pressed one is the one in use: the chosen
    stretch, the last two weeks until one is chosen, or — when the chosen one has
    since measured nothing — the first stretch that did.

    With no stretch measured there is nothing to choose, and the band places by the
    reader's own pace, typed once in the roadmap's heading (RoadmapTypedPace); a line
    says so, with the figure.

    Kept per repository band, because productivity differs from one project to the
    next (ADR 0013, ruling 4 as amended), under the band's name in the chart's
    sidebar, above the band's named lanes. A repository's band carries that
    repository's pace (Repository set), measured over its own finished work. The
    unfiled band carries the default pace (Repository unset), measured over all of it.

    A choice here that alters the pace in use is reported through OnPaceChanged, and
    the band re-lengthens every bar still sized by its effort, each at its own
    repository's pace (ADR 0013, ruling 5 as amended). Finished work moving a measured
    figure is not a change anybody made, so it redraws the figures and moves no bar.
*@
@implements IDisposable
@inject IPlanningPace Pace
@inject IRoadmapWorkChanges WorkChanges

<div class="roadmap-pace" data-testid="@TestIdOf(null)">
    @if (HasMeasured)
    {
        <ButtonGroup CssClass="roadmap-pace__options"
                     AriaLabel="@OptionsLabel"
                     TestId="@TestIdOf("options")">
            @foreach (var option in Options)
            {
                var value = _paces.Of(option.Source);
                if (value is null) continue;

                <ToggleButton BaseClass="btn btn--toggle btn--small"
                              Pressed="@(_paces.InEffect == option.Source)"
                              Title="@option.Title(value.Value, Repository)"
                              OnClick="() => Choose(option.Source)"
                              TestId="@TestIdOf(option.Key)">
                    <span class="roadmap-pace__option-name">@option.Name</span>
                    <span class="roadmap-pace__option-value">@Rounded(value.Value)</span>
                </ToggleButton>
            }
        </ButtonGroup>
    }

    @* One short line, always the same height, so the band never has to grow for
       it. The whole sentence is its title and what a screen reader hears. *@
    @if (Note is { } note)
    {
        <span class="roadmap-pace__note"
              role="status"
              title="@note.Sentence"
              data-testid="@TestIdOf(note.Kind)">
            <span aria-hidden="true">@note.Short</span>
            <span class="sr-only">@note.Sentence</span>
        </span>
    }
</div>

@code {
    private sealed record Option(PaceSource Source, string Key, string Name, string Stretch)
    {
        public string Title(decimal measured, string? repository)
        {
            var plans = repository is null ? "plans in no repository" : $"{repository}'s plans";
            var finished = repository is null ? "what you finished" : $"what you finished in {repository}";

            return $"Place {plans} by {finished} over the {Stretch}: {Rounded(measured)} points a week";
        }
    }

    /// <summary>What the line under the choices says: a short form to show and the
    /// sentence it stands for.</summary>
    private sealed record PaceNote(string Kind, string Short, string Sentence);

    private static readonly Option[] Options =
    [
        new(PaceSource.LastTwoWeeks, "two-weeks", "2 wk", "last two weeks"),
        new(PaceSource.LastFourWeeks, "four-weeks", "4 wk", "last four weeks"),
        new(PaceSource.LastEightWeeks, "eight-weeks", "8 wk", "last eight weeks")
    ];

    /// <summary>The repository whose pace this is, by alias; unset for the default
    /// pace — the one a plan filed in no repository is placed at.</summary>
    [Parameter]
    public string? Repository { get; set; }

    /// <summary>Raised after the reader chose a stretch that changed the pace
    /// placement uses for this control's scope, so the band can re-lengthen the bars
    /// sized by it. Not raised for a choice that leaves the pace in use where it
    /// was.</summary>
    [Parameter]
    public EventCallback OnPaceChanged { get; set; }

    private PlanningPacesDto _paces = new(7m, null, null, null, PaceSource.Manual);
    private string? _error;
    private string? _read;
    private bool _initialized;

    private string OptionsLabel => Repository is null
        ? "Which default pace places a plan"
        : $"Which pace places a plan in {Repository}";

    private string Where => Repository is null ? string.Empty : $" in {Repository}";

    /// <summary>Whether any stretch measured something — and so whether there is a
    /// choice to offer at all.</summary>
    private bool HasMeasured => !_paces.FellBack;

    /// <summary>What the line under the choices says, most pressing first: a choice
    /// that could not be kept, since it is what the reader just did; then, with no
    /// stretch measured, that the reader's own pace is placing this band.</summary>
    private PaceNote? Note
    {
        get
        {
            if (_error is not null) return new PaceNote("refused", "Not saved — see why", _error);

            if (_paces.FellBack)
            {
                var mine = Rounded(_paces.Manual);
                return new PaceNote(
                    "fell-back",
                    $"Using Mine: {mine} pt/wk",
                    $"Nothing estimated was finished{Where} in the last eight weeks, so your own pace is used: {mine} points a week.");
            }

            return null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Pace.Changed += OnChanged;
        WorkChanges.Changed += OnChanged;
        await Read();
        _initialized = true;
    }

    /// <summary>A control handed another repository reads that one's pace.</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized || string.Equals(_read, Repository, StringComparison.OrdinalIgnoreCase)) return;

        _error = null;
        await Read();
    }

    public void Dispose()
    {
        Pace.Changed -= OnChanged;
        WorkChanges.Changed -= OnChanged;
    }

    private async Task Read()
    {
        _read = Repository;
        _paces = await Pace.ReadAsync(Repository);
    }

    private async Task Choose(PaceSource source)
    {
        var before = _paces.InUse;
        _error = Pace.Choose(source, Repository);
        await Read();
        if (_paces.InUse != before) await OnPaceChanged.InvokeAsync();
    }

    // Raised from whatever thread saved the pace or wrote a task.
    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        await Read();
        StateHasChanged();
    });

    /// <summary>Every test id carries the scope at the end — the repository, or
    /// "default" — so each band's control can be told apart.</summary>
    private string TestIdOf(string? part)
    {
        var id = part is null ? "roadmap-pace" : $"roadmap-pace-{part}";
        return $"{id}-{(Repository is null ? "default" : Slug(Repository))}";
    }

    private static string Slug(string value) =>
        new([.. value.Select(character => char.IsLetterOrDigit(character) ? char.ToLowerInvariant(character) : '-')]);

    /// <summary>A pace to two decimals for reading at a glance. Placement still
    /// divides by the four it was measured to.</summary>
    private static string Rounded(decimal pace) => pace.ToString("0.##", CultureInfo.InvariantCulture);
}
