<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Roadmap module's public surface — everything a host or another module is
    allowed to see (ADR 0005, ADR 0009):
      DataTransferObjects/  what a caller receives instead of the plan
      Services/             IRoadmapPlanning, the one port a host calls
      Enums                 the vocabulary those DTOs are written in
      RoadmapFeatures       the feature key the shell gates the band on
    The aggregate, its repository port, and the use-case handlers stay in the
    implementation project. Nothing here may reference it, or anything else in
    the solution beyond the shared kernel.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.Modules.Roadmap.Abstractions</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Backlog.SharedKernel\Backlog.SharedKernel.csproj" />
  </ItemGroup>

</Project>
