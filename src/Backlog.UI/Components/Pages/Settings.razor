@page "/settings"
@inject BacklogStore Store
@inject GitHubIntegration GitHub
@inject NavigationManager Navigation

@*
    The one screen in this app with a form control, and it earns it: a folder
    path is not something you can type inline into a backlog entry. It still
    follows the house rule — no save button. Committing the field (blur or
    Enter) moves the store.
*@

<div class="shell shell--narrow">
    <header class="app-header">
        <h1>Settings</h1>
        <a class="icon-link" href="" data-testid="back-link" title="Back to the backlog" aria-label="Back to the backlog">←</a>
    </header>

    <section class="setting">
        <h2 class="setting__title">Where the backlog is stored</h2>
        <p class="setting__body">
            Every entry is a markdown file with YAML frontmatter, readable and editable
            without this app. Point this at a synced or version-controlled folder and the
            backlog travels with it.
        </p>

        <label class="setting__label" for="storage-path">Folder</label>
        <input class="setting__input @(_error is null ? string.Empty : "setting__input--error")"
               id="storage-path"
               data-testid="storage-path-input"
               type="text"
               spellcheck="false"
               autocomplete="off"
               aria-describedby="storage-path-status"
               value="@_draftPath"
               @oninput="e => _draftPath = e.Value?.ToString() ?? string.Empty"
               @onchange="ApplyAsync"
               @onkeydown="OnKeyDownAsync" />

        <p class="setting__status" id="storage-path-status" data-testid="storage-path-status" role="status">
            @if (_error is not null)
            {
                <span class="setting__status--error">@_error</span>
            }
            else if (_moved)
            {
                <span class="setting__status--ok">Moved. Entries now load from this folder.</span>
            }
            else
            {
                <span>Entries live in <code>@Store.EntriesDirectory</code>@(Store.IsDefaultRoot ? " — the default location." : ".")</span>
            }
        </p>

        <div class="setting__actions">
            <button type="button"
                    class="btn"
                    data-testid="reset-storage-path"
                    disabled="@Store.IsDefaultRoot"
                    @onclick="ResetAsync">
                Use the default folder
            </button>
        </div>

        <p class="setting__note">
            Moving the store points the app somewhere new — it does not copy anything.
            Entries already written stay in the old folder until you move the files
            yourself.
        </p>
    </section>

    @*
        GitHub is a cross-cutting concern, so its configuration lives here rather
        than on any one screen: which repositories may be written to, and how to
        authenticate. Same house rule — no save button; committing a field
        (blur or Enter) applies it.
    *@
    <section class="setting" data-testid="github-settings">
        <h2 class="setting__title">Repositories on GitHub</h2>
        <p class="setting__body">
            An entry filed under an area whose name matches one of these can be pushed
            to GitHub as an issue, and its issue and pull request state read back.
            One per line, as <code>owner/repo</code> — or <code>name = owner/repo</code>
            when the area you type is not the repository's own name.
        </p>

        <label class="setting__label" for="github-repos">Repositories</label>
        <textarea class="setting__input setting__input--multiline @(_repoError is null ? string.Empty : "setting__input--error")"
                  id="github-repos"
                  data-testid="github-repos-input"
                  rows="4"
                  spellcheck="false"
                  autocomplete="off"
                  aria-describedby="github-repos-status"
                  placeholder="@("JSdotNet/Backlog\ndocs = JSdotNet/Backlog-docs")"
                  @oninput="e => _draftRepos = e.Value?.ToString() ?? string.Empty"
                  @onchange="ApplyRepositories">@_draftRepos</textarea>

        <p class="setting__status" id="github-repos-status" data-testid="github-repos-status" role="status">
            @if (_repoError is not null)
            {
                <span class="setting__status--error">@_repoError</span>
            }
            else if (GitHub.Repositories.Count == 0)
            {
                <span>Nothing configured — entries show no GitHub controls at all until one is.</span>
            }
            else
            {
                <span>
                    Type <code>@("@" + GitHub.Repositories[0].Alias)</code> on an entry to file it against
                    <code>@GitHub.Repositories[0].FullName</code>@(GitHub.Repositories.Count > 1 ? $", and {GitHub.Repositories.Count - 1} more." : ".")
                </span>
            }
        </p>

        <p class="setting__status" data-testid="github-connection-status" role="status">
            @(_connection?.Summary ?? "Checking how this machine can reach GitHub…")
        </p>

        <label class="setting__label" for="github-token">Personal access token — only used when the GitHub CLI isn't signed in</label>
        <input class="setting__input"
               id="github-token"
               data-testid="github-token-input"
               type="password"
               spellcheck="false"
               autocomplete="off"
               placeholder="@(GitHub.Settings.Current.Token is null ? "ghp_…" : "•••••••• — stored")"
               value="@_draftToken"
               @oninput="e => _draftToken = e.Value?.ToString() ?? string.Empty"
               @onchange="ApplyTokenAsync"
               @onkeydown="OnTokenKeyDownAsync" />

        <div class="setting__actions">
            <button type="button"
                    class="btn"
                    data-testid="github-recheck-button"
                    @onclick="CheckConnectionAsync">
                Check the connection
            </button>

            <button type="button"
                    class="btn"
                    data-testid="github-clear-token-button"
                    disabled="@(GitHub.Settings.Current.Token is null)"
                    @onclick="ClearTokenAsync">
                Forget the token
            </button>
        </div>

        <p class="setting__note">
            Signing in with <code>gh auth login</code> is preferred: the token then stays
            with the GitHub CLI and this app never holds a credential. A token typed here
            is kept in <code>@GitHub.Settings.SettingsPath</code> — deliberately outside the
            backlog folder, so it is never synced or committed along with your entries.
        </p>
    </section>
</div>

@code {
    private string _draftPath = string.Empty;
    private string? _error;
    private bool _moved;

    private string _draftRepos = string.Empty;
    private string _draftToken = string.Empty;
    private string? _repoError;
    private GitHubConnection? _connection;

    protected override void OnInitialized()
    {
        _draftPath = Store.RootDirectory;
        _draftRepos = GitHub.Settings.Current.ToText();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Asking GitHub who we are is a network call, so it happens after the
        // page is on screen rather than holding it up.
        await CheckConnectionAsync();
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ApplyAsync();
        else if (e.Key == "Escape") _draftPath = Store.RootDirectory;
    }

    private Task ApplyAsync()
    {
        var previous = Store.RootDirectory;
        _error = Store.TryUseRoot(_draftPath);
        _moved = _error is null && !string.Equals(previous, Store.RootDirectory, StringComparison.OrdinalIgnoreCase);

        if (_error is null) _draftPath = Store.RootDirectory;
        return Task.CompletedTask;
    }

    private Task ResetAsync()
    {
        _draftPath = Store.DefaultRootDirectory;
        return ApplyAsync();
    }

    /// <summary>Commits the repository list. Lines that aren't repositories are
    /// reported and skipped rather than throwing away the ones around them —
    /// a half-typed line is an ordinary thing to have in a text box.</summary>
    private void ApplyRepositories()
    {
        var (repositories, errors) = GitHubSettings.ParseText(_draftRepos);

        var saveError = GitHub.Settings.SetRepositories(repositories);
        _repoError = errors.Count > 0 ? string.Join(" ", errors) : saveError;
    }

    private async Task OnTokenKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ApplyTokenAsync();
        else if (e.Key == "Escape") _draftToken = string.Empty;
    }

    private async Task ApplyTokenAsync()
    {
        if (string.IsNullOrWhiteSpace(_draftToken)) return;

        GitHub.Settings.SetToken(_draftToken);

        // The field is cleared straight after: the token is stored, and leaving
        // it on screen only invites it into a screenshot.
        _draftToken = string.Empty;
        await CheckConnectionAsync();
    }

    private async Task ClearTokenAsync()
    {
        GitHub.Settings.SetToken(null);
        _draftToken = string.Empty;
        await CheckConnectionAsync();
    }

    private async Task CheckConnectionAsync()
    {
        _connection = null;
        StateHasChanged();

        try
        {
            _connection = await GitHub.DescribeConnectionAsync();
        }
        catch (Exception)
        {
            _connection = new GitHubConnection(false, "Couldn't work out how to reach GitHub from this machine.");
        }

        StateHasChanged();
    }
}
