@page "/settings"
@inject BacklogStore Store
@inject IAppUpdateService Updates
@inject NavigationManager Navigation

@*
    The one screen in this app with a form control, and it earns it: a folder
    path is not something you can type inline into a backlog entry. It still
    follows the house rule — no save button. Committing the field (blur or
    Enter) moves the store.
*@

<div class="shell shell--narrow">
    <header class="app-header">
        <h1>Settings</h1>
        <a class="icon-link" href="" data-testid="back-link" title="Back to the backlog" aria-label="Back to the backlog">←</a>
    </header>

    <section class="setting">
        <h2 class="setting__title">Where the backlog is stored</h2>
        <p class="setting__body">
            Every entry is a markdown file with YAML frontmatter, readable and editable
            without this app. Point this at a synced or version-controlled folder and the
            backlog travels with it.
        </p>

        <label class="setting__label" for="storage-path">Folder</label>
        <input class="setting__input @(_error is null ? string.Empty : "setting__input--error")"
               id="storage-path"
               data-testid="storage-path-input"
               type="text"
               spellcheck="false"
               autocomplete="off"
               aria-describedby="storage-path-status"
               value="@_draftPath"
               @oninput="e => _draftPath = e.Value?.ToString() ?? string.Empty"
               @onchange="ApplyAsync"
               @onkeydown="OnKeyDownAsync" />

        <p class="setting__status" id="storage-path-status" data-testid="storage-path-status" role="status">
            @if (_error is not null)
            {
                <span class="setting__status--error">@_error</span>
            }
            else if (_moved)
            {
                <span class="setting__status--ok">Moved. Entries now load from this folder.</span>
            }
            else
            {
                <span>Entries live in <code>@Store.EntriesDirectory</code>@(Store.IsDefaultRoot ? " — the default location." : ".")</span>
            }
        </p>

        <div class="setting__actions">
            <button type="button"
                    class="btn"
                    data-testid="reset-storage-path"
                    disabled="@Store.IsDefaultRoot"
                    @onclick="ResetAsync">
                Use the default folder
            </button>
        </div>

        <p class="setting__note">
            Moving the store points the app somewhere new — it does not copy anything.
            Entries already written stay in the old folder until you move the files
            yourself.
        </p>
    </section>

    @*
        "About and updates" is an explicit-action section, not a form field. The
        buttons here run a check or apply an update on demand — they are not save
        buttons, so the no-save-button house rule still holds. When the build
        cannot manage its own updates (unpackaged, web, or a bare .msix) we show
        only the explanatory message and no action buttons.
    *@
    <section class="setting">
        <h2 class="setting__title">About and updates</h2>
        <p class="setting__body">
            Version <code data-testid="app-version">@Updates.CurrentVersion</code>.
            @if (Updates.IsSupported)
            {
                <text>Updates are checked when the app launches; you can also check now.</text>
            }
        </p>

        <p class="setting__status" data-testid="update-status" role="status">
            @if (_updateMessage is not null)
            {
                <span class="@_updateStatusClass">@_updateMessage</span>
            }
            else if (!Updates.IsSupported)
            {
                <span>@_unsupportedMessage</span>
            }
            else
            {
                <span>Check for updates to see if a newer version is available.</span>
            }
        </p>

        @if (Updates.IsSupported)
        {
            <div class="setting__actions">
                <button type="button"
                        class="btn"
                        data-testid="check-for-updates"
                        disabled="@_busy"
                        @onclick="CheckForUpdatesAsync">
                    @(_checking ? "Checking…" : "Check for updates")
                </button>

                @if (_updateReady)
                {
                    <button type="button"
                            class="btn"
                            data-testid="install-update"
                            disabled="@_busy"
                            @onclick="InstallUpdateAsync">
                        @(_installing ? "Installing…" : "Install and restart")
                    </button>
                }
            </div>
        }
    </section>
</div>

@code {
    private string _draftPath = string.Empty;
    private string? _error;
    private bool _moved;

    private string? _updateMessage;
    private string _updateStatusClass = string.Empty;
    private string _unsupportedMessage = "Updates are managed by however you started this build.";
    private bool _checking;
    private bool _installing;
    private bool _updateReady;

    private bool _busy => _checking || _installing;

    protected override async Task OnInitializedAsync()
    {
        _draftPath = Store.RootDirectory;

        // Surface the host's own explanation when updates aren't self-managed, so
        // the message stays accurate per channel without hard-coding it here.
        if (!Updates.IsSupported)
        {
            var result = await Updates.CheckForUpdateAsync();
            _unsupportedMessage = result.Message;
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ApplyAsync();
        else if (e.Key == "Escape") _draftPath = Store.RootDirectory;
    }

    private Task ApplyAsync()
    {
        var previous = Store.RootDirectory;
        _error = Store.TryUseRoot(_draftPath);
        _moved = _error is null && !string.Equals(previous, Store.RootDirectory, StringComparison.OrdinalIgnoreCase);

        if (_error is null) _draftPath = Store.RootDirectory;
        return Task.CompletedTask;
    }

    private Task ResetAsync()
    {
        _draftPath = Store.DefaultRootDirectory;
        return ApplyAsync();
    }

    private async Task CheckForUpdatesAsync()
    {
        if (_busy) return;

        _checking = true;
        _updateMessage = null;
        _updateReady = false;

        try
        {
            var result = await Updates.CheckForUpdateAsync();
            _updateReady = result.UpdateReady;
            _updateMessage = result.Message;
            _updateStatusClass = result.Availability switch
            {
                AppUpdateAvailability.UpToDate => "setting__status--ok",
                AppUpdateAvailability.Failed => "setting__status--error",
                _ => string.Empty
            };
        }
        catch
        {
            // The service is contracted never to throw, but the UI must survive it
            // if it ever does.
            _updateReady = false;
            _updateMessage = "The update check could not be completed.";
            _updateStatusClass = "setting__status--error";
        }
        finally
        {
            _checking = false;
        }
    }

    private async Task InstallUpdateAsync()
    {
        if (_busy) return;

        _installing = true;

        try
        {
            var result = await Updates.StartUpdateAsync();
            _updateMessage = result.Message;
            _updateStatusClass = result.Started ? "setting__status--ok" : "setting__status--error";
            if (!result.Started) _updateReady = false;
        }
        catch
        {
            _updateMessage = "The update could not be installed.";
            _updateStatusClass = "setting__status--error";
        }
        finally
        {
            _installing = false;
        }
    }
}
