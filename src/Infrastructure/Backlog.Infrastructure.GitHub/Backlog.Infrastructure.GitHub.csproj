<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cross-cutting GitHub adapter: issue read/write over the gh CLI or a token.
    Knows nothing about any module's domain model — callers map between the two.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.Infrastructure.GitHub</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Backlog.SharedKernel\Backlog.SharedKernel.csproj" />
    <!-- Devbook's published surface. A repository carries a list of that
         context's DevbookFolderSetting, which is the adapter conforming to a
         module's language rather than a module reaching for an adapter — the
         direction ModuleBoundaryTests allows and the one that keeps the setting
         out of a project the module may not see. -->
    <ProjectReference Include="..\..\Modules\Devbook\Backlog.Modules.Devbook.Abstractions\Backlog.Modules.Devbook.Abstractions.csproj" />
    <!-- Sessions' published surface, in the same direction and for the same
         reason: ISessionRepositoryResolver is that module's port, and the settings
         store answers it (SettingsSessionRepositoryResolver) with the clone
         directory each registered repository carries. -->
    <ProjectReference Include="..\..\Modules\Sessions\Backlog.Modules.Sessions.Abstractions\Backlog.Modules.Sessions.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The line format people type into Settings and the JSON shapes GitHub
         answers with are both worth testing directly. -->
    <InternalsVisibleTo Include="Backlog.Desktop.UI.UnitTests" />
    <InternalsVisibleTo Include="Backlog.Infrastructure.GitHub.UnitTests" />
  </ItemGroup>

</Project>