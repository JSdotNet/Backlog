<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cross-cutting GitHub Copilot CLI adapter. Keeps process launching and local
    executable configuration out of UI code while callers own their prompt shape.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.Infrastructure.Copilot</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The launcher's process seam is internal so tests can see what it starts
         without spawning the CLI. -->
    <InternalsVisibleTo Include="Backlog.Infrastructure.Copilot.UnitTests" />
  </ItemGroup>

</Project>
