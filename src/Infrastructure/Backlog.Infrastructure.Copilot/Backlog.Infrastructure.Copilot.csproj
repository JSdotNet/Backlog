<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cross-cutting GitHub Copilot CLI adapter. Keeps process launching and local
    executable configuration out of UI code while callers own their prompt shape.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Backlog.Infrastructure.Copilot</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
