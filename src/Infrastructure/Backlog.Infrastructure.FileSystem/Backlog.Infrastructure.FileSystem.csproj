<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cross-cutting file-system adapter: the settings, feature flags and knowledge
    folders that genuinely are files on local disk. The tasks and the roadmap plan
    both live in Backlog.Infrastructure.Sqlite. Implements ports declared by the
    modules and by the shared kernel; no module may reference this project except
    through its own port interfaces.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.Infrastructure.FileSystem</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The VS Code launcher decides which installed executable to start by
         reading PATH and probing the disk. That decision is worth asserting
         against a fixed fake machine rather than only through whatever VS Code
         the build agent happens to have, so the resolver and the process seam
         are internal and this project's own tests see them. -->
    <InternalsVisibleTo Include="Backlog.Infrastructure.FileSystem.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Tasks\Backlog.Modules.Tasks\Backlog.Modules.Tasks.csproj" />
    <!-- The cross-context joins under Roadmap/ - the plan's tags offered to the
         task tag picker, and a roadmap item's rollup of the entries and knowledge
         chapters it gathers. Storage is no longer among them: the plan itself
         moved to Backlog.Infrastructure.Sqlite. An adapter referencing a module
         implementation is the normal direction; the module never sees this
         project. -->
    <ProjectReference Include="..\..\Modules\Roadmap\Backlog.Modules.Roadmap\Backlog.Modules.Roadmap.csproj" />
    <ProjectReference Include="..\..\Core\Backlog.SharedKernel\Backlog.SharedKernel.csproj" />
    <!-- The workspace adapters under Workspace/ answer two module ports over one
         settings file: Tasks' ITaskStore and Second Brain's
         IKnowledgeFolderSource. Answering them needs the GitHub repository
         settings as well as the local root, and holding that join is exactly
         what an adapter is for — it is what keeps either context from having to
         see the other. -->
    <ProjectReference Include="..\..\Modules\Knowledge\Backlog.Modules.Knowledge.Abstractions\Backlog.Modules.Knowledge.Abstractions.csproj" />
    <ProjectReference Include="..\Backlog.Infrastructure.GitHub\Backlog.Infrastructure.GitHub.csproj" />
    <!-- For where the task database lives: the settings store shows the path on
         the settings screen, and the Sqlite adapter owns the file name. -->
    <ProjectReference Include="..\Backlog.Infrastructure.Sqlite\Backlog.Infrastructure.Sqlite.csproj" />
  </ItemGroup>

</Project>