<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cross-cutting file-system adapter: the settings, feature flags and knowledge
    folders that genuinely are files on local disk, plus the cross-context joins
    under Roadmap/, Dashboard/ and Inbox/ that only an adapter seeing both sides
    may hold. The tasks, the roadmap plan and the inbox all live in
    Backlog.Infrastructure.Sqlite. Implements ports declared by the modules and by
    the shared kernel; no module may reference this project except through its
    own port interfaces.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.Infrastructure.FileSystem</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The VS Code launcher decides which installed executable to start by
         reading PATH and probing the disk. That decision is worth asserting
         against a fixed fake machine rather than only through whatever VS Code
         the build agent happens to have, so the resolver and the process seam
         are internal and this project's own tests see them.
         SyncedFolderDetector reads the machine the same way and extends the same
         reasoning: which sync providers are installed and signed in is even less
         a test's business than which VS Code is, so its environment and probe
         seam is internal too. -->
    <InternalsVisibleTo Include="Backlog.Infrastructure.FileSystem.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Tasks\Backlog.Modules.Tasks\Backlog.Modules.Tasks.csproj" />
    <!-- The cross-context joins under Roadmap/ - the plan's tags offered to the
         task tag picker, and a roadmap item's rollup of the entries and knowledge
         chapters it gathers. Storage is no longer among them: the plan itself
         moved to Backlog.Infrastructure.Sqlite. An adapter referencing a module
         implementation is the normal direction; the module never sees this
         project. -->
    <ProjectReference Include="..\..\Modules\Roadmap\Backlog.Modules.Roadmap\Backlog.Modules.Roadmap.csproj" />
    <!-- The cross-context join under Inbox/ - an inbox item routed to the backlog
         becomes entries, composed in Tasks' grammar from the Inbox's published
         request shape. The published surface only: the adapter answers the Inbox's
         port and asks Tasks through ITaskItems, and needs neither aggregate. -->
    <ProjectReference Include="..\..\Modules\Inbox\Backlog.Modules.Inbox.Abstractions\Backlog.Modules.Inbox.Abstractions.csproj" />
    <!-- The cross-context join under Dashboard/ - the Sessions context supplies the
         assistant-session facts the Dashboard's sessions part reports on. Two
         published surfaces and no implementation: the adapter is the only thing in
         the product allowed to see both, which is precisely why the join is here
         rather than as a reference between the two module UIs. -->
    <ProjectReference Include="..\..\Modules\Dashboard\Backlog.Modules.Dashboard.Abstractions\Backlog.Modules.Dashboard.Abstractions.csproj" />
    <ProjectReference Include="..\..\Modules\Sessions\Backlog.Modules.Sessions.Abstractions\Backlog.Modules.Sessions.Abstractions.csproj" />
    <!-- The capture-sources settings file under Workspace/ answers Capture's
         ICaptureSourceSettings port. The published surface only: the store
         writes the vocabulary and the DTOs, and never sees a run. -->
    <ProjectReference Include="..\..\Modules\Capture\Backlog.Modules.Capture.Abstractions\Backlog.Modules.Capture.Abstractions.csproj" />
    <!-- For the name of the tools catalog folder under the root, which the
         workspace store carries along when the root moves. The published
         surface only, and only that one constant. -->
    <ProjectReference Include="..\..\Modules\DevPc\Backlog.Modules.DevPc.Abstractions\Backlog.Modules.DevPc.Abstractions.csproj" />
    <ProjectReference Include="..\..\Core\Backlog.SharedKernel\Backlog.SharedKernel.csproj" />
    <!-- The workspace adapters under Workspace/ answer two module ports over one
         settings file: Tasks' ITaskStore and Devbook's
         IDevbookFolderSource. Answering them needs the GitHub repository
         settings as well as the local root, and holding that join is exactly
         what an adapter is for — it is what keeps either context from having to
         see the other. -->
    <ProjectReference Include="..\..\Modules\Devbook\Backlog.Modules.Devbook.Abstractions\Backlog.Modules.Devbook.Abstractions.csproj" />
    <ProjectReference Include="..\Backlog.Infrastructure.GitHub\Backlog.Infrastructure.GitHub.csproj" />
    <!-- For where the task database lives: the settings store shows the path on
         the settings screen, and the Sqlite adapter owns the file name. -->
    <!-- The read side of the generated devbook database. The roadmap rollup is
         a join only an adapter may make, and the knowledge half of it is now a
         few indexed rows rather than a 947 KB document parse. -->
    <ProjectReference Include="..\Backlog.Infrastructure.Devbook\Backlog.Infrastructure.Devbook.csproj" />
    <ProjectReference Include="..\Backlog.Infrastructure.Sqlite\Backlog.Infrastructure.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The backup worker logs what a scheduled run did the way the sync
         workers do: a refusal at information, an unplanned exception at error.
         Abstractions only; which sink hears it is the host's business. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
