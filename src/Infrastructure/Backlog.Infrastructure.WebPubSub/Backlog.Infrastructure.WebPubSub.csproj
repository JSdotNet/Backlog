<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Web PubSub adapter: the realtime nudge the sync service sends an owner's desktops
    (local ADR 0038 §4). It implements INotificationNudgeChannel, a port declared by
    Backlog.Modules.Sync; the module never sees this project, which is the direction
    Backlog.Infrastructure.Cosmos and Backlog.Infrastructure.BlobStorage run in beside it.

    The Web PubSub client is referenced here and nowhere else in the solution, for the
    reason the storage packages are: the host depends on a port implementation rather
    than on a service driver. The Aspire package registers the service client with
    DefaultAzureCredential, which is the managed identity the deployed service reaches
    the hub with; local auth is off on the hub, so no key would work anyway.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.Infrastructure.WebPubSub</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Sync\Backlog.Modules.Sync\Backlog.Modules.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Azure.Messaging.WebPubSub" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Backlog.Modules.Sync.Api.UnitTests" />
  </ItemGroup>

</Project>
