<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Notification Hubs adapter: the Android push the sync service sends an owner's phones
    (local ADR 0039 §4), relayed by the hub to FCM v1. It implements
    INotificationPushChannel, a port declared by Backlog.Modules.Sync; the module never sees
    this project, which is the direction Backlog.Infrastructure.WebPubSub runs in beside it.

    The Notification Hubs client is referenced here and nowhere else in the solution, for the
    reason the Web PubSub client is: the host depends on a port implementation rather than
    on a service driver. The hub supports no managed identity, so the client is built from
    two SAS connection strings that Bicep writes into container app secrets — a Send-only
    one for the message, and a Manage one for the installations (ADR 0039 §5).
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.Infrastructure.NotificationHubs</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Sync\Backlog.Modules.Sync\Backlog.Modules.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.NotificationHubs" />
    <!-- Lifts the client's vulnerable 6.0.1 dependency; see Directory.Packages.props. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Backlog.Modules.Sync.Api.UnitTests" />
  </ItemGroup>

</Project>
