<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The generated devbook database: its reader, and since local ADR 0015 its
    builder, which writes one database per repository path into the app's own
    storage (local ADR 0004 for what the database is).

    Its own project rather than a folder inside Backlog.Infrastructure.Sqlite,
    which is the canonical local task store. This is a different file with a
    different lifecycle: a build output rebuilt whole from the devbook folders,
    never migrated and never repaired row by row, where the task store is data
    nobody can regenerate.

    It is also what "one artifact, every channel" wants: the mobile head and the
    IDE extension can reference this later without taking the backlog store, its
    schema and its migrations with them.
  -->
  <ItemGroup>
    <!-- SQLitePCLRaw.bundle_e_sqlite3 arrives transitively and ships FTS5
         compiled in; an explicit SQLitePCLRaw reference would pin a second
         opinion about which native build is loaded. FtsAvailability is the test
         that says so out loud. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- DevbookDatabaseRefresher reports a failed background build rather than
         losing it. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Devbook's published surface, for the two retrieval ports this
         project implements: IDevbookSearch and IDevbookVectorSearch. The
         direction is the one ModuleBoundaryTests requires - a module declares a
         port and infrastructure implements it, never the reverse - and it is the
         same reference Backlog.Infrastructure.GitHub and .FileSystem already
         take for IDevbookFolderSource, which is also what tells this project
         which repository's database to open. -->
    <ProjectReference Include="..\..\Modules\Devbook\Backlog.Modules.Devbook.Abstractions\Backlog.Modules.Devbook.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one schema text both writers load (local ADR 0015): the Node writer
         reads this file, the builder here embeds it. -->
    <EmbeddedResource Include="..\..\..\tools\devbook\devbook-schema.sql"
                      LogicalName="Backlog.Infrastructure.Devbook.devbook-schema.sql"
                      Link="devbook-schema.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Backlog.Infrastructure.Devbook.UnitTests" />
  </ItemGroup>

</Project>
