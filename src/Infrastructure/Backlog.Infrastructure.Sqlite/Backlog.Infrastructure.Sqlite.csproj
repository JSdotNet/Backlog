<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cross-cutting SQLite adapter: the canonical local store for Backlog
    Management's tasks, for Roadmap Planning's stored plan, and for the Inbox's
    items, lists and groups. Implements ports declared by those modules; no
    module may reference this project except through its own port interfaces.

    Five tables in one file, with an owner each: tasks, roadmap_plan, and the
    three inbox_* tables. Inherited ADR 0014 puts persistence in the hands of
    the module that owns the data, so no adapter here reads, writes, or creates
    another's table - what they share is a database file, not a schema.

    It is a separate project from Backlog.Infrastructure.FileSystem on purpose.
    That project holds the adapters that genuinely are files - the workspace
    settings, the feature settings, the knowledge folder resolver - and a
    database inside a project called FileSystem would be misfiled.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.Infrastructure.Sqlite</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Tasks\Backlog.Modules.Tasks\Backlog.Modules.Tasks.csproj" />
    <!-- Roadmap Planning's IRoadmapPlanRepository, answered under Roadmap/ by one
         document row in the same database the tasks use. An adapter referencing a
         module implementation is the normal direction; the module never sees this
         project. -->
    <ProjectReference Include="..\..\Modules\Roadmap\Backlog.Modules.Roadmap\Backlog.Modules.Roadmap.csproj" />
    <!-- The Inbox module's two repository ports, answered under Inbox/ by three
         tables in the same database. Same direction, same reasoning. -->
    <ProjectReference Include="..\..\Modules\Inbox\Backlog.Modules.Inbox\Backlog.Modules.Inbox.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

</Project>
