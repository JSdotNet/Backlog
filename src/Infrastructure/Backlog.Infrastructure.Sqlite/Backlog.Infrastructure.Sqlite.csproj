<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cross-cutting SQLite adapter: the canonical local store for Backlog
    Management's tasks, for Roadmap Planning's stored plan, for Progress's goals
    and impediments, for the Inbox's items, lists and groups, for Notifications'
    notifications, and for Events' knowledge events and event series. Implements
    ports declared by those modules; no module may reference this project except
    through its own port interfaces.

    One file, with an owner per table: tasks, roadmap_plan, the progress_*,
    inbox_* and events_* tables, notifications, and the Sessions context's
    tables. Inherited ADR 0014 puts persistence in the hands of
    the module that owns the data, so no adapter here reads, writes, or creates
    another's table - what they share is a database file, not a schema. The one
    shared table is the change journal's change_sets (local ADR 0061 §2): one change
    set can span several owners' tables, so it belongs to none of them, and each
    journalled write records its change set there through Changes/.

    It is a separate project from Backlog.Infrastructure.FileSystem on purpose.
    That project holds the adapters that genuinely are files - the workspace
    settings, the feature settings, the devbook folder resolver - and a
    database inside a project called FileSystem would be misfiled.
  -->
  <PropertyGroup>
    <RootNamespace>Backlog.Infrastructure.Sqlite</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Tasks\Backlog.Modules.Tasks\Backlog.Modules.Tasks.csproj" />
    <!-- Roadmap Planning's IRoadmapPlanRepository, answered under Roadmap/ by one
         document row in the same database the tasks use. An adapter referencing a
         module implementation is the normal direction; the module never sees this
         project. -->
    <ProjectReference Include="..\..\Modules\Roadmap\Backlog.Modules.Roadmap\Backlog.Modules.Roadmap.csproj" />
    <!-- Progress's IGoalRepository and IImpedimentRepository, answered under Progress/
         by the progress_goals and progress_impediments tables in the same database.
         Same direction. -->
    <ProjectReference Include="..\..\Modules\Progress\Backlog.Modules.Progress\Backlog.Modules.Progress.csproj" />
    <!-- The Inbox module's two repository ports, answered under Inbox/ by three
         tables in the same database. Same direction, same reasoning. -->
    <ProjectReference Include="..\..\Modules\Inbox\Backlog.Modules.Inbox\Backlog.Modules.Inbox.csproj" />
    <!-- The Sessions context's IClaudeApiRequestStore, answered under Sessions/ by the
         claude_api_requests table in the same database. The context has no module
         project, so the port comes from its abstractions; same direction otherwise. -->
    <ProjectReference Include="..\..\Modules\Sessions\Backlog.Modules.Sessions.Abstractions\Backlog.Modules.Sessions.Abstractions.csproj" />
    <!-- Notifications' INotificationRepository, answered under Notifications/ by the
         notifications table in the same database (local ADR 0039 §3). Same direction.
         Its published INotifications too: the task store is where a task's end is
         noticed, so it closes the notifications about that task. -->
    <ProjectReference Include="..\..\Modules\Notifications\Backlog.Modules.Notifications\Backlog.Modules.Notifications.csproj" />
    <!-- Events' IKnowledgeEventRepository and IEventSeriesRepository, answered under
         Events/ by the events_knowledge_events and events_series tables in the same
         database (local ADR 0050 §2). Same direction. -->
    <ProjectReference Include="..\..\Modules\Events\Backlog.Modules.Events\Backlog.Modules.Events.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared open (SqliteSchema) is internal to this project and asserted
         directly, rather than only through whichever repository calls it. -->
    <InternalsVisibleTo Include="Backlog.Infrastructure.Sqlite.UnitTests" />
  </ItemGroup>

</Project>
