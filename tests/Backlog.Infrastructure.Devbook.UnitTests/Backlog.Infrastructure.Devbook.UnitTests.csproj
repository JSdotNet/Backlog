<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The reader's own suite. It holds the cross-language contract ADR 0004 names
    as this change's main risk: every database these tests read is created from
    the DDL in tools/devbook/devbook-schema.mjs, read from disk at test time,
    so a column renamed on the writing side fails here rather than in a panel.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Infrastructure\Backlog.Infrastructure.Devbook\Backlog.Infrastructure.Devbook.csproj" />
    <!-- The Brain's conventions, note text and link types (local ADR 0040), whose
         suites live here beside the Brain database they describe. -->
    <ProjectReference Include="..\..\src\Modules\Brain\Backlog.Modules.Brain.Abstractions\Backlog.Modules.Brain.Abstractions.csproj" />
    <!-- The Brain's corpus profile, database location and readers (local ADR
         0040), which the Brain database suites here build and read through. -->
    <ProjectReference Include="..\..\src\Infrastructure\Backlog.Infrastructure.Brain\Backlog.Infrastructure.Brain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The refresher's quiet interval, driven without waiting it out. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Backlog.Infrastructure.Devbook" />
    <Using Include="Backlog.Modules.Brain.Abstractions" />
    <Using Include="Backlog.Infrastructure.Brain" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\TestDoubles\RecordingNotifications.cs" Link="Shared\TestDoubles\RecordingNotifications.cs" />
  </ItemGroup>

</Project>
