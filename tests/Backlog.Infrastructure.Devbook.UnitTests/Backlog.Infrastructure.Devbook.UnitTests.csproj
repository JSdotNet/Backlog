<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The reader's own suite. It holds the cross-language contract ADR 0004 names
    as this change's main risk: every database these tests read is created from
    the DDL in tools/devbook/devbook-schema.mjs, read from disk at test time,
    so a column renamed on the writing side fails here rather than in a panel.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Infrastructure\Backlog.Infrastructure.Devbook\Backlog.Infrastructure.Devbook.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The refresher's quiet interval, driven without waiting it out. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Backlog.Infrastructure.Devbook" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\TestDoubles\RecordingNotifications.cs" Link="Shared\TestDoubles\RecordingNotifications.cs" />
  </ItemGroup>

</Project>
