<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Host composition, asserted by building the host.

    The suite next door proves what each registration extension registers. This
    one proves that the hosts which call them can still start: a provider that
    cannot satisfy one constructor is a crash inside Build(), and no unit test of
    a service collection assembled by a test can see it. The two web harnesses
    are the hosts that can be built in-process — the MAUI heads need their
    platform SDKs — and they are the same two the AppHost starts, so a failure
    here is the failure a developer would otherwise meet as a resource that dies
    on startup.

    The MAUI desktop head is the exception it can partly close: that head and the
    desktop harness compose through one AddDesktopComposition call, so
    MauiDesktopCompositionTests builds that call with the head's options and its
    head-only lines, restated, and validates the provider.

    Both harnesses are referenced under an alias: each has its own top-level
    Program in the global namespace, and without one the name is ambiguous.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\src\Harness\Backlog.Desktop.WebHarness\Backlog.Desktop.WebHarness.csproj" Aliases="DesktopHarness" />
    <ProjectReference Include="..\..\src\Harness\Backlog.Mobile.WebHarness\Backlog.Mobile.WebHarness.csproj" Aliases="MobileHarness" />
    <!-- The MCP group table, so the composition rule constructs whatever tool
         classes the library publishes today rather than a list kept here. It
         arrives through the desktop harness anyway; named because this project
         uses it directly, and a reference nobody states is a reference somebody
         removes. -->
    <ProjectReference Include="..\..\src\Infrastructure\Backlog.Infrastructure.Mcp\Backlog.Infrastructure.Mcp.csproj" />
    <!-- The GitHub transport, whose HttpClient the harness test asks the
         factory for. Named for the same reason as the reference above. -->
    <ProjectReference Include="..\..\src\Infrastructure\Backlog.Infrastructure.GitHub\Backlog.Infrastructure.GitHub.csproj" />
    <!-- The composition both desktop heads share, which MauiDesktopCompositionTests
         builds with the MAUI head's options: that head cannot be referenced, so
         its container is proven through the call it makes. The adapters it hands
         in - DPAPI, the full tools service, the Devbook block - are named for the
         same reason as the two references above. -->
    <ProjectReference Include="..\..\src\App\Backlog.Desktop.Composition\Backlog.Desktop.Composition.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\Backlog.Infrastructure.DevPc\Backlog.Infrastructure.DevPc.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\Backlog.Infrastructure.Devbook\Backlog.Infrastructure.Devbook.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\Backlog.Infrastructure.Sync\Backlog.Infrastructure.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebApplicationFactory: it runs the host's real entry point, which is the
         only thing that composes the host the way the host composes itself. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- A real browser on the pop-out page's circuit, for SurfaceWindowPagesTests:
         nothing short of one speaks Blazor's circuit protocol. That test skips
         where no Playwright Chromium is installed. -->
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>

  <!-- The shared test doubles this project uses. Linked per project rather than
       from tests/Directory.Build.props: a double that implements a product
       interface only compiles in a project that references it. -->
  <ItemGroup>
    <Compile Include="..\Shared\TestDoubles\InMemorySessionRequestStore.cs" Link="Shared\TestDoubles\InMemorySessionRequestStore.cs" />
    <Compile Include="..\Shared\TestDoubles\RecordingTelemetry.cs" Link="Shared\TestDoubles\RecordingTelemetry.cs" />
  </ItemGroup>

  <!-- The MAUI head's MCP listener, compiled here from its own source: the head
       cannot be referenced, and McpServerWorkerTests holds it to building its
       listener off the thread that constructs it. Everything the file uses
       arrives through the desktop harness's references. -->
  <ItemGroup>
    <Compile Include="..\..\src\App\Backlog.Desktop\Mcp\McpServerWorker.cs" Link="Head\McpServerWorker.cs" />
    <!-- And the pop-out pages it serves (local ADR 0041 §7), which it calls:
         SurfaceWindowPagesTests renders /window/{surfaceId} through it. -->
    <Compile Include="..\..\src\App\Backlog.Desktop\Mcp\SurfaceWindowPages.cs" Link="Head\SurfaceWindowPages.cs" />
  </ItemGroup>

  <!-- And the port the Settings page reads that listener through, for the same
       reason: DesktopMcpEndpointSourceTests holds it to forwarding the listener's
       state, the port and a Retry to the real worker rather than a stand-in. -->
  <ItemGroup>
    <Compile Include="..\..\src\App\Backlog.Desktop\Mcp\DesktopMcpEndpointSource.cs" Link="Head\DesktopMcpEndpointSource.cs" />
  </ItemGroup>

  <!-- The head's .mjs response decision, compiled here for the same reason:
       ModuleScriptResponsesTests holds the head to serving its module scripts
       as JavaScript, which MAUI's Windows extension table does not. The file
       uses no MAUI or WebView2 type, so it compiles without the head's SDK. -->
  <ItemGroup>
    <Compile Include="..\..\src\App\Backlog.Desktop\Services\ModuleScriptResponses.cs" Link="Head\ModuleScriptResponses.cs" />
  </ItemGroup>

  <!-- What Claude Code posted to an OTLP logs endpoint, scrubbed, for ClaudeCodeLogsEndpointGateTests
       to replay. Shared from tests/Fixtures because the reader and the host route
       replay the same capture. -->
  <ItemGroup>
    <None Include="..\Fixtures\claude-code-otlp\*" Link="Fixtures\claude-code-otlp\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
