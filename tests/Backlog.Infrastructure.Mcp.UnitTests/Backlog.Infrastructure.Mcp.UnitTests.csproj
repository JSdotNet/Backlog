<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- A comment is dated, and a date a test cannot pin is a date a test has to
         reconstruct - which is the same arithmetic the subject does, asserted
         against itself. FakeTimeProvider is what every other clock-reading test
         in this solution uses. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Infrastructure\Backlog.Infrastructure.Mcp\Backlog.Infrastructure.Mcp.csproj" />
    <!-- The ports the doubles implement, and the DTOs they answer with. Named
         rather than left to flow through the subject, so a test that stops
         compiling says which contract moved. -->
    <ProjectReference Include="..\..\src\Modules\Tasks\Backlog.Modules.Tasks.Abstractions\Backlog.Modules.Tasks.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Modules\Roadmap\Backlog.Modules.Roadmap.Abstractions\Backlog.Modules.Roadmap.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Modules\Devbook\Backlog.Modules.Devbook.Abstractions\Backlog.Modules.Devbook.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Modules\Brain\Backlog.Modules.Brain.Abstractions\Backlog.Modules.Brain.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Modules\Inbox\Backlog.Modules.Inbox.Abstractions\Backlog.Modules.Inbox.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Modules\Sessions\Backlog.Modules.Sessions.Abstractions\Backlog.Modules.Sessions.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Modules\Notifications\Backlog.Modules.Notifications.Abstractions\Backlog.Modules.Notifications.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Core\Backlog.SharedKernel\Backlog.SharedKernel.csproj" />
    <!-- BrainFolderSource and BrainNoteWriter, the real Brain the desktop head
         composes. The Brain tools are tested over them rather than over doubles
         because capture_note's promises - the inbox area, never overwriting, the
         refusal in the writer's own words - are the writer's, and a double would
         make them true of the double. -->
    <ProjectReference Include="..\..\src\Infrastructure\Backlog.Infrastructure.Brain\Backlog.Infrastructure.Brain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Backlog.Modules.Brain.Abstractions" />
    <Using Include="Backlog.Infrastructure.Brain" />
  </ItemGroup>
  <!-- The shared test doubles this project uses. -->
  <ItemGroup>
    <Compile Include="..\Shared\TestDoubles\InMemorySessionRequestStore.cs" Link="Shared\TestDoubles\InMemorySessionRequestStore.cs" />
    <Compile Include="..\Shared\TestDoubles\HeldWaitingQuestions.cs" Link="Shared\TestDoubles\HeldWaitingQuestions.cs" />
    <Compile Include="..\Shared\TestDoubles\InMemoryLoopRegister.cs" Link="Shared\TestDoubles\InMemoryLoopRegister.cs" />
  </ItemGroup>

</Project>
