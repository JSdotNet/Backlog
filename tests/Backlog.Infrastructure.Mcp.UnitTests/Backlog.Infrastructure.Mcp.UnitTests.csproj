<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- A comment is dated, and a date a test cannot pin is a date a test has to
         reconstruct - which is the same arithmetic the subject does, asserted
         against itself. FakeTimeProvider is what every other clock-reading test
         in this solution uses. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

