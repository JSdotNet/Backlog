<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="bunit" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Backlog.UI.Components.Markdown" />

    <!-- The app is split by bounded context (Inbox, BacklogManagement,
         Knowledge) under a composing Shell — namespaces that are projects rather
         than folders in one. The namespaces did not move with them, so these
         lines are unchanged: each module UI project keeps publishing the
         namespace it always did. Tests sit outside that boundary and check all
         of it, so the namespaces are imported once here instead of per file. -->
    <Using Include="Backlog.Modules.Backlog.Abstractions" />
    <Using Include="Backlog.Modules.Backlog.Abstractions.DataTransferObjects" />
    <!-- Dev PC Management publishes the Copilot tool port, the DTOs behind it and
         the .tools catalog format. Unlike the contexts above it never had a
         folder in Backlog.Desktop.UI to keep a namespace from, so its types say
         Backlog.Modules.DevPc.Abstractions. -->
    <Using Include="Backlog.Modules.DevPc.Abstractions" />
    <!-- Second Brain publishes the knowledge-folder port, the configured-folder
         format and the location it resolves to. Like Dev PC Management it never
         had a folder in Backlog.Desktop.UI, so its types say
         Backlog.Modules.Knowledge.Abstractions. -->
    <Using Include="Backlog.Modules.Knowledge.Abstractions" />
    <!-- Roadmap and Monitoring have no abstractions project to import: neither has
         a domain module yet, so each publishes one component and one feature key
         from its .UI project, and that is the namespace the tests name. -->
    <Using Include="Backlog.Modules.Roadmap.UI" />
    <Using Include="Backlog.Modules.Monitoring.UI" />
    <!-- The feature port and the app-wide feature keys, and the file-system
         adapters that answer the workspace ports these tests drive directly. -->
    <Using Include="Backlog.SharedKernel" />
    <Using Include="Backlog.Infrastructure.FileSystem" />
    <Using Include="Backlog.Desktop.UI.Inbox" />
    <Using Include="Backlog.Desktop.UI.BacklogManagement" />
    <Using Include="Backlog.Desktop.UI.Knowledge" />
    <Using Include="Backlog.Desktop.UI.Shell" />
    <!-- The self-update port and its result types moved out of the Shell folder
         into AppUpdate/ and took their namespace with them. The settings screen
         moved folders too but kept the Shell namespace; see the comment in
         src/App/Backlog.Desktop.UI/Settings/_Imports.razor for the name
         collision that decided it. -->
    <Using Include="Backlog.Desktop.UI.AppUpdate" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Backlog\Backlog.Modules.Backlog\Backlog.Modules.Backlog.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\Backlog.Infrastructure.AzureFoundry\Backlog.Infrastructure.AzureFoundry.csproj" />
    <ProjectReference Include="..\..\src\Harness\Backlog.AzureFoundry.TestService\Backlog.AzureFoundry.TestService.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\Backlog.Infrastructure.Copilot\Backlog.Infrastructure.Copilot.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\Backlog.Infrastructure.GitHub\Backlog.Infrastructure.GitHub.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\Backlog.Infrastructure.FileSystem\Backlog.Infrastructure.FileSystem.csproj" />
    <ProjectReference Include="..\..\src\Core\Backlog.SharedKernel\Backlog.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\Modules\Knowledge\Backlog.Modules.Knowledge.Abstractions\Backlog.Modules.Knowledge.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Modules\Inbox\Backlog.Modules.Inbox.UI\Backlog.Modules.Inbox.UI.csproj" />
    <ProjectReference Include="..\..\src\Modules\Backlog\Backlog.Modules.Backlog.UI\Backlog.Modules.Backlog.UI.csproj" />
    <ProjectReference Include="..\..\src\Modules\Knowledge\Backlog.Modules.Knowledge.UI\Backlog.Modules.Knowledge.UI.csproj" />
    <ProjectReference Include="..\..\src\Modules\DevPc\Backlog.Modules.DevPc.Abstractions\Backlog.Modules.DevPc.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Modules\Roadmap\Backlog.Modules.Roadmap.UI\Backlog.Modules.Roadmap.UI.csproj" />
    <ProjectReference Include="..\..\src\Modules\Monitoring\Backlog.Modules.Monitoring.UI\Backlog.Modules.Monitoring.UI.csproj" />
    <ProjectReference Include="..\..\src\App\Backlog.Desktop.UI\Backlog.Desktop.UI.csproj" />
  </ItemGroup>

</Project>

