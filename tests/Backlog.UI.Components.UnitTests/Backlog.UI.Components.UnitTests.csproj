<!-- The Razor SDK is here so the few test harness components can be written as
     markup: Tabs only makes sense with its panels nested inside it, and a
     hand-built render fragment would obscure what is being tested. -->
<Project Sdk="Microsoft.NET.Sdk.Razor">

  <ItemGroup>
    <PackageReference Include="bunit" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Bunit" />
    <Using Include="Microsoft.AspNetCore.Components" />
    <Using Include="Microsoft.AspNetCore.Components.Web" />
    <Using Include="Backlog.UI.Components.Badges" />
    <Using Include="Backlog.UI.Components.Buttons" />
    <Using Include="Backlog.UI.Components.Code" />
    <Using Include="Backlog.UI.Components.Compare" />
    <Using Include="Backlog.UI.Components.Diagrams" />
    <Using Include="Backlog.UI.Components.Feedback" />
    <Using Include="Backlog.UI.Components.Inputs" />
    <Using Include="Backlog.UI.Components.Integrations" />
    <Using Include="Backlog.UI.Components.Knowledge" />
    <Using Include="Backlog.UI.Components.Layout" />
    <Using Include="Backlog.UI.Components.Markdown" />
    <Using Include="Backlog.UI.Components.Menus" />
    <Using Include="Backlog.UI.Components.Metrics" />
    <Using Include="Backlog.UI.Components.Overlays" />
    <Using Include="Backlog.UI.Components.Roadmap" />
    <Using Include="Backlog.UI.Components.Selects" />
    <Using Include="Backlog.UI.Components.Tasks" />
    <Using Include="Backlog.UI.Components.UnitTests.Harnesses" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only the library: these tests exist to prove it stands on its own. -->
    <ProjectReference Include="..\..\src\Core\Backlog.UI.Components\Backlog.UI.Components.csproj" />
  </ItemGroup>

</Project>
